// The lexer's state cells and its one flag.
//
//   lexline  the running line number
//   lexbol   the source index the current line begins at, so a token's column
//            is its index minus this
//   lexcols  1 under --cols, which prints each token's columns (line.id)
lex_setup(int argc, string[] argv) {
  export int[] lexline = [1];
  export int[] lexbol = [0];
  lex_cols(argc, argv);
} return void;
(1, ["prog"]):() then calls lex_cols:[1] then (import lexline)[0]:(1)
(2, ["prog", "--cols"]):() then calls lex_cols:[1] then (import lexbol)[0]:(0)

lex_cols(int argc, string[] argv) {
  int on = 0;
  if(argc > 1 && argv[1] == "--cols") {
    on = 1;
  }
  export int[] lexcols = [on];
} return void export lexcols;
(1, ["prog"]):() then (import lexcols)[0]:(0)
(2, ["prog", "--cols"]):() then (import lexcols)[0]:(1)

is_lcomment(string src, int i) {
  int ok = 0;
  if(character_code_at(src, i) == 47 && character_code_at(src, i + 1) == 47) {
    ok = 1;
  }
} return int ok;
("// hi", 0):(1)
("x", 0):(0)
