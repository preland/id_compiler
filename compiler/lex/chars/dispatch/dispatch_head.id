// Dispatch chain, part 1. Each function makes one decision and returns the
// index just past whatever was consumed, delegating the rest down the chain.
// `src`/`i`/`ni` repeat across these functions -- allowed now, because a name
// may recur as long as it always denotes the same type (src: string indices
// i and ni: int).

// whitespace, or hand off
scan_one(string src, int i) {
  int ni = 0;
  if(idstd_character_is_space_at(src, i)) {
    ni = eat_space(src, i);
  } else {
    ni = scan_tok_span(src, i);
  }
} return int ni;
(" x", 0):(1) then prints:("")
given lex_fix_setup ("x", 0):(1) then prints:("ident x\n")

// `//` line comment, or hand off
scan_word(string src, int i) {
  int ni = 0;
  if(character_code_at(src, i) == 47 && character_code_at(src, i + 1) == 47) {
    ni = string_end_of_line(src, i);
  } else {
    ni = scan_block(src, i);
  }
} return int ni;
("// hi", 0):(5) then prints:("")
("x", 0):(1) then prints:("ident x\n")

// identifier/keyword, or hand off
scan_token(string src, int i) {
  int ni = 0;
  if(is_name_start_at(src, i)) {
    ni = scan_ident(src, i);
  } else {
    ni = scan_numop(src, i);
  }
} return int ni;
("x", 0):(1) then prints:("ident x\n")
("5", 0):(1) then prints:("int 5\n")
