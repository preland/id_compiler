// Line tracking for diagnostics: the running line number. The store helper it
// needs (an imported list cannot be index-assigned directly) is idstd's
// `lset`, which the compiler's own diagnostic names as the fix; this file used
// to carry a private copy of it.

bump_line() {
  lset((import lexline), 0, (import lexline)[0] + 1);
  print("line " + (import lexline)[0]);
} return void;
given lex_fix_setup ():() then prints:("line 2\n")
given lex_fix_setup ():() then prints:("line 2\n") then lex_line_now:(2)

// Column tracking for `idc --fix`, which rewrites source and so has to know
// where on its line each token starts and ends. The token is printed first and
// its extent after it, because only once the scanner has returned is the end
// known; the parser attaches a `span` to the token just before it. The two
// columns travel as one number, start * 65536 + end (see the parser's
// front/tokens/load/more/pos/span.id).
scan_tok_span(string src, int i) {
  int ni = scan_word(src, i);
  span_out(src, i, ni);
} return int ni;
given lex_fix_setup ("x", 0):(1) then prints:("ident x\n")
given lex_fix_setup_cols ("x", 0):(1) then prints:("ident x\nspan 1\n")

// Only under --cols, so an ordinary build's token stream is unchanged. A `//`
// comment prints no token, so it prints no span either.
span_out(string src, int i, int ni) {
  if((import lexcols)[0] == 1 && is_lcomment(src, i) == 0) {
    int b = (import lexbol)[0];
    print("span " + ((i - b) * 65536 + ni - b));
  }
} return void;
given lex_fix_setup ("x", 0, 1):() then prints:("")
given lex_fix_bol1 ("abcdef", 3, 5):() then prints:("span 131076\n")
