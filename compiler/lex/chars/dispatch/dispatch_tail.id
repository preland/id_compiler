// Dispatch chain, part 2: the tail of the per-character decision tree.

// hex literal, or hand off to the binary case. Hex is tested before the
// decimal case because `0x1f` starts with a digit and would otherwise scan as
// the number 0.
scan_numop(string src, int i) {
  int ni = 0;
  if(hex_start(src, i)) {
    ni = scan_hex(src, i);
  } else {
    ni = scan_binop(src, i);
  }
} return int ni;
("0xff", 0):(4) then prints:("int 255\n")
("5", 0):(1) then prints:("int 5\n")

// string literal (pass the index past the opening quote), else an operator
scan_strop(string src, int i) {
  int ni = 0;
  if(charat(src, i) == 34) {
    ni = scan_string(src, i + 1);
  } else {
    ni = scan_op(src, i);
  }
} return int ni;
("\"hi\"", 0):(4) then prints:("str \"hi\"\n")
("+x", 0):(1) then prints:("op +\n")
