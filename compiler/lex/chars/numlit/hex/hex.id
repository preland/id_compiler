// Hex literals. `id` lexes 0xff to the *integer token* 255 -- hex is a
// spelling, not a type, and nothing downstream ever learns the literal was
// written in hex. So this converts as it scans, and the emitted token is
// byte-identical to the one idc.py produces.
//
// Digit values: 48-57 are '0'-'9', 65-70 are 'A'-'F', 97-102 are 'a'-'f'.

is_hex(int c) {
  int ok = 0;
  if(is_digit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)) {
    ok = 1;
  }
} return int ok;

hex_digit(int c) {
  int n = c - 48;
  if(c >= 65) {
    n = hex_alpha(c);
  }
} return int n;

hex_alpha(int c) {
  int n = c - 55;
  if(c >= 97) {
    n = c - 87;
  }
} return int n;
