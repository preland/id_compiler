// Digit-run scanning, and the float continuation test: a '.' immediately
// followed by another digit. Mirrors idc.py's `\d+\.\d+` float regex, which
// requires digits on both sides of the dot (so a bare trailing dot, with no
// fraction digit, is not part of the number).

digit_run_end(string src, int i) {
  while(idstd_character_is_digit_at(src, i)) {
    i = i + 1;
  }
} return int i;
("123", 0):(3)
("12a", 0):(2)

has_frac(string src, int e) {
  int ok = 0;
  if(character_code_at(src, e) == 46 && idstd_character_is_digit_at(src, e + 1)) {
    ok = 1;
  }
} return int ok;
("x.14", 1):(1)
("42", 2):(0)

// An exponent, if the number has one: `e` or `E`, an optional sign, then the
// digit run. The digit run may be empty (`1e`, `1e+`) and the token still ends
// there: the parser reports it by name (E0103) instead of the lexer leaving a
// stray `e` identifier behind to be misread as a variable.
exp_end(string src, int fe) {
  int c = character_code_at(src, fe);
  int ee = fe;
  if(c == 101 || c == 69) {
    int sg = character_code_at(src, fe + 1);
    ee = digit_run_end(src, fe + 1 + (sg == 43 || sg == 45));
  }
} return int ee;
("1e5", 1):(3)
("1e-30x", 1):(5)
("2E4", 1):(3)
("12", 2):(2)
("1e+", 1):(3)
