// Extend a digit run past an optional fractional part and an optional
// exponent, and pick the token kind word ("int" or "float") based on whether
// either was found: an exponent makes a literal a float, as a point does.

num_end(string src, int i, int e) {
  int fe = e;
  if(has_frac(src, e)) {
    fe = digit_run_end(src, e + 1);
  }
  fe = exp_end(src, fe);
} return int fe;
("3.14", 0, 1):(4)
("42", 0, 2):(2)
("6.02e23", 0, 1):(7)
("2e10", 0, 1):(4)

numkind(int e, int fe) {
  string kind = "int";
  if(fe > e) {
    kind = "float";
  }
} return string kind;
(5, 5):("int")
(5, 8):("float")
