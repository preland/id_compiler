(sizeof(long long), (size_t)ncap, \"list growth\");\n    long long* inl = ID_LIST_CELLS(L);\n    if (L->data == inl) {\n        ID_MEM_CHARGE(nb);\n        long long* nd = (long long*)id_pool_get(nb);\n        memcpy(nd, inl, sizeof(long long) * (size_t)L->len);\n        inl[0] = L->cap;\n        L->data = nd;\n    } else {\n        L->data = (long long*)id_realloc(L->data, sizeof(long long) * (size_t)L->cap, nb);\n    }\n    L->cap = ncap;\n}\nstatic void id_list_push(IdList* L, long long v) {\n    if (!L) id_null_read();\n    id_list_mut_check(L); if (L->len >= L->cap) id_list_grow(L);\n    L->data[L->len++] = v;\n}\nstatic long long id_list_get(IdList* L, int i) {\n    if (!L) id_null_read();\n    if (i < 0 || i >= L->len) {\n        if (L->cap == INT_MIN) id_freed_trap();\n        fprintf(stderr, \"id: index %d out of bounds (len %d)\\n\", i, L->len);\n        exit(1);\n    }\n    return L->data[i];\n}\nstatic void id_list_set(IdList* L, int i, long long v) {\n    if (!L) id_null_read();\n    id_list_mut_check(L); if (i < 0 || i >= L->len) {\n        fprintf(stderr, \"id: index %d out of bounds (len %d)\\n\", i, L->len);\n        exit(1);\n    }\n    L->data[i] = v;\n}\nstatic long long id_list_cell(IdList* L, int i) { return L->data[i]; }\nstatic void id_list_cell_set(IdList* L, int i, long long v) { L->data[i] = v; }\nstatic int id_list_len_raw(IdList* L) { return L ? L->len : -1; }\nstatic int id_list_cap_raw(IdList* L) { return L ? L->cap : -1; }\nstatic int id_list_len(IdList* L) { if (!L) id_null_read(); if (L->len < 0) id_freed_trap(); return L->len; }\nstatic long long id_list_pop(IdList* L) {   /* remove & return the last cell */\n    if (!L) id_null_read();\n    id_list_mut_check(L); if (L->len <= 0) {\n        fprintf(stderr, \"id: pop from empty list\\n\");\n        exit(1);\n    }\n    return L->data[--L->len];\n}\nstatic IdList* id_list_adopt(IdList* f) {   /* a list a native returned -> a list this runtime owns */\n    if (!f) return NULL;\n    if (f->len < 0 || (f->len > 0 && !f->data)) {\n        fprintf(stderr, \"id: a native returned a malformed list (len %d): fill len cells at data, or size the list from id and return a count\\n\", f->len);\n        exit(1);\n    }\n    IdList* L = id_list_new();\n    for (int i = 0; i < f->len; i++) id_list_push(L, f->data[i]);\n    return L;\n}\nstatic IdList* id_list_lit(int n, ...) {   /* elements are pre-boxed to cells */\n    IdList* L = id_list_make(n, n < 1 ? 4 : n);\n    va_list ap; va_start(ap, n);\n    for (int k = 0; k < n; k++) L->data[k] = va_arg(ap, long long);\n    va_end(ap);\n    return L;\n}\nstatic long long id_box_f(double d) { long long x; memcpy(&x, &d, 8); return x; }\nstatic double id_unbox_f(long long x) { double d; memcpy(&d, &x, 8); return d; }\nstatic long long id_bits_of_float(double d) { return id_box_f(d); }\nstatic double id_float_of_bits(long long x) { return id_unbox_f(x); }\nstatic long long id_bits32_of_float(double d) { float f = (float)d; unsigned int u; memcpy(&u, &f, 4); return (long long)u; }\nstatic double id_float_of_bits32(long long x) { unsigned int u = (unsigned int)x; float f; memcpy(&f, &u, 4); return (double)f; }\nstatic int id_to_int(const char* s) {\n    while (*s == 32 || (*s >= 9 && *s <= 13)) s++;\n    int neg = *s == '-';\n    if (*s == '-' || *s == '+') s++;\n    unsigned long long lim = neg ? 9223372036854775808ULL : 9223372036854775807ULL, u = 0;\n    for (; *s >= '0' && *s <= '9'; s++) {\n        unsigned int d = (unsigned int)(*s - '0');\n        if (u > (lim - d) / 10) { u = lim; break; }\n        u = u * 10 + d;\n    }\n    return (int)(unsigned int)(neg ? 0ULL - u : u);\n}\n\nstatic char* id_concat(const char* a, const char* b) {\n    size_t la = id_slen(a), lb = id_slen(b);\n    char* r = id_str_new(id_add_check(la, lb, \"concat\"));\n    memcpy(r, a, la);\n    memcpy(r + la, b, lb);\n    return r;\n}\n/* `+` whose operand is an unnamed temporary (docs/MEMORY.md 3.3). Bit 1 of m: a\n   is fresh, so the result is built in a's block (a pool block grows in place\n   while its size class has room; a large one is realloc'd); bit 2: b is fresh\n   and is given back once copied. */\nstatic char* id_concat_f(char* a, char* b, int m) {\n    size_t la = id_slen(a), lb = id_slen(b);\n    size_t n = id_add_check(la, lb, \"concat\");\n    char* r;\n    if (m & 1) {\n        size_t hb = id_add_check(n, sizeof(size_t) + 1, \"concat\");\n        r = (char*)id_realloc(a - sizeof(size_t), la + sizeof(size_t) + 1, hb) + sizeof(size_t);\n        ((size_t*)(void*)r)[-1] = n;\n    } else {\n        r = id_str_new(n);\n        memcpy(r, a, la);\n    }\n    memcpy(r + la, b, lb);\n    r[n] = '\\0';\n    if (m & 2) id_str_free(b);\n    return r;\n}\nstatic char* id_str_of_word(long long x) {\n    char b[24]; int i = 24;\n    unsigned long long u = x < 0 ? 0ULL - (unsigned long long)x : (unsigned long long)x;\n    do { b[--i] = (char)('0' + u % 10); u /= 10; } while (u);\n    if (x < 0) b[--i] = '-';\n    return id_str_from(b + i, (size_t)(24 - i));\n}\nstatic char* id_str_of_int(int x) { return id_str_of_word(x); }\n\n/* ---- word arithmetic with no undefined behaviour ------------------------\n   C leaves division by zero, INT_MIN/-1, and shifts by 64-or-more undefined.\n   id gives all three a defined answer -- a loud abort for the first two,\n   which are always bugs, and the obvious result for the third -- on the same\n   principle as bounds-checked list indexing: a mistake stops the program\n   instead of quietly producing nonsense. */\nstatic void id_trap(const char* what) {\n    fprintf(stderr, \"id: %s\\n\", what);\n    exit(1);\n}\nstatic long long id_sdiv(long long a, long long b) {\n    if (b == 0) id_trap(\"division by zero\");\n    if (b == -1 && a == LLONG_MIN) id_trap(\"division overflow\");\n    return a / b;\n}\nstatic long long id_smod(long long a, long long b) {\n    if (b == 0) id_trap(\"remainder by zero\");\n    if (b == -1) return 0;              /* would overflow; the answer is 0 */\n    return a % b;\n}\n/* The same two checks for `int`. They used to be word-only, on the grounds\n   that trapping was a new behaviour and `int` division should stay exactly as\n   it was -- but \"exactly as it was\" meant a SIGFPE and a core dump with no\n   message, while the identical mistake on a `word` printed one line and\n   exited 1. Two spellings of one bug do not deserve two failure modes, and\n   gcc folds the check away whenever the divisor is a nonzero constant. */\nstatic int id_idiv(int a, int b) {\n    if (b == 0) id_trap(\"division by zero\");\n    if (b == -1 && a == INT_MIN) id_trap(\"division overflow\");\n    return a / b;\n}\nstatic int id_imod(int a, int b) {\n    if (b == 0) id_trap(\"remainder by zero\");\n    if (b == -1) return 0;              /* would overflow; the answer is 0 */\n    return a % b;\n}\nstatic long long id_shl(long long a, long long n) {\n    if (n < 0) id_trap(\"shift by a negative amount\");\n    if (n >= 64) return 0;\n    return (long long)((unsigned long long)a << n);\n}\nstatic long long id_sar(long long a, long long n) {   /* arithmetic: `>>` */\n    if (n < 0) id_trap(\"shift by a negative amount\");\n    if (n >= 64) return a < 0 ? -1 : 0;\n    return a >> n;\n}\nstatic long long id_ushr(long long a, long long n) {  /* logical: `ushr` */\n    if (n < 0) id_trap(\"shift by a negative amount\");\n    if (n >= 64) return 0;\n    return (long long)((unsigned long long)a >> n);\n}\nstatic long long id_udiv(long long a, long long b) {\n    if (b == 0) id_trap(\"division by zero\");\n    return (long long)((unsigned long long)a / (unsigned long long)b);\n}\nstatic long long id_umod(long long a, long long b) {\n    if (b == 0) id_trap(\"remainder by zero\");\n    return (long long)((unsigned long long)a % (unsigned long long)b);\n}\nstatic long long id_ult(long long a, long long b) {\n    return (unsigned long long)a < (unsigned long long)b;\n}\nstatic long long id_umul_hi(long long a, long long b) {\n#if defined(__SIZEOF_INT128__) && !defined(__wasm__)\n    return (long long)(((unsigned __int128)(unsigned long long)a * (unsigned long long)b) >> 64);\n#else\n    unsigned long long xl = (unsigned long long)a & 0xffffffffULL;\n    unsigned long long xh = (unsigned long long)a >> 32;\n    unsigned long long yl = (unsigned long long)b & 0xffffffffULL;\n    unsigned long long yh = (unsigned long long)b >> 32;\n    unsigned long long lh = xl * yh;\n    unsigned long long hl = xh * yl;\n    unsigned long long mid = ((xl * yl) >> 32) + (lh & 0xffffffffULL) + (hl & 0xffffffffULL);\n    return (long long)(xh * yh + (lh >> 32) + (hl >> 32) + (mid >> 32));\n#endif\n}\nstatic long long id_rotl32(long long x, long long n) {\n    unsigned int v = (unsigned int)x;\n    unsigned int k = (unsigned int)n & 31u;\n    return (long long)(int)((v << k) | (v >> ((0u - k) & 31u)));\n}\nstatic long long id_rotl(long long x, long long n) {\n    unsigned long long v = (unsigned long long)x;\n    unsigned long long k = (unsigned long long)n & 63ULL;\n    return (long long)((v << k) | (v >> ((0ULL - k) & 63ULL)));\n}\nstatic long long id_uword_of_int(long long a) {\n    return (long long)(unsigned int)a;\n}\nstatic long long id_add_checked32(long long a, long long b) {\n    int r;\n    if (__builtin_add_overflow((int)a, (int)b, &r)) id_trap(\"integer overflow\");\n    return r;\n}\nstatic long long id_add_checked(long long a, long long b) {\n    long long r;\n    if (__builtin_add_overflow(a, b, &r)) id_trap(\"integer overflow\");\n    return r;\n}\nstatic long long id_sub_checked32(long long a, long long b) {\n    int r;\n    if (__builtin_sub_overflow((int)a, (int)b, &r)) id_trap(\"integer overflow\");\n    return r;\n}\nstatic long long id_sub_checked(long long a, long long b) {\n    long long r;\n    if (__builtin_sub_overflow(a, b, &r)) id_trap(\"integer overflow\");\n    return r;\n}\nstatic long long id_mul_checked32(long long a, long long b) {\n    int r;\n    if (__builtin_mul_overflow((int)a, (int)b, &r)) id_trap(\"integer overflow\");\n    return r;\n}\nstatic long long id_mul_checked(long long a, long long b) {\n    long long r;\n    if (__builtin_mul_overflow(a, b, &r)) id_trap(\"integer overflow\");\n    return r;\n}\n\n/* ---- the flat store -----------------------------------------------------\n   One flat, byte-addressed memory. An address is an ordinary word, so\n   structs become offsets, arrays become strides, and taking the address of\n   something is arithmetic -- none of which the language needs syntax for.\n\n   Address 0 is never handed out, so it can mean \"null\" the way it does\n   everywhere else. Every access is bounds-checked against the high-water\n   mark: the class of mistake that silently corrupts memory in C is a clean\n   abort here, which is the entire reason the store is a primitive rather\n   than a library. The store grows on demand and is freed at exit with the\n   rest of the arena. */\nstatic ID_TLS unsigned char* id_store = NULL;\nstatic ID_TLS long long id_store_used = 1;    /* 0 is reserved for null */\nstatic ID_TLS long long id_store_cap = 0;\n\nstatic void id_store_grow(long long need) {\n    long long cap = id_store_cap ? id_store_cap : 65536;\n    while (cap < need) {\n        if (cap > (long long)1 << 44) id_trap(\"store too large\");\n        cap *= 2;\n    }\n    id_store = (unsigned char*)id_realloc(id_store, (size_t)id_store_cap, (size_t)cap);\n    memset(id_store + id_store_cap, 0, (size_t)(cap - id_store_cap));\n    id_store_cap = cap;\n}\nstatic long long id_mem_alloc(long long n) {\n    if (n < 0) id_trap(\"negative allocation size\");\n    /* 8-align every allocation so a 64-bit field is never split awkwardly */\n    long long base = (id_store_used + 7) & ~(long long)7;\n    long long end = base + n;\n    if (end < base) id_trap(\"allocation size overflow\");\n    if (end > id_store_cap) id_store_grow(end);\n    id_store_used = end;\n    return base;\n}\nstatic long long id_mem_size(void) { return id_store_used; }\nvoid id_thread_enter(void) { id_arena_hooked = 1; }\nvoid id_thread_leave(void) {\n    IdAllocHdr* h = id_arena_head;\n    while (h) { IdAllocHdr* nx = h->next; free(h); h = nx; }\n    id_arena_head = NULL; id_store = NULL; id_store_used = 1; id_store_cap = 0;\n    id_pool_drop();\n}\n#ifndef __wasm__\ntypedef struct { pthread_mutex_t mu; pthread_cond_t ne, nf; long long* q; int head, count, cap, sopen, ropen, taken, used; } IdChan;\ntypedef struct { int (*f)(int); int arg, res, used; pthread_t t; } IdThr;\nstatic IdChan id_chans[256];\nstatic IdThr id_thrs[256];\nstatic pthread_mutex_t id_chan_tab = PTHREAD_MUTEX_INITIALIZER;\nstatic IdChan* id_chan_of(int h) {\n    if (h < 2 || h / 2 >= 256 || !id_chans[h / 2].used) id_trap(\"chan: not an open channel end\");\n    return &id_chans[h / 2];\n}\nint id_chan_new(int cap) {\n    if (cap < 1) id_trap(\"chan_new: capacity must be at least 1\");\n    pthread_mutex_lock(&id_chan_tab);\n    int i = 1;\n    while (i < 256 && id_chans[i].used) i++;\n    if (i == 256) { pthread_mutex_unlock(&id_chan_tab); id_trap(\"chan_new: too many open channels\"); }\n    IdChan* c = &id_chans[i];\n    c->q = (long long*)malloc(sizeof(long long) * (size_t)cap);\n    if (!c->q) { pthread_mutex_unlock(&id_chan_tab); id_trap(\"out of memory (channel)\"); }\n    pthread_mutex_init(&c->mu, NULL); pthread_cond_init(&c->ne, NULL); pthread_cond_init(&c->nf, NULL);\n    c->head = 0; c->count = 0; c->cap = cap; c->sopen = 1; c->ropen = 1; c->taken = 0; c->used = 1;\n    pthread_mutex_unlock(&id_chan_tab);\n    return i * 2;\n}\nint id_chan_sender(int rx) {\n    IdChan* c = id_chan_of(rx);\n    pthread_mutex_lock(&c->mu);\n    int again = c->taken;\n    c->taken = 1;\n    pthread_mutex_unlock(&c->mu);\n    if (again) id_trap(\"this channel already has a sender (a channel has one sender; make a second channel)\");\n    return rx + 1;\n}\nint id_chan_send(int tx, int v) {\n    IdChan* c = id_chan_of(tx);\n    pthread_mutex_lock(&c->mu);\n    while (c->count == c->cap && c->ropen) pthread_cond_wait(&c->nf, &c->mu);\n    int ok = c->ropen;\n    if (ok) { c->q[(c->head + c->count) % c->cap] = v; c->count++; pthread_cond_signal(&c->ne); }\n    pthread_mutex_unlock(&c->mu);\n    return ok;\n}\nint id_chan_wait(int rx) {\n    IdChan* c = id_chan_of(rx);\n    pthread_mutex_lock(&c->mu);\n    while (c->count == 0 && c->sopen) pthread_cond_wait(&c->ne, &c->mu);\n    int ok = c->count > 0;\n    pthread_mutex_unlock(&c->mu);\n    return ok;\n}\nint id_chan_take(int rx) {\n    IdChan* c = id_chan_of(rx);\n    pthread_mutex_lock(&c->mu);\n    if (c->count == 0) { pthread_mutex_unlock(&c->mu); id_trap(\"chan_take on an empty channel: call chan_wait first and take only when it returns 1\"); }\n    int v = (int)c->q[c->head];\n    c->head = (c->head + 1) % c->cap; c->count--;\n    pthread_cond_signal(&c->nf);\n    pthread_mutex_unlock(&c->mu);\n    return v;\n}\nvoid id_chan_close(int h) {\n    IdChan* c = id_chan_of(h);\n    pthread_mutex_lock(&c->mu);\n    if (h & 1) { c->sopen = 0; pthread_cond_broadcast(&c->ne); } else { c->ropen = 0; pthread_cond_broadcast(&c->nf); }\n    int last = !c->sopen && !c->ropen;\n    pthread_mutex_unlock(&c->mu);\n    if (!last) return;\n    pthread_mutex_lock(&id_chan_tab);\n    free(c->q); c->q = NULL; c->used = 0;\n    pthread_mutex_unlock(&id_chan_tab);\n}\nstatic void* id_thr_main(void* p) {\n    IdThr* t = (IdThr*)p;\n    id_thread_enter();\n    t->res = t->f(t->arg);\n    id_thread_leave();\n    return NULL;\n}\nint id_thr_spawn(int (*f)(int), int arg) {\n    pthread_mutex_lock(&id_chan_tab);\n    int i = 1;\n    while (i < 256 && id_thrs[i].used) i++;\n    if (i == 256) { pthread_mutex_unlock(&id_chan_tab); id_trap(\"thr_spawn: too many running threads\"); }\n    id_thrs[i].used = 1; id_thrs[i].f = f; id_thrs[i].arg = arg;\n    int bad = pthread_create(&id_thrs[i].t, NULL, id_thr_main, &id_thrs[i]);\n    if (bad) id_thrs[i].used = 0;\n    pthread_mutex_unlock(&id_chan_tab);\n    if (bad) id_trap(\"thr_spawn: cannot start a thread\");\n    return i;\n}\nint id_thr_join(int h) {\n    if (h < 1 || h >= 256 || !id_thrs[h].used) id_trap(\"thr_join: not a running thread\");\n    pthread_join(id_thrs[h].t, NULL);\n    int r = id_thrs[h].res;\n    id_thrs[h].used = 0;\n    return r;\n}\n#endif\n\n/* Every load and store funnels through this one check. */\nstatic unsigned char* id_at(long long addr, long long width) {\n    if (addr <= 0 || addr + width > id_store_used) {\n        fprintf(stderr, \"id: store address %lld out of range (size %lld)\\n\",\n                addr, id_store_used);\n        exit(1);\n    }\n    return id_store + addr;\n}\n/* The store as a native sees it: n bytes at addr, bounds-checked like every\n   other access. Not static, so separately compiled C can reach it. The\n   pointer is good only until the next alloc, which may move the store. */\nunsigned char* id_store_span(long long addr, long long n) {\n    if (n < 0) id_trap(\"negative length\");\n    return id_at(addr, n);\n}\n/* stderr as a native sees it: n bytes, in order with print and eprint. It goes\n   where eprint goes -- IDTC_EPRINT_TO is the test harness's capture target for\n   an `eprints` clause and plain stderr everywhere else -- and flushes stdout\n   first, as eprint does, so the two streams interleave as written. 0, or -1. */\n#ifndef IDTC_EPRINT_TO\n#define IDTC_EPRINT_TO stderr\n#endif\nint id_err_write(const unsigned char* p, size_t n) {\n    fflush(stdout);\n    return fwrite(p, 1, n, IDTC_EPRINT_TO) == n ? 0 : -1;\n}\n/* Little-endian (one memcpy on a little-endian host, byte at a time\n   elsewhere): the same bytes on every host, and no alignment requirement -- C code casts pointers to odd addresses freely. */\nstatic long long id_peek_n(long long addr, int width) {\n    unsigned char* p = id_at(addr, width);\n    unsigned long long v = 0;\n#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__\n    memcpy(&v, p, (size_t)width);\n#else\n    for (int i = width - 1; i >= 0; i--) v = (v << 8) | p[i];\n#endif\n    return (long long)v;\n}\nstatic void id_poke_n(long long addr, long long value, int width) {\n    unsigned char* p = id_at(addr, width);\n    unsigned long long v = (unsigned long long)value;\n#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__\n    memcpy(p, &v, (size_t)width);\n#else\n    for (int i = 0; i < width; i++) { p[i] = (unsigned char)(v & 0xff); v >>= 8; }\n#endif\n}\nstatic long long id_peek8(long long a)  { return id_peek_n(a, 1); }\nstatic long long id_peek16(long long a) { return id_peek_n(a, 2); }\nstatic long long id_peek32(long long a) { return id_peek_n(a, 4); }\nstatic long long id_peek64(long long a) { return id_peek_n(a, 8); }\nstatic void id_poke8(long long a, long long v)  { id_poke_n(a, v, 1); }\nstatic void id_poke16(long long a, long long v) { id_poke_n(a, v, 2); }\nstatic void id_poke32(long long a, long long v) { id_poke_n(a, v, 4); }\nstatic void id_poke64(long long a, long long v) { id_poke_n(a, v, 8); }\nstatic long long id_peek8s(long long a)  { return (long long)(signed char)id_peek_n(a, 1); }\nstatic long long id_peek16s(long long a) { return (long long)(short)id_peek_n(a, 2); }\nstatic long long id_peek32s(long long a) { return (long long)(int)id_peek_n(a, 4); }\nstatic long long id_peek8u(long long a)  { return id_peek_n(a, 1); }\nstatic long long id_peek16u(long long a) { return id_peek_n(a, 2); }\nstatic long long id_peek32u(long long a) { return id_peek_n(a, 4); }\nstatic void id_fail(const char* m) { id_trap(m); }\n\n/* Bridges between the store and id's own strings, so a program working in\n   the store can still print. */\nstatic char* id_str_of_mem(long long addr, long long n) {\n    if (n < 0) id_trap(\"negative length\");\n    unsigned char* p = id_at(addr, n);\n    if (memchr(p, 0, (size_t)n)) id_trap(\"a NUL byte reached a string (str_of_mem): use idstd stdio_slurp or stdio_read_mem, or the store (fs_read_mem), for binary data\");\n    return id_str_from((const char*)p, (size_t)n);\n}\nstatic long long id_mem_of_str(const char* s) {\n    size_t n = id_slen(s);\n    long long a = id_mem_alloc((long long)n + 1);\n    memcpy(id_store + a, s, n + 1);\n    return a;\n}\nstatic char* id_str_of_float(double x) {\n    char b[64]; int n = snprintf(b, sizeof b, \"%g\", x); return id_str_from(b, (size_t)n);\n}\nstatic void id_print(const char* s) { puts(s); }\nstatic char* id_input(void) {\n    /* read one whole line from stdin, drop the trailing newline; \"\" on EOF.\n       The block doubles as the line grows (like read_all), so a line of any\n       length comes back whole and reading stays linear in its length */\n    size_t cap = 64, n = 0, h = sizeof(size_t);\n    id_nalloc_s++;\n    char* r = (char*)id_pool_blk(cap);\n    int ch;\n    while ((ch = getc(stdin)) != EOF && ch != '\\n') {\n        if (h + n + 1 >= cap) {\n            if (cap > SIZE_MAX / 2) {\n                fprintf(stderr, \"id: allocation size overflow (input)\\n\");\n                exit(1);\n            }\n            r = (char*)id_realloc(r, cap, cap * 2);\n            cap *= 2;\n        }\n        r[h + n] = (char)ch;\n        n++;\n    }\n    r = (char*)id_realloc(r, cap, h + n + 1);\n    r += h;\n    if (memchr(r, 0, n)) id_trap(\"a NUL byte reached a string (input): use idstd stdio_slurp or stdio_read_mem, or the store (fs_read_mem), for binary data\");\n    ((size_t*)(void*)r)[-1] = n;\n    r[n] = '\\0';\n    return r;\n}\nstatic char* id_read_all(void) {\n    /* slurp all of stdin into one string (grows as needed); the count goes\n       in the block's first word, so the bytes are read in place after it */\n    size_t cap = 4096, n = 0, h = sizeof(size_t);\n    id_nalloc_s++;\n    char* r = (char*)id_pool_blk(cap);\n    for (;;) {\n        if (h + n + 1 >= cap) {\n            if (cap > SIZE_MAX / 2) {\n                fprintf(stderr, \"id: allocation size overflow (read_all)\\n\");\n                exit(1);\n            }\n            r = (char*)id_realloc(r, cap, cap * 2);\n            cap *= 2;\n        }\n        size_t got = fread(r + h + n, 1, cap - h - n - 1, stdin);\n        n += got;\n        if (got == 0) break;\n    }\n    r = (char*)id_realloc(r, cap, h + n + 1);\n    r += h;\n    if (memchr(r, 0, n)) id_trap(\"a NUL byte reached a string (read_all): use idstd stdio_slurp or stdio_read_mem, or the store (fs_read_mem), for binary data\");\n    ((size_t*)(void*)r)[-1] = n;\n    r[n] = '\\0';\n    return r;\n}\nstatic int id_len(const char* s) { return (int)id_slen(s); }\n/* character_code_at's bounds check is one load of the stored length, so walking a string\n   is O(n) however many strings are walked at once. */\nstatic int id_character_code_at(const char* s, int i) {\n    if (i < 0) return -1;\n    if ((size_t)i >= id_slen(s)) return -1;        /* out of range -> -1 */\n    return (unsigned char)s[i];\n}\nstatic char* id_chr(int code) {\n    if ((char)code == 0) id_trap(\"a NUL byte reached a string (chr(0)): a string cannot hold NUL; use the store (poke8) for binary data\");\n    char c = (char)code;\n    return id_str_from(&c, 1);\n}\n/* The n bytes of s from i, as a block of their own: one bounds check, one\n   allocation, one copy. An empty span reads nothing, so it is inside wherever\n   i >= 0. */\nstatic char* id_str_sub(const char* s, int i, int n) {\n    size_t m = id_slen(s);\n    if (i < 0 || n < 0 || (n > 0 && (size_t)i + (size_t)n > m)) {\n        fprintf(stderr, \"id: str span out of bounds: i=%d n=%d in a string of length %zu; clamp i and n first (fixed_point_minimum, fixed_point_maximum)\\n\", i, n, m);\n        exit(1);\n    }\n    return id_str_from(n ? s + i : s, (size_t)n);\n}\n/* bytes: a mutable, growable buffer of bytes, one byte per cell, passed by\n   reference like a list. It is one pool block, a header (len, cap, data) with\n   the first cells inline; growth takes a separate block for the cells and the\n   first inline bytes then hold the capacity the header block was made with,\n   which is what gives the block back at the right size. A cell is read as\n   0..255 and a store outside that range traps. The capacity is never below 8\n   so the inline area can hold that number. */\ntypedef struct { int len, cap; unsigned char* data; } IdBytes;\ntypedef struct { IdBytes h; unsigned char c[8]; } IdBytesBlk;\n#define ID_BYTES_CELLS(B) (((IdBytesBlk*)(void*)(B))->c)\n#define ID_BYTES_BYTES(n) (__builtin_offsetof(IdBytesBlk, c) + (size_t)(n))\nstatic IdBytes* id_bytes_make(long long len, long long cap) {\n    id_nalloc++;\n    IdBytesBlk* B = (IdBytesBlk*)id_pool_blk(ID_BYTES_BYTES(cap));\n    B->h.len = (int)len; B->h.cap = (int)cap; B->h.data = B->c;\n    return &B->h;\n}\nstatic IdBytes* id_bytes_new(int n) {\n    if (n < 0 || n > INT_MAX) id_trap(\"bytes_new: length out of range\");\n    IdBytes* B = id_bytes_make(n, n < 8 ? 8 : n);\n    memset(B->data, 0, (size_t)n);\n    return B;\n}\nstatic void id_bytes_free(IdBytes* B) {\n    if (!B) return;\n    id_nfree++;\n    if (id_fguard < 0) { const char* e = getenv(\"ID_FREE_GUARD\"); id_fguard = (e && e[0] == '1'); }\n    if (id_fguard) {\n        if (B->cap == INT_MIN) id_freed_trap();\n        int c = B->cap < 0 ? -B->cap : B->cap;\n        memset(B->data, 0xDD, (size_t)c);\n        B->len = -1; B->cap = INT_MIN;\n        return;\n    }\n    size_t c = (size_t)(B->cap < 0 ? -B->cap : B->cap);\n    unsigned char* inl = ID_BYTES_CELLS(B);\n    if (B->data == inl) { id_pool_free(B, ID_BYTES_BYTES(c)); return; }\n    size_t ic;\n    memcpy(&ic, inl, sizeof ic);\n    id_pool_free(B->data, c);\n    id_pool_free(B, ID_BYTES_BYTES(ic));\n}\nstatic void id_list_free_bytes(IdList* L) {\n    if (!L) return;\n    if (L->cap != INT_MIN) { for (int i = 0; i < L->len; i++) id_bytes_free((IdBytes*)(intptr_t)L->data[i]); }\n    id_list_free(L);\n}\nstatic void id_bytes_mut_check(IdBytes* B) {\n    if (B->cap < 0) {\n        if (B->cap == INT_MIN) id_freed_trap();\n        id_trap(\"cannot mutate a constant bytes\");\n    }\n}\nstatic _Noreturn void id_bytes_oob(IdBytes* B, long long i) {\n    if (B->cap == INT_MIN) id_freed_trap();\n    fprintf(stderr, \"id: index %lld out of bounds (len %d)\\n\", i, B->len);\n    exit(1);\n}\nstatic _Noreturn void id_byte_range(long long v) {\n    fprintf(stderr, \"id: byte value %lld out of range 0..255\\n\", v);\n    exit(1);\n}\nstatic unsigned char id_byte_fit(long long v) {\n    if (v < 0 || v > 255) id_byte_range(v);\n    return (unsigned char)v;\n}\nstatic int id_bytes_len_raw(IdBytes* B) { return B ? B->len : -1; }\nstatic int id_bytes_cap_raw(IdBytes* B) { return B ? B->cap : -1; }\nstatic int id_bytes_len(IdBytes* B) { if (!B) id_null_read(); if (B->len < 0) id_freed_trap(); return B->len; }\nstatic long long id_bytes_get(IdBytes* B, int i) {\n    if (!B) id_null_read();\n    if (i < 0 || i >= B->len) id_bytes_oob(B, i);\n    return B->data[i];\n}\nstatic void id_bytes_set(IdBytes* B, int i, long long v) {\n    if (!B) id_null_read();\n    id_bytes_mut_check(B);\n    if (i < 0 || i >= B->len) id_bytes_oob(B, i);\n    B->data[i] = id_byte_fit(v);\n}\nstatic void id_bytes_store(IdBytes* B, int i, long long v) {\n    if (!B) id_null_read();\n    id_bytes_mut_check(B);\n    if (i < 0 || i >= B->len) id_bytes_oob(B, i);\n    B->data[i] = (unsigned char)v;\n}\nstatic long long id_bytes_cell(IdBytes* B, int i) { return B->data[i]; }\nstatic void id_bytes_cell_set(IdBytes* B, int i, long long v) { B->data[i] = id_byte_fit(v); }\nstatic IdBytes* id_bytes_lit(int n, ...) {\n    IdBytes* R = id_bytes_make(n, n < 8 ? 8 : n);\n    va_list ap; va_start(ap, n);\n    for (int k = 0; k < n; k++) R->data[k] = id_byte_fit(va_arg(ap, long long));\n    va_end(ap);\n    return R;\n}\nstatic void id_bytes_show(IdBytes* B) {\n    fputs(\"[\", stderr);\n    for (int i = 0; i < B->len; i++) fprintf(stderr, \"%s0x%02X\", i ? \", \" : \"\", B->data[i]);\n    fputs(\"]\", stderr);\n}\nstatic void id_bytes_reserve(IdBytes* B, size_t need) {\n    if ((size_t)B->cap >= need) return;\n    if (need > INT_MAX) id_trap(\"bytes capacity overflow\");\n    size_t ncap = (size_t)B->cap * 2;\n    if (ncap < need) ncap = need;\n    if (ncap > INT_MAX) ncap = INT_MAX;\n    ID_MEM_CHARGE(ncap);\n    unsigned char* inl = ID_BYTES_CELLS(B);\n    if (B->data == inl) {\n        unsigned char* nd = (unsigned char*)id_pool_get(ncap);\n        size_t ic = (size_t)B->cap;\n        memcpy(nd, inl, (size_t)B->len);\n        memcpy(inl, &ic, sizeof ic);\n        B->data = nd;\n    } else {\n        B->data = (unsigned char*)id_realloc(B->data, (size_t)B->cap, ncap);\n    }\n    B->cap = (int)ncap;\n}\nstatic void id_bytes_push(IdBytes* B, long long v) {\n    if (!B) id_null_read();\n    id_bytes_mut_check(B);\n    unsigned char b = id_byte_fit(v);\n    if (B->len >= B->cap) id_bytes_reserve(B, (size_t)B->len + 1);\n    B->data[B->len++] = b;\n}\nstatic long long id_bytes_pop(IdBytes* B) {\n    if (!B) id_null_read();\n    id_bytes_mut_check(B);\n    if (B->len <= 0) id_trap(\"pop from empty bytes\");\n    return B->data[--B->len];\n}\nstatic void id_bytes_append(IdBytes* D, IdBytes* S) {\n    if (!D || !S) id_null_read();\n    id_bytes_mut_check(D);\n    if (S->len < 0) id_freed_trap();\n    size_t n = (size_t)S->len;\n    if (n == 0) return;\n    id_bytes_reserve(D, id_add_check((size_t)D->len, n, \"bytes_append\"));\n    memmove(D->data + D->len, S->data, n);\n    D->len += (int)n;\n}\nstatic IdBytes* id_bytes_sub(IdBytes* B, int i, int n) {\n    if (!B) id_null_read();\n    if (B->len < 0) id_freed_trap();\n    if (i < 0 || n < 0 || (n > 0 && (unsigned long long)i + (unsigned long long)n > (unsigned long long)B->len)) {\n        fprintf(stderr, \"id: bytes span out of bounds: i=%lld n=%lld in a bytes of length %d\\n\", i, n, B->len);\n        exit(1);\n    }\n    IdBytes* R = id_bytes_make(n, n < 8 ? 8 : n);\n    if (n) memcpy(R->data, B->data + i, (size_t)n);\n    return R;\n}\nstatic int id_bytes_cmp(IdBytes* A, IdBytes* B) {\n    if (!A || !B) id_null_read();\n    if (A->len < 0 || B->len < 0) id_freed_trap();\n    if (A->len != B->len) return 1;\n    return A->len ? memcmp(A->data, B->data, (size_t)A->len) : 0;\n}\nstatic IdBytes* id_bytes_of_string(const char* s) {\n    size_t n = id_slen(s);\n    if (n > INT_MAX) id_trap(\"bytes_of_string: string too long\");\n    IdBytes* R = id_bytes_make((long long)n, n < 8 ? 8 : (long long)n);\n    memcpy(R->data, s, n);\n    return R;\n}\nstatic char* id_string_of_bytes(IdBytes* B) {\n    if (!B) id_null_read();\n    if (B->len < 0) id_freed_trap();\n    if (B->len > 0 && memchr(B->data, 0, (size_t)B->len)) id_trap(\"a NUL byte reached a string (string_of_bytes): look for it first with idstd bytes_find(b, 0), or keep the data in bytes\");\n    return id_str_from((const char*)B->data, (size_t)B->len);\n}\nstatic IdBytes* id_bytes_of_memory(long long addr, int n) {\n    if (n < 0 || n > INT_MAX) id_trap(\"bytes_of_memory: length out of range\");\n    unsigned char* p = id_at(addr, n);\n    IdBytes* R = id_bytes_make(n, n < 8 ? 8 : n);\n    memcpy(R->data, p, (size_t)n);\n    return R;\n}\nstatic long long id_memory_of_bytes(IdBytes* B) {\n    if (!B) id_null_read();\n    if (B->len < 0) id_freed_trap();\n    long long a = id_mem_alloc((long long)B->len);\n    if (B->len) memcpy(id_store + a, B->data, (size_t)B->len);\n    return a;\n}\n\n/* real-time terminal I/O: write without a newline, flush, poll a single key\n   without blocking (raw mode is entered lazily and restored at exit), and\n   sleep. Together these let id drive an animated full-screen frame loop. */\nstatic void id_put(const char* s) { fputs(s, stdout); }\nstatic void id_flush(void) { fflush(stdout); }\n#ifndef __wasi__\nstatic struct termios id_saved_termios;\nstatic int id_raw_active = 0;\nstatic void id_term_restore(void) {\n    if (id_raw_active) {\n        tcsetattr(STDIN_FILENO, TCSANOW, &id_saved_termios);\n        id_raw_active = 0;\n    }\n}\nstatic void id_term_raw(void) {\n    struct termios t;\n    if (id_raw_active) return;\n    if (tcgetattr(STDIN_FILENO, &id_saved_termios) != 0) return;\n    t = id_saved_termios;\n    t.c_lflag &= ~(tcflag_t)(ICANON | ECHO);\n    t.c_cc[VMIN] = 0; t.c_cc[VTIME] = 0;   /* read() returns at once, 0 on no key */\n    tcsetattr(STDIN_FILENO, TCSANOW, &t);\n    id_raw_active = 1;\n    atexit(id_term_restore);\n}\nstatic int id_getkey(void) {\n    unsigned char c;\n    id_term_raw();\n    if (read(STDIN_FILENO, &c, 1) == 1) return (int)c;\n    return -1;   /* no key available this poll */\n}\n#else\nstatic void id_term_restore(void) {}\nstatic void id_term_raw(void) {}\nstatic int id_getkey(void) { return -1; }\n#endif\nstatic void id_sleep_ms(int ms) {\n    struct timespec ts;\n    if (ms < 0) ms = 0;\n    ts.tv_sec = ms / 1000;\n    ts.tv_nsec = (long)(ms % 1000) * 1000000L;\n    nanosleep(&ts, NULL);\n}\nstatic int id_ticks(void) {   /* monotonic milliseconds, for timing and seeding */\n    struct timespec ts;\n    clock_gettime(CLOCK_MONOTONIC, &ts);\n    return (int)(ts.tv_sec * 1000 + ts.tv_nsec / 1000000);\n}";
// eprint's helper for the LLVM target's runtime, which is asked for once per
// build and without the program, so it cannot know whether eprint is called and
// always defines it. It has no harness to answer to: the cases of any build run
// in the C harness.
string c_crt_eprint = "void id_eprint(const char* s) { fflush(stdout); fprintf(stderr, \"%s\\n\", s); }";
// The closure runtime's text (docs/SPEC.md 1.1.1): its types, its object
// operations, and the rest -- what a native boundary, a case's comparison and
// the LLVM target's calls need. A closure has no function pointer to give a
// native, so id_fn_raw stops the program there with the fix named; two function
// values are equal when they are the same object, or the same function holding
// the same number of cells with the same bits. The calls a module the LLVM
// target prints makes keep an object opaque to the module and to idrun.
string c_clo_types = "/* closures: every function value is a pointer to one of these (docs/SPEC.md 1.1.1) */\ntypedef struct IdFn { void* fn; void* raw; long long n; } IdFn;\n#define ID_FNC(f) ((long long*)((char*)(f) + sizeof(IdFn)))\n#define ID_FNV(x) ({ extern IdFn idfn_o_##x; &idfn_o_##x; })";
string c_clo_ops = "ID_CLO IdFn* id_clo_make(void* fn, int n) {\n    IdFn* o = (IdFn*)id_alloc(id_add_check(sizeof(IdFn), id_mul_check(sizeof(long long), (size_t)n + 1, \"closure\"), \"closure\"));\n    memset(ID_FNC(o), 0, ((size_t)n + 1) * sizeof(long long));\n    o->fn = fn; o->raw = 0; o->n = n;\n    return o;\n}\nID_CLO IdFn* id_clo_new(const IdFn* t) { return id_clo_make(t->fn, (int)t->n); }\nID_CLO IdFn* id_clo_set(IdFn* o, int i, long long v) { ID_FNC(o)[i] = v; return o; }\nID_CLO IdFn* id_clo_setl(IdFn* o, int i, long long v) {\n    ID_FNC(o)[i] = v;\n    if (i < 63) ID_FNC(o)[o->n] |= 1LL << i;\n    return o;\n}\nID_CLO void id_clo_free(IdFn* o) {\n    if (!o) return;\n    if (id_fguard < 0) { const char* e = getenv(\"ID_FREE_GUARD\"); id_fguard = (e && e[0] == '1'); }\n    if (o->n < 0) id_freed_trap();\n    long long m = ID_FNC(o)[o->n];\n    for (int i = 0; i < 63 && i < o->n; i++) if ((m >> i) & 1) id_list_free((IdList*)(intptr_t)ID_FNC(o)[i]);\n    size_t cells = (size_t)o->n + 1;\n    if (id_fguard) { memset(ID_FNC(o), 0xDD, cells * sizeof(long long)); o->n = -1; return; }\n    id_pool_free(o, sizeof(IdFn) + cells * sizeof(long long));\n}\nID_CLO IdList* id_clo_copy(IdList* L) {\n    if (!L) id_null_read();\n    IdList* M = id_list_new();\n    for (int i = 0; i < L->len; i++) id_list_push(M, L->data[i]);\n    id_list_lock(M);\n    return M;\n}";
string c_clo_cmp = "ID_CLO void* id_fn_raw(const IdFn* f) {\n    if (!f) id_null_read();\n    if (!f->raw) { fprintf(stderr, \"id: a closure cannot be passed to a native: it takes a plain function pointer; pass the function by name, or give the native the values another way\\n\"); exit(1); }\n    return f->raw;\n}\nID_CLO int id_fn_eq(const IdFn* a, const IdFn* b) {\n    return a == b || (a && b && a->fn == b->fn && a->raw == b->raw && a->n == b->n && memcmp(ID_FNC(a), ID_FNC(b), (size_t)a->n * sizeof(long long)) == 0);\n}\nID_CLO void* id_clo_fn(const IdFn* f) { if (!f) id_null_read(); return f->fn; }\nID_CLO long long id_clo_cell(const IdFn* f, int i) { if (!f) id_null_read(); return ID_FNC(f)[i]; }\nID_CLO IdFn* id_fn_plain(void* fn, void* raw) {\n    static ID_TLS IdFn* tab[64];\n    static ID_TLS int used = 0;\n    for (int i = 0; i < used; i++) if (tab[i]->fn == fn) return tab[i];\n    IdFn* o = id_clo_make(fn, 0);\n    o->raw = raw;\n    if (used < 64) tab[used++] = o;\n    return o;\n}";
// The test harness's C: the prelude that says a case's eprint writes to stdout by
// default (stderr is the channel its report comes back through; IDTC_EPRINT_TO is
// a variable, not a bare stdout, so an eprints clause can swap it for the call
// under test only), the part that follows the runtime, and the three that run and
// judge a case (fork, limits, counts).
string c_cnt_pre = "/* test harness (idc) -- the runtime below is counted */\n#define IDTC_EPRINT_TO (idtc_eprint_target ? idtc_eprint_target : stdout)\n#define _POSIX_C_SOURCE 200809L\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdarg.h>\n#include <stdint.h>\n#include <limits.h>\n#include <termios.h>\n#include <unistd.h>\n#include <time.h>\n#include <errno.h>\n#include <math.h>\n#include <signal.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n#include <sys/resource.h>\nstatic FILE* idtc_eprint_target = NULL;\nstatic long long id_ctr_time = 0;\nstatic long long id_ctr_mem = 0;\n#define ID_MEM_CHARGE(n) (id_ctr_mem += (long long)(n))\nstatic size_t idtc_strlen(const char* s) { size_t n = strlen(s); id_ctr_time += (long long)n; return n; }\n#undef strlen\n#define strlen(s) idtc_strlen(s)\n#define id_len idtc_rt_len\n#define id_concat idtc_rt_concat\n#define id_concat_f idtc_rt_concat_f";
string c_cnt_post = "#undef id_len\n#undef id_concat\n#undef id_concat_f\nstatic int id_len(const char* s) { id_ctr_time += (long long)id_slen(s); return (int)id_slen(s); }\nstatic char* id_concat(const char* a, const char* b) {\n    id_ctr_time += (long long)(id_slen(a) + id_slen(b));\n    return idtc_rt_concat(a, b);\n}\nstatic char* id_concat_f(char* a, char* b, int m) {\n    id_ctr_time += (long long)(id_slen(a) + id_slen(b));\n    return idtc_rt_concat_f(a, b, m);\n}\n#undef ID_MEM_CHARGE\n#undef strlen";
string c_tc_judge = "static long long idtc_max_of(const long long* v, int count) {\n    long long m = v[0];\n    for (int i = 1; i < count; i++) if (v[i] > m) m = v[i];\n    return m;\n}\nstatic double idtc_growth(const char* bound, long long n) {\n    double x = (double)(n < 1 ? 1 : n);\n    double lg = log2(x < 2 ? 2 : x);\n    if (strcmp(bound, \"O(1)\") == 0) return 1.0;\n    if (strcmp(bound, \"O(log n)\") == 0) return lg;\n    if (strcmp(bound, \"O(n)\") == 0) return x;\n    if (strcmp(bound, \"O(n log n)\") == 0) return x * lg;\n    return x * x;\n}\nstatic int idtc_claim(const int* g, int count, const char* kind, const char* bound) {\n    int lo = 0, hi = 0, spread = 0;\n    const long long* col = strcmp(kind, \"time\") == 0 ? idtc_t : idtc_m;\n    for (int i = 1; i < count; i++) {\n        if (idtc_n[g[i]] != idtc_n[g[0]]) spread = 1;\n        if (idtc_n[g[i]] < idtc_n[g[lo]]) lo = i;\n        if (idtc_n[g[i]] >= idtc_n[g[hi]]) hi = i;\n    }\n    if (!spread && count > 1) {\n        fprintf(stderr, \"%s: error: [%s:%s] has %d cases but they all give n = %lld, so there is no second input size to compare; n is the largest of every list length, string length and integer value among a case's arguments, so one large integer argument sets n for every case that has it. Make the size argument the largest value in each case (a smaller integer argument), or vary the integer, so the cases differ in n\\n\", idtc_where[g[0]], kind, bound, count, idtc_n[g[0]]);\n        return 1;\n    }\n    if (!spread) {\n        fprintf(stderr, \"%s: error: [%s:%s] needs a second case with a different input size to compare against\\n\", idtc_where[g[0]], kind, bound);\n        return 1;\n    }\n    long long c1 = col[g[lo]], c2 = col[g[hi]], n1 = idtc_n[g[lo]], n2 = idtc_n[g[hi]];\n    double allowed = (double)(c1 > 1 ? c1 : 1) * idtc_growth(bound, n2) / idtc_growth(bound, n1) * 4;\n    if ((double)c2 <= allowed) return 0;\n    fprintf(stderr, \"%s: error: [%s:%s] does not hold for '%s': %s is %lld at n=%lld and %lld at n=%lld, where %s allows at most %lld\\n\", idtc_where[g[hi]], kind, bound, idtc_fn[g[0]], kind, c1, n1, c2, n2, bound, (long long)allowed);\n    return 1;\n}\nstatic void idtc_counts(const char* path) {\n    FILE* f = fopen(path, \"w\");\n    if (!f) return;\n    for (int k = 0; k < IDTC_N; k++) fprintf(f, \"%s %d %lld %lld\\n\", idtc_fn[k], idtc_fidx[k], idtc_t[k], idtc_m[k]);\n    fclose(f);\n}\nstatic int* idtc_eoff;\nstatic int* idtc_eto;\nstatic int* idtc_hgt;\nstatic int* idtc_ff;\nstatic int* idtc_cul;\nstatic int idtc_height(int c) {\n    int h = 0;\n    if (idtc_hgt[c] >= 0) return idtc_hgt[c];\n    for (int i = idtc_eoff[c]; i < idtc_eoff[c + 1]; i++) {\n        int d = idtc_height(idtc_eto[i]) + 1;\n        if (d > h) h = d;\n    }\n    idtc_hgt[c] = h;\n    return h;\n}\nstatic int idtc_level(int k) {\n    return idtc_cc[k] >= 0 ? idtc_height(idtc_cc[k]) : 0;\n}\nstatic int idtc_culprit(int c) {\n    int r = -1;\n    if (idtc_cul[c] != -2) return idtc_cul[c];\n    for (int i = idtc_eoff[c]; i < idtc_eoff[c + 1] && r < 0; i++) {\n        int d = idtc_eto[i];\n        r = idtc_ff[d] >= 0 ? idtc_ff[d] : idtc_culprit(d);\n    }\n    idtc_cul[c] = r;\n    return r;\n}\nstatic int* idtc_plan(void) {\n    int ne = 0, nc, top = 0, most = 0;\n    int *ord, *at;\n    idtc_graph();\n    nc = idtc_nc;\n    while (idtc_ce[2 * ne] >= 0) ne++;\n    ord = malloc(sizeof(int) * (IDTC_N + 1));\n    at = malloc(sizeof(int) * (nc + 1));\n    idtc_eoff = calloc(nc + 2, sizeof(int));\n    idtc_eto = malloc(sizeof(int) * (ne + 1));\n    idtc_hgt = malloc(sizeof(int) * (nc + 1));\n    idtc_ff = malloc(sizeof(int) * (nc + 1));\n    idtc_cul = malloc(sizeof(int) * (nc + 1));\n    if (!ord || !at || !idtc_eoff || !idtc_eto || !idtc_hgt || !idtc_ff || !idtc_cul) return NULL;\n    for (int e = 0; e < ne; e++) idtc_eoff[idtc_ce[2 * e] + 1]++;\n    for (int c = 0; c < nc; c++) {\n        idtc_eoff[c + 1] += idtc_eoff[c];\n        at[c] = idtc_eoff[c];\n        idtc_hgt[c] = -1;\n        idtc_ff[c] = -1;\n        idtc_cul[c] = -2;\n    }\n    for (int e = 0; e < ne; e++) idtc_eto[at[idtc_ce[2 * e]]++] = idtc_ce[2 * e + 1];\n    for (int k = 0; k < IDTC_N; k++) if (idtc_level(k) > most) most = idtc_level(k);\n    for (int h = 0; h <= most; h++)\n        for (int k = 0; k < IDTC_N; k++) if (idtc_level(k) == h) ord[top++] = k;\n    free(at);\n    return ord;\n}\nint main(int argc, char** argv) {\n    int bad = 0, failed = 0, unrun = 0, first = -1;\n    const char* idtc_show = getenv(\"IDC_SHOW_NOT_RUN\");\n    const char* idtc_skip = getenv(\"IDTC_SKIP\");\n    const char* idtc_pass = getenv(\"IDTC_PASSED\");\n    FILE* idtc_pf = idtc_pass ? fopen(idtc_pass, \"w\") : NULL;\n    const char* idtc_tk = getenv(\"IDTC_TICK\");\n    int idtc_tfd = idtc_tk ? atoi(idtc_tk) : -1;\n    unsetenv(\"IDTC_TICK\");\n    int* ord;\n    if (idtc_skip && (int)strlen(idtc_skip) != IDTC_N) idtc_skip = NULL;\n    id_fguard = 1;\n    idtc_setup();\n    idtc_dirs();\n    ord = idtc_plan();\n    if (!ord) { perror(\"idc: test harness\"); return 1; }\n    for (int j = 0; j < IDTC_N; j++) {\n        int k = ord[j], c = idtc_cc[k], why, one;\n        if (idtc_skip && idtc_skip[k] == '1') continue;\n        why = c >= 0 ? idtc_culprit(c) : -1;\n        if (why >= 0) {\n            if (first < 0) first = why;\n            if (idtc_show) fprintf(stderr, \"%s: not run: %s depends on %s, whose case at %s failed\\n\", idtc_where[k], idtc_call[k], idtc_fn[why], idtc_where[why]);\n            unrun++;\n            bad = 1;\n            if (idtc_tfd >= 0 && write(idtc_tfd, \".\", 1) < 0) idtc_tfd = -1;\n            continue;\n        }\n        one = idtc_one(k);\n        if (idtc_tfd >= 0 && write(idtc_tfd, \".\", 1) < 0) idtc_tfd = -1;\n        bad |= one;\n        if (one) failed++;\n        if (one && c >= 0 && idtc_ff[c] < 0) idtc_ff[c] = k;\n        if (!one && idtc_pf) fprintf(idtc_pf, \"%d\\n\", k);\n    }\n    if (idtc_pf) fclose(idtc_pf);\n    if (unrun) fprintf(stderr, \"idc: %d case(s) failed; %d more not run, because a function they call failed a case (the first failure was a case of '%s' at %s; set IDC_SHOW_NOT_RUN=1 to list each case not run)\\n\", failed, unrun, idtc_fn[first], idtc_where[first]);\n    if (bad) return 1;\n    if (argc > 1) idtc_counts(argv[1]);\n    return idtc_claims();\n}";
string c_tc_one = "static int idtc_one(int k) {\n    int err[2], cnt[2], st = 0;\n    char msg[4096];\n    size_t used = 0;\n    ssize_t r;\n    long long c[2] = {0, 0};\n    pid_t pid;\n    siginfo_t wi;\n    char scratch[4096];\n    const char *tmpbase = getenv(\"TMPDIR\");\n    snprintf(scratch, sizeof scratch, \"%s/idcase_XXXXXX\", (tmpbase && tmpbase[0] == '/') ? tmpbase : \"/tmp\");\n    if (pipe(err) != 0 || pipe(cnt) != 0) { perror(\"idc: test harness\"); return 1; }\n    if (!mkdtemp(scratch)) { perror(\"idc: test harness\"); return 1; }\n    fflush(NULL);\n    pid = fork();\n    if (pid < 0) { perror(\"idc: test harness\"); idtc_rmtree(scratch); return 1; }\n    if (pid == 0) {\n        setpgid(0, 0);\n        setenv(\"TMPDIR\", scratch, 1);\n        close(err[0]);\n        close(cnt[0]);\n        dup2(err[1], 2);\n        if (getenv(\"IDTC_READS\")) {\n            char rp[4096];\n            snprintf(rp, sizeof rp, \"%s/%d\", getenv(\"IDTC_READS\"), k);\n            setenv(\"IDTC_READLOG\", rp, 1);\n        }\n        if (idtc_dir[k] && chdir(idtc_dir[k]) != 0) {\n            fprintf(stderr, \"%s: test failed: %s could not run in %s: %s\\n\", idtc_where[k], idtc_call[k], idtc_dir[k], strerror(errno));\n            exit(3);\n        }\n        idtc_stdin_set(k);\n        idtc_limit(k);\n        exit(idtc_case[k](cnt[1]));\n    }\n    setpgid(pid, pid);\n    close(err[1]);\n    close(cnt[1]);\n    used = idtc_pull(err[0], msg, used, 50, pid);\n    while (waitid(P_PID, (id_t)pid, &wi, WEXITED | WNOWAIT) < 0) {\n        if (errno != EINTR) { perror(\"idc: test harness\"); return 1; }\n    }\n    kill(-pid, SIGKILL);\n    used = idtc_pull(err[0], msg, used, 200, 0);\n    msg[used] = '\\0';\n    idtc_nonblock(cnt[0]);\n    r = read(cnt[0], c, sizeof c);\n    close(err[0]);\n    close(cnt[0]);\n    idtc_rmtree(scratch);\n    while (waitpid(pid, &st, 0) < 0) {\n        if (errno != EINTR) { perror(\"idc: test harness\"); return 1; }\n    }\n    if (WIFEXITED(st) && WEXITSTATUS(st) == 0 && r == (ssize_t)sizeof c) {\n        idtc_t[k] = c[0];\n        idtc_m[k] = c[1];\n        return 0;\n    }\n    if (WIFEXITED(st) && WEXITSTATUS(st) == 3) {\n        fputs(msg, stderr);\n        return 1;\n    }\n    if (idtc_traps[k]) {\n        return idtc_trap_match(k, st, msg);\n    }\n    idtc_report(k, st, msg);\n    return 1;\n}";
string c_tc_proc = "static const char* idtc_where[IDTC_N];\nstatic const char* idtc_call[IDTC_N];\nstatic const char* idtc_fn[IDTC_N];\nstatic int idtc_fidx[IDTC_N];\nstatic int (*idtc_case[IDTC_N])(int);\nstatic long long idtc_t[IDTC_N];\nstatic long long idtc_m[IDTC_N];\nstatic long long idtc_n[IDTC_N];\nstatic const char* idtc_in[IDTC_N];\nstatic int idtc_secs[IDTC_N];\nstatic const char* idtc_traps[IDTC_N];\nstatic void idtc_setup(void);\nstatic int idtc_claims(void);\nstatic const char* idtc_dir[IDTC_N];\nstatic void idtc_dirs(void);\nstatic const int* idtc_cc;\nstatic const int* idtc_ce;\nstatic int idtc_nc;\nstatic void idtc_graph(void);\n#define IDTC_SECONDS 30\n#define IDTC_MEMORY ((rlim_t)1 << 32)\nstatic int idtc_secs_of(int k) {\n    return idtc_secs[k] > 0 ? idtc_secs[k] : IDTC_SECONDS;\n}\nstatic void idtc_limit(int k) {\n    struct rlimit rl;\n    alarm(idtc_secs_of(k));\n    if (getrlimit(RLIMIT_AS, &rl) == 0 && (rl.rlim_max == RLIM_INFINITY || rl.rlim_max > IDTC_MEMORY)) {\n        rl.rlim_cur = IDTC_MEMORY;\n        setrlimit(RLIMIT_AS, &rl);\n    }\n}\nvoid idtc_rmtree(const char*);\nsize_t idtc_pull(int, char*, size_t, int, pid_t);\nvoid idtc_nonblock(int);\nstatic void idtc_stdin_set(int k) {\n    FILE* f = tmpfile();\n    if (!f) return;\n    fputs(idtc_in[k], f);\n    fflush(f);\n    rewind(f);\n    dup2(fileno(f), 0);\n    fclose(f);\n}\nstatic void idtc_report(int k, int st, char* msg) {\n    size_t n = strlen(msg);\n    while (n > 0 && msg[n - 1] == '\\n') msg[--n] = '\\0';\n    fprintf(stderr, \"%s: test failed: %s \", idtc_where[k], idtc_call[k]);\n    if (WIFSIGNALED(st) && WTERMSIG(st) == SIGALRM)\n        fprintf(stderr, \"did not finish within %d seconds\\n\", idtc_secs_of(k));\n    else if (WIFSIGNALED(st))\n        fprintf(stderr, \"was killed by signal %d (%s)\\n\", WTERMSIG(st), strsignal(WTERMSIG(st)));\n    else if (n > 0 && strstr(msg, \"out of memory\"))\n        fprintf(stderr, \"trapped: %s (a case may use at most %d MiB)\\n\", msg, (int)(IDTC_MEMORY >> 20));\n    else if (n > 0)\n        fprintf(stderr, \"trapped: %s\\n\", msg);\n    else\n        fprintf(stderr, \"exited with status %d\\n\", WEXITSTATUS(st));\n}\nstatic int idtc_trap_match(int k, int st, char* msg) {\n    char sigmsg[256];\n    size_t mn = strlen(msg);\n    while (mn > 0 && msg[mn - 1] == '\\n') msg[--mn] = '\\0';\n    if (WIFSIGNALED(st) && WTERMSIG(st) != SIGALRM) {\n        snprintf(sigmsg, sizeof sigmsg, \"killed by signal %d (%s)\", WTERMSIG(st), strsignal(WTERMSIG(st)));\n        if (strstr(sigmsg, idtc_traps[k]) != NULL) return 0;\n        fprintf(stderr, \"%s: test failed: %s trapped: %s, expected a trap containing %s\\n\", idtc_where[k], idtc_call[k], sigmsg, idtc_traps[k]);\n        return 1;\n    }\n    if (WIFEXITED(st) && WEXITSTATUS(st) != 0 && strlen(msg) > 0) {\n        if (strstr(msg, idtc_traps[k]) != NULL) return 0;\n        fprintf(stderr, \"%s: test failed: %s trapped: %s, expected a trap containing %s\\n\", idtc_where[k], idtc_call[k], msg, idtc_traps[k]);\n        return 1;\n    }\n    idtc_report(k, st, msg);\n    return 1;\n}";
// The C a case's output capture emits around the call under test (back/tgt/c/emit/
// prog/test/case/around/then/more/capture/): stdout redirected to a temp file
// for a prints clause, eprint's target swapped for an eprints clause, recording
// turned on for a calls clause, and each read back or turned off afterwards.
string c_cap_out_pre = "    fflush(stdout);\n    FILE* idtc_out_tmp = tmpfile();\n    int idtc_out_save = dup(1);\n    dup2(fileno(idtc_out_tmp), 1);";
string c_cap_err_pre = "    idtc_eprint_target = tmpfile();";
string c_cap_calls_pre = "    idtc_rec_on = 1;\n    long long idtc_seek = -1;";
string c_cap_calls_post = "    idtc_rec_on = 0;";
string c_cap_out_post = "    fflush(stdout);\n    dup2(idtc_out_save, 1);\n    close(idtc_out_save);\n    long idtc_out_len = ftell(idtc_out_tmp);\n    fseek(idtc_out_tmp, 0, SEEK_SET);\n    char* idtc_out_buf = malloc((size_t)idtc_out_len + 1);\n    if (idtc_out_len > 0) { size_t idtc_out_rd = fread(idtc_out_buf, 1, (size_t)idtc_out_len, idtc_out_tmp); (void)idtc_out_rd; }\n    idtc_out_buf[idtc_out_len] = 0;\n    fclose(idtc_out_tmp);";
string c_cap_err_post = "    fflush(idtc_eprint_target);\n    long idtc_err_len = ftell(idtc_eprint_target);\n    fseek(idtc_eprint_target, 0, SEEK_SET);\n    char* idtc_err_buf = malloc((size_t)idtc_err_len + 1);\n    if (idtc_err_len > 0) { size_t idtc_err_rd = fread(idtc_err_buf, 1, (size_t)idtc_err_len, idtc_eprint_target); (void)idtc_err_rd; }\n    idtc_err_buf[idtc_err_len] = 0;\n    fclose(idtc_eprint_target);\n    idtc_eprint_target = NULL;";
// Word sets, asked with str_in (mid/names/symbols/lookup/more/map.id): the operator
// classes of the grammar and the checks (relational includes id's bare `=`, which is
// equality inside an expression), the type words a statement can start with, the
// builtins the checks treat alike, the LLVM casts and the IR opcodes that have an
// effect, and the complexity words a bounds clause may name.
string[] mulops = ["*", "/", "%"];
string[] relops = ["==", "!=", "<", ">", "<=", ">=", "="];
string[] unops = ["-", "!", "~"];
string[] shiftops = ["<<", ">>"];
string[] typewords = ["int", "float", "string", "void", "word", "export", "func", "bytes"];
string[] mutnames = ["push", "pop"];
// asgops: both spellings of equality; a statement that is one compares instead of
// assigning. idc.py's parser folds `=` into `==` on the way in, so by the time
// either compiler has an AST there is one operator.
string[] asgops = ["=", "=="];
string[] logops = ["&&", "||"];
string[] bitops = ["&", "|", "^", "<<", ">>"];
string[] arithops = ["+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>"];
string[] pokefns = ["poke8", "poke16", "poke32", "poke64"];
string[] freshfns = ["chr", "input", "read_all", "str_of_mem", "str_sub", "string_of_bytes", "bytes_new", "bytes_of_memory", "bytes_of_string", "bytes_sub"];
string[] castops = ["zext", "sext", "trunc", "sitofp", "fptosi", "ptrtoint", "inttoptr"];
string[] eqops = ["==", "!=", "="];
string[] ordops = ["<", ">", "<=", ">="];
string[] peekfns = ["peek8", "peek16", "peek32", "peek64", "peek8s", "peek16s", "peek32s", "peek8u", "peek16u", "peek32u"];
string[] bigo_words = ["O(1)", "O(log n)", "O(n)", "O(n log n)", "O(n^2)"];
string[] addops = ["+", "-"];
// irnoeff: what may not be removed for having no users. A call is here because
// nothing tells this compiler which calls are pure -- every builtin that matters
// is a runtime call, and print's users are the point of it.
string[] irnoeff = ["store", "call", "ret", "br", "cbr", "nop", "param"];
// Node kinds asked in sets with str_in: the numeric leaves (a negative literal is
// a unary minus over one), the declarations a variable table is built from, and
// the two kinds that name a variable -- var and import -- whose type is the
// variable's.
string[] numkinds = ["int", "float"];
string[] declkinds = ["decl", "param"];
string[] namekinds = ["var", "import"];
// The tokens that may follow an identifier at the cursor (ident_then,
// front/parse/stmt/dispatch/more/is_assign.id): `=` makes the statement an
// assignment, `[` or `.` an element or field store, and `(` a constructor in a
// case. A bare name in a case's tuple is a function when nothing but the end of
// the element follows it (`,` or `)`): `f(1)` is a call and `f[0]` an index,
// neither of which a case may hold.
string[] nx_eq = ["="];
string[] nx_index = ["[", "."];
string[] nx_call = ["("];
string[] nx_elem_end = [",", ")"];
// The why and help lines of the two refused float literals (E0103, E0104;
// front/parse/expr/atom/kind/floatlit/check.id).
string flt_exp_why = "an exponent is 'e' or 'E', an optional sign and at least one digit, so this text names no number; it is not read as a number followed by a variable called e";
string flt_exp_help = "write the digits after the 'e', as in 1e5, 1.5E+3 or 6.02e-23, or delete the 'e' if it was a typo";
string flt_big_why = "a float is an IEEE-754 binary64 and its largest finite value is about 1.7976931348623157e308; a literal beyond that rounds to infinity, which a literal cannot be";
string flt_big_help = "write a value no larger than 1.7976931348623157e308, or lower the exponent";
// The why and help lines of the three limit diagnostics (E0201 a block of more
// than three actions, E0202 nesting deeper than two, E0204 a chain after a
// segment with room left), passed to limit_diag
// (mid/names/limits/report/actions.id) by the checks in limits/shape/block/.
string lim_actions_why = "a block that does more than three things is hard to read and to test at a glance, so the language caps it; a chain is the one way to continue a function past the cap without hiding that it does";
string lim_actions_help = "continue the function into a chain: end this segment with `} chain (same parameters) {` and write the remaining statements after it (docs/SPEC.md, section 9), or move part of the block into its own function";
string lim_deep_why = "three open conditions or loops at once is more than a reader can hold in mind, so the language caps nesting at two levels";
string lim_deep_help = "move the innermost block into its own function and call it from here; the new function gets its own two levels and its own test cases";
string lim_seg_why = "a function has one way to continue past the action limit, so a chain is only for a segment that has run out of room (docs/SPEC.md, section 9)";
string lim_seg_help = "give this segment exactly 3 actions before the chain by moving the chain's first statement up into it; if that statement is an if/else (2 actions) and only one slot is free, pad the segment with `blank`";
// The why and help lines of the two name-conflict diagnostics that name one
// word (E0308 a variable named like a function, E0306 a variable called as a
// function), passed to report_name (mid/names/symbols/check/conflict/more/
// messages.id).
string nm_func_why = "a function and a variable cannot share a name, because a call and a read of the name would look alike";
string nm_func_help = "rename the variable, or the function if the variable's name is the better one";
string nm_callvar_why = "a call runs a function by its name; a variable holds a value, and only a variable of a function type (`func(...) return T`) can be called";
string nm_callvar_help = "call a function by its own name, or drop the parentheses if you meant to read the variable";
// The separator in the name of a function value's adapter: the function's name,
// this, and the number of values bound into it (idfn_a_tick__0).
string fv_sep = "__";
// The why of E0311 (a name with a piece that is not a word, mid/form/words/),
// and what the diagnostic calls each table the word scan reads, by the kind
// number the scan passes: function, variable, export, struct, struct field.
string vocab_why = "a name is read by people who did not write it, so each part of it has to be a word they already know; an abbreviation means one thing to its author and another to everyone else";
string[] vocab_labels = ["function", "variable", "exported name", "struct", "struct field"];
