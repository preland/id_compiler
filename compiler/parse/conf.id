// The parser stage's constants. Each is a program global, initialised before
// main and read with (import name); none needs a function to hold it.
//
// idx_n: the number of buckets in the symbol index (mid/names/symbols/lookup/).
// A prime, so that the final `%` mixes all sixteen bits of the hash rather than
// keeping the low ones. About 1300 names in this compiler, so five or so per
// bucket.
//
// builtin_src: the builtin names, as one space-separated literal split into
// `bnames` at startup (mid/names/exports/extern/builtin/). The order is idc.py's
// BUILTIN_NAMES order, not alphabetical: the fourteen ordinary builtins first,
// then the flat-store and unsigned-word group, so the printed list reads the
// same under both compilers -- up to eprint, which idc.py does not have and so
// comes last.
int idx_n = 251;
string builtin_src = "print input read_all len push pop to_int character_code_at chr put flush getkey sleep_ms ticks alloc store_size peek8 peek16 peek32 peek64 poke8 poke16 poke32 poke64 udiv umod ult ushr rotl umul_hi uword_of_int add_checked sub_checked mul_checked str_of_mem mem_of_str eprint peek8s peek16s peek32s peek8u peek16u peek32u bits_of_float float_of_bits bits32_of_float float_of_bits32 fail bind str_sub character_code_at bytes_new bytes_sub bytes_append string_of_bytes bytes_of_string bytes_of_memory memory_of_bytes";
// The runtime helper names (compiler/parse/back/tgt/c/runtime/prelude.id),
// space-separated: an id function may not be named after one of these,
// because every id function is emitted as id_<name> and would collide with
// the runtime in C. is_reserved_name (mid/form/unique/scan/more/reserved/
// check.id) is what catches it, over resv_names, which mid/names/exports/
// extern/builtin/more/names.id's init_resv_names splits this string into at
// startup. Kept in step with runtime.id by hand; tests/stdlib.sh asserts the
// two agree.
string resv_names_src = "add_check alloc arena_free_all arena_link arena_unlink at bits32_of_float bits_of_float box_f byte_fit byte_range bytes_append bytes_cap_raw bytes_cell bytes_cell_set bytes_cmp bytes_free bytes_get bytes_len bytes_len_raw bytes_lit bytes_make bytes_mut_check bytes_new bytes_of_memory bytes_of_string bytes_oob bytes_pop bytes_push bytes_reserve bytes_set bytes_show bytes_store bytes_sub character_code_at chr clo_cell clo_copy clo_fn clo_make clo_new clo_free clo_set clo_setl concat err_write exit fail float_of_bits float_of_bits32 flush fn_eq fn_plain fn_raw fprintf freed_trap getkey idiv imod input len list_adopt list_free list_free_bytes list_free_deep list_free_strs fr_skip free_walk frs_push frs_run list_get list_len list_lit list_lock list_mut_check list_new list_pop list_push list_set mem_alloc mem_of_str mem_size mul_check null_read peek16 peek16s peek16u peek32 peek32s peek32u peek64 peek8 peek8s peek8u peek_n poke16 poke32 poke64 poke8 poke_n print put read_all realloc sar sdiv shl sleep_ms slen smod store_grow store_span memory_of_bytes string_of_bytes str_from str_new str_of_cstr str_of_float str_of_int str_of_mem str_of_word term_raw term_restore thread_enter thread_leave ticks to_int trap trap_arm trap_disarm trap_raise trap_text udiv ult umod unbox_f ushr rotl rotl32 umul_hi uword_of_int add_checked add_checked32 sub_checked sub_checked32 mul_checked mul_checked32 arena_hook list_grow list_make list_sized pool_blk pool_carve pool_class pool_class_bytes pool_drop pool_free pool_get pool_has pool_large_alloc pool_large_free pool_oom pool_span str_free concat_f freed_str_trap str_dup list_cell list_cell_set list_len_raw list_cap_raw str_sub chan_new chan_sender chan_send chan_wait chan_take chan_close chan_of thr_main thr_spawn thr_join";
// What a case's key may promise about the natives and builtins it reaches
// (mid/form/unique/dump/digest/). A native is volatile unless it is on one of
// the two lists below, and a case that reaches a volatile one is never cached,
// whether or not it calls it. A case that reaches only listed natives is
// cached with the files it read recorded beside its key (docs/TESTS.md, "Files
// a case reads"). A name goes on a list only when the backend that implements
// it keeps the list's promise through the harness's read log ($IDTC_READLOG);
// a name listed without that would be cached with nothing to invalidate it.
// Processes, sockets, windows, stdio and temp files are on neither list.
//
// cache_file_natives: depends only on its arguments and the files it reads, and
// the backend logs every path it reads or probes, found or not (idstd's
// host/io/fs/fs_posix.c). fs_drop_exit only registers a /tmp tree for removal at
// exit, which is what lets fs_posix.c let a write into that tree through.
string[] cache_file_natives = ["fs_open", "fs_close", "fs_error", "fs_read", "fs_read_mem", "fs_size", "fs_exists", "fs_mtime", "fs_list", "fs_drop_exit"];
// cache_taint_natives: changes or reads something no read set can stand for (a
// write, the environment). The backend marks the case in the log when one is
// called, which keeps that case from being cached; a case that reaches one and
// never calls it is cached, since nothing it did depended on it. fs_posix.c
// lets a write through only when it is inside a tree the case registered with
// fs_drop_exit.
string[] cache_taint_natives = ["fs_write", "fs_write_mem", "fs_flush", "fs_mkdir", "fs_remove", "fs_rename", "fs_chmod", "env_has", "env_get", "env_set", "env_error"];
// Builtins whose result is not a function of the case and its files: the clock
// and the terminal. A case calling one is never cached.
string[] cache_volatile_builtins = ["ticks", "getkey"];
// The why and help lines of E0402 and E0405. Each is written by two places: the
// check of two functions of the program (mid/form/unique/.../report/dup.id,
// mid/form/decomp/checks/impdup/.../report/diag.id) and the check of a function
// of the program against one of the library that is not loaded
// (mid/names/symbols/check/conflict/more/core/ext/check/), so a collision with
// the library reads exactly as one inside the program does.
string dupd_why = "two functions with the same signature and the same logic are one function written twice, and every later fix would have to be made twice";
string dupd_help = "delete one and call the other from both places, or make them genuinely differ: a different signature, or different logic";
string imdd_why = "two functions that differ only in which imported value they read are one function written twice; the value is the only thing that varies, so it belongs in a parameter";
string imdd_help = "replace the import with a parameter, call that one function from both places, and delete the other";
// The why of E0407 (two functions that differ only in the values of their
// literals, mid/form/unique/scan/more/report/lit.id); its help names the two
// functions, so it is built where it is reported.
string litd_why = "two functions that differ only in the values of their literals are one function written twice; the values are all that varies, so they belong in parameters";
// The why of E0408 (a function that is one operation on its inputs, mid/form/decomp/
// checks/wsc/report.id); its help names the expression, so it is built where it is
// reported.
string wsc_why = "a function that is one operation on its inputs is a second spelling of that operation, and every reader has to open it to learn it is nothing more";
// The why and help lines of E0409 (an operation that cannot change its value) and
// E0410 (a local that is declared and never read), mid/form/decomp/checks/noop/.
// Both are padding, and padding is how a rule gets satisfied on paper: a rule
// that pushes someone to add it is the thing to report, so the help says so.
string noop_why = "an operation that cannot change its value is padding: it looks like work, hides the real expression from the reader, and leaves the code doing exactly what it did without it";
string noop_help = "remove it; if a rule made you add it, that rule needs a different fix -- report it";
string unread_why = "a local that is declared and never read is dead weight: every reader has to find out that nothing uses it, and it can be added only to satisfy a rule on paper";
string unread_help = "remove the declaration; if a rule made you add it, that rule needs a different fix -- report it";
// The why and help lines of E0303 for a variable the standard library also
// declares (mid/names/symbols/check/conflict/more/core/ext/check/pass/var/).
string svd_why = "a name must keep one type across the whole program, the standard library included, so that one name always means one kind of value wherever it appears";
string svd_help = "rename this variable so that it differs from the library's; the library's declaration is the one that cannot change";
// The why and help lines of E0310(a parameter with a generated name,
// mid/form/decomp/checks/genname/) and the why of E0406 (a pure forwarder,
// mid/form/decomp/checks/fwd/); E0406's help names the two functions, so it is
// built where it is reported.
string gnd_why = "a name that a rule invented says nothing about what the value is, and every caller that reads the parameter inherits it";
string gnd_help = "rename the parameter to what it holds, in the signature and at every use of it in the body";
string fwdd_why = "a function that passes all its parameters unchanged to another and returns the result adds a name to read and a call to follow, and says nothing the target does not";
// Where a float literal overflows to infinity (front/parse/expr/atom/kind/floatlit/
// more/big/over.id). flt_inf_digits is 2^1024 - 2^970, the exact point half an
// ulp past DBL_MAX where round-to-nearest-even goes to infinity, as the 309
// digits of an integer; flt_inf_pt is 309, the number of those digits.
int flt_inf_pt = 309;
string flt_inf_digits = "";
// The builtins a `pure` function may call (mid/types/check/store/assign/rule/
// escape/flow/pure/). Every other builtin is refused there: print, put, flush,
// eprint, input, read_all, getkey, sleep_ms and ticks do I/O or read the clock,
// and alloc, store_size, peek*, poke*, str_of_mem and mem_of_str read or write
// the flat store, which holds state that is not an argument. A builtin that is
// added later is refused until it is listed here.
string[] pure_builtins = ["len", "push", "pop", "to_int", "character_code_at", "chr", "udiv", "umod", "ult", "ushr", "rotl", "umul_hi", "uword_of_int", "add_checked", "sub_checked", "mul_checked", "fail", "bind", "bits_of_float", "float_of_bits", "bits32_of_float", "float_of_bits32", "str_sub", "bytes_new", "bytes_sub", "string_of_bytes", "bytes_of_string"];
// The tokens of a versioned loop's guard that stand for themselves, with no
// operand in their spelling (back/ir/build/stmt/flow/loop/guard/check.id): the
// others are names and literals, comparisons and sums (back/guard/token.id).
string[] gd_plain = ["null", "wide", "len", "cap", "slen", "|"];
// The IR opcode of an operator, looked up with str_map
// (mid/names/symbols/lookup/more/pick.id) in back/ir/build/expr/op/more/ctrl/
// irop/float.id: the integer table and the float one, each with the opcode of
// the operator that is in neither list (`&`, `+`) as its default, and the
// relational words LLVM spells a comparison with (back/tgt/ll/val/insn/ops/
// more/rel.id), `>=` being its default.
string[] irop_ik = ["+", "-", "*", "|", "^"];
string[] irop_iv = ["add", "sub", "mul", "or", "xor"];
string[] irop_fk = ["-", "*", "/"];
string[] irop_fv = ["fsub", "fmul", "fdiv"];
string[] llrel_k = ["<", ">", "<=", "u<"];
string[] llrel_v = ["lt", "gt", "le", "lt"];
// The C text the compiler prints for the runtime and for the test harness. Each
// is a constant, so it is one here and the code that prints it passes it to
// print -- not a function of its own per text, which is the same
// function written once per constant (docs/ERRORS.md, E0407).
// c_prelude_text: the C runtime prelude, printed verbatim so every target that
// splices C into one translation unit gets the same runtime. Source of truth:
// this constant (idc.py's RUNTIME, which used to generate it, is frozen -- see
// docs/HACKING.md). c_crt_text is the same runtime with external linkage, which
// the LLVM target links.
string c_crt_text = "/* generated by idc -- the `id` language compiler */\n#define _POSIX_C_SOURCE 200809L\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdarg.h>\n#ifndef __wasm__\n#include <pthread.h>\n#endif\n#include <stdint.h>\n#include <limits.h>\n#include <termios.h>\n#include <unistd.h>\n#include <time.h>\n\n/* ---- allocation pool -------------------------------------------------------\n   Every heap block the runtime allocates (lists, and the strings built by\n   concat/str_of_int/str_of_float/input/read_all/chr, and closures) comes from\n   id_pool_blk below, and carries no header: the caller says how big the block is\n   when it gives it back (id_pool_free), so the runtime stores no size and links no\n   list of blocks. A block of up to ID_POOL_MAX bytes is rounded up to a size\n   class and taken from that class's free list, or carved from the current\n   chunk, a ID_CHUNK-byte page malloc'd whole; a freed block goes back on its\n   class's free list and is reused by the next allocation of that class.\n   Chunks are what is released: at process exit (the hook is registered with\n   atexit on the first chunk), and at id_thread_leave for a worker thread, whose\n   pool is its own (ID_TLS) so no allocation takes a lock. A larger block is\n   one malloc with a two-pointer header, linked into one list that is swept at\n   exit; the header is what lets a realloc of it keep its place.\n   id_pool_has says whether an address lies in the span the chunks occupy, so a\n   later step can tell a heap block from a literal in the image by address. A\n   block that is not pool memory (a large block, a string from a native) is\n   not claimed by it.\n   Allocation failure and size overflow abort with a clear message instead of\n   continuing with a NULL pointer or a wrapped-around size. */\ntypedef struct IdAllocHdr { struct IdAllocHdr* prev; struct IdAllocHdr* next; } IdAllocHdr;\n#ifndef ID_TLS\n#ifdef __wasm__\n#define ID_TLS\n#else\n#define ID_TLS __thread\n#endif\n#endif\n#if !defined(exit) && !defined(__wasm__)\n#define ID_TRAPS 1\n#endif\n#ifdef ID_TRAPS\n#include <setjmp.h>\nstatic ID_TLS jmp_buf* id_trap_jb = NULL;\nstatic ID_TLS char id_trap_msg[512];\nstatic int id_fprintf(FILE* f, const char* fmt, ...) {\n    va_list ap;\n    va_start(ap, fmt);\n    int r = (f == stderr && id_trap_jb) ? vsnprintf(id_trap_msg, sizeof id_trap_msg, fmt, ap) : vfprintf(f, fmt, ap);\n    va_end(ap);\n    return r;\n}\nstatic _Noreturn void id_exit(int code) {\n    if (id_trap_jb) longjmp(*id_trap_jb, 1);\n    (exit)(code);\n}\n#define exit(code) id_exit(code)\n#define fprintf id_fprintf\njmp_buf* id_trap_arm(jmp_buf* jb) { jmp_buf* old = id_trap_jb; id_trap_jb = jb; id_trap_msg[0] = 0; return old; }\nvoid id_trap_disarm(jmp_buf* old) { id_trap_jb = old; }\nconst char* id_trap_text(void) { return id_trap_msg; }\n_Noreturn void id_trap_raise(const char* msg) { fprintf(stderr, \"%s\", msg); exit(1); }\n#endif\n#ifndef ID_MEM_CHARGE\n#define ID_MEM_CHARGE(n) ((void)0)\n#endif\n#ifdef __SANITIZE_ADDRESS__\nvoid __asan_poison_memory_region(void const volatile* a, size_t s);\nvoid __asan_unpoison_memory_region(void const volatile* a, size_t s);\n#define ID_POISON(p, n) __asan_poison_memory_region(p, n)\n#define ID_UNPOISON(p, n) __asan_unpoison_memory_region(p, n)\n#else\n#define ID_POISON(p, n) ((void)0)\n#define ID_UNPOISON(p, n) ((void)0)\n#endif\n#define ID_POOL_MAX 16384\n#define ID_POOL_SMALL 512\n#define ID_NCLASS 53\n#define ID_CHUNK 262144\n#define ID_CHUNK_HDR 16\n#define ID_LINK(p) (*(void**)((char*)(p) + 8))\ntypedef struct IdChunk { struct IdChunk* next; } IdChunk;\nID_TLS IdAllocHdr* id_arena_head = NULL;\nID_TLS int id_arena_hooked = 0;\nID_TLS long id_nfree = 0;\nID_TLS long id_nfree_s = 0;\nID_TLS long id_nalloc = 0;\nID_TLS long id_nalloc_s = 0;\nID_TLS void* id_pool_fl[ID_NCLASS];\nID_TLS char* id_pool_bump = NULL;\nID_TLS size_t id_pool_left = 0;\nID_TLS IdChunk* id_pool_chunks = NULL;\nuintptr_t id_pool_lo = UINTPTR_MAX;\nuintptr_t id_pool_hi = 0;\nvoid id_pool_drop(void) {\n    IdChunk* c = id_pool_chunks;\n    while (c) { IdChunk* nx = c->next; free(c); c = nx; }\n    id_pool_chunks = NULL; id_pool_bump = NULL; id_pool_left = 0;\n    memset(id_pool_fl, 0, sizeof id_pool_fl);\n}\nvoid id_arena_free_all(void) {\n    if (getenv(\"ID_ALLOC_STATS\")) {\n        fprintf(stderr, \"id: allocated %ld lists\\n\", id_nalloc);\n        fprintf(stderr, \"id: allocated %ld strings\\n\", id_nalloc_s);\n    }\n    if (getenv(\"ID_FREE_STATS\")) {\n        fprintf(stderr, \"id: freed %ld lists\\n\", id_nfree);\n        if (id_nfree_s) fprintf(stderr, \"id: freed %ld strings\\n\", id_nfree_s);\n    }\n    IdAllocHdr* h = id_arena_head;\n    while (h) { IdAllocHdr* nx = h->next; free(h); h = nx; }\n    id_arena_head = NULL;\n    id_pool_drop();\n}\nvoid id_arena_hook(void) {\n    if (!id_arena_hooked) { atexit(id_arena_free_all); id_arena_hooked = 1; }\n}\nvoid id_arena_link(IdAllocHdr* h) {\n    h->prev = NULL;\n    h->next = id_arena_head;\n    if (id_arena_head) id_arena_head->prev = h;\n    id_arena_head = h;\n    id_arena_hook();\n}\nvoid id_arena_unlink(IdAllocHdr* h) {\n    if (h->prev) h->prev->next = h->next; else id_arena_head = h->next;\n    if (h->next) h->next->prev = h->prev;\n}\nsize_t id_add_check(size_t a, size_t b, const char* what) {\n    if (a > SIZE_MAX - b) {\n        fprintf(stderr, \"id: allocation size overflow (%s)\\n\", what);\n        exit(1);\n    }\n    return a + b;\n}\nsize_t id_mul_check(size_t a, size_t b, const char* what) {\n    if (a != 0 && b > SIZE_MAX / a) {\n        fprintf(stderr, \"id: allocation size overflow (%s)\\n\", what);\n        exit(1);\n    }\n    return a * b;\n}\n/* String lengths. A `string` is a char* to NUL-terminated bytes, with the byte\n   count stored in the size_t just before them, so id_slen is one load: no\n   strlen and no memo. The layout is the one prelude.id documents; an LLVM\n   module writes the count itself, in front of each literal's bytes, and\n   builds argv strings with id_str_of_cstr. */\nsize_t id_slen(const char* s) { return ((const size_t*)(const void*)s)[-1]; }\n#define ID_S(lit) ({ static const struct { size_t n; char s[sizeof(lit)]; } id_l_ = { __builtin_strlen(lit), lit }; (char*)id_l_.s; })\n#define ID_SK(lit) ((char*)((const struct { size_t n; char s[sizeof(lit)]; }){ __builtin_strlen(lit), lit }).s)\n#ifdef __GNUC__\n__attribute__((noinline, cold))\n#endif\n_Noreturn void id_pool_oom(size_t n) {\n    fprintf(stderr, \"id: out of memory (%zu bytes)\\n\", n);\n    exit(1);\n}\nsize_t id_pool_class(size_t n) {\n    if (n <= ID_POOL_SMALL) return n ? (n + 15) >> 4 : 1;\n    size_t m = n - 1;\n    int e = 63 - __builtin_clzll(m);\n    return 33 + (size_t)(e - 9) * 4 + ((m >> (e - 2)) & 3);\n}\nsize_t id_pool_class_bytes(size_t k) {\n    if (k <= 32) return k << 4;\n    size_t j = k - 33;\n    int e = 9 + (int)(j >> 2);\n    return ((size_t)1 << e) + ((j & 3) + 1) * ((size_t)1 << (e - 2));\n}\nvoid id_pool_span(uintptr_t lo, uintptr_t hi) {\n#ifdef __wasm__\n    if (lo < id_pool_lo) id_pool_lo = lo;\n    if (hi > id_pool_hi) id_pool_hi = hi;\n#else\n    uintptr_t o = __atomic_load_n(&id_pool_lo, __ATOMIC_RELAXED);\n    while (lo < o && !__atomic_compare_exchange_n(&id_pool_lo, &o, lo, 1, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}\n    o = __atomic_load_n(&id_pool_hi, __ATOMIC_RELAXED);\n    while (hi > o && !__atomic_compare_exchange_n(&id_pool_hi, &o, hi, 1, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}\n#endif\n}\nint id_pool_has(const void* p) {\n    uintptr_t a = (uintptr_t)p;\n    return a >= id_pool_lo && a < id_pool_hi;\n}\nvoid* id_pool_carve(size_t bytes) {\n    if (id_pool_left < bytes) {\n        IdChunk* c = (IdChunk*)malloc(ID_CHUNK);\n        if (!c) id_pool_oom(bytes);\n        c->next = id_pool_chunks;\n        id_pool_chunks = c;\n        id_pool_span((uintptr_t)c, (uintptr_t)c + ID_CHUNK);\n        id_pool_bump = (char*)c + ID_CHUNK_HDR;\n        id_pool_left = ID_CHUNK - ID_CHUNK_HDR;\n        id_arena_hook();\n    }\n    void* p = id_pool_bump;\n    id_pool_bump += bytes;\n    id_pool_left -= bytes;\n    return p;\n}\nvoid* id_pool_large_alloc(size_t n) {\n    IdAllocHdr* h = (IdAllocHdr*)malloc(id_add_check(n, sizeof(IdAllocHdr), \"alloc\"));\n    if (!h) id_pool_oom(n);\n    id_arena_link(h);\n    return (void*)(h + 1);\n}\nvoid id_pool_large_free(void* p) {\n    IdAllocHdr* h = (IdAllocHdr*)p - 1;\n    id_arena_unlink(h);\n    free(h);\n}\nvoid* id_pool_get(size_t n) {\n    if (n > ID_POOL_MAX) return id_pool_large_alloc(n);\n    size_t k = id_pool_class(n);\n    void* p = id_pool_fl[k];\n    if (!p) return id_pool_carve(id_pool_class_bytes(k));\n    id_pool_fl[k] = ID_LINK(p);\n    ID_UNPOISON(p, id_pool_class_bytes(k));\n    return p;\n}\nvoid* id_pool_blk(size_t n) {\n    ID_MEM_CHARGE(n);\n    return id_pool_get(n);\n}\nvoid* id_alloc(size_t n) { return id_pool_blk(n); }\nvoid id_pool_free(void* p, size_t n) {\n    if (!p) return;\n    if (n > ID_POOL_MAX) { id_pool_large_free(p); return; }\n    size_t k = id_pool_class(n);\n    ID_LINK(p) = id_pool_fl[k];\n    id_pool_fl[k] = p;\n    ID_POISON(p, 8);\n    ID_POISON((char*)p + 16, id_pool_class_bytes(k) - 16);\n}\nvoid* id_realloc(void* p, size_t old, size_t n) {\n    ID_MEM_CHARGE(n);\n    if (!p) return id_pool_get(n);\n    if (old > ID_POOL_MAX && n > ID_POOL_MAX) {\n        IdAllocHdr* h = (IdAllocHdr*)p - 1;\n        id_arena_unlink(h);\n        IdAllocHdr* nh = (IdAllocHdr*)realloc(h, id_add_check(n, sizeof(IdAllocHdr), \"realloc\"));\n        if (!nh) id_pool_oom(n);\n        id_arena_link(nh);\n        return (void*)(nh + 1);\n    }\n    if (old <= ID_POOL_MAX && n <= ID_POOL_MAX && id_pool_class(old) == id_pool_class(n)) return p;\n    void* q = id_pool_get(n);\n    memcpy(q, p, old < n ? old : n);\n    id_pool_free(p, old);\n    return q;\n}\nchar* id_str_new(size_t n) {\n    id_nalloc_s++;\n    char* r = (char*)id_pool_blk(id_add_check(id_a