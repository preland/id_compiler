// The if form of ps4, once the condition and the then-branch are known.
ps4_if(int id, int i1_of_v2, int[] l1_of_v2) {
  int[] l2_of_v = l2_of(id);
  string s = "(if " + print_expr(i1_of_v2) + " (then" + print_list(l1_of_v2) + ") (else" + print_list(l2_of_v) + "))";
} return string s;
