// Expression printer (S-expression). Dispatch on node kind via a helper chain.
//   int  -> digits        var/str -> the text
//   bin  -> (op L R)       call    -> (call name ARGS)

print_expr(int id) {
  string s = "";
  if((import nkind)[id] == "int") {
    s = "" + (import ni1)[id];
  } else {
    s = pe_op(id);
  }
} return string s;
given bin_fix (0):("5")
given bin_fix (2):("(+ 5 x)")

pe_op(int id) {
  string s = "";
  if((import nkind)[id] == "bin") {
    int i1_of_v = (import ni1)[id];
    int i2_of_v = (import ni2)[id];
    s = "(" + (import ns1)[id] + " " + print_expr(i1_of_v) + " " + print_expr(i2_of_v) + ")";
  } else {
    s = pe_atom(id);
  }
} return string s;
given bin_fix (2):("(+ 5 x)")
given bin_fix (1):("x")

pe_atom(int id) {
  string s = (import ns1)[id];
  if((import nkind)[id] == "call") {
    int[] l1_of_v = (import nl1)[id];
    s = "(call " + (import ns1)[id] + pe_args(l1_of_v) + ")";
  }
} return string s;
given bin_fix (1):("x")
given call_fix (3):("(call foo 5 x)")
