// The module preamble, and the three sections that make up its body.
ll_head(string triple) {
  emit_line("; generated by idc -- the `id` language compiler");
  string q = chr(34);
  ll_head_triple(triple, q);
} return void;
("x86_64"):() then prints:("; generated by idc -- the `id` language compiler\ntarget triple = \"x86_64\"\n\n")
("wasm32"):() then prints:("; generated by idc -- the `id` language compiler\ntarget triple = \"wasm32\"\n\n")

ll_head_triple(string triple, string q) {
  emit_line("target triple = " + q + triple + q);
  emit_line("");
} return void;
("x86_64", "\""):() then prints:("target triple = \"x86_64\"\n\n")
("wasm32", "Q"):() then prints:("target triple = Qwasm32Q\n\n")

ll_body() {
  ll_declares();
  ll_globals();
  ll_funcs();
} return void;
