// The module preamble, and the three sections that make up its body.
ll_head(string triple) {
  emit_line("; generated by idc -- the `id` language compiler");
  string q = chr(34);
  ll_head_triple(triple, q);
} return void;

ll_head_triple(string triple, string q) {
  emit_line("target triple = " + q + triple + q);
  emit_line("");
} return void;

ll_body() {
  ll_declares();
  ll_globals();
  ll_funcs();
} return void;
