// The runtime symbols the module calls. They are declarations, never
// definitions: a hosted build links the C runtime that defines them and a
// freestanding one links a runtime written in `id`, and the module is the same
// either way -- unless this module IS the runtime, in which case it defines
// them, and a declaration beside a definition of one symbol is not something
// LLVM accepts.
ll_declares() {
  if((import rtc)[0] == 0) {
    ll_decl_block();
  }
  int i = 0;
  while(i < len((import prog))) {
    if(is_native((import prog)[i]) == 1) {
      string ndecl = ll_native_decl((import prog)[i]);
      print(ndecl);
    }
    i = i + 1;
  }
} return void;
