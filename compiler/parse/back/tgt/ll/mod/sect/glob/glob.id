// An exported variable is a module-level global. A scalar constant from
// conf.id carries its value; everything else starts zeroed and is written
// when its declaring function runs -- a list constant by @idc_const_init
// (init/), defined after the globals.
ll_globals() {
  int i = 0;
  while(i < len((import enames))) {
    ll_global_kept(i);
    i = i + 1;
  }
  ll_const_init();
} return void;

ll_global_at(int i, string ty) {
  string init = ll_init(i);
  emit_line("@" + (import enames)[i] + " = global " + ty + " " + init);
} return void;

ll_init(int i) {
  string s = ll_zero((import etypes)[i]);
  if((import eowners)[i] == "conf.id" && ty_is_list((import etypes)[i]) == 0) {
    int const_decl_v = const_decl((import enames)[i]);
    int i1_of_v = i1_of(const_decl_v);
    s = ll_const_val(i1_of_v, (import enames)[i]);
  }
} return string s;
