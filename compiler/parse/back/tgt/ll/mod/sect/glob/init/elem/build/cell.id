// One element as a cell, pushed. An integer or a word is its folded value,
// written in place, as a scalar constant's is (str/const.id); a string and a
// float take one instruction each to become a cell, named for the constant
// and the position (named.id).

ll_init_elem(int i, int j, int e, string pass) {
  string t = elem_type((import etypes)[i]);
  if(pass == "bytes" && t == "string") {
    ll_elem_bytes(i, j, e);
  }
  if(pass == "build") {
    ll_init_push(i, j, e, t);
  }
} return void;
given elems3_fixture (0, 0, (import llie_child), "build"):() then prints:("  call void @id_list_push(ptr %c0, i64 1)\n")
given elems3_fixture (0, 0, (import llie_child), "bytes"):() then prints:("")

ll_init_push(int i, int j, int e, string t) {
  string cell = ll_cell(i, j, e, t);
  emit_line("  call void @id_list_push(ptr %c" + i + ", i64 " + cell + ")");
} return void;
given elems3_fixture (0, 0, (import llie_child), "int"):() then prints:("  call void @id_list_push(ptr %c0, i64 1)\n")
given elems3_fixture (2, 0, (import llie_child), "int"):() then prints:("  call void @id_list_push(ptr %c2, i64 1)\n")

ll_cell(int i, int j, int e, string t) {
  string cell = ll_const_num(e);
  if(t == "string" || t == "float") {
    cell = ll_cell_named(i, j, e, t);
  }
} return string cell;
given llc_int_setup (0, 0, (import llc_int_e), "int"):("5")
given llc_str_setup (0, 3, (import llc_str_e), "string"):("%s0.3")
