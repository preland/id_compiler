// One element as a cell, pushed. An integer or a word is its folded value,
// written in place, as a scalar constant's is (str/const.id); a string and a
// float take one instruction each to become a cell, named for the constant and
// the position
// (named.id); an element that reads another constant is a load of its global
// (load.id).

ll_init_elem(int i, int j, int e, string pass) {
  string t = elem_type((import etypes)[i]);
  if(pass == "bytes" && t == "string" && (import nkind)[e] != "import") {
    ll_elem_bytes(i, j, e);
  }
  if(pass == "build") {
    ll_init_push(i, j, e, t);
  }
} return void;
given elems3_fixture {
  (0, 0, (import llie_child), "build"):() then prints:("  call void @id_list_push(ptr %c0, i64 1)\n")
  (0, 0, (import llie_child), "build"):() then calls ll_init_push:(0, 0, (import llie_child), "int")
  (0, 0, (import llie_child), "bytes"):() then prints:("")
}

ll_init_push(int i, int j, int e, string t) {
  string cell = ll_cell(i, j, e, t);
  print("  call void @id_list_push(ptr %c" + i + ", i64 " + cell + ")");
} return void;
given elems3_fixture {
  (0, 0, (import llie_child), "int"):() then prints:("  call void @id_list_push(ptr %c0, i64 1)\n")
  (2, 0, (import llie_child), "int"):() then prints:("  call void @id_list_push(ptr %c2, i64 1)\n")
}

ll_cell(int i, int j, int e, string t) {
  string cell = "";
  if((import nkind)[e] == "import") {
    cell = ll_cell_load(i, j, e);
  } else if(t == "string" || t == "float") {
    cell = ll_cell_named(i, j, e, t);
  }
} chain (int i, int j, int e, string t) {
  if(cell == "") {
    cell = ll_const_num(e);
  }
} return string cell;
given llim_setup (0, 1, (import llim_e), "int"):("%s0.1") then prints:("  %l0.1 = load i32, ptr @b\n  %s0.1 = sext i32 %l0.1 to i64\n")
given llc_int_setup (0, 0, (import llc_int_e), "int"):("5")
given llc_str_setup (0, 3, (import llc_str_e), "string"):("%s0.3")
