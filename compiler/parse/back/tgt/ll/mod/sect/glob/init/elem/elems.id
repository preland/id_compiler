// The elements of list constant `i`, each visited for the walk `pass` names.

ll_init_elems(int i, string pass) {
  int d = const_decl((import enames)[i]);
  int e = (import ni1)[d];
  ll_init_elems2(i, e, pass);
} return void;
given lc_dce_setup {
  (0, "build"):() then prints:("  call void @id_list_push(ptr %c0, i64 1)\n")
  (0, "build"):() then calls ll_init_elems2:(0, 1, "build")
  (0, "bytes"):() then prints:("")
}

ll_init_elems2(int i, int e, string pass) {
  int[] els = (import nl1)[e];
  int j = 0;
  while(j < len(els)) {
    ll_init_elem(i, j, els[j], pass);
    j = j + 1;
  }
} return void;
given elems2_fixture (0, (import llie_e), "build"):() then prints:("  call void @id_list_push(ptr %c0, i64 1)\n")
given elems3_fixture (0, (import llie_e), "build"):() then calls ll_init_elem:(0, 0, (import llie_child), "build")
given elems2_fixture (0, (import llie_e), "bytes"):() then prints:("")

// A string element's bytes, named for the constant and the position.
ll_elem_bytes(int i, int j, int e) {
  string spell = (import ns1)[e];
  ll_str_bytes("@.cs." + (import enames)[i] + "." + j, spell);
} return void;
given elems3_fixture {
  (0, 0, (import llie_child)):() then prints:("@.cs.a.0.d = private unnamed_addr constant <{ i64, [1 x i8] }> <{ i64 0, [1 x i8] c\"\\00\" }>, align 8\n@.cs.a.0 = private alias i8, getelementptr inbounds (i8, ptr @.cs.a.0.d, i64 8)\n")
  (0, 5, (import llie_child)):() then prints:("@.cs.a.5.d = private unnamed_addr constant <{ i64, [1 x i8] }> <{ i64 0, [1 x i8] c\"\\00\" }>, align 8\n@.cs.a.5 = private alias i8, getelementptr inbounds (i8, ptr @.cs.a.5.d, i64 8)\n")
}
