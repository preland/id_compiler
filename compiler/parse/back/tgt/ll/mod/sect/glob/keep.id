// One `@name = global` line, or nothing when pruning drops it
// (dce/export/keep.id).
ll_global_kept(int i) {
  if(keep_export(i) == 1) {
    string ty = ll_ty((import etypes)[i]);
    ll_global_at(i, ty);
  }
} return void;
given lc_dce_setup (0):() then prints:("@a = global ptr null\n")
given lc_dce_setup (1):() then prints:("@b = global i32 2\n")
