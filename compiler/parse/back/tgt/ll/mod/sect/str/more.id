ll_str_emit2(string gname, string s, int blen, int zl) {
  string q = chr(34);
  string bytes = ll_bytes(s);
  emit_line(gname + ".d = private unnamed_addr constant <{ i64, [" + blen + " x i8] }> <{ i64 " + zl + ", [" + blen + " x i8] c" + q + bytes + q + " }>, align 8\n" + gname + " = private alias i8, getelementptr inbounds (i8, ptr " + gname + ".d, i64 8)");
} return void;
