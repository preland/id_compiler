// A string literal's bytes as a private global called `gname`. A literal in a
// function body is named for its IR value; a conf.id constant's, for the
// constant (./const.id). A string carries its length in the word before its
// bytes (runtime/prelude.id), so the bytes sit in a struct after an i64 count
// and `gname` is an alias for the address of the bytes: every use of the
// literal names `gname` and gets a pointer a runtime string would give.
ll_str_bytes(string gname, string s) {
  int blen = ll_blen(s);
  int zl = ll_zlen(s);
  ll_str_emit2(gname, s, blen, zl);
} return void;
