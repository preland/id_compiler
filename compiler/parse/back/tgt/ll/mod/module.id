// The LLVM IR target: a printer over the IR, not a second walk of the AST.
// Everything interesting -- the CFG, the SSA values, the passes -- has already
// happened by the time anything here runs, which is the whole point of there
// being an IR at all.

emit_llvm(string triple, int lvl) {
  fv_init();
  integer_list_set((import lvc), 0, lvl);
  ir_lower();
} chain (string triple, int lvl) {
  ir_opt(lvl);
  ll_emit(triple);
} return void;
given ll_env_fixture2 {
  ("x86_64", 0):() then calls ir_lower:[1] then calls ll_emit:("x86_64")
  ("wasm32", 2):() then calls ir_opt:(2) then calls ll_emit:("wasm32")
  ("x86_64", 0):() then (import lvc)[0]:(0)
}

ll_emit(string triple) {
  ll_head(triple);
  ll_asm_all(triple);
  ll_body();
} chain (string triple) {
  fv_ll_flush();
} return void;
given ll_env_fixture2 {
  ("x86_64"):() then calls ll_head:("x86_64") then calls ll_body:[1]
  ("wasm32"):() then calls ll_head:("wasm32") then calls ll_body:[1]
}
