// "a"'s own value node (../../../mod/sect/glob/../../drive/run/check/dce/
// export/fixture.id's lc_dce_setup registers it, but exports only the
// name "a" is registered under, not the node) and its one element, for
// mod/sect/glob/init/elem/elems.id's ll_init_elems2/ll_elem_bytes and
// init/elem/build/cell.id's ll_init_elem/ll_init_push -- const_decl+i1_of
// is exactly what ll_init_elems itself does to get from one to the other.

elems2_fixture() {
  lc_dce_setup();
  int d = const_decl("a");
  export int llie_e = i1_of(d);
} return void;
():() then check_failed:(0)
():() then init_units:(0)

elems3_fixture() {
  elems2_fixture();
  export int llie_child = l1_of((import llie_e))[0];
} return void;
():() then check_failed:(0)
():() then init_units:(0)

// One whole asm row, for the operand-text translation in text/. asm_reg_fix1b
// (front/tree/node/newnode/cases/fixture.id) already leaves afret "int" and
// afretn "result" on row 0; afparams and aflines have no fixture at all --
// afparams' only writer is asm_sig_tail, a parser function -- so the
// parameter "x" and a one-line body are pushed here. The line arrives with
// its quotes, as the parser stores it, because ll_asm_line scans between
// them.
llasm_row_fixture() {
  asm_reg_fix1b();
  int pnode = node_param("param", "int", "x");
  push((import afparams), [pnode]);
} chain () {
  push((import aflines), ["\"mov %[x], $0\""]);
} return void;
():() then check_failed:(0)
():() then init_units:(0)
