ll_block(int b) {
  emit_line("b" + b + ":");
  int i = 0;
  while(i < len(((import binsn)[b]))) {
    int[] ins = (import binsn)[b];
    ll_insn(ins[i]);
    i = i + 1;
  }
} return void;
