// The parameter list of a define: `<ty> %v<id>`, in order, which is also how
// every use of a parameter inside the body spells it.
ll_pstr(int f) {
  string s = "";
  int i = 0;
  while(i < ll_pcount(f)) {
    int[] pars = irf_par(f);
    s = ll_pstr_step(s, i, pars[i]);
    i = i + 1;
  }
} return string s;
given ll_main_fixture (0):("i32 %v0, i64 %v1")
given ir_rows (0):("")

ll_sep(int i) {
  string s = ", ";
  if(i == 0) {
    s = "";
  }
} return string s;
(0):("")
(1):(", ")

ll_block(int b) {
  emit_line("b" + b + ":");
  int i = 0;
  while(i < insn_count(b)) {
    int[] ins = blk_ins(b);
    ll_insn(ins[i]);
    i = i + 1;
  }
} return void;
