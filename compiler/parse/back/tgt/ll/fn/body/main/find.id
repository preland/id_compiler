// A main taking no arguments is called with none; the marshalled list is
// simply unused, which costs one call and keeps the wrapper in one piece.
ll_mcall(int f) {
  string s = "  %r = call i32 @id_main()";
  int[] irf_par_v = irf_par(f);
  if(len(irf_par_v) == 2) {
    s = "  %r = call i32 @id_main(i32 %argc, ptr %args)";
  }
} return string s;
