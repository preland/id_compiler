// The C-ABI entry point: marshal argv into an `id` string list and call
// id_main. Emitted as text rather than lowered through the IR because it is
// not `id` code -- it is the boundary the host calls across, and it exists in
// exactly one shape.

ll_wrapper(int f) {
  print("");
  print("define i32 @main(i32 %argc, ptr %argv) {\nw.entry:\n  %args = call ptr @id_list_new()\n  br label %w.test\nw.test:\n  %i = phi i32 [ 0, %w.entry ], [ %i.next, %w.body ]\n  %more = icmp slt i32 %i, %argc\n  br i1 %more, label %w.body, label %w.done\nw.body:\n  %ix = sext i32 %i to i64\n  %slot = getelementptr ptr, ptr %argv, i64 %ix\n  %raw = load ptr, ptr %slot\n  %arg = call ptr @id_str_of_cstr(ptr %raw)\n  %cell = ptrtoint ptr %arg to i64\n  call void @id_list_push(ptr %args, i64 %cell)\n  %i.next = add i32 %i, 1\n  br label %w.test\nw.done:");
  string mcall = ll_mcall(f);
} chain (int f) {
  print(mcall);
  print("  ret i32 %r");
  print("}");
} return void;
