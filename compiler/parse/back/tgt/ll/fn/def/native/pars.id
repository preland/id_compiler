// One declaration line, and its parameter types. A declaration names no
// parameters, so only the types are spelled. The line itself is built in
// ll_native_decl's chain (../native.id) once its own block is full.

ll_native_pars(int[] ps) {
  string out = "";
  int i = 0;
  while(i < len(ps)) {
    string s1_of_v = s1_of(ps[i]);
    out = out + ll_sep(i) + ll_ty(s1_of_v);
    i = i + 1;
  }
} return string out;
