
ll_func(int f) {
  string ret = (import fnret)[f];
  string ty = ll_ty(ret);
  string name = (import fnname)[f];
} chain (int f) {
  string plist = ll_pstr(f);
  emit_line("define " + ty + " @id_" + name + "(" + plist + ") {");
  ll_blocks(f);
} chain (int f) {
  emit_line("}");
} return void;
