// An `id` type in LLVM's spelling. Every reference type -- a string, a list of
// anything -- is an opaque pointer: what is behind it is the runtime's
// business and the module never looks.
ll_ty(string t) {
  string s = ll_ty2(t);
  if(t == "int" || t == "bool") {
    s = "i32";
  } else if(t == "word") {
    s = "i64";
  }
} return string s;
("int"):("i32")
("float"):("double")
("bool"):("i32")

ll_ty2(string t) {
  string s = str_pick(t, "wide", "i128", ll_ty3(t));
  if(t == "float") {
    s = "double";
  } else if(t == "i1" || t == "" || t == "void") {
    s = str_pick(t, "i1", "i1", "void");
  }
} return string s;
("string"):("ptr")
("wide"):("i128")
("float"):("double")
("i1"):("i1")
(""):("void")

ll_ty3(string t) {
  string s = str_pick(t, "byte", "i8", "ptr");
} return string s;
("byte"):("i8")
("string"):("ptr")
