// An `id` type in LLVM's spelling. Every reference type -- a string, a list of
// anything -- is an opaque pointer: what is behind it is the runtime's
// business and the module never looks.
ll_ty(string t) {
  string s = ll_ty2(t);
  if(t == "int") {
    s = "i32";
  } else if(t == "word") {
    s = "i64";
  }
} return string s;
("int"):("i32")
("float"):("double")

ll_ty2(string t) {
  string s = str_pick(t, "wide", "i128", "ptr");
  if(t == "float") {
    s = "double";
  } else if(t == "bool" || t == "" || t == "void") {
    s = str_pick(t, "bool", "i1", "void");
  }
} return string s;
("string"):("ptr")
("wide"):("i128")
("float"):("double")
("bool"):("i1")
(""):("void")
