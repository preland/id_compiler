
ll_lit(int v) {
  string s = ir_s(v);
  if(ll_isstr(v) == 1) {
    s = "@.str" + v;
  }
} return string s;
given ir_fix1 (0):("5")
given ir_fix2 (1):("@.str1")

// A typed operand: `<ty> <value>`, the form LLVM wants nearly everywhere.
ll_op(int v) {
  string ll_vty_v = ll_vty(v);
  string ret_s = ll_ty(ll_vty_v) + " " + ll_val(v);
} return string ret_s;
given ir_fix1 (0):("i32 5")
given ir_fix3 (3):("ptr @gname")

ll_args(int id) {
  string s = "";
  int i = 0;
  while(i < ir_l_count(id)) {
    int[] ir_l_v = ir_l(id);
    s = s + ll_sep(i) + ll_op(ir_l_v[i]);
    i = i + 1;
  }
} return string s;
given ir_fix2 (2):("")
given ir_fix5 (7):("i32 5")
