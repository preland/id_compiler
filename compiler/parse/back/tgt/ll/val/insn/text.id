// One instruction, as LLVM text. A dispatch chain in the order the shapes
// differ: terminators name blocks, memory names an address, a call names a
// symbol, and everything else is an operator over typed operands.
//
// Each level computes the rest of the chain into its declaration and then
// overrides it -- the shape the C emitter uses -- so a level costs two tests
// rather than a test and an else.

ll_text(int id) {
  string s = ll_t2(id);
  if((import iop)[id] == "ret") {
    s = ll_ret(id);
  } else if((import iop)[id] == "br") {
    s = "br label %b" + (import iblk)[id][0];
  }
} return string s;
given ir_fixture3 {
  ((import ir_retvoid)):("ret void")
  ((import ir_br)):("br label %b3")
}

ll_ret(int id) {
  string s = "ret void";
  if((import ia)[id] >= 0) {
    int ir_a_v = (import ia)[id];
    s = "ret " + ll_op(ir_a_v);
  }
} return string s;
given ir_fixture3 ((import ir_retvoid)):("ret void")
given fixture1 ((import ir_retval)):("ret i32 5")

ll_t2(int id) {
  string s = ll_t3(id);
  if((import iop)[id] == "cbr") {
    int ir_a_v = (import ia)[id];
    s = "br i1 " + ll_val(ir_a_v) + ", label %b" + (import iblk)[id][0] + ", label %b" + (import iblk)[id][1];
  } else if((import iop)[id] == "alloca") {
    string ir_ty_v = (import ity)[id];
    s = "%v" + id + " = alloca " + ll_ty(ir_ty_v);
  }
} return string s;
given ir_fixture3 {
  ((import ir_cbr)):("br i1 poison, label %b1, label %b2")
  ((import ir_alloca)):("%v3 = alloca i32")
}
