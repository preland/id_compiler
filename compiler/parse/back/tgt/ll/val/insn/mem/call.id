// What a call calls. A call to a function names its symbol; a call through a
// function value carries the value as its first operand (back/ir/build/expr/
// call/core/args.id), which is written where the symbol would be.
ll_callee(int id) {
  string s = "@" + (import istr)[id];
  if((import ia)[id] >= 0) {
    int ir_a_v = (import ia)[id];
    s = ll_val(ir_a_v);
  }
} return string s;
given fixture2 ((import ir_callee_sym)):("@myfunc")
given fixture3 ((import ir_callee_val)):("5")

// A call to a varargs function must carry the function's prototype after the
// result type, or LLVM reads the call as fixed-arity: id_list_lit takes its
// count and then any number of cells.
ll_vsig(int id) {
  string vsig_s = "";
  if((import ia)[id] < 0 && (import istr)[id] == "id_list_lit") {
    vsig_s = " (i32, ...)";
  }
} return string vsig_s;
given fixture2 ((import ir_callee_sym)):("")
given fixture3 ((import ir_callee_val)):("")
