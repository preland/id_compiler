// Six synthetic IR instructions (back/ir/core/store/make/insn/insn.id's
// ir_insn, after init_ir -- a second, independent parallel-list store with
// no relation to the front-end node store, so none of env_init's tables
// apply here) for this directory and ../insn.id's dispatch chains: a `ret`
// with no value, an unconditional `br`, a conditional `cbr`, an `alloca`,
// a `load` and a `store`. None of the six read their own l/bl columns in
// this dispatch chain, so [9] (any non-empty literal, which needs no
// typed declaration the way `[]` alone would) stands in wherever the
// value is never read; br/cbr's own block targets are the real values the
// text actually prints. Each chain step adds the next two so a case
// anywhere in this group can `given` whichever step is furthest along and
// import any earlier export by name.

ir_fixture1() {
  init_ir();
  export int ir_retvoid = ir_insn("ret", "", 0 - 1, 0 - 1, "", [9], [9]);
  export int ir_br = ir_insn("br", "", 0 - 1, 0 - 1, "", [9], [3]);
} return void;
():() then init_units:(0)
():() then calls ir_insn:[2]

ir_fixture2() {
  ir_fixture1();
  export int ir_cbr = ir_insn("cbr", "", 0 - 1, 0 - 1, "", [9], [1, 2]);
  export int ir_alloca = ir_insn("alloca", "int", 0 - 1, 0 - 1, "", [9], [9]);
} return void;
():() then init_units:(0)
():() then calls ir_insn:[4]

ir_fixture3() {
  ir_fixture2();
  export int ir_load = ir_insn("load", "int", 0 - 1, 0 - 1, "", [9], [9]);
  export int ir_store = ir_insn("store", "", 0 - 1, 0 - 1, "", [9], [9]);
} return void;
():() then init_units:(0)
():() then calls ir_insn:[6]
