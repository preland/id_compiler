
ll_t3(int id) {
  string s = ll_t4(id);
  if(ir_op(id) == "load") {
    string ir_ty_v = ir_ty(id);
    int ir_a_v = ir_a(id);
    s = "%v" + id + " = load " + ll_ty(ir_ty_v) + ", ptr " + ll_val(ir_a_v);
  } else if(ir_op(id) == "store") {
    int ir_b_v = ir_b(id);
    int ir_a_v2 = ir_a(id);
    s = "store " + ll_op(ir_b_v) + ", ptr " + ll_val(ir_a_v2);
  }
} return string s;
given ir_fixture3 ((import ir_load)):("%v4 = load i32, ptr poison")
given ir_fixture3 ((import ir_store)):("store void poison, ptr poison")

ll_t4(int id) {
  string s = ll_t5(id);
  if(ir_op(id) == "call") {
    s = ll_call(id);
  } else if(ir_op(id) == "phi") {
    string ir_ty_v = ir_ty(id);
    s = "%v" + id + " = phi " + ll_ty(ir_ty_v) + " " + ll_phis(id);
  }
} return string s;
given fixture2 ((import ir_callee_sym)):("call void @myfunc()")
given phi_fixture ((import ir_phi)):("%v1 = phi i32 [ %v0, %b7 ]")

// A call that produces nothing is a statement; one that produces a value names
// it. LLVM will not accept a name for a void result, so the two really are
// different lines rather than one with an empty prefix. What is called is a
// symbol or a function value (call.id).
ll_call(int id) {
  string ir_ty_v = ir_ty(id);
  string s = "call " + ll_ty(ir_ty_v) + " " + ll_callee(id) + "(" + ll_args(id) + ")";
  if(ll_ty(ir_ty_v) != "void") {
    s = "%v" + id + " = " + s;
  }
} return string s;
given fixture2 ((import ir_callee_sym)):("call void @myfunc()")
given fixture3 ((import ir_callee_val)):("%v3 = call i32 5()")
