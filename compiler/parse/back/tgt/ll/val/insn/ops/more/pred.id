// A comparison carries the `id` operator, and the operand type decides how
// LLVM spells it: integers compare signed, floats compare ordered. Keeping one
// spelling in the IR is what lets a fold read a comparison without knowing
// which target will print it.
ll_pred(string op, string t) {
  string s = ll_pred_word(op, "eq", "ne", "s");
  if(ty_kind(t) == "float") {
    s = ll_pred_word(op, "oeq", "une", "o");
  }
} return string s;
given init_tyreg ("<", "int"):("slt")
given init_tyreg ("<", "float"):("olt")
given init_tyreg ("!=", "int"):("ne")
given init_tyreg ("==", "float"):("oeq")

// The word for a comparison: equality, inequality, or the relational one with
// its prefix, each spelled by the caller (signed for integers, ordered for
// floats).
ll_pred_word(string op, string eq_word, string ne_word, string rel_pre) {
  string s = eq_word;
  if(op == "!=") {
    s = ne_word;
  } else if(op != "=" && op != "==") {
    s = rel_pre + ll_rel(op);
  }
} return string s;
("!=", "eq", "ne", "s"):("ne")
("<", "eq", "ne", "s"):("slt")
("==", "oeq", "une", "o"):("oeq")
("<", "oeq", "une", "o"):("olt")
