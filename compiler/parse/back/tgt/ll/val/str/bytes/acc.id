// The rest of `ll_bytes`: the accumulating loop, kept apart because a
// `string` parameter is a value -- appending to it here and appending to it
// in the caller are appends to two different copies, so the loop has to own
// the accumulator from "" to the finished text.
ll_bytes_acc(string s) {
  string out = "";
  int i = 1;
  while(i < len(s) - 1) {
    out = out + ll_piece(s, i);
    i = ll_step(s, i);
  }
} return string out;
("\"\""):("")
("\"a\""):("\\61")

// How many bytes of a literal come before its first NUL: what a strlen would
// have said, and so the count stored in front of the bytes (ll_str_bytes). A
// literal with a `\0` in it is as long as its text up to there, on every
// target, so `len` and a comparison can never disagree about where it ends.
ll_zlen(string s) {
  string zbytes = ll_bytes(s);
  int i = 0;
  while(character_code_at(zbytes, i * 3 + 1) != 48 || character_code_at(zbytes, i * 3 + 2) != 48) {
    i = i + 1;
  }
} return int i;
("\"\""):(0)
("\"ab\""):(2)
("\"a\\0b\""):(1)
