// A string literal, as LLVM wants it: every byte written as an escape, so no
// character in the source can end the constant early, plus a trailing NUL.
// The source form arrives with its quotes and its backslash escapes intact,
// which is why this reads the bytes rather than the characters.
//
// The text is accumulated here rather than in the helper because a `string` is
// a value: a helper that appended to a parameter would be appending to a copy,
// and the constant would come out empty. So one helper says what the byte at a
// position spells and another says how far that position advanced.

ll_bytes(string s) {
  string out = ll_bytes_acc(s);
  string ret_s = out + "\\00";
} return string ret_s;
("\"\""):("\\00")
("\"a\""):("\\61\\00")

ll_piece(string s, int i) {
  int charat_v = character_code_at(s, i);
  string out = ll_hex(charat_v);
  if(character_code_at(s, i) == 92) {
    int charat_v2 = character_code_at(s, i + 1);
    int ll_escbyte_v = ll_escbyte(charat_v2);
    out = ll_hex(ll_escbyte_v);
  }
} chain (string s, int i) {
  if(hex_escape_at(s, i) == 1) {
    int hex_escape_v = hex_escape_byte(s, i);
    out = ll_hex(hex_escape_v);
  }
  int octal_digits = octal_escape_length(s, i);
  if(octal_digits > 0) {
    int octal_v = octal_escape_byte(s, i, octal_digits);
    out = ll_hex(octal_v);
  }
} return string out;
("ab", 1):("\\62")
("\\n", 0):("\\0A")
("a\\x41", 1):("\\41")
("\\x7a", 0):("\\7A")
("\\033", 0):("\\1B")
("a\\101", 1):("\\41")
("\\0", 0):("\\00")

// Where the next piece starts: past a backslash and the character after it, or
// past the four characters of a `\xHH`, which is one byte whatever follows it,
// or past a backslash and its one to three octal digits.
ll_step(string s, int i) {
  int next = string_advance_past_escape(s, i, 92, 2);
  if(hex_escape_at(s, i) == 1) {
    next = i + 4;
  }
  int octal_digits = octal_escape_length(s, i);
} chain (string s, int i) {
  if(octal_digits > 0) {
    next = i + 1 + octal_digits;
  }
} return int next;
("ab", 0):(1)
("\\n", 0):(2)
("\\x41b", 0):(4)
("\\0331", 0):(4)
("\\7a", 0):(2)

