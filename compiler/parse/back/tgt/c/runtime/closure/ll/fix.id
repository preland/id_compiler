// The nodes the closure lowering's cases are about, in the lowering context
// lw_env_fixture opens: bf(int x) return int, a function registered by name,
// lb_name its name as a value, lb_lit a literal to bind, and lb_call the bind
// of the two.

lw_clo_fixture() {
  lw_env_fixture();
  init_bnames();
  int[] none = [];
} chain () {
  export int lb_fn = node_func("bf", "int", [node_param("param", "int", "x")], none, 0 - 1);
  fidx_add("bf");
  push((import fnames), "bf");
} chain () {
  push((import fnodes), lb_fn);
  export int lb_name = node_var("bf");
  export int lb_lit = node_int("7", 7, 0);
} chain () {
  export int lb_call = node_call("bind", [lb_name, lb_lit]);
} return void;
():() then calls lw_env_fixture:[1]
():() then init_units:(0)
