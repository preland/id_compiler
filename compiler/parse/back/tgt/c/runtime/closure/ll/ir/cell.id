// One value of a bind in the IR: converted to the type of the parameter it
// fixes (a C call converts implicitly and LLVM will not), copied if that type
// is a list so the closure holds its own locked copy, boxed into the 8-byte
// cell the way a list element is, and stored with id_clo_set at its index.

lw_clo_set(int o, int fn, int idx, int i, int a) {
  string pt = (import ns1)[(import nl1)[fn][i]];
  int cellv = lw_clo_cell(a, pt);
  lw_callf(clo_setter(pt), "string", [o, idx, cellv]);
} return void;
