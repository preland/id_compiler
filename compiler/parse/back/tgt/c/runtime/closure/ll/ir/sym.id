// A function value in the IR (docs/SPEC.md 1.1.1). The module defines, for each
// pair (name, nd) its code uses, an adapter -- nd is 0 for a plain function used
// as a value -- recorded in the registry the module's end reads (closure/fv.id).
// What the module never defines is an object: the runtime makes them, and the
// module only holds the pointer it is given. A plain function's object is
// id_fn_plain(adapter, function); a call through a value reads the adapter from
// the object (id_clo_fn) and calls it with the object first, so the value goes
// in front of the arguments the call's own type spells.

fv_sym(string name, int nd) {
  fv_note(name, nd);
  string s = "idfn_a_" + name + (import fv_sep) + nd;
} return string s;
given lw_clo_fixture ("tick", 0):("idfn_a_tick__0") then len((import fvname)):(1)
given lw_clo_fixture ("pick", 2):("idfn_a_pick__2") then (import fvk)[0]:(2)

lw_obj_args(int obj, int[] args) {
  int[] full = [obj];
  int i = 0;
  while(i < len(args)) {
    push(full, args[i]);
    i = i + 1;
  }
} return int[] full;
(4, [7, 8]):([4, 7, 8])
(4, []):([4])

lw_fnval(string name, string ety) {
  int fa = ir_leaf("global", "string", 0 - 1, 0 - 1, fv_sym(name, 0));
  int fnraw = ir_leaf("global", "string", 0 - 1, 0 - 1, "id_" + name);
  int ret_i = lw_callf("id_fn_plain", ety, [fa, fnraw]);
} return int ret_i;
given lw_clo_fixture ("tick", "func(int) return int"):(2) then (import istr)[0]:("idfn_a_tick__0")
given lw_clo_fixture ("tick", "func(int) return int"):(2) then (import istr)[1]:("id_tick")
