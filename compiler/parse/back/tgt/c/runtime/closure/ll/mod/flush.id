// What the module defines for the function values it uses (closure/fv.id), at
// its end: the declarations of the runtime calls a function value makes, then an
// adapter for each pair (name, nd), the same adapters the C target writes
// (c/more/def/). The module defines no object: the runtime makes them, so the
// module does not depend on how a runtime lays one out, and idrun, which has its
// own, runs the same module. A runtime that is the module itself (--runtime)
// defines these calls and does not declare them.

fv_ll_flush() {
  if(len((import fvname)) > 0 && (import rtc)[0] == 0) {
    print("declare ptr @id_fn_plain(ptr, ptr)\ndeclare ptr @id_clo_make(ptr, i32)\ndeclare ptr @id_clo_set(ptr, i32, i64)\ndeclare ptr @id_clo_copy(ptr)\ndeclare ptr @id_fn_raw(ptr)\ndeclare ptr @id_clo_fn(ptr)\ndeclare i64 @id_clo_cell(ptr, i32)");
  }
  int i = 0;
  while(i < len((import fvname))) {
    fv_ll_def((import fvname)[i], (import fvk)[i]);
    i = i + 1;
  }
} return void;
