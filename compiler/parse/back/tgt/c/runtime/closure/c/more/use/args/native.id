// Whether parameter i of the function a call names is a function type and that
// function is a native: the one place a function value leaves id for C, so the
// one place it must be a plain function pointer rather than an object.

native_fn_param(int id, int i) {
  int fn = fn_node_of((import ns1)[id]);
  int ok = 0;
  if(fn >= 0 && is_native(fn) == 1) {
    ok = param_is_func(fn, i);
  }
} return int ok;
