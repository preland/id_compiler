// Writing what fv.id found, after the translation unit's last function. For
// each pair (name, nd) an adapter, the function `fn` of the object, and the
// object: for nd = 0 the plain function used as a value, whose `raw` is the
// function itself; for nd > 0 the template bind copies, whose `raw` is 0
// because what bind makes is a closure (docs/SPEC.md 1.1.1).

fv_flush() {
  int i = 0;
  while(i < len((import fvname))) {
    fv_def((import fvname)[i], (import fvk)[i]);
    i = i + 1;
  }
} return void;
given clo_fixture ():() then prints:("")
given clo_seeded ():() then prints:("int idfn_a_fx_target__0(IdFn* c, int a0) { return id_fx_target(a0); }\nIdFn idfn_o_fx_target__0 = { (void*)idfn_a_fx_target__0, (void*)id_fx_target, 0 };\n")

fv_def(string name, int nd) {
  int fn = fn_node_of(name);
  emit_line(fv_adapter(fn, name, nd));
  emit_line(fv_object(name, nd));
} return void;
given clo_fixture ("fx_target", 0):() then prints:("int idfn_a_fx_target__0(IdFn* c, int a0) { return id_fx_target(a0); }\nIdFn idfn_o_fx_target__0 = { (void*)idfn_a_fx_target__0, (void*)id_fx_target, 0 };\n")
given clo_fixture ("fx_target", 1):() then prints:("int idfn_a_fx_target__1(IdFn* c) { return id_fx_target((int)(ID_FNC(c)[0])); }\nIdFn idfn_o_fx_target__1 = { (void*)idfn_a_fx_target__1, 0, 1 };\n")

fv_object(string name, int nd) {
  string key = fv_key(name, nd);
  string raw = fv_raw(name, nd);
  string s = "IdFn idfn_o_" + key + " = { (void*)idfn_a_" + key + ", " + raw + ", " + nd + " };";
} return string s;
("tick", 0):("IdFn idfn_o_tick__0 = { (void*)idfn_a_tick__0, (void*)id_tick, 0 };")
("tick", 2):("IdFn idfn_o_tick__2 = { (void*)idfn_a_tick__2, 0, 2 };")
