// `bind(NAME, v1, ..., vk)` as C (docs/SPEC.md 1.1.1): a new object copied from
// the template of (NAME, k), then each value stored in its cell, boxed as the
// parameter it fixes is typed. A list is copied and locked on the way in, so
// the closure holds its own immutable copy; a string and a function value are
// shared because they are immutable already.

emit_bind(int id) {
  int[] args = (import nl1)[id];
  string clo0 = bind_new(args);
  string s = bind_sets(clo0, fn_node_of((import ns1)[args[0]]), args);
} return string s;
given clo_bind_fixture {
  ((import cb_call)):("id_clo_set(id_clo_new(ID_FNV(fx_target__1)), 0, (long long)(7))")
  ((import cb_var)):("id_clo_set(id_clo_new(ID_FNV(fx_target__1)), 0, (long long)(n))")
}


bind_new(int[] args) {
  string nm = (import ns1)[args[0]];
  int nd = len(args) - 1;
  string s = "id_clo_new(" + fv_ref(nm, nd) + ")";
} return string s;
given clo_bind_fixture {
  ([(import cb_name), (import cb_lit)]):("id_clo_new(ID_FNV(fx_target__1))")
  ([(import cb_name)]):("id_clo_new(ID_FNV(fx_target__0))")
}

bind_sets(string clo0, int fn, int[] args) {
  string s = clo0;
  int i = 1;
  while(i < len(args)) {
    s = clo_setter(bind_pt(fn, i - 1)) + "(" + s + ", " + (i - 1) + ", " + bind_cell(fn, i - 1, emit_expr(args[i])) + ")";
    i = i + 1;
  }
} return string s;
given clo_bind_fixture {
  ("n", (import fixture_fn), [(import cb_name), (import cb_lit)]):("id_clo_set(n, 0, (long long)(7))")
  ("n", (import fixture_fn), [(import cb_name)]):("n")
}
