const_hop(int e) {
  if((import nkind)[e] == "import") {
    int d = const_decl((import ns1)[e]);
    if(d >= 0 && ty_is_list((import ns1)[d]) == 0) {
      e = (import ni1)[d];
    }
  }
} return int e;
