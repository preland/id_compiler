// A registered list constant ("k") and a registered scalar constant ("m"),
// for init_line (../line.id) and const_line_tail (../../line.id), which both
// render a conf.id constant's declaration node as C.

cl_setup() {
  lc_env();
  export int cl_d = lc_reg_list1("k", "5", 5);
} return void;
():() then (import chkfail)[0]:(0)
():() then init_units:(0)

cl_scalar_setup() {
  lc_env();
  export int cl_scalar_d = lc_reg_int("m", "9", 9);
} return void;
():() then (import chkfail)[0]:(0)
():() then init_units:(0)

// "fa" imports the later constant "fb" (a forward reference); "fc" and "fd"
// import each other. const_hop and const_root follow the first and stop at
// the cycle.
cl_fwd_setup() {
  lc_env();
  export int cl_fwd_lit = node_int("4", 4, 0);
  export int cl_fwd_ie = node_import("fb");
} chain () {
  int db = lc_reg("int", "fb", (import cl_fwd_lit));
  int da = lc_reg("int", "fa", (import cl_fwd_ie));
  export int cl_cyc_ic = node_import("fd");
} chain () {
  int dc = lc_reg("int", "fc", (import cl_cyc_ic));
  int dd = lc_reg("int", "fd", node_import("fc"));
} return void;
():() then (import chkfail)[0]:(0)
():() then init_units:(0)
