// export owned by a function (gx, index 0), one conf.id constant (gc, index
// 1), and an import node reading gx.
uninit_fixture() {
  lz_j();
  entry_fixture_harn();
  add_export("gx", "int", "setup_fn");
} chain () {
  add_export("gc", "int", "conf.id");
  export int uninit_imp = node_import("gx");
} return void;
():() then calls add_export:("gx", "int", "setup_fn")
():() then (import harn)[0]:(1)
