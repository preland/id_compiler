// list_consts_kept for emit_init_call, which asks once per test case: the
// answer is fixed while a unit is emitted, and recomputing it was most of the
// parser's time on the compiler's own source. kept_lists_reset (test/unit/
// flag.id) clears it where the unit changes.
list_consts_cached() {
  int kept_n = (import kept_lists)[0];
  if(kept_n < 0) {
    kept_n = list_consts_kept();
    lset((import kept_lists), 0, kept_n);
  }
} return int kept_n;
