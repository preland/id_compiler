// One export line, or nothing when pruning drops it (dce/export/keep.id).
emit_export_line_kept(int i) {
  if(keep_export(i) == 1) {
    string export_line_v = export_line(i);
    emit_line(export_line_v);
  }
} return void;
given lc_dce_setup (0):() then prints:("IdList* a;  /* constant from conf.id */\n")
given lc_dce_setup (1):() then prints:("int b = 2;  /* constant from conf.id */\n")
