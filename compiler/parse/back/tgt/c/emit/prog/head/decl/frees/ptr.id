// The leaf pieces of the free steps (val.id): a struct field's statement and
// the pointer a cell holds.

frs_struct(string fz_t, string fz_e) {
  string fz_r = "id_list_free(" + frs_ptr(fz_e) + ");";
  if(esc_dkind(fz_t) == 3) {
    fz_r = "id_frs_push(s, " + frs_ptr(fz_e) + ", idfs_" + fz_t + ");";
  }
} return string fz_r;
given esc_ty_fix {
  ("Pt", "e"):("id_list_free((void*)(intptr_t)e);")
  ("Pg", "q"):("id_frs_push(s, (void*)(intptr_t)q, idfs_Pg);")
}

frs_ptr(string fz_e) {
  string fz_r = "(void*)(intptr_t)" + fz_e;
} return string fz_r;
given esc_ty_fix {
  ("a"):("(void*)(intptr_t)a")
  ("L->data[2]"):("(void*)(intptr_t)L->data[2]")
}
