// After the call: the counts, then the expected values, one local each --
// `idtc_e0`, `idtc_e1`, ... -- then the comparison.

emit_case_expd(int ci) {
  int fn = (import casefn)[ci];
  int[] expd = (import nl2)[((import casenode)[ci])];
  int j = 0;
} chain (int ci) {
  while(j < len(expd)) {
    emit_expd_decl(fn, expd, j);
    j = j + 1;
  }
} return void;
