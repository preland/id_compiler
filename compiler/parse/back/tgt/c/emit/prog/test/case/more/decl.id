given nz_prog_fixture ((import nz_plainfn)):("")

names_upto(int n) {
  string out = "";
  int j = 0;
  while(j < n) {
    out = out + sep_at(", ", j) + "idtc_a" + j;
    j = j + 1;
  }
} return string out;
