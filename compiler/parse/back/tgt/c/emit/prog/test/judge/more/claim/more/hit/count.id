// Whether case ci belongs to claim c's group, and how many do.

claim_count(int c) {
  int n = 0;
  int ci = 0;
  while(ci < len((import casenode))) {
    n = n + carries(ci, c);
    ci = ci + 1;
  }
} return int n;
