// One recorded name's storage: a struct with one native-typed field per
// parameter (row/columns.id), grown as calls come in. `_n` counts every call
// (long long: `then calls NAME:[N]` is exact however many); `_kept` counts the
// rows actually stored, at most IDTC_REC_MAX (../scan/prelude.id).

emit_rec_def(string nm, int fn) {
  string sigtext = param_str(fn);
  int[] params = l1_of(fn);
  string fields = rec_row_fields(params);
} chain (string nm, int fn) {
  emit_rec_types(nm, fields);
  emit_rec_fn(nm, sigtext, params);
} return void;
given fn_fixture ("fx_target", (import fixture_fn)):() then prints:("typedef struct { int x; int idtc_rc_pad; } idtc_rc_fx_target_t;\nstatic long long idtc_rc_fx_target_n = 0;\nstatic int idtc_rc_fx_target_kept = 0;\nstatic int idtc_rc_fx_target_cap = 0;\nstatic idtc_rc_fx_target_t* idtc_rc_fx_target_buf = NULL;\nstatic long long* idtc_rc_fx_target_seq = NULL;\nstatic void idtc_rec_fx_target(int x) {\n    if (!idtc_rec_on) return;\n    long long idtc_rs = idtc_rec_seq++;\n    idtc_rc_fx_target_n++;\n    if (idtc_rc_fx_target_kept == IDTC_REC_MAX) return;\n    if (idtc_rc_fx_target_kept == idtc_rc_fx_target_cap) {\n        idtc_rc_fx_target_cap = idtc_rc_fx_target_cap ? idtc_rc_fx_target_cap * 2 : 8;\n        idtc_rc_fx_target_buf = idtc_rec_grow(idtc_rc_fx_target_buf, sizeof(idtc_rc_fx_target_t), idtc_rc_fx_target_cap);\n        idtc_rc_fx_target_seq = idtc_rec_grow(idtc_rc_fx_target_seq, sizeof(long long), idtc_rc_fx_target_cap);\n    }\n    idtc_rc_fx_target_buf[idtc_rc_fx_target_kept].x = x; \n    idtc_rc_fx_target_seq[idtc_rc_fx_target_kept] = idtc_rs;\n    idtc_rc_fx_target_kept++;\n}\n")
given nz_prog_fixture ("run", (import nz_plainfn)):() then prints:("typedef struct { int idtc_rc_pad; } idtc_rc_run_t;\nstatic long long idtc_rc_run_n = 0;\nstatic int idtc_rc_run_kept = 0;\nstatic int idtc_rc_run_cap = 0;\nstatic idtc_rc_run_t* idtc_rc_run_buf = NULL;\nstatic long long* idtc_rc_run_seq = NULL;\nstatic void idtc_rec_run(void) {\n    if (!idtc_rec_on) return;\n    long long idtc_rs = idtc_rec_seq++;\n    idtc_rc_run_n++;\n    if (idtc_rc_run_kept == IDTC_REC_MAX) return;\n    if (idtc_rc_run_kept == idtc_rc_run_cap) {\n        idtc_rc_run_cap = idtc_rc_run_cap ? idtc_rc_run_cap * 2 : 8;\n        idtc_rc_run_buf = idtc_rec_grow(idtc_rc_run_buf, sizeof(idtc_rc_run_t), idtc_rc_run_cap);\n        idtc_rc_run_seq = idtc_rec_grow(idtc_rc_run_seq, sizeof(long long), idtc_rc_run_cap);\n    }\n    \n    idtc_rc_run_seq[idtc_rc_run_kept] = idtc_rs;\n    idtc_rc_run_kept++;\n}\n")

emit_rec_types(string nm, string fields) {
  emit_line("typedef struct { " + fields + "int idtc_rc_pad; } idtc_rc_" + nm + "_t;\nstatic long long idtc_rc_" + nm + "_n = 0;\nstatic int idtc_rc_" + nm + "_kept = 0;\nstatic int idtc_rc_" + nm + "_cap = 0;\nstatic idtc_rc_" + nm + "_t* idtc_rc_" + nm + "_buf = NULL;\nstatic long long* idtc_rc_" + nm + "_seq = NULL;");
} return void;
