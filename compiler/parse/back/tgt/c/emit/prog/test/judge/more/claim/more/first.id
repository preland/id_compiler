// Whether claim c is the first of its kind and bound in its function.

first_claim(int c) {
  int r = 1;
  int j = 0;
  while(j < c) {
    r = r * (1 - same_claim(j, c));
    j = j + 1;
  }
} return int r;
(0):(1)
given claim_dup_fixture (1):(0)

same_claim(int j, int c) {
  int r = 0;
  if((import casefn)[(import conscase)[j]] == (import casefn)[(import conscase)[c]] && (import conskind)[j] == (import conskind)[c] && (import consbound)[j] == (import consbound)[c]) {
    r = 1;
  }
} return int r;
given claim_dup_fixture (0, 1):(1)
given claim_cols_fixture (0, 1):(0)

emit_claim(int c) {
  string grp = claim_group(c);
  int gn = claim_count(c);
  print("    bad |= idtc_claim((int[]){" + grp + "}, " + gn + ", \"" + (import conskind)[c] + "\", \"" + (import consbound)[c] + "\");");
} return void;
given claim_cols_fixture (0):() then prints:("    bad |= idtc_claim((int[]){0}, 1, \"time\", \"O(n)\");\n")
given claim_cols_fixture (1):() then prints:("    bad |= idtc_claim((int[]){0}, 1, \"mem\", \"O(n)\");\n")
