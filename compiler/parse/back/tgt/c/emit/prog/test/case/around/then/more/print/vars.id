// What a `prints`/`eprints` clause compares against, and what its failure
// message calls it: `thenprints` reads back stdout (capture/io.id), and
// `theneprints` reads back eprint's own buffer.

print_var(string kind) {
  string pv = "idtc_out_buf";
  if(kind == "theneprints") {
    pv = "idtc_err_buf";
  }
} return string pv;
("thenprints"):("idtc_out_buf")
("theneprints"):("idtc_err_buf")

print_label(string kind) {
  string lab = "prints";
  if(kind == "theneprints") {
    lab = "eprints";
  }
} return string lab;
("thenprints"):("prints")
("theneprints"):("eprints")

// The C call that measures an export for `then len((import NAME))` (check/
// entry.id): a list's length and a string's are different runtime calls.
// Filed here because the check/ lane is at the three-function limit.
then_len_call(string nm) {
  string lc = "id_len(";
  if(ty_is_list((import etypes)[find_str((import enames), nm)]) == 1) {
    lc = "id_list_len(";
  }
} return string lc;
given then_imp_fixture ("int[]", 0, 0) ("gx"):("id_list_len(")
given then_imp_fixture ("string", 0, 0) ("gx"):("id_len(")
