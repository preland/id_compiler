// (emit_tc_run, ../text/proc.id) has something other than zero to read --
// the value itself is never dereferenced there, so a plain 0 is enough. The
// harn flag itself (../flag.id) is turned on by the pre-existing
// entry_fixture_harn (code/func/def/body/entry.id).

one_casefn_fixture() {
  env_init();
  push((import casefn), 0);
} return void;
():() then (import casefn)[0]:(0)
():() then len((import casefn)):(1)
():() then init_units:(0)
():() then calls env_init:[1]

