emit_tc_one() {
  emit_line("static int idtc_one(int k) {\n    int err[2], cnt[2], st = 0;\n    char msg[4096];\n    size_t used = 0;\n    ssize_t r;\n    long long c[2] = {0, 0};\n    pid_t pid;\n    siginfo_t wi;\n    char scratch[] = \"/tmp/idcase_XXXXXX\";\n    if (pipe(err) != 0 || pipe(cnt) != 0) { perror(\"idc: test harness\"); return 1; }\n    if (!mkdtemp(scratch)) { perror(\"idc: test harness\"); return 1; }\n    fflush(NULL);\n    pid = fork();\n    if (pid < 0) { perror(\"idc: test harness\"); idtc_rmtree(scratch); return 1; }\n    if (pid == 0) {\n        setpgid(0, 0);\n        setenv(\"TMPDIR\", scratch, 1);\n        close(err[0]);\n        close(cnt[0]);\n        dup2(err[1], 2);\n        if (getenv(\"IDTC_READS\")) {\n            char rp[4096];\n            snprintf(rp, sizeof rp, \"%s/%d\", getenv(\"IDTC_READS\"), k);\n            setenv(\"IDTC_READLOG\", rp, 1);\n        }\n        if (idtc_dir[k] && chdir(idtc_dir[k]) != 0) {\n            fprintf(stderr, \"%s: test failed: %s could not run in %s: %s\\n\", idtc_where[k], idtc_call[k], idtc_dir[k], strerror(errno));\n            exit(3);\n        }\n        idtc_stdin_set(k);\n        idtc_limit(k);\n        exit(idtc_case[k](cnt[1]));\n    }\n    setpgid(pid, pid);\n    close(err[1]);\n    close(cnt[1]);\n    used = idtc_pull(err[0], msg, used, 50, pid);\n    while (waitid(P_PID, (id_t)pid, &wi, WEXITED | WNOWAIT) < 0) {\n        if (errno != EINTR) { perror(\"idc: test harness\"); return 1; }\n    }\n    kill(-pid, SIGKILL);\n    used = idtc_pull(err[0], msg, used, 200, 0);\n    msg[used] = '\\0';\n    idtc_nonblock(cnt[0]);\n    r = read(cnt[0], c, sizeof c);\n    close(err[0]);\n    close(cnt[0]);\n    idtc_rmtree(scratch);\n    while (waitpid(pid, &st, 0) < 0) {\n        if (errno != EINTR) { perror(\"idc: test harness\"); return 1; }\n    }\n    if (WIFEXITED(st) && WEXITSTATUS(st) == 0 && r == (ssize_t)sizeof c) {\n        idtc_t[k] = c[0];\n        idtc_m[k] = c[1];\n        return 0;\n    }\n    if (WIFEXITED(st) && WEXITSTATUS(st) == 3) {\n        fputs(msg, stderr);\n        return 1;\n    }\n    if (idtc_traps[k]) {\n        return idtc_trap_match(k, st, msg);\n    }\n    idtc_report(k, st, msg);\n    return 1;\n}");
} return void;
