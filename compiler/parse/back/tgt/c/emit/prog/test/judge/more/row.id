// One row of the case table.

emit_setup_line(int ci, string cw, string cc) {
  string f1 = s1_of((import casefn)[ci]);
  int fx = case_fidx(ci);
  emit_line("    idtc_where[" + ci + "] = \"" + cw + "\"; idtc_call[" + ci + "] = \"" + cc + "\"; idtc_fn[" + ci + "] = \"" + f1 + "\"; idtc_fidx[" + ci + "] = " + fx + "; idtc_case[" + ci + "] = idtc_case_" + ci + ";");
} return void;

case_where_c(int ci) {
  string case_loc_v = case_loc(ci);
  string so = c_esc(case_loc_v);
} return string so;

case_call_c(int ci) {
  string f1 = s1_of((import casefn)[ci]);
  int[] args = l1_of((import casenode)[ci]);
  string so = call_c(f1, args);
} return string so;
