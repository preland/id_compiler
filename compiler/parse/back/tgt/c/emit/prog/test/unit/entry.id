// The case keys come first, while `prog` is still every function as parsed
// (mid/form/unique/dump/digest/keys/emit.id): bin/idc reads them to decide
// which cases this build has already seen pass.
emit_tests(string triple) {
  if(len((import casefn)) > 0) {
    dg_emit_keys();
    emit_test_kept(triple);
  }
  print("/* ---- end of test harness ---- */");
} return void;
