eq = NULL;\nstatic void idtc_rec_fx_target(int x) {\n    if (!idtc_rec_on) return;\n    long long idtc_rs = idtc_rec_seq++;\n    idtc_rc_fx_target_n++;\n    if (idtc_rc_fx_target_kept == IDTC_REC_MAX) return;\n    if (idtc_rc_fx_target_kept == idtc_rc_fx_target_cap) {\n        idtc_rc_fx_target_cap = idtc_rc_fx_target_cap ? idtc_rc_fx_target_cap * 2 : 8;\n        idtc_rc_fx_target_buf = idtc_rec_grow(idtc_rc_fx_target_buf, sizeof(idtc_rc_fx_target_t), idtc_rc_fx_target_cap);\n        idtc_rc_fx_target_seq = idtc_rec_grow(idtc_rc_fx_target_seq, sizeof(long long), idtc_rc_fx_target_cap);\n    }\n    idtc_rc_fx_target_buf[idtc_rc_fx_target_kept].x = x; \n    idtc_rc_fx_target_seq[idtc_rc_fx_target_kept] = idtc_rs;\n    idtc_rc_fx_target_kept++;\n}\n")
