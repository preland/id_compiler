// Global state for `calls`-clause recording (docs/TESTS.md): idtc_rec_on is
// true only while the call under test (and whatever it calls) is running, and
// idtc_rec_seq gives each recorded call, across every recorded name, one
// position in the order calls actually happened -- what lets several `then
// calls` clauses be matched as a subsequence (case/around/then/more/calls/).
// idtc_eprint_target is eprint's own destination
// (test/unit/more/prelude/count.id's IDTC_EPRINT_TO).

emit_rec_prelude() {
  emit_line("");
  emit_line("static int idtc_rec_on = 0;\nstatic long long idtc_rec_seq = 0;\nstatic FILE* idtc_eprint_target = NULL;\nstatic void idtc_show_esc(const char* s) {\n    fputc('\"', stderr);\n    for (const unsigned char* p = (const unsigned char*)s; *p; p++) {\n        if (*p == '\\\\' || *p == '\"') { fputc('\\\\', stderr); fputc(*p, stderr); }\n        else if (*p == '\\n') { fputs(\"\\\\n\", stderr); }\n        else { fputc(*p, stderr); }\n    }\n    fputc('\"', stderr);\n}");
  emit_rec_defs();
} return void;
given fn_fixture ():() then prints:("\nstatic int idtc_rec_on = 0;\nstatic long long idtc_rec_seq = 0;\nstatic FILE* idtc_eprint_target = NULL;\nstatic void idtc_show_esc(const char* s) {\n    fputc('\"', stderr);\n    for (const unsigned char* p = (const unsigned char*)s; *p; p++) {\n        if (*p == '\\\\' || *p == '\"') { fputc('\\\\', stderr); fputc(*p, stderr); }\n        else if (*p == '\\n') { fputs(\"\\\\n\", stderr); }\n        else { fputc(*p, stderr); }\n    }\n    fputc('\"', stderr);\n}\n")
given calls_node_fixture ():() then prints:("\nstatic int idtc_rec_on = 0;\nstatic long long idtc_rec_seq = 0;\nstatic FILE* idtc_eprint_target = NULL;\nstatic void idtc_show_esc(const char* s) {\n    fputc('\"', stderr);\n    for (const unsigned char* p = (const unsigned char*)s; *p; p++) {\n        if (*p == '\\\\' || *p == '\"') { fputc('\\\\', stderr); fputc(*p, stderr); }\n        else if (*p == '\\n') { fputs(\"\\\\n\", stderr); }\n        else { fputc(*p, stderr); }\n    }\n    fputc('\"', stderr);\n}\ntypedef struct { int x; int idtc_rc_pad; } idtc_rc_fx_target_t;\nstatic int idtc_rc_fx_target_n = 0;\nstatic int idtc_rc_fx_target_cap = 0;\nstatic idtc_rc_fx_target_t* idtc_rc_fx_target_buf = NULL;\nstatic long long* idtc_rc_fx_target_seq = NULL;\nstatic void idtc_rec_fx_target(int x) {\n    if (!idtc_rec_on) return;\n    if (idtc_rc_fx_target_n == idtc_rc_fx_target_cap) {\n        idtc_rc_fx_target_cap = idtc_rc_fx_target_cap ? idtc_rc_fx_target_cap * 2 : 8;\n        idtc_rc_fx_target_buf = realloc(idtc_rc_fx_target_buf, sizeof(idtc_rc_fx_target_t) * (size_t)idtc_rc_fx_target_cap);\n        idtc_rc_fx_target_seq = realloc(idtc_rc_fx_target_seq, sizeof(long long) * (size_t)idtc_rc_fx_target_cap);\n    }\n    idtc_rc_fx_target_buf[idtc_rc_fx_target_n].x = x; \n    idtc_rc_fx_target_seq[idtc_rc_fx_target_n] = idtc_rec_seq++;\n    idtc_rc_fx_target_n++;\n}\n")
