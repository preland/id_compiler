// Global state for `calls`-clause recording (docs/TESTS.md): idtc_rec_on is
// true only while the call under test (and whatever it calls) is running, and
// idtc_rec_seq gives each recorded call, across every recorded name, one
// position in the order calls actually happened -- what lets several `then
// calls` clauses be matched as a subsequence (case/around/then/more/calls/).
// IDTC_REC_MAX bounds the argument rows kept per recorded name. A decoder
// that calls a recorded helper on every bit made millions of rows and ran a
// case out of its address space; past the bound, calls are still counted and
// still take a sequence number, only their arguments are dropped. 65536 is a
// power of two, so the doubling in ../def/fn.id lands on it exactly and the
// int capacity never overflows, and it keeps one name under a few MiB for any
// realistic signature -- far past what a case pins by its arguments.
// idtc_rec_grow reports a failed allocation the way the runtime does, as a
// trap, rather than handing back NULL to be written through.
// idtc_calls_skipped/_item/_end lay out a `calls` clause's miss
// (case/around/then/more/calls/args/cmp.id) so a case writer sees the real
// arguments instead of guessing at them: the calls the clause could still
// have matched, then the ones an earlier clause's match put out of reach, at
// most five of each. idtc_show_cap bounds how much of a list is printed
// (ctype/list/more/def/show.id), since a recorded list can be any length, and
// idtc_show_listed notes that one was printed at all: rows hold a list by
// reference, so what it shows is its state when the case ended.

emit_rec_prelude() {
  emit_line("");
  emit_line("static int idtc_rec_on = 0;\nstatic long long idtc_rec_seq = 0;\n#define IDTC_REC_MAX 65536\nstatic void* idtc_rec_grow(void* p, size_t sz, int cap) {\n    void* q = realloc(p, sz * (size_t)cap);\n    if (!q) { fprintf(stderr, \"id: out of memory (%zu bytes)\\n\", sz * (size_t)cap); exit(1); }\n    return q;\n}\nstatic void idtc_show_esc(const char* s) {\n    fputc('\"', stderr);\n    for (const unsigned char* p = (const unsigned char*)s; *p; p++) {\n        if (*p == '\\\\' || *p == '\"') { fputc('\\\\', stderr); fputc(*p, stderr); }\n        else if (*p == '\\n') { fputs(\"\\\\n\", stderr); }\n        else { fputc(*p, stderr); }\n    }\n    fputc('\"', stderr);\n}\nstatic int idtc_show_cap = 0;\nstatic int idtc_show_listed = 0;\nstatic int idtc_calls_skipped(long long* seq, int kept, long long seek) {\n    int sk = 0;\n    while (sk < kept && seq[sk] <= seek) sk++;\n    return sk;\n}\nstatic int idtc_calls_item(int k, int kept, int sk) {\n    int el = kept - sk;\n    int pos = k < el ? k : k - el;\n    if (k == el) fprintf(stderr, \"; %d earlier call(s) were skipped\", sk);\n    if (pos == 0) fputs(\": \", stderr);\n    else if (pos < 5) fputs(\", \", stderr);\n    else if (pos == 5) fprintf(stderr, \", ... (%d more)\", (k < el ? el : sk) - 5);\n    return pos < 5;\n}\nstatic void idtc_calls_end(long long n, int kept) {\n    if (n > kept) fprintf(stderr, \"; recording overflowed: %lld later call(s) were counted but their arguments were not kept (at most %d per function)\", n - kept, IDTC_REC_MAX);\n    if (idtc_show_listed) fputs(\" (list arguments show their final state)\", stderr);\n    fputs(\"\\n\", stderr);\n    idtc_show_cap = 0;\n}");
  emit_rec_defs();
} return void;
