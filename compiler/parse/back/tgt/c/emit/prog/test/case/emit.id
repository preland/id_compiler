// One C function per case, run in the case's own process:
//
//   static int idtc_case_K(int idtc_fd) {
//       the `given` setup, if any
//       <argument>s, built at the parameter types
//       counters to zero
//       the call
//       counters read
//       <expected>s, built at the types they are compared as
//       compare; on a mismatch print the message and return 3
//       each `then` check, compared the same way
//       write the counts to idtc_fd; return 0
//   }
//
// The counters are read before the expected values are built: building a list
// allocates, and that allocation is not the function's. For the same reason the
// setup runs before they are zeroed and the checks after they are read.

// A library case (case_is_std, mid/names/symbols/lookup/more/std_unit.id)
// is not emitted: seed_tested never sought its function as a root, so a
// case still emitted here would call a function dce_pack has already pruned
// out of `prog` -- a reference the harness C would not compile. Its row
// (judge/more/row.id's emit_setup_line) points at idtc_case_std_skip
// instead, emitted once here, unconditionally, so IDTC_N and every index
// into idtc_case still line up whether or not this build excludes anything.
emit_cases() {
  print("static int idtc_case_std_skip(int idtc_fd) {\n    long long idtc_cnt[2] = { 0, 0 };\n    if (write(idtc_fd, idtc_cnt, sizeof idtc_cnt) != (ssize_t)sizeof idtc_cnt) return 4;\n    return 0;\n}");
  int ci = 0;
  while(ci < len((import casenode))) {
    if(case_is_std(ci) == 0) {
      emit_case_fn(ci);
    }
    ci = ci + 1;
  }
} return void;
given void_call_fixture ():() then calls emit_case_fn:(0) then calls emit_case_fn:(1)
given casegiven_fixture ():() then calls emit_case_fn:(0)

emit_case_fn(int ci) {
  print("static int idtc_case_" + ci + "(int idtc_fd) {");
  emit_case_pre(ci);
  print("    id_ctr_time = 0; id_ctr_mem = 0;");
} chain (int ci) {
  emit_case_call_wrapped(ci);
  print("    long long idtc_cnt[2] = { id_ctr_time, id_ctr_mem };");
  emit_case_post(ci);
} chain (int ci) {
  print("    if (write(idtc_fd, idtc_cnt, sizeof idtc_cnt) != (ssize_t)sizeof idtc_cnt) return 4;\n    return 0;\n}");
} return void;
given void_call_fixture {
  (0):() then calls emit_case_pre:(0) then calls emit_case_call_wrapped:(0)
  (1):() then calls emit_case_pre:(1) then calls emit_case_call_wrapped:(1)
}

// A `traps` case skips the return-value machinery entirely (emit_case_expd,
// emit_case_fail, emit_case_thens): all three read what the call under test
// left behind, and a trap means the call's process never comes back to read
// it from (case/more/judge/expected.id's emit_case_traps_fail is what a traps
// case gets instead). The write-the-counts tail after this stays the same
// either way: a traps case that DOES return falls through emit_case_traps_fail's
// own `return 3;` before ever reaching it.
emit_case_post(int ci) {
  if(case_has_out(ci, "thentraps") == 1) {
    emit_case_traps_fail(ci);
  } else {
    emit_case_expd(ci);
    emit_case_fail(ci);
    emit_case_thens(ci);
  }
} return void;
given void_call_fixture (0):() then calls emit_case_expd:(0)
given traps_case_fixture ((import fixture_ci)):() then calls emit_case_traps_fail:((import fixture_ci))
