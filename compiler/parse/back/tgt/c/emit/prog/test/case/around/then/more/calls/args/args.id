// `then calls NAME:(ARGS)` -- some recorded call to NAME, after idtc_seek (the
// case's shared search position, capture/pre.id), whose arguments equal ARGS.
// A match advances idtc_seek to that call's position, so several `calls`
// clauses on one case are matched as a subsequence, in the order written
// (docs/TESTS.md).

emit_calls_args(int ci, int ti, int node) {
  string nm = s1_of(node);
  int[] items = l1_of(node);
  emit_calls_args_body(ci, ti, nm, items);
} return void;
given calls_node_fixture (0, 0, (import fixture_calls_node)):() then prints:("    int idtc_hit0 = 0;\n    for (int idtc_j0 = 0; idtc_j0 < idtc_rc_fx_target_n; idtc_j0++) {\n        if (idtc_rc_fx_target_seq[idtc_j0] > idtc_seek && (1 && (idtc_rc_fx_target_buf[idtc_j0].x == 1))) {\n            idtc_hit0 = 1;\n            idtc_seek = idtc_rc_fx_target_seq[idtc_j0];\n            break;\n        }\n    }\n    if (!idtc_hit0) {\n        fprintf(stderr, \"%s: test failed: %s calls fx_target(...) did not match; %d call(s) to 'fx_target' were recorded\\n\", idtc_where[0], idtc_call[0], idtc_rc_fx_target_n);\n        return 3;\n    }\n")
