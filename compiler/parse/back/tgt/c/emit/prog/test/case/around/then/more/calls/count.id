// `then calls NAME:[N]` -- the exact count recorded for NAME
// (test/unit/more/rec/), regardless of when during the call under test each
// happened.

emit_calls_count(int ci, int ti, int node) {
  string nm = s1_of(node);
  int[] items = l1_of(node);
  string want = tc_value(items[0], "int");
} chain (int ci, int ti, int node) {
  string cntexpr = "idtc_rc_" + nm + "_n";
  emit_calls_count_cond(ci, nm, cntexpr, want);
} return void;

emit_calls_count_cond(int ci, string nm, string cntexpr, string want) {
  string cnd = "(" + cntexpr + " == (" + want + "))";
  emit_line("    if (!" + cnd + ") {\n        fprintf(stderr, \"%s: test failed: %s calls " + nm + "[%d], expected %d\\n\", idtc_where[" + ci + "], idtc_call[" + ci + "], " + cntexpr + ", " + want + ");\n        return 3;\n    }");
} return void;
(0, "f", "idtc_rc_f_n", "3"):() then prints:("    if (!(idtc_rc_f_n == (3))) {\n        fprintf(stderr, \"%s: test failed: %s calls f[%d], expected %d\\n\", idtc_where[0], idtc_call[0], idtc_rc_f_n, 3);\n        return 3;\n    }\n")
(1, "g", "idtc_rc_g_n", "5"):() then prints:("    if (!(idtc_rc_g_n == (5))) {\n        fprintf(stderr, \"%s: test failed: %s calls g[%d], expected %d\\n\", idtc_where[1], idtc_call[1], idtc_rc_g_n, 5);\n        return 3;\n    }\n")
