// eprint's buffer read back the same way stdout's is, and its target restored
// to the default; recording turned back off so a `then` check's own calls are
// never recorded.

emit_capture_post2(int ci) {
  emit_err_post(ci);
  emit_calls_post(ci);
} return void;
