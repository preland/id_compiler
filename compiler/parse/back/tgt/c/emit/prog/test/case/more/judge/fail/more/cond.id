// Whether the call produced what the case expects: every compared value
// matches. A void case that names no arguments compares nothing.

case_cond(int fn, int[] expd) {
  string cnd = "1";
  if(len(expd) > 0) {
    cnd = cond_parts(fn, expd);
  }
} return string cnd;
given fn_fixture ((import fixture_fn), []):("1")
given fn_fixture ((import fixture_fn), [0]):("(idtc_got == idtc_e0)")

cond_parts(int fn, int[] expd) {
  string out = "";
  int j = 0;
  while(j < len(expd)) {
    out = out + and_sep(j) + cond_part(fn, j);
    j = j + 1;
  }
} return string out;
given fn_fixture ((import fixture_fn), []):("")
given fn_fixture ((import fixture_fn), [0]):("(idtc_got == idtc_e0)")

cond_part(int fn, int j) {
  string nm = chk_name(fn, j);
  string pt = chk_type(fn, j);
  string so = tc_compare(nm, "idtc_e" + j, pt);
} return string so;
given fn_fixture ((import fixture_fn), 0):("(idtc_got == idtc_e0)")
given ret_void_fix (8, 0):("(idtc_a0 == idtc_e0)")
