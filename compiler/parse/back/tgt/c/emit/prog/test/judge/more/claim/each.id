// Every claim is written on a case, but judged once per function: a claim is
// emitted at its first appearance among its function's cases.

claim_of(int j, int ci) {
  int r = 0;
  if((import conscase)[j] == ci) {
    r = 1;
  }
} return int r;
given claim_conscase_fixture (0, 0):(1)
given claim_conscase_fixture (0, 5):(0)

claim_at(int c) {
  if(first_claim(c) == 1) {
    emit_claim(c);
  }
} return void;
