  print("    if (!(" + cnd + ")) {\n        fprintf(stderr, \"%s: test failed: %s " + lab + " = \", idtc_where[" + ci + "], idtc_call[" + ci + "]);\n        " + shown + "\n        fputs(\"" + tail + "\", stderr);\n        return 3;\n    }");
} return void;
