} chain (int node) {
  int pi = 1;
  while(pi < len(steps)) {
    rd = unbox("id_list_get(" + rd + ", " + sd_fpos(pt, steps[pi]) + ")", then_path_step(pt, steps[pi]));
    pt = then_path_step(pt, steps[pi]);
    pi = pi + 1;
  }
} return string rd;
