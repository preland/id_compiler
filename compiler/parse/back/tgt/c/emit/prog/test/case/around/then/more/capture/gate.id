// What a case emits only when it carries a clause of the kind: one line of C
// from conf.id, and, for a clause that reads a buffer back, the line that fails
// the case when the buffer holds a NUL. The texts are constants (conf.id,
// c_cap_*); which clause, which buffer and what the clause is called are the
// caller's arguments, not a function per clause.

emit_when(int has_it, string cap_text) {
  if(has_it == 1) {
    print(cap_text);
  }
} return void;
given case_fixture {
  (1, "x"):() then prints:("x\n")
  (1, "line two"):() then prints:("line two\n")
  (0, "x"):() then prints:("")
}

emit_cap_post(int ci, string cap_kind, string cap_body, string cap_var, string cap_clause) {
  if(case_has_out(ci, cap_kind) == 1) {
    print(cap_body);
    emit_cap_nul(ci, cap_var, cap_clause);
  }
} return void;
given print_fixture ((import fixture_ci), "thenprints", "B", "out", "a prints"):() then calls emit_cap_nul:((import fixture_ci), "out", "a prints")
given print_fixture ((import fixture_ci), "thenprints", "BODY", "buf", "an x"):() then prints:("BODY\n    if ((long)strlen(idtc_buf_buf) != idtc_buf_len) {\n        fprintf(stderr, \"%s: test failed: %s wrote a NUL byte, which an x clause cannot match: it compares string literals, and a string cannot hold one; check the bytes with a then check function instead\\n\", idtc_where[0], idtc_call[0]);\n        return 3;\n    }\n")
given case_fixture ((import fixture_ci), "thenprints", "B", "out", "a prints"):() then calls emit_cap_nul:[0]

emit_cap_nul(int ci, string cap_var, string cap_clause) {
  string cap_head = "    if ((long)strlen(idtc_" + cap_var + "_buf) != idtc_" + cap_var + "_len) {\n        fprintf(stderr, \"%s: test failed: %s wrote a NUL byte, which " + cap_clause + " clause cannot match: it compares string literals, and a string cannot hold one; check the bytes with a then check function instead\\n\", idtc_where[";
  print(cap_head + ci + "], idtc_call[" + ci + "]);\n        return 3;\n    }");
} return void;
given case_fixture {
  (0, "out", "a prints"):() then prints:("    if ((long)strlen(idtc_out_buf) != idtc_out_len) {\n        fprintf(stderr, \"%s: test failed: %s wrote a NUL byte, which a prints clause cannot match: it compares string literals, and a string cannot hold one; check the bytes with a then check function instead\\n\", idtc_where[0], idtc_call[0]);\n        return 3;\n    }\n")
  (2, "err", "an eprints"):() then prints:("    if ((long)strlen(idtc_err_buf) != idtc_err_len) {\n        fprintf(stderr, \"%s: test failed: %s wrote a NUL byte, which an eprints clause cannot match: it compares string literals, and a string cannot hold one; check the bytes with a then check function instead\\n\", idtc_where[2], idtc_call[2]);\n        return 3;\n    }\n")
}
