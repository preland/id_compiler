note_calls(int node) {
  string nm = s1_of(node);
  int cfn = func_node(nm);
  int[] ps = l1_of(cfn);
} chain (int node) {
  int i = 0;
  while(i < len(ps)) {
    string pt = s1_of(ps[i]);
    note_ty(pt);
    i = i + 1;
  }
} return void;
