calls_row_show(string nm, int ti, int[] params) {
  string out = "fputs(\"" + nm + "(\", stderr); ";
  int i = 0;
  while(i < len(params)) {
    out = calls_show_step(nm, ti, params, out, i);
    i = i + 1;
  }
} return string out;
