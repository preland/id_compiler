// Before the call under test: redirect stdout to a temp file for a `prints`
// clause. Declared unconditionally further down (post/) would be an unused
// variable when the case has no such clause, which is why this is emitted at
// all only when needed -- the declaration and its use are always emitted
// together, by the same query, so they are always in the same scope.

emit_capture_pre(int ci) {
  int cap_out_pre = case_has_out(ci, "thenprints");
  emit_when(cap_out_pre, (import c_cap_out_pre));
  emit_capture_pre2(ci);
} return void;
