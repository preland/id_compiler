// A case's arguments, one C local each: `idtc_a0`, `idtc_a1`, ...

emit_case_args(int ci) {
  int[] ps = (import nl1)[((import casefn)[ci])];
  int[] args = (import nl1)[((import casenode)[ci])];
  emit_arg_lines(ps, args);
} return void;
given wrap_fixture {
  (0):() then prints:("    int idtc_a0 = 0;\n")
  (0):() then calls emit_tc_decl:("int", "idtc_a0", "0")
  (0):() then calls emit_tc_decl:[1]
