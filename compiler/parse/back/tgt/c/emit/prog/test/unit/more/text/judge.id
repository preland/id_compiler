emit_tc_rest() {
  emit_cases();
  emit_tc_setup();
  emit_line("static int idtc_claims(void) {\n    int bad = 0;");
} chain () {
  claim_body();
  emit_line("    return bad;\n}");
  emit_tc_dirs();
} chain () {
  emit_tc_graph();
} return void;
