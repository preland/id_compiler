// idtc_graph, which the entry point calls first: each case's component and
// the edges between components (mid/form/unique/dump/digest/graph/hash/dag/),
// from which idtc_plan derives the run order and idtc_culprit the skips.
// With no case there is no digest to read -- emit_tests builds it only for a
// harness that has one -- and no edge is needed.
emit_tc_graph() {
  int[] tgc = dg_case_comps();
  int[] tge = [];
  int tgn = 0;
} chain () {
  if(len(tgc) > 0) {
    tge = dg_comp_edges();
    tgn = (import dg_ctr)[1];
  }
  emit_line("static void idtc_graph(void) {\n    static const int cc[] = {");
  int tgi = 0;
} chain () {
  while(tgi < len(tgc)) {
    emit_line("    " + tgc[tgi] + ",");
    tgi = tgi + 1;
  }
  emit_line("    -1};\n    static const int ce[] = {");
  tgi = 0;
} chain () {
  while(tgi < len(tge)) {
    emit_line("    " + tge[tgi] + ", " + tge[tgi + 1] + ",");
    tgi = tgi + 2;
  }
  emit_line("    -1};\n    idtc_cc = cc;\n    idtc_ce = ce;\n    idtc_nc = " + tgn + ";\n}");
} return void;
