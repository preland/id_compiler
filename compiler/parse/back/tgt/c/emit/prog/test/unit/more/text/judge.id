idtc_cul;\nstatic int idtc_height(int c) {\n    int h = 0;\n    if (idtc_hgt[c] >= 0) return idtc_hgt[c];\n    for (int i = idtc_eoff[c]; i < idtc_eoff[c + 1]; i++) {\n        int d = idtc_height(idtc_eto[i]) + 1;\n        if (d > h) h = d;\n    }\n    idtc_hgt[c] = h;\n    return h;\n}\nstatic int idtc_level(int k) {\n    return idtc_cc[k] >= 0 ? idtc_height(idtc_cc[k]) : 0;\n}\nstatic int idtc_culprit(int c) {\n    int r = -1;\n    if (idtc_cul[c] != -2) return idtc_cul[c];\n    for (int i = idtc_eoff[c]; i < idtc_eoff[c + 1] && r < 0; i++) {\n        int d = idtc_eto[i];\n        r = idtc_ff[d] >= 0 ? idtc_ff[d] : idtc_culprit(d);\n    }\n    idtc_cul[c] = r;\n    return r;\n}\nstatic int* idtc_plan(void) {\n    int ne = 0, nc, top = 0, most = 0;\n    int *ord, *at;\n    idtc_graph();\n    nc = idtc_nc;\n    while (idtc_ce[2 * ne] >= 0) ne++;\n    ord = malloc(sizeof(int) * (IDTC_N + 1));\n    at = malloc(sizeof(int) * (nc + 1));\n    idtc_eoff = calloc(nc + 2, sizeof(int));\n    idtc_eto = malloc(sizeof(int) * (ne + 1));\n    idtc_hgt = malloc(sizeof(int) * (nc + 1));\n    idtc_ff = malloc(sizeof(int) * (nc + 1));\n    idtc_cul = malloc(sizeof(int) * (nc + 1));\n    if (!ord || !at || !idtc_eoff || !idtc_eto || !idtc_hgt || !idtc_ff || !idtc_cul) return NULL;\n    for (int e = 0; e < ne; e++) idtc_eoff[idtc_ce[2 * e] + 1]++;\n    for (int c = 0; c < nc; c++) {\n        idtc_eoff[c + 1] += idtc_eoff[c];\n        at[c] = idtc_eoff[c];\n        idtc_hgt[c] = -1;\n        idtc_ff[c] = -1;\n        idtc_cul[c] = -2;\n    }\n    for (int e = 0; e < ne; e++) idtc_eto[at[idtc_ce[2 * e]]++] = idtc_ce[2 * e + 1];\n    for (int k = 0; k < IDTC_N; k++) if (idtc_level(k) > most) most = idtc_level(k);\n    for (int h = 0; h <= most; h++)\n        for (int k = 0; k < IDTC_N; k++) if (idtc_level(k) == h) ord[top++] = k;\n    free(at);\n    return ord;\n}\nint main(int argc, char** argv) {\n    int bad = 0, failed = 0, unrun = 0;\n    const char* idtc_skip = getenv(\"IDTC_SKIP\"