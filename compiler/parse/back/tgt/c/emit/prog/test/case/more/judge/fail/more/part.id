// One shown value, and the expected side as the case wrote it.

show_part(int fn, int j) {
  string nm = chk_name(fn, j);
  string pt = chk_type(fn, j);
  string so = show_sep(j) + tc_show(nm, pt);
} return string so;
given fn_fixture ((import fixture_fn), 1):("fputs(\", \", stderr); fprintf(stderr, \"%d\", idtc_got);")
given ret_void_fix (8, 0):("fprintf(stderr, \"%d\", idtc_a0);")

show_sep(int j) {
  string so = "";
  if(j > 0) {
    so = "fputs(\", \", stderr); ";
  }
} return string so;
(0):("")
(1):("fputs(\", \", stderr); ")

exp_tail(int[] expd) {
  string et = items_text(expd);
  if(len(expd) != 1) {
    et = "(" + et + ")";
  }
  string so = c_esc(", expected " + et + "\n");
} return string so;
given arith_fix ([0]):(", expected 6\\n")
given arith_fix ([0, 0]):(", expected (6, 6)\\n")
