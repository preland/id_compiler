// Whether the C being emitted is the harness's. Read where work is counted --
// a function's entry and a loop's body -- and 1 only while the harness's
// functions are emitted, so the program's C never sees a counter.

harn_init() {
  export int[] harn = [0];
} return void export harn;
():() then (import harn)[0]:(0)
():() then init_units:(0)

