// After the call has been compared: each `then` clause written on the case,
// in the order written -- a check (check/), an output clause (more/print/)
// or a call clause (more/calls/). The counters were read before any of this,
// so a clause's own work is never counted as the function's.

emit_case_thens(int ci) {
  int ti = 0;
  while(ti < len((import thennode))) {
    then_at(ci, ti);
    ti = ti + 1;
  }
} return void;

then_at(int ci, int ti) {
  if(i1_of((import thennode)[ti]) == ci) {
    emit_then(ci, ti);
  }
} return void;

emit_then(int ci, int ti) {
  int node = (import thennode)[ti];
  string kind = k_of(node);
  emit_then_kind(kind, ci, ti, node);
} return void;
