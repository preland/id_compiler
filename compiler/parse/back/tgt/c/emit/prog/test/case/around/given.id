// One setup of a case's `given`: `id_NAME();`, or -- when it was written with
// arguments, `given NAME(LIT, ...)` -- its arguments built at the setup's own
// parameter types, one C local each, in a block of their own so the names are
// free again for the case's arguments that follow. An `(import NAME)` among
// them is read here, after the setups written before this one have run.
emit_setup(int ci, int si, string nm) {
  int[] items = given_items(ci, si);
  int[] ps = [];
  if(len(items) > 0) {
    ps = (import nl1)[(func_node(nm))];
    print("    {");
  }
} chain (int ci, int si, string nm) {
  string an = names_upto(len(items));
  emit_arg_lines(ps, items);
  print("    id_" + nm + "(" + an + ");");
} chain (int ci, int si, string nm) {
  if(len(items) > 0) {
    print("    }");
  }
} return void;
