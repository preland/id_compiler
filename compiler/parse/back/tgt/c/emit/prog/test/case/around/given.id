emit_case_given(int ci) {
  string[] setups = str_split((import casegiven)[ci], " ");
  int i = 0;
  while(i < len(setups)) {
    if(setups[i] != "") {
      emit_setup(ci, i, setups[i]);
    }
    i = i + 1;
  }
} return void;
