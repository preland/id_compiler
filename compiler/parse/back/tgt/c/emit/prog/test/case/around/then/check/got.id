// One check: what it returned and what it must equal, one C local each --
// `idtc_chkT` and `idtc_wantT`, T the check's index among all checks, so two
// checks on one case never share a name. The check is called with the
// literals written after its name, if any (args.id), after the call under test
// and after the checks written before it.

emit_then_got(int ci, int ti, string chk_nm, int cfn) {
  string rt = (import ns2)[cfn];
  string ct = c_type(rt);
  emit_then_want(ci, ti, chk_nm, rt, ct);
} return void;
given chk_fixture {
  (0, 0, "chk", (import fixture_chk_fn)):() then prints:("    int idtc_chk0 = id_chk();\n    int idtc_want0 = 1;\n    if (!((idtc_chk0 == idtc_want0))) {\n        fprintf(stderr, \"%s: test failed: %s then chk() = \", idtc_where[0], idtc_call[0]);\n        fprintf(stderr, \"%d\", idtc_chk0);\n        fputs(\", expected 1\\n\", stderr);\n        return 3;\n    }\n")
  (2, 0, "chk", (import fixture_chk_fn)):() then prints:("    int idtc_chk0 = id_chk();\n    int idtc_want0 = 1;\n    if (!((idtc_chk0 == idtc_want0))) {\n        fprintf(stderr, \"%s: test failed: %s then chk() = \", idtc_where[2], idtc_call[2]);\n        fprintf(stderr, \"%d\", idtc_chk0);\n        fputs(\", expected 1\\n\", stderr);\n        return 3;\n    }\n")
}

emit_then_want(int ci, int ti, string chk_nm, string rt, string ct) {
  int[] targs = (import nl2)[((import thennode)[ti])];
  string an = emit_then_args(ti, chk_nm, targs);
  print("    " + ct + " idtc_chk" + ti + " = " + fn_sym(chk_nm) + "(" + an + ");");
} chain (int ci, int ti, string chk_nm, string rt, string ct) {
  int[] items = (import nl1)[((import thennode)[ti])];
  emit_then_judge(ci, ti, then_label(chk_nm, targs), rt, items);
} return void;
