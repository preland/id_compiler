}

emit_then_judge(int ci, int ti, string chk_lbl, string rt, int[] items) {
  string cv = tc_value(items[0], rt);
  emit_tc_decl(rt, "idtc_want" + ti, cv);
  emit_then_fail(ci, ti, chk_lbl, rt);
} return void;
