// The comparison and its message, idc.py's wording:
//
//   FILE:LINE: test failed: add(1, 2) = 3, expected 4
//
// The location and the call are the case's rows in idtc_where and idtc_call,
// which the parent also uses when a case stops without printing anything.

emit_case_end(int ci) {
  emit_case_fail(ci);
  emit_case_thens(ci);
  emit_line("    if (write(idtc_fd, idtc_cnt, sizeof idtc_cnt) != (ssize_t)sizeof idtc_cnt) return 4;\n    return 0;\n}");
} return void;

emit_case_fail(int ci) {
  int fn = (import casefn)[ci];
  int[] expd = l2_of((import casenode)[ci]);
  emit_fail_lines(ci, fn, expd);
} return void;

emit_fail_lines(int ci, int fn, int[] expd) {
  string cnd = case_cond(fn, expd);
  emit_line("    if (!(" + cnd + ")) {\n        fprintf(stderr, \"%s: test failed: %s = \", idtc_where[" + ci + "], idtc_call[" + ci + "]);");
  emit_fail_show(fn, expd);
} return void;
