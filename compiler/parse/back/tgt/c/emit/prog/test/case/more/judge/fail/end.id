// The comparison and its message, idc.py's wording:
//
//   FILE:LINE: test failed: add(1, 2) = 3, expected 4
//
// The location and the call are the case's rows in idtc_where and idtc_call,
// which the parent also uses when a case stops without printing anything.

emit_case_fail(int ci) {
  int fn = (import casefn)[ci];
  int[] expd = (import nl2)[((import casenode)[ci])];
  string cnd = case_cond(fn, expd);
} chain (int ci) {
  print("    if (!(" + cnd + ")) {\n        fprintf(stderr, \"%s: test failed: %s = \", idtc_where[" + ci + "], idtc_call[" + ci + "]);");
  string shows = show_all(fn, expd);
  string tail = exp_tail(expd);
} chain (int ci) {
  print("        " + shows + "\n        fputs(\"" + tail + "\", stderr);\n        return 3;\n    }");
} return void;
