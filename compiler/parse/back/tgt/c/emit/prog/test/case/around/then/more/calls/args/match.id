emit_calls_args_cond(int ci, int ti, string nm, int[] params, int[] items) {
  string rowcond = calls_row_cond(nm, ti, params, items);
  string rowshow = calls_row_show(nm, ti, params);
  emit_calls_args_emit(ci, ti, nm, rowcond, rowshow, items);
} return void;
