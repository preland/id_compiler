// `then calls NAME:(ARGS)` -- some recorded call to NAME, after idtc_seek (the
// case's shared search position, capture/pre/redirect.id), whose arguments equal ARGS.
// A match advances idtc_seek to that call's position, so several `calls`
// clauses on one case are matched as a subsequence, in the order written
// (docs/TESTS.md).

emit_calls_args(int ci, int ti, int node) {
  string nm = s1_of(node);
  int[] items = l1_of(node);
  emit_calls_args_body(ci, ti, nm, items);
} return void;
given calls_node_fixture (0, 0, (import fixture_calls_node)):() then prints:("    int idtc_hit0 = 0;\n    for (int idtc_j0 = 0; idtc_j0 < idtc_rc_fx_target_kept; idtc_j0++) {\n        if (idtc_rc_fx_target_seq[idtc_j0] > idtc_seek && (1 && (idtc_rc_fx_target_buf[idtc_j0].x == 1))) {\n            idtc_hit0 = 1;\n            idtc_seek = idtc_rc_fx_target_seq[idtc_j0];\n            break;\n        }\n    }\n    if (!idtc_hit0) {\n        int idtc_sk0 = idtc_calls_skipped(idtc_rc_fx_target_seq, idtc_rc_fx_target_kept, idtc_seek);\n        fprintf(stderr, \"%s: test failed: %s calls %s did not match any of the %d recorded call(s) to 'fx_target'%s\", idtc_where[0], idtc_call[0], \"fx_target(1)\", idtc_rc_fx_target_kept - idtc_sk0, idtc_sk0 ? \" after the previous clause's match\" : \"\");\n        idtc_show_cap = 16;\n        idtc_show_listed = 0;\n        for (int idtc_k0 = 0; idtc_k0 < idtc_rc_fx_target_kept; idtc_k0++) {\n            int idtc_j0 = (idtc_k0 + idtc_sk0) % idtc_rc_fx_target_kept;\n            if (idtc_calls_item(idtc_k0, idtc_rc_fx_target_kept, idtc_sk0)) { fputs(\"fx_target(\", stderr); fprintf(stderr, \"%d\", idtc_rc_fx_target_buf[idtc_j0].x); fputs(\")\", stderr); }\n        }\n        idtc_calls_end(idtc_rc_fx_target_n, idtc_rc_fx_target_kept);\n        return 3;\n    }\n")
