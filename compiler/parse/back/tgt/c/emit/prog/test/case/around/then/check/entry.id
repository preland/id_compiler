// `then (import NAME):(value)` and `then (import NAME)[i]:(value)`: the export
// is read where a check function's result would be -- after the call and
// after the counters were read -- trapping first when nothing has set it
// (checked_read, prog/head/decl/export/uninit.id), and an element is read the
// way an index in a program is, unboxed to its type (op/index/get.id), or its
// length taken for `then len((import NAME))` (then_len_call). From
// there it is the same local, the same literal and the same failure line a
// check function gets (got.id, fail.id), with `(import NAME)[i]` where the
// function's name would be.
emit_then_imp(int ci, int ti, int node) {
  string vt = then_imp_type(node);
  string rd = checked_read((import ns1)[node]);
  string lbl = "(import " + (import ns1)[node] + ")";
} chain (int ci, int ti, int node) {
  int[] imp_ix = (import nl2)[node];
  int[] items = (import nl1)[node];
  if(len(imp_ix) == 1) {
    rd = unbox("id_list_get(" + rd + ", " + tc_value(imp_ix[0], "int") + ")", vt);
    lbl = lbl + "[" + lit_text(imp_ix[0]) + "]";
  }
} chain (int ci, int ti, int node) {
  if((import nkind)[node] == "thenlen") {
    rd = then_len_call((import ns1)[node]) + rd + ")";
    lbl = "len(" + lbl + ")";
  }
  emit_line("    " + c_type(vt) + " idtc_chk" + ti + " = " + rd + ";");
  emit_then_judge(ci, ti, lbl, vt, items);
} return void;
