// Dispatch by node kind (../then.id), and the original check's own entry
// point: what it names, then what it returns (got.id).
//
// The "then" branch is driven by chk_fixture (mid/.../given/then/more/print/
// print.id), whose "chk() return int" is the niladic, registered check
// target the other fixtures here lack: fx_target takes an argument and
// "nope" does not exist, and emit_then_got reads the callee's return type
// unconditionally, so either would crash rather than emit.

emit_then_kind(string kind, int ci, int ti, int node) {
  if(kind == "then") {
    emit_then_check(ci, ti, node);
  } else if(kind == "thenprints" || kind == "theneprints") {
    emit_then_print(ci, ti, node);
  } else {
    emit_then_calls(ci, ti, node);
  }
} return void;
