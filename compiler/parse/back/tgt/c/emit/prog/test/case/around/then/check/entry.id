emit_then_check(int ci, int ti, int node) {
  string chk_nm = (import ns1)[node];
  if((import nkind)[node] == "thenimp" || (import nkind)[node] == "thenlen") {
    emit_then_imp(ci, ti, node);
  } else {
    emit_then_got(ci, ti, chk_nm, func_node(chk_nm));
  }
} return void;
