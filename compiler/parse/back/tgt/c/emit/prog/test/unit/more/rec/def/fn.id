// The recorder itself: NAME's own parameter list (its signature, unchanged --
// param_str(fn) in struct.id). ../call.id calls it from inside NAME's body with
// NAME's own parameters, by name (row/names.id), since that is what is in
// scope there. Appends a row only while idtc_rec_on is set
// (case/around/then/more/capture/), counting every such call but keeping
// at most IDTC_REC_MAX rows (../scan/prelude.id).

emit_rec_fn(string nm, string sigtext, int[] params) {
  string assigns = rec_row_assigns(params, "idtc_rc_" + nm + "_buf[idtc_rc_" + nm + "_kept]");
  emit_rec_fn_body(nm, sigtext, assigns);
} return void;
given fn_fixture {
  ("fx_target", "int x", (import fixture_params)):() then prints:("static void idtc_rec_fx_target(int x) {\n    if (!idtc_rec_on) return;\n    long long idtc_rs = idtc_rec_seq++;\n    idtc_rc_fx_target_n++;\n    if (idtc_rc_fx_target_kept == IDTC_REC_MAX) return;\n    if (idtc_rc_fx_target_kept == idtc_rc_fx_target_cap) {\n        idtc_rc_fx_target_cap = idtc_rc_fx_target_cap ? idtc_rc_fx_target_cap * 2 : 8;\n        idtc_rc_fx_target_buf = idtc_rec_grow(idtc_rc_fx_target_buf, sizeof(idtc_rc_fx_target_t), idtc_rc_fx_target_cap);\n        idtc_rc_fx_target_seq = idtc_rec_grow(idtc_rc_fx_target_seq, sizeof(long long), idtc_rc_fx_target_cap);\n    }\n    idtc_rc_fx_target_buf[idtc_rc_fx_target_kept].x = x; \n    idtc_rc_fx_target_seq[idtc_rc_fx_target_kept] = idtc_rs;\n    idtc_rc_fx_target_kept++;\n}\n")
  ("g", "void", []):() then prints:("static void idtc_rec_g(void) {\n    if (!idtc_rec_on) return;\n    long long idtc_rs = idtc_rec_seq++;\n    idtc_rc_g_n++;\n    if (idtc_rc_g_kept == IDTC_REC_MAX) return;\n    if (idtc_rc_g_kept == idtc_rc_g_cap) {\n        idtc_rc_g_cap = idtc_rc_g_cap ? idtc_rc_g_cap * 2 : 8;\n        idtc_rc_g_buf = idtc_rec_grow(idtc_rc_g_buf, sizeof(idtc_rc_g_t), idtc_rc_g_cap);\n        idtc_rc_g_seq = idtc_rec_grow(idtc_rc_g_seq, sizeof(long long), idtc_rc_g_cap);\n    }\n    \n    idtc_rc_g_seq[idtc_rc_g_kept] = idtc_rs;\n    idtc_rc_g_kept++;\n}\n")
}

emit_rec_fn_body(string nm, string sigtext, string assigns) {
  print("static void idtc_rec_" + nm + "(" + sigtext + ") {\n    if (!idtc_rec_on) return;\n    long long idtc_rs = idtc_rec_seq++;\n    idtc_rc_" + nm + "_n++;\n    if (idtc_rc_" + nm + "_kept == IDTC_REC_MAX) return;\n    if (idtc_rc_" + nm + "_kept == idtc_rc_" + nm + "_cap) {\n        idtc_rc_" + nm + "_cap = idtc_rc_" + nm + "_cap ? idtc_rc_" + nm + "_cap * 2 : 8;\n        idtc_rc_" + nm + "_buf = idtc_rec_grow(idtc_rc_" + nm + "_buf, sizeof(idtc_rc_" + nm + "_t), idtc_rc_" + nm + "_cap);\n        idtc_rc_" + nm + "_seq = idtc_rec_grow(idtc_rc_" + nm + "_seq, sizeof(long long), idtc_rc_" + nm + "_cap);\n    }\n    " + assigns + "\n    idtc_rc_" + nm + "_seq[idtc_rc_" + nm + "_kept] = idtc_rs;\n    idtc_rc_" + nm + "_kept++;\n}");
} return void;
("fx_target", "int x", "buf.x = x; "):() then prints:("static void idtc_rec_fx_target(int x) {\n    if (!idtc_rec_on) return;\n    long long idtc_rs = idtc_rec_seq++;\n    idtc_rc_fx_target_n++;\n    if (idtc_rc_fx_target_kept == IDTC_REC_MAX) return;\n    if (idtc_rc_fx_target_kept == idtc_rc_fx_target_cap) {\n        idtc_rc_fx_target_cap = idtc_rc_fx_target_cap ? idtc_rc_fx_target_cap * 2 : 8;\n        idtc_rc_fx_target_buf = idtc_rec_grow(idtc_rc_fx_target_buf, sizeof(idtc_rc_fx_target_t), idtc_rc_fx_target_cap);\n        idtc_rc_fx_target_seq = idtc_rec_grow(idtc_rc_fx_target_seq, sizeof(long long), idtc_rc_fx_target_cap);\n    }\n    buf.x = x; \n    idtc_rc_fx_target_seq[idtc_rc_fx_target_kept] = idtc_rs;\n    idtc_rc_fx_target_kept++;\n}\n")
("g", "void", ""):() then prints:("static void idtc_rec_g(void) {\n    if (!idtc_rec_on) return;\n    long long idtc_rs = idtc_rec_seq++;\n    idtc_rc_g_n++;\n    if (idtc_rc_g_kept == IDTC_REC_MAX) return;\n    if (idtc_rc_g_kept == idtc_rc_g_cap) {\n        idtc_rc_g_cap = idtc_rc_g_cap ? idtc_rc_g_cap * 2 : 8;\n        idtc_rc_g_buf = idtc_rec_grow(idtc_rc_g_buf, sizeof(idtc_rc_g_t), idtc_rc_g_cap);\n        idtc_rc_g_seq = idtc_rec_grow(idtc_rc_g_seq, sizeof(long long), idtc_rc_g_cap);\n    }\n    \n    idtc_rc_g_seq[idtc_rc_g_kept] = idtc_rs;\n    idtc_rc_g_kept++;\n}\n")
