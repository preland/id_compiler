// The recorder itself: NAME's own parameter list (its signature, unchanged --
// param_str(fn) in def.id). ../call.id calls it from inside NAME's body with
// NAME's own parameters, by name (row/names.id), since that is what is in
// scope there. Appends a row only while idtc_rec_on is set
// (case/around/then/more/capture/).

emit_rec_fn(string nm, string sigtext, int[] params) {
  string assigns = rec_row_assigns(params, "idtc_rc_" + nm + "_buf[idtc_rc_" + nm + "_n]");
  emit_rec_fn_body(nm, sigtext, assigns);
} return void;
given fn_fixture ("fx_target", "int x", (import fixture_params)):() then prints:("static void idtc_rec_fx_target(int x) {\n    if (!idtc_rec_on) return;\n    if (idtc_rc_fx_target_n == idtc_rc_fx_target_cap) {\n        idtc_rc_fx_target_cap = idtc_rc_fx_target_cap ? idtc_rc_fx_target_cap * 2 : 8;\n        idtc_rc_fx_target_buf = realloc(idtc_rc_fx_target_buf, sizeof(idtc_rc_fx_target_t) * (size_t)idtc_rc_fx_target_cap);\n        idtc_rc_fx_target_seq = realloc(idtc_rc_fx_target_seq, sizeof(long long) * (size_t)idtc_rc_fx_target_cap);\n    }\n    idtc_rc_fx_target_buf[idtc_rc_fx_target_n].x = x; \n    idtc_rc_fx_target_seq[idtc_rc_fx_target_n] = idtc_rec_seq++;\n    idtc_rc_fx_target_n++;\n}\n")
given fn_fixture ("g", "void", []):() then prints:("static void idtc_rec_g(void) {\n    if (!idtc_rec_on) return;\n    if (idtc_rc_g_n == idtc_rc_g_cap) {\n        idtc_rc_g_cap = idtc_rc_g_cap ? idtc_rc_g_cap * 2 : 8;\n        idtc_rc_g_buf = realloc(idtc_rc_g_buf, sizeof(idtc_rc_g_t) * (size_t)idtc_rc_g_cap);\n        idtc_rc_g_seq = realloc(idtc_rc_g_seq, sizeof(long long) * (size_t)idtc_rc_g_cap);\n    }\n    \n    idtc_rc_g_seq[idtc_rc_g_n] = idtc_rec_seq++;\n    idtc_rc_g_n++;\n}\n")

emit_rec_fn_body(string nm, string sigtext, string assigns) {
  emit_line("static void idtc_rec_" + nm + "(" + sigtext + ") {\n    if (!idtc_rec_on) return;\n    if (idtc_rc_" + nm + "_n == idtc_rc_" + nm + "_cap) {\n        idtc_rc_" + nm + "_cap = idtc_rc_" + nm + "_cap ? idtc_rc_" + nm + "_cap * 2 : 8;\n        idtc_rc_" + nm + "_buf = realloc(idtc_rc_" + nm + "_buf, sizeof(idtc_rc_" + nm + "_t) * (size_t)idtc_rc_" + nm + "_cap);\n        idtc_rc_" + nm + "_seq = realloc(idtc_rc_" + nm + "_seq, sizeof(long long) * (size_t)idtc_rc_" + nm + "_cap);\n    }\n    " + assigns + "\n    idtc_rc_" + nm + "_seq[idtc_rc_" + nm + "_n] = idtc_rec_seq++;\n    idtc_rc_" + nm + "_n++;\n}");
} return void;
("fx_target", "int x", "buf.x = x; "):() then prints:("static void idtc_rec_fx_target(int x) {\n    if (!idtc_rec_on) return;\n    if (idtc_rc_fx_target_n == idtc_rc_fx_target_cap) {\n        idtc_rc_fx_target_cap = idtc_rc_fx_target_cap ? idtc_rc_fx_target_cap * 2 : 8;\n        idtc_rc_fx_target_buf = realloc(idtc_rc_fx_target_buf, sizeof(idtc_rc_fx_target_t) * (size_t)idtc_rc_fx_target_cap);\n        idtc_rc_fx_target_seq = realloc(idtc_rc_fx_target_seq, sizeof(long long) * (size_t)idtc_rc_fx_target_cap);\n    }\n    buf.x = x; \n    idtc_rc_fx_target_seq[idtc_rc_fx_target_n] = idtc_rec_seq++;\n    idtc_rc_fx_target_n++;\n}\n")
("g", "void", ""):() then prints:("static void idtc_rec_g(void) {\n    if (!idtc_rec_on) return;\n    if (idtc_rc_g_n == idtc_rc_g_cap) {\n        idtc_rc_g_cap = idtc_rc_g_cap ? idtc_rc_g_cap * 2 : 8;\n        idtc_rc_g_buf = realloc(idtc_rc_g_buf, sizeof(idtc_rc_g_t) * (size_t)idtc_rc_g_cap);\n        idtc_rc_g_seq = realloc(idtc_rc_g_seq, sizeof(long long) * (size_t)idtc_rc_g_cap);\n    }\n    \n    idtc_rc_g_seq[idtc_rc_g_n] = idtc_rec_seq++;\n    idtc_rc_g_n++;\n}\n")
