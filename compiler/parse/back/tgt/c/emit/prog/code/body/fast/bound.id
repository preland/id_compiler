// A conjunct `counter < limit` read as a bound, or, when the counter is not a
// variable or the limit is not one the guard can read, as junk (lp_cond).

lp_bound(int lq_c) {
  int lq_l = (import ni1)[lq_c];
  if((import nkind)[lq_l] == "var" && lp_limit((import ni2)[lq_c]) == 1) {
    push((import lpj), (import ns1)[lq_l]);
    push((import lpn), (import ni2)[lq_c]);
  } else {
    integer_list_set((import lpbad), 0, 1);
  }
} return void;
