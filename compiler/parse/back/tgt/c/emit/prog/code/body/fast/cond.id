// The bounds a loop's condition guarantees on entry to every iteration: each
// conjunct of the form `counter < limit`, where the limit is a variable, an
// integer literal or `len(variable)`. A `&&` holds both sides inside the body.
// The condition is run once per iteration, outside the body the guard looks at,
// so it may hold nothing else -- a call in it could resize a list -- and
// anything else in it marks the loop as not coverable (lpbad).

lp_cond(int lq_c) {
  if((import nkind)[lq_c] == "bin") {
    lp_bin(lq_c);
  } else {
    integer_list_set((import lpbad), 0, 1);
  }
} return void;
