// The three texts a temporary argument turns into (temp_all.id): its C
// variable and the expression that fills it, the name the call uses, and the
// free that follows the call. Each is empty or the argument as written for an
// argument that is not a temporary.

tmp_decl(int id, int i) {
  int[] args = (import nl1)[id];
  string tx_d = "";
  if(esc_tmp_free(id, i) == 1) {
    tx_d = c_type(type_of(args[i])) + " idft" + i + " = " + emit_expr(args[i]) + "; ";
  }
} return string tx_d;
given esc_ffix {
  ((import eff_ctp), 0):("IdList* idft0 = id_ff_make(n); ")
  ((import eff_ctp), 1):("")
}

tmp_arg(int id, int i) {
  int[] args = (import nl1)[id];
  string tx_a = "idft" + i;
  if(esc_tmp_free(id, i) == 0) {
    tx_a = emit_expr(args[i]);
  }
} return string tx_a;
given esc_ffix {
  ((import eff_ctp), 0):("idft0")
  ((import eff_cmk), 0):("n")
}

tmp_free(int id, int i) {
  string tx_f = "";
  if(esc_tmp_free(id, i) == 1) {
    tx_f = esc_tmp_fn(id, i) + "(idft" + i + "); ";
  }
} return string tx_f;
given esc_ffix {
  ((import eff_ctp), 0):("id_list_free(idft0); ")
  ((import eff_ctp), 1):("")
}
