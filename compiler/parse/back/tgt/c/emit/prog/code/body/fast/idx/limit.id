// The room each counter of the loop's condition has left, for a second
// counter's largest value: its limit less its value less one, summed with that
// counter's own value (the first operand, pushed by the caller) in one sum.

lx_hlim(string[] lg_tk) {
  int lg_i = 0;
  while(lg_i < len((import lpj))) {
    lx_hone(lg_tk, lg_i);
    lg_i = lg_i + 1;
  }
  push(lg_tk, "+:" + (len((import lpj)) + 1));
} return void;
given lpq_cs(2) (["a"]):(["a", "v:lkn", "wide", "v:lkj", "wide", "k:1", "-:3", "+:2"])
given lpq_cs(3) ([]):(["v:lmn", "wide", "v:lmi", "wide", "k:1", "-:3", "v:lmm", "wide", "v:lmj", "wide", "k:1", "-:3", "+:3"])

lx_hone(string[] lg_tk, int lg_bx) {
  int lg_nn = (import lpn)[lg_bx];
  lp_nul(lg_nn);
  lp_ntok(lg_tk, lg_nn);
} chain (string[] lg_tk, int lg_bx) {
  push(lg_tk, "wide");
  push(lg_tk, "v:" + (import lpj)[lg_bx]);
  push(lg_tk, "wide");
} chain (string[] lg_tk, int lg_bx) {
  push(lg_tk, "k:1");
  push(lg_tk, "-:3");
} return void;
given lpq_cs(3) ([], 1):(["v:lmm", "wide", "v:lmj", "wide", "k:1", "-:3"])
given lpf_cs(1) ([], 0):(["v:lbv", "len", "wide", "wide", "v:lbj", "wide", "k:1", "-:3"]) then (import lpcond)[0]:("v:lbv null !=")
