// Whether any node lo..hi is a call to a function of the program.

lp_uany(int lq_lo, int lq_hi) {
  int lq_r = 0;
  int lq_i = lq_lo;
  while(lq_i <= lq_hi && lq_r == 0) {
    lq_r = lp_ucall(lq_i);
    lq_i = lq_i + 1;
  }
} return int lq_r;
given lpf_more ((import lpf_log), (import lpf_hig)):(1)
given lpf_more ((import lpf_loa), (import lpf_hia)):(0)
given lpf_more ((import lpf_loc), (import lpf_hic)):(0)
