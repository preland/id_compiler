// does before it looks at a body: lpj and lpn hold its counters and limits.
// The conditions are those of LS, LV, LK, LM, LN, LT, LU, LP, LI, LW and LZ.

lpq_cs(int lfi_k) {
  lpq_lw();
  lp_cond((import lpq_cl)[lfi_k]);
} return void;
