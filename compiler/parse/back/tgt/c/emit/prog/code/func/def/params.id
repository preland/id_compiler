// Parameter list for a signature: "void" if none, else "c_type name, ...".

param_str(int id) {
  int[] l1_of_v = l1_of(id);
  string ret_s = pstr(l1_of_v);
} return string ret_s;
given nz_prog_fixture ((import nz_mainfn)):("int argc")
given nz_prog_fixture ((import nz_plainfn)):("void")

pstr(int[] params) {
  string s = "void";
  if(len(params) > 0) {
    s = list_params(params);
  }
} return string s;
given nz_main_parts ((import nz_mainparams)):("int argc")
([]):("void")

list_params(int[] params) {
  string out = "";
  int i = 0;
  while(i < len(params)) {
    string s1_of_v = s1_of(params[i]);
    out = out + sep_arg(i) + c_type(s1_of_v) + " " + s2_of(params[i]);
    i = i + 1;
  }
} return string out;
given nz_main_parts ((import nz_mainparams)):("int argc")
([]):("")
