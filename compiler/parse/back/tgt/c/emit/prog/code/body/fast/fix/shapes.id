  export int lpq_kp = lpf_lt("lpj2", lpq_np);
} chain () {
  export int lpq_m1 = lpf_term("*", "lpj2", 3);
  export int lpq_m2 = lpf_term("*", "lpj2", 5);
  export int lpq_up = node_txt2("bin", "+", lpq_m1, lpq_m2);
} chain () {
  export int lpq_xp = lpf_ix("lpv2", lpq_up);
  export int lpq_ap = lpf_acc("lps2", lpq_xp);
  export int lpq_ip = lpf_inc("lpj2", 1);
} chain () {
  export int lpq_wp = lpf_wh(lpq_kp, lpq_ap, lpq_ip);
  export int lpq_lop = (import ni1)[lpq_wp] + 1;
  export int lpq_hip = lpq_wp - 1;
} return void;
