// A name that is not a counter of the loop's condition, by what the body does
// to it: nothing (kind 2), or one write, which makes it a second counter when
// it is a step after the access (kind 4), or a local set once when it is a
// declaration before the access at the top of the body (kind 5).

lx_wr(string lg_nm, int lg_id, int lg_lo, int lg_hi, int lg_dp) {
  int lg_w = lp_cnt(lg_lo, lg_hi, lg_nm, 0);
  int lg_k = 0;
  if(lg_w == 0) {
    lg_k = 2;
  }
} chain (string lg_nm, int lg_id, int lg_lo, int lg_hi, int lg_dp) {
  if(lg_w == 1 && lg_dp == 0) {
    lg_k = lx_one(lg_nm, lg_id, lg_lo, lg_hi);
  }
} return int lg_k;
given lpq_cs(0) ("lsc", (import lpq_xs), (import lpq_los), (import lpq_his), 0):(2)
given lpq_cs(2) ("lkk", (import lpq_xk), (import lpq_lok), (import lpq_hik), 0):(4)
given lpq_cs(1) ("lvq", (import lpq_xv), (import lpq_lov), (import lpq_hiv), 0):(5)
given lpq_cs(2) ("lkk", (import lpq_xk), (import lpq_lok), (import lpq_hik), 1):(0)

lx_one(string lg_nm, int lg_id, int lg_lo, int lg_hi) {
  int lg_f = lp_first(lg_lo, lg_hi, lg_nm);
  int lg_k = 0;
  if((import nkind)[lg_f] == "assign") {
    lg_k = 4 * lx_sec(lg_f, lg_id, lg_lo, lg_hi);
  }
} chain (string lg_nm, int lg_id, int lg_lo, int lg_hi) {
  if((import nkind)[lg_f] == "decl") {
    lg_k = 5 * lx_dec(lg_f, lg_id, lg_lo, lg_hi);
  }
} return int lg_k;
given lpq_cs(2) ("lkk", (import lpq_xk), (import lpq_lok), (import lpq_hik)):(4)
given lpq_cs(1) ("lvq", (import lpq_xv), (import lpq_lov), (import lpq_hiv)):(5)
given lpq_cs(5) ("ltk", (import lpq_xt), (import lpq_lot), (import lpq_hit)):(0)
given lpq_cs(6) ("luk", (import lpq_xu), (import lpq_lou), (import lpq_hiu)):(0)

lx_ctr(int lg_bx, int lg_id, string lg_nm, int lg_lo, int lg_hi) {
  int lg_r = lp_lim(lg_bx, lg_lo, lg_hi);
  if(lg_r == 1) {
    lg_r = lp_steps(lg_id, lg_nm, lg_lo, lg_hi);
  }
} return int lg_r;
given lpq_cs(0) (0, (import lpq_xs), "lsj", (import lpq_los), (import lpq_his)):(1)
given lpf_cs(3) (0, (import lpf_xd), "ldj", (import lpf_lod), (import lpf_hid)):(0)
given lpf_cs(5) (0, (import lpf_xr), "lrj", (import lpf_lor), (import lpf_hir)):(0)
