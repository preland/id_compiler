// The cells of a constructor: each argument as C, boxed to the type of the
// field it initialises.

ctor_cells(string sd_nm, int[] sd_as) {
  string out = "";
  int sd_k = 0;
  while(sd_k < len(sd_as)) {
    out = out + sep_at(", ", sd_k) + ctor_cell(sd_nm, sd_as, sd_k);
    sd_k = sd_k + 1;
  }
} return string out;
given sd_use_fixture {
  ("P", [(import sd_one), (import sd_one)]):("(long long)(1), (long long)(1)")
  ("Q", [(import sd_str)]):("(long long)(intptr_t)(id_str_dup(ID_S(s)))")
}

ctor_cell(string sd_nm, int[] sd_as, int sd_k) {
  string sd_code = esc_ctor_code(sd_nm, sd_as, sd_k, emit_expr(sd_as[sd_k]));
  string sd_ft = sd_cell((import sdftype), sd_nm, sd_k);
  string ret_s = box(sd_code, sd_ft);
} return string ret_s;
given sd_use_fixture {
  ("P", [(import sd_one), (import sd_one)], 1):("(long long)(1)")
  ("Q", [(import sd_str)], 0):("(long long)(intptr_t)(id_str_dup(ID_S(s)))")
}
