// The two literals the guard reads: a plain non-negative one (an offset), and
// the plain 1 of a counter's step.

lp_lit(int lq_b) {
  int lq_r = (import ni2)[lq_b] == 0 && (import ni1)[lq_b] >= 0;
} return int lq_r;
given lpf_more {
  ((import lpf_n0)):(1)
  ((import lpf_ngl)):(0)
  ((import lpf_bgl)):(0)
}

lp_one(int lq_b) {
  int lq_r = (import nkind)[lq_b] == "int" && (import ni1)[lq_b] == 1 && (import ni2)[lq_b] == 0;
} return int lq_r;
given lpf_more {
  ((import lpf_n0)):(1)
  ((import lpf_n1)):(0)
  ((import lpf_q)):(0)
  ((import lpf_bgl)):(0)
}
