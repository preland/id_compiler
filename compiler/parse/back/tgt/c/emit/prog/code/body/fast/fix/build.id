// Builders for the pieces of a loop the cases need, each answering the node it
// built last and numbering its nodes in the order the parser does, operands
// first.

lpf_ix(string lfs_list, int lfi_x) {
  int lfi_a = node_txt("var", lfs_list);
  int lfi_r = node_index(lfi_a, lfi_x);
} return int lfi_r;
given lpf_one ("v", 0):(2) then (import ns1)[1]:("v")
given lpf_one ("w", 0):(2) then (import ni2)[2]:(0)

lpf_acc(string lfs_s, int lfi_e) {
  int lfi_a = node_txt("var", lfs_s);
  int lfi_b = node_txt2("bin", "+", lfi_a, lfi_e);
  int lfi_r = node_txt1("assign", lfs_s, lfi_b);
} return int lfi_r;
given lpf_one ("s", 0):(3) then (import ns1)[3]:("s")
given lpf_two ("t", 1):(4) then (import ni2)[3]:(1)

lpf_inc(string lfs_j, int lfi_k) {
  int lfi_a = node_txt("var", lfs_j);
  int lfi_b = node_txt2("int", "" + lfi_k, lfi_k, 0);
  int lfi_c = node_txt2("bin", "+", lfi_a, lfi_b);
} chain (string lfs_j, int lfi_k) {
  int lfi_r = node_txt1("assign", lfs_j, lfi_c);
} return int lfi_r;
given lpf_env ("j", 1):(3) then (import ni1)[1]:(1)
given lpf_env ("q", 2):(3) then (import ni1)[1]:(2)
