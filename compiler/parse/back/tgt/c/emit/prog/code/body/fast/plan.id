// Planning a loop: its bounds, the accesses they cover, and, if there are any,
// whether the body is clean. A body that is not clean covers nothing.

lp_plan(int lq_w) {
  lp_reset();
  lp_cond((import ni1)[lq_w]);
  lp_scan((import ni1)[lq_w] + 1, lq_w - 1);
} chain (int lq_w) {
  lp_guard((import ni1)[lq_w] + 1, lq_w - 1);
  int lq_r = len((import lpset)) > 0;
} return int lq_r;
