// The accesses of a loop body the guard can cover. The nodes lo..hi are the
// body's: a node is numbered after the nodes it is made of, so the condition's
// nodes come before its root and the statements after it, up to the `while`
// node itself.

lp_scan(int lq_lo, int lq_hi) {
  int lq_i = lq_lo;
  while(lq_i <= lq_hi) {
    lp_node(lq_i, lq_lo, lq_hi);
    lq_i = lq_i + 1;
  }
} return void;
