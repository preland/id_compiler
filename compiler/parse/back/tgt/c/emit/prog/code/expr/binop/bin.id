// Binary expression. Four forms: id_concat for string `+`, a strcmp for
// string equality, a runtime-helper call for the shifts and word division
// (see op/helper/), and ordinary infix otherwise.

emit_bin(int id) {
  string s = "";
  if(is_concat(id)) {
    s = emit_concat(id);
  } else {
    s = emit_op2(id);
  }
} return string s;
given nz_bin_add_fixture ((import nz_bin_add)):("(7 + 3)")
given nz_bin_concat_fixture ((import nz_bin_concat)):("id_concat(\"hi\", \"yo\")")

emit_op2(int id) {
  string s = "";
  if(is_strcmp(id)) {
    s = emit_strcmp(id);
  } else {
    s = emit_op3(id);
  }
} return string s;
given nz_bin_eq_fixture ((import nz_bin_eq)):("(strcmp(\"hi\", \"yo\") == 0)")
given nz_bin_add_fixture ((import nz_bin_add)):("(7 + 3)")

emit_infix(int id) {
  int i1_of_v = i1_of(id);
  string s1_of_v = s1_of(id);
  string s = infix_line(id, i1_of_v, s1_of_v);
} return string s;
given nz_bin_add_fixture ((import nz_bin_add)):("(7 + 3)")
given nz_bin_eq_fixture ((import nz_bin_eq)):("(\"hi\" == \"yo\")")
