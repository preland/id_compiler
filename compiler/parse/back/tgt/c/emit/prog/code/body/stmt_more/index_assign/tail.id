// No trailing ";": iassign4 supplies it, the same way whether or not
// iset_hz wraps this text in a binding -- a bound index's own text must not
// carry a semicolon that would land inside the comma expression.
iset_code(int id, string val) {
  int i1_of_v = (import ni1)[id];
  string sd_ixc = emit_idx(id);
  string lp_base = emit_expr(i1_of_v);
} chain (int id, string val) {
  string ret_s = lp_set(id, lp_base, sd_ixc, val);
} return string ret_s;
