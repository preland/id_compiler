// Hoist locals declared inside a while body.

hoist_loop(int id) {
  if((import nkind)[id] == "while") {
    int[] l1_of_v = (import nl1)[id];
    hoist_list(l1_of_v);
  }
} return void;
given tyc_fix (3):() then calls hoist_list:[1]
given tyc_fix (4):() then calls hoist_list:[0]

// The tail of hoist_decl: the C type is derived from the declared type only
// once its export flag has already gated whether to emit at all.
hoist_decl_line(string hoist_ty_name, string hoist_var_name) {
  string c_type_v = c_type(hoist_ty_name);
  string esc_i = esc_init_code(hoist_var_name);
  emit_line("    " + c_type_v + " " + hoist_var_name + esc_i + ";");
} return void;
given tyc_fix ("int", "y"):() then prints:("    int y;\n")
given esc_fix ("int[]", "w"):() then prints:("    IdList* w = NULL;\n")
given esc_fix ("int[]", "z"):() then prints:("    IdList* z;\n")
given tyc_fix ("int", "z"):() then prints:("    int z;\n")

// A sequencing temporary's name (../../expr/atom/order/): idsq_ and the
// node's distance below the node of the function being emitted, which
// emit_def (../../func/def/body/def.id) sets into sqbase. A function's nodes
// all precede its own node, so the distance is positive and unique within
// it -- and, unlike the node id itself, it stays put when a function earlier
// in the program gains or loses a node, so an edit changes the C of the
// function edited and of no other (bin/idc compiles and caches that C a
// unit at a time). Outside any function (sqbase 0), the node id as before.
// Filed here because order/ and its files are at their caps.
sq_name(int u) {
  int sqn = u;
  if((import sqbase)[0] > u) {
    sqn = (import sqbase)[0] - u;
  }
  string s = "idsq_" + sqn;
} return string s;
given env_init (7):("idsq_7")
given sq_based (7):("idsq_13")
