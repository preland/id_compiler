
// One condition's text, computed once per level of an if / else-if chain
// (chain.id, seq_conds) so that a unit's declaration -- printed as a side
// effect of emit_expr, inside emit_seq -- lands before the chain's first
// line rather than at this level's own, possibly later, position.
cond_text_of(int if_id) {
  int cond_id = (import ni1)[if_id];
  string cond_text = emit_expr(cond_id);
} return string cond_text;
given stmt_fix {
  (4):("5")
  (3):("5")
}

// The state emit_def (func/def/body/def.id) leaves while it emits the body
// of a function whose node is 20, for sq_name's own cases (body/hoist/
// hoist_loop.id is at its three-function cap).
sq_based() {
  env_init();
  integer_list_set((import sqbase), 0, 20);
} return void;
():() then calls env_init:[1] then (import sqbase)[0]:(20)
():() then len((import tyname)):(7)
():() then init_units:(0)
