// Whether one access is in range for every iteration, given the guard: its
// list is a plain variable, its counter has a bound from the loop condition,
// and nothing the guard compares changes inside the body -- the list is not
// reassigned, the limit is not written, the counter only ever steps by one,
// and the access comes before the counter's first step. Then in every
// iteration the counter is at least its value on entry (the guard checks that
// is not negative) and below the limit, so the guard's one comparison of the
// limit with the list's length covers every iteration.

lp_ok(int lq_id, int lq_jn, int lq_lo, int lq_hi) {
  int lq_bx = find_str((import lpj), (import ns1)[lq_jn]);
  int lq_r = 0;
  if(lq_bx >= 0 && (import nkind)[((import ni1)[lq_id])] == "var") {
    lq_r = lp_stable(lq_id, lq_bx, lq_lo, lq_hi);
  }
} return int lq_r;
given lpf_cs(0) ((import lpf_xa), (import lpf_ja), (import lpf_loa), (import lpf_hia)):(1)
given lpf_cs(3) ((import lpf_xd), (import lpf_jd), (import lpf_lod), (import lpf_hid)):(0)
given lpf_cs(4) ((import lpf_xe), (import lpf_je), (import lpf_loe), (import lpf_hie)):(0)
given lpf_cs(0) ((import lpf_xa), (import lpf_jb), (import lpf_loa), (import lpf_hia)):(0)

lp_stable(int lq_id, int lq_bx, int lq_lo, int lq_hi) {
  int lq_r = lp_lim(lq_bx, lq_lo, lq_hi);
  if(lq_r == 1) {
    lq_r = lp_held(lq_id, lq_bx, lq_lo, lq_hi);
  }
} return int lq_r;
given lpf_cs(0) ((import lpf_xa), 0, (import lpf_loa), (import lpf_hia)):(1)
given lpf_cs(3) ((import lpf_xd), 0, (import lpf_lod), (import lpf_hid)):(0)
given lpf_cs(5) ((import lpf_xr), 0, (import lpf_lor), (import lpf_hir)):(0)
given lpf_cs(6) ((import lpf_xw), 0, (import lpf_low), (import lpf_hiw)):(0)

lp_lim(int lq_bx, int lq_lo, int lq_hi) {
  string lq_ln = lp_lname((import lpn)[lq_bx]);
  int lq_r = 1;
  if(lq_ln != "") {
    lq_r = lp_cnt(lq_lo, lq_hi, lq_ln, 0) == 0;
  }
} return int lq_r;
