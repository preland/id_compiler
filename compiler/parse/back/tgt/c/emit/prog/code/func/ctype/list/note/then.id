// The type each `then` check compares at: its function's return type. A check
// returning a list needs that type's helpers even when no case compares at it.
//
// A `then` node's s1 is always a function's name; the other then-family
// kinds' is not (front/.../case/then/more/) -- "" for prints/eprints, and for
// a calls clause the recorded function's own name, whose *parameters* would
// need noting, not its return type, so it is skipped here too rather than
// noted wrongly. func_node("") is -1, which is what the guard below is for.

tc_collect_thens() {
  int ti = 0;
  while(ti < len((import thennode))) {
    note_check(ti);
    ti = ti + 1;
  }
} return void;
given print_fixture ():() then calls note_check:[1]
given calls_node_fixture ():() then calls note_check:[1]

note_check(int ti) {
  int node = (import thennode)[ti];
  if(k_of(node) == "then") {
    note_check_then(node);
  }
} return void;
given print_fixture (0):() then prints:("")
given calls_node_fixture (0):() then prints:("")

note_check_then(int node) {
  string chk_nm = s1_of(node);
  int cfn = func_node(chk_nm);
  note_fn_ret(cfn);
} return void;
given then_node_fixture ((import fixture_then_node)):() then prints:("")
given then_node_fixture ((import fixture_then_bad)):() then prints:("")
