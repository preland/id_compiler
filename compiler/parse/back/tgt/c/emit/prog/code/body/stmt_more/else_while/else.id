
// The else arm.

emit_else(int id, string ind) {
  emit_line(ind + "} else {");
  int[] l2_of_v = (import nl2)[id];
  emit_body_close(l2_of_v, ind);
} return void;
given stmt_fix (4, ""):() then prints:("} else {\n}\n")
given stmt_fix (3, "  "):() then prints:("  } else {\n  }\n")

// The closing lines a block shares with a while loop: the body, then the
// brace. Shared rather than duplicated, since the two are identical once
// their opening line has already been emitted.
emit_body_close(int[] close_body_ids, string ind) {
  emit_block(close_body_ids, ind + "    ");
  emit_line(ind + "}");
} return void;
given stmt_fix ([], ""):() then prints:("}\n")
given stmt_fix ([], "  "):() then prints:("  }\n")

// The two flow statements, then on to if/while. id's `while` is a C `while`,
// so a `break` is C's; an early return is C's `return` at the statement's own
// indent.
es_flow(int id, string ind) {
  if((import nkind)[id] == "break") {
    emit_line(ind + "break;");
  } else if((import nkind)[id] == "ret") {
    string ret_code_v = ret_code(id);
    emit_line(ind + ret_code_v);
  } else {
    es4(id, ind);
  }
} return void;
given flow_emit_fixture ((import flow_brk), "  "):() then prints:("  break;\n")
given flow_emit_fixture ((import flow_retn), "  "):() then prints:("  return 7;\n")
