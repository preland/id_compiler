// The environment the loop-versioning cases build their trees in: env_init's
// tables, init_idx's name index (sym_func and fix_fnix read it) and init_rtc's
// builtin table (lp_known reads it), and harn_init's and init_tyc's, which
// emitting a loop reads. lpf_one and lpf_two add the leaves the builders below
// take as operands.

lpf_env() {
  env_init();
  init_idx();
  init_rtc();
} chain () {
  harn_init();
  init_tyc();
} return void;
():() then len((import tyc)):(5)
():() then (import lvc)[0]:(1)
():() then len((import harn)):(1)
():() then calls init_tyc:()
():() then init_units:(0)
():() then calls env_init:[1]

lpf_one() {
  lpf_env();
  export int lpf_n0 = node_txt2("int", "1", 1, 0);
} return void;
():() then calls node_txt2:("int", "1", 1, 0)
():() then len((import tyc)):(5)
():() then init_units:(0)
():() then calls lpf_env:[1]

lpf_two() {
  lpf_one();
  export int lpf_n1 = node_txt2("int", "2", 2, 0);
} return void;
():() then calls node_txt2:("int", "2", 2, 0)
():() then calls node_txt2:("int", "1", 1, 0)
():() then init_units:(0)
():() then calls lpf_one:[1]
