// A list printed as a case writes it, `[1, 2, 3]`, and the name its helpers
// are spelled with.

emit_show_body(string key, string et) {
  string ga = unbox("a->data[i]", et);
  string sh = tc_show(ga, et);
  emit_line("static void idtc_show_" + key + "(IdList* a) {\n    fputs(\"[\", stderr);\n    for (int i = 0; i < a->len; i++) {\n        if (i) fputs(\", \", stderr);\n        " + sh + "\n    }\n    fputs(\"]\", stderr);\n}");
} return void;

tc_key(string type) {
  string et = list_elem(type);
  string so = key_text(et);
} return string so;

key_text(string t) {
  string out = "";
  int i = 0;
  while(i < len(t)) {
    out = out + key_at(t, i);
    i = i + 1;
  }
} return string out;
