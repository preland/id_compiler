// The node of a name's first write in lo..hi, or hi + 1 when there is none:
// every access numbered below it is read before the name changes, because
// nodes are numbered in the order the source is read and a body runs in that
// order, one pass.

lp_first(int lq_lo, int lq_hi, string lq_nm) {
  int lq_i = lq_lo;
  while(lq_i <= lq_hi && lp_w(lq_i, lq_nm, 0) == 0) {
    lq_i = lq_i + 1;
  }
} return int lq_i;
