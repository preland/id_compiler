// The text of a list base in the guarded copy: the local copy of its header
// lp_hbase made, for a covered access of a list that has one, and otherwise
// the base as written. lp_hty names the struct a base points to; a bytes
// buffer has its own header.

lp_hb(string lq_btxt, int lq_id) {
  string lq_ht = lq_btxt;
  if(lp_hit(lq_id) == 1 && find_str((import lph), lq_btxt) >= 0) {
    lq_ht = "idh_" + lq_btxt;
  }
} return string lq_ht;
given lpf_on_hdr ("lav", (import lpf_xa)):("idh_lav")
given lpf_on ("lav", (import lpf_xa)):("lav")

lp_hty(string lq_t) {
  string lq_ht = "IdList";
  if(cell_ns(lq_t) == "id_bytes_") {
    lq_ht = "IdBytes";
  }
} return string lq_ht;
("bytes"):("IdBytes")
("int[]"):("IdList")
("string[]"):("IdList")
