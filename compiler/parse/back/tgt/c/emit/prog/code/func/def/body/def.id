
// A function definition: signature, hoisted locals, body, return. Its node is
// what its sequencing temporaries are named from (sq_name, ../../../body/
// hoist/hoist_loop.id).

emit_def(int id) {
  string sig_v = sig(id);
  lset((import sqbase), 0, id);
  string lq_attr = lp_flat(id);
} chain (int id) {
  emit_line(lq_attr + sig_v + " {");
  emit_def_body(id);
} return void;
given nz_prog_fixture ((import nz_mainfn)):() then prints:("int id_main(int argc) {\n    return 7;\n}\n")
given nz_prog_fixture ((import nz_plainfn)):() then prints:("void id_run(void) {\n    return;\n}\n")

emit_def_body(int id) {
  hoist(id);
  emit_entry(id);
  emit_tail(id);
} return void;
given nz_prog_fixture ((import nz_mainfn)):() then prints:("    return 7;\n}\n")
given nz_prog_fixture ((import nz_plainfn)):() then prints:("    return;\n}\n")

emit_tail(int id) {
  emit_main_init(id);
  emit_tail2(id);
} return void;
given nz_prog_fixture ((import nz_mainfn)):() then prints:("    return 7;\n}\n")
given nz_prog_fixture ((import nz_plainfn)):() then prints:("    return;\n}\n")
