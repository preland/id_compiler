// A struct's compare: every field equal, read back at the field's type -- the
// same test a list's helper makes of its elements, one field at a time.

st_eq_expr(string sd_nm) {
  string out = "1";
  int sd_k = 0;
  while(sd_k < sd_nfields(sd_nm)) {
    out = st_eq_join(out, sd_nm, sd_k);
    sd_k = sd_k + 1;
  }
} return string out;
given sd_note_fixture ("P"):("((int)(a->data[0]) == (int)(b->data[0])) && ((int)(a->data[1]) == (int)(b->data[1]))")
given sd_note_fixture ("Q"):("(strcmp((char*)(intptr_t)(a->data[0]), (char*)(intptr_t)(b->data[0])) == 0)")

st_eq_join(string out, string sd_nm, int sd_k) {
  string sd_ft = sd_cell((import sdftype), sd_nm, sd_k);
  string ga = unbox("a->data[" + sd_k + "]", sd_ft);
  string gb = unbox("b->data[" + sd_k + "]", sd_ft);
} chain (string out, string sd_nm, int sd_k) {
  string so = tc_compare(ga, gb, sd_ft);
  if(sd_k > 0) {
    so = out + " && " + so;
  }
} return string so;
given sd_note_fixture ("", "P", 0):("((int)(a->data[0]) == (int)(b->data[0]))")
given sd_note_fixture ("X", "P", 1):("X && ((int)(a->data[1]) == (int)(b->data[1]))")
