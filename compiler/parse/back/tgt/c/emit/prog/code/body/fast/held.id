lp_steps(int lq_id, string lq_js, int lq_lo, int lq_hi) {
  int lq_r = lp_cnt(lq_lo, lq_hi, lq_js, 2) == 0;
  if(lq_r == 1) {
    lq_r = lq_id < lp_first(lq_lo, lq_hi, lq_js);
  }
} return int lq_r;
