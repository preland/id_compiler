// The set of list types, in the order first met, and their prototypes.
//
//   tctys  every list type the harness needs helpers for

note_one(string ty) {
  if(find_str((import tctys), ty) < 0) {
    push((import tctys), ty);
  }
} return void;
given tc_types_init ("int[]"):() then tctys_len:(1)
given tctys_note_one_setup ("int[]"):() then tctys_len:(1)

tc_types_init() {
  export string[] tctys = [];
} return void;
given nz_env ():() then check_failed:(0)
given nz_env ():() then init_units:(0)

emit_ty_protos() {
  int i = 0;
  while(i < len((import tctys))) {
    emit_ty_proto((import tctys)[i]);
    i = i + 1;
  }
} return void;
given tctys_note_one_setup ():() then prints:("static int idtc_eq_int(IdList* a, IdList* b);\nstatic void idtc_show_int(IdList* a);\n")
given tc_types_init ():() then prints:("")
