
// A function definition: signature, hoisted locals, body, return.

emit_def(int id) {
  string sig_v = sig(id);
  emit_line(sig_v + " {");
  emit_def_body(id);
} return void;

emit_def_body(int id) {
  hoist(id);
  emit_count("    ");
  emit_tail(id);
} return void;

emit_tail(int id) {
  emit_main_init(id);
  emit_tail2(id);
} return void;
