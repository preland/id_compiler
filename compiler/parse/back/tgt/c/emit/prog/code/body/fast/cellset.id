cell_value_fits(int cbx_node) {
  int cbx_ok = 0;
  if((import nkind)[cbx_node] == "int") {
    cbx_ok = cell_int_fits(cbx_node);
  } else {
    cbx_ok = cell_derived_fits(cbx_node);
  }
} return int cbx_ok;
