// A store into a list or a bytes buffer. cbx_fit says whether the value is
// already known to be a byte, so the store can skip the range check: an int
// literal of 0..255, a mask by one (`x & 255`), or a read of another bytes
// buffer (every cell of one is a byte).

cell_set_text(string cbx_ns, string cbx_base, string cbx_index, string cbx_value, int cbx_hit, int cbx_fit) {
  string cbx_text = cell_set_name(cbx_ns, cbx_fit) + "(" + cbx_base + ", " + cbx_index + ", " + cbx_value + ")";
  if(cbx_hit == 1) {
    cbx_text = "(" + cbx_base + ")->data[" + cbx_index + "] = " + cell_set_rhs(cbx_ns, cbx_value, cbx_fit);
  }
} return string cbx_text;
