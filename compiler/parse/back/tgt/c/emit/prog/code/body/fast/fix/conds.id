// A guard of two or three clauses, for lp_pre's and lp_add's cases: lpf_conds
// holds `x` exists and `y` is not negative, lpf_conds3 adds that `n` is at most
// the length of `z` less one. lpcond and lpg are filled as lp_put leaves them,
// by hand, so that these cases do not stand on it.

lpf_conds() {
  lpf_env();
  push((import lpcond), "v:x null !=");
  push((import lpcond), "v:y k:0 >=");
} chain () {
  string[] lfc_a = ["v:x", "null", "!=", "|", "v:y", "k:0", ">=", "|"];
  list_string_extend((import lpg), lfc_a);
} return void;
():() then len((import lpcond)):(2)
():() then len((import lpg)):(8)

lpf_conds3() {
  lpf_conds();
  push((import lpcond), "v:n v:z len wide k:1 -:2 <=");
  string[] lfc_b = ["v:n", "v:z", "len", "wide", "k:1", "-:2", "<=", "|"];
} chain () {
  list_string_extend((import lpg), lfc_b);
} return void;
():() then len((import lpcond)):(3)
():() then (import lpg)[14]:("<=")

lpf_planned() {
  lp_plan((import lpf_wa));
} return void;
given lpf_in(0) {
  ():() then lpf_nset:(1)
  ():() then lpf_flag:(1)
}
