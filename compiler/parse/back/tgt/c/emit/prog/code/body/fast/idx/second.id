// The two single writes an index may read through. A second counter is stepped
// once, after the access, and only while every counter of the condition is
// stepped once and some step is made on every path of the body (lx_psec): then
// it is at most its entry value plus the number of iterations so far. A local
// is the one write of a declaration of an int at the top of the body, before
// the access, whose terms keep their values until the access.

lx_sec(int lg_f, int lg_id, int lg_lo, int lg_hi) {
  int lg_r = lg_id < lg_f && lp_isinc(lg_f) == 1;
  if(lg_r == 1) {
    lg_r = lx_psec(lg_lo, lg_hi);
  }
} return int lg_r;
