// A function type's parameters as C spells them inside the pointer-to-function
// type a call through a function value casts `fn` to (c_clo_ptr): the types
// alone, joined by commas.

c_type_list(string[] pts) {
  string out = "";
  int i = 0;
  while(i < len(pts)) {
    out = out + sep_at(", ", i) + c_type(pts[i]);
    i = i + 1;
  }
} return string out;
given lc_env2 {
  (["int", "string"]):("int, char*")
  ([]):("")
}

// Where unit_file (unit.id, at its three-function cap) starts looking: where
// the last lookup stopped, unless id lies before that -- node ids grow along
// pnodes, so an earlier id means a second pass over `prog` has begun (the
// program's, after the harness's) and the walk starts again from the top.
unit_from(int id) {
  int uc = (import unitc)[1];
  if(uc < len((import pnodes)) && id < (import pnodes)[uc]) {
    uc = 0;
  }
} return int uc;
given unit_t_mark(1, 1) {
  ((import unit_t_fb)):(1)
  ((import unit_t_fa)):(0)
}
