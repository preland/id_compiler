// A function type's parameters as C spells them inside a pointer-to-function
// type: the types alone, and `void` for none, which in C is not the same as
// an empty list.

c_fn_params(string[] pts) {
  string out = "void";
  if(len(pts) > 0) {
    out = c_type_list(pts);
  }
} return string out;
given lc_env2 (["int"]):("int")
given lc_env2 ([]):("void")

c_type_list(string[] pts) {
  string out = "";
  int i = 0;
  while(i < len(pts)) {
    out = out + sep_arg(i) + c_type(pts[i]);
    i = i + 1;
  }
} return string out;
given lc_env2 (["int", "string"]):("int, char*")
given lc_env2 ([]):("")

// Where unit_file (unit.id, at its three-function cap) starts looking: where
// the last lookup stopped, unless id lies before that -- node ids grow along
// pnodes, so an earlier id means a second pass over `prog` has begun (the
// program's, after the harness's) and the walk starts again from the top.
unit_from(int id) {
  int uc = (import unitc)[1];
  if(uc < len((import pnodes)) && id < (import pnodes)[uc]) {
    uc = 0;
  }
} return int uc;
given unit_t_late ((import unit_t_fb)):(1)
given unit_t_late ((import unit_t_fa)):(0)
