// LR, whose body writes the variable that bounds it, and LW, whose body
// writes the list it reads: neither can be covered.

lpf_lr() {
  lpf_lh();
  export int lpf_nr = node_txt("var", "lrn");
  export int lpf_cr = lpf_lt("lrj", lpf_nr);
} chain () {
  export int lpf_xr = lpf_ix("lrv", node_txt("var", "lrj"));
  export int lpf_sr = lpf_acc("lrn", lpf_xr);
  export int lpf_ir = lpf_inc("lrj", 1);
} chain () {
  export int lpf_wr = lpf_wh(lpf_cr, lpf_sr, lpf_ir);
  export int lpf_lor = (import ni1)[lpf_wr] + 1;
  export int lpf_hir = lpf_wr - 1;
} return void;
():() then calls lpf_lh:[1]
():() then init_units:(0)

lpf_lw() {
  lpf_lr();
  export int lpf_nw = node_txt("var", "lwn");
  export int lpf_cw = lpf_lt("lwj", lpf_nw);
} chain () {
  export int lpf_xw = lpf_ix("lwv", node_txt("var", "lwj"));
  export int lpf_sw = lpf_acc("lwv", lpf_xw);
  export int lpf_iw = lpf_inc("lwj", 1);
} chain () {
  export int lpf_ww = lpf_wh(lpf_cw, lpf_sw, lpf_iw);
  export int lpf_low = (import ni1)[lpf_ww] + 1;
  export int lpf_hiw = lpf_ww - 1;
} return void;
():() then calls lpf_lr:[1]
():() then init_units:(0)

lpf_lx() {
  lpf_lw();
  export int lpf_nx = node_txt("var", "lxn");
  export int lpf_c1 = lpf_lt("lxj", lpf_nx);
} chain () {
  export int lpf_x0 = node_txt2("bin", "!=", node_txt("var", "lxf"), (import lpf_n0));
  export int lpf_cx = node_txt2("bin", "&&", lpf_c1, lpf_x0);
  export int lpf_xx = lpf_ix("lxv", node_txt("var", "lxj"));
} chain () {
  export int lpf_sx = lpf_acc("lxs", lpf_xx);
  export int lpf_jx = lpf_inc("lxj", 1);
  export int lpf_wx = lpf_wh(lpf_cx, lpf_sx, lpf_jx);
} chain () {
  export int lpf_lox = (import ni1)[lpf_wx] + 1;
  export int lpf_hix = lpf_wx - 1;
} return void;
():() then calls lpf_lw:[1]
():() then init_units:(0)
