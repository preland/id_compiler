// Hoist locals: id is function-scoped (a var declared in a branch may be used
// after it), so every declaration in the body becomes a C declaration at the
// top of the function, and the body emits the initializer as an assignment.

hoist(int id) {
  int[] l2_of_v = (import nl2)[id];
  hoist_list(l2_of_v);
} return void;
given tyc_fix {
  (7):() then prints:("    int y;\n")
  (7):() then calls hoist_list:([1, 2])
  (4):() then prints:("")
}

hoist_list(int[] stmts) {
  int i = 0;
  while(i < len(stmts)) {
    hoist_one(stmts[i]);
    i = i + 1;
  }
} return void;
given tyc_fix {
  ([1]):() then prints:("    int y;\n")
  ([1, 1]):() then prints:("    int y;\n    int y;\n")
  ([]):() then prints:("")
}

hoist_one(int id) {
  if((import nkind)[id] == "decl") {
    hoist_decl(id);
  } else {
    hoist_nested(id);
  }
} return void;
given tyc_fix {
  (1):() then prints:("    int y;\n")
  (3):() then calls hoist_nested:(3)
  (3):() then prints:("")
}
