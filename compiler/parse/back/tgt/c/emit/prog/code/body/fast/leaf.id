// The size and the calls of a function, from its nodes: those from where the
// function before it in `prog` ended through its own. A function not found in
// `prog` gets every node from 0, which is too many to be a leaf.

lp_wide(int lq_fn) {
  int lq_lo = lp_lo(lq_fn);
  int lq_r = 1;
  if(lp_small(lq_lo, lq_fn) == 1) {
    lq_r = lp_range(lq_lo, lq_fn, 0);
  }
} return int lq_r;
given lpf_more {
  ((import lpf_leaf)):(0)
  ((import lpf_grow)):(1)
  ((import lpf_f1)):(1)
}

lp_lo(int lq_fn) {
  int lq_k = list_index_of((import prog), lq_fn);
  int lq_lo = 0;
  if(lq_k > 0) {
    lq_lo = (import prog)[lq_k - 1] + 1;
  }
} return int lq_lo;
given lpf_more {
  ((import lpf_leaf)):(0)
  ((import lpf_grow)):((import lpf_gl))
  ((import lpf_f1)):((import lpf_l1))
}

lp_range(int lq_lo, int lq_hi, int lq_md) {
  int lq_r = 0;
  int lq_i = lq_lo;
  while(lq_i <= lq_hi && lq_r == 0) {
    lq_r = lp_callbad(lq_i, lq_md);
    lq_i = lq_i + 1;
  }
} return int lq_r;
given lpf_more {
  ((import lpf_loa), (import lpf_hia), 0):(0)
  ((import lpf_log), (import lpf_hig), 0):(1)
  ((import lpf_log), (import lpf_hig), 1):(0)
  ((import lpf_loc), (import lpf_hic), 1):(1)
}
