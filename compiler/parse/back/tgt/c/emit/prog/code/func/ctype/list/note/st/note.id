// The struct types the harness needs helpers for: every struct a case passes,
// expects or checks, a struct held in one of those, and the struct elements of
// a list of structs. One compare and one print each, `idtc_eqs_NAME` and
// `idtc_shows_NAME`, beside the list helpers (../../more/) and emitted with
// them; a struct is noted before its fields are, so a struct that holds a list
// of itself is noted once.
//
//   tcsts  every struct type the harness needs helpers for

note_struct(string ty) {
  if(ty_kind_is(ty, "struct") == 1 && find_str((import tcsts), ty) < 0) {
    push((import tcsts), ty);
    note_sfields(ty);
  }
} return void;
given sd_note_fixture {
  ("P"):() then len((import tcsts)):(1)
  ("int"):() then len((import tcsts)):(0)
  ("W"):() then len((import tcsts)):(2)
}

note_sfields(string ty) {
  int sd_k = 0;
  while(sd_k < sd_nfields(ty)) {
    note_ty(sd_cell((import sdftype), ty, sd_k));
    sd_k = sd_k + 1;
  }
} return void;
given sd_note_fixture {
  ("nope"):() then len((import tcsts)):(0)
  ("W"):() then len((import tcsts)):(1)
  ("P"):() then len((import tcsts)):(0)
}

