given nz_prog_fixture ((import nz_plainfn)):("id_main(); return 0;")

main_call(int m) {
  string mc = "id_main()";
  if(has_args(m)) {
    mc = "id_main(argc, id_args)";
  }
} return string mc;
given nz_prog_fixture ((import nz_mainfn)):("id_main(argc, id_args)")
given nz_prog_fixture ((import nz_plainfn)):("id_main()")

// the func node named "main", or -1
find_main() {
  int i = 0;
  int m = 0 - 1;
  while(i < len((import prog))) {
    m = main_at(i, m);
    i = i + 1;
  }
} return int m;
