// The call body inside the wrapper: `return id_main(...);` for an int return,
// `id_main(...); return 0;` otherwise; with or without the marshalled args.

main_body(int m) {
  string bd = "return " + main_call(m) + ";";
  if(s2_of(m) != "int") {
    bd = main_call(m) + "; return 0;";
  }
} return string bd;
