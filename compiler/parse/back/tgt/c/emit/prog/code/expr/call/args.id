// Comma-separated argument list. The separator is sep_at(", ", i), shared
// with params; id's bare `=` equality becomes C `==` where an operator is
// spelled (str_pick(op, "=", "==", op)).

emit_args(int[] args) {
  string out = "";
  int i = 0;
  while(i < len(args)) {
    out = out + sep_at(", ", i) + emit_expr(args[i]);
    i = i + 1;
  }
} return string out;
