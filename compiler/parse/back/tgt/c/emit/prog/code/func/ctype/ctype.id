// id type -> C type. Any list type is the generic IdList*; a function type is
// a pointer to a function (c_fn_type); otherwise the scalar's spelling is a
// lookup in this target's own column of the type registry, not a chain of
// `if`.
//
// docs/BACKENDS.md asks for exactly this: mid/types/registry/ holds the facts that
// are true of a type in any target (kind, width, signedness) and each target
// owns one column of spellings beside it. The column lives here rather than
// in the registry because "long long" is not a fact about `word`, it is a
// fact about C.

c_type(string t) {
  string ct = "IdList*";
  if(ty_is_func(t) == 1) {
    ct = c_fn_type(t);
  } else if(ty_is_list(t) == 0) {
    ct = c_scalar(t);
  }
} return string ct;
given lc_env2 ("int[]"):("IdList*")
given lc_env2 ("func(int) return int"):("__typeof__(int (*)(int))")

// C can spell a pointer to a function only around a name -- `void (*f)(int)` --
// and every declaration this emitter writes is a type followed by a name.
// __typeof__ makes the pointer type one that stands in front of a name, and
// nests: `__typeof__(void (*)(int)) f`.
c_fn_type(string t) {
  string rt = fn_ret(t);
  string[] pts = fn_params(t);
  string ct = "__typeof__(" + c_type(rt) + " (*)(" + c_fn_params(pts) + "))";
} return string ct;
given lc_env2 ("func(int) return int"):("__typeof__(int (*)(int))")
given lc_env2 ("func() return void"):("__typeof__(void (*)(void))")

// A type with no registry row has no spelling either. It answers `int` for
// the same reason the old chain ended there -- nothing upstream emits a type
// the checks have not already accepted -- but it is now one place rather than
// four, and it cannot be reached by forgetting a case.
c_scalar(string t) {
  int r = ty_find(t);
  string ct = "int";
  if(r >= 0) {
    ct = (import tyc)[r];
  }
} return string ct;
given lc_env2 ("int"):("int")
given lc_env2 ("string"):("char*")
