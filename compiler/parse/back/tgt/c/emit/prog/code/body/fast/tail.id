// Whether a `+` node is `variable + literal` with a plain, non-negative
// literal: the only sum an index may be for the guard to cover it.

lp_tail(int lq_x) {
  int lq_a = (import ni1)[lq_x];
  int lq_b = (import ni2)[lq_x];
  int lq_r = lp_vlit(lq_a, lq_b);
} return int lq_r;
given lpf_more {
  ((import lpf_ob)):(1)
  ((import lpf_vvs)):(0)
}

lp_vlit(int lq_a, int lq_b) {
  int lq_r = 0;
  if((import nkind)[lq_a] == "var" && (import nkind)[lq_b] == "int") {
    lq_r = lp_lit(lq_b);
  }
} return int lq_r;
given lpf_more {
  ((import lpf_q), (import lpf_n0)):(1)
  ((import lpf_n0), (import lpf_n0)):(0)
  ((import lpf_q), (import lpf_ngl)):(0)
  ((import lpf_q), (import lpf_bgl)):(0)
}
