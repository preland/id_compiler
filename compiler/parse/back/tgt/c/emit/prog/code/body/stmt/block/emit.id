
// Emit a block of statements, and the start of the statement dispatch.
// A decl is emitted as an assignment (its C declaration was hoisted).

emit_block(int[] stmts, string ind) {
  int i = 0;
  while(i < len(stmts)) {
    emit_stmt(stmts[i], ind);
    i = i + 1;
  }
} return void;
given stmt_fix ([1, 2], ""):() then prints:("y = 5;\nz = 5;\n")
given stmt_fix ([], ""):() then prints:("")

emit_stmt(int id, string ind) {
  if((import nkind)[id] == "decl") {
    string s2_of_v = (import ns2)[id];
    int i1_of_v = (import ni1)[id];
    emit_decl_mark(id, s2_of_v, i1_of_v, ind);
  } else {
    es2(id, ind);
  }
} return void;
given stmt_fix (1, ""):() then prints:("y = 5;\n")
given stmt_fix (2, ""):() then prints:("z = 5;\n")

// The tail of a decl statement, once its target name and initializer are known.
emit_decl_line(string decl_target, int decl_init_id, string ind) {
  esc_pick_set(decl_target, decl_init_id);
  string emit_expr_v = emit_expr(decl_init_id);
  string esc_c = esc_store_code(decl_target, emit_expr_v, decl_init_id);
} chain (string decl_target, int decl_init_id, string ind) {
  esc_cons_set(0 - 1);
  emit_line(ind + esc_c);
} return void;
given stmt_fix ("y", 0, "  "):() then prints:("  y = 5;\n")
given stmt_fix ("z", 0, ""):() then prints:("z = 5;\n")
given esc_fix ("w", (import efc_three), "  "):() then prints:("  { IdList* idfe_o = w; w = 3; id_list_free(idfe_o); }\n")
given esc_fix ("s", (import efc_three), ""):() then prints:("s = 3;\n")
