emit_loop_fast(int id, string ind) {
  string lq_pre = lp_pre();
  print(ind + "if (" + lq_pre + ") {");
  lp_hoist(id, ind + "    ");
} chain (int id, string ind) {
  integer_list_set((import lpon), 0, 1);
  emit_while(id, ind + "    ");
  integer_list_set((import lpon), 0, 0);
} chain (int id, string ind) {
  print(ind + "} else {");
  emit_while(id, ind + "    ");
  print(ind + "}");
} return void;
