// A while loop, emitted twice when lp_plan covers some of its accesses: the
// guarded copy under the guard, and the unchanged loop under its `else`. The
// guard runs once, before the loop, so a loop whose guard fails runs exactly
// as it would have, and traps at the same iteration with the same message.

emit_loop(int id, string ind) {
  int lq_fast = lp_plan(id);
  if(lq_fast == 1) {
    emit_loop_fast(id, ind);
  } else {
    emit_while(id, ind);
  }
} return void;
