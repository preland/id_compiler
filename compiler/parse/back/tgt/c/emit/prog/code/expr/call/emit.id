// Call emission: a normal call is id_NAME(args); print and eprint coerce their
// single argument to string context, matching idc.py's id_print(to_string(...)).

emit_call(int id) {
  string s = "";
  if((import ns1)[id] == "print" || (import ns1)[id] == "eprint") {
    s = emit_print(id);
  } else {
    s = ec2(id);
  }
} return string s;
given nz_call_eprint_fixture ((import nz_call_eprint)):("id_eprint(id_str_of_int(7))")
given nz_call_foo_fixture ((import nz_call_foo)):("id_foo(7)")

emit_print(int id) {
  int arg = (import nl1)[id][0];
  string sym_v = fn_sym((import ns1)[id]);
  string s = sym_v + "(" + arg_str(arg) + ")";
} return string s;
given nz_call_print_fixture ((import nz_call_print)):("id_print(ID_S(\"hi\"))")
given nz_call_eprint_fixture ((import nz_call_eprint)):("id_eprint(id_str_of_int(7))")
