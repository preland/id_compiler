lx_hleaf(string[] lg_tk, int lg_e, int lg_id, int lg_lo, int lg_hi, int lg_dp) {
  int lg_k = lx_kind(lg_e, lg_id, lg_lo, lg_hi, lg_dp);
  lx_hcl(lg_e, lg_k);
  if(lg_k == 3) {
    lx_hctr(lg_tk, lg_e);
  }
} chain (string[] lg_tk, int lg_e, int lg_id, int lg_lo, int lg_hi, int lg_dp) {
  if(lg_k == 4) {
    lx_hsec(lg_tk, lg_e);
