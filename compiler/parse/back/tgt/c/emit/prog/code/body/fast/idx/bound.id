// The largest value an index takes over the loop, as tokens in 64 bits pushed
// on the end of lg_tk, and the clauses that make it so. A literal is itself; a
// name the body leaves alone, a counter at entry and a second counter must not
// be negative (a clause each); a counter reaches its limit less one (its limit
// must exist, a clause when it is len(xs)); a second counter reaches its entry
// value plus, for each counter of the condition, the room between the counter
// and its limit less one; a local is its definition's terms.

lx_hi(string[] lg_tk, int lg_e, int lg_id, int lg_lo, int lg_hi, int lg_dp) {
  if((import nkind)[lg_e] == "bin") {
    lx_hbin(lg_tk, lg_e, lg_id, lg_lo, lg_hi, lg_dp);
  } else {
    lx_hleaf(lg_tk, lg_e, lg_id, lg_lo, lg_hi, lg_dp);
  }
} return void;
