
// A declaration cannot sit between a branch's closing `}` and its `} else
// if (`, so every condition of an if / else-if chain is emitted -- and its
// units' declarations printed, as a side effect of emit_expr -- before the
// chain's first line. collect_chain walks the chain of `if` nodes (an else
// arm holding exactly one `if` continues it); seq_conds then computes each
// condition's text, in order, before any of it is rendered.

collect_chain(int id) {
  int[] if_ids = [id];
  int cur_id = id;
  while((import ni2)[cur_id] == 1) {
    int[] elsel = (import nl2)[cur_id];
    cur_id = elsel[0];
    push(if_ids, cur_id);
  }
} return int[] if_ids;
given stmt_fix (4):([4])
given stmt_fix (3):([3])

seq_conds(int[] if_ids) {
  string[] cond_texts = [];
  int i = 0;
  while(i < len(if_ids)) {
    string cond_text = cond_text_of(if_ids[i]);
    push(cond_texts, cond_text);
    i = i + 1;
  }
} return string[] cond_texts;
given stmt_fix ([4]):(["5"])
given stmt_fix ([]):([])

// Render one level of the chain, using its precomputed condition text rather
// than computing it here: computing it here, for an else-if, would run at
// this level's own position in the output -- between the previous branch's
// `}` and this `} else if (`, which is exactly the position a declaration
// may not sit in.
render_chain(int[] if_ids, string[] cond_texts, int lvl, string ind) {
  string cond_text = cond_texts[lvl];
  int cur_id = if_ids[lvl];
  int[] l1_of_v = (import nl1)[cur_id];
} chain (int[] if_ids, string[] cond_texts, int lvl, string ind) {
  string head = ind + "if (";
  if(lvl > 0) {
    head = ind + "} else if (";
  }
  print(head + cond_text + ") {");
} chain (int[] if_ids, string[] cond_texts, int lvl, string ind) {
  emit_block(l1_of_v, ind + "    ");
  int has_else = (import ni2)[cur_id];
  int next_k = lvl + 1;
} chain (int[] if_ids, string[] cond_texts, int lvl, string ind) {
  if(has_else == 0) {
    print(ind + "}");
  } else if(has_else == 1) {
    render_chain(if_ids, cond_texts, next_k, ind);
  } else {
    emit_else(cur_id, ind);
  }
} return void;
given stmt_fix ([4], ["5"], 0, ""):() then prints:("if (5) {\n}\n")
given stmt_fix ([4], ["5"], 0, "  "):() then prints:("  if (5) {\n  }\n")
