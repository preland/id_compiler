// The lengths a guarded copy reads once. A limit `len(xs)` of the loop
// condition becomes `int idh_n_xs`, taken before the loop; lp_hlen then gives
// that local in place of the call wherever the guarded copy asks for the
// length of xs. Only a list the body does not write (lp_cnt) is taken, the
// same test lp_lim makes of a limit, and a string is left alone.

lp_hlens(string lq_ind, int lq_lo, int lq_hi) {
  int lq_k = 0;
  while(lq_k < len((import lpn))) {
    lp_hlen1((import lpn)[lq_k], lq_ind, lq_lo, lq_hi);
    lq_k = lq_k + 1;
  }
} return void;
