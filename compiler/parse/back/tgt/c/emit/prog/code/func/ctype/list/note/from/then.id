given print_fixture ():() then calls note_check:[1]
given calls_node_fixture ():() then calls note_check:[1]

note_check(int ti) {
  int node = (import thennode)[ti];
  if((import nkind)[node] == "then" || (import nkind)[node] == "thenimp") {
    note_check_then(node);
  }
  if((import nkind)[node] == "thencalls") {
    note_calls(node);
  }
} return void;
