// A fresh operand (str_mask) is handed to the consuming concat, which builds
// the result in a fresh left operand and gives a fresh right one back.
concat_text(string cxa, string cxb, int m) {
  string s = "id_concat(" + cxa + ", " + cxb + ")";
  if(m > 0) {
    s = "id_concat_f(" + cxa + ", " + cxb + ", " + m + ")";
  }
} return string s;
