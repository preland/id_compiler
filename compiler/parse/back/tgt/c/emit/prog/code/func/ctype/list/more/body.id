// One list type's prototypes, and the loop over their bodies.

emit_ty_proto(string ty) {
  string key = tc_key(ty);
  print("static int idtc_eq_" + key + "(IdList* a, IdList* b);\nstatic void idtc_show_" + key + "(IdList* a);");
} return void;
("int[]"):() then prints:("static int idtc_eq_int(IdList* a, IdList* b);\nstatic void idtc_show_int(IdList* a);\n")
("string[]"):() then prints:("static int idtc_eq_string(IdList* a, IdList* b);\nstatic void idtc_show_string(IdList* a);\n")

emit_ty_bodies() {
  int i = 0;
  while(i < len((import tctys))) {
    emit_ty_body((import tctys)[i]);
    i = i + 1;
  }
  emit_st_bodies();
} return void;
given tctys_note_one_setup ():() then prints:("static int idtc_eq_int(IdList* a, IdList* b) {\n    if (a->len != b->len) return 0;\n    for (int i = 0; i < a->len; i++)\n        if (!((int)(a->data[i]) == (int)(b->data[i]))) return 0;\n    return 1;\n}\nstatic void idtc_show_int(IdList* a) {\n    idtc_show_listed = 1;\n    fputs(\"[\", stderr);\n    for (int i = 0; i < a->len; i++) {\n        if (i) fputs(\", \", stderr);\n        if (idtc_show_cap && i == idtc_show_cap) { fputs(\"...\", stderr); break; }\n        fprintf(stderr, \"%d\", (int)(a->data[i]));\n    }\n    fputs(\"]\", stderr);\n}\n")
