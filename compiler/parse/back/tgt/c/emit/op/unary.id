// Unary-expression emission: `(OP operand)`, e.g. `(-1)`. Extends the
// emit_expr chain (... -> ee5 -> ee6 -> the var/str/import text default). A
// function named as a value is the C function it is emitted as, id_NAME.

ee6(int id) {
  string s = import_text(id);
  if((import nkind)[id] == "un") {
    s = emit_un(id);
  }
  if(is_fn_value(id) == 1) {
    s = "id_" + (import ns1)[id];
  }
} return string s;
given un_fix (3):("(-6)")
given arith_fix (0):("6")

emit_un(int id) {
  int i1_of_v = (import ni1)[id];
  string ret_s = "(" + (import ns1)[id] + emit_expr(i1_of_v) + ")";
} return string ret_s;
given un_fix (3):("(-6)")
given arith_fix (2):("(/6)")

// A "-6" un node, reusing arith_fix's ai0 as the operand. Deterministic id:
// un0=3.
un_fix() {
  arith_fix();
  int[] none = [];
  int un0 = newnode("un", 0, 0, "-", "", none, none);
} return void;
():() then calls arith_fix:[1]
():() then init_units:(0)
