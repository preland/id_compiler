// Unary-expression emission: `(OP operand)`, e.g. `(-1)`. Extends the
// emit_expr chain (... -> ee5 -> ee6 -> the var/str/import text default). A
// function named as a value is the object of that function, written where the
// translation unit ends (runtime/closure/).

ee6(int id) {
  string s = import_text(id);
  if((import nkind)[id] == "un") {
    s = emit_un(id);
  }
  if(is_fn_value(id) == 1) {
    s = fv_ref((import ns1)[id], 0);
  }
} return string s;
given arith_fix_n("un", 0, "-") (3):("(-6)")
given arith_fix (0):("6")
given clo_bind_fixture ((import cb_name)):("ID_FNV(fx_target__0)")

emit_un(int id) {
  int i1_of_v = (import ni1)[id];
  string ret_s = "(" + (import ns1)[id] + emit_expr(i1_of_v) + ")";
} return string ret_s;
given arith_fix_n("un", 0, "-") (3):("(-6)")
given arith_fix (2):("(/6)")

