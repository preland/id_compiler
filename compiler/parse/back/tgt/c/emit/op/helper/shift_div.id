// The shift helpers, and the gate on the division helpers.

// `>>` is the arithmetic shift; `ushr` is the logical one.
hop_shift(string op) {
  string hop_sar = str_pick(op, ">>", "id_sar", "");
  string h = str_pick(op, "<<", "id_shl", hop_sar);
} return string h;
("<<"):("id_shl")
(">>"):("id_sar")
("+"):("")

// `int` and `word` division both go through the checked helpers; float
// division does not, because IEEE gives it an answer rather than a signal.
hop_div(int id) {
  string h = "";
  if(type_bin(id) == "word" || type_bin(id) == "int") {
    string s1_of_v = (import ns1)[id];
    string type_bin_v = type_bin(id);
    h = hop_dw(s1_of_v, type_bin_v);
  }
} return string h;
given arith_fix {
  (2):("id_idiv")
  (0):("")
}
