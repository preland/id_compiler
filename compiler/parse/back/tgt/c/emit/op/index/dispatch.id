
// Expression emission for the array/index nodes, extending the emit_expr
// dispatch chain (... -> ee3 -> ee4 -> ee5). An index reads a cell and unboxes
// it to the element type; an arr builds a list literal.

ee4(int id) {
  string s = ee5(id);
  if(k_of(id) == "index") {
    s = emit_index(id);
  }
} return string s;
given leaves_fixture ((import lit_a)):("2")
given idx_build ((import idx_fix)):("(int)(id_list_get(id_list_lit(2, (long long)(2), (long long)(5)), 2))")

ee5(int id) {
  string s = ee6(id);
  if(k_of(id) == "arr") {
    s = emit_arr(id);
  }
} return string s;
given leaves_fixture ((import lit_a)):("2")
given shapes_fixture ((import arr_ints)):("id_list_lit(2, (long long)(2), (long long)(5))")

// The leaf text ee6 starts from: a name as written, except an import read in
// the harness, which traps first when nothing has set it
// (prog/head/decl/export/uninit.id), and a string literal, which a `string`
// carries its length in front of (runtime/prelude.id): ID_S builds that object
// around the literal. The kind is tested before is_harn(), so emitting any
// other leaf never reads the flag.
import_text(int id) {
  string s = s1_of(id);
  if(k_of(id) == "str") {
    s = "ID_S(" + c_lit(s) + ")";
  }
  if(k_of(id) == "import" && is_harn() == 1) {
    s = checked_read(s);
  }
} return string s;
given uninit_fixture ((import uninit_imp)):("((void)(idtc_set_gx || (id_null_read(), 0)), gx)")
given leaves_fixture ((import lit_a)):("2")
given lit_str_fixture ((import lit_str_e)):("ID_S(hi)")
