// A one-node expression over arith_fix's ai0 (and ai1): "-6" for ("un", 0, "-"),
// the node deterministically id 3; "6 << 3" for ("bin", 1, "<<"), for the
// shift-helper (rather than division-helper) path, also id 3.
arith_fix_n(string afn_kind, int afn_b, string afn_op) {
  arith_fix();
  int[] none = [];
  int afn_node = newnode(afn_kind, 0, afn_b, afn_op, "", none, none);
} return void;
