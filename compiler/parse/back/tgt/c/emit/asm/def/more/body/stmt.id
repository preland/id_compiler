
// GCC extended asm. Every block is volatile with a memory clobber: that is
// conservative, but the alternative is trusting hand-written clobber lists,
// and a wrong one is a miscompile that shows up under -O2 months later.
asm_stmt(int r) {
  string asm_text_v = asm_text(r);
  string chr_v = chr(34);
  asm_stmt2(r, asm_text_v, chr_v);
} return void;
given llasm_row_fixture (0):() then prints:("    __asm__ __volatile__(\"mov %[x], $0\" \"\\n\\t\" \"ret\" : [result] \"=r\" (result) : [x] \"r\" (x) : \"memory\");\n    return result;\n}\n")
given casm_row2_fixture (1):() then prints:("    __asm__ __volatile__(\"nop\" : [out] \"=r\" (out) :  : \"memory\");\n    return out;\n}\n")
given llasm_row_fixture (0):() then calls asm_stmt2:[1]
given llasm_row2_fixture (0):() then calls asm_stmt2:[1]

asm_stmt2(int r, string asm_body_text, string asm_quote1) {
  string asm_quote2 = chr(34);
  string asm_in_text = asm_in_ops((import afparams)[r]);
  asm_stmt3(r, asm_body_text, asm_quote1, asm_quote2, asm_in_text);
} return void;
given llasm_row_fixture {
  (0, "T", "Q"):() then prints:("    __asm__ __volatile__(T : [result] Q=r\" (result) : [x] \"r\" (x) : \"memory\");\n    return result;\n}\n")
  (0, "U", "Z"):() then prints:("    __asm__ __volatile__(U : [result] Z=r\" (result) : [x] \"r\" (x) : \"memory\");\n    return result;\n}\n")
  (0, "T", "Q"):() then calls asm_stmt3:[1]
  (0, "U", "Z"):() then calls asm_stmt3:[1]
}

asm_stmt3(int r, string asm_body_text, string asm_quote1, string asm_quote2, string asm_in_text) {
  string chr_v3 = chr(34);
  string chr_v4 = chr(34);
  print("    __asm__ __volatile__(" + asm_body_text + " : [" + (import afretn)[r] + "] " + asm_quote1 + "=r" + asm_quote2 + " (" + (import afretn)[r] + ") : " + asm_in_text + " : " + chr_v3 + "memory" + chr_v4 + ");");
} chain (int r, string asm_body_text, string asm_quote1, string asm_quote2, string asm_in_text) {
  print("    return " + (import afretn)[r] + ";");
  print("}");
} return void;
given llasm_row_fixture {
  (0, "T", "Q", "Q", "OPS"):() then prints:("    __asm__ __volatile__(T : [result] Q=rQ (result) : OPS : \"memory\");\n    return result;\n}\n")
  (0, "U", "Z", "Z", ""):() then prints:("    __asm__ __volatile__(U : [result] Z=rZ (result) :  : \"memory\");\n    return result;\n}\n")
}
