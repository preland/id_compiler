// The boxed, comma-separated cell list for an array literal.

arr_cells(int[] elems, string etyp) {
  string out = "";
  int i = 0;
  while(i < len(elems)) {
    string emit_expr_v = emit_expr(elems[i]);
    out = out + sep_arg(i) + box(emit_expr_v, etyp);
    i = i + 1;
  }
} return string out;
