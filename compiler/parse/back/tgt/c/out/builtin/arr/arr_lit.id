// Array-literal emission: `id_list_lit(0)` for an empty list, otherwise
// `id_list_lit(n, cell, ...)` with each element boxed to a cell. The element
// type comes from the first element, matching idc.py.

emit_arr(int id) {
  string s = "id_list_lit(0)";
  int[] l1_of_v = l1_of(id);
  if(len(l1_of_v) > 0) {
    s = emit_arr_n(id);
  }
} return string s;

emit_arr_n(int id) {
  int[] elems = l1_of(id);
  string etyp = type_of(elems[0]);
  string ret_s = arr_lit(elems, etyp);
} return string ret_s;

arr_lit(int[] elems, string etyp) {
  string cells = arr_cells(elems, etyp);
  string ret_s = "id_list_lit(" + len(elems) + ", " + cells + ")";
} return string ret_s;
