
// Call emission dispatch for the list builtins, extending emit_call:
//   print -> id_print(to_string(...))   (in expr/call/emit.id)
//   len   -> id_len (string) or id_list_len (list)
//   push  -> id_list_push with the value boxed
//   pop   -> id_list_pop unboxed to the element type (in pop.id)
//   everything else -> id_NAME(args)  (character_code_at/chr/to_int/input/read_all and
//   ordinary user calls all take this generic form, matching idc.py)

ec2(int id) {
  string s = "";
  if((import ns1)[id] == "len") {
    s = emit_len(id);
  } else {
    s = emit_call_struct(id);
  }
} return string s;
given call_names_fixture ((import call_e_foo)):("id_foo(5, 4)")
given call_names_fixture ((import call_e_len)):("id_list_len(5)")
given sd_ctor_fixture ((import sd_c2)):("id_list_lit(2, (long long)(1), (long long)(1))")

ec3(int id) {
  string s = "";
  if((import ns1)[id] == "push") {
    s = emit_push(id);
  } else {
    s = emit_call_bound(id);
  }
} return string s;
given call_names_fixture ((import call_e_foo)):("id_foo(5, 4)")
given call_names_fixture2 ((import call_e_push)):("id_list_push(5, (long long)(intptr_t)(4))")
given clo_bind_fixture ((import cb_call)):("id_clo_set(id_clo_new(ID_FNV(fx_target__1)), 0, (long long)(7))")

emit_gcall(int id) {
  string s = "";
  if(is_syscall((import ns1)[id])) {
    s = emit_syscall(id);
  } else {
    s = emit_gcall_tail(id);
  }
} return string s;
given call_names_fixture ((import call_e_foo)):("id_foo(5, 4)")
given call_names_fixture ((import call_e_len)):("id_len(5, 4)")
given call_sys_fixture ((import call_e_sys)):("id_peek8((long long)(5), (long long)(4))")
