
// len picks id_len for a string and id_list_len for a list; push boxes its
// value to the list's element type.

emit_len(int id) {
  int arg = (import nl1)[id][0];
  string type_of_v = type_of(arg);
  string s = emit_len_form(arg, type_of_v);
} return string s;
given call_names_fixture ((import call_e_foo)):("id_list_len(5)")
given call_names_fixture2 ((import call_e_pop)):("id_list_len(4)")

emit_len_form(int arg, string len_list_type) {
  string s = "";
  if(len_list_type == "string") {
    s = "id_len(" + emit_expr(arg) + ")";
  } else {
    s = cell_ns(len_list_type) + "len(" + emit_expr(arg) + ")";
    s = lp_hlen(s, emit_expr(arg));
  }
} return string s;
given call_int_fixture {
  ((import call_e1), "string"):("id_len(5)")
  ((import call_e1), "bytes"):("id_bytes_len(5)")
  ((import call_e2), "int[]"):("id_list_len(4)")
}

emit_push(int id) {
  int[] args = (import nl1)[id];
  string type_of_v = type_of(args[0]);
  string ret_s = emit_push_tail(args, type_of_v);
} return string ret_s;
given call_names_fixture2 {
  ((import call_e_push)):("id_list_push(5, (long long)(intptr_t)(4))")
  ((import call_e_pop)):("id_list_push(4, (long long)(intptr_t)(5))")
}
