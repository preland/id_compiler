// `rotl` is the one builtin whose helper depends on a type: it rotates within
// the width of its first argument, so an int takes the 32-bit helper and a word
// the 64-bit one. Both helpers return a `long long`; the 32-bit result is cut
// back to an `int` here so that C arithmetic on it wraps at 32 bits too.
sys_helper_at(int id) {
  string sha_h = sys_helper((import ns1)[id]);
  int[] sha_args = (import nl1)[id];
  if(sha_h == "id_rotl" && type_of(sha_args[0]) == "int") {
    sha_h = "id_rotl32";
  }
} chain (int id) {
  if(is_checked_op((import ns1)[id]) == 1 && type_of(sha_args[0]) == "int" && type_of(sha_args[1]) == "int") {
    sha_h = sha_h + "32";
  }
} return string sha_h;
