given call_rotl_fixture ((import call_e_rotlw)):("id_rotl")
given call_rotl_fixture ((import call_e_sys)):("id_peek8")

sys_narrow(int id, string text) {
  string sha_r = text;
  if(sys_helper_at(id) == "id_rotl32") {
    sha_r = "(int)(" + text + ")";
  }
} return string sha_r;
