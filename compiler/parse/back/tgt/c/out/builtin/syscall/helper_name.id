// C helper name for a systems builtin: `id_` + the builtin's name, except for
// the two store-management calls, whose helpers are named after the store
// rather than after the id spelling.

sys_helper(string name) {
  string h = sys_helper2(name);
  if(name == "alloc") {
    h = "id_mem_alloc";
  }
} return string h;
("peek8"):("id_peek8")
("alloc"):("id_mem_alloc")

sys_helper2(string name) {
  string h = "id_" + name;
  if(name == "store_size") {
    h = "id_mem_size";
  }
} return string h;
("peek8"):("id_peek8")
("store_size"):("id_mem_size")

// The cast in front of one argument. `udiv`, `umod`, `ult` and `ushr` read an
// `int` as its 32 unsigned bits, so an `int` there is zero-extended rather than
// sign-extended into the helper's `long long`.
arg_cast(string name, int arg) {
  string pre_cast = "(long long)(";
  if((name == "udiv" || name == "umod" || name == "ult" || name == "ushr") && type_of(arg) == "int") {
    pre_cast = "(long long)(unsigned int)(";
  }
} return string pre_cast;
given call_args_fixture {
  ("peek8", (import call_e1)):("(long long)(")
  ("ushr", (import call_e1)):("(long long)(unsigned int)(")
}
