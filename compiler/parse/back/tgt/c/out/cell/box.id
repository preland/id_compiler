// Boxing a value into a uniform list cell (a long long), mirroring idc.py's
// box(): an int widens, a float is bit-copied, a pointer (string/list) goes
// through intptr_t. Plus elem_type, which strips a trailing `[]` to get a
// list's element type.

// A `word` boxes exactly like an `int` -- the cast is what widens a narrower
// value into the 8-byte cell that id_list_lit's varargs read back.
box(string code, string type) {
  string s = wrap_by_type(code, type, "float", "(long long)(intptr_t)(", ")", "id_box_f(", ")");
  if(type == "int" || type == "word") {
    s = "(long long)(" + code + ")";
  }
} return string s;
("x", "int"):("(long long)(x)")
("x", "string"):("(long long)(intptr_t)(x)")

// A code string wrapped by its type: `pre code post`, or `pre_alt code post_alt`
// when the type is the given one. Boxing, unboxing and showing a value are each
// this with their own wrappers; none is a function of its own.
wrap_by_type(string code, string type, string key, string pre, string post, string pre_alt, string post_alt) {
  string s = pre + code + post;
  if(type == key) {
    s = pre_alt + code + post_alt;
  }
} return string s;
("x", "float", "float", "A(", ")", "B(", ")"):("B(x)")
("x", "int", "float", "A(", ")", "B(", ")"):("A(x)")
("x", "word", "word", "[", "]", "<", ">"):("<x>")

elem_type(string t) {
  string out = "";
  int i = 0;
  while(i < len(t) - 2) {
    int charat_v = charat(t, i);
    out = out + chr(charat_v);
    i = i + 1;
  }
} return string out;
("int[]"):("int")
("string[]"):("string")
