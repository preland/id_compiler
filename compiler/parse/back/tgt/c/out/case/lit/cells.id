// A list literal's cells, and a scalar: the digits or text as written, with a
// leading minus when the case negated it.

tc_cells(int[] xs, string et) {
  string out = "";
  int i = 0;
  while(i < len(xs)) {
    string cv = tc_value(xs[i], et);
    out = out + sep_arg(i) + box(cv, et);
    i = i + 1;
  }
} return string out;
given lit_cells_fixture ((import lit_cells_xs), "int"):("(long long)(5), (long long)(4)")
given lit_cells_fixture ((import lit_cells_xs), "string"):("(long long)(intptr_t)(5), (long long)(intptr_t)(4)")

tc_scalar(int e) {
  string so = int_code(e);
  if(k_of(e) == "un") {
    so = tc_neg(e);
  }
} return string so;
given lit_int_fixture ((import lit_e)):("5")
given lit_un_fixture ((import lit_un_e)):("-5")

tc_neg(int e) {
  int i1_of_v = i1_of(e);
  string so = "-" + int_code(i1_of_v);
} return string so;
given lit_un_fixture ((import lit_un_e)):("-5")
given lit_un_fixture ((import lit_un_e2)):("-4")
