// Synthetic case-literal nodes for this directory's emitters: two plain
// ints (env_init gives the node tables newleaf/node_int write into) and the
// negated ("un") node built on top of them.

lit_int_fixture() {
  env_init();
  export int lit_e = node_txt2("int", "5", 5, 0);
  export int lit_e2 = node_txt2("int", "4", 4, 0);
} chain () {
  init_rtc();
} return void;
():() then calls node_txt2:("int", "5", 5, 0)
():() then calls node_txt2:("int", "4", 4, 0)
():() then init_units:(0)

lit_un_fixture() {
  lit_int_fixture();
  export int lit_un_e = newleaf("un", (import lit_e), 0, "-", "");
  export int lit_un_e2 = newleaf("un", (import lit_e2), 0, "-", "");
} chain () {
  export int lit_un_dbl = newleaf("un", (import lit_un_e), 0, "-", "");
  export int lit_un_cpl = newleaf("un", (import lit_e), 0, "~", "");
} return void;
given lit_int_fixture ():() then calls newleaf:("un", (import lit_e), 0, "~", "")
given lit_int_fixture ():() then calls newleaf:("un", (import lit_e2), 0, "-", "")
():() then init_units:(0)
():() then calls lit_int_fixture:[1]

// A string leaf, for the emitters that read a "str" node's text rather than
// a number.
lit_str_fixture() {
  env_init();
  export int lit_str_e = newleaf("str", 0, 0, "hi", "");
} return void;
():() then calls newleaf:("str", 0, 0, "hi", "")
():() then (import ns1)[0]:("hi")
():() then init_units:(0)
