// A case value as C: a literal, built by tc_lit (lit/lit.id), or
// `(import NAME)`, which is the export's C global, read where the value is
// built -- after the setup for an argument, after the call for an expected
// value. Its type was checked to be exactly the one wanted
// (mid/.../cases/given/read/), so it needs no conversion.

tc_value(int e, string want) {
  string so = s1_of(e);
  if(k_of(e) != "cimport") {
    so = tc_lit(e, want);
  }
} return string so;

tc_list(int e, string want) {
  int[] xs = l1_of(e);
  string et = list_elem(want);
  string so = tc_list_n(xs, et);
} return string so;

tc_list_n(int[] xs, string et) {
  string so = "id_list_lit(0)";
  if(len(xs) > 0) {
    string cells = tc_cells(xs, et);
    so = "id_list_lit(" + len(xs) + ", " + cells + ")";
  }
} return string so;
