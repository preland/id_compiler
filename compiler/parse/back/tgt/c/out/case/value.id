// A case value as C: a literal, built by tc_lit (lit/lit.id), or
// `(import NAME)`, which is the export's C global, read where the value is
// built -- after the setup for an argument, after the call for an expected
// value -- or a function's name, which is the C function id_NAME. Either type
// was checked to be exactly the one wanted (mid/.../cases/given/read/), so it
// needs no conversion.

tc_value(int e, string want) {
  string so = s1_of(e);
  if(k_of(e) != "cimport") {
    so = tc_lit(e, want);
  }
  if(k_of(e) == "cfn") {
    so = "id_" + s1_of(e);
  }
} return string so;
given lit_import_fixture ((import lit_cimport_e), "int"):("gb")
given lit_int_fixture ((import lit_e), "int"):("5")

tc_list(int e, string want) {
  int[] xs = l1_of(e);
  string et = list_elem(want);
  string so = tc_list_n(xs, et);
} return string so;
given lit_arr_fixture ((import lit_arr_e), "int[]"):("id_list_lit(2, (long long)(5), (long long)(4))")
given lit_arr_fixture ((import lit_arr_e), "string[]"):("id_list_lit(2, (long long)(intptr_t)(5), (long long)(intptr_t)(4))")

tc_list_n(int[] xs, string et) {
  string so = "id_list_lit(0)";
  if(len(xs) > 0) {
    string cells = tc_cells(xs, et);
    so = "id_list_lit(" + len(xs) + ", " + cells + ")";
  }
} return string so;
([], "int"):("id_list_lit(0)")
given lit_cells_fixture ((import lit_cells_xs), "int"):("id_list_lit(2, (long long)(5), (long long)(4))")
