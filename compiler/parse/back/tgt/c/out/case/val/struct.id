// A struct in a test case as C: the list it is at run time, one cell per field,
// each value built at its field's type (so a field that is a list, a string or
// another struct is built by the same rules as a case's own argument of that
// type) and boxed to a cell (field.id).

tc_other(int e, string want) {
  string so = "";
  if(ty_kind_is(want, "struct") == 1) {
    so = tc_struct(e, want);
  } else {
    so = tc_other2(e, want);
  }
} return string so;
given sd_case_fixture ((import sd_ce), "P"):("id_list_lit(2, (long long)(1), (long long)(1))")
given lit_int_fixture ((import lit_e), "int"):("5")
given clo_case_fixture ((import cc_e), "func() return int"):("id_clo_set(id_clo_new(ID_FNV(fx_target__1)), 0, (long long)(7))")

tc_struct(int e, string want) {
  int[] xs = (import nl1)[e];
  string cells = tc_fcells(xs, want);
  string so = "id_list_lit(" + len(xs) + ", " + cells + ")";
} return string so;
given sd_case_fixture ((import sd_ce), "P"):("id_list_lit(2, (long long)(1), (long long)(1))")
given sd_case_fixture ((import sd_cl), "P"):("id_list_lit(1, (long long)(1))")

// bind(NAME, v1, ..., vk) in a test case (docs/TESTS.md): the object the bind of
// a program makes (runtime/closure/c/more/use/bind.id), from the template of
// (NAME, k), then each value stored in its cell.
tc_cbind(int e) {
  int[] items = (import nl1)[e];
  string clo0 = "id_clo_new(" + fv_ref((import ns1)[items[0]], len(items) - 1) + ")";
  string so = tc_cbsets(clo0, fn_node_of((import ns1)[items[0]]), items);
} return string so;
