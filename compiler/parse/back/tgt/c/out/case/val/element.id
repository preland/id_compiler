// `(import NAME)` as C: the export's global, or -- for the element form a
// check's argument may take (front/parse/decl/func/cases/case/given/elem/
// take.id) -- the list's element at the index, unboxed to the type wanted. Both
// are read where the value is built, after the call under test.

tc_import(int e, string want) {
  string so = (import ns1)[e];
  if((import nkind)[e] == "cimport" && (import ni1)[e] > 0) {
    string ixc = tc_value((import ni1)[e] - 1, "int");
    so = unbox("id_list_get(" + so + ", " + ixc + ")", want);
  }
} return string so;
