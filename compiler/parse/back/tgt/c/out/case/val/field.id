// The cells of a struct in a test case: each value built at the type of the
// field it initialises, then boxed.

tc_fcells(int[] xs, string want) {
  string out = "";
  int sd_k = 0;
  while(sd_k < len(xs)) {
    out = out + sep_arg(sd_k) + tc_fcell(xs[sd_k], want, sd_k);
    sd_k = sd_k + 1;
  }
} return string out;
given sd_case_fixture ([(import sd_ca), (import sd_ca)], "P"):("(long long)(1), (long long)(1)")
given sd_case_fixture ([(import sd_cs)], "Q"):("(long long)(intptr_t)(ID_S(s))")

tc_fcell(int e, string want, int sd_k) {
  string sd_ft = sd_ftype_at(want, sd_k);
  string cv = tc_value(e, sd_ft);
  string so = box(cv, sd_ft);
} return string so;
given sd_case_fixture ((import sd_ca), "P", 1):("(long long)(1)")
given sd_case_fixture ((import sd_cs), "Q", 0):("(long long)(intptr_t)(ID_S(s))")
