// The cells of a struct in a test case: each value built at the type of the
// field it initialises, then boxed.

tc_fcells(int[] xs, string want) {
  string out = "";
  int sd_k = 0;
  while(sd_k < len(xs)) {
    out = out + sep_at(", ", sd_k) + tc_fcell(xs[sd_k], want, sd_k);
    sd_k = sd_k + 1;
  }
} return string out;
given sd_case_fixture {
  ([(import sd_ca), (import sd_ca)], "P"):("(long long)(1), (long long)(1)")
  ([(import sd_cs)], "Q"):("(long long)(intptr_t)(ID_S(s))")
}

tc_fcell(int e, string want, int sd_k) {
  string sd_ft = sd_cell((import sdftype), want, sd_k);
  string cv = tc_value(e, sd_ft);
  string so = box(cv, sd_ft);
} return string so;
given sd_case_fixture {
  ((import sd_ca), "P", 1):("(long long)(1)")
  ((import sd_cs), "Q", 0):("(long long)(intptr_t)(ID_S(s))")
}

// What is neither a struct nor a list at a position of a test case: a closure,
// written bind(NAME, 1, [2]) where a function type is wanted, or a scalar.
tc_other2(int e, string want) {
  string so = tc_scalar(e);
  if(ty_is_func(want) == 1 && (import nkind)[e] == "cctor") {
    so = tc_cbind(e);
  }
} return string so;
given clo_case_fixture ((import cc_e), "func() return int"):("id_clo_set(id_clo_new(ID_FNV(fx_target__1)), 0, (long long)(7))")
given lit_int_fixture ((import lit_e), "int"):("5")
