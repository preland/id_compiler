// Comparing and printing a value of an id type, in C. A list goes through the
// harness's per-type helpers (ctype/list/), which do the same element by
// element. A function value compares by id_fn_eq: the same object, which is
// how two uses of one plain function compare, or the same function holding the
// same cells (docs/SPEC.md 1.1.1). It has no spelling a case could have written
// but its name, which the running harness does not know -- so a failing case
// says only that it was a function.

tc_compare(string ga, string gb, string type) {
  string so = "(" + ga + " == " + gb + ")";
  if(type == "string") {
    so = "(strcmp(" + ga + ", " + gb + ") == 0)";
  } else if(ty_is_list(type) == 1) {
    string key = tc_key(type);
    so = "idtc_eq_" + key + "(" + ga + ", " + gb + ")";
  }
} chain (string ga, string gb, string type) {
  if(ty_kind_is(type, "struct") == 1) {
    so = "idtc_eqs_" + type + "(" + ga + ", " + gb + ")";
  } else if(ty_is_func(type) == 1) {
    so = "id_fn_eq(" + ga + ", " + gb + ")";
  } else if(type == "bytes") {
    so = "(id_bytes_cmp(" + ga + ", " + gb + ") == 0)";
  }
} return string so;
given sd_note_fixture {
  ("a", "b", "int"):("(a == b)")
  ("a", "b", "string"):("(strcmp(a, b) == 0)")
  ("a", "b", "int[]"):("idtc_eq_int(a, b)")
  ("a", "b", "P"):("idtc_eqs_P(a, b)")
  ("a", "b", "func(int) return int"):("id_fn_eq(a, b)")
  ("a", "b", "bytes"):("(id_bytes_cmp(a, b) == 0)")
}

tc_show(string code, string type) {
  string so = show_scalar(code, type);
  if(ty_is_list(type) == 1) {
    string key = tc_key(type);
    so = "idtc_show_" + key + "(" + code + ");";
  }
  if(ty_is_func(type) == 1) {
    so = "fputs(\"a function value\", stderr);";
  }
} chain (string code, string type) {
  if(ty_kind_is(type, "struct") == 1) {
    so = "idtc_shows_" + type + "(" + code + ");";
  } else if(type == "bytes") {
    so = "id_bytes_show(" + code + ");";
  }
  if(type == "bool") {
    so = "fprintf(stderr, \"%s\", (" + code + ") ? \"true\" : \"false\");";
  }
} return string so;
given sd_note_fixture {
  ("x", "int"):("fprintf(stderr, \"%d\", x);")
  ("x", "int[]"):("idtc_show_int(x);")
  ("f", "func(int) return int"):("fputs(\"a function value\", stderr);")
  ("x", "P"):("idtc_shows_P(x);")
  ("x", "bytes"):("id_bytes_show(x);")
}

show_scalar(string code, string type) {
  string so = "fprintf(stderr, \"%d\", " + code + ");";
  if(type == "string") {
    so = "fprintf(stderr, \"\\\"%s\\\"\", " + code + ");";
  } else if(type == "float" || type == "word") {
    so = wrap_by_type(code, type, "float", "fprintf(stderr, \"%lld\", ", ");", "fprintf(stderr, \"%g\", ", ");");
  }
} return string so;
("x", "int"):("fprintf(stderr, \"%d\", x);")
("x", "string"):("fprintf(stderr, \"\\\"%s\\\"\", x);")
("x", "float"):("fprintf(stderr, \"%g\", x);")
