// The `n` a case argument contributes to a scaling claim, as a C expression:
// the length of a list or a string, or the value of an integer. A float has no
// size. A string's length is taken by the C compiler from the literal, so its
// escapes count as the bytes they are.

tc_size(int e) {
  string so = size_leaf(e);
  if((import nkind)[e] == "arr") {
    int[] xs = (import nl1)[e];
    so = "" + len(xs);
  } else if((import nkind)[e] == "un") {
    so = size_neg(e);
  }
} return string so;
given lit_int_fixture ((import lit_e)):("(long long)(5)")
given lit_arr_fixture ((import lit_arr_e)):("2")

size_leaf(int e) {
  string so = "0";
  if((import nkind)[e] == "int") {
    string int_code_v = int_code(e);
    so = "(long long)(" + int_code_v + ")";
  } else if((import nkind)[e] == "str") {
    so = "(long long)(sizeof(" + c_lit((import ns1)[e]) + ") - 1)";
  }
} return string so;
given lit_int_fixture ((import lit_e)):("(long long)(5)")
given lit_str_fixture ((import lit_str_e)):("(long long)(sizeof(hi) - 1)")

size_neg(int e) {
  int i1_of_v = (import ni1)[e];
  string so = "-" + size_leaf(i1_of_v);
} return string so;
given lit_un_fixture ((import lit_un_e)):("-(long long)(5)")
given lit_un_fixture ((import lit_un_e2)):("-(long long)(4)")
