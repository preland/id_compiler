// A case's `n`: the largest
// size among its arguments. (A number is printed the way a case writes it by
// wrap_by_type, box.id.)

size_list(int[] args) {
  string out = "";
  int j = 0;
  while(j < len(args)) {
    out = out + sep_at(", ", j) + tc_size(args[j]);
    j = j + 1;
  }
} return string out;
([]):("")
