// The one place emitted code leaves the compiler.
//
// Every line of the target language goes through here, so "where does output
// happen" is a question with one answer instead of forty. Diagnostics do
// *not*: they are mid/'s, they go out whether or not anything is emitted, and
// a buffered emitter would reorder them behind the code they are complaining
// about.
//
// It is a plain pass-through today. It exists because the next target cannot
// be a pass-through: a WASM module needs its type and function sections
// written before the bodies that determine them, and LLVM wants its
// declarations gathered the same way. Both need emission to be a buffer that
// can be filled out of order, and both need exactly one place to change.

// id 5: "x[3]", an "index" node; the one-element arg list [3] for a call.
lz_d() {
  lz_c();
  export int lz_idx = node_index((import lz_var), (import lz_i1));
  export int[] lz_callargs = [(import lz_i1)];
} return void;
():() then check_failed:(0)
():() then init_units:(0)

emit_line(string s) {
  print(s);
} return void;
