// Reachability from the tested functions. The import sweep is switched off
// again first: its diagnostics were given during checking, and a reachable set
// seeded from anywhere but `main` is not what they are about.

test_reach() {
  lset((import dphase), 0, 0);
  seed_tested();
  test_reach_tail();
} return void;

// The harness's natives are read between the fixpoint and the narrowing, while
// `prog` is still whole (back/drive/sink/natives/scan.id).
test_reach_tail() {
  reach_mark();
  nat_scan("harness", 0);
  dce_pack(0, 0);
} return void;

seed_tested() {
  clear_strs((import rfn));
  push((import rfn), "conf.id");
  seed_cases();
} return void;
