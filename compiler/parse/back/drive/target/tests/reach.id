// flat_outer_call is itself two calls deep (outer(push(...))), so wrapping it
// as an argument gives chk_flat_at's negative case: nested two levels rather
// than one. Paired beside cm_push_call (one level) so the same call node
// carries an argument of each depth, for hc_pair/hc_list's own cases too.
flat_deep_call_fixture() {
  flat_call_fixture();
  export int[] flat_deep_args = [(import cm_push_call), (import flat_outer_call)];
  export int flat_deep_call = node_call("mid", flat_deep_args);
} return void;
