// only trace it leaves. Filed here (an unrelated harness-narrowing step)
// because tests/more/seed/ (given.id, fns.id, seed.id) is at its 3-file cap.
seed_given_fixture() {
  fn_fixture();
  init_reach();
  push((import casegiven), "fx_target");
} return void;
