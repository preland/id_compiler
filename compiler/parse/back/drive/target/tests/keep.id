// Two gaps void_call_fixture's narrower cases never hit: nat_scan's own
// natc/natkey/natrow, without natcall_fixture's env_init (which would wipe
// void_call_fixture's casefn/casenode/casegiven) -- the --natives flag off,
// since nothing here needs an actual native row, only nat_func's
// unconditional read of natc[0] to not trap; and a second casestart entry,
// since void_call_fixture's own "bare" case (index 1) is pushed onto
// casefn/casenode/casegiven but never onto casestart, which case_loc reads
// by index once the harness's setup rows walk both cases, not just index 0.
kept_natoff_fixture() {
  nat_init(1, ["prog"]);
  push((import casestart), 0);
} return void;
