// Copying a list onto the end of another. An exported list
// may only be assigned by its declaring function, so this works in place;
// emptying one is pred_wipe (back/ir/opt/cfg/more/scan.id).

keep_ints(int[] ints, int[] onto) {
  int i = 0;
  while(i < len(ints)) {
    push(onto, ints[i]);
    i = i + 1;
  }
} return void;
([1, 2], []):([1, 2], [1, 2])
([], [5]):([], [5])

keep_strs(string[] strs, string[] names) {
  int i = 0;
  while(i < len(strs)) {
    push(names, strs[i]);
    i = i + 1;
  }
} return void;
(["a", "b"], []):(["a", "b"], ["a", "b"])
([], ["z"]):([], ["z"])

// A single node in thennode (given.id's own seed_thens), after
// then_node_fixture: given the node it names -- then_node_fixture's
// fixture_then_node (s1 = "fx_target") passes reach_add's fnames guard so
// rfn_len can see the loop ran, and its fixture_then_bad names no function in
// the build, so the guard must block it. Filed here (an unrelated list-copy
// step) because tests/more/seed/ is at its 3-file cap.
seed_then_fixture(int stf_node) {
  init_reach();
  push((import thennode), stf_node);
} return void;
given then_node_fixture (0):() then check_failed:(0)
given then_node_fixture (1):() then rfn_len:(2)
