// A function a case passes as an argument is called through by the function
// under test, so the harness has to carry it whether or not anything else in
// the build calls it.

seed_fn_args(int ci) {
  int[] args = (import nl1)[((import casenode)[ci])];
  int j = 0;
  while(j < len(args)) {
    seed_fn_arg(args[j]);
    j = j + 1;
  }
} return void;
given seed_cfn_fixture (0):() then len((import rfn)):(2)
given seed_cfn_fixture (1):() then len((import rfn)):(3)

seed_fn_arg(int e) {
  if((import nkind)[e] == "cfn") {
    string s1_of_v = (import ns1)[e];
    reach_add(s1_of_v);
  }
  if((import nkind)[e] == "cctor" && (import ns1)[e] == "bind") {
    seed_fn_arg((import nl1)[e][0]);
  }
} return void;
