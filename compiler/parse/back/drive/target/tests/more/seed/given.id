// The setups and checks cases name. The harness calls them directly, so they
// are entry points whether or not any function with a case calls them -- and
// so is every function a case passes as a value (fns.id).

// A library case's own `given`s are skipped the same way its root is
// (seed_tested, ../../reach.id): they run for bin/idc's pre-check of the
// library, not for a program's harness.
seed_givens() {
  int ci = 0;
  while(ci < len((import casegiven))) {
    string[] setups = str_split((import casegiven)[ci], " ");
    if(case_is_std(ci) == 0) {
      seed_given_list(setups);
    }
    ci = ci + 1;
  }
} return void;
given seed_given_fixture_bad ():() then rfn_len:(2)
given seed_given_fixture ():() then rfn_len:(3)

// One case's setups: a `given` may name several, so each entry is a
// space-separated list.
seed_given_list(string[] setups) {
  int gi = 0;
  while(gi < len(setups)) {
    reach_add(setups[gi]);
    gi = gi + 1;
  }
} return void;
given seed_given_fixture (["fx_target"]):() then rfn_len:(3)
given seed_given_fixture_bad (["nope"]):() then rfn_len:(2)

// case_is_std takes a case index, and a thennode carries the index of the
// case it was written on in i1 (case/then/push.id's then_store), not its own
// index in thennode -- so the check reads that first, in the same statement
// budget the plain reach_add took.
seed_thens() {
  int ti = 0;
  while(ti < len((import thennode))) {
    int case_of_then = i1_of((import thennode)[ti]);
    if(case_is_std(case_of_then) == 0) {
      string s1_of_v = s1_of((import thennode)[ti]);
      reach_add(s1_of_v);
    }
    ti = ti + 1;
  }
} return void;
given seed_then_fixture_bad ():() then rfn_len:(2)
given seed_then_fixture ():() then rfn_len:(3)
