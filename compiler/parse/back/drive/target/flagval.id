// The value of a `--name VALUE` flag, found anywhere in the arguments.
//
// Scanned rather than read at a fixed index. The driver once put another flag
// ahead of `--triple` whenever a native backend was attached, and the
// positional read this replaces then took that flag for `--triple` and kept
// the default triple -- so `idc prog.id --backend B --triple aarch64-...`
// built an x86_64 binary and reported success. A wrong platform must not be a
// silent one.
arg_flag_val(int argc, string[] argv, int i, string name, string dflt) {
  string s = dflt;
  if(i + 1 < argc && argv[i] == name) {
    s = argv[i + 1];
  } else if(i < argc) {
    s = arg_flag_val(argc, argv, i + 1, name, dflt);
  }
} return string s;
(1, ["prog"], 1, "--triple", "default"):("default")
(3, ["prog", "--triple", "wasm32"], 1, "--triple", "default"):("wasm32")
