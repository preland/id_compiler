// The test harness comes first, while `prog` still holds every function: a
// function with cases need not be reachable from main, and every case in the
// build runs. Then the prune, then the program -- which is therefore emitted
// exactly as it is without the harness.
//
// A freestanding object keeps every function, exactly as a project with no
// main does, and for the same reason: it is not the whole program. Something
// outside it -- a boot stub, an interrupt vector, another object -- may be the
// only caller, and reachability from `main` cannot see that. It saw it wrongly
// once: the kernel's fault handler is called from the interrupt stubs and
// nothing else, so it was pruned and the link failed on a symbol the program
// obviously needed. Deciding what is live across a link is the linker's job.
//
// The natives the kept program calls are listed just before the prune and
// written just after the program (back/drive/sink/natives/).
emit_all(int argc, string[] argv) {
  emit_tests_maybe(argc, argv);
  natives_then_prune();
  blank;
} chain (int argc, string[] argv) {
  if(argc > 1 && argv[1] == "ast") {
    print_program();
  } else {
    emit_target(argc, argv);
  }
  if((import natc)[0] == 1) {
    nat_print();
  }
} chain (int argc, string[] argv) {
  emit_notes();
  tk_emit_keys();
} return void;
