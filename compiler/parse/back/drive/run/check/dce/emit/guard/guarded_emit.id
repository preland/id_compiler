// --calls' asm rows: one per asm declaration, printed after print_call_cases
// (driver.id's print_calls calls both). Filed here rather than beside
// print_call_cases (back/drive/run/check/dce/emit/calls/cases.id, at its
// 3-function cap) or asm_case_row (mid/names/limits/report/more/loc/
// func_line.id, this row's own builder).
print_asm_cases() {
  int i = 0;
  while(i < len((import aloc))) {
    string line = asm_case_row(i);
    print(line);
    i = i + 1;
  }
} return void;
