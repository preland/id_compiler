// count_cases (mid/names/limits/shape/cases/more/flag/count.id) already
// counts a function's cases for the two-case minimum; this reads it rather
// than re-scanning `casefn` a second time.
call_case_row(int i) {
  string name = s1_of((import prog)[i]);
  int n = count_cases((import prog)[i]);
  string ret_s = name + "|" + (import pfile)[i] + ":" + (import pline)[i] + "|" + n;
} return string ret_s;
