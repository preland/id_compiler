// Walk every function's node range and print its call/value edges --
// mirrors reach_funcs/reach_func (mid/names/exports/reach/dead/sweep.id) but
// visits every function unconditionally, because --calls reports the whole
// call graph a build would prune from, not what dce_prune would keep.
call_edges_funcs(int f, int lo) {
  while(f < len((import prog))) {
    lo = call_edges_func(f, lo);
    f = f + 1;
  }
} return void;
given edge_fixture (0, 0):() then check_failed:(0)
