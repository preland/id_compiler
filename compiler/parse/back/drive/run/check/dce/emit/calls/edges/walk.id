call_edges_func(int f, int lo) {
  string caller = s1_of((import prog)[f]);
  call_edges_range(lo, (import prog)[f], caller);
  int ret_i = (import prog)[f] + 1;
} return int ret_i;
given edge_fixture (0, 0):(4)
given edge_fixture (1, 0):(8)

call_edges_range(int lo, int hi, string caller) {
  while(lo <= hi) {
    scan_call_edge(lo, caller);
    lo = lo + 1;
  }
} return void;
