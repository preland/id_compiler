// One printed row, built from the callee's own node so caller and callee
// never disagree with what k_of/s1_of already resolved.
call_edge_emit(string caller, int id, string kind) {
  string callee_name = s1_of(id);
  string line = call_edge_line(caller, callee_name, kind);
  print(line);
} return void;
