// State for sweep.id's own cases: one registered function ("fx_target", via
// ../../../../../mid/names/limits/shape/cases/given/then/more/fixture/fn.id's
// fn_fixture) with "main" also in fnames, so dce_prune's own guard is true,
// and the reachable set (rfn) seeded either with or without that function's
// name (reach_seed, ../../../../../mid/names/limits/shape/cases/given/read/
// reach.id) -- the two things dce_pack/dce_keep read.

dce_fx_setup(string dce_seed) {
  fn_fixture();
  push((import fnames), "main");
  reach_seed(dce_seed);
} return void;
("fx_target"):() then calls reach_seed:("fx_target")
("nope"):() then calls reach_seed:("nope")
