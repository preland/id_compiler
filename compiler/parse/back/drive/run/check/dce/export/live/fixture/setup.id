// State for mark.id and scan/'s own cases: four constants in conf.id order --
// ca, cb (whose initialiser reads ca bare, a "var" node, as conf.id writes it), cc and cd -- and a "main" that reads cb
// and cd. So cb and cd are read by reachable code, ca only by cb's
// initialiser, and cc by nothing until cvl_case adds a case that reads it.
// Node ids: the constants' are 0-7, main's reads 8 and 9, main is 10.

cvl_setup() {
  lc_dce_init();
  init_idx();
  init_reach();
} chain () {
  int cvf_da = lc_reg_int("ca", "1", 1);
  int cvf_ib = node_var("ca");
  int cvf_db = lc_reg("int", "cb", cvf_ib);
} chain () {
  int cvf_dc = lc_reg_int("cc", "3", 3);
  int cvf_dd = lc_reg_int("cd", "4", 4);
  int cvf_rb = node_import("cb");
} chain () {
  int cvf_rd = node_import("cd");
  int[] cvf_none = [];
  int[] cvf_body = [cvf_rb];
} chain () {
  export int cvf_main = node_func("main", "int", cvf_none, cvf_body, cvf_rd);
  add_func("main", "int", (import cvf_main));
  push((import prog), (import cvf_main));
} return void;
():() then (import chkfail)[0]:(0)
():() then init_units:(0)

clive_str() {
  string cvf_s_t = "live " + (str_join((import clive), ","));
} return string cvf_s_t;
given cvl_setup ():("live ")
given cvl_setup given const_mark(0) ():("live cb,cd,ca")

cvl_scan() {
  int cvf_base = const_base();
  const_funcs(0, cvf_base);
} return void;
given cvl_setup ():() then (import chkfail)[0]:(0)
given cvl_setup ():() then clive_str:("live cb,cd")
