// The case and marking halves of cvl_setup's state (setup.id).
// cvl_case's argument is a "cimport" node, the kind a case line makes.

cvl_case() {
  int cvc_ic = newleaf("cimport", 0, 0, "cc", "");
  int[] cvc_args = [cvc_ic];
  int[] cvc_none = [];
} chain () {
  int cvc_node = newnode("case", 0, 0, "", "", cvc_args, cvc_none);
  push((import casefn), (import cvf_main));
  push((import casenode), cvc_node);
} return void;
given cvl_setup {
  ():() then calls newleaf:("cimport", 0, 0, "cc", "")
  ():() then calls newnode:("case", 0, 0, "", "", [11], []) then len((import casenode)):(1) then (import casefn)[0]:(10)
  ():() then (import chkfail)[0]:(0)
  ():() then init_units:(0)
}

cvl_std() {
  integer_list_set((import stdunit), 0, 0);
} return void;
given cvl_setup {
  ():() then (import stdunit)[0]:(0)
  given integer_list_set((import stdunit), 0, 5) ():() then (import stdunit)[0]:(0)
  ():() then (import chkfail)[0]:(0)
  ():() then init_units:(0)
}
