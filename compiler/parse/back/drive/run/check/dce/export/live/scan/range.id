// The leaf of the constant walk: every import node in a range of the node
// store, and what it makes live.

const_range(int cv_lo, int cv_hi) {
  while(cv_lo <= cv_hi) {
    const_take(cv_lo);
    cv_lo = cv_lo + 1;
  }
} return void;
given cvl_setup (8, 9):() then clive_str:("cb,cd")
given cvl_setup (9, 9):() then clive_str:("cd")

const_take(int cv_id) {
  if(k_of(cv_id) == "import" || k_of(cv_id) == "var") {
    string cv_name = s1_of(cv_id);
    const_add(cv_name);
  }
} return void;
given cvl_setup (8):() then clive_str:("cb")
given cvl_setup (4):() then clive_str:("")
given cvl_setup (2):() then clive_str:("ca")

const_add(string cv_name) {
  int cv_ek = find_str((import enames), cv_name);
  if(cv_ek >= 0 && (import eowners)[cv_ek] == "conf.id" && find_str((import clive), cv_name) < 0) {
    push((import clive), cv_name);
  }
} return void;
given cvl_setup ("ca"):() then clive_str:("ca")
given cvl_setup given cvl_scan ("cb"):() then clive_str:("cb,cd")
given cvl_setup ("zz"):() then clive_str:("")
