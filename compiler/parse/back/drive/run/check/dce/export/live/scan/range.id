// The leaf of the constant walk: every import node (and a case's cimport, the
// index of a `then (import tbl)[(import NAME)]` check) in a range of the node
// store, and what it makes live.

const_range(int cv_lo, int cv_hi) {
  while(cv_lo <= cv_hi) {
    const_take(cv_lo);
    cv_lo = cv_lo + 1;
  }
} return void;
given cvl_setup {
  (8, 9):() then clive_str:("live cb,cd")
  (9, 9):() then clive_str:("live cd")
}

const_take(int cv_id) {
  if((import nkind)[cv_id] == "import" || (import nkind)[cv_id] == "var" || (import nkind)[cv_id] == "cimport") {
    string cv_name = (import ns1)[cv_id];
    const_add(cv_name);
  }
} return void;
given cvl_setup {
  (8):() then clive_str:("live cb")
  (4):() then clive_str:("live ")
  (2):() then clive_str:("live ca")
}

const_add(string cv_name) {
  int cv_ek = find_str((import enames), cv_name);
  if(cv_ek >= 0 && (import eowners)[cv_ek] == "conf.id" && find_str((import clive), cv_name) < 0) {
    push((import clive), cv_name);
  }
} return void;
given cvl_setup {
  ("ca"):() then clive_str:("live ca")
  given cvl_scan ("cb"):() then clive_str:("live cb,cd")
  ("zz"):() then clive_str:("live ")
}
