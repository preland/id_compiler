// The list constants that survive emission.
//
// A scalar constant is a static initialiser. A list cannot be: building one
// allocates, which is work, and work runs in a function. So a build with a
// kept list constant has one initialiser that builds them all, in conf.id
// order, and every entry point calls it before anything else runs --
// id_main's first statement on every target, and a test case's first
// statement in the harness, where each case is a process of its own.

is_list_const(int i) {
  int ok = 0;
  if((import eowners)[i] == "conf.id" && ty_is_list((import etypes)[i]) == 1) {
    ok = keep_export(i);
  }
} return int ok;
given lc_dce_setup (0):(1)
given lc_dce_setup (1):(0)

// seed_cfn_fixture's cfn leaf (fns.id, tests/more/clear.id), wrapped as a
// single-argument "case" node the way tuple.id's own parser builds one, so
// seed_fn_args has a casenode entry whose l1_of is non-empty. Filed here (an
// unrelated list-constants check) because tests/more/seed/ is at its 3-file
// cap.
seed_cfn_fixture_node() {
  export int cfnid = newleaf("cfn", 0, 0, "fx_target", "");
  int[] args = [cfnid];
  seed_cfn_fixture_add(args);
} return void;
given fn_fixture ():() then (import chkfail)[0]:(0)
given fn_fixture ():() then init_units:(0)

list_consts_kept() {
  int n = 0;
  int i = 0;
  while(i < len((import enames))) {
    n = n + is_list_const(i);
    i = i + 1;
  }
} return int n;
