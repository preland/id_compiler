arg_flag(int argc, string[] argv, int i, string name) {
  int r = 0;
  if(i < argc && argv[i] == name) {
    r = 1;
  } else if(i < argc) {
    r = arg_flag(argc, argv, i + 1, name);
  }
} return int r;
(2, ["a", "--x"], 0, "--x"):(1)
(2, ["a", "b"], 0, "--x"):(0)
