// The new block's own index. Its predecessors, instructions and label are
// already in the store by the time this runs; what is left is telling the
// owning function it exists and handing back the id the caller will use.
ir_blk4(int f) {
  int len_v = len((import bfunc));
  push((import fnblk)[f], len_v - 1);
  int ret_i = len((import bfunc)) - 1;
} return int ret_i;
given ir_rows (1):(1)
given ir_rows_chk1 (0):(1)

// The most recently pushed block's label and owning function, for a case on
// ir_block/ir_blk2 (../block.id).
chk_last_blk_lbl() {
  int n = len((import bfunc));
  string ret_s = blk_lbl(n - 1);
} return string ret_s;
given ir_rows ():("body")
given ir_rows_chk1 ():("body")

chk_last_blk_fn() {
  int n = len((import bfunc));
  int ret_i = blk_fn(n - 1);
} return int ret_i;
given ir_rows ():(1)
given ir_rows_chk1 ():(1)
