// The rest of insn/row_fields.id's readers: operand B, the auxiliary
// string, and the auxiliary block list.

chk_b() {
  string ret_i_t = "b " + ((import ib)[((import chk_id)[0])]);
} return string ret_i_t;
given ir_rows ():("b 4")
given ir_rows_chk1 ():("b -1")

chk_s() {
  string ret_s = (import istr)[((import chk_id)[0])];
} return string ret_s;
given ir_rows ():("")
given ir_rows_chk1 ():("hi")

chk_bl() {
  string ret_li_t = "bl " + (list_text((import iblk)[((import chk_id)[0])], ","));
} return string ret_li_t;
given ir_rows ():("bl ")
given ir_rows_chk1 ():("bl ")
