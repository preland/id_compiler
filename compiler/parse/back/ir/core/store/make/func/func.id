// An IR function. Its block list is empty at this point; the lowering fills it.

ir_func(int node, string name, string ret) {
  ir_func2(name, ret);
  ir_func3(node);
  int ret_i = ir_func4();
} return int ret_i;
given ir_rows (99, "third", "word"):(2) then chk_last_fn_name:("third") then chk_last_fn_ret:("word")
given ir_rows_chk1 (5, "fourth", "int"):(2) then chk_last_fn_name:("fourth") then chk_last_fn_ret:("int")

// The parameter list starts empty and lw_param fills it: a function's
// parameters are instructions, and they do not exist until the lowering makes
// them.
ir_func2(string name, string ret) {
  push((import fnname), name);
  push((import fnret), ret);
  push((import fnpar), []);
} return void;
given ir_rows ("third", "word"):() then chk_last_fn_name:("third") then chk_last_fn_ret:("word")
given ir_rows_chk1 ("fourth", "int"):() then chk_last_fn_name:("fourth") then chk_last_fn_ret:("int")

ir_func3(int node) {
  push((import fnblk), []);
  push((import fnnode), node);
} return void;
given ir_rows (42):() then chk_last_fn_name:("two") then chk_last_fn_ret:("string")
given ir_rows_chk1 (-7):() then chk_last_fn_name:("two") then chk_last_fn_ret:("string")
