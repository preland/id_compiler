// Niladic readers of chk_id's instruction (../../../../fixture/rows/constfn.id), for
// `then` checks on a core/store/edit case: an edit function is void, so its
// effect is only visible through a function that returns something.

chk_op() {
  string ret_s_t = "op " + ((import iop)[((import chk_id)[0])]);
} return string ret_s_t;
given ir_rows ():("op add")
given ir_rows_chk1 ():("op const")

chk_ty() {
  string ret_s_t = "ty " + ((import ity)[((import chk_id)[0])]);
} return string ret_s_t;
given ir_rows ():("ty int")
given ir_rows_chk1 ():("ty string")

chk_a() {
  string ret_i_t = "a " + ((import ia)[((import chk_id)[0])]);
} return string ret_i_t;
given ir_rows ():("a 3")
given ir_rows_chk1 ():("a -1")
