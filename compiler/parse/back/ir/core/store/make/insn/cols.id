// The last two instruction columns. An instruction starts with no home block:
// it is put in one by ir_add, and a constant never is, because a constant
// prints as its literal wherever it is used rather than as an instruction.

ir_col3(int[] bl) {
  push((import iblk), bl);
  push((import ihome), 0 - 1);
} return void;

// The new instruction's own id, once every column has a row for it: the id
// IS the row index, so this only has meaning after ir_col3 has pushed the
// last of them.
ir_insn_fin(int[] bl) {
  ir_col3(bl);
  int ret_i = len((import iop)) - 1;
} return int ret_i;

