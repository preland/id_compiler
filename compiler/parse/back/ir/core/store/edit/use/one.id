
ir_rauw_l(int i, int old, int fresh) {
  int[] l = ir_l(i);
  int j = 0;
  while(j < len(l)) {
    j = ir_rauw_one(l, j, old, fresh);
  }
} return void;
given ir_rows_lst (0, 5, 9):() then chk_l:([9, 7, 9])
given ir_rows_lst (0, 99, 2):() then chk_l:([5, 7, 5])

ir_rauw_one(int[] l, int j, int old, int fresh) {
  if(l[j] == old) {
    lset(l, j, fresh);
  }
  int ret_i = j + 1;
} return int ret_i;
([5, 7, 5], 0, 5, 9):(1)
([5, 7, 5], 1, 5, 9):(2)

// Instruction 0's aux list set to a real, repeated-value list, so
// ir_rauw_l's while loop has more than one candidate to walk over.
ir_rows_lst() {
  ir_rows();
  ir_set_l(0, [5, 7, 5]);
} return void;
