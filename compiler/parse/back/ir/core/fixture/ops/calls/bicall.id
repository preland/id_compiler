// dispatch cases and everything under it. The other two call-node fixtures
// (an ordinary call, and a call through a variable of function type) are at
// ../../../../build/expr/call/more/arg/cell/fixture.id and ./fcallv.id -- split
// across three files (a file holds at most 3 functions) and two directories
// (arg/cell had room for only one of them).

bicall_fixture() {
  lw_env_fixture();
  init_bnames();
  bicall_fixture_reg();
} return void;
():() then (import bicall_node):(2)
():() then calls node_txt2:("int", "1", 1, 0)
():() then init_units:(0)
():() then calls lw_env_fixture:[1]

bicall_fixture_reg() {
  export int[] bicall_args = [node_txt2("int", "1", 1, 0)];
  export int bicall_arg_n = bicall_args[0];
  export int bicall_node = node_call("print", bicall_args);
} return void;
given bicall_fixture {
  ():() then calls node_txt2:("int", "1", 1, 0)
  ():() then calls node_call:("print", (import bicall_args))
