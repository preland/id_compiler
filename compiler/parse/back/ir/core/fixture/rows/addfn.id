// Two IR functions, each with a block and one instruction, distinct in
// every field a core/read or core/store/edit case might read or rewrite:
// fn 0 ("one"/"int", node -1) holds block 0 ("entry") with an "add"
// instruction (operands 3, 4), added to its block; ../fn1.id's fn 1
// ("two"/"string", node 7) holds block 1 ("body") with a "const"
// instruction ("hi"), never added to a block, the way a literal never is.
// chk_id (make/insn/row_fields.id and friends) starts at 0, so a chk_*
// check reads fn 0's instruction until a case points it elsewhere.

ir_rows() {
  env_init();
  int ret_i = init_ir();
  ir_rows_fn0();
} return void;
():() then entry_count(0):(1)
():() then (import fnname)[0]:("one") then (import fnname)[1]:("two")
():() then init_units:(0)
():() then calls env_init:[1]

ir_rows_fn0() {
  int f0 = ir_func(0 - 1, "one", "int");
  int b0 = ir_block(f0, "entry");
  ir_rows_fn0_insn();
} return void;
given ir_rows {
  ():() then calls ir_func:(-1, "one", "int") then calls ir_block:(2, "entry")
  ():() then (import fnname)[2]:("one") then (import fnname)[3]:("two")
  ():() then (import chkfail)[0]:(0)
  ():() then init_units:(0)
}

ir_rows_fn0_insn() {
  int v0 = ir_leaf("add", "int", 3, 4, "");
  ir_add(0, v0);
  ir_rows_fn1();
} return void;
given ir_rows {
  ():() then calls ir_leaf:("add", "int", 3, 4, "") then calls ir_add:(0, 2)
  ():() then (import ia)[2]:(3) then (import ihome)[2]:(0)
  ():() then (import chkfail)[0]:(0)
  ():() then init_units:(0)
}
