m2r_shift(int[] l, int i) {
  while(i > 0) {
    m2r_swap(l, i);
    i = i - 1;
  }
} return void;
([10, 20, 30, 40], 2):([30, 10, 20, 40])
([7], 0):([7])

m2r_swap(int[] l, int i) {
  int v = l[i];
  lset(l, i, l[i - 1]);
  lset(l, i - 1, v);
} return void;
([1, 2], 1):([2, 1])
([5, 9, 3], 1):([9, 5, 3])
