// A phi for every slot in every block but the entry, before anything is
// renamed. Placing them maximally means the walk can visit blocks in any
// order: a block's incoming value is its own phi, never a predecessor's
// outgoing one, so nothing depends on what has been processed yet.

m2r_phis(int f) {
  int i = 1;
  while(i < blk_count(f)) {
    m2r_phi_blk(f, i);
    i = i + 1;
  }
} return void;
given m2r_2blk_fixture (0):() then calls m2r_phi_blk:(0, 1)
given m2r_outv_fixture (0):() then calls m2r_phi_blk:[0]

m2r_phi_blk(int f, int i) {
  int j = 0;
  while(j < len((import pra))) {
    j = m2r_phi_one(f, i, j);
  }
} return void;
given m2r_outv_fixture (0, 0):() then calls m2r_phi_one:(0, 0, 0)
given m2r_row_fixture (0, 0):() then calls m2r_phi_one:[0]

m2r_phi_one(int f, int i, int j) {
  int ph = m2r_phi_make(i, j);
  m2r_phi_place(f, i, ph);
  int ret_i = j + 1;
} return int ret_i;
given m2r_outv_fixture (0, 0, 0):(1) then phiof_sum:("phiof 3")
given m2r_outv_fixture (0, 0, 0):(1) then calls m2r_phi_place:(0, 0, 3)
