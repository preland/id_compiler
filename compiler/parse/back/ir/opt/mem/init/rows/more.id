// The entry block, and what `m2r_collect` needs of it: only the entry ever
// holds an alloca, so a slot count for the whole function is really a count
// of the entry block alone.

entry_of(int f) {
  int[] irf_blk_v = irf_blk(f);
  int b = irf_blk_v[0];
} return int b;
given ir_rows (0):(0)
given ir_rows (1):(1)

entry_count(int f) {
  int b = entry_of(f);
  int n = insn_count(b);
} return int n;
given ir_rows (0):(1)
given ir_rows (1):(0)

m2r_collect_at(int f, int i) {
  int b = entry_of(f);
  int[] blk_ins_v = blk_ins(b);
  if(ir_op(blk_ins_v[i]) == "alloca") {
    push((import pra), blk_ins_v[i]);
  }
} return void;
given m2r_alloca_fixture (0, 1):() then pra_len_check:(1)
given m2r_alloca_fixture (0, 0):() then pra_len_check:(0)
