// The slots, in the order they were allocated -- which is the entry block, in
// order, because that is the only place the lowering puts an alloca. Every one
// is promotable: `id` cannot take the address of a variable, so an alloca is
// only ever the address operand of a load or a store.
m2r_collect(int f) {
  int i = 0;
  while(i < entry_count(f)) {
    m2r_collect_at(f, i);
    i = i + 1;
  }
} return void;
