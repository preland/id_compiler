// One block, in order: a load of a slot becomes the value the slot holds here,
// and a store to one changes what it holds from this point on. Both
// instructions go away; what is left is the value flowing through registers.
// The scan itself is m2r_blk's chain (../walk.id).

m2r_step(int f, int id, int i) {
  if(ir_op(id) == "load") {
    m2r_load(f, id, i);
  } else if(ir_op(id) == "store") {
    m2r_store(id, i);
  }
} return void;

m2r_slot(int a) {
  int ret_i = lst_index_of((import pra), a);
} return int ret_i;
