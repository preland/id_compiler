// One block, in order: a load of a slot becomes the value the slot holds here,
// and a store to one changes what it holds from this point on. Both
// instructions go away; what is left is the value flowing through registers.
// The scan itself is m2r_blk's chain (../walk.id).

m2r_step(int f, int id, int i) {
  if((import iop)[id] == "load") {
    m2r_load(f, id, i);
  } else if((import iop)[id] == "store") {
    m2r_store(id, i);
  }
} return void;
given m2r_ldfx {
  (0, (import ldfx_id), 0):() then calls m2r_load:(0, (import ldfx_id), 0)
  (0, (import ldfx_id2), 0):() then calls m2r_store:((import ldfx_id2), 0)
}

// A "load" and a "store" whose address is the promotable slot m2r_outv_fixture
// collects, for m2r_load/m2r_store/m2r_step's own cases: neither reads
// ir_op, so an id built for this needs to be right only in ir_a and ir_b.
m2r_ldfx() {
  m2r_outv_fixture();
  int[] none = [];
  export int ldfx_id = ir_insn("load", "int", (import pra)[0], 42, "", none, none);
} chain () {
  export int ldfx_id2 = ir_insn("store", "int", (import pra)[0], 42, "", none, none);
  integer_list_set((import chk_id), 0, ldfx_id);
} return void;
():() then (import ldfx_id2):(4)
():() then chk_op:("op load")
():() then calls m2r_outv_fixture:[1]
