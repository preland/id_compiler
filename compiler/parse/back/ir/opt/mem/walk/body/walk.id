
m2r_pass2(int f) {
  m2r_walk(f, 0);
  m2r_fill(f, 1);
  m2r_after(f);
} return void;

m2r_walk(int f, int i) {
  while(i < blk_count(f)) {
    m2r_blk(f, i);
    i = i + 1;
  }
} return void;
given m2r_2blk_fixture (0, 0):() then calls m2r_blk:(0, 0) then calls m2r_blk:(0, 1)
given ir_rows (1, 1):() then calls m2r_blk:[0]

m2r_blk(int f, int i) {
  m2r_seed(i, 0);
  int[] irf_blk_v = irf_blk(f);
  int n = 0;
} chain (int f, int i) {
  while(n < insn_count(irf_blk_v[i])) {
    int[] blk_ins_v = blk_ins(irf_blk_v[i]);
    m2r_step(f, blk_ins_v[n], i);
    n = n + 1;
  }
} return void;
given m2r_outv_fixture (0, 0):() then calls m2r_seed:(0, 0) then calls m2r_step:(0, 0, 0) then calls m2r_step:(0, 2, 0)
given m2r_outv_fixture (1, 0):() then calls m2r_seed:(0, 0) then calls m2r_step:[0]
