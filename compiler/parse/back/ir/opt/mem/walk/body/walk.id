
m2r_pass2(int f) {
  m2r_walk(f, 0);
  m2r_fill(f, 1);
  m2r_after(f);
} return void;

m2r_walk(int f, int i) {
  while(i < blk_count(f)) {
    m2r_blk(f, i);
    i = i + 1;
  }
} return void;

m2r_blk(int f, int i) {
  m2r_seed(i, 0);
  int[] irf_blk_v = irf_blk(f);
  m2r_scan(f, irf_blk_v[i], i);
} return void;
