// The single value a phi is, or -1 if it has none yet and -2 if it has more
// than one. An incoming edge that is the phi itself is not a second value: a
// loop variable that is never reassigned reaches its own phi, and that is
// still one value.
m2r_same(int id) {
  int v = 0 - 1;
  int i = 0;
  while(i < len(((import ilist)[id]))) {
    v = m2r_pick(id, i, v);
    i = i + 1;
  }
} return int v;
given ir_rows (0):(-1)
given irlfx_setup ((import irlfx_id)):(-2)

m2r_pick(int id, int i, int v) {
  int r = 0 - 2;
  if((import ilist)[id][i] == id || (import ilist)[id][i] == v) {
    r = v;
  } else if(v == 0 - 1) {
    r = (import ilist)[id][i];
  }
} return int r;
given irlfx_setup {
  ((import irlfx_id), 0, -1):(10)
  ((import irlfx_id), 1, 10):(-2)
}

// Replace every use of a value with another and remove what defined it. The
// same operation serves a promoted load and a collapsed phi, which is why it
// takes a counter it may not use: the sweep needs to know something changed.
m2r_drop(int f, int id, int v, int n) {
  op_rauw(f, id, v);
  ir_kill(id);
  int ret_i = n + 1;
} return int ret_i;
