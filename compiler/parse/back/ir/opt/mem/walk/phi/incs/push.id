// A phi's incoming edge, in two halves: the value the predecessor left this
// slot holding, and the predecessor block itself. `ir_l` and `ir_bl` are
// each read once and pushed once, so the two never fight over the same list.

m2r_inc_at(int f, int ph, int j, int pb) {
  int pi = m2r_pos(f, pb);
  m2r_inc_val(ph, j, pi);
  int[] bl = ir_bl(ph);
} chain (int f, int ph, int j, int pb) {
  push(bl, pb);
} return void;

m2r_inc_val(int ph, int j, int pi) {
  int[] l = ir_l(ph);
  push(l, (import outv)[pi][j]);
} return void;

// One row of phiof, for phiof_sum (at.id): a loop inside a loop is already
// at the nesting limit, so the inner one cannot sit in the reader itself.
phiof_row_sum(int i) {
  int n = 0;
  int j = 0;
  while(j < len((import phiof)[i])) {
    n = n + (import phiof)[i][j];
    j = j + 1;
  }
} return int n;
