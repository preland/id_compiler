
pred_wipe(int[] l) {
  while(len(l) > 0) {
    pop(l);
  }
} return void;

// A block's successors are the blocks its terminator names, and its terminator
// is its last instruction -- every block has one, because the lowering never
// leaves a block open.
pred_of(int b) {
  int[] blk_ins_v = blk_ins(b);
  int len_v = len(blk_ins_v);
  pred_succ(b, blk_ins_v[len_v - 1], 0);
} return void;

pred_succ(int b, int v, int i) {
  while(i < succ_count(v)) {
    pred_succ_at(b, v, i);
    i = i + 1;
  }
} return void;
