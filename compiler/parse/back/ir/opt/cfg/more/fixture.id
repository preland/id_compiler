// A synthetic lowering context for an expr/stmt-lowering case: one IR
// function with its entry and body block open and lwcur pointing at the
// body -- what lw_open (../../lower/more/lower.id) sets up before lowering a
// real function's statements, built by hand so a case can call a lowerer
// directly without parsing a program. lw_fixture_n is the func node itself,
// exported so a case needing "the node under lowering" can read it back.
// init_idx() is here too: type_of (mid/types/type_of/dispatch/type_of.id)
// reads the symbol index for any node whose kind is not "int" -- one call
// here covers every case built on this fixture, instead of each one that
// happens to touch a non-int node remembering it. init_rtc() likewise: a
// string comparison's lowering asks is_freestanding() (lw_strcmp,
// ../../expr/op/more/str/ncmp.id), which reads a cell only init_rtc()
// exports.

lw_fixture() {
  env_init();
  init_idx();
  lw_fixture_node();
} return void;
():() then check_failed:(0)
():() then init_units:(0)

lw_fixture_node() {
  int[] none = [];
  export int lw_fixture_n = node_func("t", "int", none, none, 0 - 1);
  lw_fixture_open();
} return void;
given env_init ():() then check_failed:(0)
given env_init ():() then init_units:(0)

lw_fixture_open() {
  int f = ir_func((import lw_fixture_n), "t", "int");
  lw_open(f);
  init_rtc();
} return void;
given env_init ():() then check_failed:(0)
given env_init ():() then init_units:(0)
