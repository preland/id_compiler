// The predecessors of every block, computed rather than maintained.
//
// A branch rewrite that forgets to fix a predecessor list is silent and the
// bug shows up in a phi three passes later, so no pass edits bpred: this runs
// again whenever the CFG has changed.

op_preds(int f) {
  pred_clear(f, 0);
  pred_scan(f, 0);
} return void;
given br_fixture_p (0):() then chk_pred1:([0])
given br_fixture (0):() then chk_pred1:([0])

pred_clear(int f, int i) {
  while(i < blk_count(f)) {
    pred_clear_at(f, i);
    i = i + 1;
  }
} return void;
given br_fixture_p (0, 0):() then chk_pred1:([])
given br_fixture_p (0, 2):() then chk_pred1:([0])

pred_scan(int f, int i) {
  while(i < blk_count(f)) {
    int[] irf_blk_v = irf_blk(f);
    pred_of(irf_blk_v[i]);
    i = i + 1;
  }
} return void;
given br_fixture (0, 0):() then chk_pred1:([0])
given br_fixture (0, 2):() then chk_pred1:([])
