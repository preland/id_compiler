
dce_one(int f, int id, int n) {
  string ir_op_v = (import iop)[id];
  if(str_in((import irnoeff), ir_op_v) == 0 && dce_used(f, id) == 0) {
    ir_kill(id);
    n = n + 1;
  }
} return int n;
