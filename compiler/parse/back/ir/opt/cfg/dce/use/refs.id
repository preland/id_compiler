
dce_used_b(int b, int id, int n) {
  int i = 0;
  while(i < len(((import binsn)[b]))) {
    int[] blk_ins_v = (import binsn)[b];
    n = dce_refs(blk_ins_v[i], id, n);
    i = i + 1;
  }
} return int n;
given cfg_fixture {
  (0, 0, 0):(0)
  (1, 0, 0):(0)
}

// A killed instruction keeps its operands, so it is skipped rather than read:
// otherwise a dead chain would keep itself alive and nothing after the first
// sweep would ever be removed. A value naming itself -- a phi whose only
// incoming edge is its own -- does not count as a use either.
dce_refs(int at, int id, int n) {
  int r = n;
  if(at != id && (import iop)[at] != "nop" && dce_names(at, id) == 1) {
    r = n + 1;
  }
} return int r;
given dce_fixture {
  (0, 5, 0):(1)
  (0, 0, 3):(3)
}

dce_names(int at, int id) {
  int r = 0;
  if((import ia)[at] == id || (import ib)[at] == id || dce_lists(at, id) == 1) {
    r = 1;
  }
} return int r;
given dce_fixture {
  (0, 5):(1)
  (0, 99):(0)
}
