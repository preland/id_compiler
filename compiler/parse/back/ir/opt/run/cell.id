// What a pass needs to know beyond the function it is given.
//
//   pra    the promotable stack slots of the function being optimised
//   phiof  one row per block, one column per slot: the phi inserted there
//   outv   one row per block, one column per slot: its value at the block's end
//
// Cleared per function, like the lowering's own state, because a pass runs on
// one function at a time and nothing crosses between them: an SSA value is
// local to its function by construction.

// outv: The other table m2r_row pushes a row onto, read as pra_len_check reads
// pra. Filed here rather than beside its export in ../../cell.id, which this
// leaves at its three-function cap.
// outv: A row of its own: two nested loops are already at the nesting limit, so
// the inner one cannot also sit in outv_sum.
// phiof: One row per block, pushed by m2r_row (../../mem/init/blank/row.id) whose
// whole effect is that push and outv's: nothing but a reader of one of the
// two tables can see either happen.
// phiof: One row of phiof, for phiof_sum (at.id): a loop inside a loop is already
// at the nesting limit, so the inner one cannot sit in the reader itself.
init_opt() {
  export int[] pra = [];
  export int[][] phiof = [];
  export int[][] outv = [];
} return int 0;
given env_init ():(0) then (import chkfail)[0]:(0)
given env_init ():(0) then len((import pra)):(0)

// The optimisation level, from `--opt N`. Level 0 emits the lowering as it
// stands, which is the property that makes the lowering trustworthy: a program
// built with every pass off must still be correct, so a wrong answer at -O1 is
// a pass's fault and can be bisected to one.
arg_opt(int argc, string[] argv, int i, int lvl) {
  int r = lvl;
  if(i + 1 < argc && argv[i] == "--opt") {
    r = to_int(argv[i + 1]);
  } else if(i < argc) {
    r = arg_opt(argc, argv, i + 1, lvl);
  }
} return int r;
(3, ["prog", "--opt", "2"], 0, 1):(2)
(2, ["prog", "x"], 0, 1):(1)
