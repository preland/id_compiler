// The two operands `fold_iszext` and `fold_cmp` test on the right of an
// `&&`: neither may run unless the arm to its left already held, so each is
// its own composition rather than a name computed ahead of the `if`.

fold_isbool(int v) {
  int a = ir_a(v);
  string t = ir_ty(a);
  int r = t == "bool";
} return int r;
given irlfx_setup ((import irlfx_id)):(0)
given fold_true_setup ((import ft_id)):(1)

fold_zero_of(int id) {
  int b = ir_b(id);
  int r = 0;
  if(b >= 0 && ir_op(b) == "const" && ir_s(b) == "0") {
    r = 1;
  }
} return int r;
given ir_rows (1):(0)
given fold_true_setup ((import ft_id)):(1)

// A "const" bool row (c0, "0") that both fold_isbool's and fold_zero_of's
// true branches can point at: ft_id ("add") has both fields set to c0, and
// fz_id ("zext") gives fold_iszext (../cmp.id) a row whose op matches too.
fold_true_setup() {
  env_init();
  int[] none = [];
  int c0 = ir_insn("const", "bool", 0, 0, "0", none, none);
} chain () {
  export int ft_id = ir_insn("add", "int", c0, c0, "", none, none);
  export int fz_id = ir_insn("zext", "int", c0, 0, "", none, none);
} return void;
():() then check_failed:(0)
():() then init_units:(0)
