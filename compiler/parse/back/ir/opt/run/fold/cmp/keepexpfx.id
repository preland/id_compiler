// keep_export_fixture (../../../cfg/dce/use/cases/keepexpfx.id) plus is_harn()
// forced true, for keep_export's own short-circuit case.

keep_export_fixture_harn_on() {
  keep_export_fixture();
  harn_set(1);
} return void;
():() then check_failed:(0)
():() then init_units:(0)

// The rest of keep_export_fixture_reg's chain: main reachable and two
// exported names, one unreached, one reached.
keep_export_fixture_tail() {
  init_reach();
  push((import eowners), "nat_target");
  push((import eowners), "main");
} return void;
given keep_export_fixture_reg ():() then check_failed:(0)
given keep_export_fixture_reg ():() then init_units:(0)

// The registration and the export owners together: the one setup that gives
// both a function table and a non-empty eowners, which setups_miss
// (mid/names/limits/shape/cases/given/read/impcheck.id) needs to read an owner.
keep_export_fixture_all() {
  keep_export_fixture_reg();
  keep_export_fixture_tail();
} return void;
():() then check_failed:(0)
():() then init_units:(0)
