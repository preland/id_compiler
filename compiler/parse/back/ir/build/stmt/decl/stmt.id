// Statement lowering. The dispatch tests the kind first and only then recurses,
// rather than computing the fallback eagerly the way the C emitter's chain
// does: here a fallback that is computed and discarded would leave real
// instructions in a real block.

lw_stmts(int[] stmts) {
  int i = 0;
  while(i < len(stmts)) {
    lw_stmt(stmts[i]);
    i = i + 1;
  }
} return void;
given bound_fixture ([1]):() then (import chkfail)[0]:(0)
given bound_fixture ([]):() then (import chkfail)[0]:(0)

lw_stmt(int node) {
  if((import nkind)[node] == "decl") {
    lw_decl(node);
  } else {
    ls2(node);
  }
} return void;
