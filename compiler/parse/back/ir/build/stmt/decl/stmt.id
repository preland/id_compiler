given decl_fixture2 ((import expr_node)):() then (import chkfail)[0]:(0)

// An exported declaration writes the global; a plain one writes its slot.
// Both are a store, and lw_addr already knows which address to give.
//
// The address is taken into a local first: for an export it is a fresh
// instruction, and two arguments that both build one are built in whichever
// order the C compiler chose to evaluate them.
lw_decl(int node) {
  string s2_of_v = (import ns2)[node];
  int a = lw_addr(s2_of_v);
  lw_decl_tail(node, a);
} return void;
given bound_fixture ((import decl_node)):() then (import chkfail)[0]:(0)
