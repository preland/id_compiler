// lw_alloca's slots in fs_acc, the function of esc_sfix whose string `s` the
// escape analysis owns (lws_s), and in fs_ret, whose string `r` it owns but
// the function returns (lws_r), so the free hooks have a string to decide
// about. lws_fixture_in is the same with the cell set that says the store being
// lowered consumed `s`, and lws_fixture_ret leaves fs_ret as the function whose
// body is being lowered.
lws_fixture() {
  esc_sfix();
  int r = init_ir();
  int f = ir_func(0 - 1, "fs_acc", "int");
} chain () {
  int o = lw_open(f);
  export int lws_s = lw_alloca("string", "s");
  export int lws_ent = (import lwent)[0];
} return void;
():() then calls ir_func:(-1, "fs_acc", "int")
():() then calls lw_alloca:("string", "s")
():() then init_units:(0)

