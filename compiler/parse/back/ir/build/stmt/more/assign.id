// The declared type of an assignment's target: an export's if it is one, and
// otherwise the slot's, which the alloca recorded.
lw_aty(string name) {
  string t = lw_vty(name);
  if(t == "") {
    int lw_slot_v = lw_slot(name);
    t = ir_ty(lw_slot_v);
  }
} return string t;
