// The chain marker lowers to nothing: the segments it separates are one
// function's body, and control simply falls from one into the next. Without
// this arm it would reach ls5, which lowers a non-`if` as a `while`.
ls4(int node) {
  if((import nkind)[node] == "iassign") {
    lw_iassign(node);
  } else if((import nkind)[node] != "chain" && (import nkind)[node] != "blank") {
    ls5(node);
  }
} return void;
