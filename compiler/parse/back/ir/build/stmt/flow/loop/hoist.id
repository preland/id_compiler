// The counterpart of the C target's tgt/c/emit/prog/code/body/fast/hoist_len.id.
// A limit `len(xs)` of a versioned loop is lowered once, in the block that
// enters the guarded copy, and every `len(xs)` that copy asks for afterwards is
// that value. The copy exists only when the body cannot push or pop (lp_clean)
// and does not reassign xs (lp_held, lp_lim), so the length is the same on every
// iteration; read inside the loop, id_list_len's trap exits made the loop
// uncountable and clang would not vectorise it. The read is still the checked
// one, so a list that is not there still traps, at the entry the first test
// would have trapped at. The fallback copy keeps its read per iteration.

lh_hoist(int lh_w, int lh_on) {
  int lh_lo = (import ni1)[lh_w] + 1;
  int lh_hi = lh_w - 1;
  int lh_k = 0;
} chain (int lh_w, int lh_on) {
  while(lh_on == 1 && lh_k < len((import lpn))) {
    lh_take((import lpn)[lh_k], lh_lo, lh_hi);
    lh_k = lh_k + 1;
  }
} return void;
