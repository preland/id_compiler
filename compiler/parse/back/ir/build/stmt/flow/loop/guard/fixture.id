// The guard a loop over `v` up to a limit `j` would carry, and two the lowering
// must refuse: one that names a float, and one with a token it does not know.

gd_good() {
  lp_reset();
  string[] gdr_tk = ["v:j", "k:0", ">=", "|", "v:v", "null", "!=", "|"];
  lst_str_extend((import lpg), gdr_tk);
} return void;
():() then len((import lpg)):(8)
():() then (import lpg)[4]:("v:v")

gd_bad() {
  lp_reset();
  string[] gdr_tk = ["v:j", "k:0", ">=", "|", "v:f", "k:0", ">=", "|"];
  lst_str_extend((import lpg), gdr_tk);
} return void;
():() then len((import lpg)):(8)
():() then (import lpg)[4]:("v:f")

gd_odd() {
  lp_reset();
  string[] gdr_tk = ["v:j", "k:0", ">=", "|", "v:j", "->foo", ">=", "|"];
  lst_str_extend((import lpg), gdr_tk);
} return void;
():() then len((import lpg)):(8)
():() then (import lpg)[5]:("->foo")
