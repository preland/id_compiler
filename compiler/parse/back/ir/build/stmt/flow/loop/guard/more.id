// The rest of the dispatch on an item.

gd_op_b(string gdi_item) {
  if(str_starts(gdi_item, "i:") == 1 || str_starts(gdi_item, "k:") == 1) {
    gd_push_lit(gdi_item);
  } else {
    gd_op_c(gdi_item);
  }
} return void;
given gd_fix given gd_stk_new ("i:5"):() then gd_last:("int const 5")
given gd_fix given gd_stk_new ("k:0"):() then gd_last:("int const 0")
given gd_vals given gd_one_on ("cap"):() then (import gdstk)[0]:(6)

gd_op_c(string gdi_item) {
  if(gdi_item == "null") {
    push((import gdstk), 0 - 1);
  } else {
    gd_op_d(gdi_item);
  }
} return void;
given gd_stk_new ("null"):() then (import gdstk)[0]:(-1)
given gd_vals given gd_two ("wide"):() then (import gdstk)[1]:(5)

gd_op_d(string gdi_item) {
  if(gdi_item == "wide" || gdi_item == "len" || gdi_item == "cap") {
    gd_un(gdi_item);
  } else {
    gd_bin(gdi_item);
  }
} return void;
given gd_vals given gd_two ("+:2"):() then (import gdstk)[0]:(7)
given gd_vals given gd_one_on ("len"):() then (import gdstk)[0]:(6)
