// The guard of a versioned loop as one bool: each clause of gdrpn evaluated in
// turn and anded with those before it. A clause has no side effect and traps on
// nothing, so they are all evaluated rather than skipped past the first false
// one.

gd_and(int gde_acc, int gde_clause) {
  int gde_out = gde_clause;
  if(gde_acc >= 0) {
    gde_out = lw_op("and", "bool", gde_acc, gde_clause, "");
  }
} return int gde_out;
given gd_words (-1, 6):(6)
given gd_words (5, 6):(7) then gd_last:("bool and ")

gd_close(int gde_acc) {
  int gde_clause = pop((import gdstk));
  int gde_out = gd_and(gde_acc, gde_clause);
} return int gde_out;
given gd_words given gd_two (-1):(3)
given gd_words given gd_two (5):(7)

gd_item(string gde_item, int gde_acc) {
  int gde_out = gde_acc;
  if(gde_item == "|") {
    gde_out = gd_close(gde_acc);
  } else {
    gd_op(gde_item);
  }
} return int gde_out;
given gd_vals given gd_two ("|", -1):(3)
given gd_vals given gd_two ("v:j", 9):(9) then len((import gdstk)):(3)
