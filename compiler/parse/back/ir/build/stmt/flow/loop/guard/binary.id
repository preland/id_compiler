// An operator taken off the stack with its operands and its result put back.
// A comparison with null is the list-exists test; any other is made on both
// operands widened. A sum, difference or product joins as many operands as its
// token says (fold.id), a comparison two (cmp.id).

gd_bin_of(string gdb_op, int gdb_a, int gdb_b) {
  int gdb_out = 0 - 1;
  if(gdb_op == "!=") {
    gdb_out = gd_nn(gdb_a);
  } else {
    gdb_out = gd_wise(gdb_op, gdb_a, gdb_b);
  }
} return int gdb_out;
given gd_vals ("!=", 4, -1):(8) then gd_last:("bool icmp >=")
given gd_vals ("+", 3, 3):(7) then gd_last:("word add ")

gd_wise(string gdb_op, int gdb_a, int gdb_b) {
  int gdb_x = gd_wide(gdb_a);
  int gdb_y = gd_wide(gdb_b);
  int gdb_out = gd_arith(gdb_op, gdb_x, gdb_y);
} return int gdb_out;
given gd_vals ("<", 3, 3):(7) then calls lw_op:("icmp", "bool", 5, 6, "<")
given gd_vals ("-", 3, 4):(6) then calls lw_op:("sub", "word", 5, 4, "")

gd_bin(string gdb_tok) {
  if(gt_isar(gdb_tok) == 1) {
    gd_fold(gdb_tok);
  } else {
    gd_cmp(gdb_tok);
  }
} return void;
given gd_vals given gd_two ("+:2"):() then (import gdstk)[0]:(7)
given gd_vals given gd_two ("<"):() then len((import gdstk)):(1)
