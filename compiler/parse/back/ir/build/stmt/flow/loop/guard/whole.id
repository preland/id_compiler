// The guard of a versioned loop: lpg read to its end, the bool it comes to.

gd_guard() {
  gd_stk_new();
  int gdg_acc = 0 - 1;
  int gdg_at = 0;
} chain () {
  while(gdg_at < len((import lpg))) {
    gdg_acc = gd_item((import lpg)[gdg_at], gdg_acc);
    gdg_at = gdg_at + 1;
  }
} return int gdg_acc;
