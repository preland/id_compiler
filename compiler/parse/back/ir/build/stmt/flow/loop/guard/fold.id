// A sum, difference or product of the top N values of the stack, taken from the
// left: `a - b - c` is `(a - b) - c`, each step made in 64 bits. The N values
// go and their result is put back.

gd_run(string gdf_op, int gdf_at, int gdf_n) {
  int gdf_acc = (import gdstk)[gdf_at];
  int gdf_k = 1;
  while(gdf_k < gdf_n) {
    gdf_acc = gd_wise(gdf_op, gdf_acc, (import gdstk)[gdf_at + gdf_k]);
    gdf_k = gdf_k + 1;
  }
} return int gdf_acc;
given gd_words given gd_trio ("-", 0, 3):(8) then gd_last:("word sub ")
given gd_words given gd_trio ("+", 2, 1):(5)

gd_drop(int gdf_n) {
  int gdf_d = 0;
  while(gdf_d < gdf_n) {
    int gdf_x = pop((import gdstk));
    gdf_d = gdf_d + 1;
  }
} return void;
