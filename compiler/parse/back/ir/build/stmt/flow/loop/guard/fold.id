gd_fold(string gdf_tok) {
  int gdf_n = gt_arity(gdf_tok);
  string gdf_op = gt_op(gdf_tok);
  int gdf_at = len((import gdstk)) - gdf_n;
} chain (string gdf_tok) {
  int gdf_acc = gd_run(gdf_op, gdf_at, gdf_n);
  gd_drop(gdf_n);
  push((import gdstk), gdf_acc);
} return void;
