given gd_begin given gd_fix ("(j) >= 0"):() then len((import gdrpn)):(4)

gd_check() {
  gd_begin();
  int gdk_at = 0;
  int gdk_ok = 0;
} chain () {
  while(gdk_at < len((import lpcond)) && (import gdbad)[0] == 0) {
    gd_one((import lpcond)[gdk_at]);
    gdk_at = gdk_at + 1;
  }
  gdk_ok = (import gdbad)[0] == 0;
} return int gdk_ok;
