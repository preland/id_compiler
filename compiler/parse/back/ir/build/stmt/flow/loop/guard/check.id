// Whether the lowering can build every token of the loop's guard (lpg): a name
// is one the function has a slot or an export for, of a type the guard can
// compare, and a sum has operands; a token that is none of the guard's is not
// built. True when all can be, and false when the loop must keep its checks --
// which is how a target that does not know a token the analysis now writes
// stays correct, and why the conformance suite counts the loops it versions.

gd_known(string gdk_tok) {
  int gdk_ok = find_str((import gd_plain), gdk_tok) >= 0 || gt_iscmp(gdk_tok) == 1 || gt_isval(gdk_tok) == 1;
  if(gt_isar(gdk_tok) == 1) {
    gdk_ok = gt_arity(gdk_tok) >= 1;
  }
  if(str_starts(gdk_tok, "v:") == 1) {
    gdk_ok = gd_okname(gt_tail(gdk_tok));
  }
} return int gdk_ok;
given gd_fix ("v:j"):(1)
given gd_fix ("v:f"):(0)
given gd_fix ("wide"):(1)
given gd_fix ("->len"):(0)
given gd_fix ("-:3"):(1)
given gd_fix ("-:x"):(0)

gd_check() {
  int gdk_at = 0;
  int gdk_ok = 1;
  while(gdk_at < len((import lpg)) && gdk_ok == 1) {
    gdk_ok = gd_known((import lpg)[gdk_at]);
    gdk_at = gdk_at + 1;
  }
} return int gdk_ok;
given gd_fix given gd_cond(["v:j", "k:0", ">=", "|", "v:v", "null", "!=", "|"]) ():(1)
given gd_fix given gd_cond(["v:j", "k:0", ">=", "|", "v:f", "k:0", ">=", "|"]) ():(0)
given gd_fix given gd_cond(["v:j", "k:0", ">=", "|", "v:j", "->foo", ">=", "|"]) ():(0)
