// Reading every clause of a loop's guard. True when all of them were read, and
// then gdrpn holds the guard; false when the loop must keep its checks.

gd_one(string gdk_clause) {
  string[] gdk_toks = gd_toks(gdk_clause);
  gd_open(gdk_toks);
  gd_clause();
} return void;
