// The operators of one operand: the cast to 64 bits, and the reads of a list's
// length and capacity.

gd_un_of(string gdu_op, int gdu_val) {
  int gdu_out = 0 - 1;
  if(gdu_op == "wide") {
    gdu_out = gd_wide(gdu_val);
  } else {
    gdu_out = gd_raw(gdu_op, gdu_val);
  }
} return int gdu_out;
given gd_vals ("wide", 3):(5) then gd_last:("word sext ")
given gd_vals ("cap", 4):(6) then calls lw_callf:("id_list_cap_raw", "int", [4])

gd_un(string gdu_op) {
  int gdu_val = pop((import gdstk));
  int gdu_out = gd_un_of(gdu_op, gdu_val);
  push((import gdstk), gdu_out);
} return void;
given gd_vals given gd_two ("wide"):() then (import gdstk)[1]:(5)
given gd_vals given gd_one_on ("len"):() then (import gdstk)[0]:(6)
