// The arithmetic: a product is primaries joined by `*`, a sum is products
// joined by `+` and `-`, each operator written after its operands.

gd_prod() {
  gd_prim();
  while(gd_peek() == "*") {
    gd_adv();
    gd_prim();
    gd_emit("*");
  }
} return void;
given gd_rpn_new given gd_bad_new given gd_open(["2", "*", "3"]) ():() then (import gdrpn)[2]:("*")
given gd_rpn_new given gd_bad_new given gd_open(["2", "+", "3"]) ():() then len((import gdrpn)):(1)

gd_term(string gdq_op) {
  gd_adv();
  gd_prod();
  gd_emit(gdq_op);
} return void;
given gd_rpn_new given gd_bad_new given gd_open(["+", "3"]) ("+"):() then (import gdrpn)[1]:("+")
given gd_rpn_new given gd_bad_new given gd_open(["+", "3"]) ("+"):() then (import gdrpn)[0]:("i:3")

gd_more() {
  string gdq_op = gd_peek();
  while(gdq_op == "+" || gdq_op == "-") {
    gd_term(gdq_op);
    gdq_op = gd_peek();
  }
} return void;
given gd_rpn_new given gd_bad_new given gd_open(["+", "2", "-", "3"]) ():() then len((import gdrpn)):(4)
given gd_rpn_new given gd_bad_new given gd_open(["*", "2"]) ():() then len((import gdrpn)):(0)
