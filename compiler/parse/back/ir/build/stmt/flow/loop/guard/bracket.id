// A parenthesised sum, or a leaf; and the closing bracket that must be there.

gd_prim_b(string gdq_tok) {
  if(gdq_tok == "(") {
    gd_sum();
    gd_want(")");
    gd_post();
  } else {
    gd_leaf(gdq_tok);
  }
} return void;
given gd_rpn_new given gd_bad_new given gd_open(["4", ")", "->len"]) ("("):() then (import gdrpn)[1]:("->len")
given gd_rpn_new given gd_bad_new given gd_open(["4"]) ("5"):() then (import gdrpn)[0]:("i:5")

gd_want(string gdq_tok) {
  string gdq_next = gd_peek();
  if(gdq_next != gdq_tok) {
    lset((import gdbad), 0, 1);
  }
  gd_adv();
} return void;
given gd_bad_new given gd_open([")"]) (")"):() then (import gdbad)[0]:(0)
given gd_bad_new given gd_open(["]"]) (")"):() then (import gdbad)[0]:(1)
