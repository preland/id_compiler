// The operands. A primary is a cast of a primary, a parenthesised sum that may
// be followed by `->len` or `->cap`, or a name or number. Each writes its
// reverse Polish form to gdrpn as it is read.

gd_post() {
  string gdq_tok = gd_peek();
  if(gdq_tok == "->len" || gdq_tok == "->cap") {
    gd_emit(gdq_tok);
    gd_adv();
  }
} return void;
given gd_rpn_new given gd_open(["->len"]) ():() then (import gdrpn)[0]:("->len")
given gd_rpn_new given gd_open(["->len"]) ():() then (import gdpos)[0]:(1)
given gd_rpn_new given gd_open(["+"]) ():() then len((import gdrpn)):(0)

gd_prim() {
  string gdq_tok = gd_peek();
  gd_adv();
  gd_prim_of(gdq_tok);
} return void;
given gd_rpn_new given gd_bad_new given gd_fix given gd_open(["j"]) ():() then (import gdrpn)[0]:("v:j")
given gd_rpn_new given gd_bad_new given gd_open(["7"]) ():() then (import gdpos)[0]:(1)

gd_prim_of(string gdq_tok) {
  if(gdq_tok == "(long long)") {
    gd_prim();
    gd_emit("L");
  } else {
    gd_prim_b(gdq_tok);
  }
} return void;
given gd_rpn_new given gd_bad_new given gd_open(["3"]) ("(long long)"):() then (import gdrpn)[1]:("L")
given gd_rpn_new given gd_bad_new given gd_open(["3"]) ("(long long)"):() then (import gdrpn)[0]:("i:3")
