// A condition in `id` is any integral value, true when it is nonzero, so a
// branch tests `!= 0` rather than taking a bit. The comparison a reader wrote
// has already become an icmp of its own; this one collapses in constfold.

lw_cond(int node) {
  string t = type_of(node);
  int v = lw_expr(node);
  int ret_i = lw_truth(v, t);
} return int ret_i;
