// One arm of a branch, or the body of a loop: a block, its statements, and the
// jump out of whatever block the arm ended in -- which is not necessarily the
// block it started in, because a nested if leaves the cursor on its join.
lw_arm(int b, int[] stmts, int jn) {
  lw_go(b);
  lw_stmts(stmts);
  lw_term("br", 0 - 1, [jn]);
} return void;
given bound_fixture (0, [1], 5):() then chk_lwcur:(0)
