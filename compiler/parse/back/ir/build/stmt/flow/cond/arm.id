// The loop test. Written out rather than folded into the cbr call because the
// condition's own instructions have to land in the head block before the
// branch does, and relying on argument evaluation order to arrange that is the
// kind of thing that is true until it is not.
lw_head(int node, int bdy, int ex) {
  int i1_of_v = i1_of(node);
  int c = lw_cond(i1_of_v);
  lw_term("cbr", c, [bdy, ex]);
} return void;
