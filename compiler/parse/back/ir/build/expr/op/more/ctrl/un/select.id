// Unary `-`, `~` and `!`. The first two keep their operand's type; `!` is a
// truth test, so it is a comparison against zero and widens back to `int`.

lw_un(int node) {
  string lw_ety_v = lw_ety(node);
  int ret_i = lw_un2(node, lw_ety_v);
} return int ret_i;
given un_fixture {
  ((import neg_node)):(4)
  ((import not_node)):(6)
}

lw_un2(int node, string t) {
  int v = 0 - 1;
  if((import ns1)[node] == "!") {
    v = lw_not(node);
  } else {
    v = lw_un2_op(node, t);
  }
} return int v;
given un_fixture {
  ((import not_node), "int"):(6)
  ((import neg_node), "int"):(4)
}

