lw_tostr_at(int v, string t) {
  int r = v;
  if(t == "bool") {
    r = lw_tostr_bool(v);
  } else if(t != "string") {
    string lw_strfn_v = str_pick2(t, "int", "id_str_of_int", "float", "id_str_of_float", "id_str_of_word");
    r = lw_callf(lw_strfn_v, "string", [v]);
  }
} return int r;
