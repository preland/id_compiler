// The IR opcode for an operator at a type. Float arithmetic is its own set of
// opcodes rather than a flag on the integer ones, because that is how the
// printer wants it and how every fold has to read it anyway.
lw_irop(string op, string t) {
  string p = str_map((import irop_ik), (import irop_iv), op, "and");
  if(ty_kind(t) == "float") {
    p = str_map((import irop_fk), (import irop_fv), op, "fadd");
  }
} return string p;
given ir_rows {
  ("+", "int"):("add")
  ("-", "int"):("sub")
  ("*", "int"):("mul")
  ("&", "int"):("and")
  ("|", "int"):("or")
  ("^", "int"):("xor")
  ("-", "float"):("fsub")
  ("*", "float"):("fmul")
  ("/", "float"):("fdiv")
  ("+", "float"):("fadd")
}
