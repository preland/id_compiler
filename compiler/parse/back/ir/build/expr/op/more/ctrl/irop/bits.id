
lw_iop_bits(string op) {
  string p = "and";
  if(op == "|") {
    p = "or";
  } else if(op == "^") {
    p = "xor";
  }
} return string p;
given ir_rows ("|"):("or")
given ir_rows ("^"):("xor")

