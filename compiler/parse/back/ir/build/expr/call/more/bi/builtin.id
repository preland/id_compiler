// Builtins. Each becomes the runtime call the C target spells for it, with its
// arguments converted to the types that runtime symbol actually takes -- C did
// those conversions implicitly and LLVM IR will not do them at all.

lw_builtin(int node) {
  int v = 0 - 1;
  if(s1_of(node) == "print" || s1_of(node) == "eprint") {
    string fn_v = "id_" + s1_of(node);
    v = lw_print(fn_v, node);
  } else {
    v = lb_b2(node);
  }
} return int v;

lb_b2(int node) {
  int v = 0 - 1;
  if(s1_of(node) == "len") {
    v = lw_len(node);
  } else {
    v = lb_b3(node);
  }
} return int v;

lb_b3(int node) {
  int v = 0 - 1;
  if(s1_of(node) == "push") {
    v = lw_push(node);
  } else {
    v = lb_b4(node);
  }
} return int v;
