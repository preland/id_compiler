// The flat store and the unsigned operations work in machine words, so every
// argument widens into one -- which is exactly the cast the C target writes.
// mem_of_str is the exception on both targets: its argument is a string.
lw_bpty2(string name, int i) {
  string t = "";
  if(is_syscall(name) == 1 && name != "mem_of_str" || name == "bytes_of_memory" && i == 0) {
    t = "word";
  } else {
    t = lw_bpty3(name, i);
  }
} return string t;
("peek8", 0):("word")
("mem_of_str", 0):("string")
("bytes_of_memory", 0):("word")
("bytes_of_memory", 1):("")

lw_bpty3(string name, int i) {
  string t = "";
  if(name == "to_int" || name == "mem_of_str" || name == "put" || name == "fail" || name == "character_code_at" && i == 0) {
    t = "string";
  } else if(name == "chr" || name == "sleep_ms" || name == "character_code_at") {
    t = "int";
  }
} chain (string name, int i) {
  if(name == "bits_of_float" || name == "bits32_of_float") {
    t = "float";
  } else if(name == "float_of_bits" || name == "float_of_bits32") {
    t = "word";
  }
} return string t;
("to_int", 0):("string")
("chr", 0):("int")
("fail", 0):("string")
("bits32_of_float", 0):("float")
("float_of_bits", 0):("word")

// The rest of lw_barg_at, once the argument's own position is known.
lw_barg_val(int i, int[] vals, int[] args, string name) {
  string lw_bpty_v = lw_bpty(name, i, args[i]);
  int lw_as_v = lw_as_arg(args[i], lw_bpty_v, name);
  int ret_i = lw_barg_push(i, vals, lw_as_v);
} return int ret_i;
