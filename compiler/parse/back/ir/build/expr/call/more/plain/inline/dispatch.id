// The unsigned and word-width builtins as LLVM instructions rather than calls.
// The hosted C runtime and the freestanding one agree on every value these
// compute, and none of them traps, so the module can say what they mean
// instead of naming a symbol for the linker to resolve: the optimizer sees an
// `icmp ult` or a `fshl` where it would otherwise see an opaque call.
lw_expand(string helper, string ret_ty, int[] ih_args) {
  int ret_i = 0 - 1;
  if(helper == "id_ult") {
    ret_i = lw_inline_ult(ih_args);
  } else {
    ret_i = lw_expand_word(helper, ret_ty, ih_args);
  }
} return int ret_i;
given lw_env_fixture {
  ("id_ult", "word", [0, 1]):(1)
  ("id_x", "word", [0, 1]):(0)
}

lw_expand_word(string helper, string ret_ty, int[] ih_args) {
  int ret_i = 0 - 1;
  if(helper == "id_uword_of_int") {
    ret_i = lw_inline_uword(ih_args);
  } else {
    ret_i = lw_expand_turn(helper, ret_ty, ih_args);
  }
} return int ret_i;
given lw_env_fixture {
  ("id_uword_of_int", "word", [0]):(1)
  ("id_x", "word", [0]):(0)
}

lw_expand_turn(string helper, string ret_ty, int[] ih_args) {
  int ret_i = 0 - 1;
  if(helper == "id_rotl") {
    ret_i = lw_callf("llvm.fshl.i64", "word", [ih_args[0], ih_args[0], ih_args[1]]);
  } else {
    ret_i = lw_expand_turn32(helper, ret_ty, ih_args);
  }
} return int ret_i;
given lw_env_fixture {
  ("id_rotl", "word", [0, 1]):(0)
  ("id_x", "word", [0, 1]):(0)
}
