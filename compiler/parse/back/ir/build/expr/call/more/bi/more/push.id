// The rest of lw_push2, once the value to push is converted.
lw_push2_tail(int a, int v, string elem) {
  int lw_box_v = lw_box(v, elem);
  int ret_i = lw_callf("id_list_push", "", [a, lw_box_v]);
} return int ret_i;
