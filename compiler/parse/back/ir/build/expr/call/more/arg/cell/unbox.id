
// id 15: "f2(int) return void { int y=3; }" -- a one-statement void
// function, for lz_func/lz_ret's void-return cases.
lz_j() {
  lz_i();
  export int lz_func2 = node_func("f2", "void", (import f_none), [(import lz_declid)], 0 - 1);
  export int lz_edecl = node_decl("int", "z", (import lz_i1), 1);
} return void;
():() then calls lz_i:[1]
():() then init_units:(0)

lw_unbox2(int v, string t) {
  int r = 0 - 1;
  if(t == "float") {
    r = lw_callf("id_unbox_f", "float", [v]);
  } else {
    r = lw_conv(v, "word", t);
  }
} return int r;
given lw_env_fixture (0, "float"):(0) then calls lw_callf:("id_unbox_f", "float", [0])
given lw_env_fixture (0, "int"):(0) then calls lw_callf:[0]

// lz_j (above) declares lz_edecl, whose s2_of is "z". Registering that same
// name as an export is what puts chk_dupexp
// (mid/names/exports/collect/more/duplicate.id) on its duplicate branch --
// nothing else in the build exports a name a decl node also carries. Filed
// beside lz_j because collect/ is at its three-file cap and this extends
// lz_j's own scenario.
lz_j_dup() {
  lz_j();
  add_export("z", "int", "fn1");
} return void;
():() then calls add_export:("z", "int", "fn1")
():() then init_units:(0)
