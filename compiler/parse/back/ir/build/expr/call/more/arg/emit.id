
lw_callf(string name, string ret, int[] args) {
  int[] none = [];
  int ret_i = lw_emit("call", ret, 0 - 1, 0 - 1, name, args, none);
} return int ret_i;

// print and eprint: the one argument, of any type, in string context, passed
// to the runtime helper `fn_v` names. Only the helper differs between the two.
lw_print(string fn_v, int node) {
  int[] l1_of_v = l1_of(node);
  int lw_tostr_v = lw_tostr(l1_of_v[0]);
  int ret_i = lw_callf(fn_v, "", [lw_tostr_v]);
} return int ret_i;
