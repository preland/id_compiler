
// A call that is not to a builtin: through a variable of function type, or to
// a function by name.
lw_ocall(int node) {
  int v = 0 - 1;
  if(is_fcall(node) == 1) {
    v = lw_fcall(node);
  } else {
    v = lw_ucall(node);
  }
} return int v;
