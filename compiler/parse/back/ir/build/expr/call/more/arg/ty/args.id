// The two halves of the guard are functions rather than names, because `&&`
// skips its right side: `f` is -1 when the callee has no AST node, and a name
// bound before the `if` would have called l1_of(-1) to compute it.
lw_pty2(int f, int i, string t) {
  string p = t;
  if(f >= 0 && lw_has_par(f, i) == 1) {
    p = param_type(f, i);
  }
} return string p;
