// A logical shift right. A negative count traps, a count of the word's width
// or more gives zero (the C helper's rule), and a count in range is the plain
// lshr. lshr by 64 or more is poison, so the count is masked to six bits and
// the result is anded with all ones when the count was in range and zero when
// not -- no select, which the IR has no instruction for.
lw_inline_ushr(int[] ih_args) {
  int ih_zero = lw_const("word", "0");
  int ih_neg = lw_op("icmp", "bool", ih_args[1], ih_zero, "<");
  lw_guard(ih_neg, "shift by a negative amount");
} chain (int[] ih_args) {
  int ih_width = lw_const("word", "64");
  int ih_small = lw_op("icmp", "bool", ih_args[1], ih_width, "u<");
  int ih_mask = lw_op("sext", "word", ih_small, 0 - 1, "");
} chain (int[] ih_args) {
  int ih_six = lw_const("word", "63");
  int ih_cnt = lw_op("and", "word", ih_args[1], ih_six, "");
  int ih_shr = lw_op("lshr", "word", ih_args[0], ih_cnt, "");
} chain (int[] ih_args) {
  int ret_i = lw_op("and", "word", ih_shr, ih_mask, "");
} return int ret_i;
