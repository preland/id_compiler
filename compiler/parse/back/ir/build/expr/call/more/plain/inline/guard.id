// The unsigned shift as LLVM instructions, guarded by the same
// trap the C helpers raise. The guard is built here, at IR-build time, the way
// `&&` builds its blocks (../../../../../op/more/ctrl/logic): a conditional
// branch to a block that calls id_fail with the helper's own message, and a
// join block the rest of the expression continues in. The .ll printer never
// splits a block, so no phi's incoming label can go stale.

// Branch to a trap block when `bad` holds, then carry on in the join block.
lw_guard(int gd_bad, string gd_msg) {
  int gd_trap = ir_block((import lwfn)[0], "trap");
  int gd_ok = ir_block((import lwfn)[0], "ok");
  lw_term("cbr", gd_bad, [gd_trap, gd_ok]);
} chain (int gd_bad, string gd_msg) {
  lw_go(gd_trap);
  int gd_text = lw_const("string", "\"" + gd_msg + "\"");
  lw_callf("id_fail", "", [gd_text]);
} chain (int gd_bad, string gd_msg) {
  lw_term("br", 0 - 1, [gd_ok]);
  lw_go(gd_ok);
} return void;
