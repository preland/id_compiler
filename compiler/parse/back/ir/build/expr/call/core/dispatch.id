given fcallv_fixture ((import fcallv_node)):("id_gfunc")

lw_ucall_rest(int node, string name) {
  string ety = lw_ety(node);
  int[] args = lw_args(node);
  int ret_i = lw_callf(name, ety, args);
} return int ret_i;
