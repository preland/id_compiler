// A resolved call goes to the runtime spelling; a call through a variable of
// function type calls the value it holds; anything else is an ordinary
// `id_`-prefixed call, name and arguments lowered in the order they were
// written.
lw_call_dispatch(int node, string name) {
  int v = 0 - 1;
  if(is_builtin(name) == 1) {
    v = lw_builtin(node);
  } else {
    v = lw_ocall(node);
  }
} return int v;
