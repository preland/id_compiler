given lw_fix_arr_empty ((import fix_arr_empty_n)):([0])

lw_arr_val(int node, int i, string elem) {
  int[] els = (import nl1)[node];
  int v = lw_as(els[i], elem);
  int boxed = lw_box(v, elem);
} return int boxed;
