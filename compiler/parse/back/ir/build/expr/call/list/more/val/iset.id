// The value half of a list-element assignment: converted, then boxed. The
// index shares lw_index_idx with a plain read -- same node, same computation.
// id 13: "hi" * x, a second "bin" node; id 14: "bar(x)", a second "call".
lz_i() {
  lz_h();
  export int lz_bin2 = node_bin("*", (import lz_str), (import lz_var));
  export int lz_call2 = node_call("bar", [(import lz_var)]);
} return void;
