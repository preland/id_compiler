
lw_iset(int node, int a, string elem) {
  int i = lw_index_idx(node);
  int v = lw_iset_val(node, elem);
  lw_callf("id_list_set", "", [a, i, v]);
} return void;

// A fresh list. Its own function because the runtime call takes no arguments
// and an empty list literal needs a typed context, which an argument position
// is not.
lw_new(string ty) {
  int[] none = [];
  int ret_i = lw_callf("id_list_new", ty, none);
} return int ret_i;
