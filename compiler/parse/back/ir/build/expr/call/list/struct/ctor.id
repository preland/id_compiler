// A struct constructor, lowered as the list it is at run time: a new list, then
// one push per field, each value converted to the field's type and boxed to the
// runtime's uniform cell -- the same steps a list literal takes (../lit/arr.id),
// except that the element type is the field's own and differs from one cell to
// the next.

lw_ctor(int node) {
  string ty = lw_ety(node);
  int a = lw_new(ty);
  lw_ctor_els(node, a);
} return int a;
