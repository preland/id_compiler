// A list literal: a non-empty one is a single id_list_lit call that allocates
// the exact capacity and fills every cell, as the C target does; an empty one
// is a new list with no pushes, which is why `[]` needs no separate case.
lw_arr(int node) {
  string elem = lw_arr_elem(node);
  int a = lw_arr_build(node, elem);
} return int a;
given lw_fix_arr ((import fix_arr_n)):(3)
given lw_fix_arr_empty ((import fix_arr_empty_n)):(0)

lw_arr_els(int node, int a, string elem) {
  int i = 0;
  while(lw_args_more(node, i)) {
    i = lw_arr_one(node, i, a, elem);
  }
} return void;
