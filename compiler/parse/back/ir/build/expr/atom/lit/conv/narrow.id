// A builtin argument widened to what its helper takes. `udiv`, `umod`, `ult`
// and `ushr` read an `int` as its 32 unsigned bits, so there the widening is a
// zero extension instead of lw_narrow's sign extension.
lw_as_arg(int node, string want, string name) {
  int r = 0;
  if((name == "udiv" || name == "umod" || name == "ult" || name == "ushr") && lw_ety(node) == "int") {
    int v = lw_expr(node);
    r = lw_op("zext", want, v, 0 - 1, "");
  } else {
    r = lw_as(node, want);
  }
} return int r;
