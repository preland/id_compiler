// The rest of lw_alloca, once the entry block and the value itself exist.
lw_alloca_tail(int lw_ent_v, int v, string name) {
  ir_add(lw_ent_v, v);
  int ret_i = lw_bind(name, v);
} return int ret_i;
given lw_fixture (2, 0, "x"):(0) then chk_lwvar_len:(1) then chk_home:(2)
given lw_fixture_vars (2, 0, "z"):(0) then chk_lwvar_len:(2) then chk_home:(2)

// The rest of lw_pslot, once the parameter's type and name are in hand.
lw_pslot_tail(string ty, string name, int v) {
  int lw_alloca_v = lw_alloca(ty, name);
  lw_store_at(lw_alloca_v, v);
} return void;
given lw_fixture ("int", "x", 9):() then chk_lwvar_len:(1)
given lw_fixture2 ("word", "y", 4):() then chk_lwvar_len:(1)

