
lw_params(int[] pars) {
  int i = 0;
  while(i < len(pars)) {
    lw_param(pars[i], i);
    i = i + 1;
  }
} return void;
given lw_fixture_pnode {
  ([0, 1]):() then len((import lwvar)):(2)
  ([0]):() then len((import lwvar)):(1)
}

lw_param(int node, int i) {
  string s1_of_v = (import ns1)[node];
  string s2_of_v = (import ns2)[node];
  lw_param_mid(node, i, s1_of_v, s2_of_v);
} return void;
given lw_fixture_pnode {
  (0, 0):() then len((import lwvar)):(1)
  (1, 1):() then len((import lwvar)):(1)
}

// A parameter is copied into a stack slot like any other local, so that an
// assignment to one is an ordinary store and the lowering needs no second
// rule for it.
lw_pslot(int node, int v) {
  string s1_of_v = (import ns1)[node];
  string s2_of_v = (import ns2)[node];
  lw_pslot_tail(s1_of_v, s2_of_v, v);
} return void;
given lw_fixture_pnode {
  (0, 3):() then len((import lwvar)):(1)
  (1, 4):() then len((import lwvar)):(1)
}
