// Three more AST-node fixtures for the call/list/ lowering cases: an
// `iassign` node (`xs[i] = 9`, reusing lw_fix_index's `index` node as the
// assignment target the way the parser itself does -- node_iassign copies
// its base/idx), an `arr` node (`[1]`), and an empty one (`[]`, for the
// while-loop cases in arr.id that a one-element literal cannot reach).
// Filed here rather than under call/list (every directory there was then at the
// since-dropped 3-entry cap) -- this directory already holds this build's other
// fixtures.

lw_fix_iassign() {
  lw_fix_index();
  int v = node_txt2("int", "9", 9, 0);
  export int fix_iassign_n = node_iassign((import fix_index_n), v);
} return void;
():() then calls node_txt2:("int", "9", 9, 0)
():() then init_units:(0)

lw_fix_arr() {
  lw_env_fixture();
  int a = node_txt2("int", "1", 1, 0);
  export int fix_arr_n = node_arr([a]);
} return void;
():() then calls node_txt2:("int", "1", 1, 0)
():() then init_units:(0)

lw_fix_arr_empty() {
  lw_env_fixture();
  int[] none = [];
  export int fix_arr_empty_n = node_arr(none);
} return void;
():() then calls lw_env_fixture:[1]
():() then init_units:(0)
