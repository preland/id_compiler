// AST to IR, one function at a time.
//
// The result is alloca form: every local is a stack slot, every read a load,
// every write a store, every branch explicit. That is deliberately the dumbest
// correct lowering there is -- no phis to get wrong, and a value is always in
// exactly one place -- so it can be trusted without an argument. Everything
// good about the output comes from the passes afterwards, where it can be
// tested and measured on its own.

ir_lower() {
  int i = 0;
  while(i < len((import prog))) {
    if(is_native((import prog)[i]) == 0) {
      lw_func((import prog)[i]);
    }
    i = i + 1;
  }
} return void;
