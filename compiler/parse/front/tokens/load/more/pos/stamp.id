// The token end of every node, and the parentheses written around one.
//
//   ntok     the last token of each node, parallel to nkind: every node is
//            built just after the tokens that make it up, so it is the token
//            most recently consumed when the node is pushed
//   nst      the first token of each statement node, -1 for every other node
//   ngrp     each node written inside grouping parentheses, once per pair
//   ngrpc    the closing parenthesis of that pair
//   synfail  1 once a syntax error was reported, after which the tree is not
//            what was written and nothing may be rewritten from it
// An expression's first token is not recorded: `idc --fix` works it out from
// the node's kind and its children, which is what these lists are enough for.
init_pos2() {
  export int[] ntok = [];
  export int[] ngrp = [];
  init_pos3();
} return void;
given full_env ():() then check_failed:(0)
given full_env ():() then init_units:(0)

init_pos3() {
  export int[] ngrpc = [];
  export int[] nst = [];
  export int[] synfail = [0];
} return void;
given full_env ():() then check_failed:(0)
given full_env ():() then init_units:(0)

// Consuming a token records its line and its index.
stamp_tok(int[] pos) {
  int cur_ln_v = cur_ln(pos);
  lset((import curtl), 0, cur_ln_v);
  lset((import curtk), 0, pos[0]);
} return void;
given mk_two_toks ([0]):() then calls lset:((import curtl), 0, 1) then calls lset:((import curtk), 0, 0)
given mk_two_toks ([1]):() then calls lset:((import curtl), 0, 1) then calls lset:((import curtk), 0, 1)
