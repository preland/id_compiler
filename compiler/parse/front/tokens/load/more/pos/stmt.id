// A statement's line and first token, recorded once it is parsed: its node is
// the last one the statement builds, so the id is only known afterwards, while
// the token it began at was taken before.

stmt_done(int id, int t0) {
  int n = tok_ln(t0);
  integer_list_set((import nline), id, n);
  integer_list_set((import nst), id, t0);
} return void;
given mk_two_nodes {
  (0, 0):() then calls integer_list_set:((import nline), 0, 1) then calls integer_list_set:((import nst), 0, 0)
  (1, 5):() then calls integer_list_set:((import nline), 1, 1) then calls integer_list_set:((import nst), 1, 5)
}

// The line of token t0, or 1 past the end of the store -- cur_ln's answer for
// a token index rather than a cursor.
tok_ln(int t0) {
  int n = 1;
  if(t0 < len((import tline))) {
    n = (import tline)[t0];
  }
} return int n;
given mk_two_toks {
  (0):(1)
  (5):(1)
}

// Called just after the closing parenthesis was consumed.
grp_note(int e, int[] pos) {
  push((import ngrp), e);
  int c = pos[0] - 1;
  push((import ngrpc), c);
} return void;
given full_env {
  (7, [5]):() then last_ngrp:("ngrp 7") then last_ngrpc:("ngrpc 4")
  (9, [2]):() then last_ngrp:("ngrp 9") then last_ngrpc:("ngrpc 1")
}
