// substring + token append.

slice(string src, int a, int b) {
  string out = "";
  if(a < b) {
    out = str_sub(src, a, b - a);
  }
} return string out;
("hello world", 0, 5):("hello")
("hello world", 6, 11):("world")
("hi", 2, 1):("")

// A `line N` marker is not a token: it updates the current line and is
// dropped, so the cursor and everything above it are unchanged, and every
// real token records the line it was on.
push_tok(string kind, string text) {
  if(kind == "line") {
    int to_int_v = to_int(text);
    push((import lnseen), to_int_v);
  } else if(kind == "span") {
    set_span(text);
  } else {
    push_tok2(kind, text);
  }
} return void;
given full_env {
  ("line", "7"):() then src_line:(7)
  ("kw", "if"):() then calls push_real:("kw", "if")
}

push_real(string kind, string text) {
  push((import tkind), kind);
  push((import ttext), text);
  push_line();
} return void;
given full_env {
  ("kw", "if"):() then last_tkind:("tkind kw") then calls push_line:()
  ("ident", "x"):() then last_tkind:("tkind ident") then calls push_line:()
}
