// Loader: read the lexer's "<kind> <value>" lines from stdin into the token
// store. Kind = text before the first space, value = text after it.

// No cases: read_all() is a builtin that reads the process's real stdin fd
// directly in the generated C (mid/names/exports/extern/builtin/more/
// names.id's builtin_list carries it beside input/getkey), and given/then
// can only substitute a literal or a setup's exported state for an ordinary
// id-level call -- neither reaches a builtin's own I/O. load_at/take_line,
// its callees, take the string as a parameter and are cased directly.
load() {
  string src = read_all();
  load_at(src, 0);
} return void;
given full_env stdin "op =\nkw return\n" ():() then last_tkind:("tkind kw")
given full_env stdin "ident x\n" ():() then last_tkind:("tkind ident")

load_at(string src, int i) {
  while(i < len(src)) {
    i = take_line(src, i);
  }
} return void;
given full_env ("op =\nkw return\n", 0):() then last_tkind:("tkind kw")
given full_env ("ident x\n", 0):() then last_tkind:("tkind ident")

take_line(string src, int i) {
  int e = string_end_of_line(src, i);
  proc_line(src, i, e);
  int ret_i = e + 1;
} return int ret_i;
given full_env ("op =\n", 0):(5) then calls proc_line:("op =\n", 0, 4)
given full_env ("kw return\n", 0):(10) then calls proc_line:("kw return\n", 0, 9)
