// An operator where an expression belongs.
//
// The atom parser's last resort is "whatever text is here is a name", which
// for an operator token manufactures a variable called `/` -- and the first
// complaint anyone sees is the access pass reporting an undefined variable
// with a punctuation mark for a name, three times, for one mistake. An
// operator is never a name, so it is reported here, once, as what it is.

no_op_atom(int[] pos) {
  if(cur_kind(pos) == "op") {
    string cur_text_v = cur_text(pos);
    op_atom_diag(pos, cur_text_v);
  }
} return void;
given mk_two_toks ([0]):() then (import chkfail)[0]:(1) then prints:("<stdin>:1: error: unexpected token '=' [E0102]\n  at: =\n  why: an operator cannot start an expression or a statement; the parser was looking for a name, a number, a string, a call or a type\n  help: write an operand where '=' is, or remove it; a missing operand just before it is the usual cause\n")
given mk_two_toks ([1]):() then (import chkfail)[0]:(0)

// The lexer folds a whole `/* ... */` into one `/*` token precisely so this
// can say what the mistake actually was.
unexpected_msg(string t) {
  string s = "unexpected token '" + t + "'";
  if(t == "/*") {
    s = "block comments are not supported; use // for a line comment";
  }
  if(t == ".") {
    s = "unexpected token '.'; a float literal cannot start with the point";
  }
} chain (string t) {
  if(t == "#!") {
    s = "'#!' is only allowed as the first line of a file";
  }
} return string s;
("+"):("unexpected token '+'")
("/*"):("block comments are not supported; use // for a line comment")
("."):("unexpected token '.'; a float literal cannot start with the point")
("#!"):("'#!' is only allowed as the first line of a file")

// The tail of syn_err.id's syn_err -- that file is already full.
syn_err_tail(string err_file, int err_line, string msg) {
  print(err_file + ":" + err_line + ": error: " + msg);
  note_failure();
  integer_list_set((import synfail), 0, 1);
} return void;
given full_env ("f.id", 3, "bad"):() then prints:("f.id:3: error: bad\n") then (import chkfail)[0]:(1)
given full_env ("g.id", 7, "oops"):() then prints:("g.id:7: error: oops\n") then (import chkfail)[0]:(1)
