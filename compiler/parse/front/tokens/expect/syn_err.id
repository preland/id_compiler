// Syntax diagnostics. Without these the parser silently mis-parses malformed
// input into a valid-looking AST, and the first thing to notice is a *later*
// pass complaining about something unrelated -- `return 0;` inside a body
// became a call to an undefined variable named `return`, which is true but
// useless.
//
// Parsing continues after an error rather than stopping: the AST is already
// wrong, but reporting every syntax problem in one run matches what the rest
// of this compiler does, and nothing is emitted when any check has failed.

syn_err(int[] pos, string msg) {
  string cur_file_v = cur_file();
  int cur_ln_v = cur_ln(pos);
  syn_err_tail(cur_file_v, cur_ln_v, msg);
} return void;
given mk_two_toks {
  ([0], "custom msg"):() then prints:("<stdin>:1: error: custom msg\n") then (import chkfail)[0]:(1)
  ([1], "other msg"):() then prints:("<stdin>:1: error: other msg\n") then (import chkfail)[0]:(1)
}

expect_text(int[] pos, string want) {
  if(cur_text(pos) != want) {
    string cur_text_v = cur_text(pos);
    syn_expected(pos, want, cur_text_v);
  }
} return void;
given mk_two_toks {
  ([0], "="):() then (import chkfail)[0]:(0)
  ([1], "="):() then (import chkfail)[0]:(1) then prints:("<stdin>:1: error: expected '=', found 'return' [E0101]\n  at: return\n  why: the grammar needs '=' here to finish what it was reading, so the construct before this point is incomplete or mistyped\n  help: put '=' where it belongs; if it looks right, check the line before for a missing ';', ')' or '}', because those are noticed one token late\n")
}

// The rest of push_tok (../load/more/push_tok.id, at its three-function cap):
// a `tcc KEY` line is not a token either -- it is a type-check key bin/idc
// has on record as clean (mid/types/check/walk/check/tk/), kept in tccin. An
// `ext` line is no token either: it is one row of the library's index, for
// a build that did not load the library whole (mid/names/symbols/check/
// conflict/more/core/ext/).
push_tok2(string kind, string text) {
  if(kind == "tcc") {
    push((import tccin), text);
  } else if(kind == "ext") {
    ext_line(text);
  } else {
    push_tok3(kind, text);
  }
} return void;
given full_env {
  ("tcc", "123"):() then len((import tkind)):(0)
  ("kw", "int"):() then len((import tkind)):(1)
  ("ext", "M\tlazy"):() then len((import tkind)):(0)
}
