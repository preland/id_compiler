// A `)` or `]` where an operand belongs closes nothing: say so and say to
// delete it, rather than call it an unexpected operator.
op_atom_diag(int[] pos, string oa_tok) {
  if(oa_tok == ")" || oa_tok == "]") {
    syn_stray(pos, oa_tok);
  } else {
    string unexpected_msg_v = unexpected_msg(oa_tok);
    syn_unexpected(pos, oa_tok, unexpected_msg_v);
  }
} return void;
given mk_two_toks {
  ([0], ")"):() then (import chkfail)[0]:(1)
  ([0], "="):() then (import chkfail)[0]:(1) then prints:("<stdin>:1: error: unexpected token '=' [E0102]\n  at: =\n  why: an operator cannot start an expression or a statement; the parser was looking for a name, a number, a string, a call or a type\n  help: write an operand where '=' is, or remove it; a missing operand just before it is the usual cause\n")
}
