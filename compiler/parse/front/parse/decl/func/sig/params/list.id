// Parameter list: ( [type name (, type name)*] )
//
// `kind` is the node kind each parameter is built as: "param" for a function
// with a body, "nparam" for a `native` declaration, whose parameter names are
// documentation rather than variables (see ../../../top/decl/native/).

parse_params(int[] pos, string kind) {
  int[] params = [];
  scan_params(pos, params, kind);
} return int[] params;
given decl_tokens ([1], "param"):([0, 1])
given decl_tokens ([1], "nparam"):([0, 1])

scan_params(int[] pos, int[] params, string kind) {
  advance(pos);
  fill_params(pos, params, kind);
  advance(pos);
} return void;
given decl_tokens ([1], [], "param"):([8], [0, 1])
given decl_tokens ([1], [], "nparam"):([8], [0, 1])

fill_params(int[] pos, int[] params, string kind) {
  while(cur_text(pos) != ")" && cur_kind(pos) != "eof") {
    int one_param_v = one_param(pos, kind);
    push(params, one_param_v);
    skip_comma(pos);
  }
} return void;
given decl_tokens ([2], [], "param"):([7], [0, 1])
given decl_tokens ([2], [], "nparam"):([7], [0, 1])
