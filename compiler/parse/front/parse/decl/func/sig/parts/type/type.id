// Parse a type: a base keyword (int/float/string/void) plus any number of
// `[]` suffixes, or a function type (fn.id). Shared by declarations,
// parameters, and return clauses.

parse_type(int[] pos) {
  string t = cur_text(pos);
  advance(pos);
  string ret_s = type_tail(t, pos);
} return string ret_s;

// A function type takes no brackets of its own: any that follow belong to its
// return type, which it parses itself.
type_tail(string t, int[] pos) {
  string s = t;
  if(t == "func") {
    s = parse_fn_type(pos);
  } else {
    s = add_brackets(t, pos);
  }
} return string s;

add_brackets(string t, int[] pos) {
  while(cur_text(pos) == "[") {
    advance(pos);
    advance(pos);
    t = t + "[]";
  }
} return string t;
