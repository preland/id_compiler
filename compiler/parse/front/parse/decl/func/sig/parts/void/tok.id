// The token store by absolute index, for the one place that has to look past
// the cursor. Everything else reads through cur_kind and cur_text, which is
// why these live here rather than beside them.
tok_at(int at) {
  string k = "eof";
  if(at < len((import tkind))) {
    k = (import tkind)[at];
  }
} return string k;
given expr_tokens (0):("int")
given expr_tokens (20):("eof")

tok_str(int at) {
  string s = "";
  if(at < len((import ttext))) {
    s = (import ttext)[at];
  }
} return string s;
given expr_tokens (0):("1")
given expr_tokens (19):(";")

// A token index no later than the end of the store. A function that runs into
// the end of the file has consumed past it, and a span ending there would be
// walked by the digest as tokens that do not exist.
tok_end(int at) {
  int e = len((import tkind));
  if(at < e) {
    e = at;
  }
} return int e;
given expr_tokens (0):(0)
given expr_tokens (99):(21)
