// The restated parameters must match the function's own, exactly.
//
// They are restated for the reader -- a chain is a continuation, so the values
// in scope are the ones the signature already named -- which makes a
// restatement that disagrees a mistake about what is in scope rather than a
// second signature. A parameter node is newleaf(kind, 0, 0, type, name), so
// s1 is the type and s2 is the name (front/tree/make/stmt/decl_call.id).

chain_same(int[] pos, int[] params, int[] restated) {
  if(len(params) != len(restated)) {
    syn_err(pos, "a chain restates the function's parameters exactly; this one lists a different number");
  } else {
    chain_each(pos, params, restated);
  }
} return void;
given decl_tokens ([33], [], []):() then check_failed:(0)
given decl_tokens ([33], [0], []):() then check_failed:(1)

chain_each(int[] pos, int[] params, int[] restated) {
  int i = 0;
  while(i < len(params)) {
    chain_one(pos, params[i], restated[i]);
    i = i + 1;
  }
} return void;
given regrow_param ([33], [], []):() then check_failed:(0)
given regrow_param ([33], (import regrow_plist), (import regrow_plist)):() then check_failed:(0)

// s1 is the type and s2 the name, so this compares both halves of the
// parameter. Neither call is an argument to the other, so the condition stays
// within the expression rules.
chain_one(int[] pos, int a, int b) {
  if(s1_of(a) != s1_of(b) || s2_of(a) != s2_of(b)) {
    syn_err(pos, "a chain restates the function's parameters exactly; this one differs");
  }
} return void;
given farm_g ([33], (import f_pa), (import f_pa)):() then check_failed:(0)
given farm_g ([33], (import f_pa), (import f_pb)):() then check_failed:(1)
