// `export NAME` after a return type that is not void: only a void function says
// which export it initializes, since a function that returns a value has a
// result to say instead. The two tokens are skipped so one mistake is reported once.
non_void_export(int[] pos, string rt) {
  if(rt != "void" && cur_kind(pos) == "kw" && cur_text(pos) == "export") {
    syn_err(pos, "only a void function can name the export it initializes: '} return " + rt + " export NAME;' gives a value and a variable at once; drop 'export NAME' from the return clause, or make the function void");
    advance(pos);
    advance(pos);
  }
} return void;
