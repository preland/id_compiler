// One case: `(args) : (expected) [constraints]`.
//
// The two tuples are parsed as ordinary expressions and then held to being
// literals, which is what lets the harness build them without running any of
// the program. The token range is recorded around the whole case, constraints
// included, because that range is what the duplicate-case rule compares.

parse_case(int[] pos) {
  push((import casestart), pos[0]);
  int[] args = case_tuple(pos);
  int ret_i = parse_case_rhs(pos, args);
} return int ret_i;

parse_case_rhs(int[] pos, int[] args) {
  eat_colon(pos);
  int[] expd = case_tuple(pos);
  int ret_i = case_tail(pos, args, expd);
} return int ret_i;

case_tail(int[] pos, int[] args, int[] expd) {
  case_cons(pos);
  push((import caseend), pos[0]);
  int ret_i = newnode("case", 0, 0, "", "", args, expd);
} return int ret_i;
