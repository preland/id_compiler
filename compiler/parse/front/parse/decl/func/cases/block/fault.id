given gblk_stream("open") ([0], 0, 3, 13):(0) then (import synfail)[0]:(0) then len((import tkind)):(14)

gblk_inner(int gb_at, int gb_k, int gb_in) {
  int gb_hit = 0;
  if(gb_in >= 0) {
    gblk_inner_diag(gb_at, gb_k, gb_in);
    gb_hit = 1;
  }
} return int gb_hit;
