gblk_try(int[] pos) {
  int gb_at = pos[0];
  int gb_e = gblk_line_end(gb_at);
  int gb_k = gblk_close(gb_e);
} chain (int[] pos) {
  int gb_skip = gblk_fault(pos, gb_at, gb_e, gb_k);
  if(gb_skip == 0) {
    gblk_apply(gb_at, gb_e, gb_k);
  }
} return int gb_skip;
