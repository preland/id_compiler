// E0523: every case of the function begins with the same first given and none
// is inside a block, so the setup belongs in a block. Run on the cases as
// written, before any block among them is expanded.
gblk_share(int[] pos) {
  int gb_first = pos[0];
  int gb_gend = gblk_given_end(gb_first);
  int gb_cnt = gblk_same(gb_first, gb_gend);
} chain (int[] pos) {
  if(gb_cnt >= 2) {
    if((import bsc)[1] == 1) {
      gblk_share_diag(pos, gb_first, gb_gend, gb_cnt);
    }
  }
} return void;
