// The two hooks take_cases calls: the block expansion, ahead of each case, and
// the shared-setup check, once ahead of a function's cases.

// 1 when the opener was refused and its tokens dropped, so the caller must look
// at the store again; 0 when there was no block or it has been expanded, and
// the cursor is on a case either way.
gblk_open(int[] pos) {
  int gb_skip = 0;
  if(gblk_is_open(pos[0]) == 1) {
    gb_skip = gblk_try(pos);
  }
} return int gb_skip;
