// A claim is about `time` or `mem`. idc.py's wording for both mistakes.
cons_kind(int[] pos, string ck) {
  if(cur_kind(pos) != "ident") {
    syn_err(pos, "expected 'time' or 'mem', found '" + ck + "'");
  } else if(ck != "time" && ck != "mem") {
    syn_err(pos, "unknown constraint '" + ck + "'; a case constrains 'time' or 'mem'");
  }
} return void;

// One literal int leaf (id 0), for cases/more/lit/kinds.id's leaf_lit/
// leaf_num true case.
fixture_int_leaf() {
  env_init();
  node_int("1", 1, 0);
} return void;
():() then check_failed:(0)
():() then last_i2:(0)

// `-1`: a unary minus (id 1) wrapping a literal (id 0), for
// cases/more/lit/kinds.id's neg_lit.
fixture_neg_lit_node() {
  env_init();
  node_int("1", 1, 0);
  node_un("-", 0);
} return void;
():() then check_failed:(0)
():() then last_i2:(0)
