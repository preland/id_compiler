// The case columns that follow casefn and casestart (front/tokens/expect/).
//
//   caseend    one past each case's last token
//   casenode   each case's "case" node: arguments in nl1, expected in nl2
//   conscase   for each claim, the index of the case it is written on
//   conskind   the claim's kind, `time` or `mem`
//   consbound  the claim's bound as canonical text, e.g. `O(n log n)`
//   casegiven  each case's setup function, or "" (cases/case/given/)
//   casestdin  each case's `stdin "TEXT"` node, or -1 (cases/case/given/)
//   casetimeout  each case's `timeout N` seconds, or 0 (cases/case/given/)
//   casegargs  each case's "gargs" node: one "gsetup" per `given`, in order,
//              holding the literals a setup is called with (cases/case/given/)
//   thennode   each `then` check, as a "then" node (cases/case/then/)
//   ptoks      each function's first token, parallel to `prog` as parsed
//   ptoke      one past its return clause's last token: the text a case
//              key hashes (mid/form/unique/dump/digest/)
//   pnodes     its node, so a function can be found again once `prog` has
//              been narrowed or pruned and no longer lines up with pfile
//   unitc      [1 under --units, the emitter's cursor into pnodes], and
//   unitlast   the file the last unit marker named (back/tgt/c/emit/prog/
//              code/func/def/body/rest/unit.id)
//   rcon       1 once the setup-reach memo exists (mid/names/limits/shape/
//              cases/given/read/reach/memo.id)
//   tccin      the clean type-check keys bin/idc handed in, as `tcc KEY`
//              lines in the token stream (front/tokens/expect/syn_err.id)
//   tcerrs     how many type-check diagnostics have been printed
//   tkout      [1 under --tc-keys]: write this build's clean keys (mid/
//              types/check/walk/check/tk/)
//   uroots     each compilation unit's root directory, from --unit-roots:
//              where a unit's cases run (back/tgt/c/emit/prog/test/judge/
//              claims/)
//   sqbase     the node of the function the C emitter is inside, which its
//              sequencing temporaries are named from (sq_name, back/tgt/c/
//              emit/prog/code/body/hoist/hoist_loop.id)

init_cases() {
  export int[] caseend = [];
  export int[] casenode = [];
  init_cases2();
} return void;
():() then calls init_cases2:[1]
():() then calls init_cases2:()

// casegiven: casegiven[0] as it stands, for given_fit's cases: a check takes no
// arguments, and what it must show is that the cut-down list was put back.
// consbound: The bound a claim gives that kind, the third of the three. claim_cols_rest
// (back/tgt/c/emit/prog/test/judge/more/claim/more/group.id) reaches
// claim_cols_bounds, so the fixture that leaves one kind row leaves two.
// conscase: cons_push (rest.id) pushes the three claim columns in step, one entry each
// per claim, so a reader of any one of them sees that push happen -- but only
// that one: deleting either of the other two pushes would leave this count
// exactly where it was. That is why each column has a reader of its own, and
// why cons_push's cases check all three at once: the columns must grow
// together, and only asserting them together says so.
// conskind: The kind a claim constrains, pushed by cons_push (../../../../more/lit/
// cons/rest.id) beside the case index and the bound. Filed here because the
// cons directory has one free function slot and the three parallel columns
// need a reader each -- conscase_len (../../../../more/lit/cons/list.id) says
// why one cannot stand for the others.
// uroots: How many unit roots bin/idc passed (root.id), for its cases.
init_cases2() {
  export int[] conscase = [];
  export string[] conskind = [];
  export string[] consbound = [];
} chain () {
  export string[] casegiven = [];
  export int[] thennode = [];
  export int[] casestdin = [];
} chain () {
  export int[] ptoks = [];
  export int[] ptoke = [];
  export int[] pnodes = [];
} chain () {
  export int[] unitc = [0, 0];
  export string[] unitlast = [""];
  export int[] sqbase = [0];
} chain () {
  export int[] rcon = [0];
  export string[] tccin = [];
  export int[] tcerrs = [0];
} chain () {
  export int[] tkout = [0];
  export string[] uroots = [];
  export int[] casetimeout = [];
} chain () {
  export int[] casegargs = [];
} return void;
():() then len((import consbound)):(0)
given claim_cols_fixture ():() then len((import consbound)):(0)
