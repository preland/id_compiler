// Only the bounds docs/TESTS.md defines may be claimed. Anything else is
// named, rather than silently checked as something it does not say.

bound_close(int[] pos, string bt, string parts) {
  eat_text(pos, ")");
  string so = bt + "(" + parts + ")";
  bound_check(pos, so);
} return string so;
given bound_n_fix ([3], "O", "n"):("O(n)") then prints:("")
given bound_n_fix ([3], "O", "n^5"):("O(n^5)") then prints:("<stdin>:1: error: unknown bound 'O(n^5)'; the bounds a case may claim are O(1), O(log n), O(n), O(n log n), O(n^2) [E0507]\n  at: O(n^5)\n  why: a bound is checked by counting steps at two input sizes, and only these five growth rates have a counted check\n  help: claim the nearest bound from the list, as in [time:O(n)]\n")

bound_check(int[] pos, string so) {
  if(str_in((import bigo_words), so) == 0) {
    syn_diag(pos, "E0507", "unknown bound '" + so + "'; the bounds a case may claim are O(1), O(log n), O(n), O(n log n), O(n^2)", so, "a bound is checked by counting steps at two input sizes, and only these five growth rates have a counted check", "claim the nearest bound from the list, as in [time:O(n)]");
  }
} return void;
given env_init ([0], "O(n^3)"):() then prints:("<stdin>:1: error: unknown bound 'O(n^3)'; the bounds a case may claim are O(1), O(log n), O(n), O(n log n), O(n^2) [E0507]\n  at: O(n^3)\n  why: a bound is checked by counting steps at two input sizes, and only these five growth rates have a counted check\n  help: claim the nearest bound from the list, as in [time:O(n)]\n")
given env_init ([0], "O(n log n)"):() then (import synfail)[0]:(0)
given env_init ([0], "O(n)"):() then prints:("")

