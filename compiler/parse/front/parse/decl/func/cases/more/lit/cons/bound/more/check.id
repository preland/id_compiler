// Only the bounds docs/TESTS.md defines may be claimed. Anything else is
// named, rather than silently checked as something it does not say.

bound_close(int[] pos, string bt, string parts) {
  eat_text(pos, ")");
  string so = bt + "(" + parts + ")";
  bound_check(pos, so);
} return string so;
given bound_n_fix ([3], "O", "n"):("O(n)") then prints:("")
given bound_n_fix ([3], "O", "n^5"):("O(n^5)") then prints:("<stdin>:1: error: unknown bound 'O(n^5)'; the bounds a case may claim are O(1), O(log n), O(n), O(n log n), O(n^2)\n")

bound_check(int[] pos, string so) {
  if(str_in((import bigo_words), so) == 0) {
    syn_err(pos, "unknown bound '" + so + "'; the bounds a case may claim are O(1), O(log n), O(n), O(n log n), O(n^2)");
  }
} return void;
given env_init ([0], "O(n)"):() then prints:("")
given env_init ([0], "O(n^3)"):() then prints:("<stdin>:1: error: unknown bound 'O(n^3)'; the bounds a case may claim are O(1), O(log n), O(n), O(n log n), O(n^2)\n")

