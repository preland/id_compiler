// The rest of one claim, once its kind has been read: `: O(...)`.

cons_rest(int[] pos, string ck) {
  advance(pos);
  eat_colon(pos);
  cons_bound(pos, ck);
} return void;
given toks_env(["ident"], ["time"]) ([0], "time"):() then prints:("<stdin>:1: error: expected ':', found '' [E0101]\n  why: the grammar needs ':' here to finish what it was reading, so the construct before this point is incomplete or mistyped\n  help: put ':' where it belongs; if it looks right, check the line before for a missing ';', ')' or '}', because those are noticed one token late\n<stdin>:1: error: expected '(', found '' [E0101]\n  why: the grammar needs '(' here to finish what it was reading, so the construct before this point is incomplete or mistyped\n  help: put '(' where it belongs; if it looks right, check the line before for a missing ';', ')' or '}', because those are noticed one token late\n")
given toks_fn(["kw", "ident", "op", "op", "int", "op"], ["then", "myfn", ":", "(", "6", ")"]) ([1], "mem"):() then prints:("<stdin>:1: error: expected '(', found '6' [E0101]\n  at: 6\n  why: the grammar needs '(' here to finish what it was reading, so the construct before this point is incomplete or mistyped\n  help: put '(' where it belongs; if it looks right, check the line before for a missing ';', ')' or '}', because those are noticed one token late\n")

cons_bound(int[] pos, string ck) {
  string bt = big_o(pos);
  int n = len((import casestart));
  cons_push(n, ck, bt);
} return void;
given bound_n_fix ([0], "foo"):() then prints:("")
given toks_fn(["kw", "ident", "op", "op", "int", "op"], ["then", "myfn", ":", "(", "6", ")"]) ([1], "bar"):() then prints:("<stdin>:1: error: expected '(', found ':' [E0101]\n  at: :\n  why: the grammar needs '(' here to finish what it was reading, so the construct before this point is incomplete or mistyped\n  help: put '(' where it belongs; if it looks right, check the line before for a missing ';', ')' or '}', because those are noticed one token late\n")

// The case being parsed is the last one whose start has been recorded.
cons_push(int n, string ck, string bt) {
  push((import conscase), n - 1);
  push((import conskind), ck);
  push((import consbound), bt);
} return void;
given case_fixture (1, "time", "O(n)"):() then len((import conscase)):(1) then len((import conskind)):(1) then len((import consbound)):(1)
