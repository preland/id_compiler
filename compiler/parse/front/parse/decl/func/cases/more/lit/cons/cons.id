// The constraint list: `[time:O(n), mem:O(1)]`, optional. Parsed from
// case_rest (../../case/then/then.id) when the case has one.
//
// Each claim is recorded in three parallel lists -- the case it is written on,
// its kind and its bound -- because a claim is checked against the OTHER cases
// of the same function that carry it, and that grouping is a scan of these.

cons_list(int[] pos) {
  cons_one(pos);
  while(cur_text(pos) == ",") {
    advance(pos);
    cons_one(pos);
  }
  expect_text(pos, "]");
} return void;
given cons_fix1 ([0]):() then prints:("<stdin>:1: error: expected ':', found ''\n<stdin>:1: error: expected '(', found ''\n<stdin>:1: error: expected ']', found ''\n")
given bound_n_fix ([0]):() then prints:("<stdin>:1: error: unknown constraint 'O'; a case constrains 'time' or 'mem'\n<stdin>:1: error: expected ':', found '('\n<stdin>:1: error: expected '(', found 'n'\n<stdin>:1: error: expected ']', found 'n'\n")

cons_one(int[] pos) {
  string ck = cur_text(pos);
  cons_kind(pos, ck);
  cons_rest(pos, ck);
} return void;
given cons_fix1 ([0]):() then prints:("<stdin>:1: error: expected ':', found ''\n<stdin>:1: error: expected '(', found ''\n")
given bound_n_fix ([0]):() then prints:("<stdin>:1: error: unknown constraint 'O'; a case constrains 'time' or 'mem'\n<stdin>:1: error: expected ':', found '('\n<stdin>:1: error: expected '(', found 'n'\n")
