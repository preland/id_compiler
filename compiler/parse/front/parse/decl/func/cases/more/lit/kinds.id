// The leaves a case literal may be built from.

leaf_lit(int e) {
  int r = 0;
  if(k_of(e) == "int" || k_of(e) == "float" || k_of(e) == "str") {
    r = 1;
  }
} return int r;
given fixture_lit_nodes (0):(1)
given fixture_lit_nodes (1):(0)

leaf_num(int e) {
  int r = 0;
  if(k_of(e) == "int" || k_of(e) == "float") {
    r = 1;
  }
} return int r;
given fixture_lit_nodes (0):(1)
given fixture_lit_nodes (1):(0)

// `-1` is a unary minus applied to a literal, not a literal of its own.
neg_lit(int e) {
  int r = 0;
  int i1_of_v = i1_of(e);
  if(s1_of(e) == "-" && leaf_num(i1_of_v) == 1) {
    r = 1;
  }
} return int r;
given fixture_neg_lit_node (1):(1)
given fixture_lit_nodes (1):(0)
