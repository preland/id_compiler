// `-1` is a unary minus applied to a literal, not a literal of its own.
neg_lit(int e) {
  int r = 0;
  int i1_of_v = (import ni1)[e];
  if((import ns1)[e] == "-" && leaf_num(i1_of_v) == 1) {
    r = 1;
  }
} return int r;
