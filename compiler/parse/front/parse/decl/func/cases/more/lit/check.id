// A case takes literals only: a number, a string, a negated number, or a list
// of those. Anything else -- a variable, a call, arithmetic -- is rejected here
// rather than when the harness is emitted, where the diagnostic would be about
// a name that is not in scope. idc.py's wording, word for word.
//
// A list is not checked here: it is read element by element as a tuple is
// (case/given/elem/more/list.id), so each element is held to this on its own.

check_lit(int e) {
  if(is_lit(e) == 0) {
    string lit_loc = cur_file() + ":" + (import nline)[e];
    diag("E0506", lit_loc, "a test case takes literals only (a number, a string, a list of those, or a struct written as P(1, 2))", "", "a case is checked before any variable or call exists, so each value in it must be written out in full", "write the value itself, as in (3, \"a\"):(7), or build it in a function named by 'given'");
    integer_list_set((import synfail), 0, 1);
  }
} return void;
given lit_fix {
  (0):() then prints:("") then (import synfail)[0]:(0)
  (1):() then prints:("<stdin>:0: error: a test case takes literals only (a number, a string, a list of those, or a struct written as P(1, 2)) [E0506]\n  why: a case is checked before any variable or call exists, so each value in it must be written out in full\n  help: write the value itself, as in (3, \"a\"):(7), or build it in a function named by 'given'\n")
}

is_lit(int e) {
  int r = leaf_lit(e);
  if((import nkind)[e] == "un") {
    r = neg_lit(e);
  }
} return int r;
given lit_fix {
  (0):(1)
  (1):(0)
}
