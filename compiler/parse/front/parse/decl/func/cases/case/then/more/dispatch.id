// Which `then` clause this is: the original check (`then NAME:(value)`), the
// two output clauses (more/print/), or a call clause (more/calls/). `prints`,
// `eprints` and `calls` are keywords (lex/chars/classify/ident_kw.id), so a
// check's own name can never collide with one.
//
// KNOWN GAP: none of the new parser functions here (then_dispatch through
// more/print/'s and more/calls/'s, and push.id's then_push_kind) carry
// inline cases. Every existing parser function that takes `pos` in this tree
// is in the same position -- none has cases either, self-hosted or not
// (`grep -rlE '":\("' front | xargs grep -L given` finds none carrying the
// form) -- because a case for one would need a synthetic token stream
// (ttext/tkind/tline, front/tokens/load/) built by hand, which is a fixture
// this tree does not yet have anywhere. They are exercised end to end by
// tests_feature.sh's 25 new cases, which parse real `prints`/`eprints`/
// `calls` clauses through this exact code on every run.

then_dispatch(int[] pos) {
  if(cur_kind(pos) == "kw" && (cur_text(pos) == "prints" || cur_text(pos) == "eprints")) {
    then_print_dispatch(pos);
  } else if(cur_kind(pos) == "kw" && cur_text(pos) == "calls") {
    then_calls_clause(pos);
  } else {
    then_traps_or_check(pos);
  }
} return void;
given toks_fn(["kw", "ident", "op", "op", "int", "op"], ["then", "myfn", ":", "(", "6", ")"]) ([1]):()
given toks_fn(["kw", "kw", "op", "op", "str", "op"], ["then", "prints", ":", "(", "\"hi\"", ")"]) ([1]):()

then_check_clause(int[] pos) {
  if(at_case_import(pos) == 1 || cur_text(pos) == "len") {
    then_imp_clause(pos);
  } else {
    string chk_nm = case_fn_name(pos, "then");
    then_value(pos, chk_nm);
  }
} return void;
given toks_fn(["kw", "ident", "op", "op", "int", "op"], ["then", "myfn", ":", "(", "6", ")"]) ([1]):()
given toks_fn(["ident", "op", "op", "int", "op"], ["otherfn", ":", "(", "6", ")"]) ([0]):()
given toks_env(["op", "kw", "ident", "op"], ["(", "import", "zz", ")"]) ([0]):() then calls then_imp_clause:[1]
given env_init given toks_push(["ident", "op", "op", "kw", "ident", "op", "op", "op", "op", "int", "op"], ["len", "(", "(", "import", "zz", ")", ")", ":", "(", "5", ")"]) ([0]):() then calls then_imp_clause:[1]

// `traps` is the fourth keyword then_dispatch tells apart, folded in here
// rather than as a fourth branch above (that if/else-if chain already spends
// its own action budget) -- more/calls/fixture.id's then_traps_clause is the
// actual parse.
then_traps_or_check(int[] pos) {
  if(cur_kind(pos) == "kw" && cur_text(pos) == "traps") {
    then_traps_clause(pos);
  } else {
    then_check_clause(pos);
  }
} return void;
given toks_fn(["kw", "ident", "op", "op", "int", "op"], ["then", "myfn", ":", "(", "6", ")"]) ([1]):()
given toks_fn(["kw", "op", "op", "str", "op"], ["traps", ":", "(", "\"hi\"", ")"]) ([0]):()
