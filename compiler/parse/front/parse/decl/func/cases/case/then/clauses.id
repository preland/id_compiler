// `then (import NAME):(value)` and `then (import NAME)[i]:(value)`: the
// export, or one element of it, read after the call and compared with a
// literal -- no function is named, so s1 is the export's name, s2 the fields
// named after it (`(import NAME).a.b` is ".a.b", "" for none), l2 holds the
// index's node when there is one, and the kind is "thenimp". The index is a
// single scalar, or an `(import NAME)` naming a conf.id constant (a "cimport"
// node, as in a tuple), held to being an int by the checker (mid/names/limits/
// shape/cases/given/then/check/). `then len((import NAME)):(value)` is the same node
// with the kind "thenlen" and no index: the length of the export, an int.
then_imp_clause(int[] pos) {
  int is_len = 0;
  if(cur_text(pos) == "len") {
    advance(pos);
    advance(pos);
    is_len = 1;
  }
  int e = then_imp_item(pos);
} chain (int[] pos) {
  int[] imp_ix = [];
  if(cur_text(pos) == "[") {
    advance(pos);
    push(imp_ix, case_item(pos));
    expect_text(pos, "]");
  }
  if(is_len == 1) {
    eat_close(pos);
  }
} chain (int[] pos) {
  if(len(imp_ix) == 1 && cur_text(pos) == "]") {
    advance(pos);
  }
  eat_colon(pos);
  int[] items = case_tuple(pos);
} chain (int[] pos) {
  string kd = "thenimp";
  if(is_len == 1) {
    kd = "thenlen";
  }
  then_imp_store(kd, e, items, imp_ix);
} return void;
