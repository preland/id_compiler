// An element of a case tuple: a literal, `(import NAME)` -- the value an
// export holds once the case's setup has run -- a function's name (fn.id), or a list of
// these (more/list.id).
//
// It is a "cimport" node, not an "import". An import is a read inside a
// function body, and the dead-export check walks bodies by node range
// (mid/names/exports/reach/dead/sweep.id), in which a case's nodes fall into
// the function declared after it: an "import" here would be judged as that
// function's read. Whether the export exists, is set up by the case's `given`
// and has the right type is checked in mid/names/limits/shape/cases/given/.

case_item(int[] pos) {
  int v = 0;
  if(at_case_import(pos) == 1) {
    v = case_import(pos);
    import_index(pos, (import ns1)[v]);
  } else {
    v = case_value(pos);
  }
} return int v;
given toks_env(["op", "kw", "ident", "op"], ["(", "import", "zz", ")"]) ([0]):(0)
given tup1_fix ([0]):(0)

case_import(int[] pos) {
  advance(pos);
  advance(pos);
  int ret_i = import_rest(pos);
} return int ret_i;
given toks_env(["op", "kw", "ident", "op"], ["(", "import", "zz", ")"]) ([0]):(0)
given toks_env(["op", "kw", "ident", "op"], ["(", "import", "zz", ")"]) ([0]):(0) then (import chkfail)[0]:(0)

import_rest(int[] pos) {
  string name = read_name(pos);
  eat_text(pos, ")");
  int ret_i = newleaf("cimport", 0, 0, name, "");
} return int ret_i;
given toks_env(["op", "kw", "ident", "op"], ["(", "import", "zz", ")"]) ([2]):(0)
given toks_env(["op", "kw", "ident", "op"], ["(", "import", "zz", ")"]) ([2]):(0) then (import chkfail)[0]:(0)
