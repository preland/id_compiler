// A function's name as a case element: that function, passed as a value to a
// function that takes one (docs/SPEC.md 1.1). A function that takes a function
// value needs its cases like any other, and its name is as fixed as a literal
// -- nothing runs to produce it -- so it needs no setup either. It is a "cfn"
// node rather than a "var" for the reason a case's import is a "cimport"
// (elem.id). Anything else that is not a literal is still refused.

case_value(int[] pos) {
  int v = 0;
  if(ident_then(pos, (import nx_elem_end)) == 1) {
    v = case_fn(pos);
  } else {
    if(cur_text(pos) == "[") {
      v = case_list(pos);
    } else {
      v = case_scalar(pos);
    }
  }
} return int v;
given fnname_fix ([0]):(0)
given tup1_fix ([0]):(0)
given sd_case_toks ([0]):(2)

case_fn(int[] pos) {
  string name = read_name(pos);
  int ret_i = newleaf("cfn", 0, 0, name, "");
} return int ret_i;
given fnname_fix ([0]):(0)
