// Top level is a marker the driver injected -- a file boundary or a conf.id
// constant -- or an ordinary declaration.
parse_top(int[] pos) {
  if(cur_kind(pos) == "file") {
    take_file(pos);
  } else if(cur_kind(pos) == "const") {
    take_const(pos);
  } else {
    parse_decl_top(pos);
  }
} return void;
given decl_tokens ([0]):([37])
given decl_tokens ([0]):() then calls parse_decl_top:[1]

// asm "triple" name(params) { "insn" ... } return TYPE name;
parse_asm(int[] pos) {
  advance(pos);
  string cur_text_v = cur_text(pos);
  string unquote_v = unquote(cur_text_v);
} chain (int[] pos) {
  push((import aftriple), unquote_v);
  string cur_text_v2 = cur_text(pos);
  push((import afname), cur_text_v2);
} chain (int[] pos) {
  advance(pos);
  advance(pos);
  int[] parse_params_v = parse_params(pos, "param");
} chain (int[] pos) {
  int ret_i = asm_sig_tail(pos, parse_params_v);
} return int ret_i;
