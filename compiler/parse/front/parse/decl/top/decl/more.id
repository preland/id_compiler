// The function's own token range is recorded beside it (ptoks/ptoke), before
// its cases are taken: the text a case key hashes is the declaration alone,
// so adding a case to a function does not change the key of a caller's case.
push_func_body(int[] pos) {
  int ptok_first = pos[0];
  int parse_func_v = parse_fn(pos);
  push((import prog), parse_func_v);
} chain (int[] pos) {
  int ptok_last = tok_end(pos[0]);
  ptok_note(ptok_first, ptok_last, parse_func_v);
  int ret_i = take_cases(pos);
} return int ret_i;
given decl_tokens ([0]):(0) then ptok_span:(37)
