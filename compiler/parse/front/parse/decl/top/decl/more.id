// push_asm records where an asm declaration begins, the way push_func
// records an ordinary function's, before parse_asm (../core/top.id) consumes
// it -- so --calls can give it a fn row (asm_case_row, mid/names/limits/
// report/more/loc/func_line.id; print_asm_cases, back/drive/run/check/dce/
// emit/guard/guarded_emit.id) the way an ordinary function already gets one.
// aloc holds "file:line" already joined, one entry per declaration, parallel
// to afname (front/parse/decl/kinds/asm/asm_state.id).
push_asm(int[] pos) {
  string cur_file_v = cur_file();
  int cur_ln_v = cur_ln(pos);
  string loc = cur_file_v + ":" + cur_ln_v;
} chain (int[] pos) {
  push((import aloc), loc);
  int ret_i = parse_asm(pos);
} return int ret_i;
