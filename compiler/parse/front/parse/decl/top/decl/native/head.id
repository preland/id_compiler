// `native` declarations: a function whose body is native code a backend
// links in.
//
//   native NAME(TYPE p, ...) return TYPE;
//
// It is an ordinary func node -- in `prog`, in the symbol tables, counted by
// the per-file rule and compared by uniqueness -- with no body, no return
// expression, and 1 in its second int field (see is_native). Every check that
// reads a function therefore reads this one, and only the emitters ask.
//
// Its parameters are "nparam" nodes, not "param": with no body they name
// nothing, so they carry types for the call checks and prototypes but are not
// variables. They enter no symbol table and reserve no name, so a program may
// export or retype a name a backend's parameter happens to use.

parse_fn(int[] pos) {
  int pure_v = at_pure(pos);
  skip_pure(pos);
  int n = parse_fn_kind(pos);
} chain (int[] pos) {
  pure_mark_fn(pure_v, n);
} return int n;
given decl_tokens ([0]):(17)
given decl_tokens ([0]):(17) then (import chkfail)[0]:(0)

parse_native(int[] pos) {
  advance(pos);
  string name = cur_text(pos);
  int ret_i = native_sig(pos, name);
} return int ret_i;
given decl_tokens ([0]):(2)
given decl_tokens ([32]):(1)

native_sig(int[] pos, string name) {
  advance(pos);
  int[] params = parse_params(pos, "nparam");
  int ret_i = native_ret(pos, name, params);
} return int ret_i;
given decl_tokens ([1], "n1"):(2)
given decl_tokens ([33], "n2"):(1)
