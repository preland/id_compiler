// Parameter nodes for pure_mark_param's cases (../kind.id): a function-typed
// parameter and an int one, each the first node of a fresh environment, so its
// id is 0.

pure_fix_fn_param() {
  full_env();
  int pfix_fn = node_param("param", "func(int) return int", "g");
} return void;
():() then calls node_param:("param", "func(int) return int", "g")
():() then init_units:(0)

pure_fix_int_param() {
  full_env();
  int pfix_int = node_param("param", "int", "g");
} return void;
():() then calls node_param:("param", "int", "g")
():() then init_units:(0)
