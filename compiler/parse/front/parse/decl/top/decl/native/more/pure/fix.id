// A parameter node for pure_mark_param's cases (../kind.id): a function-typed
// one (pure_fix_param("func(int) return int")) or an int one
// (pure_fix_param("int")), the first node of a fresh environment, so its id is 0.

pure_fix_param(string pfix_ty) {
  full_env();
  int pfix_node = node_param("param", pfix_ty, "g");
} return void;
("func(int) return int"):() then calls node_param:("param", "func(int) return int", "g")
("int"):() then calls node_param:("param", "int", "g")
("int"):() then init_units:(0)
