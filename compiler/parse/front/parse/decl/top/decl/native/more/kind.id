// A `pure` that is not before a function type: E0807.
pure_misplaced(int[] pos, string name, string type) {
  string msg = "'pure' belongs before a parameter whose type is a function type, and '" + name + "' is " + type;
  string why = "'pure' promises that the function a caller passes writes no export and does no I/O, which says nothing about a value of type " + type;
  string help = "write 'pure func(...) return ...' only for a function-typed parameter; remove 'pure' from '" + name + "', or give it a function type";
} chain (int[] pos, string name, string type) {
  syn_diag(pos, "E0807", msg, name, why, help);
} return void;
