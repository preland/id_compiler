// What follows a function's `pure` marker (pure/pure.id): a native declaration
// or an ordinary function. Split from parse_fn (../head.id), which is at its
// file's three-function cap, so that the marker is read before either form.

parse_fn_kind(int[] pos) {
  int n = 0;
  if(cur_text(pos) == "native") {
    n = parse_native(pos);
  } else {
    n = parse_func(pos);
  }
} return int n;
