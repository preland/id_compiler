// A `#const` marker and the declaration after it: a constant from the
// project's conf.id.
//
// The marker is a bare token; the declaration that follows is ORDINARY source,
// so parse_decl reads it and nothing here re-implements declaration parsing
// for a marker payload. See bin/idc's emit_sources for the injection.
//
// A constant belongs to no function, which is the entire point of it. An
// `export` inside a function body does not exist until that function runs --
// which is why idstd's 91-entry sin table needs fx_trig_init() called from
// every program's setup chain, and why forgetting it is a compile error rather
// than working code. A constant needs no such call: the compiler emits one
// initialiser for all of them and calls it before main.
//
//   cdecl  the declaration node of each constant, in conf.id order
//   ctoks  each constant's first token, parallel to cdecl, and
//   ctoke  one past its last: the text a case key hashes for the constants
//          a case reaches (mid/form/unique/dump/digest/graph/build/consts/)
//
// Two pieces of parse state that are not about constants ride along, because
// this is the parser's one init with room: pend_rets holds the early `return`
// nodes of the function being parsed, which learn its name and return type
// only once its return clause is read (sig/params/seal.id); loopd is how many
// `while` bodies enclose the statement being parsed, so a `break` outside one
// is refused where it is written (stmt/form/more.id).

init_consts() {
  export int[] cdecl = [];
  init_pos();
  export int[] pend_rets = [];
} chain () {
  export int[] loopd = [0];
  export int[] ctoks = [];
  export int[] ctoke = [];
} return int 0;
given env_init ():(0)
given env_init ():(0) then (import chkfail)[0]:(0)

take_const(int[] pos) {
  advance(pos);
  int ctok_first = pos[0];
  int parse_decl_v = parse_decl(pos);
} chain (int[] pos) {
  int fold_v = fold_const(parse_decl_v);
  reg_const(fold_v, ctok_first, tok_end(pos[0]));
} return void;
given decl_tokens ([9]):([14]) then ctok_span:(4)
given decl_tokens ([9]):([14]) then (import chkfail)[0]:(1)

// Registered in the same export tables an in-function `export` fills, so the
// name is reserved program-wide and a collision with a function's export is
// caught by the ordinary duplicate check. The owner is "conf.id" -- the file
// the constant was written in -- rather than a function name, because there is
// no function: an identifier cannot contain a dot, so no program can define a
// function by that name and claim to own a constant.
reg_const(int d, int ctok_first, int ctok_last) {
  add_export2(d, "conf.id");
  push((import cdecl), d);
  push((import ctoks), ctok_first);
} chain (int d, int ctok_first, int ctok_last) {
  push((import ctoke), ctok_last);
} return void;
given lc_reg_setup (0, 3, 8):() then ctok_span:(5)
given lc_reg_setup (1, 10, 10):() then ctok_span:(0)
