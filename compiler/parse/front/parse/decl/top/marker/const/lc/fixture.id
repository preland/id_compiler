// A synthetic conf.id constant, registered the way reg_const registers a real
// one (const.id) -- built by hand from a node the case constructs, rather
// than parsed from a `#const` marker, so a case can give const_decl and its
// callers a constant without a source file. lc_env runs env_init (env.id)
// and also init_consts, which env_init's own chain never reaches: init_consts
// is normally called only while parsing a `#const` marker.

lc_env() {
  env_init();
  init_consts();
  lc_env2();
} return void;
given fold_setup ():() then len((import cdecl)):(0)
given fold_setup ():() then len((import nline)):(0)
():() then len((import cdecl)):(0)
():() then init_units:(0)
():() then calls env_init:[2]

lc_reg(string type, string name, int expr) {
  int d = node_decl(type, name, expr, 1);
  add_export2(d, "conf.id");
  push((import cdecl), d);
} return int d;
given lc_reg_setup {
