const_find(string name) {
  int fold_src = 0 - 1;
  int i = 0;
  while(i < len((import cdecl))) {
    if(s2_of((import cdecl)[i]) == name && ty_is_list(s1_of((import cdecl)[i])) == 0) {
      fold_src = (import cdecl)[i];
    }
    i = i + 1;
  }
} return int fold_src;
