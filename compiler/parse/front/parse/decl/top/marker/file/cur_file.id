// Which source file the compiler is currently reading. The pipeline hands
// idparse one concatenated stream, so the driver injects `#file N|<path>`
// markers between files and the lexer turns each into a `file` token.
//
// The current file is the last one pushed -- a list rather than a mutable
// cell, because only a declaring function may assign an exported scalar, and
// a stack needs no assignment at all.
//
//   fseen  every file marker seen, in order
//   pfile  the file each entry of `prog` came from, same length as `prog`

init_files() {
  export string[] fseen = [];
  export string[] pfile = [];
  int ret_i = init_files_rest();
} return int ret_i;

cur_file() {
  string s = "<stdin>";
  if(len((import fseen)) > 0) {
    s = (import fseen)[len((import fseen)) - 1];
  }
} return string s;

// The marker carries the unit as well as the path (see unit/split.id): the
// path goes on the stack every diagnostic reads, the unit into the cell every
// node created from here on is stamped with.
take_file(int[] pos) {
  string cur_text_v = cur_text(pos);
  string file_path_v = file_path(cur_text_v);
  take_file_mid(pos, file_path_v);
} return void;
