// One call recorded, for cnode_count's own cases above.
mk_one_call() {
  env_init();
  init_calls();
  call_at(5, 10);
} return void;
():() then calls call_at:(5, 10)
():() then len((import cnode)):(1)

// One file marker taken, for cur_file.id's cur_file/take_file cases.
mk_one_file() {
  env_init();
  init_files();
  take_file_mid([0], "x.id");
} return void;
():() then calls take_file_mid:([1], "x.id")
():() then cur_file:("x.id")
