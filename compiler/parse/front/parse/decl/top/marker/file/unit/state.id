// The unit columns.
//
//   nunit  the unit each AST node was parsed in, parallel to nkind
//   ucur   the unit the parser is reading now, set by every `#file` marker
//   vunit  the unit each row of vnames/vtypes was declared in
//
// A variable's type is looked up by name alone, which is only sound while a
// name keeps one type -- and it does, within a unit. So the symbol table is
// keyed by unit as well as name, and a node carries the unit it was written
// in so that every lookup can say which one it means.
//
// stdunit rides the same init, at its own -1 ("no library to exclude")
// default: it is mutated in place by nat_init's own chain
// (back/drive/sink/natives/more/live.id) once a real build's --std-unit is
// read, not re-exported there, since a name is exported once -- and mutated
// here in a chain of its own because this segment already used its 3.
//
// exclunit is the same idea for a unit range --std-unit cannot name: a
// backend directory attached as its own dependency (not merged into the
// stdlib's own contiguous range) is a library too, and its cases are
// excluded by unit number rather than by boundary (mid/names/symbols/
// lookup/more/std_unit.id's unit_excluded). Empty at its own default --
// "nothing excluded", the same reading len() > 0 gives an untouched list
// everywhere else in this program -- and grown by nat_init's chain calling
// back/drive/sink/natives/more/emit.id's exclunit_seed, never lset in
// place: a name is exported once, and a list export is populated the same
// push-based way every other one in this file is.
// stdunit: nat_init's own cases (live.id) read this back to check --std-unit landed
// in the cell; case_unit_fixture (back/tgt/c/emit/prog/test/case/emit.id)
// gives a second, differently-sourced value so this function's own two
// cases are not both nat_init's default.
// cloose: 1 while the literal-insensitive fingerprints are being made
// (mid/form/unique/scan/loose.id), 0 otherwise; canon_expr reads it
// (mid/form/unique/canon/expr/more/lit.id), so it has to exist wherever a
// fingerprint is made, which is everywhere init_units has run.
init_units() {
  export int[] nunit = [];
  export int[] ucur = [0];
  export int[] vunit = [];
} chain () {
  export int[] stdunit = [0 - 1];
  export int[] exclunit = [];
  export int[] cloose = [0];
} return int 0;
given env_init ():(0)
given env_init ():(0) then (import chkfail)[0]:(0)

// The rest of cur_file.id's take_file, split across two more steps to stay
// under the action limit -- and a natural fit here, since the second step
// is the one that writes ucur.
take_file_mid(int[] pos, string seen_path) {
  push((import fseen), seen_path);
  string cur_text_v2 = cur_text(pos);
  take_file_unit(pos, cur_text_v2);
} return void;
given full_env ([0], "src.id"):([1])
given full_env ([0], "other.id"):([1])

take_file_unit(int[] pos, string unit_text) {
  int file_unit_v = file_unit(unit_text);
  lset((import ucur), 0, file_unit_v);
  advance(pos);
} return void;
given full_env ([0], "2|foo"):([1])
given full_env ([0], "nobar"):([1])
