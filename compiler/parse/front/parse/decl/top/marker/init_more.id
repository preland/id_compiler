// The rest of cur_file.id's init_files -- that file is already full, so
// the tail lives up at the marker/ level instead.

init_files_rest() {
  init_files2();
  init_calls();
  int ret_i = init_units();
} return int ret_i;
():(0)
():(0) then calls init_files2:[1]

// The line each call was written on, for the natives list bin/idc reads
// (back/drive/sink/natives/). Two columns rather than one indexed by node,
// because only call nodes have a row.
//
//   cnode  a call node's id, in the order calls were parsed
//   cline  the line its '(' was on
// cnode: How many calls have been recorded, for init_more.id's init_calls/call_at
// cases: both are void and touch only exported lists, which a case can only
// read back through a check. It also starts the function-value registry
// (back/tgt/c/runtime/closure/fv.id), which every environment that emits needs
// and nothing else would start in a case's setup.
init_calls() {
  export int[] cnode = [];
  export int[] cline = [];
  fv_init();
} return void export cnode;
given env_init {
  ():() then (import chkfail)[0]:(0)
  ():() then len((import cnode)):(0)
}

call_at(int node, int ln) {
  push((import cnode), node);
  push((import cline), ln);
} return void;
given init_calls {
  (5, 10):() then len((import cnode)):(1)
  (7, 20):() then len((import cnode)):(1)
}
