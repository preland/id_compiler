// A struct table with two rows in it, for the cases of whatever reads or
// appends to the table: P { int x; int y; } and Q { string s; }.

sd_pair() {
  env_init();
  init_bnames();
  sd_note("P", ["x", "y"], ["int", "int"], "p.id", 1);
} chain () {
  sd_note("Q", ["s"], ["string"], "q.id", 5);
} return void;
():() then sd_count:(2)
():() then sd_last_nf:(1)

// A case element that is a constructor, then a literal: `P(1, 2) 7`.
sd_case_toks() {
  env_init();
  push_toks(["ident", "op", "int", "op", "int", "op", "int", "eof"], ["P", "(", "1", ",", "2", ")", "7", ""]);
} return void;
():() then check_failed:(0)
():() then tkind_len:(8)
