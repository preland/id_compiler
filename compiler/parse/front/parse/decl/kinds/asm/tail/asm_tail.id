
asm_tail(int[] pos) {
  advance(pos);
  string rt = parse_type(pos);
  int ret_i = asm_tail_mid(pos, rt);
} return int ret_i;
given asm_fix_full ([2]):(0) then afret_last:("afret int") then afretn_last:("result")
given toks_env(["op", "str", "op", "kw", "kw", "ident"], ["{", "\"i1\"", "}", "return", "word", "r"]) ([3]):(0) then afret_last:("afret word") then afretn_last:("r")

asm_fin(int[] pos) {
  advance(pos);
  skip_text(pos, ";");
} return int 0;
given asm_fix_full ([4]):(0)
given toks_env(["op", "str", "op", "kw", "kw", "ident"], ["{", "\"i1\"", "}", "return", "word", "r"]) ([5]):(0)

init_asm_all() {
  init_asm();
  init_asm2();
  int ret_i = init_asm_rest();
} return int ret_i;
given env_init ():(0) then calls init_asm:[1]
given env_init ():(0) then init_units:(0)
