// The tail of asm_body.id's asm_lines -- that file's other two functions
// (scan_asm, fill_asm) already fill it to the limit.

asm_lines_tail(int[] pos, string[] alines) {
  push((import aflines), alines);
  int ret_i = asm_tail(pos);
} return int ret_i;
given asm_fix_full ([2], []):(0) then afret_last:("afret int") then afretn_last:("result")
given toks_env(["op", "str", "op", "kw", "kw", "ident"], ["{", "\"i1\"", "}", "return", "word", "r"]) ([3], ["\"i1\""]):(0) then afret_last:("afret word") then afretn_last:("r")

// tspan holding one column value, for set_span's and last_tspan's own cases.
mk_span(string col) {
  full_env();
  set_span(col);
} return void;
("5"):() then last_tspan:("tspan 5")
("9"):() then last_tspan:("tspan 9")
("5"):() then calls set_span:("5")
