
asm_lines(int[] pos) {
  string[] alines = [];
  scan_asm(pos, alines);
  int ret_i = asm_lines_tail(pos, alines);
} return int ret_i;
given asm_fix_full ([0]):(0) then afret_last:("afret int") then afretn_last:("result")
given toks_env(["op", "str", "op", "kw", "kw", "ident"], ["{", "\"i1\"", "}", "return", "word", "r"]) ([0]):(0) then afret_last:("afret word") then afretn_last:("r")

scan_asm(int[] pos, string[] alines) {
  advance(pos);
  fill_asm(pos, alines);
  advance(pos);
} return void;
given asm_fix_full ([0], []):([2], [])
given toks_env(["op", "str", "op", "kw", "kw", "ident"], ["{", "\"i1\"", "}", "return", "word", "r"]) ([0], []):([3], ["\"i1\""])

// The body is a run of string literals and nothing else: an asm function is a
// leaf, so there is no statement, call or import to read here.
fill_asm(int[] pos, string[] alines) {
  while(cur_kind(pos) == "str") {
    string cur_text_v = cur_text(pos);
    push(alines, cur_text_v);
    advance(pos);
  }
} return void;
given toks_env(["op", "str", "str", "op"], ["{", "\"i1\"", "\"i2\"", "}"]) ([1], []):([3], ["\"i1\"", "\"i2\""])
given toks_env(["op", "str", "op"], ["{", "\"i1\"", "}"]) ([1], []):([2], ["\"i1\""])
given env_init ([0], []):([0], [])
