// asm functions: a function whose body is instructions rather than statements,
// declared for one platform triple. See ../../../../../docs/ASM.md.
//
// They are kept out of the ordinary node store because a row needs six fields
// and a node has room for two strings, two ints and two lists. Six parallel
// lists, one row per declaration:
//
//   afname    the function's name -- repeated across platform overloads
//   aftriple  the platform triple this body is written for
//   afparams  parameter nodes, as for an ordinary function
//   aflines   the instruction lines, verbatim, quotes included
//   afret     the return type
//   afretn    the name the return clause gives the result, which is what
//             `%[name]` in the instruction text binds to

// aftriple: One entry per asm row, exported by asm_state (front/parse/decl/kinds/asm/
// asm_state.id) and pushed by parse_asm_mid as it reads each triple. Filed
// here because that directory held three entries (a since-dropped cap) with both files at three
// functions, and the asm subtree this belongs to has room in no other file --
// so it sits two directories from llasm_row_fixture, which pushes the row it
// counts.
// parse_asm_mid, the writer, is deliberately left uncased: reaching it needs
// a token stream standing at the triple string, and every asm fixture in the
// tree starts at the body brace instead, so pinning its one push would take a
// new fixture spanning the parser cursor and a whole declaration. Dropped on
// fixture cost, not because the push is uninteresting -- so this reader is
// ready for that case rather than witnessing one today.
init_asm() {
  export string[] afname = [];
  export string[] aftriple = [];
  export int[][] afparams = [];
} return void;
given env_init {
  given asmfx_push ():() then len((import afname)):(0)
  given llasm_row_fixture ():() then len((import afparams)):(0)
  ():() then (import chkfail)[0]:(0)
  ():() then init_units:(0)
}

init_asm2() {
  export string[][] aflines = [];
  export string[] afret = [];
  export string[] afretn = [];
} return void;
given env_init {
  given asmfx_push ():() then len((import afret)):(0)
  given llasm_row_fixture ():() then len((import aflines)):(0)
  ():() then (import chkfail)[0]:(0)
  ():() then init_units:(0)
}

