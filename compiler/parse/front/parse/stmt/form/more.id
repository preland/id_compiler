given flow_tokens ([0]):(0) then (import chkfail)[0]:(1)

// An early `return`, or on to the rest of the statement forms.
parse_ret_or(int[] pos) {
  int node = 0;
  if(cur_text(pos) == "return") {
    node = parse_ret(pos);
  } else {
    node = parse_stmt4(pos);
  }
} return int node;
