// Leaf of statement dispatch (after assignment): index-assignment
// (`xs[i] = expr`) vs a bare expression statement. Plus the primary helper
// that routes `[` to an array literal and everything else to an atom.

parse_stmt5(int[] pos) {
  int node = 0;
  if(is_iassign(pos)) {
    node = parse_iassign(pos);
  } else {
    node = parse_exprstmt(pos);
  }
} return int node;
given atom_tokens ([33]):(4)
given atom_tokens ([0]):(4)

// `blank` occupies an action slot and does nothing. It exists so that a segment
// which must reach three actions before a chain can do so when the chain's
// first action cannot be lifted into it -- an if/else-if chain being the case
// in point, since splitting one would leave the chain unable to be spun back
// out into its own function later.
parse_blank_or(int[] pos) {
  int node = 0;
  if(cur_text(pos) == "blank") {
    node = parse_blank(pos);
  } else {
    node = parse_stmt4(pos);
  }
} return int node;
