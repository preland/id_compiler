// `name = ...` is an assignment; anything else starting here is an expression
// statement. `cur2_text` looks one token ahead.

is_assign(int[] pos) {
  int ok = 0;
  if(cur_kind(pos) == "ident" && cur2_text(pos) == "=") {
    ok = 1;
  }
} return int ok;
