// `name = ...` is an assignment, `name[` and `name.` an element or field store;
// anything else starting here is an expression statement. peek_text looks a
// number of tokens ahead; ident_then asks whether the identifier at the cursor is
// followed by a token of a set (nx_eq, nx_index and the others in conf.id).

ident_then(int[] pos, string[] nexts) {
  int ok = 0;
  string it_next = peek_text(pos, 1);
  if(cur_kind(pos) == "ident" && str_in(nexts, it_next) == 1) {
    ok = 1;
  }
} return int ok;
given stmt_tokens ([16], ["="]):(1)
given stmt_tokens ([9], ["="]):(0)
given atom_tokens ([33], ["[", "."]):(1)
given atom_tokens ([0], ["[", "."]):(0)

peek_text(int[] pos, int ahead) {
  string s = "";
  if(pos[0] + ahead < len((import ttext))) {
    s = (import ttext)[pos[0] + ahead];
  }
} return string s;
given stmt_tokens ([16], 1):("=")
given stmt_tokens ([42], 1):(";")
given sd_stmt_toks ([5], 2):("]")
given sd_stmt_toks ([0], 2):("=")
