// a declaration starts with `export`, a type keyword, or a struct name
// (written as an identifier followed by another, or by `[]`)
is_decl_start(int[] pos) {
  int ok = 0;
  string cur_text_v = cur_text(pos);
  if(str_in((import typewords), cur_text_v)) {
    ok = 1;
  }
} chain (int[] pos) {
  if(is_named_type_start(pos) == 1) {
    ok = 1;
  }
} return int ok;
