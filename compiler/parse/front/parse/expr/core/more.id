// One "line N" marker loaded (front/tokens/load/more/push_tok.id's push_tok
// drops it rather than storing it as a token), so src_line() -- and anything
// that reads it, such as push_line -- sees 9 instead of the no-marker
// default of 1.
mk_line9() {
  full_env();
  push_tok("line", "9");
} return void;
