// The afretn reader for decl/kinds/asm/'s cases (see
// ../../../tree/node/newnode/fixture.id and ../../../tree/make/array/fixture.id
// for the afret/afretn scenarios themselves).

afretn_last() {
  string s = (import afretn)[len((import afretn)) - 1];
} return string s;
given asm_reg_fix1b("int", "result") ():("result")
given asm_reg_fix1b("word", "r") ():("r")

// The afname reader for decl/top/core/'s parse_asm cases: the function's own
// name, the first thing parse_asm records, and top.id/more.id are both full.
afname_last() {
  string s_t = "afname " + ((import afname)[len((import afname)) - 1]);
} return string s_t;
given asmfx_setup ():("afname foo")
given llasm_row_fixture ():("afname portout")

// Two literal AST nodes for decl/func/cases/more/lit/'s cases: an int
// literal and a plain variable reference (not a literal). Node ids are
// deterministic in a fresh case process, so lit_int is 0 and lit_var is 1.
lit_fix() {
  env_init();
  export int lit_int = node_txt2("int", "5", 5, 0);
  export int lit_var = node_txt("var", "x");
} return void;
():() then calls node_txt2:("int", "5", 5, 0)
():() then calls node_txt:("var", "x")
():() then init_units:(0)
