// multiplicative fold + the primary production.

fold_mul(int[] pos, int left) {
  string op = cur_text(pos);
  advance(pos);
  int ret_i = fold_mul_tail(pos, left, op);
} return int ret_i;
given expr_tokens ([3], 100):(1)
given expr_tokens ([5], 100):(1)

// primary: '(' expr ')' | '[' array literal | INT | STR | ident (var or call)
parse_primary(int[] pos) {
  int node = 0;
  if(cur_text(pos) == "(") {
    node = paren_primary(pos);
  } else {
    node = pp2(pos);
  }
} return int node;
given ptoks_env(["op", "int", "op", "int", "op", "op", "eof"], ["(", "1", "+", "2", ")", ";", ""]) ([0]):(2)
given expr_tokens ([0]):(0)

parse_paren(int[] pos) {
  int pp_ln = cur_ln(pos);
  advance(pos);
  int e = parse_expr(pos);
} chain (int[] pos) {
  close_bracket(pos, ")", pp_ln);
} return int e;
given ptoks_env(["op", "int", "op", "int", "op", "op", "eof"], ["(", "1", "+", "2", ")", ";", ""]) ([0]):(2)
given decl_tokens ([1]):(0)
