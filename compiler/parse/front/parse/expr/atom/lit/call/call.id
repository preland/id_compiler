// After an identifier: a '(' makes it a call, otherwise it is a variable.
//
// A call's line is recorded as it is parsed. Only statements carry a line in
// `nline`, and the diagnostics that already fall back to a function's line
// must keep doing so, so the call's line goes in a table of its own; bin/idc
// names it when a reached native cannot be linked.
finish_atom(string name, int[] pos) {
  int node = node_var(name);
  if(cur_text(pos) == "(") {
    int ln = cur_ln(pos);
    node = parse_call(name, pos);
    call_at(node, ln);
  }
} return int node;
given atom_tokens ("foo", [1]):(3)
given atom_tokens ("x", [26]):(0)

parse_call(string name, int[] pos) {
  int[] args = [];
  scan_args(pos, args);
  int ret_i = node_call(name, args);
} return int ret_i;
given atom_tokens ("foo", [1]):(2)
given atom_tokens ("g", [19]):(1)

// consume '(' args ')', pushing each argument node id onto `args`
scan_args(int[] pos, int[] args) {
  advance(pos);
  fill_args(pos, args);
  advance(pos);
} return void;
given atom_tokens ([1], []):([6], [0, 1])
given atom_tokens ([19], []):([23], [0])
