// The operator-class predicates.

// `=` is included: in an expression a bare `=` means equality in id (assignment
// is detected as a statement before we get here).
is_relop(string s) {
  int ok = 0;
  if(s == "==" || s == "!=" || s == "<" || s == ">" || s == "<=" || s == ">=" || s == "=") {
    ok = 1;
  }
} return int ok;
("=="):(1)
("+"):(0)

is_addop(string s) {
  int ok = 0;
  if(s == "+" || s == "-") {
    ok = 1;
  }
} return int ok;
("+"):(1)
("*"):(0)
