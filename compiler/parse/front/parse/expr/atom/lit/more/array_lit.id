// Array literal: `[ expr (, expr)* ]` (or `[]`). Builds an "arr" node whose
// child list holds the element node ids.

parse_arr(int[] pos) {
  int[] elems = [];
  scan_list(pos, elems, "]");
  int ret_i = node_arr(elems);
} return int ret_i;
given atom_tokens ([7]):(3)
given atom_tokens ([34]):(1)

scan_list(int[] pos, int[] items, string close) {
  int sl_ln = cur_ln(pos);
  advance(pos);
  fill_list(pos, items, close);
} chain (int[] pos, int[] items, string close) {
  close_bracket(pos, close, sl_ln);
} return void;
given atom_tokens ([7], [], "]"):([14], [0, 1, 2])
given atom_tokens ([34], [], "]"):([37], [0])
given atom_tokens ([1], [], ")"):([6], [0, 1])
given atom_tokens ([19], [], ")"):([23], [0])

