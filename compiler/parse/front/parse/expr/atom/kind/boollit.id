given toks_env(["kw"], ["true"]) ([0]):(0) then calls node_bool:("true")
given toks_env(["kw"], ["false"]) ([0]):(0) then calls node_bool:("false")

parse_bool(int[] pos) {
  string text = cur_text(pos);
  advance(pos);
  int ret_i = node_bool(text);
} return int ret_i;
