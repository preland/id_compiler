// The bool literals `true` and `false`, between the float case and the rest of
// the atom chain (parse_atom -> parse_atom2 -> parse_atom_float -> here ->
// parse_atom3). Both are keywords, so they never reach the name path.

parse_atom_bool(int[] pos) {
  int node = 0;
  if(cur_kind(pos) == "kw" && (cur_text(pos) == "true" || cur_text(pos) == "false")) {
    node = parse_bool(pos);
  } else {
    node = parse_atom3(pos);
  }
} return int node;
given atom_tokens ([17]):(0)
