// `import name` (usually written `(import name)`) vs a plain identifier/call.

parse_atom3(int[] pos) {
  int node = 0;
  if(cur_text(pos) == "import") {
    node = parse_import(pos);
  } else {
    node = parse_ident_or_call(pos);
  }
} return int node;
