// Does a float literal round to infinity? Exactly, and without a bignum: a
// finite double is at most DBL_MAX, and a value rounds up to infinity when it
// reaches half an ulp past that, which is 2^1024 - 2^970. That number has 309
// digits (conf.id's flt_inf_digits), so a literal whose point falls beyond the
// 309th digit overflows, one whose point falls before it does not, and one that
// falls on it overflows when its digits, padded or cut to 309, are not below
// those. Cutting is exact: a number below the cut one is below the limit, and
// a tie goes up, because DBL_MAX's last bit is odd.

flt_over(string text) {
  string flraw = flt_lit_mant(text);
  string flds = flt_lstrip(flraw);
  int flov = 0;
} chain (string text) {
  if(len(flds) > 0) {
    int flp = flt_scale(text, flraw, flds);
    flov = flt_over_at(flp, flds);
  }
} return int flov;
("1.5"):(0)
("1e999"):(1)
("0e999"):(0)
("0.000e5"):(0)

flt_over_at(int flp, string flds) {
  int flov = 0;
  if(flp > (import flt_inf_pt)) {
    flov = 1;
  } else if(flp == (import flt_inf_pt)) {
    flov = flt_ge_max(flds);
  }
} return int flov;
(310, "1"):(1)
(308, "9"):(0)
(309, "17976931348623157081452742373170235"):(0)
(309, ""):(0)
(309, ""):(1)
(309, ""):(1)

flt_ge_max(string flds) {
  string flhead = flt_head(flds, (import flt_inf_pt));
  int flc = str_cmp(flhead, (import flt_inf_digits));
  int flge = flc >= 0;
} return int flge;
("17976931348623157081"):(0)
("9"):(1)
