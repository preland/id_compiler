// The two ways a float literal is refused (check.id decides which), and the
// test for the first: does the exponent that starts at index flj have a digit?

flt_exp_has(string text, int flj) {
  int flc = character_code_at(text, flj);
  int fldg = character_code_at(text, flj + (flc == 43 || flc == 45));
  int flok = fldg >= 48 && fldg <= 57;
} return int flok;
("1e5", 2):(1)
("1e-5", 2):(1)
("1e+", 2):(0)
("1e", 2):(0)

// A refused float literal: the code, what is wrong with it (the words after the
// literal in the message), and the why and help lines, which are constants
// (conf.id, flt_exp_* and flt_big_*) since check.id decides which one applies.
flt_bad(int[] pos, string text, string flcode, string fltail, string flwhy, string flhelp) {
  syn_diag(pos, flcode, "float literal '" + text + "'" + fltail, text, flwhy, flhelp);
} return void;
given mk_two_toks {
  ([0], "x", "E0103", " is odd", "w", "h"):() then prints:("<stdin>:1: error: float literal 'x' is odd [E0103]\n  at: x\n  why: w\n  help: h\n")
  ([0], "yy", "E0104", " is huge", "why2", "help2"):() then prints:("<stdin>:1: error: float literal 'yy' is huge [E0104]\n  at: yy\n  why: why2\n  help: help2\n")
}
