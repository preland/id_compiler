// Unary level: a prefix `-`, `!` or `~` applied to a unary (right-recursive),
// else a postfix expression. Mirrors idc.py's parse_unary, which sits between
// the multiplicative and postfix levels. So `-1` parses as a unary node and
// emits `(-1)`, and `~x` emits `(~x)`, matching idc.py.

parse_unary(int[] pos) {
  string cur_text_v = cur_text(pos);
  int node = unary_or_postfix(pos, cur_text_v);
} return int node;

fold_unary(int[] pos) {
  string op = cur_text(pos);
  advance(pos);
  int ret_i = fold_unary_tail(pos, op);
} return int ret_i;

is_unop(string s) {
  int ok = 0;
  if(s == "-" || s == "!" || s == "~") {
    ok = 1;
  }
} return int ok;
