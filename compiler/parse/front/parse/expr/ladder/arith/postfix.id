// Postfix level: a primary followed by any number of `[ expr ]` index
// suffixes (xs[i], or xs[i][j]) or `.field` suffixes (p.x, or xs[i].x). Sits
// between the multiplicative level and the primary production, matching
// idc.py's parse_postfix.

parse_postfix(int[] pos) {
  int node = parse_primary(pos);
  while(cur_text(pos) == "[" || cur_text(pos) == ".") {
    node = fold_post(pos, node);
  }
} return int node;
given atom_tokens {
  ([33]):(2)
  ([25]):(0)
}

fold_index(int[] pos, int base) {
  int fi_ln = cur_ln(pos);
  advance(pos);
  int idx = parse_expr(pos);
} chain (int[] pos, int base) {
  int ret_i = fold_index_tail(pos, base, idx, fi_ln);
} return int ret_i;
given atom_tokens {
  ([34], 50):(1)
  ([34], 99):(1)
}

fold_index_tail(int[] pos, int base, int idx, int open_ln) {
  close_bracket(pos, "]", open_ln);
  int ret_i = node_index(base, idx);
} return int ret_i;
given atom_tokens {
  ([36], 10, 20, 1):(0)
  ([36], 1, 2, 1):(0)
}
