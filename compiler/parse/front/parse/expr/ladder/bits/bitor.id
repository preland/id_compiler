// The bitwise levels of the precedence ladder. They sit *below* the
// comparisons -- tighter, not looser -- so `flags & MASK != 0` would group as
// `(flags & MASK) != 0`. C binds them the other way round, and because the two
// disagree, a comparison with an unparenthesized bitwise operand is a compile
// error (mid/types/check/expr/op/compare/cond/more/). Among themselves the
// levels follow C:
//
//   rel -> bitor(|) -> bitxor(^) -> bitand(&) -> shift(<< >>) -> add
//
// Same shape as every other level: parse the tighter level, then fold
// left-associatively, one operator per fold step.

parse_bitor(int[] pos) {
  int left = parse_bitxor(pos);
  while(cur_text(pos) == "|") {
    left = fold_bitor(pos, left);
  }
} return int left;
given expr_tokens ([10]):(2)
given expr_tokens ([8]):(4)

fold_bitor(int[] pos, int left) {
  advance(pos);
  int right = parse_bitxor(pos);
  int ret_i = node_bin("|", left, right);
} return int ret_i;
given expr_tokens ([9], 100):(3)
given expr_tokens ([11], 100):(1)

parse_bitxor(int[] pos) {
  int left = parse_bitand(pos);
  while(cur_text(pos) == "^") {
    left = fold_bitxor(pos, left);
  }
} return int left;
given expr_tokens ([10]):(2)
given expr_tokens ([8]):(0)
