// Logical-or level (lowest precedence), above and/equality. Mirrors idc.py:
// parse_expr -> parse_or -> parse_and -> parse_rel(equality+relational).

parse_or(int[] pos) {
  int left = parse_and(pos);
  while(cur_text(pos) == "||") {
    left = fold_or(pos, left);
  }
} return int left;
