// Synthetic afret/afretn state (see ../../../init/setup/fixture/toks/decl.id for the
// token-stream half) for decl/kinds/asm/'s cases that push onto them.

asm_reg_fix0() {
  env_init();
  init_asm();
  init_asm2();
} return void;
():() then calls env_init:[1]
():() then init_units:(0)

asm_reg_fix1(string arf_ty) {
  asm_reg_fix0();
  push((import afret), arf_ty);
} return void;
("int"):() then calls asm_reg_fix0:[1]
("word"):() then init_units:(0)

asm_reg_fix1b(string arf_ty, string arf_name) {
  asm_reg_fix1(arf_ty);
  push((import afretn), arf_name);
} return void;
("int", "result"):() then calls asm_reg_fix1:("int")
("word", "r"):() then init_units:(0)
