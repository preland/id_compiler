// newnode appends a full node and returns its id. newleaf is the common case
// of a node with no child lists (it supplies two empty lists).

newnode(string k, int a, int b, string s1, string s2, int[] l1, int[] l2) {
  push_kii(k, a, b);
  push_ss(s1, s2);
  int ret_i = newnode_tail(l1, l2);
} return int ret_i;
given full_env ("test", 1, 2, "a", "b", [], []):(0) then calls push_kii:("test", 1, 2) then calls push_ss:("a", "b") then calls newnode_tail:([], [])
given full_env ("call", 5, 0, "f", "", [1, 2], []):(0) then calls push_kii:("call", 5, 0) then calls push_ss:("f", "") then calls newnode_tail:([1, 2], [])

newleaf(string k, int a, int b, string s1, string s2) {
  int[] none = [];
  int ret_i = newnode(k, a, b, s1, s2, none, none);
} return int ret_i;
given full_env ("var", 0, 0, "x", ""):(0) then calls newnode:("var", 0, 0, "x", "", [], [])
given full_env ("int", 5, 0, "5", ""):(0) then calls newnode:("int", 5, 0, "5", "", [], [])

k_of(int id) {
  string ret_s = (import nkind)[id];
} return string ret_s;
given mk_two_nodes (0):("kw")
given mk_two_nodes (1):("func")
