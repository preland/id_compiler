// Whether a func node is a `native` declaration: the parser marks one with 1
// in the second int field, which an ordinary function leaves 0.
is_native(int id) {
  int ok = (import ni2)[id] == 1;
} return int ok;
given mk_list_nodes (1):(0)
given mk_two_nodes (1):(1) then last_kind:("kind func")
given mk_two_nodes (0):(0)
given mk_two_nodes (1):(1)

// The token index push_pos stamps a new node with, and the -1 it always
// gives the node's first-token slot (only a statement fills that in).
last_ntok() {
  string ret_i_t = "ntok " + (list_last((import ntok)));
} return string ret_i_t;
given mk_curtk(5) ():("ntok 5")
given mk_curtk(9) ():("ntok 9")

last_nst() {
