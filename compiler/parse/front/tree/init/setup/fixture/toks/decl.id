// A synthetic token stream for cases under decl/kinds/asm/ and decl/func/cases/:
// env_init leaves tkind/ttext empty, and nothing else builds one by hand for
// a case to walk with cur_kind/cur_text/advance (front/tokens/cursor.id).

toks_push(string[] kinds, string[] texts) {
  int i = 0;
  while(i < len(kinds)) {
    push((import tkind), kinds[i]);
    push((import ttext), texts[i]);
    i = i + 1;
  }
} return void;
given env_init {
  (["op"], ["{"]):() then len((import tkind)):(1)
  (["op", "str"], ["{", "\"a\""]):() then len((import tkind)):(2)
}

