// A hand-loaded token stream for a case to parse: the tables load() fills
// from stdin, filled by hand instead, one token per pair, so a parser
// function under test can be pointed at a chosen input without reading a
// real program through the lexer.
push_toks(string[] kinds, string[] texts) {
  int i = 0;
  while(i < len(kinds)) {
    push_real(kinds[i], texts[i]);
    i = i + 1;
  }
} return void;
