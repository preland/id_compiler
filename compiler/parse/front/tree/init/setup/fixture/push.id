// A hand-loaded token stream for a case to parse: the tables load() fills
// from stdin, filled by hand instead, one token per pair, so a parser
// function under test can be pointed at a chosen input without reading a
// real program through the lexer.
push_toks(string[] kinds, string[] texts) {
  int i = 0;
  while(i < len(kinds)) {
    push_real(kinds[i], texts[i]);
    i = i + 1;
  }
} return void;
given env_init (["ident", "op"], ["x", "("]):() then (import chkfail)[0]:(0)
given env_init (["kw"], ["int"]):() then (import chkfail)[0]:(0)

// The second int field of the most recently created node, for a case whose
// function under test returns a node id it cannot itself compare a field of
// (a `then` check takes no arguments).
last_i2() {
  string ret_i_t = "i2 " + (list_last((import ni2)));
} return string ret_i_t;
