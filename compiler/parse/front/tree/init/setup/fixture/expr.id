// A token stream covering the whole expression ladder in one pass:
// `1 + 2 * 3 << 1 & 2 | 3 ^ 4 == 5 && 6 || 7 ;` -- one operator of every
// level, left to right from the tightest (`*`) to the loosest (`||`), so a
// case can point pos at any sub-expression's start and read the rest.
expr_tokens() {
  env_init();
  push_toks(["int", "op", "int", "op", "int", "op", "int", "op", "int", "op", "int", "op", "int", "op", "int", "op", "int", "op", "int", "op", "eof"], ["1", "+", "2", "*", "3", "<<", "1", "&", "2", "|", "3", "^", "4", "==", "5", "&&", "6", "||", "7", ";", ""]);
} return void;
():() then check_failed:(0)
():() then tok_count:(21)

// A token stream covering one of each atom kind, `;`-separated so each
// starts its own parseable atom: a call, an array literal, a string, a
// float, an import read, and a unary/postfix form.
atom_tokens() {
  env_init();
  push_toks(["ident", "op", "int", "op", "int", "op", "op", "op", "int", "op", "int", "op", "int", "op", "op", "str", "op", "float", "op", "op", "kw", "ident", "op", "op", "op", "ident", "op", "op", "ident", "op", "op", "ident", "op", "ident", "op", "int", "op", "op", "eof"], ["foo", "(", "1", ",", "2", ")", ";", "[", "1", ",", "2", ",", "3", "]", ";", "\"hi\"", ";", "1.5", ";", "(", "import", "g", ")", ";", "-", "x", ";", "!", "y", ";", "~", "z", ";", "a", "[", "0", "]", ";", ""]);
} return void;
():() then check_failed:(0)
():() then tok_count:(39)

// A grouped expression: `(1 + 2);` -- the one construct neither expr_tokens
// nor atom_tokens has, for primary.id's parenthesised-primary production.
paren_tokens() {
  env_init();
  push_toks(["op", "int", "op", "int", "op", "op", "eof"], ["(", "1", "+", "2", ")", ";", ""]);
} return void;
():() then check_failed:(0)
():() then tok_count:(7)
