// Symbol tables for the type pass, plus the exported-variable table.
// A name has one type within a compilation unit, so one global table keyed by
// name and unit suffices:
//   vnames/vtypes/vunit  every parameter and local declaration, and the unit
//                  it was declared in
//   fnames/frets   every function and its return type
//   fnodes         the function's node id, so a call can reach its parameter
//                  list; -1 for an asm function, which has no node
//   enames/etypes/eowners  each exported variable, its type, and owner function

init_sym() {
  init_sym_a();
  init_sym_b();
  init_asm_all();
} chain () {
  esc_init();
  init_structs();
  lp_reset();
} return void;
given full_env ():() then calls init_sym_a:[1]
given full_env ():() then init_units:(0)

// fnames: How many functions are registered -- a `then` check for the void
// functions above, which otherwise leave no result to compare.
init_sym_a() {
  export string[] fnames = [];
  export string[] frets = [];
  export string[] enames = [];
} return void;
given full_env ():() then (import chkfail)[0]:(0)
given full_env ():() then init_units:(0)

// eowners: The owner recorded for each exported name, pushed by add_export
// (../collect/add.id) in step with enames and etypes. dead_err
// (dead/more/report.id) is what reads it back, and add_export returns void,
// so only a reader of one of its columns can see the push that filled it.
// etypes: One entry per exported name, pushed by add_export (../add.id) in step with
// enames and eowners. add_export returns void and the table it builds is what
// the later checks read, so only a reader of one of its columns can see the
// push happen; dead_exp_fixture (../../reach/dead/more/add.id) adds two.
init_sym_b() {
  export string[] etypes = [];
  export string[] eowners = [];
  export int[] fnodes = [];
} return void;
given full_env ():() then (import chkfail)[0]:(0)
given full_env ():() then init_units:(0)
