// Remaining exported state: the second string field, the two child-list
// fields, the top-level program list, and the symbol tables for the type pass.

init_rest() {
  init_c();
  init_d();
  init_sym();
} return void;
given full_env ():() then check_failed:(0)
given full_env ():() then init_units:(0)

init_c() {
  export string[] ns2 = [];
  export int[][] nl1 = [];
  export int[][] nl2 = [];
} return void;
given full_env ():() then check_failed:(0)
given full_env ():() then init_units:(0)

init_d() {
  export int[] prog = [];
  export string[] vnames = [];
  export string[] vtypes = [];
} return void;
given full_env ():() then check_failed:(0)
given full_env ():() then init_units:(0)
