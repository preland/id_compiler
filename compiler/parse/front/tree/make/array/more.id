// The tail of array.id's node_iassign -- that file is already full.

node_iassign_tail(int target, int[] vlist, int[] none) {
  int i1_of_v = i1_of(target);
  int i2_of_v = i2_of(target);
  int ret_i = newnode("iassign", i1_of_v, i2_of_v, "", "", vlist, none);
} return int ret_i;
given mk_two_nodes (0, [5], []):(2) then calls newnode:("iassign", 1, 0, "", "", [5], [])
given mk_two_nodes (1, [6], []):(2) then calls newnode:("iassign", 2, 1, "", "", [6], [])

// Two ordinary leaves, id 0 ("kw" 1/0 "if"/"") and id 1 ("func" 2/1 "y"/"z"),
// for the field accessors' and last_kind/last_s1's own cases.
mk_two_nodes() {
  full_env();
  newleaf("kw", 1, 0, "if", "");
  newleaf("func", 2, 1, "y", "z");
} return void;
():() then last_kind:("func")
():() then check_failed:(0)

// Two "arr" nodes with real child lists, for l1_of/l2_of and last_l1's cases.
mk_list_nodes() {
  full_env();
  newnode("arr", 0, 0, "", "", [7, 8], [9]);
  newnode("arr", 0, 0, "", "", [3], [9, 10]);
} return void;
():() then last_kind:("arr")
