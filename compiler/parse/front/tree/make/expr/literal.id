// Leaf constructors, one per shape of leaf, not one per kind of leaf: a kind is
// the first argument. Two constructors that differ only in the kind word they
// pass to newleaf are one constructor written twice (docs/ERRORS.md, E0407).
//
// node_txt: a leaf that is its text alone -- var ("x"), str, import (`(import
// name)` reads an exported global; it emits as just the name, so it reuses the
// var shape with kind "import").
node_txt(string kind, string text) {
  int ret_i = newleaf(kind, 0, 0, text, "");
} return int ret_i;
given full_env ("var", "x"):(0) then calls newleaf:("var", 0, 0, "x", "")
given full_env ("str", "hi"):(0) then calls newleaf:("str", 0, 0, "hi", "")
given full_env ("import", "foo"):(0) then calls newleaf:("import", 0, 0, "foo", "")

// node_txt1: text and one operand -- an assignment (ns1 = the name, ni1 = the
// expression) and a unary operator (ns1 = "-" or "!", ni1 = the operand).
node_txt1(string kind, string text, int operand) {
  int ret_i = newleaf(kind, operand, 0, text, "");
} return int ret_i;
given full_env ("assign", "x", 5):(0) then calls newleaf:("assign", 5, 0, "x", "")
given full_env ("un", "-", 3):(0) then calls newleaf:("un", 3, 0, "-", "")
given full_env ("un", "!", 5):(0) then calls newleaf:("un", 5, 0, "!", "")

// node_txt2: text and two integers -- an int literal (ni1 = the value, for the
// AST dump; ni2 = 1 when the literal is too wide for an int; ns1 = the digits
// as written, since C emission prints those verbatim and a 64-bit literal cannot
// survive the trip through an int) and a binary operator (ni1, ni2 = its
// operands, ns1 = the operator).
node_txt2(string kind, string text, int first, int second) {
  int ret_i = newleaf(kind, first, second, text, "");
} return int ret_i;
given full_env ("int", "5", 5, 0):(0) then calls newleaf:("int", 5, 0, "5", "")
given full_env ("int", "99999999999999999999", 0, 1):(0) then calls newleaf:("int", 0, 1, "99999999999999999999", "")
given full_env ("bin", "+", 1, 2):(0) then calls newleaf:("bin", 1, 2, "+", "")
given full_env ("bin", "*", 3, 4):(0) then calls newleaf:("bin", 3, 4, "*", "")
