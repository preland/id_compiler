// `(import name)` reads an exported global. It emits as just the name (the C
// global), so it reuses the var node shape with kind "import".

node_import(string name) {
  int ret_i = newleaf("import", 0, 0, name, "");
} return int ret_i;
given full_env ("foo"):(0) then calls newleaf:("import", 0, 0, "foo", "")
given full_env ("bar"):(0) then calls newleaf:("import", 0, 0, "bar", "")

// The float leaf: like the str leaf, its raw source text (e.g. "0.8") is kept
// verbatim in ns1, since idc.py's C emitter prints a float literal's spelling
// unchanged.
node_float(string text) {
  int ret_i = newleaf("float", 0, 0, text, "");
} return int ret_i;
given full_env ("0.8"):(0) then calls newleaf:("float", 0, 0, "0.8", "")
given full_env ("3.14"):(0) then calls newleaf:("float", 0, 0, "3.14", "")

// The kind word of the most recently loaded real token, for push_real/push_tok
// and split_line.id's proc_line -- none of them return or mutate an argument
// a case can read directly.
last_tkind() {
  int i = len((import tkind)) - 1;
  string ret_s = (import tkind)[i];
} return string ret_s;
given mk_two_toks ():("kw")
given mk_three_toks ():("ident")
