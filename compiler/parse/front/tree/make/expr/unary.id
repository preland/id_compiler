// curtk[0] set to a chosen token index, then push_pos() run once so both a
// direct case of push_pos and last_ntok/last_nst's own cases can read the
// entry it left behind.
mk_curtk(int mk_tk) {
  full_env();
  integer_list_set((import curtk), 0, mk_tk);
  push_pos();
} return void;
(5):() then last_ntok:("ntok 5")
(9):() then last_ntok:("ntok 9")
(5):() then last_nst:("nst -1")
