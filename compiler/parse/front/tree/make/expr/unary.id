// Unary-operator node: ns1 = op ("-" or "!"), ni1 = operand expr id.

node_un(string op, int operand) {
  int ret_i = newleaf("un", operand, 0, op, "");
} return int ret_i;

// `-1`: a unary minus (id 1) wrapping a literal (id 0), for
// cases/more/lit/kinds.id's neg_lit.
fixture_neg_lit_node() {
  env_init();
  node_int("1", 1, 0);
  node_un("-", 0);
} return void;
