// Two plain int leaves in one list, for acc_elems' own cases
// (check/access/expr/walk.id) -- a call's or a var's argument list would also
// dispatch into the registry reads acc_var/acc_callee need, and env_init alone
// is not enough for those. Filed here because every file under
// check/access/expr/ is at the 3-function cap and this was the only one left
// with room.
elems_fixture() {
  env_init();
  export int elems_e1 = node_int("1", 1, 0);
  export int elems_e2 = node_int("2", 2, 0);
} chain () {
  export int[] elems_two = [(import elems_e1), (import elems_e2)];
} return void;
