// Both indexes get their buckets in one loop: they are the same size and are
// built at the same moment, and two loops would be the same loop twice.
push_buckets() {
  int[] new_bucket_v = new_bucket();
  push((import vidx), new_bucket_v);
  push_fbucket();
} return void;
