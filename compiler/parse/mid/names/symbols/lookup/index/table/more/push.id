// The two-push tail of vidx_add, fidx_add and didx_add, split out so each of
// those blocks stays within the action limit. The three differ only in which
// pair of tables they push to, which is exactly the kind of difference the
// duplicate-logic rule counts.

vidx_push(int bucket_slot, int didx_len, string name) {
  push((import vidx)[bucket_slot], didx_len);
  push((import vnames), name);
} return void;
given call2_setup (0, 0, "newv"):() then len((import vnames)):(1)
given fcall_reg_b (0, 1, "newv2"):() then len((import vnames)):(2)

fidx_push(int bucket_slot, int didx_len, string name) {
  push((import fidx)[bucket_slot], didx_len);
  push((import fnames), name);
} return void;
given call2_setup (0, 0, "newf"):() then len((import fnames)):(1)
given argfn_d (0, 1, "newf2"):() then len((import fnames)):(2)

didx_push(int bucket_slot, int didx_len, string name) {
  push((import didx)[bucket_slot], didx_len);
  push((import dvname), name);
} return void;
given regrow_c (0, 0, "y"):() then len((import dvname)):(1)
given regrow_d (0, 1, "z"):() then len((import dvname)):(2)
