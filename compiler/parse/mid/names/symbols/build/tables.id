// Build the symbol tables by scanning every AST node once: declarations and
// parameters give variable types; functions give return types.

build_syms() {
  init_idx();
  int i = 0;
  while(i < len((import nkind))) {
    sym_one(i);
    i = i + 1;
  }
} return void;
given fn_idx_fixture ():() then len((import fnames)):(2)
given elif_fixture ():() then len((import fnames)):(0)

sym_one(int id) {
  if(str_in((import declkinds), (import nkind)[id])) {
    string s2_of_v = (import ns2)[id];
    string s1_of_v = (import ns1)[id];
    add_var(s2_of_v, s1_of_v, (import nunit)[id]);
  } else {
    sym_func(id);
  }
} return void;
given fn_idx_fixture ((import fixture_fn)):() then len((import fnames)):(2)
given farm_a ((import f_pa)):() then len((import vnames)):(1)

