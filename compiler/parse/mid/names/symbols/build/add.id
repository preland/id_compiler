// Record a function's return type, and the two table-append helpers.

sym_func(int id) {
  if((import nkind)[id] == "func") {
    string s1_of_v = (import ns1)[id];
    string s2_of_v = (import ns2)[id];
    add_func(s1_of_v, s2_of_v, id);
  }
} return void;
given fn_idx_fixture ((import fixture_fn)):() then len((import fnames)):(2)
given fn_idx_fixture ((import fixture_zero)):() then len((import fnames)):(1)

// The unit comes along because the table is keyed by it: a name may be an int
// in the program and a string in an imported library, and a lookup has to know
// which of the two it is asking about.
add_var(string name, string type, int unit) {
  push((import vtypes), type);
  push((import vunit), unit);
  vidx_add(name);
} return void;
given call2_setup ("newv", "int", 0):() then len((import vnames)):(1)
given fcall_reg_b ("newv2", "int", 0):() then len((import vnames)):(2)

// The node id comes along so that a call site can reach the parameter list
// and the return clause: a name and a return type answer "what does this
// evaluate to", which is all the emitter ever needed, but not "may it be
// called like that".
add_func(string name, string ret, int id) {
  push((import frets), ret);
  push((import fnodes), id);
  fidx_add(name);
} return void;
given call2_setup ("newf", "int", 0):() then len((import fnames)):(1)
given argfn_d ("newf2", "int", 0):() then len((import fnames)):(2)
