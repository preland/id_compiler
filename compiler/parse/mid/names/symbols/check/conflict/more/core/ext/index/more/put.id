// A record is one tab-separated line, and a tag with nothing after it is not
// written: a function that reaches nothing has no D record.

ixw_put(string[] ixw_cols) {
  string ixw_tab = chr(9);
  string ixw_line = string_join(ixw_cols, ixw_tab);
  print(ixw_line);
} return void;
(["F", "f", "1"]):() then prints:("F\tf\t1\n")
(["@"]):() then prints:("@\n")

ixw_tag(string ixw_tag_name, string ixw_text) {
  if(ixw_text != "") {
    ixw_put([ixw_tag_name, ixw_text]);
  }
} return void;
("D", "a b"):() then prints:("D\ta b\n")
("V", "x int"):() then prints:("V\tx int\n")
("D", ""):() then prints:("")

// What main does up to its checks, over the token text on the case's stdin:
// the tables the index reads exist only after the whole pipeline has run.
ixw_fx() {
  full_env();
  load();
  int[] ixw_pos = [0];
} chain () {
  parse_program(ixw_pos);
  build_syms();
  collect_exports();
} chain () {
  arg_setup(1, ["prog"]);
  check_program();
} return void;
stdin "file 0|x.id\nident fa\nop (\nkw int\nident a\nop )\nop {\nline 2\nkw int\nident s\nop =\nident a\nop +\nint 1\nop ;\nline 3\nop }\nkw return\nkw int\nident s\nop ;\nline 4\neof\n" ():() then len((import prog)):(1)
stdin "file 0|x.id\neof\n" ():() then len((import prog)):(0)
