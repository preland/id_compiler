// The V line: a variable the library declares, one per name (bin/idc's
// std_index_assemble keeps the first). std_var_pass compares the program's
// variables against these, so a name the program shares with a function the
// build did not load still has the library's type.

ext_route4(string xe_tag, string[] xe_f) {
  if(xe_tag == "M") {
    integer_list_set((import ext_mode), 0, 1);
  } else if(xe_tag == "V") {
    ext_put_var(xe_f);
  }
} return void;
given env_init {
  ("M", ["M"]):() then (import ext_mode)[0]:(1)
  ("V", ["V", "n", "int", "a.id", "3"]):() then len((import ext_vt)):(1)
}

ext_put_var(string[] xe_f) {
  push((import ext_vt), xe_f[2]);
  push((import ext_vf), xe_f[3]);
  int xe_vln = to_int(xe_f[4]);
} chain (string[] xe_f) {
  push((import ext_vl), xe_vln);
  int xe_vrow = len((import ext_vt)) - 1;
  hash_map_put((import ext_mk), (import ext_mv), (import ext_mu), (import ext_mc), "v:" + xe_f[1], xe_vrow);
} return void;
given env_init {
  (["V", "n", "string", "a.id", "3"]):() then (import ext_vt)[0]:("string")
  (["V", "n", "string", "a.id", "3"]):() then (import ext_vf)[0]:("a.id")
  given ext_line("V\tm\tint\tb.id\t5") (["V", "n", "word", "c.id", "9"]):() then (import ext_vl)[1]:(9)
}
