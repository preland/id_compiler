// The place of an AST node: the function it belongs to, and its line there
// (tc_loc makes the same place with `: error: ` after it).
tc_at(int dgn_node) {
  string dgn_node_fn = node_fn(dgn_node);
  int dgn_node_line = tc_line(dgn_node);
  string dgn_node_loc = diag_fn_loc(dgn_node_fn, dgn_node_line);
} return string dgn_node_loc;
