// A lazy build leaves the library's cases to the library's own build, so
// a library function it loaded has none and owes none.
ext_exempt(int xe_i) {
  int xe_ex = 0;
  int xe_unit = (import nunit)[((import prog)[xe_i])];
  if((import ext_mode)[0] == 1 && (import stdunit)[0] >= 0 && xe_unit >= (import stdunit)[0]) {
    xe_ex = 1;
  }
} return int xe_ex;
