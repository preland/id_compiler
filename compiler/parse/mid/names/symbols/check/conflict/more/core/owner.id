
report_var_type(string name, string type, string prev, string owner, int ln) {
  string loc_at_v = loc_at(owner, ln);
  print(loc_at_v + "variable '" + name + "' is declared " + type + " here but " + prev + " elsewhere; a name must keep one type across the whole program");
  note_failure();
} return void;
given regrow_d ("x", "string", "int", "f", 10):() then check_failed:(1)
given regrow_d ("y", "word", "float", "f", 10):() then check_failed:(1)

// The function that exported `name`, from the table collect_exports built.
export_owner(string name) {
  string ret_s = (import eowners)[find_str((import enames), name)];
} return string ret_s;
given call2_setup ("clist"):("conf.id")
given call2_scalar_setup ("cscalar"):("conf.id")

// The function a name belongs to: the first one to declare it, which is what
// idc.py's var_owner records and what its diagnostics name.
owner_of(string name) {
  int i = 0;
  string s = "";
  while(i < len((import dvname))) {
    s = owner_at(i, name, s);
    i = i + 1;
  }
} return string s;
given regrow_d ("x"):("f")
given regrow_d ("y"):("")
