
report_var_type(string name, string type, string prev, string owner, int ln) {
  string type_where = diag_fn_loc(owner, ln);
  string type_msg = "variable '" + name + "' is declared " + type + " here but " + prev + " elsewhere";
  diag("E0303", type_where, type_msg, name, "a name must keep one type across the whole program, so that one name always means one kind of value wherever it appears", "rename this variable so that it differs from the other one, or declare both with the same type");
} chain (string name, string type, string prev, string owner, int ln) {
  string type_first = owner_of(name);
  int type_first_ln = decl_line(name, type_first);
  diag_related(diag_fn_loc(type_first, type_first_ln), "the other declaration, which is " + prev);
} return void;
given regrow_d ("x", "string", "int", "g", 20):() then prints:("<stdin>:20: error: variable 'x' is declared string here but int elsewhere [E0303]\n  at: x\n  why: a name must keep one type across the whole program, so that one name always means one kind of value wherever it appears\n  help: rename this variable so that it differs from the other one, or declare both with the same type\n  related: <stdin>:10: note: the other declaration, which is int\n") then (import chkfail)[0]:(1)
given regrow_d ("x", "word", "float", "f", 10):() then prints:("<stdin>:10: error: variable 'x' is declared word here but float elsewhere [E0303]\n  at: x\n  why: a name must keep one type across the whole program, so that one name always means one kind of value wherever it appears\n  help: rename this variable so that it differs from the other one, or declare both with the same type\n  related: <stdin>:10: note: the other declaration, which is float\n") then (import chkfail)[0]:(1)

// The function that exported `name`, from the table collect_exports built.
export_owner(string name) {
  string ret_s = (import eowners)[find_str((import enames), name)];
} return string ret_s;
given call2_setup ("clist"):("conf.id")
given call2_scalar_setup ("cscalar"):("conf.id")

// The function a name belongs to: the first one to declare it, which is what
// idc.py's var_owner records and what its diagnostics name.
owner_of(string name) {
  int i = 0;
  string s = "";
  while(i < len((import dvname))) {
    s = owner_at(i, name, s);
    i = i + 1;
  }
} return string s;
given regrow_d ("x"):("f")
given regrow_d ("y"):("")
