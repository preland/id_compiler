// The parts of the import-duplicate diagnostic that do not depend on where the
// two functions are: the sentence and the
// imports that differ. imd_msg and imd_vals (../../../checks/impdup/scan/more/
// report/) build on them for two functions of the program; ext_imd_later and
// ext_imd_first for one of the library's.

imd_sentence(string imd_nx, string imd_ydef, string imd_vs) {
  string ret_s = "function '" + imd_nx + "' and " + imd_ydef + " differ only in the imported value they read (" + imd_vs + ")";
} return string ret_s;
("f", "'g' (defined at a.id:1)", "V"):("function 'f' and 'g' (defined at a.id:1) differ only in the imported value they read (V)")
("p", "'q' (defined at b.id:7)", "W"):("function 'p' and 'q' (defined at b.id:7) differ only in the imported value they read (W)")

imd_vals_of(string imd_va, string imd_vb) {
  string[] imd_xa = str_split(imd_va, ",");
  string[] imd_xb = str_split(imd_vb, ",");
  int imd_k = imd_first(imd_xa, imd_xb);
} chain (string imd_va, string imd_vb) {
  string ret_s = "(import " + imd_xa[imd_k] + ") in one, (import " + imd_xb[imd_k] + ") in the other";
} return string ret_s;
("a,b", "a,c"):("(import b) in one, (import c) in the other")
("x", "y"):("(import x) in one, (import y) in the other")
