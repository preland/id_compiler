// Which library declaration a program row is compared with: a loaded one
// first, then the index's.

sv_find(int sv_r) {
  int sv_j = sv_std_row((import dvname)[sv_r]);
  if(sv_j >= 0) {
    sv_loaded(sv_r, sv_j);
  } else {
    sv_ext(sv_r);
  }
} return void;
given sv_fx("string") (0):() then calls sv_loaded:(0, 1)
given sv_xfx("string") (0):() then calls sv_ext:(0)

// The first row of a library unit that declares `sv_nm`, or -1.
sv_std_row(string sv_nm) {
  int[] sv_bk = (import didx)[name_bucket(sv_nm)];
  int sv_hit = sv_scan(sv_bk, sv_nm, 0, 0 - 1);
} return int sv_hit;
given sv_fx("int") ("x"):(1)
given sv_fx("int") ("zz"):(-1)

sv_scan(int[] sv_bk, string sv_nm, int sv_k, int sv_hit) {
  while(sv_k < len(sv_bk)) {
    sv_hit = sv_pick(sv_bk[sv_k], sv_nm, sv_hit);
    sv_k = sv_k + 1;
  }
} return int sv_hit;
given sv_fx("int") ([0, 1], "x", 0, -1):(1)
given sv_fx("int") ([0], "x", 0, -1):(-1)
