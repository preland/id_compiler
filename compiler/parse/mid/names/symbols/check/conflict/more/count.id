// Count how many functions in the program have a given name.
// Used to suppress "declared twice" errors when the containing function
// is actually a duplicate function name, since the root cause is the
// duplicate function definition which is already reported.

fn_count(string fname) {
  int i = 0;
  int n = 0;
  while(i < len((import prog))) {
    n = fn_count_at(i, fname, n);
    i = i + 1;
  }
} return int n;
given fncount_setup ("g"):(1)
given fncount_setup ("nope"):(0)

// Asked only once a declaration already collides, so the scan over every
// function is paid by the rare repeated name rather than by every declaration.
// A repeat inside a function whose name is defined twice is the two definitions
// sharing one owner, not a repeat, and is left to the checks that follow.
reg_twice(string name, string type, string owner, int exported, int ln, int unit) {
  if(fn_count(owner) < 2) {
    report_var_twice(name, owner, ln);
  } else {
    reg_report3(name, type, owner, exported, ln, unit);
  }
} return void;
given fncount_setup ("x", "int", "g", 0, 10, 0):() then calls report_var_twice:("x", "g", 10)
given fncount_setup ("x", "int", "nope", 0, 10, 0):() then calls report_var_twice:("x", "nope", 10)

fn_count_at(int i, string fname, int n) {
  int r = n;
  if(s1_of((import prog)[i]) == fname) {
    r = n + 1;
  }
} return int r;
given fncount_setup (0, "g", 0):(1)
given fncount_setup (0, "nope", 0):(0)
