// `idparse --index`: what bin/idc keeps of a library so a build can load only
// the functions it reaches and still check the program against all of them.
// After every check has run, one tab-separated record per line, behind a
// marker line so the diagnostics the checks printed before it can be dropped:
//
//   @ PATH               the file the records below belong to
//   F NAME KIND LINE END a function (f), native (n) or struct (s), the line its
//                        name is on and the line its return clause ends on
//   P KEY FINGERPRINT    one per fingerprint segment, in order, of the F above
//   I KEY NAMES          its import-duplicate text's key and the import names
//   D NAMES              the names its body reaches: calls, function values,
//                        exports it imports, types it declares
//   C NAMES              the same for its cases
//   X OWNER NAME TYPE    an export the function OWNER declares
//   V OWNER NAME TYPE    a variable it declares
//   Z WHY                the index cannot be trusted: syntax or asm
//
// Nothing here changes what a build does; it only reads the tables the checks
// built.

ixw_print() {
  ixw_begin();
  print("/* ---- index ---- */");
  ixw_funcs();
} chain () {
  ixw_structs();
  ixw_exports();
  ixw_vars();
} chain () {
  ixw_flags();
} return void;
given ixw_fx stdin "file 0|x.id\nline 1\nident fa\nop (\nkw int\nident a\nop )\nop {\nline 2\nkw int\nident s\nop =\nident a\nop +\nint 1\nop ;\nline 3\nop }\nkw return\nkw int\nident s\nop ;\nline 4\neof\n" ():() then prints:("/* ---- index ---- */\n@\tx.id\nF\tfa\tf\t1\t3\nP\t36:-26173762752150447:4987494224040662966\t|(int 0)->int=>v1{d:int 1=b+(v0,I1)}\nD\tint\nV\tfa\ta\tint\nV\tfa\ts\tint\n")
given ixw_fx stdin "file 0|x.id\nline 1\nident fa\nop (\nkw int\nident a\nop )\nop {\nline 2\nkw int\nident s\nop =\nident a\nop +\nint 1\nop ;\nline 3\nop }\nkw return\nkw int\nident s\nop ;\nline 4\nop (\nint 1\nop )\nop :\nop (\nint 2\nop )\nline 5\nop (\nint 2\nop )\nop :\nop (\nint 3\nop )\nline 6\nline 7\nident fb\nop (\nkw int\nident b\nop )\nop {\nline 8\nkw int\nident t\nop =\nident fa\nop (\nident b\nop )\nop ;\nline 9\nkw int\nident u\nop =\nident t\nop +\nop (\nkw import\nident gx\nop )\nop ;\nline 10\nop }\nkw return\nkw int\nident u\nop ;\nline 11\nkw given\nident fa_setup\nop (\nint 1\nop )\nop :\nop (\nint 4\nop )\nline 12\nline 13\nident fa_setup\nop (\nop )\nop {\nline 14\nkw export\nkw int\nident gx\nop =\nint 3\nop ;\nline 15\nop }\nkw return\nkw void\nop ;\nline 16\neof\n" ():() then prints:("/* ---- index ---- */\n@\tx.id\nF\tfa\tf\t1\t3\nP\t36:-26173762752150447:4987494224040662966\t|(int 0)->int=>v1{d:int 1=b+(v0,I1)}\nD\tint\nF\tfb\tf\t7\t10\nP\t57:-2640773998179882632:7831248051046639341\tgx|(int 0)->int=>v1{d:int 2=c(fa:v0);d:int 1=b+(v2,g(0))}\nI\t57:-5940529621038374376:3617102361143808501\tgx\nD\tint fa gx\nC\tfa_setup\nF\tfa_setup\tf\t13\t15\nP\t29:-7199948939538576421:-2748663230870663910\t|()->void=>void{ed:int gx=I3}\nD\tint void\nX\tfa_setup\tgx\tint\nV\tfa\ta\tint\nV\tfa\ts\tint\nV\tfb\tb\tint\nV\tfb\tt\tint\nV\tfb\tu\tint\n")

ixw_begin() {
  export int[] ixw_c = [0, 0, 0, 0];
  export string[] ixw_file_cell = [""];
  int ixw_base_v = const_base();
} chain () {
  lset((import ixw_c), 0, ixw_base_v);
} return void;
given cvl_setup ():() then (import ixw_c)[0]:(8)
given lc_dce_init ():() then (import ixw_c)[0]:(0)

ixw_flags() {
  if((import synfail)[0] != 0) {
    ixw_put(["Z", "syntax"]);
  }
  if(len((import afname)) > 0) {
    ixw_put(["Z", "asm"]);
  }
} return void;
