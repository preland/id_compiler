} chain (int dgn_row, int dgn_have) {
  string dgn_text = case_skeleton(dgn_np, 2 - dgn_have, dgn_rt);
  if(dgn_have < 2) {
    diag_edit("placeholder", "after-function", (import pline)[dgn_row], "", dgn_text);
  }
} return void;
