// A syntax diagnostic is a diagnostic at the token the parser is looking at, and
// it marks the syntax as broken: nothing may be rewritten from the tree after it
// (synfail, ../../../../../../../../../front/tokens/load/more/pos/stamp.id), the
// same two effects syn_err_tail has for a diagnostic not yet moved to the record.

syn_diag(int[] pos, string dgn_code, string dgn_msg, string dgn_at, string dgn_why, string dgn_help) {
  string dgn_sfile = cur_file();
  int dgn_sline = cur_ln(pos);
  string dgn_sloc = dgn_sfile + ":" + dgn_sline;
} chain (int[] pos, string dgn_code, string dgn_msg, string dgn_at, string dgn_why, string dgn_help) {
  diag(dgn_code, dgn_sloc, dgn_msg, dgn_at, dgn_why, dgn_help);
  integer_list_set((import synfail), 0, 1);
} return void;
given mk_two_toks {
  ([0], "E0099", "bad", "x", "because", "do this"):() then prints:("<stdin>:1: error: bad [E0099]\n  at: x\n  why: because\n  help: do this\n") then (import synfail)[0]:(1)
  ([1], "E0098", "worse", "", "", ""):() then prints:("<stdin>:1: error: worse [E0098]\n") then (import chkfail)[0]:(1)
}

// `expected 'X', found 'Y'`: the parser needed one token and met another.
// What is wrong is almost never at the token it names -- an unclosed bracket or
// a missing `;` is noticed one token late -- so the help sends the reader to the
// line before.
syn_expected(int[] pos, string dgn_want, string dgn_found) {
  string dgn_ewhy = "the grammar needs '" + dgn_want + "' here to finish what it was reading, so the construct before this point is incomplete or mistyped";
  string dgn_ehelp = "put '" + dgn_want + "' where it belongs; if it looks right, check the line before for a missing ';', ')' or '}', because those are noticed one token late";
  syn_diag(pos, "E0101", "expected '" + dgn_want + "', found '" + dgn_found + "'", dgn_found, dgn_ewhy, dgn_ehelp);
} return void;
given mk_two_toks {
  ([1], "=", "return"):() then prints:("<stdin>:1: error: expected '=', found 'return' [E0101]\n  at: return\n  why: the grammar needs '=' here to finish what it was reading, so the construct before this point is incomplete or mistyped\n  help: put '=' where it belongs; if it looks right, check the line before for a missing ';', ')' or '}', because those are noticed one token late\n")
  ([0], ";", ""):() then prints:("<stdin>:1: error: expected ';', found '' [E0101]\n  why: the grammar needs ';' here to finish what it was reading, so the construct before this point is incomplete or mistyped\n  help: put ';' where it belongs; if it looks right, check the line before for a missing ';', ')' or '}', because those are noticed one token late\n")
}

// An operator where an expression belongs, and the block comment the lexer folds
// into one `/*` token so that the mistake can be named.
syn_unexpected(int[] pos, string dgn_tok, string dgn_umsg) {
  string dgn_uwhy = "an operator cannot start an expression or a statement; the parser was looking for a name, a number, a string, a call or a type";
  string dgn_uhelp = "write an operand where '" + dgn_tok + "' is, or remove it; a missing operand just before it is the usual cause";
  if(dgn_tok == "/*") {
    dgn_uwhy = "id has line comments only, so a comment always ends where its line ends and can never swallow code";
    dgn_uhelp = "write // at the start of each commented line";
  }
} chain (int[] pos, string dgn_tok, string dgn_umsg) {
  if(dgn_tok == ".") {
    dgn_uwhy = "a float literal is digits, a point and digits, so it never starts with the point and an exponent cannot stand alone";
    dgn_uhelp = "write the digit before the point, as in 0.5 for .5, and put an exponent after digits, as in 0.5e3 or 1e-9";
  }
  if(dgn_tok == "#!") {
    dgn_uwhy = "a '#!' line is only a shebang, and only on line 1, so that ./script.id can run; anywhere else nothing in id starts with '#'";
    dgn_uhelp = "move the line to the top of the file, or turn it into a // comment";
  }
  syn_diag(pos, "E0102", dgn_umsg, dgn_tok, dgn_uwhy, dgn_uhelp);
} return void;
given mk_two_toks {
  ([0], "=", "unexpected token '='"):() then prints:("<stdin>:1: error: unexpected token '=' [E0102]\n  at: =\n  why: an operator cannot start an expression or a statement; the parser was looking for a name, a number, a string, a call or a type\n  help: write an operand where '=' is, or remove it; a missing operand just before it is the usual cause\n")
  ([0], "/*", "block comments are not supported; use // for a line comment"):() then prints:("<stdin>:1: error: block comments are not supported; use // for a line comment [E0102]\n  at: /*\n  why: id has line comments only, so a comment always ends where its line ends and can never swallow code\n  help: write // at the start of each commented line\n")
  ([0], ".", "unexpected token '.'; a float literal cannot start with the point"):() then prints:("<stdin>:1: error: unexpected token '.'; a float literal cannot start with the point [E0102]\n  at: .\n  why: a float literal is digits, a point and digits, so it never starts with the point and an exponent cannot stand alone\n  help: write the digit before the point, as in 0.5 for .5, and put an exponent after digits, as in 0.5e3 or 1e-9\n")
  ([0], "#!", "'#!' is only allowed as the first line of a file"):() then prints:("<stdin>:1: error: '#!' is only allowed as the first line of a file [E0102]\n  at: #!\n  why: a '#!' line is only a shebang, and only on line 1, so that ./script.id can run; anywhere else nothing in id starts with '#'\n  help: move the line to the top of the file, or turn it into a // comment\n")
}
