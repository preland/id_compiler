ixw_edges(int ixw_f) {
  int ixw_node = (import prog)[ixw_f];
  string ixw_body = ixw_refs((import ixw_c)[0], ixw_node);
  ixw_tag("D", ixw_body);
} chain (int ixw_f) {
  string ixw_cases_row = ixw_refs(ixw_node + 1, (import ixw_c)[2]);
  ixw_tag("C", ixw_cases_row);
  integer_list_set((import ixw_c), 0, (import ixw_c)[2] + 1);
} return void;
