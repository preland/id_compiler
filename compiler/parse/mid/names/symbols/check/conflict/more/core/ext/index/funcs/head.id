// The F, P and I records of a function, and its D and C records.
//
// ixw_c holds the walk's place: 0 the first node of the function being written
// (its nodes run from just past the previous function's cases through its own
// node), 1 the next case, 2 the last node any of its cases made, 3 the next
// fingerprint row.

ixw_head(int ixw_f) {
  int ixw_node = (import prog)[ixw_f];
  string ixw_kind = "f";
  if(is_native(ixw_node) == 1) {
    ixw_kind = "n";
  }
} chain (int ixw_f) {
  ixw_put(["F", (import ns1)[ixw_node], ixw_kind, "" + (import pline)[ixw_f], "" + ixw_end(ixw_f)]);
} return void;
