}

ixw_fps(int ixw_f) {
  while((import ixw_c)[3] < len((import cfp)) && (import cfpfn)[(import ixw_c)[3]] == ixw_f) {
    ixw_fp_at((import ixw_c)[3]);
    integer_list_set((import ixw_c), 3, (import ixw_c)[3] + 1);
  }
  ixw_imd(ixw_f);
} return void;
