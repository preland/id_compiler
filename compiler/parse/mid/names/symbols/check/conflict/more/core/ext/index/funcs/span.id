ixw_cases(int ixw_node) {
  while((import ixw_c)[1] < len((import casefn)) && (import casefn)[(import ixw_c)[1]] == ixw_node) {
    ixw_case((import ixw_c)[1]);
    integer_list_set((import ixw_c), 1, (import ixw_c)[1] + 1);
  }
} return void;
