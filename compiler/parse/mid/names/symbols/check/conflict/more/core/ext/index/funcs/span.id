// Where a function's cases end. A case is a node made after the nodes of its
// own arguments, so the cases of a function are the nodes between its own node
// and the highest case node it owns, and the next function's nodes begin after
// that.

ixw_span(int ixw_node) {
  integer_list_set((import ixw_c), 2, ixw_node);
  ixw_cases(ixw_node);
} return void;
