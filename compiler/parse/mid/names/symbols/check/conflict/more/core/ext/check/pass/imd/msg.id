ext_imd_later(int xe_i, int xe_k) {
  string xe_nm = (import ns1)[((import prog)[xe_i])];
  string xe_vals = imd_vals_of((import imd_tab)[xe_i * 2 + 1], (import ext_inm)[xe_k]);
  string xe_def = def_at((import ext_n)[xe_k], ext_where(xe_k));
} chain (int xe_i, int xe_k) {
  string xe_text = imd_sentence(xe_nm, xe_def, xe_vals);
  diag("E0405", (import pfile)[xe_i] + ":" + (import pline)[xe_i], xe_text, xe_nm, (import imdd_why), (import imdd_help));
  diag_related(ext_where(xe_k), "the function this one repeats");
} return void;
