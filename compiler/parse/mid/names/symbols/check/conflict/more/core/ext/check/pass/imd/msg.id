// The diagnostic of ext_imd_scan, for the program's function being the later
// of the pair and for the unloaded one being it. imd_sentence is the sentence
// imd_msg (mid/form/decomp/checks/impdup/scan/more/report/msg.id) writes.

ext_imd_pick(int xe_i, int xe_k, int xe_first) {
  if(xe_first == 1) {
    ext_imd_later(xe_i, xe_k);
  } else if(imd_find(xe_i) < 0) {
    ext_imd_first(xe_i, xe_k);
  }
} return void;
