given loopfix ((import rgwhile_node), "g"):() then calls acc_block:((import rgdeclist), "g")

acc_block(int[] stmts, string owner) {
  int keep = len((import scnames));
  acc_list(stmts, owner);
  scope_cut(keep);
} return void;
given scnames_fix ((import rgdeclist), "f"):() then calls acc_list:((import rgdeclist), "f")
given scnames_fix ([], "f"):() then calls acc_list:([], "f")

scope_cut(int keep) {
  while(len((import scnames)) > keep) {
    pop((import scnames));
  }
} return void;
