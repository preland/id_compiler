// The parts of acc_func, acc_if and acc_while moved out so each of those
// blocks stays within the action limit. Grouped here by that shared reason
// rather than split across their callers' files, all three of which were
// already at the 3-function limit.

acc_func_body(int[] l2_of_v, string s1_of_v, int id) {
  scope_func(id);
  acc_list(l2_of_v, s1_of_v);
  if((import ni1)[id] >= 0) {
    int i1_of_v = (import ni1)[id];
    string ret_owner = (import ns1)[id];
    acc_expr(i1_of_v, ret_owner, (import nline)[i1_of_v]);
  }
} return void;
given fnscope_fix ((import regrow_plist), "g2", (import regrow_fn_node)):() then calls scope_func:((import regrow_fn_node))
given fnscope_fix ([], "g2", (import regrow_fn_node)):() then calls scope_func:((import regrow_fn_node))

acc_if_body(int id, string owner) {
