// A name the function declares, used where that declaration cannot be seen.
// The storage is hoisted to the whole function, so without this the program
// compiles and reads whatever the storage holds.

report_scope(string name, string owner, int ln) {
  string scope_where = diag_fn_loc(owner, ln);
  string scope_msg_v = scope_msg(name, owner, ln);
  diag("E0307", scope_where, "variable '" + name + "' is used on line " + ln + scope_msg_v, name, "a variable exists only from its declaration to the end of the block that declares it", "declare it above this use, in a block that also holds the use, or pass the value in");
} return void;
given regrow_d {
  ("x", "f", 10):() then prints:("<stdin>:10: error: variable 'x' is used on line 10, before its declaration on line 10 [E0307]\n  at: x\n  why: a variable exists only from its declaration to the end of the block that declares it\n  help: declare it above this use, in a block that also holds the use, or pass the value in\n") then (import chkfail)[0]:(1)
  ("y", "g", 20):() then prints:("<stdin>:20: error: variable 'y' is used on line 20, outside the block that declares it on line 0 [E0307]\n  at: y\n  why: a variable exists only from its declaration to the end of the block that declares it\n  help: declare it above this use, in a block that also holds the use, or pass the value in\n") then (import chkfail)[0]:(1)
}

scope_msg(string name, string owner, int ln) {
  int dl = decl_line(name, owner);
  string msg = ", before its declaration on line " + dl;
  if(dl < ln) {
    msg = ", outside the block that declares it on line " + dl;
  }
} return string msg;
given regrow_d {
  ("x", "f", 5):(", before its declaration on line 10")
  ("x", "f", 15):(", outside the block that declares it on line 10")
}

// A function declares a name at most once, so the one matching row is it.
decl_line(string name, string owner) {
  int i = 0;
  int dl = 0;
  while(i < len((import dvname))) {
    if(dv_hit(i, name, owner) == 1) {
      dl = (import dvline)[i];
    }
    i = i + 1;
  }
} return int dl;
given regrow_d {
  ("x", "f"):(10)
  ("y", "f"):(0)
}
