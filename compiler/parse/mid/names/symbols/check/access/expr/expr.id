// Expression dispatch. Only two kinds name anything: `var` reads a variable of
// the enclosing function or names a function as a value, `import` reads an
// exported global. The rest are operators and literals, walked for the names
// underneath them.
acc_expr(int id, string owner, int ln) {
  if(k_of(id) == "var") {
    string s1_of_v = s1_of(id);
    acc_var(s1_of_v, owner, ln);
  } else {
    acc_expr2(id, owner, ln);
  }
} return void;
