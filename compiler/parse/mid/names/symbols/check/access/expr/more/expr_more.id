acc_expr4(int id, string owner, int ln) {
  if(k_of(id) == "un") {
    int i1_of_v = i1_of(id);
    acc_expr(i1_of_v, owner, ln);
  } else {
    acc_expr5(id, owner, ln);
  }
} return void;
