// Test check: the whole declared-variable name table -- how many names and
// which, joined by "|" (see vnames_state, ../../../lookup/more/std_unit.id).
dvname_state() {
  string dvs_j = str_join((import dvname), "|");
  string dvs_s = "decls " + len((import dvname)) + ":" + dvs_j;
} return string dvs_s;
