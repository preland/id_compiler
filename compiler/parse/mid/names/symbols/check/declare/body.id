// The body walk: every declaration, including those nested in an if or a
// while. A function declares a name at most once wherever the declaration
// sits, so a name declared inside a loop collides like any other; where the
// name may be used is the access pass's block scope, not this.

reg_decls(int[] stmts, string owner) {
  int i = 0;
  while(i < len(stmts)) {
    reg_stmt(stmts[i], owner);
    i = i + 1;
  }
} return void;
given ifwhilefix ((import rgdeclist), "f"):() then dvname_len:(2)
given regrow_d ([], "f"):() then dvname_len:(1)

reg_stmt(int id, string owner) {
  if(k_of(id) == "decl") {
    reg_decl_stmt(id, owner);
  } else {
    reg_nested(id, owner);
  }
} return void;
given declfix ((import rgdecl_node), "f"):() then dvname_len:(2)
given regrow_param ((import regrow_p), "f"):() then dvname_len:(1)

reg_nested(int id, string owner) {
  if(k_of(id) == "if") {
    reg_branches(id, owner);
  } else {
    reg_loop(id, owner);
  }
} return void;
given ifwhilefix ((import rgif_node), "f"):() then calls reg_branches:((import rgif_node), "f")
given whilefix ((import rgwhile_node), "f"):() then calls reg_loop:((import rgwhile_node), "f")
