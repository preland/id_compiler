// An else arm is a statement list whichever way it was written: a plain
// `else { ... }` is its statements, and an `else if` is a one-element list
// holding the next if. Walking the list therefore follows the whole chain.

reg_branches(int id, string owner) {
  int[] l1_of_v = l1_of(id);
  reg_decls(l1_of_v, owner);
  reg_l2_decls(id, owner);
} return void;
given ifwhilefix ((import rgif_node), "f"):() then dvname_len:(3)
given regrow_param ((import regrow_p), "f"):() then dvname_len:(1)

reg_loop(int id, string owner) {
  if(k_of(id) == "while") {
    int[] l1_of_v = l1_of(id);
    reg_decls(l1_of_v, owner);
  }
} return void;
given whilefix ((import rgwhile_node), "f"):() then dvname_len:(2)
given ifwhilefix ((import rgif_node), "f"):() then dvname_len:(1)

// One declaration: report whatever it conflicts with, then record it anyway.
// idc.py raises at the first conflict; recording regardless is what lets this
// checker go on to report the rest of the program's, and the row is needed by
// the access pass afterwards, which has to know the name exists somewhere.
reg_var(string name, string type, string owner, int exported, int ln, int unit) {
  reg_report(name, type, owner, exported, ln, unit);
  reg_push(name, type, owner, exported, unit);
  push((import dvline), ln);
} return void;
given regrow_d ("q", "int", "f", 0, 10, 0):() then dvname_len:(2)
given regrow_c ("q", "int", "f", 0, 10, 0):() then dvname_len:(1)
