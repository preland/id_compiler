// What to do with an unresolved name, and the message when it is an error.

is_builtin(string name) {
  int ok = 0;
  if(find_str((import bnames), name) >= 0) {
    ok = 1;
  }
} return int ok;
given init_rtc ("print"):(1)
given init_rtc ("notabuiltin"):(0)

// idc.py also offers a "did you mean the builtin 'X'?" hint here, computed
// with Python's difflib. That is not reproduced yet; the builtin list, which is
// the part that answers the question, moved from the message to the help line.
report_nosuchfn(string name, string owner, int ln) {
  string nofn_where = diag_fn_loc(owner, ln);
  string builtin_list_v = builtin_list();
  string nofn_help = "check the spelling of '" + name + "', or define it as a function; the builtins are: " + builtin_list_v + "; a function of the standard library is found only when idstd is (--std DIR or $IDSTD_HOME), and idstd/NAMES.md lists them";
} chain (string name, string owner, int ln) {
  diag("E0304", nofn_where, "no such function '" + name + "'", name, "a call names a function this program defines, a builtin, or a function of the standard library, and nothing by this name is any of them", nofn_help);
} return void;
