// idc.py also offers a "did you mean the builtin 'X'?" hint here, computed
// with Python's difflib. That is not reproduced yet, so the message is its
// text without the hint; the builtin list, which is the part that answers the
// question, is the same.
report_nosuchfn(string name, string owner, int ln) {
  string loc_at_v = loc_at(owner, ln);
  string builtin_list_v = builtin_list();
  print(loc_at_v + "no such function '" + name + "'; available builtins: " + builtin_list_v);
} chain (string name, string owner, int ln) {
  note_failure();
} return void;
