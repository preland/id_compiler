// The end of the name starting at i, and the name itself, split so that
// take_bname needs the position only once (to compute the next start) after
// asking for the slice.
bname_end(string src, int i) {
  int len_v = len(src);
  int e = find_space(src, i, len_v);
} return int e;

push_bname(string src, int i, int e) {
  string slice_v = slice(src, i, e);
  push((import bnames), slice_v);
} return void;
