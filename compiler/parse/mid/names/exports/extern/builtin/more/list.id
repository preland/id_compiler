// The comma-joined spelling the diagnostic prints. The literal it is split
// from is builtin_src, a constant in compiler/parse/conf.id.

builtin_list() {
  string s = (import bnames)[0];
  string ret_s = join_bnames(s, 1);
} return string ret_s;

join_bnames(string s, int i) {
  while(i < len((import bnames))) {
    s = s + ", " + (import bnames)[i];
    i = i + 1;
  }
} return string s;

scnames_fix() {
  ifwhilefix();
  check_access();
} return void;
():() then check_failed:(0)
():() then init_units:(0)
