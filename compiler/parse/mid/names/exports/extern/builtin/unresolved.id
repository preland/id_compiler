// Naming the composition, not just the call inside it: a call to the right
// of && only runs when the kind check already passed, and hoisting it before
// the if would run it on every node, resolved or not.
is_unresolved_call(int id) {
  int ok = 0;
  if((import nkind)[id] == "call") {
    string s1_of_v = (import ns1)[id];
    ok = unresolved_fn(s1_of_v);
  }
} return int ok;
