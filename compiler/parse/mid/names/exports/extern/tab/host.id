// The machine the build runs on, as a triple: what the test harness is built
// for, and so what an `asm` function needs a body for before a case can reach
// it. bin/idc passes it as --host-triple. Without the flag it is the build's
// own triple, which is what a hosted build's harness has always been built for.

host_init(int argc, string[] argv) {
  string host_t = arg_flag_val(argc, argv, 1, "--host-triple", "");
  if(host_t == "") {
    host_t = arg_triple(argc, argv);
  }
  export string[] hostc = [host_t];
} return void;

build_host() {
  string ret_s = (import hostc)[0];
} return string ret_s;

// Chained from arg_flags4, whose block is full.
arg_flags5(int argc, string[] argv) {
  host_init(argc, argv);
  nat_init(argc, argv);
} return void;
