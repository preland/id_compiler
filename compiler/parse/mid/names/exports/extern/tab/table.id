// The build flags the checks read, and the builtin names a call is resolved
// against. A call that resolves to no function and no builtin is an error --
// a backend's functions are declared `native` in its own source, so there is
// no build in which such a name could come from anywhere.
//
// Neither flag is a property of the source: both are decisions the driver
// makes, so they arrive as flags and live in cells.
//
//   fsc     1 when the build is freestanding (`--freestanding`): no host, so
//           no C-ABI entry point and no libc behind the runtime
//   rtc     1 when this project IS the runtime (`--runtime`), which is what
//           lets it define a function named after a runtime helper -- that is
//           the whole point of it, and the collision the check exists to stop
//           is a collision with a C runtime this build does not link
//   bnames  the builtin names, split out of one literal (see builtin/more/)

init_rtc() {
  export int[] rtc = [0];
  export int[] fsc = [0];
  init_bnames();
} return void;

rt_set(int v) {
  lset((import rtc), 0, v);
} return void;
