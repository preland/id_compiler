// Only names this program actually defines are added: a builtin and a
// link-time symbol have no body to reach into, and adding them would make the
// set grow forever on the fixpoint test. Both questions go through rfn's index
// (index.id, known.id), and the name's new position is recorded in it.
reach_add(string name) {
  if(is_reach(name) == 0 && rfx_fn(name) == 1) {
    push((import rfn), name);
    rfx_put(name, len((import rfn)) - 1);
  }
} return void;
given seed_given_fixture ("main"):() then reach_pass:(2)
given seed_given_fixture ("fx_target"):() then reach_pass:(3)

regrow_prog() {
  regrow_fn();
  push((import prog), (import regrow_fn_node));
} return void;
():() then (import chkfail)[0]:(0)
