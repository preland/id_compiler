// A lookup in rfn's index (add/index.id), believed only when rfn still holds
// the name at the position it gives.
is_reach(string name) {
  int rv = hmap_get((import rfxk), (import rfxv), (import rfxu), name, 0 - 1);
  int ok = 0;
  if(rv >= 0 && rv < len((import rfn)) && (import rfn)[rv] == name) {
    ok = 1;
  }
} return int ok;
