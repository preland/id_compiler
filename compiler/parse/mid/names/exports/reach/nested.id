// Recurse into compound statements when collecting exports.

exp_nested(int id, string owner) {
  if((import nkind)[id] == "if") {
    exp_branches(id, owner);
  } else {
    exp_loop(id, owner);
  }
} return void;
given ifwhilefix ((import rgif_node), "main"):() then calls exp_branches:[1] then calls exp_branches:((import rgif_node), "main")
given ifwhilefix ((import rgdecl_node), "main"):() then calls exp_loop:[1] then calls exp_loop:((import rgdecl_node), "main")

exp_branches(int id, string owner) {
  int[] l1_of_v = (import nl1)[id];
  exp_list(l1_of_v, owner);
  int[] l2_of_v = (import nl2)[id];
} chain (int id, string owner) {
  exp_list(l2_of_v, owner);
} return void;
given ifwhilefix ((import rgif_node), "main"):() then calls exp_list:[2] then calls exp_list:((import rgdeclist), "main")
given ifwhilefix ((import rgif_node), "other"):() then calls exp_list:[2] then calls exp_list:((import rgdeclist), "other")

exp_loop(int id, string owner) {
  if((import nkind)[id] == "while") {
    int[] l1_of_v = (import nl1)[id];
    exp_list(l1_of_v, owner);
  }
} return void;
