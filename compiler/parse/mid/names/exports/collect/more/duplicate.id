// A `} return void export NAME;` clause is a claim that the function exports NAME in
// its own body, and the function's exports are all collected by now (exp_list),
// so the claim is checked here: NAME must be exported, and by this function.
chk_retexp(int id) {
  string cr_nm = fn_ret_export(id);
  int cr_ek = find_str((import enames), cr_nm);
  if(cr_nm != "" && (cr_ek < 0 || (import eowners)[cr_ek] != (import ns1)[id])) {
    retexp_err(id, cr_nm);
  }
} return void;
