// resv_names, split out of resv_names_src (compiler/parse/conf.id) the way
// init_bnames splits builtin_src into bnames
// (../../extern/builtin/more/names.id) -- bname_end is reused rather than
// walked again here, since it only finds the next space and is not tied to
// bnames at all.

take_name(string src, int i, string[] tn_dst) {
  int e = bname_end(src, i);
  push_slice(tn_dst, src, i, e);
  int ret_i = e + 1;
} return int ret_i;
given init_resv_names ("ab cd", 0, (import resv_names)):(3)
given init_rtc ("print input", 0, (import bnames)):(6)
given init_resv_names ("cd", 0, (import resv_names)):(3)
given init_rtc ("print input read_all", 6, (import bnames)):(12)

// src[i..e] pushed onto a list: what push_resv_name and push_bname
// (../../extern/builtin/more/type.id) do, each onto its own table.
push_slice(string[] ps_dst, string ps_src, int ps_i, int ps_e) {
  string ps_cut = slice(ps_src, ps_i, ps_e);
  push(ps_dst, ps_cut);
} return void;
(["a"], "xyz", 0, 2):(["a", "xy"])
([], "wxyz", 2, 4):(["yz"])

// The export a function's `} return void export NAME;` clause names, or "" for a
// function without one: the func node's second int field is 2 plus the name's
// position in retexp (front/parse/decl/func/sig/params/seal.id's retexp_bind).
// Filed here because add.id's directory lane has no room for a third file.
fn_ret_export(int fnode) {
  string re_nm = "";
  if((import ni2)[fnode] >= 2) {
    re_nm = (import retexp)[((import ni2)[fnode] - 2)];
  }
} return string re_nm;
