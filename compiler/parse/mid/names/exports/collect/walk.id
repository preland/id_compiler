// Collect exported variables (with their owning function) by scanning each
// function's body, like hoisting but recording exports rather than locals.

collect_exports() {
  int i = 0;
  while(i < len((import prog))) {
    scan_func_exports((import prog)[i]);
    i = i + 1;
  }
} return void;
given fn_fixture ():() then calls scan_func_exports:((import fixture_fn))
given cvl_setup ():() then calls scan_func_exports:((import cvf_main))
given fn_fixture ():() then calls scan_func_exports:[1]
given env_init ():() then calls scan_func_exports:[0]

scan_func_exports(int id) {
  int[] l2_of_v = (import nl2)[id];
  string s1_of_v = (import ns1)[id];
  exp_list(l2_of_v, s1_of_v);
} chain (int id) {
  chk_retexp(id);
} return void;
given lz_j ((import lz_func2)):() then calls exp_one:[1] then calls chk_retexp:((import lz_func2))
given ifwhilefix ((import rgif_node)):() then calls exp_one:[1] then calls chk_retexp:((import rgif_node))

exp_list(int[] stmts, string owner) {
  int i = 0;
  while(i < len(stmts)) {
    exp_one(stmts[i], owner);
    i = i + 1;
  }
} return void;
