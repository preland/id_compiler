// Whether this build asks for the two-cases-per-function rule.
//
// A property of the build, not of the source, so it arrives as a flag and is
// read from a cell rather than threaded through every pass -- the same shape
// as is_freestanding (mid/names/exports/extern/tab/fs.id) and for the same
// reason.

// reqc: An exported scalar may only be assigned by its declaring function, so the
// flag is a list written through lset, like chkfail. Cell 0 is the flag; cells 1
// and 2 are chk_own_import's per-case state (imp_side, ./rank.id).
reqtests_init() {
  export int[] reqc = [0, 0, 2];
} return void export reqc;
given env_init ():() then (import reqc)[0]:(0)
given flags_setup ():() then (import reqc)[0]:(0)


// Whether any function in the call closure of `wc_src` -- itself included --
// writes the exported variable `wc_nm` declared by `wc_owner`: a write through
// (import NAME) by any of them, or through the bare name by the declaring
// function (the write table, report/diagnostics.id's wr_ready).
wr_closure(string wc_src, string wc_nm, string wc_owner) {
  wr_ready();
  string wc_ik = "i:" + wc_nm;
  string wc_vk = "v:" + wc_nm;
} chain (string wc_src, string wc_nm, string wc_owner) {
  int wc_hit = 0;
  int wc_k = 0;
  while(wc_k < len((import wrx)) && wc_hit == 0) {
    if((import wrx)[wc_k] == wc_ik || ((import wrx)[wc_k] == wc_vk && (import wrf)[wc_k] == wc_owner)) {
      wc_hit = reaches(wc_src, (import wrf)[wc_k]);
    }
    wc_k = wc_k + 1;
  }
} return int wc_hit;
given then_imp_fixture ("int[]", 2, 0) ("rd", "gx", "mk"):(1)
given then_imp_fixture ("int[]", 2, 0) ("rd", "gy", "mk"):(0)

// A case may not compare one import against another in a function's two core
// cases when the function under test declares the export: `(import NAME)` is
// refused on the expected side when the arguments of the same case already held
// an `(import NAME)`, the case is one of the first two written under its
// function (case_rank, ./rank.id), and the function that declares NAME is the
// function under test or anything it calls, with nothing in that call writing
// NAME after declaring it -- the pair of values would come from the same call
// and agree whatever the body did (docs/TESTS.md). An import on one side only
// is not refused, and neither is a later case. Not refused either: a variable
// some function in the call writes (the case then sees an effect), a function
// whose return clause says it exists to initialize NAME (`} return void export
// NAME;`), and a `given` setup's own arguments, which are read before the call
// (given_arg, ../../given/setup/args.id, raises setupargs while it checks
// them). The sides come from imp_side (./rank.id), which fit_body
// (../fit/body.id) calls; a `then` check is on neither.
chk_own_import(int i, int e) {
  string oi_x = (import ns1)[e];
  int oi_ek = find_str((import enames), oi_x);
  string oi_f = "";
} chain (int i, int e) {
  if(i < len((import casefn))) {
    oi_f = (import ns1)[((import casefn)[i])];
  }
  if(oi_ek >= 0 && (import setupargs)[0] == 0 && (import reqc)[2] == 0) {
    lset((import reqc), 1, 1);
  }
  if(oi_f != "" && oi_ek >= 0 && (import setupargs)[0] == 0 && (import reqc)[2] == 1 && (import reqc)[1] == 1 && case_rank(i) < 2 && reaches(oi_f, (import eowners)[oi_ek]) == 1 && fn_ret_export((import casefn)[i]) != oi_x && wr_closure(oi_f, oi_x, (import eowners)[oi_ek]) == 0) {
    case_err(i, "(import " + oi_x + "): this case compares one import against another, and '" + oi_x + "' is exported by '" + (import eowners)[oi_ek] + "', which the function under test, '" + oi_f + "', is or calls with nothing in that call writing it after declaring it; the first two cases of a function are its core cases and may not compare one import against another, because both values would come from the same call and agree whatever the body did; compare '" + oi_x + "' against a literal, or move this case after the first two, or, if '" + (import eowners)[oi_ek] + "' exists to initialize '" + oi_x + "', say so in its return clause: '} return void export " + oi_x + ";'");
  }
} return void;
