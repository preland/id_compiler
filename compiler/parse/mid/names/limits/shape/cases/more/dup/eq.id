// Whether two cases are the same case: equal token counts, then equal tokens.

case_eq(int a, int b) {
  int r = 0;
  if((import caseend)[a] - (import casestart)[a] == (import caseend)[b] - (import casestart)[b]) {
    r = case_eq_run((import casestart)[a], (import casestart)[b] - (import casestart)[a], (import caseend)[a]);
  }
} return int r;

// `off` is b's start minus a's, so the second cursor is derived rather than
// carried: a second counter would put this block over the action limit.
case_eq_run(int i, int off, int stop) {
  int r = 1;
  while(i < stop) {
    r = r * tok_same(i, i + off);
    i = i + 1;
  }
} return int r;

tok_same(int i, int j) {
  int r = 0;
  if((import ttext)[i] == (import ttext)[j]) {
    r = 1;
  }
} return int r;
