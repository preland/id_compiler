// The expected side of a case, judged in fit_body's chain (../body.id) once
// its own block is full.

// A void function is judged by what it left in its arguments, positionally. It
// may stop early: only the arguments the case names are checked.
fit_void(int i, int fn, int[] expd) {
  if(len(expd) > flat_arg_count(fn)) {
    int ne = len(expd);
    case_void_err(i, fn, ne);
  } else {
    fit_items(i, fn, expd);
  }
} return void;

fit_ret(int i, int fn, int[] expd) {
  if(len(expd) != 1) {
    int ne = len(expd);
    case_ret_err(i, fn, ne);
  } else {
    string rt = s2_of(fn);
    fit_value(i, expd[0], rt);
  }
} return void;
