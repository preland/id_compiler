// The expected side of a case, judged in fit_body's chain (../body.id) once
// its own block is full.

// A void function is judged by what it left in its arguments, positionally. It
// may stop early: only the arguments the case names are checked.
fit_void(int i, int fn, int[] expd) {
  if(len(expd) > flat_arg_count(fn)) {
    int ne = len(expd);
    case_void_err(i, fn, ne);
  } else {
    fit_items(i, fn, expd);
  }
} return void;
given print_fixture (0, (import fixture_fn), (import fixture_print_two)):() then prints:("fixture.id:4: error: this case expects 2 argument(s) after the call, but 'fx_target' takes 1\n")
given print_fixture (0, (import fixture_fn), (import fixture_print_none)):() then calls fit_items:[1]

fit_ret(int i, int fn, int[] expd) {
  if(len(expd) != 1) {
    int ne = len(expd);
    case_ret_err(i, fn, ne);
  } else {
    string rt = s2_of(fn);
    fit_value(i, expd[0], rt);
  }
} return void;
given print_fixture (0, (import fixture_fn), (import fixture_print_two)):() then prints:("fixture.id:4: error: 'fx_target' returns int, so its case expects exactly one value, not 2\n")
given calls_node_fixture (0, (import fixture_fn), (import fixture_calls_one)):() then calls fit_value:[1]
