// Literals joined the way a case writes them: `1, [2, 3], "x"`.
items_text(int[] xs) {
  string lt = "";
  int j = 0;
  while(j < len(xs)) {
    lt = lt + sep_arg(j) + lit_text(xs[j]);
    j = j + 1;
  }
} return string lt;
([]):("")
given calls_node_fixture ((import fixture_calls_one)):("1")

// A leaf as written: its own text, or `(import NAME)` for an export a case
// reads (front/parse/decl/func/cases/case/given/elem.id).
leaf_text(int e) {
  string lt = s1_of(e);
  if(k_of(e) == "cimport") {
    lt = "(import " + lt + ")";
  }
} return string lt;
