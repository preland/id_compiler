// `--require-tests` anywhere in the arguments. Scanned rather than tested at a
// fixed position, for the reason arg_xok gives: the driver also passes
// `--triple` and the AST dump takes a bare `ast`, and a flag whose meaning
// depends on its index is a trap the next flag falls into.

arg_reqtests(int argc, string[] argv, int i, int ok) {
  int r = ok;
  if(i < argc && argv[i] == "--require-tests") {
    r = 1;
  } else if(i < argc) {
    r = arg_reqtests(argc, argv, i + 1, ok);
  }
} return int r;

// Chained from check_scopes rather than check_program, whose block is full.
// The duplicate check runs unconditionally; only the two-case minimum is
// behind the flag.
check_cases_maybe() {
  check_dup_cases();
  if(require_tests() == 1) {
    check_cases();
  }
} return void;
