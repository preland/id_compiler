// `--require-tests` anywhere in the arguments. Scanned rather than tested at a
// fixed position, for the reason arg_flag gives: the driver also passes
// `--triple` and the AST dump takes a bare `ast`, and a flag whose meaning
// depends on its index is a trap the next flag falls into.

arg_reqtests(int argc, string[] argv, int i, int ok) {
  int r = ok;
  if(i < argc && argv[i] == "--require-tests") {
    r = 1;
  } else if(i < argc) {
    r = arg_reqtests(argc, argv, i + 1, ok);
  }
} return int r;
(2, ["prog", "--require-tests"], 1, 0):(1)
(2, ["prog", "--other"], 1, 0):(0)

// The flag cell turned on, for require_tests's own "yes" case. reqtests_set
// has a pair proving the cell flips, but require_tests takes no arguments, so
// its two cases have to differ by setup rather than by argument. Filed beside
// the flag scanner because flag.id and count.id are both at the
// three-function cap and this directory is at the three-entry one.
reqtests_flagged() {
  flags_setup();
  reqtests_set(1);
} return void;
():() then require_tests:(1)
():() then check_failed:(0)

// Which functions cannot be tested on the build host is decided before either
// check that reads it: a case that would never run, and the minimum
// (../../report/host/).
check_case_runs() {
  check_dup_cases();
  ut_mark();
  ut_cases();
} return void;
