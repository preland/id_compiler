// A list type's element type. How many parameters a function has, or
// arguments a case passes -- both a node's first child list -- is
// flat_arg_count (mid/names/limits/expr/more/report.id).

list_elem(string t) {
  int n = len(t);
  string et = slice(t, 0, n - 2);
} return string et;
("int[]"):("int")
("string[]"):("string")

// The type a `then (import NAME)[i]:(value)` clause compares at: int for a `then len((import NAME))`, else the type of
// the export it names, or of one element of it when the clause has an index.
// "" for a name nothing exports (fit_import has said so by then). Read by the
// checker (then_imp_value, ../../../../../report/host/cases/then.id) and by
// emission and the type notes (back/.../test/case/around/then/), so all three
// agree on what the value is held to.
then_imp_type(int chk_node) {
  int ek = find_str((import enames), (import ns1)[chk_node]);
  string vt = "";
  if(ek >= 0) {
    vt = (import etypes)[ek];
  }
} chain (int chk_node) {
  if(len((import nl2)[chk_node]) == 1 && ty_is_list(vt) == 1) {
    vt = list_elem(vt);
  }
  if((import nkind)[chk_node] == "thenlen") {
    vt = "int";
  }
} return string vt;
