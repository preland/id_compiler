// Whether each case fits the function it is written under: the right number of
// arguments, the right number of expected values, and literals of the types
// the signature declares.
//
// idc.py raised these while building its harness. They are properties of the
// program, not of a harness, so here they are checks like the others, and they
// run on every build. idc.py's wording, word for word. The loop that drove
// this over every case and every then-clause was check_case_fits; it was
// called exactly once, as the last action of check_scopes
// (mid/names/symbols/build/scopes.id), and now chains there directly.

fit_case(int i) {
  int fn = (import casefn)[i];
  int node = (import casenode)[i];
  blank;
} chain (int i) {
  if(flat_arg_count(fn) != flat_arg_count(node)) {
    int na = flat_arg_count(node);
    case_arity_err(i, fn, na);
  } else if(case_has_out(i, "thentraps") == 1) {
    fit_traps(i);
  } else {
    fit_body(i, fn, node);
  }
} return void;
