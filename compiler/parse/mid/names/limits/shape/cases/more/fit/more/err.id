  (0, (import fixture_fn), 0):() then prints:("fixture.id:4: error: this case expects 0 argument(s) after the call, but 'fx_target' takes 1 [E0504]\n  why: the expected tuple of a case lists the parameters' values after the call, left to right; it may stop early, but it cannot name more of them than the function has\n  help: list at most the parameters of fx_target(int x) in the expected tuple, or none at all\n")
}

case_ret_err(int i, int fn, int ne) {
