// The three messages about a case's shape.

case_arity_err(int i, int fn, int na) {
  string f1 = s1_of(fn);
  int np = flat_arg_count(fn);
  case_err(i, "this case passes " + na + " argument(s) to '" + f1 + "', which takes " + np);
} return void;
given fn_fixture (0, (import fixture_fn), 3):() then prints:("fixture.id:4: error: this case passes 3 argument(s) to 'fx_target', which takes 1\n")
given fn_fixture (0, (import fixture_fn), 0):() then prints:("fixture.id:4: error: this case passes 0 argument(s) to 'fx_target', which takes 1\n")

case_void_err(int i, int fn, int ne) {
  string f1 = s1_of(fn);
  int np = flat_arg_count(fn);
  case_err(i, "this case expects " + ne + " argument(s) after the call, but '" + f1 + "' takes " + np);
} return void;
given fn_fixture (0, (import fixture_fn), 2):() then prints:("fixture.id:4: error: this case expects 2 argument(s) after the call, but 'fx_target' takes 1\n")
given fn_fixture (0, (import fixture_fn), 0):() then prints:("fixture.id:4: error: this case expects 0 argument(s) after the call, but 'fx_target' takes 1\n")

case_ret_err(int i, int fn, int ne) {
  string f1 = s1_of(fn);
  string rt = s2_of(fn);
  case_err(i, "'" + f1 + "' returns " + rt + ", so its case expects exactly one value, not " + ne);
} return void;
given fn_fixture (0, (import fixture_fn), 2):() then prints:("fixture.id:4: error: 'fx_target' returns int, so its case expects exactly one value, not 2\n")
given fn_fixture (0, (import fixture_fn), 0):() then prints:("fixture.id:4: error: 'fx_target' returns int, so its case expects exactly one value, not 0\n")
