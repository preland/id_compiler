  string f1 = (import ns1)[fn];
  int np = len(((import nl1)[fn]));
  string arity_case_sig = diag_sig(fn);
} chain (int i, int fn, int na) {
  case_diag(i, "E0503", "this case passes " + na + " argument(s) to '" + f1 + "', which takes " + np, "a case calls the function under test with its arguments, so it must pass exactly the parameters the function declares", "write one literal per parameter in the case's first tuple: " + arity_case_sig);
} return void;
given fn_fixture {
