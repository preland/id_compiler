  int np = len(((import nl1)[fn]));
  string f1 = (import ns1)[fn];
} chain (int i, int fn, int ne) {
  case_diag(i, "E0504", "this case expects " + ne + " argument(s) after the call, but '" + f1 + "' takes " + np, "the expected tuple of a case lists the parameters' values after the call, left to right; it may stop early, but it cannot name more of them than the function has", "list at most the parameters of " + void_case_sig + " in the expected tuple, or none at all");
} return void;
