// A literal against the type it will be built at. The declared type decides,
// not the literal: `[1, 2]` is a perfectly good `word[]`, and inferring the
// type from the literal would call it a type error about a list nobody wrote.
// `(import NAME)` and a function's name are not literals and have types of
// their own (../../../../given/read/).

fit_value(int i, int e, string want) {
  if((import nkind)[e] == "cimport" || (import nkind)[e] == "cfn") {
    fit_named(i, e, want);
  } else if(ty_is_list(want) == 1) {
    fit_list(i, e, want);
  } else {
    fit_other(i, e, want);
  }
} return void;
