fit_elems(int i, int e, string want) {
  int[] xs = (import nl1)[e];
  string et = list_elem(want);
  int j = 0;
} chain (int i, int e, string want) {
  while(j < len(xs)) {
    fit_value(i, xs[j], et);
    j = j + 1;
  }
} return void;
