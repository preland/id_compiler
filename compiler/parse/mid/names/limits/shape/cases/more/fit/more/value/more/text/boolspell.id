// A bool literal leaf is stored as 1 or 0 with ns2 "bool"; a case that quotes
// it back (the expected side of a failure message) must say true or false.
bool_spell(int e) {
  string lt = (import ns1)[e];
  if((import ns2)[e] == "bool") {
    lt = "false";
  }
  if((import ns2)[e] == "bool" && (import ns1)[e] == "1") {
    lt = "true";
  }
} return string lt;
