// The literals a check is called with, `then CHECK(LIT, ...):(value)`. Each is
// held to exactly what a case's own argument is held to (fit_value), at the
// check's parameter type -- except a function's name, which only a case's own
// arguments may pass, as for a setup's (../../setup/args.id). An `(import NAME)`
// among them is read after the call under test and the checks before it, like
// the check's expected value, so it is held to the rule of chk_own_import
// (../../more/flag/reqtests.id) where a setup's own arguments are exempt.
// Then the check's value (value.id).

then_args_fit(int ci, int chk_node, int cfn) {
  int[] targs = (import nl2)[chk_node];
  int ta_j = 0;
  while(ta_j < len(targs)) {
    then_arg(ci, cfn, targs, ta_j);
    ta_j = ta_j + 1;
  }
} chain (int ci, int chk_node, int cfn) {
  then_value_fit(ci, chk_node, cfn);
} return void;
