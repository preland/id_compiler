// A conf.id constant among a check's arguments. It says what to call the
// check with, and the value compared with stays a literal, so the case cannot
// agree with itself. fit_import (../../read/impcheck.id) refuses a constant
// unless setupargs is raised, as for a setup's arguments; it is raised here to
// 2 for a constant only, so that every other (import NAME) in a check's
// argument keeps being held to chk_own_import (../../more/flag/reqtests.id).

then_arg_value(int ci, int e, string pt) {
  int is_conf = then_arg_conf(e);
  integer_list_set((import setupargs), 0, 2 * is_conf);
  fit_value(ci, e, then_arg_want(e, pt));
} chain (int ci, int e, string pt) {
  integer_list_set((import setupargs), 0, 0);
  if((import nkind)[e] == "cimport") {
    then_arg_index(ci, e);
  }
} return void;
