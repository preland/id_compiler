fit_print_items(int ci, int[] items) {
  if(len(items) != 1) {
    int ne = len(items);
    case_err(ci, "a 'prints' or 'eprints' check compares exactly one value, not " + ne);
  } else {
    fit_value(ci, items[0], "string");
  }
} return void;
