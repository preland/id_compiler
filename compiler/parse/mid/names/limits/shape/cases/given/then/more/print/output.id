// Exactly one value of a type, or the case is refused with `msg` and the count:
// a prints/eprints check holds one string, a calls count one int.
fit_one(int ci, int[] items, string fo_msg, string fo_type) {
  if(len(items) != 1) {
    int ne = len(items);
    case_err(ci, fo_msg + ne);
  } else {
    fit_value(ci, items[0], fo_type);
  }
} return void;
