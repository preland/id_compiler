// The digest's parsed pair (mid/form/unique/dump/digest/graph/state/
// parsed.id: fb calls fa) with the memo built -- rows 0 fa, 1 fb, 2 the asm
// row -- and then with fb's set already found.

rc_t_ready() {
  dg_t_parsed();
  rc_ready();
} return void;
given dg_t_parsed ():() then (import rcon)[0]:(1)
():() then len((import dg_comp)):(3)
():() then calls dg_t_parsed:[1]
rc_t_one() {
  rc_t_ready();
  int rcfirst = rc_of("fb");
} return void;
():() then len((import rcsets)):(1)
():() then len((import dg_comp)):(3)

// Test check: the whole reach memo -- how many rows it holds, then every row's
// flags in order -- so a case states all of it. rc_has (flags.id) computes a
// row on demand through rc_of, so a check of the row count would be the
// effect of that call and not a repeat of a read it makes.
rcsets_state() {
  string rcs_j = len((import rcsets)) + ":";
  int rcs_f = 0;
  int rcs_w = 0;
} chain () {
  if(len((import rcsets)) > 0) {
    rcs_w = len((import rcsets)[0]);
  }
  while(rcs_f < len((import rcsets)) * rcs_w) {
    rcs_j = rcs_j + (import rcsets)[rcs_f / rcs_w][rcs_f % rcs_w];
    rcs_f = rcs_f + 1;
  }
} return string rcs_j;
given rc_t_ready ():("0:")
given rc_t_one ():("1:110")
