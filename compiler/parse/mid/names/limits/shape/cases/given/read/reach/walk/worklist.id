// A worklist walk: every row is flagged and queued at most once, so a setup
// costs the edges it reaches, where the fixpoint it replaces swept the whole
// program once per level of call depth.

rc_visit(int[] rcfl, int[] rctodo, int rcw) {
  if(rcw >= 0 && rcfl[rcw] == 0) {
    rcfl[rcw] = 1;
    push(rctodo, rcw);
  }
} return void;
given rc_t_ready ([0, 0, 0], [], 1):([0, 1, 0], [1])
given rc_t_ready ([0, 1, 0], [], 1):([0, 1, 0], [])

rc_walk(int[] rcfl, int[] rctodo) {
  while(len(rctodo) > 0) {
    int rcrow = pop(rctodo);
    rc_step(rcfl, rctodo, rcrow, 0);
  }
} return void;
given rc_t_ready ([0, 1, 0], [1]):([1, 1, 0], [])
given rc_t_ready ([1, 0, 0], [0]):([1, 0, 0], [])

rc_step(int[] rcfl, int[] rctodo, int rcrow, int rci) {
  while(rci < len((import dg_cout)[rcrow])) {
    rc_visit(rcfl, rctodo, (import dg_cout)[rcrow][rci]);
    rci = rci + 1;
  }
} return void;
given rc_t_ready ([0, 1, 0], [], 1, 0):([1, 1, 0], [0])
given rc_t_ready ([0, 1, 0], [], 1, 2):([0, 1, 0], [])
