// A target function for `calls`-clause checks: "fx_target(int x) return
// int", registered in the symbol tables (front/tree/init/init_sym.id) the
// way build_reg (mid/names/symbols/build/scopes.id) would, so
// func_node("fx_target") finds it and its one int parameter is there for
// arity/type checks to read. Built on case_fixture, so a case that needs
// both a case to report at and a function to check against gets both from
// one `given fn_fixture`. fixture_zero (its return expression) and
// fixture_params (its one parameter, as l1_of(fixture_fn) also is) are
// exported too: plain node ids, valid wherever a test elsewhere needs one
// and not a whole fixture of its own.

fn_fixture() {
  case_fixture();
  fn_fixture_build();
} return void;
():() then check_failed:(0)
():() then init_units:(0)

fn_fixture_build() {
  export int[] fixture_params = [node_param("param", "int", "x")];
  export int fixture_zero = node_int("0", 0, 0);
  fn_fixture_node();
} return void;
given case_fixture ():() then check_failed:(0)
given case_fixture ():() then init_units:(0)

fn_fixture_node() {
  int[] none = [];
  export int fixture_fn = node_func("fx_target", "int", (import fixture_params), none, (import fixture_zero));
  fn_fixture_reg();
} return void;
given case_fixture ():() then check_failed:(0)
