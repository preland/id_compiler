// A check's signature: a value to compare, and one literal per parameter.
// `then CHECK(LIT, ...):(value)` is called the way `given SETUP(LIT, ...)`
// calls a setup (../../setup/args.id), so the count is the same rule with the
// same words; each literal is then held to its parameter (args.id).

then_sig(int ci, int chk_node, int cfn, string chk_nm) {
  if((import ns2)[cfn] == "void") {
    case_err(ci, "'then' names '" + chk_nm + "', which returns void; a check returns the value it compares");
  } else if(len(((import nl2)[chk_node])) != len(((import nl1)[cfn]))) {
    int np = len(((import nl1)[cfn]));
    int na = len(((import nl2)[chk_node]));
    case_err(ci, "'then' names '" + chk_nm + "', which takes " + np + " parameter(s), but this 'then' passes " + na + "; a check is called with one literal per parameter, as in 'then " + chk_nm + "(1, 2):(value)', and with none as 'then " + chk_nm + ":(value)'");
  } else {
    then_args_fit(ci, chk_node, cfn);
  }
} return void;
