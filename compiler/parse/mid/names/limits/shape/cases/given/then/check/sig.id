// A `then (import NAME).a.b` clause's fields, followed to the type they reach
// (then_path_type, ../../../more/dup/utread.id): a path that is not one is
// refused there, in words that say which step and what to write instead, and
// otherwise the clause's index and value are held to that type
// (then_imp_value, ../../../report/host/cases/then.id). Filed here because
// the lane above it was at the since-dropped three-entry limit.
then_imp_field(int ci, int chk_node, string want) {
  string ft = then_path_type(want, (import ns2)[chk_node]);
  if(ft == "") {
    case_err(ci, then_path_why(chk_node, want));
  } else {
    then_imp_value(ci, chk_node, ft);
  }
} return void;
