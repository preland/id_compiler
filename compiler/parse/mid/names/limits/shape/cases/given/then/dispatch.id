// `traps` and `thenimp` (`then (import NAME):(value)`, and `thenlen` for `then len((import NAME)):(value)`) are the fourth and
// fifth kinds fit_then_kind tells apart -- folded in beside `calls` rather
// than as further branches there (that if/else-if chain already spends its
// own action budget) -- fit_then_traps and fit_then_imp (../check/entry.id)
// are the actual checks.
fit_then_traps_or_calls(string kind, int chk_node) {
  if(kind == "thentraps") {
    fit_then_traps(chk_node);
  } else if(kind == "thenimp" || kind == "thenlen") {
    fit_then_imp(chk_node);
  } else {
    fit_then_calls(kind, chk_node);
  }
} return void;
