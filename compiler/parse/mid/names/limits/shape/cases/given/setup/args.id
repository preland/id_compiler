// The literals a setup is called with: `given NAME(LIT, ...)`. The parser
// recorded them on a "gsetup" node per `given`, listed in the order written by
// the case's "gargs" node (front/parse/decl/func/cases/case/given/elem/more/
// args.id), so the si-th setup of casegiven[i] has the si-th node. There is
// one literal per parameter and each is held to exactly what a case's own
// argument is held to (fit_value), at the setup's parameter type -- except a
// function's name, which only a case's own arguments may pass: the harness
// carries a function named there because the case's arguments name it
// (back/drive/target/tests/more/seed/fns.id), and a setup's are not looked at.

// A case whose `given` was never parsed from source (every fixture but
// gsetup_fixture) has no casegargs entry, and calls its setups with nothing; the
// setups of a real one are found by their index among the names.
given_items(int i, int si) {
  int[] items = [];
  if(i < len((import casegargs))) {
    int[] gs = (import nl1)[((import casegargs)[i])];
    items = (import nl1)[(gs[si])];
  }
} return int[] items;
given gsetup_fixture (0, 1):([(import fixture_zero)])
given gsetup_fixture (0, 0):([])
given fn_fixture (0, 0):([])

given_args(int i, int si, int sfn) {
  int[] items = given_items(i, si);
  if(len(items) != len(((import nl1)[sfn]))) {
    string nm = (import ns1)[sfn];
    int np = len(((import nl1)[sfn]));
    case_err(i, "'given' names '" + nm + "', which takes " + np + " parameter(s), but this 'given' passes " + len(items) + "; a setup is called with one literal per parameter, as in 'given " + nm + "(1, 2)', and with none as 'given " + nm + "'");
  } else {
    given_fit(i, si, sfn, items);
  }
} return void;
given gsetup_fixture (0, 1, (import fixture_set1)):() then (import chkfail)[0]:(0)
given gsetup_fixture (0, 0, (import fixture_set1)):() then (import chkfail)[0]:(1)

given_arg(int i, int sfn, int[] items, int j) {
  string pt = (import ns1)[((import nl1)[sfn][j])];
  if((import nkind)[(items[j])] == "cfn") {
    case_err(i, "a setup's arguments are literals or (import NAME); '" + (import ns1)[(items[j])] + "' is a function name, which only a case's own arguments may pass");
  } else {
    lset((import setupargs), 0, 1);
    fit_value(i, items[j], pt);
  }
} chain (int i, int sfn, int[] items, int j) {
  lset((import setupargs), 0, 0);
} return void;
