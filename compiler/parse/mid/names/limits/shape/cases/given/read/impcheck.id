// `(import NAME)` in a case: the value of an export once the case's setup has
// run. Three things make it mean that, and each is decided from the case line
// and the declarations it names:
//
//   * the case has a `given` -- without one nothing has run, and the export is
//     the uninitialised global the dead-export check exists to stop reading;
//   * NAME is exported by the setup or by a function the setup reaches -- the
//     reachability that check uses, seeded from the setup instead of `main`;
//   * the export's type is exactly the type wanted at that position. A literal
//     is built at the type it is given, but an export already has one, and
//     using it as another is a conversion nobody wrote.

fit_import(int i, int e, string want) {
  string imp_nm = s1_of(e);
  int ek = find_str((import enames), imp_nm);
  blank;
} chain (int i, int e, string want) {
  if((import casegiven)[i] == "") {
    case_err(i, "(import " + imp_nm + ") needs a 'given': an export has no value in a case until a setup has run; a setup's own arguments are read before it runs, so an (import NAME) there needs an earlier 'given' that sets it");
  } else if(ek < 0) {
    case_err(i, "(import " + imp_nm + "): '" + imp_nm + "' is not an exported variable");
  } else {
    imp_owner(i, imp_nm, ek, want);
  }
} return void;
given impcase_empty ((import fixture_ci), (import fixture_zero), "int"):() then prints:("fixture.id:4: error: (import 0) needs a 'given': an export has no value in a case until a setup has run; a setup's own arguments are read before it runs, so an (import NAME) there needs an earlier 'given' that sets it\n")
given impcase_given ((import fixture_ci), (import fixture_zero), "int"):() then prints:("fixture.id:4: error: (import 0): '0' is not an exported variable\n")

imp_owner(int i, string imp_nm, int ek, string want) {
  string setup_nm = (import casegiven)[i];
  if(setups_miss(setup_nm, ek) == 1) {
    case_err(i, "(import " + imp_nm + "): '" + imp_nm + "' is exported by '" + (import eowners)[ek] + "', which the setup '" + str_trim(setup_nm) + "' does not reach, so nothing sets it before the call");
  } else if((import etypes)[ek] != want) {
    case_err(i, "this case gives (import " + imp_nm + "), a " + (import etypes)[ek] + ", where a " + want + " is required");
  }
} return void;
given impcase_empty ((import fixture_ci), "x", 0, "int"):() then prints:("")
given impcase_empty ((import fixture_ci), "x", 0, "string"):() then prints:("fixture.id:4: error: this case gives (import x), a int, where a string is required\n")

// A `given` may name several setups, so the requirement is that ONE of them
// reaches the export's owner. Reported only when a setup exists and none do:
// a name that is no function at all is given_fn's error, not this one.
setups_miss(string entry, int ek) {
  string[] setups = str_split(entry, " ");
  int si = 0;
  int seen = 0;
} chain (string entry, int ek) {
  int hit = 0;
  while(si < len(setups)) {
    seen = miss_seen(setups[si], seen);
    hit = miss_hit(setups[si], ek, hit);
    si = si + 1;
  }
  int miss = 0;
} chain (string entry, int ek) {
  if(seen == 1 && hit == 0) {
    miss = 1;
  }
} return int miss;
