then_reader(int ci, int chk_node, string rd_nm) {
  int[] targs = (import nl2)[chk_node];
  if(len(targs) != 1) {
    case_err(ci, "'then' names '" + rd_nm + "', a read builtin, which takes one address; write it as 'then " + rd_nm + "(ADDRESS):(value)'");
  } else {
    then_arg_value(ci, targs[0], "word");
  }
} chain (int ci, int chk_node, string rd_nm) {
  int[] items = (import nl1)[chk_node];
  if(len(items) != 1) {
    int ne = len(items);
    case_err(ci, "a 'then' check compares exactly one value, not " + ne);
  } else {
    fit_value(ci, items[0], "word");
  }
} return void;
