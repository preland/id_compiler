given_fn(int i, int si, string setup_nm) {
  int sfn = func_node(setup_nm);
  blank;
  blank;
} chain (int i, int si, string setup_nm) {
  if(sfn < 0) {
    case_err(i, "'given' names '" + setup_nm + "', which is not a function in this build");
  } else if((import ns2)[sfn] != "void") {
    string rt = (import ns2)[sfn];
    case_err(i, "'given' names '" + setup_nm + "', which returns " + rt + "; a setup returns void, since the harness has nothing to compare its result with");
  } else {
    given_args(i, si, sfn);
  }
} return void;
