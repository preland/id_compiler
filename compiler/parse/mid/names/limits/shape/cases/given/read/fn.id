// A function named in a case (front/parse/decl/func/cases/case/given/elem/fn.id)
// is that function as a value, so it fits a position exactly when its
// signature is the position's function type -- the rule an argument written in
// the program obeys (docs/SPEC.md 1.1). No setup is needed: nothing runs to
// produce a function's name. A name that is no function is the mistake a case
// has always been able to make -- a variable where a literal belongs -- and is
// reported in the words it always was, with what a name there would have to be.

fit_named(int i, int e, string want) {
  if((import nkind)[e] == "cfn") {
    fit_fn(i, e, want);
  } else {
    fit_case_import(i, e, want);
  }
} return void;
given cfn_fixture ((import fixture_ci), (import cfn_e), "func(int) return int"):() then (import chkfail)[0]:(0)
given cfn_fixture ((import fixture_ci), (import fixture_zero), "int"):() then (import chkfail)[0]:(1)

fit_fn(int i, int e, string want) {
  string nm = (import ns1)[e];
  string ft = fn_sig_of(nm);
  blank;
} chain (int i, int e, string want) {
  if(ft == "") {
    case_err(i, "a test case takes literals only (a number, a string, or a list of those); '" + nm + "' is not a function in this build, which is the only name a case may pass");
  } else if(ft != want) {
    case_err(i, "this case gives '" + nm + "', a " + ft + ", where a " + want + " is required");
  }
} return void;
given cfn_fixture ((import fixture_ci), (import cfn_e), "func(int) return int"):() then (import chkfail)[0]:(0)
given cfn_fixture ((import fixture_ci), (import cfn_e), "func(string) return void"):() then (import chkfail)[0]:(1)

// One setup of a multi-setup `given` (../read.id's setups_miss): raises `seen`
// when this name is a function in the build at all. A name that is not is
// given_fn's error, so setups_miss must not report it a second time.
miss_seen(string nm, int seen) {
  int r = seen;
  if(nm != "" && func_node(nm) >= 0) {
    r = 1;
  }
} return int r;
given fn_fixture ("fx_target", 0):(1)
given fn_fixture ("nosuchfn123", 0):(0)
