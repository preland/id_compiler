// (mid/.../more/fit/'s fit_items, the same check a case's own arguments get);
// the count form's single value, an int.

fit_calls_body(string kind, int ci, string nm, int cfn, int chk_node) {
  int[] items = (import nl1)[chk_node];
  if(kind == "thencalls") {
    fit_calls_args(ci, nm, cfn, items);
  } else {
    fit_one(ci, items, "a 'calls NAME:[N]' check takes exactly one count, not ", "int");
  }
} return void;
