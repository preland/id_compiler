fit_calls_args(int ci, string nm, int cfn, int[] items) {
  if(len(items) != len(((import nl1)[cfn]))) {
    int na = len(items);
    int np = len(((import nl1)[cfn]));
    case_diag(ci, "E0519", "this case's 'calls " + nm + "' passes " + na + " argument(s), which takes " + np, "'calls NAME:(ARGS)' matches the arguments of one call to NAME, so it lists one literal for each of NAME's parameters", "write one literal per parameter: " + diag_sig(cfn));
  } else {
    fit_items(ci, cfn, items);
  }
} return void;
