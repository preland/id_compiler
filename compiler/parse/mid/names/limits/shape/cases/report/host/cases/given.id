// The state a `then (import gx)` node is checked in: the case and fx_target
// of fn_fixture, a `given` naming no function (so nothing for reaches() to
// walk), `gx` exported with type `ty` by "mk", a function `rd` whose body
// reads gx, and a "thenimp" node on gx whose one value is the literal 0 --
// with an index (also 0, or the string "a" when `indexed` is 2) when `indexed`
// is 1 or 2. `reads` 1 makes `rd` the function the case is written under, 0
// leaves fx_target, which reads nothing, and 2 is 1 with `rd` also binding a list name to
// gx. A case wanting a "thenlen" node says so with `given sset((import
// nkind), (import then_imp_node), "thenlen")` after this setup.
then_imp_fixture(string ty, int reads, int indexed) {
  fn_fixture();
  push((import casegiven), "nosuch");
  add_export("gx", ty, "mk");
} chain (string ty, int reads, int indexed) {
  int[] none = [];
  export int then_imp_rd = node_txt("import", "gx");
  if(reads == 2) {
    node_decl("int[]", "al", (import then_imp_rd), 0);
  }
} chain (string ty, int reads, int indexed) {
  export int then_imp_fn = node_func("rd", "int", none, none, (import then_imp_rd));
  push((import prog), (import then_imp_fn));
  int[] ixs = [];
} chain (string ty, int reads, int indexed) {
  if(reads > 0) {
    push((import casefn), (import then_imp_fn));
  } else {
    push((import casefn), (import fixture_fn));
  }
  int[] vals = [(import fixture_zero)];
} chain (string ty, int reads, int indexed) {
  if(indexed == 1) {
    push(ixs, (import fixture_zero));
  } else if(indexed == 2) {
    push(ixs, node_txt("str", "a"));
  }
  export int then_imp_node = newnode("thenimp", (import fixture_ci), 0, "gx", "", vals, ixs);
} chain (string ty, int reads, int indexed) {
  push((import thennode), (import then_imp_node));
  export int then_imp_cix = newleaf("cimport", 0, 0, "gx", "");
} return void;
