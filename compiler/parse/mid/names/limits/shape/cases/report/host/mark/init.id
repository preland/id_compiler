// Which functions cannot be tested on the build host (docs/TESTS.md, "A
// freestanding build runs its cases on the build host").
//
// A --freestanding build's cases run in a harness built for the machine doing
// the build. A function that reaches, through the call graph, something with no
// implementation there cannot run in it, so a case under it could never run.
// Three things have none: an `asm` function with no body for the host's triple;
// a `native`, because a freestanding build links no backend and its
// implementation is whatever the object is finally linked with; and, in a
// --runtime build, a function named after a runtime helper, because the harness
// takes that name from the host's C runtime rather than from this tree.
//
// Decided from the source and the host's triple alone, once, before the case
// checks read it. A hosted build's harness is built for the build's own triple,
// so nothing is marked there and its rules are what they were.
//
//   utname  the functions that cannot be tested on the build host
//   utwhat  for each, what it reaches, as the diagnostics name it
//   utvia   the callee it reaches that through: "" when it calls the thing
//           itself, "*" when it is the thing
//   utnote  the exemption notes check_cases wrote (back/drive/sink/notes.id)

// The runtime's own helpers first, then the call graph to a fixpoint: a sweep
// that marks nothing new ends it, so the number of sweeps is the length of the
// longest chain to something that cannot run.
// utnote: utnote is the one column ut_add does not touch: check_cases writes it
// through ut_note, so notes_push (mid/form/decomp/notesfx.id) rather than
// ut_seeded is what puts a row in it.
ut_mark() {
  export string[] utname = [];
  export string[] utwhat = [];
  export string[] utvia = [];
} chain () {
  export string[] utnote = [];
  if((import fsc)[0] == 1) {
    ut_seed_self();
    ut_loop();
  }
} return void;
given notes_base ():() then ut_sweep:(0)
given ut_seeded ():() then ut_sweep:(0)

// What an element or field access is made over: `(import NAME).a.b[i]` is an
// "index" node over an "index" node over the import, and the root is the
// import. A node that is not an index is its own root. Filed here, with
// decl_alias_use, because the lane that reads them (given/then/more/calls/fit/
// use.id) is at the three-function limit.
imp_root(int nd) {
  int imp_rt = nd;
  while((import nkind)[imp_rt] == "index") {
    imp_rt = (import ni1)[imp_rt];
  }
} return int imp_rt;
given imp_use_fixture ((import imp_use_deep)):((import imp_use_rd))
given imp_use_fixture ((import imp_use_rd)):((import imp_use_rd))

// Whether a declaration binds a name to a list or a struct reached from the
// import NAME -- itself, or an element or field of it, however deep -- so that
// writing through the name may change the export (see use.id).
decl_alias_use(int nd, string imp_nm) {
  int imp_rt = imp_root((import ni1)[nd]);
  int hit = 0;
  if((import nkind)[imp_rt] == "import" && (import ns1)[imp_rt] == imp_nm && (ty_is_list((import ns1)[nd]) == 1 || sd_nfields((import ns1)[nd]) > 0)) {
    hit = 1;
  }
} return int hit;
given imp_use_fixture ((import imp_use_alias), "gx"):(1)
given imp_use_fixture given sd_note("P", ["x"], ["int"], "p.id", 1) ((import imp_use_sdecl), "gx"):(1)
given imp_use_fixture ((import imp_use_alias), "gy"):(0)
