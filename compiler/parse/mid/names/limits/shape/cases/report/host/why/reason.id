// Why a function cannot be tested on the build host, in the one wording every
// message about it uses.

ut_why(string name) {
  string build_host_v = (import hostc)[0];
  string because = ut_because(name);
  string ret_s = "cannot be tested on the build host (" + build_host_v + "): " + because;
} return string ret_s;
given ut_host_seeded ("port_byte"):("cannot be tested on the build host (x86_64-unknown-none): it is asm 'in8'")
given ut_host_seeded ("caller"):("cannot be tested on the build host (x86_64-unknown-none): it calls 'port_byte', which reaches asm 'in8'")

ut_because(string name) {
  int ut_k = find_str((import utname), name);
  string ret_s = ut_because_at((import utvia)[ut_k], (import utwhat)[ut_k]);
} return string ret_s;
given ut_host_seeded ("port_byte"):("it is asm 'in8'")
given ut_host_seeded ("caller"):("it calls 'port_byte', which reaches asm 'in8'")

// The write table (wr_ready, ../../diagnostics.id): the columns, then every
// function's statements in turn.
wr_build() {
  export string[] wrx = [];
  export string[] wrf = [];
  int wr_i = 0;
} chain () {
  while(wr_i < len((import prog))) {
    wr_fn(wr_i);
    wr_i = wr_i + 1;
  }
  integer_list_set((import wrdone), 0, 1);
} return void;
given then_imp_fixture ("int[]", 2, 0) ():() then (import wrx):(["i:gx"])
given then_imp_fixture ("int", 1, 0) ():() then len((import wrf)):(0)
