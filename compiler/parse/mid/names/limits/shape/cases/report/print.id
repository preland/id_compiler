// The two messages of report.id, split out so each reporting block stays
// within the action limit. The message of each is the wording the invalid/
// tests have always pinned; the code, why and help are the record's
// (docs/DIAGNOSTICS.md).

cases_report(string report_loc, string report_fn_name, int n) {
  string report_msg = "function '" + report_fn_name + "' has " + n + " test case(s); --require-tests needs at least 2 (see docs/TESTS.md)";
  diag("E0501", report_loc, report_msg, report_fn_name, "a function is finished when two cases pass: the cases run on every build, so they document the function and cannot drift from it (docs/TESTS.md)", "write two cases directly under the function, one per line as (ARGS):(EXPECTED); they must describe two different behaviours, and each must be able to fail if the function is wrong");
} return void;
given case_fixture ("somefile.id:1", "myfunc", 5):() then prints:("somefile.id:1: error: function 'myfunc' has 5 test case(s); --require-tests needs at least 2 (see docs/TESTS.md) [E0501]\n  at: myfunc\n  why: a function is finished when two cases pass: the cases run on every build, so they document the function and cannot drift from it (docs/TESTS.md)\n  help: write two cases directly under the function, one per line as (ARGS):(EXPECTED); they must describe two different behaviours, and each must be able to fail if the function is wrong\n")
given case_fixture ("other.id:2", "otherfunc", 0):() then prints:("other.id:2: error: function 'otherfunc' has 0 test case(s); --require-tests needs at least 2 (see docs/TESTS.md) [E0501]\n  at: otherfunc\n  why: a function is finished when two cases pass: the cases run on every build, so they document the function and cannot drift from it (docs/TESTS.md)\n  help: write two cases directly under the function, one per line as (ARGS):(EXPECTED); they must describe two different behaviours, and each must be able to fail if the function is wrong\n")

dup_case_report(string dup_file, int i, int j) {
  string dup_where = dup_file + ":" + (import tline)[(import casestart)[i]];
  string dup_first = dup_file + ":" + (import tline)[(import casestart)[j]];
  diag("E0502", dup_where,"this test case is identical to an earlier one; two cases must describe two behaviours (see docs/TESTS.md)", "", "a second case that spells the same call proves nothing the first did not; cases are compared as tokens, so changing the spacing does not make one different", "change the arguments or the expected value so this case exercises a different behaviour, or delete it; each of a function's two cases must be able to fail on its own");
} chain (string dup_file, int i, int j) {
  diag_related(dup_first, "the case this one repeats");
} return void;
given case_fixture ("somefile.id", 0, 0):() then prints:("somefile.id:4: error: this test case is identical to an earlier one; two cases must describe two behaviours (see docs/TESTS.md) [E0502]\n  why: a second case that spells the same call proves nothing the first did not; cases are compared as tokens, so changing the spacing does not make one different\n  help: change the arguments or the expected value so this case exercises a different behaviour, or delete it; each of a function's two cases must be able to fail on its own\n  related: somefile.id:4: note: the case this one repeats\n")
given case_fixture ("other.id", 0, 0):() then prints:("other.id:4: error: this test case is identical to an earlier one; two cases must describe two behaviours (see docs/TESTS.md) [E0502]\n  why: a second case that spells the same call proves nothing the first did not; cases are compared as tokens, so changing the spacing does not make one different\n  help: change the arguments or the expected value so this case exercises a different behaviour, or delete it; each of a function's two cases must be able to fail on its own\n  related: other.id:4: note: the case this one repeats\n")

fnscope_fix() {
  regrow_fn();
  check_access();
} return void;
