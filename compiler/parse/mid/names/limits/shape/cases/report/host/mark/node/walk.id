// One function's nodes. A function already marked is skipped, so what it is
// reported as reaching is the first thing a sweep found, in source order.

// Refused: ut_at (../../why/reason.id) is called unconditionally, which traps
// unless a case's `given` also ran ut_mark (../mark/); fn_fixture and
// chk_fixture (../../../given/then/more/fixture/fn.id, .../more/print/
// print.id), the fixtures with a real `prog` entry, never do. No fixture
// combines the two, and the lane's free function slots are already spent
// (see ut_note's note, ../why/note.id, for the same gap).
ut_func(int f, int lo) {
  string s1_of_v = s1_of((import prog)[f]);
  if(ut_at(s1_of_v) < 0) {
    ut_range(s1_of_v, lo, (import prog)[f]);
  }
  int ret_i = (import prog)[f] + 1;
} return int ret_i;
given notes_base given edge_fixture (0, (import fixture_fn)):(4) then calls ut_range:("fx_target", (import fixture_fn), (import fixture_fn))
given notes_base given edge_fixture (1, (import edge_caller_fn)):(8) then calls ut_range:("edge_caller", (import edge_caller_fn), (import edge_caller_fn))

ut_range(string fname, int lo, int hi) {
  while(lo <= hi) {
    ut_node(fname, lo);
    lo = lo + 1;
  }
} return void;
given fn_fixture ("f", 0, 0):() then calls ut_node:[1]
given fn_fixture ("f", 0, 2):() then calls ut_node:[3]

// A call, or a function named as a value: the two ways scan_reach reaches a
// function (mid/names/exports/reach/dead/more/scan.id), since a value may be
// called wherever it is passed.
//
// Refused: the only branch reachable without a case's `given` also running
// ut_mark (../mark/, see ut_func's note above for why) is "not call/var",
// which never calls ut_callee at all -- two cases of it would both stay
// green with the `if` deleted outright, which is the decorative case
// docs/TESTS.md warns against. fnval_fixture (mid/types/registry/table/
// fixture/varnode.id), the only "var" node this lane has, does not run
// ut_mark either.
ut_node(string fname, int id) {
  if(k_of(id) == "call" || k_of(id) == "var") {
    string s1_of_v = s1_of(id);
    ut_callee(fname, s1_of_v);
  }
} return void;
given fn_fixture ("f", (import fixture_zero)):() then calls ut_callee:[0]
given ut_host_seeded given fnval_fixture given init_asm ("somefn", (import fnval_hit)):() then calls ut_callee:("somefn", "fx_target")
