// A case that would never run is an error at the case: one under a function
// that cannot be tested on the build host, or one naming a setup, a check or a
// function value that cannot. Like the other case checks it is decided whether
// or not the minimum is on, because a case that cannot run is wrong either way.

// Refused: ut_case reads casegiven[ci] unconditionally (below), which traps
// unless a case's `given` populated it -- only wrap_fixture (back/tgt/c/emit/
// prog/test/case/around/then/more/capture/pre/fixture.id) gives casefn/
// casenode a real entry, and it does not touch casegiven; impcase_empty/
// impcase_given (../../../fit/fit.id, .../more/value/more/text/items.id)
// give casegiven but not casefn/casenode. No fixture combines the two, and
// the lane's free function slots are already spent (see ut_note's note,
// ../why/note.id, for the same kind of gap).
ut_case(int ci) {
  string s1_of_v = s1_of((import casefn)[ci]);
  ut_case_fn(ci, s1_of_v);
  string setup_nm = (import casegiven)[ci];
} chain (int ci) {
  if(setup_nm != "" && ut_at(setup_nm) >= 0) {
    ut_named(ci, "'given' names '", setup_nm);
  }
  int[] args = l1_of((import casenode)[ci]);
  int j = 0;
} chain (int ci) {
  while(j < len(args)) {
    ut_case_val(ci, args[j]);
    j = j + 1;
  }
} return void;
given notes_base given void_call_fixture (0):() then calls ut_case_fn:(0, "fx_target") then calls ut_case_val:(0, (import fixture_zero))
given notes_base given void_call_fixture (1):() then calls ut_case_fn:(1, "bare") then calls ut_case_val:[0]

// ut_at (../../why/why.id) traps unless a case's `given` also ran ut_mark
// (../mark/), which case_fixture/wrap_fixture never do; notes_base (mid/
// form/decomp/notesfx.id) does, and case_err's own branch here needs no case
// index at all when ut_at is negative (the only outcome an empty utname can
// give), so it is enough on its own.
ut_case_fn(int ci, string name) {
  if(ut_at(name) >= 0) {
    string ut_why_v = ut_why(name);
    case_err(ci, "'" + name + "' " + ut_why_v + "; this case would never run, and a function that cannot be tested needs none");
  }
} return void;
given notes_base (0, "fx_target"):() then calls ut_at:[1]
given notes_base (0, "fx_target"):() then check_failed:(0)
