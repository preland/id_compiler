// A case that would never run is an error at the case: one under a function
// that cannot be tested on the build host, or one naming a setup, a check or a
// function value that cannot. Like the other case checks it is decided whether
// or not the minimum is on, because a case that cannot run is wrong either way.

// Refused: ut_case reads casegiven[ci] unconditionally (below), which traps
// unless a case's `given` populated it -- only wrap_fixture (back/tgt/c/emit/
// prog/test/case/around/then/more/capture/pre/fixture.id) gives casefn/
// casenode a real entry, and it does not touch casegiven; impcase_empty/
// impcase_given (../../../fit/case.id, .../more/value/more/text/items.id)
// give casegiven but not casefn/casenode. No fixture combines the two, and
// the lane's free function slots are already spent (see ut_note's note,
// ../why/note.id, for the same kind of gap).
ut_case(int ci) {
  string s1_of_v = (import ns1)[((import casefn)[ci])];
  ut_case_fn(ci, s1_of_v);
  string setup_nm = (import casegiven)[ci];
} chain (int ci) {
  if(setup_nm != "" && find_str((import utname), setup_nm) >= 0) {
    ut_named(ci, "'given' names '", setup_nm);
  }
  int[] args = (import nl1)[((import casenode)[ci])];
  int j = 0;
} chain (int ci) {
  while(j < len(args)) {
    ut_case_val(ci, args[j]);
    j = j + 1;
  }
} return void;
given notes_base {
  given void_call_fixture (0):() then calls ut_case_fn:(0, "fx_target") then calls ut_case_val:(0, (import fixture_zero))
  given void_call_fixture (1):() then calls ut_case_fn:(1, "bare") then calls ut_case_val:[0]
}

// ut_at (../../why/reason.id) traps unless a case's `given` also ran ut_mark
// (../mark/), which case_fixture/wrap_fixture never do; notes_base (mid/
// form/decomp/notesfx.id) does, and case_err's own branch here needs no case
// index at all when ut_at is negative (the only outcome an empty utname can
// give), so it is enough on its own.
ut_case_fn(int ci, string name) {
  if(find_str((import utname), name) >= 0) {
    string ut_why_v = ut_why(name);
    string ut_tail_v = ut_case_tail(name);
    case_err(ci, "'" + name + "' " + ut_why_v + "; " + ut_tail_v);
  }
} return void;
given ut_host_seeded given case_fixture given ut_add("fx_target", "asm 'in8'", "*") (0, "fx_target"):() then (import chkfail)[0]:(1)
given ut_host_seeded given case_fixture given ut_add("bare", "asm 'in8'", "*") (0, "bare"):() then (import chkfail)[0]:(1)
given notes_base (0, "fx_target"):() then calls find_str:[1]
given notes_base (0, "fx_target"):() then (import chkfail)[0]:(0)

// The index of a `then (import NAME)[i]:(value)`: an int literal, or an
// `(import NAME)` that names a conf.id constant (the checker's then_imp_value
// sends it here). A constant only says where to look, and the value it is
// compared with stays a literal, so the case cannot agree with itself; an
// exported variable there would be a read of the very state under test, and
// is refused.
fit_then_ix(int ci, int ix_node) {
  string ix_nm = (import ns1)[ix_node];
  int ek = find_str((import enames), ix_nm);
  if((import nkind)[ix_node] != "cimport") {
    fit_value(ci, ix_node, "int");
  }
} chain (int ci, int ix_node) {
  if((import nkind)[ix_node] == "cimport" && ek < 0) {
    case_err(ci, "(import " + ix_nm + "): '" + ix_nm + "' is not an exported variable or a conf.id constant");
  }
  if((import nkind)[ix_node] == "cimport" && ek >= 0 && (import eowners)[ek] != "conf.id") {
    case_err(ci, "(import " + ix_nm + ") is an exported variable, and only a conf.id constant may stand in a then check's index: a variable's value is what the check is testing; name a constant, or write the index as a number");
  }
  if((import nkind)[ix_node] == "cimport" && ek >= 0 && (import eowners)[ek] == "conf.id" && (import etypes)[ek] != "int") {
    case_err(ci, "this case gives (import " + ix_nm + "), a " + (import etypes)[ek] + ", where a int is required");
  }
} return void;
given then_imp_fixture ("int", 0, 0) ((import fixture_ci), (import then_imp_cix)):() then prints:("fixture.id:4: error: (import gx) is an exported variable, and only a conf.id constant may stand in a then check's index: a variable's value is what the check is testing; name a constant, or write the index as a number\n")
given then_imp_fixture ("string", 0, 0) given string_list_set((import eowners), 0, "conf.id") ((import fixture_ci), (import then_imp_cix)):() then prints:("fixture.id:4: error: this case gives (import gx), a string, where a int is required\n")
