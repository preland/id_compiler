// The bodies of the two compound statements. A loop body and each arm of an
// if are one level deeper than the block that holds them.
//
// An `else if` chain is *not* deeper: idc.py walks the whole chain at the
// depth of the first if, checking each `then` one level down, so a chained
// if is handed straight back to check_if with the depth unchanged.

check_loop(int id, int depth, string fname) {
  if((import nkind)[id] == "while") {
    int[] l1_of_v = (import nl1)[id];
    check_block(l1_of_v, depth + 1, fname, (import nline)[id]);
  }
} return void;
