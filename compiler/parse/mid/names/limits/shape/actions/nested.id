check_if(int id, int depth, string fname) {
  int[] l1_of_v = l1_of(id);
  check_block(l1_of_v, depth + 1, fname, (import nline)[id]);
  int[] els = l2_of(id);
} chain (int id, int depth, string fname) {
  if(i2_of(id) == 1) {
    check_if(els[0], depth, fname);
  } else {
    check_plain_else(els, depth, fname, (import nline)[id]);
  }
} return void;
