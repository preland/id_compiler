// The bodies of the two compound statements. A loop body and each arm of an
// if are one level deeper than the block that holds them.
//
// An `else if` chain is *not* deeper: idc.py walks the whole chain at the
// depth of the first if, checking each `then` one level down, so a chained
// if is handed straight back to check_if with the depth unchanged.

check_loop(int id, int depth, string fname) {
  if(k_of(id) == "while") {
    int[] l1_of_v = l1_of(id);
    check_block(l1_of_v, depth + 1, fname, (import nline)[id]);
  }
} return void;
given elif_fixture ((import while_node), 2, "f"):() then check_failed:(1)
given elif_fixture ((import decl_node), 2, "f"):() then check_failed:(0)

// The rest of elif_fixture (../actions/else_chain.id), which ran out of
// actions. The `else if` node's else arm holds exactly one nested if -- the
// shape the parser builds -- and the statement lists are exported because an
// `(import NAME)` may be an argument but not an element of a list literal in
// a case (docs/TESTS.md).
elif_fixture2() {
  export int elif_node = node_if((import ev_node), [(import decl_node)], [(import else_node)], 1);
  export int[] elif_body = [(import elif_node)];
  elif_lists();
} return void;
