// nest_fixture (back/ir/build/func/lower/loc/loop.id) plus the two if nodes
// its own `if_node` cannot be: at_elif (front/parse/stmt/form/branch/
// else_if.id) writes 0 for no else arm, 2 for a plain `else { }` and 1 for an
// `else if`, and nest_fixture's if_node is a 0. Without a 2 and a 1 every
// function here takes only its default branch, so a case would pin nothing
// down.
elif_fixture() {
  nest_fixture();
  export int else_node = node_if((import ev_node), [(import decl_node)], [(import decl_node)], 2);
  elif_fixture2();
} return void;
