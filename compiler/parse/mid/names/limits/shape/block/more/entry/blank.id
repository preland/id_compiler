// Whether a `blank` earned its action slot.
//
// `blank` exists for one shape: a segment that must reach three actions before
// a chain, where the chain's first statement cannot be moved up to fill the
// room because it is a single node costing more than one action. Only an
// if-with-else does that -- stmt_actions (../../../actions/count.id) counts an
// `if` as 1 plus one per `else`, and every other statement as 1 -- so the set
// of unliftable statements and the set of if/else clauses are the same set,
// and the rule needs no list of blessed forms.
//
// Anywhere else the author had room to keep writing, or no chain to reach, and
// the padding is just an evasion of the action limit.
//
// Housed under entry/ because every other directory under shape/ is at the
// three-entry limit; like report_short_seg in limits/report/more/prefix.id,
// this is the only slot within reach rather than the right label.

next_cost(int[] body, int i) {
  int n = 0;
  if(i + 1 < len(body)) {
    n = stmt_actions(body[i + 1]);
  }
} return int n;
given fn_fixture ((import fixture_params), 0):(0)
given fn_fixture ((import fixture_params), 1):(0)

blank_tally(int[] acc, int id) {
  if(k_of(id) == "blank") {
    lset(acc, 1, acc[1] + 1);
  }
} return void;
given fn_fixture ([0, 0], 0):() then check_failed:(0)
given fn_fixture ([0, 1], 0):() then check_failed:(0)

// The room the segment would have had without its padding is
// 3 - (acc[0] - acc[1]); if the next statement fits in it, the blank is
// standing where real work belonged.
check_blank_use(string fname, int ln, int[] acc, int at_seam, int nxt) {
  if(acc[1] > 0 && (at_seam == 0 || nxt <= 3 - acc[0] + acc[1])) {
    string loc_at_v = loc_at(fname, ln);
    var_report(loc_at_v + "a `blank` in '" + fname + "' fills an action slot that had no need of it; `blank` is only allowed to pad a segment up to 3 actions when a chain follows and the chain's first statement is too large to move up into the segment");
  }
} return void;
given full_env ("f", 1, [3, 0], 1, 2):() then check_failed:(0)
given full_env ("f", 1, [3, 1], 0, 0):() then check_failed:(1)
