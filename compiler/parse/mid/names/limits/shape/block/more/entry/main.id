check_main_at(int m) {
  int[] ps = (import nl1)[m];
  if((import ns2)[m] != "int" || len(ps) != 2) {
    report_main();
  } else if((import ns1)[(ps[0])] != "int" || (import ns1)[(ps[1])] != "string[]") {
    report_main();
  }
} return void;
