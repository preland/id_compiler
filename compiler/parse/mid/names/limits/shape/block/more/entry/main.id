report_main() {
  int func_line_v = func_line("main");
  string loc_at_v = loc_at("main", func_line_v);
  var_report(loc_at_v + "'main' must be declared as main(int argc, string[] argv) and return int: it is the program's entry point, and its int is the exit status");
} return void;
