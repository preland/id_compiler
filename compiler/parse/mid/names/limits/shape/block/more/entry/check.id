// The two structural rules of `id`, checked on the parsed AST: every block
// performs at most 3 actions, and blocks nest at most 2 deep. Both are pure
// tree walks over the AST and the function table -- they need no type
// information and nothing from the backend, because they are rules of the
// language rather than of code generation.
//
// check_program() is the entry point: call it after parse_program. Every
// violation is printed (idc.py stops at the first; this reports them all) and
// check_failed() then answers 1.

// clean_check_fixture/full_check_fixture (mid/form/unique/dump/cases/
// checkfiles.id) give the node environment; init_rtc and reqtests_init are
// the two exports check_case_runs' own chain reads (is_freestanding via fsc,
// require_tests via reqc) that neither fixture's own env_init reaches.
check_program() {
  check_bodies();
  check_scopes();
  check_program_tail();
} return void;
given clean_check_fixture given init_rtc given reqtests_init ():() then check_failed:(0)
given full_check_fixture given init_rtc given reqtests_init ():() then check_failed:(1)

check_funcs() {
  check_main();
  int i = 0;
  while(i < len((import prog))) {
    check_func_body((import prog)[i]);
    i = i + 1;
  }
} return void;
given env_init ():() then calls check_main:[1] then calls check_func_body:[0]
given fn_fixture ():() then calls check_main:[1] then calls check_func_body:[1]

// A function's own body is the outermost block, at depth 0. Its name labels
// every diagnostic found anywhere inside it, as in idc.py.
check_func_body(int id) {
  int[] l2_of_v = l2_of(id);
  string s1_of_v = s1_of(id);
  int func_line_v = func_line(s1_of_v);
} chain (int id) {
  check_block(l2_of_v, 0, s1_of_v, func_line_v);
  check_segs(l2_of_v, s1_of_v, func_line_v);
} return void;
given fn_fixture ((import fixture_fn)):() then calls check_block:([], 0, "fx_target", 1) then calls check_segs:([], "fx_target", 1)
given edge_fixture ((import fixture_fn)):() then calls check_block:([], 0, "fx_target", 7) then calls check_segs:([], "fx_target", 7)
