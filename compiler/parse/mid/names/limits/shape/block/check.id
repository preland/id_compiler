// Checking one block, mirroring idc.py's check_block exactly.
//
// The depth test comes first and takes over the block completely: a block that
// is too deep is reported for that and nothing else -- its action count is not
// examined and its children are not visited, which is what idc.py does by
// raising there. A block that is deep enough to check is then measured, and
// its compound statements are walked one level down.

// `ln` is the line of the construct that *owns* this block -- the function's
// declaration for a body, the `if` or `while` for its arms -- not the line of
// the first statement inside it. That is what idc.py reports, and pointing at
// the owner is more useful anyway: it names the construct that is too long.
check_block(int[] body, int depth, string fname, int ln) {
  if(depth > 2) {
    limit_diag(fname, ln, "E0202", "code in '" + fname + "' is nested too deeply (" + depth + " levels); the maximum is 2", (import lim_deep_why), (import lim_deep_help));
  } else {
    check_fits(body, depth, fname, ln);
  }
} return void;
given env_init ([], 3, "f", 5):() then calls limit_diag:[1]
([], 2, "f", 5):() then calls check_fits:([], 2, "f", 5)

check_fits(int[] body, int depth, string fname, int ln) {
  check_count(body, depth, fname, ln);
  int i = 0;
  while(i < len(body)) {
    check_stmt(body[i], depth, fname);
    i = i + 1;
  }
} return void;
([], 0, "f", 5):() then calls check_count:([], 0, "f", 5) then calls check_stmt:[0]
given edge_fixture ((import edge_body), 0, "f", 5):() then calls check_count:((import edge_body), 0, "f", 5) then calls check_stmt:((import edge_call_node), 0, "f") then calls check_stmt:((import edge_var_node), 0, "f")

// Only a nested block is counted here. A function's own body arrives at depth
// 0, and check_segs (more/seg.id) measures it a segment at a time, so counting
// the whole body here as well would report a chained function twice -- for a
// concatenated total it never wrote -- and an ordinary one twice over.
check_count(int[] body, int depth, string fname, int ln) {
  int n = count_actions(body);
  if(n > 3 && depth > 0) {
    limit_diag(fname, ln, "E0201", "a block in '" + fname + "' performs " + n + " actions; the limit is 3 (each statement, if, else, and while is one action; return is free)", (import lim_actions_why), (import lim_actions_help));
  }
} return void;
