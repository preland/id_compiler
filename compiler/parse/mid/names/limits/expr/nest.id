has_call(int e) {
  int ok = 0;
  if(k_of(e) == "call") {
    int[] l1_of_v = l1_of(e);
    ok = 1 + hc_list(l1_of_v);
  } else {
    ok = hc_kids(e);
  }
} return int ok;
