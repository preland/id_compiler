chk_flat_at(int id, int i) {
  int a = l1_of(id)[i];
  if(has_call(a) > 1) {
    string s1_of_v = s1_of(id);
    tc_err(a, "argument " + i + " of '" + s1_of_v + "' has a call nested inside a call; an argument may hold one level of call, not two -- name the inner call's result and pass the name");
  }
  int ret_i = i + 1;
} return int ret_i;
