// Descending into the kinds that have children, and naming a kind in English
// for the diagnostic.
//
// The chain splits at three because a block holds three actions, which is the
// same reason the code being checked has to.

hc_kids(int e) {
  int ok = hc_more(e);
  if((import nkind)[e] == "bin" || (import nkind)[e] == "index") {
    int i1_of_v = (import ni1)[e];
    int i2_of_v = (import ni2)[e];
    ok = hc_pair(i1_of_v, i2_of_v);
  }
} return int ok;
given hidden_call_fixture {
  ((import hc_un)):(1)
  ((import hc_call)):(0)
}

hc_more(int e) {
  int ok = 0;
  if((import nkind)[e] == "un") {
    int i1_of_v = (import ni1)[e];
    ok = has_call(i1_of_v);
  } else if((import nkind)[e] == "arr") {
    int[] l1_of_v = (import nl1)[e];
    ok = hc_list(l1_of_v);
  }
} return int ok;
given hidden_call_fixture {
  ((import hc_un)):(1)
  ((import hc_call)):(0)
}

hc_pair(int a, int b) {
  int ok = has_call(a);
  int ok_b = has_call(b);
  if(ok_b > ok) {
    ok = ok_b;
  }
} return int ok;
