// The diagnostic for a return clause that is not a name or a literal.
//
// It names what the clause *is*, because "must be a name or a literal" on its
// own leaves the author looking for which part is the problem when the clause
// is long.

ret_shape_err(int id, int e) {
  string s1_of_v = (import ns1)[id];
  string shape_word_v = shape_word(e);
  tc_err(e, "the return clause of '" + s1_of_v + "' is " + shape_word_v + "; it must be a name or a literal -- name the value in the body and return the name");
} return void;
given fn_fixture ((import fixture_fn), (import fixture_zero)):() then prints:("<stdin>:1: error: the return clause of 'fx_target' is an expression; it must be a name or a literal -- name the value in the body and return the name\n")
given fn_fixture ((import fixture_zero), (import fixture_zero)):() then prints:("<stdin>:1: error: the return clause of '0' is an expression; it must be a name or a literal -- name the value in the body and return the name\n")

shape_word(int e) {
  string w = "an expression";
  if((import nkind)[e] == "call") {
    w = "a call";
  } else if((import nkind)[e] == "arr") {
    w = "a list literal";
  }
} return string w;
given lencall_fixture ((import lencall_node)):("a call")
given arith_fixture ((import ev_node)):("an expression")

