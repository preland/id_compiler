// The diagnostic for a return clause that is not a name or a literal.
//
// It names what the clause *is*, because "must be a name or a literal" on its
// own leaves the author looking for which part is the problem when the clause
// is long.

ret_shape_err(int id, int e) {
  string s1_of_v = (import ns1)[id];
  string shape_word_v = shape_word(e);
  tc_diag(e, "E0206", "the return clause of '" + s1_of_v + "' is " + shape_word_v + "; it must be a name or a literal", s1_of_v, "a return clause is a name or a literal so the reader sees what is returned without evaluating anything", "name the value in the body and return the name");
} return void;
given fn_fixture {
  ((import fixture_fn), (import fixture_zero)):() then prints:("<stdin>:1: error: the return clause of 'fx_target' is an expression; it must be a name or a literal [E0206]\n  at: fx_target\n  why: a return clause is a name or a literal so the reader sees what is returned without evaluating anything\n  help: name the value in the body and return the name\n")
  ((import fixture_zero), (import fixture_zero)):() then prints:("<stdin>:1: error: the return clause of '0' is an expression; it must be a name or a literal [E0206]\n  at: 0\n  why: a return clause is a name or a literal so the reader sees what is returned without evaluating anything\n  help: name the value in the body and return the name\n")
}

shape_word(int e) {
  string w = "an expression";
  if((import nkind)[e] == "call") {
    w = "a call";
  } else if((import nkind)[e] == "arr") {
    w = "a list literal";
  }
} return string w;
given lencall_fixture ((import lencall_node)):("a call")
given arith_fixture ((import ev_node)):("an expression")


// What one statement writes. A call writes what it is handed (only `len` is
// known not to), `name = v` writes name, `name[i] = v` and `name.f = v` write
// what name is a path into, and a declaration that binds a list or a struct to a
// variable, or a path into one, lets the variable write it (the rules
// node_import_use, given/then/more/calls/fit/use.id, applies to an import).
// The declaring statement itself, `export T name = v`, writes nothing.
wr_node(int nd, string wr_fname) {
  string wr_kd = (import nkind)[nd];
  if(wr_kd == "call" && (import ns1)[nd] != "len") {
    wr_args(nd, wr_fname);
  }
  if(wr_kd == "assign") {
    wr_row("v:" + (import ns1)[nd], wr_fname);
  }
} chain (int nd, string wr_fname) {
  if(wr_kd == "iassign") {
    wr_root((import ni1)[nd], wr_fname);
  }
  if(wr_kd == "decl" && (import ni2)[nd] == 0 && (ty_is_list((import ns1)[nd]) == 1 || sd_nfields((import ns1)[nd]) > 0)) {
    wr_root((import ni1)[nd], wr_fname);
  }
} return void;
given imp_use_fixture {
  given wr_build ((import imp_use_call), "f"):() then (import wrx):(["i:gx"])
  given wr_build ((import imp_use_len), "f"):() then len((import wrx)):(0)
}
