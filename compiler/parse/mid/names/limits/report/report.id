// A trailing `else { ... }`, and the two diagnostics.
//
// The message text is idc.py's, word for word, and now so is the file:line
// prefix -- the lexer emits line markers and the parser records, per
// statement, the line it began on.

check_plain_else(int[] els, int depth, string fname, int ln) {
  if(len(els) > 0) {
    check_block(els, depth + 1, fname, ln);
  }
} return void;

report_actions(string fname, int n, int ln) {
  string loc_at_v = loc_at(fname, ln);
  print(loc_at_v + "a block in '" + fname + "' performs " + n + " actions; the limit is 3 (each statement, if, else, and while is one action; return is free) -- continue the function into a chain: `} chain (same parameters) {`");
  note_failure();
} return void;

report_deep(string fname, int depth, int ln) {
  string loc_at_v = loc_at(fname, ln);
  print(loc_at_v + "code in '" + fname + "' is nested too deeply (" + depth + " levels); the maximum is 2. Split the inner block into its own function");
  note_failure();
} return void;
given edge_fixture ("fx_target", 3, 4):() then prints:("fixture.id:4: error: code in 'fx_target' is nested too deeply (3 levels); the maximum is 2. Split the inner block into its own function\n")
given edge_fixture ("nosuchfn", 4, 9):() then prints:("<stdin>:9: error: code in 'nosuchfn' is nested too deeply (4 levels); the maximum is 2. Split the inner block into its own function\n")
