// The `file:line: error: ` prefix for a diagnostic about function `fname`.
// Looked up rather than threaded: every check would otherwise need to carry a
// file alongside the depth and the function name, and diagnostics are rare
// enough that a linear scan costs nothing.
//
loc_at(string fname, int ln) {
  string ret_s = func_file(fname) + ":" + ln + ": error: ";
} return string ret_s;
given edge_fixture ("fx_target", 4):("fixture.id:4: error: ")
given edge_fixture ("nosuchfn", 9):("<stdin>:9: error: ")

// A chain continues a function that has run out of room, so a segment that
// still had room should have kept writing rather than starting a new one.
// Housed here because every file under shape/block/ and shape/actions/ is at
// the three-function limit and this was the only slot within reach; it is an
// imperfect fit for a file otherwise about the `file:line:` prefix.
report_short_seg(string fname, int n, int ln) {
  string seg_where = diag_fn_loc(fname, ln);
  string seg_msg = "a segment of '" + fname + "' performs " + n + " actions and is then continued by a chain; a chain may only follow a segment that used all 3 actions";
  diag("E0204", seg_where, seg_msg, "", "a function has one way to continue past the action limit, so a chain is only for a segment that has run out of room (docs/SPEC.md, section 9)", "move the chain's work into this segment instead: a segment that still has room should keep writing rather than starting a new one");
} return void;
given edge_fixture ("fx_target", 2, 4):() then prints:("fixture.id:4: error: a segment of 'fx_target' performs 2 actions and is then continued by a chain; a chain may only follow a segment that used all 3 actions [E0204]\n  why: a function has one way to continue past the action limit, so a chain is only for a segment that has run out of room (docs/SPEC.md, section 9)\n  help: move the chain's work into this segment instead: a segment that still has room should keep writing rather than starting a new one\n")
given edge_fixture ("nosuchfn", 1, 9):() then prints:("<stdin>:9: error: a segment of 'nosuchfn' performs 1 actions and is then continued by a chain; a chain may only follow a segment that used all 3 actions [E0204]\n  why: a function has one way to continue past the action limit, so a chain is only for a segment that has run out of room (docs/SPEC.md, section 9)\n  help: move the chain's work into this segment instead: a segment that still has room should keep writing rather than starting a new one\n")

// What a statement's expression is a path into: its root is an (import NAME) or
// a bare variable name, recorded as a write of that variable by `wr_fname`.
wr_root(int wr_x, string wr_fname) {
  int wr_rt = imp_root(wr_x);
  if((import nkind)[wr_rt] == "import") {
    wr_row("i:" + (import ns1)[wr_rt], wr_fname);
  }
  if((import nkind)[wr_rt] == "var") {
    wr_row("v:" + (import ns1)[wr_rt], wr_fname);
  }
} return void;
given imp_use_fixture given wr_build ((import imp_use_deep), "f"):() then (import wrx):(["i:gx"])
given sd_use_fixture given wr_build ((import sd_vp), "g"):() then (import wrf):(["g"])
