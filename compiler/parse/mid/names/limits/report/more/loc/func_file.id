// The file a function was declared in, from the parallel `pfile` list.
func_file(string fname) {
  int i = 0;
  string s = "<stdin>";
  while(i < len((import prog))) {
    s = func_file_at(i, fname, s);
    i = i + 1;
  }
} return string s;
given edge_fixture ("fx_target"):("fixture.id")
given edge_fixture ("nosuchfn"):("<stdin>")

func_file_at(int i, string fname, string s) {
  string fpath = s;
  if((import ns1)[((import prog)[i])] == fname && i < len((import pfile))) {
    fpath = (import pfile)[i];
  }
} return string fpath;
given edge_fixture (0, "fx_target", "<stdin>"):("fixture.id")
given edge_fixture (0, "nosuchfn", "<stdin>"):("<stdin>")

// note_failure sets chkfail, but only env_init declares it, so neither alone
// is a legal setup for a case that wants the flag already raised: called bare
// note_failure traps, and env_init alone leaves the flag at 0. Composing them
// is the only way to reach chkfail == 1 from a no-argument setup.
chkfail_raised() {
  env_init();
  note_failure();
} return void;
():() then (import chkfail)[0]:(1)
():() then (import chkfail):([1])
():() then init_units:(0)
