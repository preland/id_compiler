// The line a function was declared on, from the parallel `pline` list.
func_line(string fname) {
  int hit = fast_line(fname);
  int n = line_scan(hit, fname);
} return int n;
given fast_line_fixture {
  ("fx_target"):(7)
  ("nosuchfn"):(1)
}

func_line_at(int i, string fname, int n) {
  int r = n;
  if((import ns1)[((import prog)[i])] == fname && i < len((import pline))) {
    r = (import pline)[i];
  }
} return int r;
given edge_fixture {
  (0, "fx_target", 1):(7)
  (0, "nosuchfn", 1):(1)
}

// One row of --calls' case-count section for an asm declaration:
// `name|file:line|0`, case count fixed at 0 since an asm function has no
// cases to count. aloc already holds "file:line" (push_asm, front/parse/
// decl/top/decl/more.id); print_asm_cases (back/drive/run/check/dce/emit/
// guard/guarded_emit.id) prints one of these per entry -- filed here rather
// than beside afname (front/parse/decl/kinds/asm/) or print_call_cases (back/
// drive/run/check/dce/emit/calls/cases.id), both at their 3-function cap.
asm_case_row(int i) {
  string loc = (import aloc)[i];
  string ret_s = (import afname)[i] + "|" + loc + "|0";
} return string ret_s;
given asm_row_fixture {
  (0):("foo|<stdin>:1|0")
  (1):("bar|<stdin>:1|0")
}
