
file_hit(int i, string name) {
  int n = 0;
  if((import pfile)[i] == name) {
    n = 1;
  }
} return int n;
given edge_fixture (0, "fixture.id"):(1)
given edge_fixture (0, "other.id"):(0)

first_of_file(int i) {
  int n = 0;
  int r = 1;
  while(n < i) {
    r = r - file_hit(n, (import pfile)[i]);
    n = n + 1;
  }
} return int r;
given edge_fixture (0):(1)
given edge_fixture (1):(0)

report_funcs(string name, int n) {
  string funcs_msg = "too many functions in this file (" + n + "); the limit is 3 per file";
  string funcs_help = "move " + (n - 3) + " of its functions into another file in the same directory, named for what those functions do";
  diag("E0203", name + ":1", funcs_msg, "", "a file holds at most three functions so that the tree, not the file, carries the structure, and no file grows into a place where unrelated code gathers (docs/PROJECT.md)", funcs_help);
} return void;
given edge_fixture ("a.id", 4):() then prints:("a.id:1: error: too many functions in this file (4); the limit is 3 per file [E0203]\n  why: a file holds at most three functions so that the tree, not the file, carries the structure, and no file grows into a place where unrelated code gathers (docs/PROJECT.md)\n  help: move 1 of its functions into another file in the same directory, named for what those functions do\n")
given edge_fixture ("b.id", 9):() then prints:("b.id:1: error: too many functions in this file (9); the limit is 3 per file [E0203]\n  why: a file holds at most three functions so that the tree, not the file, carries the structure, and no file grows into a place where unrelated code gathers (docs/PROJECT.md)\n  help: move 6 of its functions into another file in the same directory, named for what those functions do\n")
