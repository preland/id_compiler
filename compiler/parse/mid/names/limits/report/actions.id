// A trailing `else { ... }`, and the two diagnostics.
//
// The message text is idc.py's, word for word, and now so is the file:line
// prefix -- the lexer emits line markers and the parser records, per
// statement, the line it began on.

check_plain_else(int[] els, int depth, string fname, int ln) {
  if(len(els) > 0) {
    check_block(els, depth + 1, fname, ln);
  }
} return void;
([], 0, "f", 5):() then calls check_block:[0]
given env_init ([7], 2, "f", 5):() then calls check_block:([7], 3, "f", 5)

// A limit diagnostic: the code, the message (built by the check, which knows the
// count or the depth), and the why and help lines (conf.id, lim_*). One function
// for the three, not one per limit.
limit_diag(string fname, int ln, string lcode, string lmsg, string lwhy, string lhelp) {
  string lim_where = diag_fn_loc(fname, ln);
  diag(lcode, lim_where, lmsg, "", lwhy, lhelp);
} return void;
given edge_fixture ("fx_target", 4, "E0201", "m", "w", "h"):() then prints:("fixture.id:4: error: m [E0201]\n  why: w\n  help: h\n")
given edge_fixture ("nosuchfn", 9, "E0204", "msg", "why", "help"):() then prints:("<stdin>:9: error: msg [E0204]\n  why: why\n  help: help\n")
