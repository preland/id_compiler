// A trailing `else { ... }`, and the two diagnostics.
//
// The message text is idc.py's, word for word, and now so is the file:line
// prefix -- the lexer emits line markers and the parser records, per
// statement, the line it began on.

check_plain_else(int[] els, int depth, string fname, int ln) {
  if(len(els) > 0) {
    check_block(els, depth + 1, fname, ln);
  }
} return void;
([], 0, "f", 5):() then calls check_block:[0]
given env_init ([7], 2, "f", 5):() then calls check_block:([7], 3, "f", 5)

report_actions(string fname, int n, int ln) {
  string at_where = diag_fn_loc(fname, ln);
  string at_msg = "a block in '" + fname + "' performs " + n + " actions; the limit is 3 (each statement, if, else, and while is one action; return is free)";
  diag("E0201", at_where, at_msg, "", "a block that does more than three things is hard to read and to test at a glance, so the language caps it; a chain is the one way to continue a function past the cap without hiding that it does", "continue the function into a chain: end this segment with `} chain (same parameters) {` and write the remaining statements after it (docs/SPEC.md, section 9), or move part of the block into its own function");
} return void;
given edge_fixture ("fx_target", 4, 4):() then prints:("fixture.id:4: error: a block in 'fx_target' performs 4 actions; the limit is 3 (each statement, if, else, and while is one action; return is free) [E0201]\n  why: a block that does more than three things is hard to read and to test at a glance, so the language caps it; a chain is the one way to continue a function past the cap without hiding that it does\n  help: continue the function into a chain: end this segment with `} chain (same parameters) {` and write the remaining statements after it (docs/SPEC.md, section 9), or move part of the block into its own function\n")
given edge_fixture ("nosuchfn", 5, 9):() then prints:("<stdin>:9: error: a block in 'nosuchfn' performs 5 actions; the limit is 3 (each statement, if, else, and while is one action; return is free) [E0201]\n  why: a block that does more than three things is hard to read and to test at a glance, so the language caps it; a chain is the one way to continue a function past the cap without hiding that it does\n  help: continue the function into a chain: end this segment with `} chain (same parameters) {` and write the remaining statements after it (docs/SPEC.md, section 9), or move part of the block into its own function\n")

report_deep(string fname, int depth, int ln) {
  string deep_where = diag_fn_loc(fname, ln);
  string deep_msg = "code in '" + fname + "' is nested too deeply (" + depth + " levels); the maximum is 2";
  diag("E0202", deep_where, deep_msg, "", "three open conditions or loops at once is more than a reader can hold in mind, so the language caps nesting at two levels", "move the innermost block into its own function and call it from here; the new function gets its own two levels and its own test cases");
} return void;
given edge_fixture ("fx_target", 3, 4):() then prints:("fixture.id:4: error: code in 'fx_target' is nested too deeply (3 levels); the maximum is 2 [E0202]\n  why: three open conditions or loops at once is more than a reader can hold in mind, so the language caps nesting at two levels\n  help: move the innermost block into its own function and call it from here; the new function gets its own two levels and its own test cases\n")
given edge_fixture ("nosuchfn", 4, 9):() then prints:("<stdin>:9: error: code in 'nosuchfn' is nested too deeply (4 levels); the maximum is 2 [E0202]\n  why: three open conditions or loops at once is more than a reader can hold in mind, so the language caps nesting at two levels\n  help: move the innermost block into its own function and call it from here; the new function gets its own two levels and its own test cases\n")
