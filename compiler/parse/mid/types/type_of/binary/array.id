  int[] l1_of_v = (import nl1)[id];
  if(len(l1_of_v) > 0) {
    int[] l1_of_v2 = (import nl1)[id];
    t = type_of(l1_of_v2[0]) + "[]";
  }
} chain (int id) {
  if(bytes_slot(id) == 1) {
    t = "bytes";
  }
} return string t;
