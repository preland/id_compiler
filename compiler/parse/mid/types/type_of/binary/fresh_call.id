// The call half of str_fresh: the builtins that make a new string block, and
// the functions of the program that return a fresh one (escape/flow/sum/fresh/).

str_fresh_call(int id) {
  int ok = 0;
  if((import nkind)[id] == "call" && is_builtin((import ns1)[id]) == 1) {
    ok = fresh_builtin((import ns1)[id]);
  } else {
    ok = esc_fresh_call(id);
  }
} return int ok;
