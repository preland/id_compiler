// Concatenation test: whether `+` is string concatenation rather than
// arithmetic. Whether an operand needs coercing to string is a language
// question; what it coerces to is C, and lives in back/ (to_str).

is_concat(int id) {
  int ok = 0;
  if((import ns1)[id] == "+" && one_is_str(id)) {
    ok = 1;
  }
} return int ok;
given composite_fixture {
  ((import bin_concat)):(1)
  ((import bin_plus)):(0)
}

one_is_str(int id) {
  int i1_of_v = (import ni1)[id];
  int i2_of_v = (import ni2)[id];
  int ok = is_str_pair(i1_of_v, i2_of_v);
} return int ok;
given composite_fixture {
  ((import bin_concat)):(1)
  ((import bin_plus)):(0)
}

is_str_pair(int a, int b) {
  int ok = 0;
  if(type_of(a) == "string" || type_of(b) == "string") {
    ok = 1;
  }
} return int ok;
given leaves_fixture {
  ((import lit_str), (import lit_a)):(1)
  ((import lit_a), (import lit_b)):(0)
}
