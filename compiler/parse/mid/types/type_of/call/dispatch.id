// call/bin dispatch, and the return type of a called name.

type_of4(int id) {
  string t = type_of5(id);
  if(k_of(id) == "call") {
    t = call_type(id);
  }
} return string t;
given shapes_fixture ((import call_len)):("int")
given composite_fixture ((import bin_plus)):("int")

type_call(string name) {
  string t = builtin_type(name);
  if(t == "?") {
    t = lookup_func(name);
  }
} return string t;
("len"):("int")
given fn_idx_fixture ("nope"):("")

// return type of a builtin, or "?" if `name` is not a builtin
builtin_type(string name) {
  string t = "?";
  if(name == "print" || name == "eprint") {
    t = "void";
  } else {
    t = bt2(name);
  }
} return string t;
("print"):("void")
("len"):("int")
