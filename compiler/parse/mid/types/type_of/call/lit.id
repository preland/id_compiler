// The type of an integer literal: `word` when it does not fit an int (the
// parser recorded that in ni2), otherwise `int`.

lit_type(int id) {
  string t = "int";
  if((import ni2)[id] == 1) {
    t = "word";
  }
} return string t;
given leaves_fixture ((import lit_a)):("int")
given leaves_fixture ((import lit_word)):("word")

// A call's result type. Every builtin's type follows from its name except
// pop's and bind's (builtin/poke.id's call_shaped); a call through a variable
// of function type has that type's return type.
call_type(int id) {
  string s1_of_v = (import ns1)[id];
  string t = call_ret(id, s1_of_v);
  string t2 = call_shaped(id, t);
} return string t2;
given shapes_fixture ((import call_len)):("int")
given idx_build ((import call_pop)):("int")

pop_elem(int id) {
  int[] l1_of_v = (import nl1)[id];
  string type_of_v = type_of(l1_of_v[0]);
  string ret_s = elem_type(type_of_v);
} return string ret_s;
given idx_build ((import call_pop)):("int")
given strarr_fixture ((import call_pop_str)):("string")
