// Return types of the systems builtins: the flat store, the unsigned-word
// operations, and the two bridges between the store and id's strings.

bt4(string name) {
  string t = bt5(name);
  if(is_wordfn(name) || name == "mem_of_str" || name == "bits_of_float" || name == "bits32_of_float") {
    t = "word";
  }
} return string t;
("alloc"):("word")
("poke32"):("void")
("bits_of_float"):("word")
("bits32_of_float"):("word")

bt5(string name) {
  string t = bt6(name);
  if(str_in((import pokefns), name)) {
    t = "void";
  } else if(name == "float_of_bits" || name == "float_of_bits32") {
    t = "float";
  }
} chain (string name) {
  if(name == "bind") {
    t = "func";
  }
} return string t;
("poke32"):("void")
("alloc"):("?")
("float_of_bits"):("float")
("float_of_bits32"):("float")
("bind"):("func")
("bytes_sub"):("bytes")
("bytes_append"):("void")

// Builtins yielding a machine word. `ult` is not among them -- it answers a
// question, so it is an int like every other comparison.
is_wordfn(string name) {
  int ok = 0;
  if(name == "alloc" || name == "store_size" || name == "peek8" || name == "peek16" || name == "peek32" || name == "peek64" || name == "peek8s" || name == "peek16s" || name == "peek32s" || name == "peek8u" || name == "peek16u" || name == "peek32u" || name == "udiv" || name == "umod" || name == "ushr" || name == "rotl" || name == "umul_hi" || name == "uword_of_int") {
    ok = 1;
  }
} return int ok;
("alloc"):(1)
("ult"):(0)
("rotl"):(1)
("umul_hi"):(1)
("uword_of_int"):(1)
("peek32s"):(1)
("peek8u"):(1)
