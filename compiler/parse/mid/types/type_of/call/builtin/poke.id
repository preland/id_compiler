// A call's type once the name has said what it can: pop's is the element type
// of the list it was handed, and bind's is its first argument's function type
// less the values it fixes. Neither follows from the name alone.
call_shaped(int id, string t) {
  string ret_s = t;
  if((import ns1)[id] == "pop") {
    ret_s = pop_elem(id);
  }
  if((import ns1)[id] == "bind") {
    ret_s = bind_type(id);
  }
} chain (int id, string t) {
  if((import ns1)[id] == "rotl") {
    ret_s = rotl_type(id);
  }
  if(is_checked_op((import ns1)[id]) == 1) {
    ret_s = checked_type(id);
  }
} return string ret_s;
given idx_build ((import call_pop), "?"):("int")
given bind_fixture ((import bind_ok), "func"):("func() return int")
