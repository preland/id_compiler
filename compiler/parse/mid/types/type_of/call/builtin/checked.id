  rotl_fixture();
  export int chk_ii = node_call("add_checked", [(import lit_a), (import lit_a)]);
} return void;
given rotl_fixture ():() then calls node_call:("add_checked", [(import lit_a), (import lit_a)])
():() then calls rotl_fixture:[1]

checked_words() {
  checked_ints();
  export int chk_iw = node_call("sub_checked", [(import lit_a), (import rot_wide)]);
