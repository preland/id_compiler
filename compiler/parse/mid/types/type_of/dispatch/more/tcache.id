// A per-node cache for type_of. A bin node's type asks for both operands'
// types twice over -- once from is_concat's check, once from the
// arithmetic-widening path taken when it isn't concat -- so an uncached
// type_of doubles its own cost at every level of a binop chain, which is
// exponential in the chain's depth. Caching the first answer makes the
// second ask free.
//
// seqt is the C back end's per-node table of the same shape (which nodes'
// values are in a temporary, back/tgt/c/emit/prog/code/expr/atom/order/). It
// is started here because this is where every build and every fixture that
// reaches emit_expr already starts a per-node table.

init_tcache() {
  export string[] tcache = [];
  export int[] tcache_ok = [];
  export int[] seqt = [];
} chain () {
  export int[] arrmark = [];
  export int[] bytesmark = [];
} return void;
given env_init given tcache_set(0, "int") ():() then len((import tcache)):(0)
given env_init given tcache_set(1, "string") ():() then len((import tcache_ok)):(0)
given env_init ():() then (import chkfail)[0]:(0)
given env_init ():() then init_units:(0)

tcache_set(int id, string t) {
  while(len((import tcache)) <= id) {
    push((import tcache), "");
    push((import tcache_ok), 0);
  }
  sset((import tcache), id, t);
  lset((import tcache_ok), id, 1);
} return void;
given env_init (0, "int"):() then (import tcache)[0]:("int")
given env_init (0, "string"):() then (import tcache)[0]:("string")
