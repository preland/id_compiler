// Name references, and the float-literal case of the type dispatch.

// var and import both name a variable; their type is the variable's type.
is_nameref(int id) {
  int ok = 0;
  if(k_of(id) == "var" || k_of(id) == "import") {
    ok = 1;
  }
} return int ok;
given varleaf_fixture ((import var_vi)):(1)
given allfix ((import lit_a)):(0)

// Extends the type_of dispatch chain (type_of2 -> here -> type_of3) with the
// float-literal case.
type_of_float(int id) {
  string t = type_of3(id);
  if(k_of(id) == "float") {
    t = "float";
  }
} return string t;
given leaves_fixture ((import lit_float)):("float")
given allfix ((import lit_a)):("int")
