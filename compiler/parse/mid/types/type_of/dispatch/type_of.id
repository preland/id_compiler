// type_of(id): the id type of an expression node. Dispatch on kind.
//   int -> int (or word, if the literal is too wide)    str -> string
//   float -> float    var -> its declared type    un -> its operand's type
//   call -> callee/builtin return type
//   bin -> string for concat, int for a predicate, else the widened operands
//
// Cached per node id (see dispatch/more/tcache.id) -- a node is asked about
// its own type from many call sites, and at every level of a binop chain,
// so an uncached answer here is what makes the whole compiler exponential
// in the chain's depth rather than linear in its size.

type_of(int id) {
  string t = "";
  if(tcache_has(id) == 1) {
    t = (import tcache)[id];
  } else {
    t = type_of_miss(id);
  }
} return string t;
given leaves_fixture ((import lit_a)):("int")
given leaves_fixture ((import lit_str)):("string")

type_of2(int id) {
  string t = "string";
  if(k_of(id) != "str") {
    t = type_of_float(id);
  }
} return string t;
given leaves_fixture ((import lit_str)):("string")
given leaves_fixture ((import lit_float)):("float")

type_of3(int id) {
  string s1_of_v = s1_of(id);
  string t = name_type(s1_of_v, (import nunit)[id]);
  if(is_nameref(id) == 0) {
    t = type_of4(id);
  }
} return string t;
given varleaf_fixture ((import var_vi)):("int")
given allfix ((import lit_a)):("int")
