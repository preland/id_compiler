// What a struct declaration may be, judged once the whole program is read
// (the parser only reads the syntax, front/parse/decl/kinds/struct/): one to
// three fields, each with its own name and a type that exists, no struct that
// holds itself, a file of its own, a name nothing else has, and fields that no
// earlier struct already has. Every message names the declaration it is about
// and what to do to it.

chk_structs() {
  int sd_i = 0;
  while(sd_i < len((import sdname))) {
    chk_struct_one(sd_i);
    sd_i = sd_i + 1;
  }
} return void;
given sd_pair {
  ():() then (import chkfail)[0]:(0)
  given sd_note("P", ["z"], ["int"], "z.id", 4) ():() then (import chkfail)[0]:(1)
}

chk_struct_one(int sd_i) {
  sd_shape(sd_i);
  sd_dupfield(sd_i);
  sd_ftypes(sd_i);
} chain (int sd_i) {
  sd_names(sd_i);
  sd_alone(sd_i);
  sd_same(sd_i);
} return void;
given sd_pair {
  (0):() then (import chkfail)[0]:(0)
  given sd_note("Z", [], [], "z.id", 4) (2):() then (import chkfail)[0]:(1)
}

sd_err(int sd_i, string sd_m) {
  print((import sdfile)[sd_i] + ":" + (import sdline)[sd_i] + ": error: " + sd_m);
  note_failure();
} return void;
given sd_pair {
  (0, "boom"):() then prints:("p.id:1: error: boom\n") then (import chkfail)[0]:(1)
  (1, "bang"):() then prints:("q.id:5: error: bang\n") then (import chkfail)[0]:(1)
}
