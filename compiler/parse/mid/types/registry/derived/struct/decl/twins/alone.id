// A struct has a file of its own: no function beside it and no second struct.
// The declaration is a thing and the functions are what the program does with
// it, and `id` files things by what they are -- the same reason a function's
// cases sit under it rather than in a separate suite.

sd_alone(int sd_i) {
  int sd_j = 0;
  while(sd_j < len((import pfile))) {
    sd_sharef(sd_i, sd_j);
    sd_j = sd_j + 1;
  }
  sd_sharest(sd_i);
} return void;
given sd_pair (0):() then (import chkfail)[0]:(0)
given sd_pair given sd_fnfile("p.id") (0):() then (import chkfail)[0]:(1)

sd_sharef(int sd_i, int sd_j) {
  if((import pfile)[sd_j] == (import sdfile)[sd_i]) {
    sd_diag(sd_i, "E0625", "struct '" + (import sdname)[sd_i] + "' shares its file with function '" + (import ns1)[((import prog)[sd_j])] + "'; a struct is declared in a file of its own -- move the function to another file", (import sdname)[sd_i], "a struct is a thing and a function is what the program does with it, and id files each in a file of its own", "move the function to another file");
  }
} return void;
given sd_pair given sd_fnfile("q.id") (1, 0):() then prints:("q.id:5: error: struct 'Q' shares its file with function 'sd_fn'; a struct is declared in a file of its own -- move the function to another file [E0625]\n  at: Q\n  why: a struct is a thing and a function is what the program does with it, and id files each in a file of its own\n  help: move the function to another file\n")
given sd_pair given sd_fnfile("q.id") (0, 0):() then (import chkfail)[0]:(0)

sd_sharest(int sd_i) {
  int sd_j = 0;
  while(sd_j < sd_i) {
    sd_sharepair(sd_i, sd_j);
    sd_j = sd_j + 1;
  }
} return void;
given sd_pair (1):() then (import chkfail)[0]:(0)
