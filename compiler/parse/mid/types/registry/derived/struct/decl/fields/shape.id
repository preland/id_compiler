// How many fields a struct has, and whether each has a name of its own. The
// limit is the same three every other limit in `id` is: a record of seven
// metrics is two records, and nesting is how a bigger idea is spelled.

sd_shape(int sd_i) {
  int sd_n = len((import sdfname)[sd_i]);
  if(sd_n == 0) {
    sd_diag(sd_i, "E0620", "struct '" + (import sdname)[sd_i] + "' has no fields; give it one to three, or use the value on its own", (import sdname)[sd_i], "a struct is a record of one to three named fields, and one with none holds nothing", "give the struct one to three fields, or use the value on its own");
  } else if(sd_n > 3) {
    sd_diag(sd_i, "E0620", "struct '" + (import sdname)[sd_i] + "' has " + sd_n + " fields; the limit is 3 -- group related fields into a second struct and nest it, as in 'struct " + (import sdname)[sd_i] + " { Part p; int a; int b; }'", (import sdname)[sd_i], "a struct is a record of one to three named fields, the same limit of three every other part of id has", "group related fields into a second struct and nest it");
  }
} return void;
given sd_pair (0):() then (import chkfail)[0]:(0)
given sd_pair given sd_note("Z", [], [], "z.id", 4) (2):() then prints:("z.id:4: error: struct 'Z' has no fields; give it one to three, or use the value on its own [E0620]\n  at: Z\n  why: a struct is a record of one to three named fields, and one with none holds nothing\n  help: give the struct one to three fields, or use the value on its own\n")
given sd_pair given sd_note("W", ["a", "b", "c", "d"], ["int", "int", "int", "int"], "w.id", 8) (2):() then prints:("w.id:8: error: struct 'W' has 4 fields; the limit is 3 -- group related fields into a second struct and nest it, as in 'struct W { Part p; int a; int b; }' [E0620]\n  at: W\n  why: a struct is a record of one to three named fields, the same limit of three every other part of id has\n  help: group related fields into a second struct and nest it\n")

sd_dupfield(int sd_i) {
  int sd_k = 0;
  while(sd_k < len((import sdfname)[sd_i])) {
    sd_dupat(sd_i, sd_k);
    sd_k = sd_k + 1;
  }
} return void;
given sd_pair (0):() then (import chkfail)[0]:(0)
given sd_pair given sd_note("D", ["a", "a"], ["int", "int"], "d.id", 2) (2):() then (import chkfail)[0]:(1)

sd_dupat(int sd_i, int sd_k) {
  string[] sd_fs = (import sdfname)[sd_i];
  if(find_str(sd_fs, sd_fs[sd_k]) != sd_k) {
    sd_diag(sd_i, "E0621", "struct '" + (import sdname)[sd_i] + "' declares field '" + sd_fs[sd_k] + "' more than once; give each field its own name", sd_fs[sd_k], "a field is read and written by its name, so two fields of one name could not be told apart", "give each field its own name");
  }
} return void;
given sd_pair (0, 1):() then (import chkfail)[0]:(0)
given sd_pair given sd_note("D", ["a", "b", "a"], ["int", "int", "int"], "d.id", 2) (2, 0):() then prints:("d.id:2: error: struct 'D' declares field 'a' more than once; give each field its own name [E0621]\n  at: a\n  why: a field is read and written by its name, so two fields of one name could not be told apart\n  help: give each field its own name\n")
