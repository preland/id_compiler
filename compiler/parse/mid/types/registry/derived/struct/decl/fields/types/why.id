// Why a field's type is refused: "" when it is fine, otherwise the rest of the
// sentence, which says what is wrong and what to write instead.

sd_ftype_why(string sd_t) {
  string sd_w = sd_ftype_why2(sd_t);
  if(ty_is_func(sd_t) == 1) {
    sd_w = " is a function value (" + sd_t + "); a function value cannot be stored in a struct -- store it in an export, or pass it to the function that calls it";
  }
} return string sd_w;
given sd_reg ("int"):("")
given sd_reg ("func(int) return void"):(" is a function value (func(int) return void); a function value cannot be stored in a struct -- store it in an export, or pass it to the function that calls it")

sd_ftype_why2(string sd_t) {
  string sd_w = "";
  if(ty_base(sd_t) == "void") {
    sd_w = " has type '" + sd_t + "'; a field holds a value, so give it int, word, float, string, a struct or a list of one";
  } else if(ty_known(sd_t) == 0) {
    sd_w = " has type '" + sd_t + "', which is not a type; use int, word, float, string, a struct declared in the program, or a list of one of those, as in 'int[]'";
  }
} return string sd_w;
given sd_reg ("P[]"):("")
given sd_reg ("Pnt"):(" has type 'Pnt', which is not a type; use int, word, float, string, a struct declared in the program, or a list of one of those, as in 'int[]'")
