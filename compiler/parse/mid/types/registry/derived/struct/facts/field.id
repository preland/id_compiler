// A struct's fields, read back by position, and as text for a diagnostic.

// "x, y": the field names, for a message that says what a struct has.
sd_fields_text(string sd_s) {
  int sd_k = 0;
  string s = "";
  while(sd_k < sd_nfields(sd_s)) {
    s = s + sep_at(", ", sd_k) + sd_cell((import sdfname), sd_s, sd_k);
    sd_k = sd_k + 1;
  }
} return string s;
given sd_pair {
  ("P"):("x, y")
  ("Q"):("s")
}
