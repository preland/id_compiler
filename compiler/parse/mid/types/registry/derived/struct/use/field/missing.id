// A field a struct does not have, read or written: the one mistake with the
// message, code and fix in one place. A read of the target of a write is not
// reported as a read, so the write reports it once.

sd_nofield_diag(int id, string sd_bt, string sd_f) {
  tc_diag(id, "E0629", sd_nofield(sd_bt, sd_f), sd_f, "a struct is read and written only through the fields its declaration gives it", "use one of its fields (" + sd_fields_text(sd_bt) + "), or add '" + sd_f + "' to the struct");
} return void;
given sd_use_fixture {
  ((import sd_iz), "P", "z"):() then prints:("<stdin>:1: error: struct 'P' has no field 'z'; its fields are x, y [E0629]\n  at: z\n  why: a struct is read and written only through the fields its declaration gives it\n  help: use one of its fields (x, y), or add 'z' to the struct\n")
  ((import sd_iz), "P", "z"):() then (import chkfail)[0]:(1)
}

sd_nofield_read(int id, string sd_bt, string sd_f) {
  if(is_ia_target(id) == 0) {
    sd_nofield_diag(id, sd_bt, sd_f);
  }
} return void;
given sd_use_fixture {
  ((import sd_iz), "P", "z"):() then (import chkfail)[0]:(1)
  ((import sd_tz), "P", "z"):() then (import chkfail)[0]:(0)
}
