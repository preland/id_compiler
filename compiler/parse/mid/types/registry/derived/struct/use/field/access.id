  ((import sd_iz)):() then (import chkfail)[0]:(1)
}

// A write through an index: the same split.
chk_iasg(int id) {
  string sd_bt = base_type(id);
  if(is_fld_idx(id) == 1) {
    chk_fstore(id, sd_bt);
  } else {
    chk_iassign(id);
  }
} return void;
