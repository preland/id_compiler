//   sd_c1  P(1)         sd_c3  Q("s", "s", "s")
//   sd_cb  P(1, "s")    sd_cx  P(1, 1) with no declaration after it
//   sd_big a literal that is a word, for the narrowing rule

sd_ctor_fixture() {
  sd_use_fixture();
  export int sd_big = node_int("99", 99, 1);
  export int sd_c1 = node_call("P", [(import sd_one)]);
} chain () {
