  export int sd_cb = node_call("P", [(import sd_one), (import sd_str)]);
  export int sd_cx = node_call("P", [(import sd_one), (import sd_one)]);
} chain () {
  export int sd_c2 = node_call("P", [(import sd_one), (import sd_one)]);
  export int sd_d2 = node_decl("P", "q", (import sd_c2), 0);
  export int sd_neg = 0 - 1;
} return void;
