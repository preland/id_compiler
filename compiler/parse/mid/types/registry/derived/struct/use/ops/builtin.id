// A struct is not printable and not a builtin's argument: `print` takes what it
// can turn into text, and a struct is not text. The one builtin that does take
// one is `push`, whose value is an element of a list of structs (the value
// argument is the one arg_ctx_b says a builtin keeps). Naming a struct's fields
// is how it is shown (print(p.x)), the same answer v1 gives to `==`: structs are
// compared and printed by field.

sd_bi_args(int id) {
  int sd_i = 0;
  while(sd_i < flat_arg_count(id)) {
    sd_bi_arg(id, sd_i);
    sd_i = sd_i + 1;
  }
} return void;
given sd_bi_fixture ((import sd_pc)):() then check_failed:(1)
given sd_bi_fixture ((import sd_pushc)):() then check_failed:(0)

sd_bi_arg(int id, int sd_i) {
  int sd_a = l1_of(id)[sd_i];
  string sd_t = type_of(sd_a);
  if(ty_is_struct(sd_t) == 1 && bi_want_for(id, sd_i) == "" && arg_ctx_b(s1_of(id), sd_i) == 0) {
    tc_err(sd_a, "'" + s1_of(id) + "' cannot take a struct: argument " + sd_i + " is " + sd_t + "; use its fields, as in " + s1_of(id) + "(p." + sd_fname_at(sd_t, 0) + ")");
  }
} return void;
