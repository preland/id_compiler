// A struct in a test case, `Point(1, 2)`, held to the type the signature
// declares at that position, the way a list literal is: the name must be that
// struct, and each argument must fit its field -- recursively, so a field that
// is a list, a struct or `(import NAME)` is judged by the rule for its own kind.
// The same shape written where a function type is wanted is a closure,
// bind(NAME, 1, [2]), and is held to the rules of a bind (../call/bind.id).

fit_other(int i, int e, string want) {
  if(ty_is_func(want) == 1 && (import nkind)[e] == "cctor") {
    fit_cbind(i, e, want);
  } else if(ty_kind_is(want, "struct") == 1 || (import nkind)[e] == "cctor") {
    fit_struct(i, e, want);
  } else {
    fit_scalar(i, e, want);
  }
} return void;
given sd_case_fixture ((import fixture_ci), (import sd_ce), "int"):() then prints:("fixture.id:4: error: this case builds a P where a int is required\n")
given sd_case_fixture ((import fixture_ci), (import sd_ca), "int"):() then (import chkfail)[0]:(0)
given cbind_fixture ((import fixture_ci), (import cb_e), "func() return int"):() then (import chkfail)[0]:(0)

fit_struct(int i, int e, string want) {
  if((import nkind)[e] != "cctor") {
    case_diag(i, "E0631", "this case gives " + lit_text(e) + " where a " + want + " is required; write the struct as " + want + "(" + sd_fields_text(want) + ")", "a struct is written in a case the way it is built, with its name and one value for each field", "write the struct as " + want + "(" + sd_fields_text(want) + ")");
  } else {
    fit_ctor(i, e, want);
  }
} return void;
given sd_case_fixture {
  ((import fixture_ci), (import sd_ca), "P"):() then prints:("fixture.id:4: error: this case gives 1 where a P is required; write the struct as P(x, y) [E0631]\n  why: a struct is written in a case the way it is built, with its name and one value for each field\n  help: write the struct as P(x, y)\n")
  ((import fixture_ci), (import sd_ce), "P"):() then (import chkfail)[0]:(0)
}

fit_ctor(int i, int e, string want) {
  if(find_str((import sdname), ((import ns1)[e])) < 0) {
    case_err(i, "a test case takes literals only (a number, a string, a list of those, or a struct written as P(1, 2)); '" + (import ns1)[e] + "' is not a struct");
  } else if((import ns1)[e] != want) {
    case_err(i, "this case builds a " + (import ns1)[e] + " where a " + want + " is required");
  } else {
    fit_fields(i, e, want);
  }
} return void;
