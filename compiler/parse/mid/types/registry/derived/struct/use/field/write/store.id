// Writing a field: `p.x = v;`. The base must be a struct with that field, and
// the value must fit the field's type the way a value fits any slot.

chk_fstore(int id, string sd_bt) {
  string sd_f = (import ns1)[((import ni2)[id])];
  if(ty_known(sd_bt) == 1) {
    chk_fstore_at(id, sd_bt, sd_f);
  }
} return void;
given sd_use_fixture {
  ((import sd_wx), "P"):() then (import chkfail)[0]:(0)
  ((import sd_wn), "int"):() then (import chkfail)[0]:(1)
}

chk_fstore_at(int id, string sd_bt, string sd_f) {
  if(ty_kind_is(sd_bt, "struct") == 0) {
    tc_diag(id, "E0615", "cannot assign field '" + sd_f + "' of a " + sd_bt, sd_f, "only a struct has fields", "assign a struct's field, or declare the variable as a struct");
  } else if(sd_fpos(sd_bt, sd_f) < 0) {
    sd_nofield_diag(id, sd_bt, sd_f);
  } else {
    chk_fvalue(id, sd_bt, sd_f);
  }
} return void;
given sd_use_fixture {
  ((import sd_wx), "P", "x"):() then (import chkfail)[0]:(0)
  ((import sd_wz), "P", "z"):() then prints:("<stdin>:1: error: struct 'P' has no field 'z'; its fields are x, y [E0629]\n  at: z\n  why: a struct is read and written only through the fields its declaration gives it\n  help: use one of its fields (x, y), or add 'z' to the struct\n")
}

chk_fvalue(int id, string sd_bt, string sd_f) {
  int sd_v = (import nl1)[id][0];
  string sd_ft = sd_cell((import sdftype), sd_bt, (sd_fpos(sd_bt, sd_f)));
  if(bad_store(sd_ft, sd_v) == 1) {
    tc_diag(id, "E0624", "cannot store a " + type_of(sd_v) + " into field '" + sd_f + "' (" + sd_ft + ") of struct '" + sd_bt + "'", sd_f, "a field holds only values of the type it was declared with", "store a " + sd_ft + " in this field, or change the field's type in the struct");
  }
} return void;
given sd_use_fixture {
  ((import sd_wx), "P", "x"):() then (import chkfail)[0]:(0)
  ((import sd_ws), "P", "x"):() then prints:("<stdin>:1: error: cannot store a string into field 'x' (int) of struct 'P' [E0624]\n  at: x\n  why: a field holds only values of the type it was declared with\n  help: store a int in this field, or change the field's type in the struct\n")
}
