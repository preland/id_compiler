// `prog`/`pfile` populated (fn_fixture only sets the former), plus a case
// tuple pushed after it, for decl/func/cases/collect.id's cases -- case_owner
// reads `pfile[len(prog)-1]`, which nothing else in this build sets up for
// a case to call it standalone. Filed here, away from decl/func/cases/
// itself, because every directory near it was then at the since-dropped 3-entry limit.

cases_fix() {
  fn_fixture();
  init_files();
  push((import pfile), "fixture.id");
} return void;
():() then calls fn_fixture:[1]
():() then init_units:(0)

// `(A):(B)`, a whole case's tokens, on top of cases_fix: `(5):(6)` for one, and
// `(1):(2)` for a second whole case, for cases whose two behaviours can only
// differ by which `given` they name.
cases_full_fix(int cff_a, int cff_b) {
  cases_fix();
  toks_push(["op", "int", "op", "op", "op", "int", "op"], ["(", "" + cff_a, ")", ":", "(", "" + cff_b, ")"]);
} return void;
(5, 6):() then calls toks_push:(["op", "int", "op", "op", "op", "int", "op"], ["(", "5", ")", ":", "(", "6", ")"])
(1, 2):() then calls toks_push:(["op", "int", "op", "op", "op", "int", "op"], ["(", "1", ")", ":", "(", "2", ")"])
(5, 6):() then init_units:(0)
