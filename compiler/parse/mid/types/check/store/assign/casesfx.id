// `prog`/`pfile` populated (fn_fixture only sets the former), plus a case
// tuple pushed after it, for decl/func/cases/cases.id's cases -- case_owner
// reads `pfile[len(prog)-1]`, which nothing else in this build sets up for
// a case to call it standalone. Filed here, away from decl/func/cases/
// itself, because every directory near it is at the 3-entry layout limit.

cases_fix() {
  fn_fixture();
  init_files();
  push((import pfile), "fixture.id");
} return void;
():() then check_failed:(0)
():() then init_units:(0)

// `(5):(6)`, a whole case's tokens, on top of cases_fix.
cases_full_fix() {
  cases_fix();
  toks_push(["op", "int", "op", "op", "op", "int", "op"], ["(", "5", ")", ":", "(", "6", ")"]);
} return void;
():() then check_failed:(0)
():() then init_units:(0)

