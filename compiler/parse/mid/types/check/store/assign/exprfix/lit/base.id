// Shared expression-node fixtures for mid/types (type_of/* and the store
// checks below): two int literals, a string literal. Filed here because no
// directory under type_of/ has room left (each was at the since-dropped 3-entry cap).
// varleaf_init (../var.id) is env_init()+init_idx(): type_of3 always calls
// name_type first, even for a node that is not a name, so every node
// needs the var index ready, not only var/import ones.
leaves_fixture() {
  varleaf_init();
  leaves_build();
  leaves_build2();
} return void;
():() then calls node_txt2:("int", "2", 2, 0)
():() then calls node_float:("1.5")
():() then calls varleaf_init:[1]
():() then init_units:(0)

leaves_build() {
  export int lit_a = node_txt2("int", "2", 2, 0);
  export int lit_b = node_txt2("int", "5", 5, 0);
  export int lit_str = node_txt("str", "hi");
} return void;
given env_init ():() then calls node_txt2:("int", "5", 5, 0)
given env_init ():() then calls node_txt:("str", "hi")
given env_init ():() then (import chkfail)[0]:(0)
given env_init ():() then init_units:(0)

leaves_build2() {
  export int lit_word = node_txt2("int", "99", 99, 1);
  export int lit_float = node_float("1.5");
} return void;
given env_init ():() then calls node_txt2:("int", "99", 99, 1)
given env_init ():() then calls node_float:("1.5")
given env_init ():() then (import chkfail)[0]:(0)
given env_init ():() then init_units:(0)
