// Calls and list literals: where an argument or an element flows.

esc_call(int e, string nm) {
  string cname = (import ns1)[e];
  int[] args = (import nl1)[e];
  int r = esc_args(args, cname, nm);
} return int r;
given esc_fix ((import efb_call), "p"):(512)
given esc_fix ((import efb_call), "t"):(256)
given esc_sd_fix ((import esd_ctor), "xs"):(64)
given esc_sd_fix ((import esd_ctor), "other"):(0)

// Each argument gets the context its position has in the callee (sum/). A
// push onto `nm` of anything but a list literal is flagged first (deep/).
esc_args(int[] args, string cname, string nm) {
  int r = esc_pushel(args, cname, nm);
  int i = 0;
  while(i < len(args)) {
    int c = esc_cmctx(args, cname, i, esc_actx(cname, i, args[i]));
    r = r | esc_expr(args[i], nm, c);
    i = i + 1;
  }
} return int r;
given esc_fix {
  ((import efb_args), "fa_sink", "p"):(512)
  ((import efb_args), "fa_sink", "t"):(256)
  ((import efa_args), "len", "b"):(0)
}

// An element of a list literal is kept by the list.
esc_list(int[] xs, string nm, int ctx) {
  int r = 0;
  int i = 0;
  while(i < len(xs)) {
    r = r | esc_expr(xs[i], nm, ctx);
    i = i + 1;
  }
} return int r;
given esc_fix {
  ((import efb_args), "p", 1):(1)
  ((import efb_args), "p", 0):(0)
}

