// Where an argument flows, decided by what is being called. Bit 1 keeps the
// value, bit 8 says the callee may break the ownership of the elements of a
// list (esc_dbit); 0 only reads it.
//
// A builtin reads every argument except the value `push` stores. Anything else
// is a function written in id, whose answer is its summary (../mask.id): one
// bit per parameter, set when the body keeps that parameter. A name that is
// not such a function -- a call through a function value, an `asm` function, a
// `native` -- keeps everything, because nothing here can see its body.

arg_ctx(string cname, int i) {
  int c = 1;
  if(is_builtin(cname) == 1) {
    c = arg_ctx_b(cname, i);
  } else {
    c = arg_ctx_u(cname, i);
  }
} return int c;
given esc_fix ("push", 1):(1)
given esc_fix ("len", 0):(0)
given esc_fix ("fa_sink", 0):(8)

arg_ctx_b(string cname, int i) {
  int c = 0;
  if(cname == "push" && i == 1) {
    c = 1;
  }
} return int c;
given esc_fix ("push", 1):(1)
given esc_fix ("push", 0):(0)
given esc_fix ("print", 1):(0)

arg_ctx_u(string cname, int i) {
  int m = esc_mask(cname);
  int c = esc_bit(m, i) | (esc_dbit(m, i) << 3);
} return int c;
given esc_fix ("fa_sink", 1):(1)
given esc_fix ("fa_sink", 0):(8)
given esc_fix ("nosuch", 0):(9)
