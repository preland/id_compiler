// Every function waiting above the first `emk` entries of esc_mem is taken off
// the list and given state `edv`: 0 to be computed again by the next pass of
// the function they waited on, 3 once that function is final.

esc_drain(int emk, int edv) {
  while(len((import esc_mem)) > emk) {
    integer_list_set((import esc_st), pop((import esc_mem)), edv);
  }
} return void;
given esc_scy (1000000, 0, 2) {
  (1, 3):() then (import esc_st)[1]:(3)
  (1, 3):() then (import esc_st)[0]:(0)
  (0, 1):() then (import esc_st)[0]:(1)
  (1, 3):() then len((import esc_mem)):(1)
}
