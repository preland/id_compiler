// The function a declaration is in, and how many of its nodes are stores of a
// given class (node.id): the node ids from `lo` to `hi` are walked once per
// class, because a count is the one thing a loop here can return without a flag.

bfl_count(string bfl_nm, int bfl_lo, int bfl_hi, int bfl_kind) {
  int bfl_n = 0;
  int bfl_i = bfl_lo;
  while(bfl_i <= bfl_hi) {
    if(bfl_class(bfl_i, bfl_nm) == bfl_kind) {
      bfl_n = bfl_n + 1;
    }
    bfl_i = bfl_i + 1;
  }
} return int bfl_n;
