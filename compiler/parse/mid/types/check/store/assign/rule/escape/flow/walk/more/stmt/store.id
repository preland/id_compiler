// A value stored into a name: the initialiser of a declaration or the right of
// an assignment. Whatever the expression is, its value is kept by the name, so
// a bare variable there is an alias of another variable and escapes.
esc_store(int sn, string nm) {
  string tg = (import ns1)[sn];
  if((import nkind)[sn] == "decl") {
    tg = (import ns2)[sn];
  }
  int r = esc_put((import ni1)[sn], tg, nm);
} return int r;
given esc_fix {
  ((import efb_dt), "t"):(0)
  ((import efb_dv), "v"):(2)
  ((import efb_dv), "p"):(1)
}

esc_put(int e, string tg, string nm) {
  int r = esc_expr(e, nm, 1);
  int f = esc_fresh(e, tg, nm);
  r = r | f;
} return int r;
given esc_fix {
  ((import efb_vp), "v", "v"):(2)
  ((import efb_vp), "v", "p"):(1)
}

// Bit 2: `nm` is the target of a store whose value is not a list literal, so
// it may be an alias of a list somebody else owns (a parameter, an element, a
// call's result) and must never be freed. Bit 8 is added for a literal whose
// elements are not themselves literals (deep/elem.id). For a string the stores
// that are no alias are a literal (no bit) and a fresh string (bit 16), see
// kind.id.
esc_fresh(int e, string tg, string nm) {
  int r = 0;
  if(tg == nm && (import nkind)[e] != "arr") {
    r = esc_nonlit(e);
  } else if(tg == nm) {
    r = esc_arrbad(e);
  }
} return int r;
given esc_fix ((import efb_vp), "v", "v"):(2)
given esc_fix ((import efb_arr), "v", "v"):(8)
given esc_dfix ((import efd_lits), "v", "v"):(0)
