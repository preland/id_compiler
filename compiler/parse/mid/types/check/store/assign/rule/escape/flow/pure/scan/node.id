// The nodes of one function, and what the purity check asks of each kind. Only
// calls, reads of an export and exported declarations can break a rule.

pure_range(int lo, int hi, int fn) {
  while(lo <= hi) {
    pure_node(lo, fn);
    lo = lo + 1;
  }
} return void;
given pure_fix_prog {
  (0, 1, (import pfx_fa)):() then (import chkfail)[0]:(0)
  (6, 28, (import pfx_fa)):() then (import chkfail)[0]:(1)
}

pure_node(int id, int fn) {
  if((import nkind)[id] == "call") {
    pure_call(id, fn);
  }
  if((import nkind)[id] == "import") {
    pure_import(id, fn);
  }
  if((import nkind)[id] == "decl") {
    pure_decl(id, fn);
  }
} return void;
given pure_fix_prog {
  ((import pfx_cio), (import pfx_fa)):() then (import chkfail)[0]:(1)
  ((import pfx_one), (import pfx_fa)):() then (import chkfail)[0]:(0)
  ((import pfx_imp), (import pfx_fa)):() then (import chkfail)[0]:(1)
  ((import pfx_dcl), (import pfx_fa)):() then (import chkfail)[0]:(1)
}
