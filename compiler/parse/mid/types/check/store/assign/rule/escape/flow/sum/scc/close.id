// The end of a function's run. One that read a running function above it waits
// for that function (esc_defer); one that did not is final, and so is every
// function that waited only on it (esc_seal). The depth is put back first: the
// two that follow do not read it.

esc_close(int ix, int esd, int esv, int emk) {
  integer_list_set((import esc_fx), 0, esd);
  if((import esc_fx)[1] < esd) {
    esc_defer(ix, (import esc_fx)[1], esv);
  } else {
    esc_seal(ix, emk, esv);
  }
} return void;
