  ((import pfx_one), (import pfx_fb)):(0)
  ((import pfx_bh), (import pfx_fb)):(1)
  ((import pfx_bg), (import pfx_fb)):(0)
}

pure_name_ok(string name, int fn) {
  int pq_ok2 = pure_fn_named(name);
  if(pq_ok2 == 0) {
    pq_ok2 = pure_param(name, fn);
  }
} return int pq_ok2;
