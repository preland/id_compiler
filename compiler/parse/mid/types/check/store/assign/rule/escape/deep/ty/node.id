// A struct's node of a descriptor (desc.id): a back reference when the struct
// is already being described, otherwise its field count and its fields.

esc_dsct(string t, string dz_a, string[] dz_sn, int[] dz_sp) {
  string dz_r = esc_dscb(t, dz_a, dz_sn, dz_sp);
  if(dz_r == "") {
    dz_r = esc_dscs(t, dz_a, dz_sn, dz_sp);
  }
} return string dz_r;
given esc_ty_fix ("Tr", "ab", ["Tr"], [2]):("ab@2;")
given esc_ty_fix ("Tr", "", [], []):("S1l@0;")
given esc_ty_fix ("Pt", "q", ["Tr"], [0]):("qS2..")

// The back reference to `t` when it is one of the structs being described,
// "" when it is not.
esc_dscb(string t, string dz_a, string[] dz_sn, int[] dz_sp) {
  int dz_k = find_str(dz_sn, t);
  string dz_r = "";
  if(dz_k >= 0) {
    dz_r = dz_a + "@" + dz_sp[dz_k] + ";";
  }
} return string dz_r;
given esc_ty_fix ("Tr", "ab", ["Tr"], [2]):("ab@2;")
given esc_ty_fix ("Pt", "ab", ["Tr"], [2]):("")

esc_dscs(string t, string dz_a, string[] dz_sn, int[] dz_sp) {
  push(dz_sn, t);
  push(dz_sp, len(dz_a));
  int dz_s = find_str((import sdname), t);
} chain (string t, string dz_a, string[] dz_sn, int[] dz_sp) {
  string dz_r = dz_a + "S" + len((import sdftype)[dz_s]);
  dz_r = esc_dscf(dz_s, dz_r, dz_sn, dz_sp);
  pop(dz_sn);
} chain (string t, string dz_a, string[] dz_sn, int[] dz_sp) {
  pop(dz_sp);
} return string dz_r;
given esc_ty_fix ("Pt", "", [], []):("S2..")
given esc_ty_fix ("Pg", "z", [], []):("zS3sl.S1l@6;")
