// Whether the emitters copy argument `k` of a constructor of struct `sd` to the
// heap: it is a string literal (a static object), the struct is one that is
// freed by type (a build that owns no string has none), and no argument is
// something the struct could not own. Then the struct holds only blocks and
// idfr_NAME can free the field; when any argument fails, the struct stays
// shallow and the literal is stored as it is.

esc_cdup(string sd, int[] dz_as, int cdup_k) {
  int d = 0;
  if((import nkind)[dz_as[cdup_k]] == "str" && esc_dkind(sd) == 3) {
    d = esc_abads(dz_as) == 0;
  }
} return int d;
given esc_ms_fix {
  ("Tr", [(import ems_lit)], 0):(1)
  ("Pt", [(import ems_lit)], 0):(0)
  ("Tr", [(import ems_lit), (import ems_sv)], 0):(0)
}

// The code of argument `k` of a constructor of struct `sd`: `code` itself, or a
// heap copy of it when the emitters copy it (esc_cdup).
esc_ctor_code(string sd, int[] dz_as, int cdup_k, string code) {
  string s = code;
  if(esc_cdup(sd, dz_as, cdup_k) == 1) {
    s = "id_str_dup(" + code + ")";
  }
} return string s;
given esc_ms_fix {
  ("Tr", [(import ems_lit)], 0, "ID_S(\"k\")"):("id_str_dup(ID_S(\"k\"))")
  ("Pt", [(import ems_lit)], 0, "ID_S(\"k\")"):("ID_S(\"k\")")
}
