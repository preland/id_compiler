// Where under a name a store lands, and whether it is allowed to (docs/MEMORY.md
// 3.2, 3.5b).

// 0 when the path `b` does not start at `nm`, 1 when it is `nm` itself, 2 when
// it goes through a field or an element.
esc_tdep(int b, string nm) {
  int dz_dp = 0;
  if(esc_isvar(b, nm) == 1) {
    dz_dp = 1;
  } else if(esc_chain(b, nm) == 1) {
    dz_dp = 2;
  }
} return int dz_dp;
given esc_dfix {
  ((import efd_g), "g"):(1)
  ((import efd_ix), "g"):(2)
  ((import efd_ix), "h"):(0)
}

// 8 when storing `v` under the path `b`, at depth `dz_dp`, can leave `v` held
// by something else.
esc_elbad2(int b, int v, int dz_dp) {
  string dz_t = type_of(imp_root(b));
  int r = 8 * esc_vbad(dz_t, v, dz_dp);
} return int r;
given esc_dfix {
  ((import efd_g), (import efd_v), 1):(8)
  ((import efd_g), (import efd_lit), 1):(0)
}

// 1 when storing `v` under a root of type `t` at depth `dz_dp` can leave `v`
// held by something else. A type with a stricter rule asks it of every store
// of something that can be freed; otherwise only a store straight into the
// list, and only of what is not a list literal.
esc_vbad(string t, int v, int dz_dp) {
  int r = 0;
  if(esc_strong(t) == 1) {
    r = esc_heap_ty(type_of(v)) == 1 && esc_ownv(v) == 0;
  } else if(dz_dp == 1) {
    r = (import nkind)[v] != "arr";
  }
} return int r;
given esc_dfix {
  ("int[][]", (import efd_v), 1):(1)
  ("int[][]", (import efd_lit), 1):(0)
  ("int[][]", (import efd_v), 2):(0)
}
