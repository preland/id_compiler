// Whether a call hands back a block the caller owns: a call to a function of
// the program whose summary leaves bit 30 clear, made when the analysis is on
// and returning something that is a block. A builtin is never claimed here
// (str_fresh_call lists the ones that make strings), nor is a native, a call
// through a function value or a name that is no function: all of those have
// every bit set.

esc_fresh_call(int e) {
  int ok = 0;
  if(esc_on() == 1 && (import nkind)[e] == "call" && is_builtin((import ns1)[e]) == 0) {
    ok = esc_fresh_name(e);
  }
} return int ok;
given esc_ffix ((import eff_cmk)):(1)
given esc_ffix ((import eff_cl)):(0)
given esc_ffix ((import eff_cbad)):(0)
given esc_ffix ((import eff_dy)):(0)

esc_fresh_name(int e) {
  int m = esc_mask((import ns1)[e]);
  string eft = type_of(e);
  int ok = ((m >> 30) & 1) == 0 && esc_heap_ty(eft) == 1;
} return int ok;
given esc_ffix ((import eff_cmk)):(1)
given esc_ffix ((import eff_cbad)):(0)
given esc_ffix ((import eff_ctp)):(0)
given esc_ffix ((import eff_crec)):(1)
