// The assembly of the "returns fresh" fixture (a.id describes the program): the
// struct FfPt, every function registered by name in the order the cases index
// them (ff_make is row 4, after fa_sink, fa_loc, fa_nest and fs_ret), the
// summaries seeded again for the new rows, and ff_use left as the function
// whose body is being emitted.

esc_ff_reg() {
  sd_note("FfPt", ["x"], ["int"], "ff.id", 1);
  add_func("fs_ret", "string", (import efs_ret));
  add_func("ff_make", "int[]", (import eff_make));
} chain () {
  add_func("ff_pass", "int[]", (import eff_pass));
  add_func("ff_glob", "int[]", (import eff_glob));
  add_func("ff_rec", "int[]", (import eff_rec));
} chain () {
  add_func("ff_ping", "int[]", (import eff_ping));
  add_func("ff_pong", "int[]", (import eff_pong));
  add_func("ff_bad", "int[]", (import eff_bad));
} chain () {
  add_func("ff_len", "int", (import eff_len));
  add_func("ff_tmp", "int", (import eff_tmp));
  add_func("ff_pt", "FfPt", (import eff_pt));
} chain () {
  add_func("ff_slen", "int", (import eff_slen));
  add_func("ff_rows", "int[][]", (import eff_rows));
  add_func("ff_rleak", "int[][]", (import eff_rleak));
} return void;
given esc_ffix ():() then calls sd_note:("FfPt", ["x"], ["int"], "ff.id", 1) then calls add_func:("fs_ret", "string", (import efs_ret)) then calls add_func:("ff_make", "int[]", (import eff_make))
