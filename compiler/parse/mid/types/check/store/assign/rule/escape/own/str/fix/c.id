// The assembly of the string-ownership fixture (a.id describes the program), and
// the two variants of it the cases of the cell and of the freestanding switch
// need. fs_acc is left as the function whose body is being emitted, so the
// hooks that ask which function that is (esc_cur) answer for it.

esc_sfix() {
  esc_fix();
  esc_fs_a();
  esc_fs_b();
} chain () {
  esc_fs_c();
  esc_fs_d();
  esc_fs_e();
} chain () {
  lset((import sqbase), 0, (import efs_acc));
} return void;
given esc_sfix ():() then calls lset:((import sqbase), 0, (import efs_acc))
():() then calls node_txt:("str", "")
():() then calls esc_fix:[1]
():() then init_units:(0)

esc_sfix_in() {
  esc_sfix();
  lset((import esc_cons), 0, (import efs_vs));
} return void;
given esc_sfix_in ():() then calls lset:((import esc_cons), 0, (import efs_vs))
():() then calls node_txt:("var", "s")
():() then calls esc_sfix:[1]
():() then init_units:(0)

esc_sfix_fs() {
  esc_sfix();
  lset((import fsc), 0, 1);
} return void;
given esc_sfix_fs ():() then calls lset:((import fsc), 0, 1)
():() then calls node_txt:("var", "n")
():() then calls esc_sfix:[1]
():() then init_units:(0)
