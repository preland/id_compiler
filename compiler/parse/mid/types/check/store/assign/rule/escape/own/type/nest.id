// The type a statement declares for `nm`, looking into the branches and loop
// bodies where a declaration may also sit. "" when it declares none.

esc_type_of(int sn, string nm) {
  string t = "";
  if((import nkind)[sn] == "decl") {
    t = esc_type_decl(sn, nm);
  } else if((import nkind)[sn] == "if" || (import nkind)[sn] == "while") {
    t = esc_type_nest(sn, nm);
  }
} return string t;
given esc_fix {
  ((import efc_z), "z"):("int[]")
  ((import efc_loop), "w"):("int[]")
  ((import efc_z), "w"):("")
}

esc_type_decl(int sn, string nm) {
  string t = "";
  if((import ns2)[sn] == nm && (import ni2)[sn] == 0) {
    t = (import ns1)[sn];
  }
} return string t;
given esc_fix {
  ((import efc_z), "z"):("int[]")
  ((import efc_z), "w"):("")
}

esc_type_nest(int sn, string nm) {
  string t = esc_decl_type((import nl1)[sn], nm);
  if(t == "") {
    t = esc_decl_type((import nl2)[sn], nm);
  }
} return string t;
given esc_fix {
  ((import efc_loop), "w"):("int[]")
  ((import efc_loop), "q"):("")
  ((import efc_ife), "w"):("int[]")
}
