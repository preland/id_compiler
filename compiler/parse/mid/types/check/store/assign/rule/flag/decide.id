// `--bool-strict`: an `int` local whose declaration and every assignment in its
// function are the literals 0 or 1, with both values stored, is a flag, and an
// int that behaves like a boolean is not allowed. The test is made once per
// declaration and reads only that declaration's function: the nodes from the
// one after the previous function's through its own. A store that is not a
// literal 0 or 1, or an arithmetic use of the name, marks a counter instead.
// An exported declaration is skipped: other functions may store to it.

decl_flag(int bfl_id, string bfl_want, int bfl_e) {
  if(bfl_want == "int" && (import ni2)[bfl_id] == 0 && bfl_lit(bfl_e) >= 0 && (import bsc)[0] == 1) {
    decl_flag_scan(bfl_id);
  }
} return void;
given bfl_fixture given integer_list_set((import bsc), 0, 1) ((import bfl_d0), "int", (import fixture_zero)):() then (import chkfail)[0]:(1)
given bfl_fixture given integer_list_set((import bsc), 0, 1) ((import bfl_c0), "int", (import fixture_zero)):() then (import chkfail)[0]:(0)
given bfl_fixture ((import bfl_d0), "int", (import fixture_zero)):() then (import chkfail)[0]:(0)
given bfl_fixture given integer_list_set((import bsc), 0, 1) ((import bfl_d0), "string", (import fixture_zero)):() then (import chkfail)[0]:(0)

decl_flag_scan(int bfl_id) {
  string bfl_nm = (import ns2)[bfl_id];
  int bfl_f = bfl_row(bfl_id);
  int bfl_hi = (import prog)[bfl_f];
} chain (int bfl_id) {
  int bfl_zero = bfl_count(bfl_nm, bfl_first(bfl_f), bfl_hi, 1);
  int bfl_one_n = bfl_count(bfl_nm, bfl_first(bfl_f), bfl_hi, 2);
  if(bfl_zero > 0 && bfl_one_n > 0 && bfl_count(bfl_nm, bfl_first(bfl_f), bfl_hi, 3) == 0) {
    decl_flag_say(bfl_id, bfl_tail(bfl_f, bfl_nm));
  }
} return void;
given bfl_fixture ((import bfl_d0)):() then (import chkfail)[0]:(1)
given bfl_fixture ((import bfl_c0)):() then (import chkfail)[0]:(0)

decl_flag_say(int bfl_id, string bfl_tail_text) {
  string bfl_nm = (import ns2)[bfl_id];
  int bfl_ln = tc_line(bfl_id);
  string bfl_help = "declare it 'bool " + bfl_nm + "', store true and false instead of 1 and 0" + bfl_tail_text + " (--fix rewrites only the declaration for now; the stores and the return are a later rule)";
} chain (int bfl_id, string bfl_tail_text) {
  tc_diag(bfl_id, "E0650", "'" + bfl_nm + "' only ever holds 0 or 1 but is declared int", bfl_nm, "an int that behaves like a boolean is not allowed under --bool-strict: a variable stored only 0 and 1 is a flag, and a flag is a bool", bfl_help);
  diag_edit("machine", "replace", bfl_ln, "int " + bfl_nm, "bool " + bfl_nm);
} return void;
given decltype_fixture ((import decl_scalar), ""):() then (import chkfail)[0]:(1)
given decltype_fixture ((import decl_scalar), ", and return bool"):() then (import tcerrs)[0]:(1)
