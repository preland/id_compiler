// The tail of the statement dispatch (pick.id).

esc_stmt4(int sn, string nm) {
  int r = 0;
  if((import nkind)[sn] == "if") {
    r = esc_if(sn, nm);
  } else {
    r = esc_stmt5(sn, nm);
  }
} return int r;
given esc_fix ((import efc_if), "y"):(2)
given esc_fix ((import efc_if), "s"):(1)

esc_stmt5(int sn, string nm) {
  int r = 0;
  if((import nkind)[sn] == "while") {
    r = esc_while(sn, nm);
  } else if((import nkind)[sn] == "ret") {
    r = esc_ret(sn, nm);
  }
} return int r;
given esc_fix ((import efc_loop), "s"):(1)
given esc_fix ((import efb_ret), "p"):(1)
given esc_fix ((import efb_ret0), "p"):(0)

// An early `return` keeps its value (the caller owns it from here); a bare one
// has none.
esc_ret(int sn, string nm) {
  int r = 0;
  if((import ni1)[sn] >= 0) {
    r = esc_expr((import ni1)[sn], nm, 1);
  }
} return int r;
given esc_fix ((import efb_ret), "p"):(1)
given esc_fix ((import efb_ret0), "p"):(0)
given esc_fix ((import efb_ret), "t"):(0)
