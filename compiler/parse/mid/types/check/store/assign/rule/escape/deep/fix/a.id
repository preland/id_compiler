// The expression nodes the deep-ownership cases run against (b.id has the
// functions): `g[0]`, the list literals, and the argument lists of
// `push(g, v)` and `push(g, [])`. All of them are exported under an `efd`
// name; esc_dfix (b.id) builds them on top of esc_fix's program.

esc_fd_a() {
  export int efd_g = node_txt("var", "g");
  export int efd_v = node_txt("var", "v");
  export int efd_lit = node_arr((import ef_none));
} return void;
given esc_fix ():() then calls node_txt:("var", "g")
given esc_fix ():() then calls node_arr:((import ef_none))
