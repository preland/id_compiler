// How a deep-owned local is freed, by its declared type (docs/MEMORY.md 3.2,
// 3.5b): 1 a list of lists, whose rows are freed as lists; 2 a list of
// strings, whose pieces are freed as strings; 3 a struct with something to
// free, whose type says what each field is. 0 is anything else. Kinds 2 and 3
// free strings, so a build that owns none (a freestanding one) has neither.

esc_dkind(string t) {
  int dz_k = esc_list_of(t, 1);
  if(dz_k == 0 && esc_hosted() == 1) {
    dz_k = esc_dkind2(t);
  }
} return int dz_k;
given esc_ty_fix ("int[][]"):(1)
given esc_ty_fix ("string[]"):(2)
given esc_ty_fix ("Tr"):(3)
given esc_ty_fix ("Pt"):(0)

esc_dkind2(string t) {
  int dz_k = 0;
  if(t == "string[]") {
    dz_k = 2;
  } else if(esc_sheap(t) == 1) {
    dz_k = 3;
  }
} return int dz_k;
given esc_ty_fix ("string[]"):(2)
given esc_ty_fix ("Pg"):(3)
given esc_ty_fix ("Pt"):(0)
given esc_ty_fix ("int[]"):(0)

// The runtime call that frees a deep-owned value of type `t`.
esc_dfn(string t) {
  string dz_f = "id_list_free_deep";
  if(esc_dkind(t) == 3) {
    dz_f = "idfr_" + t;
  } else if(esc_dkind(t) == 2) {
    dz_f = "id_list_free_strs";
  }
} return string dz_f;
given esc_ty_fix ("int[][]"):("id_list_free_deep")
given esc_ty_fix ("string[]"):("id_list_free_strs")
given esc_ty_fix ("Tr"):("idfr_Tr")
