// The program the "returns fresh" cases run against, on top of esc_sfix's
// (own/str/fix/): functions built node by node, registered by name in esc_ffix
// (c.id), each taking `int n` unless it says otherwise.
//
//   ff_make   { int[] r = [n]; }                          return r   fresh
//   ff_pass   (int[] p) { }                               return p   hands back its parameter
//   ff_glob   { int[] r = [n]; export int[] ffg = r; }    return r   an export holds it too
//   ff_rec    { int[] r = []; if(n > 0) { r = ff_rec(n - 1); } }     return r
//   ff_ping   { int[] r = []; if(n > 0) { r = ff_pong(n - 1); } }    return r
//   ff_pong   { int[] r = []; if(n > 0) { r = ff_ping(n - 1); } }    return r
//   ff_bad    (int[] p, int n) { int[] r = [];
//               if(n > 0) { r = ff_bad(p, n - 1); } else { r = p; } }  return r
//   ff_use    { int[] ys = ff_make(n); int t = len(ys); }  return t
//   ff_len    (int[] q) { int l = len(q); }                return l
//   ff_tmp    { int t = ff_len(ff_make(n)); }              return t
//   ff_early  (int[] p) { if(len(p) < 3) { return p; } int[] z = []; }  return z
//   ff_elit   (int[] p) { if(len(p) < 3) { return []; } int[] z = []; } return z
//   ff_pt     { FfPt p = FfPt(n); }                        return p
//   ff_sown   { string c = fs_ret(n); }                    return n
//
// Every node a case needs is exported under an `eff` name.

esc_ff_a() {
  export int eff_vn = node_txt("var", "n");
  export int eff_arr = node_arr([(import eff_vn)]);
  export int eff_dr = node_decl("int[]", "r", (import eff_arr), 0);
} chain () {
  export int[] eff_np = [node_param("param", "int", "n")];
  export int[] eff_pp = [node_param("param", "int[]", "p")];
  export int eff_make = node_func("ff_make", "int[]", (import eff_np), [(import eff_dr)], node_txt("var", "r"));
} chain () {
  export int eff_pass = node_func("ff_pass", "int[]", (import eff_pp), (import ef_none), node_txt("var", "p"));
  export int eff_vr = node_txt("var", "r");
  export int eff_dx = node_decl("int[]", "ffg", (import eff_vr), 1);
} return void;
given esc_ffix ():() then calls node_txt:("var", "n") then calls node_decl:("int[]", "r", (import eff_arr), 0)
given esc_ffix ():() then calls node_param:("param", "int[]", "p") then calls node_decl:("int[]", "ffg", (import eff_vr), 1)
given esc_sfix ():() then (import chkfail)[0]:(0)
given esc_sfix ():() then init_units:(0)

esc_ff_b() {
  export int eff_glob = node_func("ff_glob", "int[]", (import eff_np), [(import eff_dr), (import eff_dx)], (import eff_vr));
  export int eff_sub = node_txt2("bin", "-", (import eff_vn), node_txt2("int", "1", 1, 0));
  export int eff_crec = node_call("ff_rec", [(import eff_sub)]);
} chain () {
  export int eff_asr = node_txt1("assign", "r", (import eff_crec));
  export int eff_cond = node_txt2("bin", ">", (import eff_vn), node_txt2("int", "0", 0, 0));
  export int eff_if = node_if((import eff_cond), [(import eff_asr)], (import ef_none), 0);
} chain () {
  export int eff_d0 = node_decl("int[]", "r", node_arr((import ef_none)), 0);
  export int eff_rec = node_func("ff_rec", "int[]", (import eff_np), [(import eff_d0), (import eff_if)], (import eff_vr));
} return void;
given esc_ffix ():() then calls node_func:("ff_glob", "int[]", (import eff_np), [(import eff_dr), (import eff_dx)], (import eff_vr)) then calls node_call:("ff_rec", [(import eff_sub)]) then calls node_txt1:("assign", "r", (import eff_crec))
given esc_ffix ():() then calls node_txt2:("int", "0", 0, 0) then calls node_if:((import eff_cond), [(import eff_asr)], (import ef_none), 0)
given esc_ffix ():() then (import chkfail)[0]:(0)
given esc_ffix ():() then init_units:(0)

esc_ff_c() {
  export int eff_cpo = node_call("ff_pong", [(import eff_sub)]);
  export int eff_asp = node_txt1("assign", "r", (import eff_cpo));
  export int eff_ifp = node_if((import eff_cond), [(import eff_asp)], (import ef_none), 0);
} chain () {
  export int eff_cpi = node_call("ff_ping", [(import eff_sub)]);
  export int eff_aso = node_txt1("assign", "r", (import eff_cpi));
  export int eff_ifo = node_if((import eff_cond), [(import eff_aso)], (import ef_none), 0);
} chain () {
  export int eff_ping = node_func("ff_ping", "int[]", (import eff_np), [(import eff_d0), (import eff_ifp)], (import eff_vr));
  export int eff_pong = node_func("ff_pong", "int[]", (import eff_np), [(import eff_d0), (import eff_ifo)], (import eff_vr));
} return void;
given esc_ffix ():() then calls node_call:("ff_pong", [(import eff_sub)]) then calls node_txt1:("assign", "r", (import eff_cpo)) then calls node_call:("ff_ping", [(import eff_sub)])
given esc_ffix ():() then calls node_func:("ff_ping", "int[]", (import eff_np), [(import eff_d0), (import eff_ifp)], (import eff_vr)) then calls node_func:("ff_pong", "int[]", (import eff_np), [(import eff_d0), (import eff_ifo)], (import eff_vr))
given esc_ffix ():() then (import chkfail)[0]:(0)
given esc_ffix ():() then init_units:(0)
