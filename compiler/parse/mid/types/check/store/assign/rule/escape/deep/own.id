// Whether a local list, list of strings or struct also owns what it holds, so
// that freeing it frees that too (docs/MEMORY.md 3.2, 3.5b). Three conditions,
// each a proof obligation:
//   * it is owned in the shallow sense (own/query.id): declared here, every
//     store fresh, no use keeps it;
//   * its type has something to free below it (esc_dkind, ty/kind.id);
//   * everything it holds was built for it and is not held by anything else,
//     which esc_deepk spells out by kind: no element or field read out into a
//     position that keeps it, none stored that something else holds, and
//     nothing passed to a callee that may do either (esc_dbit).
// A list of lists frees its rows, shallowly; a list of strings frees its
// strings; a struct is freed by its type, all the way down, with a work list
// of its own (runtime id_free_walk).

// Whether `t` is a list whose elements are lists (inner 1) or are not (inner
// 0). A list of lists is a deep-owned local, freed row by row; a list whose
// elements are not lists is one a constructor may take over from a local,
// where one stricter proof covers all of them.
esc_list_of(string t, int esc_inner) {
  int ok = is_list_ty(t) == 1 && is_list_ty(list_elem(t)) == esc_inner;
} return int ok;
("int[][]", 1):(1)
("int[]", 1):(0)
("func(int) return int[][]", 1):(0)
given esc_ty_fix ("Tr[]", 0):(1)
given esc_ty_fix ("int[][]", 0):(0)

esc_deep(int fn, string nm) {
  string t = esc_decl_type((import nl2)[fn], nm);
  int ok = 0;
  if(esc_dkind(t) > 0 && esc_own(fn, nm) == 1) {
    ok = esc_deepk(fn, nm, esc_dkind(t));
  }
} return int ok;
given esc_dfix ((import efd_good), "a"):(1)
given esc_dfix ((import efd_leak), "b"):(0)
given esc_dfix ((import efd_alias), "c"):(0)
given esc_dfix ((import efd_via), "d"):(0)
given esc_ffix ((import eff_deep), "z"):(1)
given esc_ffix ((import eff_shallow), "y"):(0)

// The runtime call that frees the list or string `nm` of function `fn` when it
// dies.
esc_free_fn(int fn, string nm) {
  string fname = esc_free_base(fn, nm);
  if(esc_on() == 1 && esc_deep(fn, nm) == 1) {
    fname = esc_dfn(esc_decl_type((import nl2)[fn], nm));
  }
} return string fname;
given esc_dfix ((import efd_good), "a"):("id_list_free_deep")
given esc_dfix ((import efd_leak), "b"):("id_list_free")
given full_env (-1, "a"):("id_list_free")
given esc_sfix ((import efs_acc), "s"):("id_str_free")
given esc_fm_fix ((import efm_fn), "t"):("idfr_Tr")
