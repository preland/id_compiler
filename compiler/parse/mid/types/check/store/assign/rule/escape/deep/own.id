// Whether a local list also owns its elements, so that freeing it frees them
// (docs/MEMORY.md 3.2). Three conditions, each a proof obligation:
//   * the list is owned in the shallow sense (own/query.id): declared here,
//     every store a list literal, no use keeps it;
//   * its elements are lists, so there is something to free (esc_deep_ty);
//   * every element it holds was built for it -- a list literal, never a name
//     or a call's result -- and no element was read out into a position that
//     keeps it (bits 8 and 4 of the walk, deep/elem/), including by a callee
//     the list was passed to (esc_dbit).
// Only the elements are freed, shallowly: a list of lists of lists keeps its
// innermost lists, and a list of strings keeps its strings.

esc_deep_ty(string t) {
  int ok = is_list_ty(t) == 1 && is_list_ty(list_elem(t)) == 1;
} return int ok;
("int[][]"):(1)
("int[]"):(0)
("func(int) return int[][]"):(0)

esc_deep(int fn, string nm) {
  string t = esc_decl_type((import nl2)[fn], nm);
  int ok = 0;
  if(esc_deep_ty(t) == 1 && esc_own(fn, nm) == 1) {
    ok = (esc_func(fn, nm) & 12) == 0;
  }
} return int ok;
given esc_dfix ((import efd_good), "a"):(1)
given esc_dfix ((import efd_leak), "b"):(0)
given esc_dfix ((import efd_alias), "c"):(0)
given esc_dfix ((import efd_via), "d"):(0)

// The runtime call that frees the list or string `nm` of function `fn` when it
// dies.
esc_free_fn(int fn, string nm) {
  string fname = esc_free_base(fn, nm);
  if(esc_on() == 1 && esc_deep(fn, nm) == 1) {
    fname = "id_list_free_deep";
  }
} return string fname;
given esc_dfix ((import efd_good), "a"):("id_list_free_deep")
given esc_dfix ((import efd_leak), "b"):("id_list_free")
given full_env (-1, "a"):("id_list_free")
given esc_sfix ((import efs_acc), "s"):("id_str_free")
