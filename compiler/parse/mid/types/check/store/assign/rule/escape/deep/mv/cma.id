// The same for the expression `e`: a call whose callee takes one of the
// arguments into the argument that is the name `nm`.
esc_cmcall(int e, string nm) {
  int cmv_r = 0 - 1;
  if((import nkind)[e] == "call" && esc_cnt(e, nm) == 1) {
    cmv_r = esc_cmfind((import nl1)[e], (import ns1)[e], nm);
  }
} return int cmv_r;
