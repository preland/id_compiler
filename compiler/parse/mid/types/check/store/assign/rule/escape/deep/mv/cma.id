// A call that moves a name into the list `nm` through its callee (cmv.id): the
// push proof of deep/mv/push.id then judges it like `push(nm, row)`.

// The argument node that statement `sn` hands to a callee that takes it into
// the list `nm`, or -1.
esc_cmarg(int sn, string nm) {
  int cmv_r = 0 - 1;
  if(((import nkind)[sn] == "exprstmt" || (import nkind)[sn] == "decl" || (import nkind)[sn] == "assign") && (import ni1)[sn] >= 0) {
    cmv_r = esc_cmcall((import ni1)[sn], nm);
  }
} return int cmv_r;
