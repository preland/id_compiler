// The first argument node whose parameter `cname` takes into the argument that
// is the name `nm`, or -1.
esc_cmfind(int[] cmv_as, string cname, string nm) {
  int cmv_r = 0 - 1;
  int cmv_k = 0;
  while(cmv_k < len(cmv_as) && cmv_r < 0) {
    cmv_r = esc_cmpick(cmv_as, esc_cmvto(cname, cmv_k), cmv_k, nm);
    cmv_k = cmv_k + 1;
  }
} return int cmv_r;
