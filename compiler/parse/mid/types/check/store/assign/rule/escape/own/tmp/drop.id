// The runtime call that gives back a block the expression `e` made, a string
// and a list being different blocks, and the text of a statement that does so
// to a fresh call whose value nothing reads: `f(x);` is `id_list_free(id_f(x));`.
// A call whose result owns what it holds (a list of strings, a struct with
// fields: esc_dkind) gives back all of it.

esc_free_sh(int e) {
  string etx_fn = "id_list_free";
  if(type_of(e) == "string") {
    etx_fn = "id_str_free";
  }
  if(type_of(e) == "bytes") {
    etx_fn = "id_bytes_free";
  }
} return string etx_fn;
given esc_ffix ((import eff_cmk)):("id_list_free")
given esc_ffix ((import eff_csr)):("id_str_free")

esc_free_of(int e) {
  string etx_fn = esc_free_sh(e);
  if(esc_deepcall(e) == 1) {
    etx_fn = esc_dfn(type_of(e));
  }
} return string etx_fn;
given esc_ffix ((import eff_cmk)):("id_list_free")
given esc_ffix ((import eff_csr)):("id_str_free")
given esc_ffix ((import eff_crows)):("id_list_free_deep")

esc_deepcall(int e) {
  int ok = 0;
  if(esc_ctor(e) == 0 && esc_fresh_call(e) == 1 && esc_dkind(type_of(e)) > 0) {
    ok = esc_ndf(e) == 0;
  }
} return int ok;
given esc_ffix ((import eff_crows)):(1)
