// A `native`'s summary. Its body cannot be read, so every argument is kept
// unless the declaration says otherwise: a parameter marked `borrows`
// (front/parse/decl/top/decl/native/more/borrows/mark.id) promises that the C
// does not keep it, so both of its bits are clear and a caller may free a list
// it passed. A name that is no function, and one a case records, stay all
// bits.

esc_native_mask(int fn, string cname) {
  int m = 0 - 1;
  if(fn >= 0 && is_native(fn) == 1 && is_rec_target(cname) == 0) {
    m = esc_borrow_mask(fn);
  }
} return int m;
