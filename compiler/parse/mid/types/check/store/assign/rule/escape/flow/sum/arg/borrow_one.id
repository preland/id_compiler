// One parameter of a native: its two bits are cleared when the declaration
// marked its node `borrows`, and left as they were otherwise.

esc_borrow_one(int m, int pn, int i) {
  int r = m;
  if(borrow_has(pn) == 1) {
    r = m - (m & ((1 << i) | (1 << (15 + i))));
  }
} return int r;
given borrow_fixnode(4) {
  (-1, 4, 1):(-65539)
  (-1, 5, 1):(-1)
}

borrow_has(int pn) {
  int r = 0;
  int i = 0;
  while(i < len((import borrownode))) {
    if((import borrownode)[i] == pn) {
      r = 1;
    }
    i = i + 1;
  }
} return int r;
given borrow_fixnode(4) {
  (4):(1)
  (5):(0)
}

borrow_fixnode(int bfx_n) {
  full_env();
  push((import borrownode), bfx_n);
} return void;
(4):() then (import borrownode)[0]:(4)
(9):() then (import borrownode)[0]:(9)
