// A local list pushed once onto a list of lists is moved, not kept: the list
// of lists frees it with itself (docs/MEMORY.md 3.2). The proof is the one a
// constructor's struct uses (esc_movable, arg.id) on the statement `push(nm,
// row)`: `row` is declared in the same block, before the push, and mentioned
// nowhere else outside the span between, so it is a fresh block per execution
// of its declaration, reaches `nm` once and is read by nobody afterwards.

// 1 when statement `i` of `stmts` is not a push of a list name onto `nm`, or is
// one `nm` may own.
esc_pushat(int fn, int[] stmts, int i, string nm) {
  int ok = 1;
  int pm_arg = esc_pushof(stmts[i], nm);
  if(pm_arg >= 0) {
    ok = esc_mvarg(fn, stmts, i, pm_arg);
  }
} return int ok;
given esc_mp_fix ((import emp_fn), (import emp_body), 2, "mrows"):(1)
given esc_mp_fix ((import emp_bad), (import emp_bbody), 2, "mrows"):(0)
given esc_mp_fix ((import emp_fn), (import emp_body), 0, "mrows"):(1)
given esc_mp_fix ((import emp_fn), (import emp_body), 2, "mn"):(1)

// The node of the value a statement pushes onto `nm`, or -1.
esc_pushof(int sn, string nm) {
  int pm_arg = 0 - 1;
  if((import nkind)[sn] == "exprstmt") {
    pm_arg = esc_pushto((import ni1)[sn], nm);
  }
} return int pm_arg;
given esc_mp_fix ((import emp_ps), "mn"):(-1)
given esc_mp_fix ((import emp_wd), "mrows"):(-1)
given esc_mp_fix ((import emp_ps), "mrows"):(50)

esc_pushto(int e, string nm) {
  int pm_arg = 0 - 1;
  int[] pm_args = (import nl1)[e];
  if((import nkind)[e] == "call" && (import ns1)[e] == "push" && esc_isvar(pm_args[0], nm) == 1) {
    pm_arg = pm_args[1];
  }
} return int pm_arg;
given esc_mp_fix ((import emp_pc), "mrow"):(-1)
given esc_mp_fix ((import emp_wv), "mrows"):(-1)
given esc_mp_fix ((import emp_pc), "mrows"):(50)
