// Whether every constructor stored into the name `nm` takes only what its
// struct may own (docs/MEMORY.md 3.5b). The walk's flags already refuse a
// constructor with an argument that is not fresh and not a local list
// (bit 128); what is left to prove here is the local lists: each is declared
// in the same list of statements as the constructor, before it, is mentioned
// nowhere outside the span from its declaration to the constructor, and is
// otherwise only built (no keeping use, no element read out, no element that
// something else holds).

esc_mvok(int fn, string nm) {
  int ok = esc_mvin(fn, (import nl2)[fn], nm);
} return int ok;
given esc_fm_fix ((import efm_fn), "t"):(1)
given esc_fm_fix ((import efm_bad), "t"):(0)

esc_mvin(int fn, int[] stmts, string nm) {
  int ok = 1;
  int i = 0;
  while(i < len(stmts)) {
    ok = ok & esc_mvone(fn, stmts, i, nm);
    i = i + 1;
  }
} return int ok;
given esc_fm_fix ((import efm_fn), (import efm_body), "t"):(1)
given esc_fm_fix ((import efm_bad), (import efm_bbody), "t"):(0)

esc_mvone(int fn, int[] stmts, int i, string nm) {
  int sn = stmts[i];
  int ok = esc_mvnest(fn, sn, nm);
  if(esc_stgt(sn) == nm && esc_ctor((import ni1)[sn]) == 1) {
    ok = esc_mvctor(fn, stmts, i, (import ni1)[sn]);
  }
} chain (int fn, int[] stmts, int i, string nm) {
  ok = ok & esc_pushat(fn, stmts, i, nm);
} return int ok;
given esc_fm_fix ((import efm_fn), (import efm_body), 2, "t"):(1)
given esc_fm_fix ((import efm_bad), (import efm_bbody), 1, "t"):(0)
