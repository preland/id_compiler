// The declared type of a local, and whether it is a list this analysis frees.
// A function type that returns a list ends in "[]" too, but a function value is
// never a list literal, so the store rule would refuse it anyway; it is
// excluded here so the reason is plain.

esc_own2(int fn, string nm) {
  string t = esc_decl_type(l2_of(fn), nm);
  int ok = 0;
  if(is_list_ty(t) == 1) {
    ok = (esc_func(fn, nm) & 3) == 0;
  }
} return int ok;
given esc_fix ((import efc_fn), "w"):(1)
given esc_fix ((import efc_fn), "s"):(0)

is_list_ty(string t) {
  int ok = str_ends(t, "[]") == 1 && str_starts(t, "func") == 0;
} return int ok;
("int[]"):(1)
("int"):(0)
("func(int) return int[]"):(0)

esc_decl_type(int[] stmts, string nm) {
  string t = "";
  int i = 0;
  while(i < len(stmts) && t == "") {
    t = esc_type_of(stmts[i], nm);
    i = i + 1;
  }
} return string t;
given esc_fix ((import efc_stmts), "z"):("int[]")
given esc_fix ((import efc_stmts), "w"):("int[]")
given esc_fix ((import efc_stmts), "q"):("")
