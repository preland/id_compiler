// The declared type of a local, and whether it is a list, a struct or a string
// this analysis frees (the string half is own/str/own.id).
// A function type that returns a list ends in "[]" too, but a function value is
// never a list literal, so the store rule would refuse it anyway; it is
// excluded here so the reason is plain.
// The return clause is not a use that keeps a list: what it returns is the
// value the name holds last, which the caller owns (esc_exit leaves that one
// out of the frees at the function's exit), and every value a store replaced
// is dead whatever is returned. An early `return xs` does keep it.

esc_own2(int fn, string nm) {
  string t = esc_decl_type((import nl2)[fn], nm);
  int ok = esc_sown(fn, nm, t);
  if(esc_heap_list(t) == 1) {
    ok = (esc_block((import nl2)[fn], nm) & 579) == 0;
  }
} return int ok;
given esc_fix ((import efc_fn), "w"):(1)
given esc_fix ((import efc_fn), "s"):(0)
given esc_sfix ((import efs_acc), "s"):(1)
given esc_ffix ((import eff_pt), "p"):(1)
given esc_ffix ((import eff_glob), "r"):(0)

is_list_ty(string t) {
  int ok = string_ends_with(t, "[]") == 1 && string_starts_with(t, "func") == 0;
} return int ok;
("int[]"):(1)
("int"):(0)
("func(int) return int[]"):(0)

esc_decl_type(int[] stmts, string nm) {
  string t = "";
  int i = 0;
  while(i < len(stmts) && t == "") {
    t = esc_type_of(stmts[i], nm);
    i = i + 1;
  }
} return string t;
given esc_fix {
  ((import efc_stmts), "z"):("int[]")
  ((import efc_stmts), "w"):("int[]")
  ((import efc_stmts), "q"):("")
}
