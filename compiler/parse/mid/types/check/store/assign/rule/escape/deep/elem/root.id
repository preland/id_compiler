// The name an access path starts from: `t` in `t.kids[0].v`, in whatever
// number of index and field steps (a field is an index by a field name;
// imp_root, mid/names/limits/shape/cases/report/host/mark/init.id, finds it).
// The walks ask where a path starts for every read, push and store, because a
// struct's contents are reached by paths and not only by the name itself.

// 1 when `e` is an index or field path rooted at the variable `nm`.
esc_chain(int e, string nm) {
  int ok = 0;
  if((import nkind)[e] == "index") {
    ok = esc_isvar(imp_root(e), nm);
  }
} return int ok;
given esc_dfix ((import efd_ix), "g"):(1)
given esc_dfix ((import efd_ix), "h"):(0)
given esc_dfix ((import efd_g), "g"):(0)

esc_isvar(int e, string nm) {
  int ok = (import nkind)[e] == "var" && (import ns1)[e] == nm;
} return int ok;
given esc_dfix ((import efd_g), "g"):(1)
given esc_dfix ((import efd_g), "h"):(0)
given esc_dfix ((import efd_lit), "g"):(0)
