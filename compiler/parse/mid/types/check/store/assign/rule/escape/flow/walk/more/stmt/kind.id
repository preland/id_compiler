// The bits a store of `e` into a name adds when `e` is not a list literal
// (esc_fresh, store.id): 0 for a string literal, which a string owner copies to
// the heap when it stores it; otherwise esc_nonlit2's.
esc_nonlit(int e) {
  int r = esc_nonlit2(e);
  if((import nkind)[e] == "str") {
    r = 0;
  }
} return int r;
given esc_sfix ((import efs_lit0)):(0)
