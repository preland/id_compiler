// 16 + 8 * esc_ndf for a block made at this very expression (a constructor, or a call of a
// function that returns fresh): bit 16 gives a string name something to free,
// and bit 8 refuses it as the owner of its elements unless the call returns them
// as its own (esc_ndf); 16 for a fresh string (a concat, or a builtin that makes one); 2 for
// anything else, whose value may be held by another name.
esc_nonlit2(int e) {
  int r = 2;
  if(esc_fresh_node(e) == 1) {
    r = 16 + 8 * esc_ndf(e);
  } else if(str_fresh_node(e) == 1) {
    r = 16;
  }
} return int r;
