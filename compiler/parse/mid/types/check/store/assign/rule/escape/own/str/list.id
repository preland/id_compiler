// The tail of esc_cnt's dispatch: a unary operator, and the arguments of a
// call or the elements of a list literal.

esc_cnt3(int e, string nm) {
  int c = 0;
  if((import nkind)[e] == "un") {
    c = esc_cnt((import ni1)[e], nm);
  } else if((import nkind)[e] == "call" || (import nkind)[e] == "arr") {
    c = esc_cntl((import nl1)[e], nm);
  }
} return int c;
given esc_sfix ((import efs_cl), "n"):(1)
given esc_sfix ((import efs_arr), "n"):(1)
given esc_sfix ((import efs_vn), "n"):(0)

esc_cntl(int[] xs, string nm) {
  int c = 0;
  int i = 0;
  while(i < len(xs)) {
    c = c + esc_cnt(xs[i], nm);
    i = i + 1;
  }
} return int c;
given esc_sfix ([(import efs_vn), (import efs_vn)], "n"):(2)
given esc_sfix ([], "n"):(0)
