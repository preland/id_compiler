// The statement nodes the deep-ownership cases run against (c.id describes the
// whole program): `g[0] = v`, `g[0] = []`, and the bodies of fd_peek, fd_look
// and fd_good. Each statement is built from names rather than nested calls.

esc_fd_d() {
  export int efd_setb = node_iassign((import efd_ix), (import efd_v));
  export int efd_setl = node_iassign((import efd_ix), (import efd_lit));
  export int[] efd_gp = [node_param("param", "int[][]", "g")];
} chain () {
  export int efd_decr = node_decl("int[]", "r", (import efd_ix), 0);
  export int efd_lenc = node_call("len", [(import efd_ix)]);
  export int efd_decn = node_decl("int", "n", (import efd_lenc), 0);
} chain () {
  export int efd_peek = node_func("fd_peek", "int[]", (import efd_gp), [(import efd_decr)], node_var("r"));
  export int efd_look = node_func("fd_look", "int", (import efd_gp), [(import efd_decn)], node_var("n"));
  export int efd_va = node_var("a");
} return void;
given esc_dfix ():() then (import chkfail)[0]:(0)
given esc_dfix ():() then init_units:(0)

esc_fd_e() {
  export int efd_ai = node_index((import efd_va), node_int("0", 0, 0));
  export int efd_ad = node_decl("int[][]", "a", (import efd_lits), 0);
  export int efd_pc = node_call("push", [(import efd_va), (import efd_lit)]);
} chain () {
  export int efd_pushs = node_exprstmt((import efd_pc));
  export int efd_ia = node_iassign((import efd_ai), (import efd_lit));
  export int efd_fl = node_call("fd_look", [(import efd_va)]);
} chain () {
  export int efd_fls = node_exprstmt((import efd_fl));
  export int[] efd_gs = [(import efd_ad), (import efd_pushs), (import efd_ia), (import efd_fls)];
  export int[] efd_np = [node_param("param", "int", "n")];
} return void;
given esc_dfix ():() then (import chkfail)[0]:(0)
given esc_dfix ():() then init_units:(0)

esc_fd_f() {
  export int efd_good = node_func("fd_good", "void", (import efd_np), (import efd_gs), 0 - 1);
  export int efd_lbl = node_arr([(import efd_lit)]);
  export int efd_vb = node_var("b");
} chain () {
  export int efd_dlb = node_decl("int[][]", "b", (import efd_lbl), 0);
  export int efd_bi = node_index((import efd_vb), node_int("0", 0, 0));
  export int efd_dlr = node_decl("int[]", "r", (import efd_bi), 0);
} chain () {
  export int efd_leak = node_func("fd_leak", "void", (import efd_np), [(import efd_dlb), (import efd_dlr)], 0 - 1);
} return void;
given esc_dfix ():() then (import chkfail)[0]:(0)
given esc_dfix ():() then init_units:(0)
