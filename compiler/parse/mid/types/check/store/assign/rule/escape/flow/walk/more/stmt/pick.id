// The statement walk. Flag bit 1 is the expression walk's "escapes"; bit 2 is
// added here for a name that is assigned something other than a fresh list
// literal, because only a list this function built itself is its to free.
// The dispatch is a tower of two-way tests: each function has room for one
// test and the default, and a statement kind that is none of them (break,
// chain, blank) walks to 0.

esc_stmt(int sn, string nm) {
  int r = 0;
  if((import nkind)[sn] == "decl" || (import nkind)[sn] == "assign") {
    r = esc_store(sn, nm);
  } else {
    r = esc_stmt2(sn, nm);
  }
} return int r;
given esc_fix {
  ((import efb_dv), "p"):(1)
  ((import efb_dv), "v"):(2)
}

esc_stmt2(int sn, string nm) {
  int r = 0;
  if((import nkind)[sn] == "exprstmt") {
    r = esc_expr((import ni1)[sn], nm, 0);
  } else {
    r = esc_stmt3(sn, nm);
  }
} return int r;
given esc_fix {
  ((import efa_es), "b"):(512)
  ((import efa_es), "a"):(256)
}

esc_stmt3(int sn, string nm) {
  int r = 0;
  if((import nkind)[sn] == "iassign") {
    r = esc_iassign(sn, nm);
  } else {
    r = esc_stmt4(sn, nm);
  }
} return int r;
given esc_fix {
  ((import efa_ia), "b"):(1)
  ((import efa_ia), "a"):(8)
}
