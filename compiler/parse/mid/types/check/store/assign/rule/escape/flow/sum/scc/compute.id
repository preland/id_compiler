// The three lines every function's computation starts from: the depth it runs
// at, what the function that asked for it had read so far (put back when it
// is done), and how many functions were already waiting.
esc_scc(int ix, int fn) {
  int esd = (import esc_fx)[0];
  int esv = (import esc_fx)[1];
  int emk = len((import esc_mem));
} chain (int ix, int fn) {
  esc_open(ix, esd);
  esc_iter(ix, fn, esd, emk);
  esc_close(ix, esd, esv, emk);
} return void;
