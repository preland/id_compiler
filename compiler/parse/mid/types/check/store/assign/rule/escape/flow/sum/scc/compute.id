// Computing one function's summary. An opaque function (a name that is no
// function of the program, a `native`, one a case records) is final at once and
// says everything; any other is run by esc_scc.

esc_compute(int ix, string cname) {
  int fn = fn_node_of(cname);
  if(esc_opaque(fn, cname) == 1) {
    esc_final(ix, esc_native_mask(fn, cname));
  } else {
    esc_scc(ix, fn);
  }
} return void;
given esc_fix {
  (0, "fa_sink"):() then (import esc_pe)[0]:(32770)
  (0, "nosuch"):() then (import esc_pe)[0]:(-1)
  (1, "fa_loc"):() then (import esc_st)[1]:(3)
}

esc_final(int ix, int m) {
  integer_list_set((import esc_pe), ix, m);
  integer_list_set((import esc_st), ix, 3);
} return void;
