given esc_ffo (7) (7, (import eff_rec), 0, 0):(0)
given esc_ffo (4) (4, (import eff_make), 0, 0):(0)

esc_again(int esd, int emk, int ecg) {
  int elo = (import esc_fx)[1];
  int ean = 0;
  if(elo >= esd && (import esc_fx)[2] != ecg && (elo == esd || len((import esc_mem)) > emk)) {
    ean = 1;
    esc_drain(emk, 0);
  }
} return int ean;
