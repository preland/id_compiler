// The programs the constructor proof's cases run against, on top of esc_fix's:
//
//   fm_ok(int d) { Tr[] kids = []; if(d) { push(kids, fm_ok(d)); } Tr t = Tr(kids); }   returns t
//   fm_bad(int d) { Tr[] kids = []; Tr t = Tr(kids); int n = len(kids); }                returns t
//
// over `struct Tr { Tr[] kids; }`. fm_ok is the shape of a recursive builder
// whose struct takes over the list it filled; fm_bad reads the list after the
// struct has it.

esc_fm_a() {
  sd_note("Tr", ["kids"], ["Tr[]"], "tr.id", 1);
  add_var("kids", "Tr[]", 0);
  add_var("t", "Tr", 0);
} chain () {
  add_var("d", "int", 0);
  add_var("n", "int", 0);
  export int efm_kv = node_txt("var", "kids");
} chain () {
  export int efm_ds = node_decl("Tr[]", "kids", node_arr((import ef_none)), 0);
  export int efm_dv = node_txt("var", "d");
  export int efm_rc = node_call("fm_ok", [(import efm_dv)]);
} chain () {
  export int efm_pc = node_call("push", [(import efm_kv), (import efm_rc)]);
  export int efm_ps = node_exprstmt((import efm_pc));
} return void;
given esc_fm_fix ():() then calls sd_note:("Tr", ["kids"], ["Tr[]"], "tr.id", 1) then calls add_var:("kids", "Tr[]", 0) then calls add_var:("n", "int", 0)
given esc_fm_fix ():() then calls node_call:("fm_ok", [(import efm_dv)]) then calls node_call:("push", [(import efm_kv), (import efm_rc)])
given esc_fm_fix ():() then (import chkfail)[0]:(0)
given esc_fm_fix ():() then init_units:(0)

esc_fm_b() {
  export int efm_if = node_if(node_txt("var", "d"), [(import efm_ps)], (import ef_none), 0);
  export int efm_cc = node_call("Tr", [(import efm_kv)]);
  export int efm_ct = node_decl("Tr", "t", (import efm_cc), 0);
} chain () {
  export int[] efm_body = [(import efm_ds), (import efm_if), (import efm_ct)];
  export int efm_dn = node_decl("int", "n", node_call("len", [(import efm_kv)]), 0);
  export int[] efm_pd = [node_param("param", "int", "d")];
} chain () {
  export int efm_fn = node_func("fm_ok", "Tr", (import efm_pd), (import efm_body), node_txt("var", "t"));
  export int[] efm_bbody = [(import efm_ds), (import efm_ct), (import efm_dn)];
  export int efm_bad = node_func("fm_bad", "Tr", (import efm_pd), (import efm_bbody), node_txt("var", "t"));
} return void;
given esc_fm_fix ():() then calls node_call:("Tr", [(import efm_kv)]) then calls node_decl:("Tr", "t", (import efm_cc), 0)
given esc_fm_fix ():() then calls node_call:("len", [(import efm_kv)]) then calls node_param:("param", "int", "d")
given esc_fm_fix ():() then (import chkfail)[0]:(0)
given esc_fm_fix ():() then init_units:(0)

esc_fm_fix() {
  esc_fix();
  esc_fm_a();
  esc_fm_b();
} chain () {
  add_func("fm_ok", "Tr", (import efm_fn));
  add_func("fm_bad", "Tr", (import efm_bad));
  esc_seed();
} chain () {
  export int efm_bif = node_if(node_txt("var", "d"), [(import efm_ct)], (import ef_none), 0);
  export int efm_fl = newleaf("fld", 0, 0, "kids", "");
  export int efm_ix = node_index(node_txt("var", "t"), (import efm_fl));
} return void;
given esc_fm_fix ():() then calls add_func:("fm_ok", "Tr", (import efm_fn))
given esc_fm_fix ():() then calls add_func:("fm_bad", "Tr", (import efm_bad))
():() then calls esc_fix:[1]
():() then init_units:(0)
