// The index of the parameter node named `cmv_n` in `cmv_ps`, or -1.
esc_cmvpix(int[] cmv_ps, string cmv_n) {
  int cmv_j = 0 - 1;
  int cmv_i = 0;
  while(cmv_i < len(cmv_ps) && cmv_j < 0) {
    if((import ns2)[(cmv_ps[cmv_i])] == cmv_n) {
      cmv_j = cmv_i;
