// The expression half of moves through a callee (cmv.id, cmp.id).

// The parameter index that the call `cmv_e` pushes the name `cmv_kn` into, or
// -1: `push(pj, pk)` with `cmv_kn` as the second argument.
esc_cmvcall(int cmv_fn, int cmv_e, string cmv_kn) {
  int cmv_j = 0 - 1;
  int[] cmv_as = (import nl1)[cmv_e];
  if((import nkind)[cmv_e] == "call" && (import ns1)[cmv_e] == "push" && len(cmv_as) == 2 && esc_isvar(cmv_as[1], cmv_kn) == 1) {
    cmv_j = esc_cmvtgt(cmv_fn, cmv_as[0]);
  }
} return int cmv_j;
