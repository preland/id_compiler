// What one node says about a named variable: 0 for nothing, 1 for a store of
// the literal 0, 2 for a store of the literal 1, 3 for anything that makes the
// variable a counter -- another store, or arithmetic on it (arith.id).

bfl_class(int bfl_i, string bfl_nm) {
  int bfl_c = 0;
  if((import nkind)[bfl_i] == "bin") {
    bfl_c = bfl_arith(bfl_i, bfl_nm);
  } else {
    bfl_c = bfl_store_at(bfl_i, bfl_nm);
  }
} return int bfl_c;
given bfl_fixture {
  ((import bfl_d0), "fx_flag"):(1)
  ((import bfl_a1), "fx_flag"):(2)
  ((import bfl_plus), "fx_cnt"):(3)
  ((import bfl_d0), "other"):(0)
}

bfl_store_at(int bfl_i, string bfl_nm) {
  int bfl_c = 0;
  if((import nkind)[bfl_i] == "decl" && (import ns2)[bfl_i] == bfl_nm) {
    bfl_c = bfl_store(bfl_i);
  }
  if((import nkind)[bfl_i] == "assign" && (import ns1)[bfl_i] == bfl_nm) {
    bfl_c = bfl_store(bfl_i);
  }
} return int bfl_c;
given bfl_fixture {
  ((import bfl_d0), "fx_flag"):(1)
  ((import bfl_a1), "fx_flag"):(2)
  ((import bfl_a1), "other"):(0)
  ((import bfl_cas), "fx_cnt"):(3)
}

bfl_store(int bfl_i) {
  int bfl_v = bfl_lit((import ni1)[bfl_i]);
  int bfl_c = 3;
  if(bfl_v == 0) {
    bfl_c = 1;
  }
} chain (int bfl_i) {
  if(bfl_v == 1) {
    bfl_c = 2;
  }
} return int bfl_c;
given bfl_fixture {
  ((import bfl_d0)):(1)
  ((import bfl_a1)):(2)
  ((import bfl_cas)):(3)
}
