// Whether a local string may be freed by the function that declares it
// (docs/MEMORY.md 3.3). The proof obligations are the list ones, with two
// differences that come from strings being immutable and from there being no
// string literal that is a heap block:
//   * every store into it is a string literal or a fresh string (a concat, or
//     a builtin that makes one): bit 2 of the walk is a store of anything
//     else, and bit 16 is a store of a fresh one, which a name that only ever
//     holds literals does not need ownership for;
//   * no use of it keeps it (bit 1), where the return clause does not count:
//     the value it returns is the last one, and every value a store replaced
//     is dead whatever is returned (esc_exit says which names are freed at
//     the exit). An early `return s` does count, because it is a statement of
//     the body.
// A literal stored into an owned string is copied to the heap first
// (esc_dup), so every value an owned string holds is a block this function
// made and nothing else names. That is what lets the runtime free it without
// asking whether it is a literal, whatever its size.
// A freestanding build owns strings too (its runtime has size-class free lists for
// them); a function value it still never owns, since it has no id_clo_free.

esc_sown(int fn, string nm, string t) {
  int ok = 0;
  if(t == "string" || (ty_is_func(t) == 1 && esc_hosted() == 1)) {
    ok = esc_sflags(fn, nm);
  }
} return int ok;
given esc_sfix ((import efs_acc), "s", "string"):(1)
given esc_sfix ((import efs_clo), "k", "func(int) return int"):(1)
given esc_sfix ((import efs_cnone), "k", "func(int) return int"):(0)
given esc_sfix ((import efs_acc), "s", "int[]"):(0)
given esc_sfix_fs ((import efs_acc), "s", "string"):(1)
given esc_sfix_fs ((import efs_clo), "k", "func(int) return int"):(0)

esc_sflags(int fn, string nm) {
  int f = esc_block((import nl2)[fn], nm);
  int ok = (f & 579) == 0 && (f & 16) != 0;
} return int ok;
given esc_sfix ((import efs_acc), "s"):(1)
given esc_sfix ((import efs_dbl), "d"):(1)
given esc_sfix ((import efs_lit), "l"):(0)
given esc_sfix ((import efs_call), "c"):(0)
given esc_sfix ((import efs_alias), "a"):(0)

esc_hosted() {
  int ok = (import fsc)[0] == 0;
} return int ok;
given esc_sfix ():(1)
given esc_sfix_fs ():(0)
