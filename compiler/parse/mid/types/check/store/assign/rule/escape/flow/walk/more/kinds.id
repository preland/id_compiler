// The rest of esc_node's dispatch (../expr.id): operators and indexing read
// their operands, a list literal keeps its elements, and any other kind --
// a literal, an import, a function name -- holds no variable.

esc_node2(int e, string nm) {
  int r = 0;
  if((import nkind)[e] == "bin" || (import nkind)[e] == "index") {
    r = esc_two(e, nm);
  } else {
    r = esc_node3(e, nm);
  }
} return int r;
given esc_fix {
  ((import efb_bin), "p"):(512)
  ((import efb_bin), "t"):(256)
}

esc_node3(int e, string nm) {
  int r = 0;
  if((import nkind)[e] == "un") {
    r = esc_expr((import ni1)[e], nm, 0);
  } else if((import nkind)[e] == "arr") {
    r = esc_list((import nl1)[e], nm, 1);
  }
} return int r;
given esc_fix {
  ((import efb_un), "p"):(512)
  ((import efb_arr), "t"):(1)
  ((import efb_bin), "p"):(0)
}

esc_two(int e, string nm) {
  int r = esc_expr((import ni1)[e], nm, 0);
  int b = esc_expr((import ni2)[e], nm, 0);
  r = r | b;
} return int r;
given esc_fix {
  ((import efb_bin), "p"):(512)
  ((import efb_bin), "t"):(256)
}
