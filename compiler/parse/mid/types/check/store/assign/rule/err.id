decl_err(int id, string t, int e) {
  string s2_of_v = (import ns2)[id];
  string type_of_v = type_of(e);
  tc_diag(id, "E0609", "cannot initialize " + t + " '" + s2_of_v + "' with a " + type_of_v + " value", s2_of_v, "id converts nothing silently, so a variable holds exactly the type it was declared with", "give the variable the type of the value, or convert the value first, as in to_int(\"1\")");
} return void;
given decltype_fixture {
  ((import decl_list), "int[]", (import lit_a)):() then prints:("<stdin>:1: error: cannot initialize int[] 'xs' with a int value [E0609]\n  at: xs\n  why: id converts nothing silently, so a variable holds exactly the type it was declared with\n  help: give the variable the type of the value, or convert the value first, as in to_int(\"1\")\n")
  ((import decl_scalar), "int", (import lit_str)):() then prints:("<stdin>:1: error: cannot initialize int 'x' with a string value [E0609]\n  at: x\n  why: id converts nothing silently, so a variable holds exactly the type it was declared with\n  help: give the variable the type of the value, or convert the value first, as in to_int(\"1\")\n")
}

