given esc_ffix ("ff_ping"):(0)
given esc_ffix ("ff_pong"):(0)
given esc_ffix ("ff_bad"):(-1073741823)

esc_mask_at(int ix, string cname) {
  if((import esc_st)[ix] == 0) {
    esc_compute(ix, cname);
  } else {
    esc_low(ix);
  }
  int m = (import esc_pe)[ix];
} return int m;
given esc_fix (0, "fa_sink"):(32770)
given esc_fix (1, "fa_loc"):(-1073741823)

esc_low(int ix) {
  int elo = (import esc_dp)[ix];
  if((import esc_st)[ix] != 3 && elo < (import esc_fx)[1]) {
    integer_list_set((import esc_fx), 1, elo);
  }
} return void;
