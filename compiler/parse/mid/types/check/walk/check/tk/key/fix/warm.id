// A warm build: fa's key handed in as clean (its value is tk_key's own first
// case, ../key.id), before the keying runs (warm0) and after (warm). And a
// node whose check fails, with one function row to mark (bad).

tk_t_warm0() {
  tk_t_prep0();
  push((import tccin), "4208351378666089285");
} return void;
():() then tk_nkeys:("keys 0")
():() then tk_enabled:(1)

tk_t_warm() {
  tk_t_warm0();
  tk_setup();
} return void;
():() then tk_nskip:("skip 1")
():() then tk_nkeys:("keys 2")

tk_t_bad() {
  decltype_fixture();
  tk_prepare();
  push((import tkbad), 0);
} return void;
():() then tk_nbad:("bad 0")
():() then tk_nkeys:("keys 0")
