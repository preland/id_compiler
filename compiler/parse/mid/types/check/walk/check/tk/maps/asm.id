// An asm routine's signature lives in its own tables (front/parse/decl/kinds/asm/),
// not in anything the key reads, so a run naming one is never given a key --
// always checked, which costs a few kernel functions nothing. Its name is
// entered after the exports, so a name that is both is taken as the asm one.

tk_fill_asm(int tki) {
  while(tki < len((import afname))) {
    hash_map_put((import tkfk), (import tkfv), (import tkfu), (import tkfc), (import afname)[tki], 0 - 2);
    tki = tki + 1;
  }
} return void;
given tk_t_asm_late {
  (0):() then tk_asm_foo:(1)
  (1):() then tk_asm_foo:(0)
}

tk_is_asm(string name) {
  int tka = 0;
  if(hash_map_get((import tkfk), (import tkfv), (import tkfu), name, 0 - 1) == 0 - 2) {
    tka = 1;
  }
} return int tka;
given tk_t_asm {
  ("foo"):(1)
  ("fa"):(0)
}

// The type an export by this name has, or "".
tk_etype(string name) {
  int tke = hash_map_get((import tkfk), (import tkfv), (import tkfu), name, 0 - 1);
  string tkt = "";
  if(tke >= 0) {
    tkt = (import etypes)[tke];
  }
} return string tkt;
given tk_t_exp {
  ("gx"):("int")
  ("fa"):("")
}
