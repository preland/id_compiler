// The two tables the keys need, over idstd's hmap:
//
//   tkik/tkiv/tkiu/tkic  the clean keys bin/idc handed in (tccin), as a set
//   tkfk/tkfv/tkfu/tkfc  a name -> its row in enames when it is an export,
//                        or -2 when it is an asm routine's (asm.id)

tk_maps() {
  export string[] tkik = [];
  export int[] tkiv = [];
  export int[] tkiu = [];
} chain () {
  export int[] tkic = [];
  export string[] tkfk = [];
  export int[] tkfv = [];
} chain () {
  export int[] tkfu = [];
  export int[] tkfc = [];
  hmap_init((import tkik), (import tkiv), (import tkiu), (import tkic));
} chain () {
  hmap_init((import tkfk), (import tkfv), (import tkfu), (import tkfc));
  tk_fill_in(0);
  tk_fill_ex(0);
} chain () {
  tk_fill_asm(0);
} return void;
given tk_t_prep0 ():() then tk_nin:("in 0")
given tk_t_warm0 ():() then tk_nin:("in 1")

tk_fill_in(int tki) {
  while(tki < len((import tccin))) {
    hset_add((import tkik), (import tkiv), (import tkiu), (import tkic), (import tccin)[tki]);
    tki = tki + 1;
  }
} return void;
given tk_t_in1 (0):() then tk_nin:("in 1")
given tk_t_in1 (1):() then tk_nin:("in 0")

tk_fill_ex(int tki) {
  while(tki < len((import enames))) {
    hmap_put((import tkfk), (import tkfv), (import tkfu), (import tkfc), (import enames)[tki], tki);
    tki = tki + 1;
  }
} return void;
given tk_t_exp_late (0):() then tk_etype_gx:("int")
given tk_t_exp_late (1):() then tk_etype_gx:("")
