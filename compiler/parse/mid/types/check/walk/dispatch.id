// Dispatch for one node. Written as independent guards rather than the usual
// lazy chain: at most one of them fires, none of them returns anything, and
// three guards fit one block -- so the whole dispatch is four functions
// instead of one per kind.

tc_node(int id) {
  chk_voidarr(id);
  tc_g1(id);
  tc_g2(id);
} return void;
given decltype_fixture {
  ((import decl_list)):() then (import chkfail)[0]:(1)
  ((import decl_scalar)):() then (import chkfail)[0]:(0)
}

tc_g1(int id) {
  if((import nkind)[id] == "decl") {
    chk_decl(id);
  }
  if((import nkind)[id] == "assign") {
    chk_assign(id);
  }
  if((import nkind)[id] == "iassign") {
    chk_iasg(id);
  }
} return void;
given decltype_fixture ((import decl_list)):() then (import chkfail)[0]:(1)
given assign_build2 ((import assign_ok)):() then (import chkfail)[0]:(0)
given sd_use_fixture ((import sd_wz)):() then (import chkfail)[0]:(1)

// The two conditions differ only in their message, so they share a check.
tc_g2(int id) {
  if((import nkind)[id] == "if") {
    chk_cond(id, "condition has type void");
  }
  if((import nkind)[id] == "while") {
    chk_cond(id, "loop condition has type void");
    chk_counter_while(id);
  }
  tc_g3(id);
} return void;
given cmp_fixture {
  ((import bin_mixed)):() then (import chkfail)[0]:(1)
  ((import bin_eq)):() then (import chkfail)[0]:(0)
}
