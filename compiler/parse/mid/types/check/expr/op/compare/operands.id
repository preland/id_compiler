// What each comparison family accepts, and the knownness guard they share.
// The guard is a parameter rather than a call so the two families differ only
// in the rule they pass in.

cmp_bad(string lt, string rt, int okk) {
  int ok = 0;
  if(ty_pair_known(lt, rt) == 1 && okk == 0 && ty_kind_is(lt, "struct") == 0 && ty_kind_is(rt, "struct") == 0) {
    ok = 1;
  }
} return int ok;
given init_tyreg ("int", "word", 0):(1)
given init_tyreg ("int", "word", 1):(0)
given sd_reg ("P", "P", 0):(0)

eq_ok(string lt, string rt) {
  int ok = 0;
  if(lt == "string" && rt == "string" || lt == "bytes" && rt == "bytes" || ty_num(lt) == 1 && ty_num(rt) == 1) {
    ok = 1;
  }
} return int ok;
given init_tyreg {
  ("string", "string"):(1)
  ("int", "string"):(0)
  ("bytes", "bytes"):(1)
  ("bytes", "int"):(0)
}

ord_ok(string lt, string rt) {
  int ok = 0;
  if(ty_num(lt) == 1 && ty_num(rt) == 1) {
    ok = 1;
  }
} return int ok;
given init_tyreg {
  ("int", "word"):(1)
  ("string", "string"):(0)
}
