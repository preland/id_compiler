// The two comparison checks. Equality accepts two strings or two numbers;
// ordering accepts only two numbers -- id has no ordering on strings, and
// `"a" < "b"` is far more often a mistake than an intention.

chk_eq(int id) {
  int i1_of_v = (import ni1)[id];
  int i2_of_v = (import ni2)[id];
  eq_types(id, i1_of_v, i2_of_v);
} return void;
given cmp_fixture ((import bin_eq)):() then (import chkfail)[0]:(0)
given composite_fixture ((import bin_concat)):() then (import chkfail)[0]:(1)

eq_types(int id, int a, int b) {
  string lt = type_of(a);
  string rt = type_of(b);
  eq_report(id, lt, rt);
} return void;
given cmp_fixture ((import bin_eq), (import lit_a), (import lit_b)):() then (import chkfail)[0]:(0)
given cmp_fixture ((import bin_eq), (import lit_str), (import lit_a)):() then (import chkfail)[0]:(1)

eq_report(int id, string lt, string rt) {
  int eq_ok_v = eq_ok(lt, rt);
  if(cmp_bad(lt, rt, eq_ok_v) == 1) {
    tc_diag(id, "E0604", "cannot compare " + lt + " with " + rt, "", "== and != compare two strings or two numbers, and < <= > >= compare two numbers; id has no ordering on strings and no silent conversion between a string and a number", "compare like with like: convert one side first (to_int(s) makes a number of a string, and \"\" + n makes a string of a number), or to order strings use idstd's str_cmp(a, b)");
  }
} return void;
