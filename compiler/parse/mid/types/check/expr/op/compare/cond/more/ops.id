// Whether an operation and its operand are one comparison and one bitwise
// operator, and whether the operand was written inside parentheses.

ops_mixed(int id, int c) {
  string po = (import ns1)[id];
  string co = (import ns1)[c];
  int ok = mixed_ops(po, co);
} return int ok;
given cmp_fixture {
  ((import bin_mixed), (import bin_bitand)):(1)
  ((import bin_plus), (import bin_bitand)):(0)
}

// is_relop includes id's bare `=`, which is equality inside an expression.
mixed_ops(string po, string co) {
  int ok = 0;
  if(str_in((import relops), po) == 1 && str_in((import bitops), co) == 1 || str_in((import bitops), po) == 1 && str_in((import relops), co) == 1) {
    ok = 1;
  }
} return int ok;
("<", "&"):(1)
("+", "&"):(0)

// nparen holds only binary nodes that were parenthesized, so it is short; a
// scan is cheaper than a slot on every node would be to keep aligned.
paren_missing(int c) {
  int i = 0;
  int ok = 1;
  while(i < len((import nparen))) {
    if((import nparen)[i] == c) {
      ok = 0;
    }
    i = i + 1;
  }
} return int ok;
given cmp_fixture {
  ((import bin_bitand)):(1)
  ((import bin_eq)):(1)
}
