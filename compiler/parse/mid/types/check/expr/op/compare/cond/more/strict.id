// `--bool-strict`: a condition is a bool, and an int (or word) is not one. The
// fix is the comparison the reader meant, `X != 0`, which is what C does
// implicitly. Without the flag nothing here fires (docs/SPEC.md, section 2.4).

cond_strict(int id, string t) {
  if((import bsc)[0] == 1 && (t == "int" || t == "word")) {
    int cond_e = (import ni1)[id];
    cond_strict_say(id, t, show_expr(cond_e));
  }
} return void;
given cmp_fixture {
  given integer_list_set((import bsc), 0, 1) ((import bin_eq), "int"):() then (import chkfail)[0]:(1)
  given integer_list_set((import bsc), 0, 1) ((import bin_eq), "bool"):() then (import chkfail)[0]:(0)
  ((import bin_eq), "int"):() then (import chkfail)[0]:(0)
}

cond_strict_say(int id, string t, string cond_was) {
  int cond_ln = tc_line(id);
  string cond_fix = cond_was + " != 0";
  tc_diag(id, "E0646", "a condition must be a bool, got " + t + " '" + cond_was + "'", cond_was, "an int is not a truth value under --bool-strict; the condition says what is being tested, so write the comparison", "write '" + cond_fix + "'");
} chain (int id, string t, string cond_was) {
  diag_edit("machine", "replace", cond_ln, cond_was, cond_fix);
} return void;
given cmp_fixture {
  ((import bin_eq), "int", "n"):() then prints:("<stdin>:1: error: a condition must be a bool, got int 'n' [E0646]\n  at: n\n  why: an int is not a truth value under --bool-strict; the condition says what is being tested, so write the comparison\n  help: write 'n != 0'\n  edit: machine\treplace\t1\tn\tn != 0\n")
  ((import bin_eq), "word", "w"):() then prints:("<stdin>:1: error: a condition must be a bool, got word 'w' [E0646]\n  at: w\n  why: an int is not a truth value under --bool-strict; the condition says what is being tested, so write the comparison\n  help: write 'w != 0'\n  edit: machine\treplace\t1\tw\tw != 0\n")
}
