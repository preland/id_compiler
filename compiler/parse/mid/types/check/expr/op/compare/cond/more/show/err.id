// The diagnostic shows the expression as written and as the current precedence
// groups it, so the reader learns what it means today without looking up the
// table, and has the spelling to paste.

mixed_err(int id, int c) {
  string words = mixed_words(id, c);
  string want = mixed_fix(id);
  mixed_say(id, words, want);
} return void;
given cmp_fixture ((import bin_mixed), (import bin_bitand)):() then prints:("<stdin>:1: error: '2 & 5 < 2' mixes a bitwise '&' with a comparison '<'; parenthesize it as the current precedence reads it: '(2 & 5) < 2' [E0601]\n  at: 2 & 5 < 2\n  why: the bitwise operators bind tighter than the comparisons in id and looser in C, so a reader who knows the other table reads the line differently; the rule asks for the grouping to be written down\n  help: write the parentheses the current precedence implies\n  edit: machine\treplace\t1\t2 & 5 < 2\t(2 & 5) < 2\n")
given cmp_fixture ((import bin_mixed), (import lit_a)):() then prints:("<stdin>:1: error: '2 & 5 < 2' mixes a bitwise '2' with a comparison '<'; parenthesize it as the current precedence reads it: '(2 & 5) < 2' [E0601]\n  at: 2 & 5 < 2\n  why: the bitwise operators bind tighter than the comparisons in id and looser in C, so a reader who knows the other table reads the line differently; the rule asks for the grouping to be written down\n  help: write the parentheses the current precedence implies\n  edit: machine\treplace\t1\t2 & 5 < 2\t(2 & 5) < 2\n")

mixed_say(int id, string words, string want) {
  string was = show_bin(id);
  int mixed_ln = tc_line(id);
  tc_diag(id, "E0601", "'" + was + "' mixes " + words + "; parenthesize it as the current precedence reads it: '" + want + "'", was, "the bitwise operators bind tighter than the comparisons in id and looser in C, so a reader who knows the other table reads the line differently; the rule asks for the grouping to be written down", "write the parentheses the current precedence implies");
} chain (int id, string words, string want) {
  diag_edit("machine", "replace", mixed_ln, was, want);
} return void;
