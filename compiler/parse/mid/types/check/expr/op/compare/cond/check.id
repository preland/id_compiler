// The void condition, and the split between the two comparison families.

// A condition that is a call to a void function is the one type error the
// registry answers directly: "unit" is the kind of a type with no values, and
// a value is exactly what a condition needs.
chk_cond(int id, string msg) {
  int i1_of_v = i1_of(id);
  string type_of_v = type_of(i1_of_v);
  cond_kind(id, msg, type_of_v);
} return void;
given cmp_fixture ((import bin_eq), "bad cond"):() then check_failed:(0)
given cmp_fixture ((import bin_mixed), "bad cond"):() then check_failed:(0)

// A function value is a value, but not a truth: C would test the address,
// which is never zero, so the condition would always hold.
cond_kind(int id, string msg, string t) {
  if(ty_kind(t) == "unit") {
    tc_err(id, msg);
  } else if(ty_kind(t) == "func") {
    tc_err(id, "a condition cannot be a function value (" + t + "); call it, and test what it returns");
  }
} return void;
given cmp_fixture (0, "bad cond", "void"):() then check_failed:(1)
given cmp_fixture (0, "bad cond", "int"):() then check_failed:(0)

// `==`, `!=` and id's bare `=` compare; `< <= > >=` order. is_eqop already
// exists (in back/, for string equality's strcmp) and says exactly this --
// writing it again here would be duplicate logic, which is a compile error.
// It is a fact about id's operators, not about C, so it belongs in mid/ and
// should move here when the emitter is restructured.
chk_bin(int id) {
  fv_bin(id);
  chk_bits(id);
  chk_mixed(id);
} return void;
given cmp_fixture ((import bin_eq)):() then check_failed:(0)
given cmp_fixture ((import bin_mixed)):() then check_failed:(1)
