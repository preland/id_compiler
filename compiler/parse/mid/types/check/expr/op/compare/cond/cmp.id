fv_side(int id, int e, string side) {
  string t = type_of(e);
  if(ty_is_func(t) == 1) {
    string op = s1_of(id);
    tc_err(id, "'" + op + "' cannot take a function value: its " + side + " operand is " + t + "; a function value can only be passed, stored or called");
  }
} return void;
