  ((import bin_lt)):() then (import chkfail)[0]:(0)
}

// No binary operator takes a function value (docs/SPEC.md 1.1): arithmetic on
// one is arithmetic on an address, and comparing two tells apart functions
// that are not named where the comparison is written. Asked of every binary
// node, ahead of the comparison checks it hands on to.
fv_bin(int id) {
  fv_side(id, (import ni1)[id], "left");
  fv_side(id, (import ni2)[id], "right");
  chk_cmp(id);
} return void;
given cmp_fixture {
  ((import bin_eq)):() then (import chkfail)[0]:(0)
  ((import bin_lt)):() then (import chkfail)[0]:(0)
}

fv_side(int id, int e, string side) {
  string t = type_of(e);
  if(ty_is_func(t) == 1) {
    string op = (import ns1)[id];
    tc_err(id, "'" + op + "' cannot take a function value: its " + side + " operand is " + t + "; a function value can only be passed, stored or called");
  }
  if(ty_kind_is(t, "struct") == 1) {
    tc_err(id, "'" + (import ns1)[id] + "' cannot take a struct: its " + side + " operand is " + t + "; a struct is compared and combined by field, as in a." + sd_cell((import sdfname), t, 0) + " " + (import ns1)[id] + " b." + sd_cell((import sdfname), t, 0));
  }
} chain (int id, int e, string side) {
  if(t == "bytes" && (import ns1)[id] == "+") {
    tc_diag(id, "E0641", "'+' cannot take bytes: its " + side + " operand is bytes; a byte buffer is not joined by +, which would copy it on every step -- append in place with bytes_append(dst, src), or convert it with string_of_bytes(b) to join it to text", "+", "+ joins strings and adds numbers, and a byte buffer is neither", "append in place with bytes_append(dst, src), or convert the buffer with string_of_bytes(b) before joining it to text");
  }
} return void;
