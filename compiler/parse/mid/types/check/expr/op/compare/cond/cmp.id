// No binary operator takes a function value (docs/SPEC.md 1.1): arithmetic on
// one is arithmetic on an address, and comparing two tells apart functions
// that are not named where the comparison is written. Asked of every binary
// node, ahead of the comparison checks it hands on to.
fv_bin(int id) {
  fv_side(id, (import ni1)[id], "left");
  fv_side(id, (import ni2)[id], "right");
  chk_cmp(id);
} return void;
