// One element of an operand list, a binary operation, and an operand that
// keeps the parentheses it was written with.

show_arg_at(int[] l, int i, string out) {
  string sep = "";
  if(i > 0) {
    sep = ", ";
  }
  string ret_s = out + sep + show_expr(l[i]);
} return string ret_s;
given shapes_fixture ((import arr_elems), 0, ""):("2")
given shapes_fixture ((import arr_elems), 1, "2"):("2, 5")

show_bin(int id) {
  int i1_of_v = i1_of(id);
  int i2_of_v = i2_of(id);
  string ret_s = show_side(i1_of_v) + " " + s1_of(id) + " " + show_side(i2_of_v);
} return string ret_s;
given cmp_fixture ((import bin_eq)):("2 == 5")
given composite_fixture ((import bin_concat)):("hi + 2")

show_side(int c) {
  string out = show_expr(c);
  if(k_of(c) == "bin" && paren_missing(c) == 0) {
    out = "(" + out + ")";
  }
} return string out;
given leaves_fixture ((import lit_a)):("2")
given cmp_fixture ((import bin_bitand)):("2 & 5")
