// A function returning "int" whose own return expression is a string --
// bad_store fires but fn_ret_type does not (the declared type "int" is not
// itself a function type), unlike fnret_fixture's fnret_bad.
badexpr_fixture() {
  chkret_fixture();
  badexpr_build();
} return void;
