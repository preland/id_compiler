// Negation is the one with its own wording in idc.py; `!` and `~` share
// theirs, and naming the operator in it is what tells them apart.
chk_un2(int id, string t) {
  if((import ns1)[id] == "-" && ty_num(t) == 0) {
    tc_err(id, "cannot negate a " + t);
  } else if((import ns1)[id] != "-" && ty_int(t) == 0) {
    string s1_of_v = (import ns1)[id];
    tc_err(id, "cannot apply '" + s1_of_v + "' to a " + t);
  }
} return void;
