given composite_fixture ((import un_neg)):() then (import chkfail)[0]:(0)
given sd_decl_fixture ((import sd_dbad)):() then (import chkfail)[0]:(1)

chk_un(int id) {
  int i1_of_v = (import ni1)[id];
  string t = type_of(i1_of_v);
  if(ty_known(t) == 1) {
    chk_un2(id, t);
  }
} return void;
