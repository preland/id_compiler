// A function value cannot be a function's return type (docs/SPEC.md 1.1). A
// value handed back by a call has an origin its caller cannot see; one stored
// in an export or passed down is chosen at the line that stores or passes it.
// pline's matching entry (line 7), and id 12: "other(string b) return int" --
// same return type as fwd1 but a mismatched parameter, for the signature
// checks' negative cases.
farm_i() {
  farm_h();
  push((import pline), 7);
  export int f_other = node_func("other", "int", [(import f_pb)], (import f_none), 0 - 1);
} return void;
():() then check_failed:(0)
():() then init_units:(0)

fn_ret_type(int id) {
  string rt = s2_of(id);
  if(ty_is_func(rt) == 1) {
    string nm = s1_of(id);
    tc_err(id, "'" + nm + "' returns " + rt + "; a function value cannot be a function's return type -- store it in an export, or pass it to the function that calls it");
  }
} return void;
