// A synthetic compiler environment for a test case: everything newnode
// (front/tree/node/newnode/) and type_of/ty_narrows (../../../../type_of/,
// ../../../registry/) read before a node exists to ask about. No case here
// parses anything; env_init just runs the same init functions a real build
// runs before the first node is pushed, so a case can build one by hand.
// env_init3 runs init_lines2 first (not last) so chkfail exists by the time
// any of the three has returned, and check_failed is safe to call from any
// of their own cases below.

env_init() {
  setup();
  env_init2();
} return void;
():() then check_failed:(0)
():() then init_units:(0)

env_init2() {
  init_pos();
  init_units();
  env_init3();
} return void;
():() then check_failed:(0)
():() then init_units:(0)

env_init3() {
  init_lines2();
  init_tyreg();
  init_tcache();
} return void;
():() then check_failed:(0)
():() then init_units:(0)
