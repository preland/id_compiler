// The return clause against the declared return type.
//
// Not a call check, but the same question one step out -- idc.py raises it in
// gen_function, immediately after the body -- and it needs the same two
// fields of the func node that the call checks read, so it sits with them.
//
// `return void;` records -1 in the int field and has no expression to judge.
//
// An early `return` (front/parse/stmt/form/branch/exprstmt_if.id) is checked
// here too: it carries its function's name and return type in the same fields.
// Its value can disagree with the signature in a way the return clause's
// syntax rules out -- a value in a void function, or none in a typed one --
// which the chained segments report, for `ret` nodes only: a `native`
// declaration is a func node with a type and no value, and is not a mistake.

chk_retexpr(int id) {
  int e = i1_of(id);
  if(s2_of(id) != "void" && e >= 0) {
    chk_ret2(id, e);
  }
  fn_ret_type(id);
} chain (int id) {
  string ret_fn_nm = s1_of(id);
  string ret_fn_ty = s2_of(id);
  if(k_of(id) == "ret" && ret_fn_ty == "void" && e >= 0) {
    tc_err(e, "'" + ret_fn_nm + "' returns void, so its 'return' takes no value; write 'return;'");
  }
} chain (int id) {
  if(k_of(id) == "ret" && ret_fn_ty != "void" && e < 0) {
    tc_err(id, "'" + ret_fn_nm + "' returns " + ret_fn_ty + ", so 'return;' needs a value; write 'return NAME;' or 'return LITERAL;'");
  }
} return void;
given chkret_fixture ((import fixture_fn)):() then check_failed:(0)
given badexpr_fixture ((import badexpr_fn)):() then check_failed:(1)

chk_ret2(int id, int e) {
  string s2_of_v = s2_of(id);
  if(bad_store(s2_of_v, e) == 1) {
    string type_of_v = type_of(e);
    ret_err(id, type_of_v);
  } else {
    string type_of_v2 = type_of(e);
    chk_ret_narrow(id, type_of_v2);
  }
} return void;
given chkret_fixture ((import fixture_fn), (import lit_str)):() then check_failed:(1)
given chkret_fixture ((import fixture_fn), (import lit_a)):() then check_failed:(0)

// Reported at the return expression, not at the function heading: the clause
// is written after the closing brace and is often lines away from the name.
ret_err(int id, string t) {
  int i1_of_v = i1_of(id);
  string msg = ret_err_msg(id, t);
  tc_err(i1_of_v, msg);
} return void;
given fn_fixture ((import fixture_fn), "string"):() then prints:("<stdin>:1: error: function 'fx_target' returns int but the expression has type string\n")
given fn_fixture ((import fixture_fn), "word"):() then prints:("<stdin>:1: error: function 'fx_target' returns int but the expression has type word\n")
