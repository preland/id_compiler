// Suppressing the read-index diagnostic on an index-assignment target.
//
// `n[0] = 1` is parsed as an index expression which is then discovered to be
// an assignment target, so the index node stays in the store even though the
// iassign node replaces it. idc.py never has one -- it builds
// IndexAssignStmt directly and generates nothing for the target expression --
// so without this the same mistake is reported twice, once in each spelling.
//
// The test is exact rather than positional: node_iassign copies the target's
// own base and index node ids, and an expression node id occurs in exactly
// one place, so an iassign carrying both of this node's children IS this
// node's replacement.
//
// It runs only when a diagnostic is about to be printed, never on the walk,
// so scanning the store here costs nothing on a program that compiles.

ix_err(int id, string msg) {
  if(is_ia_target(id) == 0) {
    tc_err(id, msg);
  }
} return void;

is_ia_target(int id) {
  int i = 0;
  int ok = 0;
  while(i < len((import nkind))) {
    ok = ia_hit(i, id, ok);
    i = i + 1;
  }
} return int ok;

ia_hit(int i, int id, int ok) {
  int r = ok;
  if(k_of(i) == "iassign" && i1_of(i) == i1_of(id) && i2_of(i) == i2_of(id)) {
    r = 1;
  }
} return int r;
