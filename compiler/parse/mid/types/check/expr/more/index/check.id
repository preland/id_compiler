// Reading `base[index]`. The same two questions index-assignment asks, and
// the first has the same answer word for word; only the index diagnostic is
// spelled differently in idc.py ("array index" for a read, "list index" for a
// store), so both spellings are kept rather than unified.
//
// This matters beyond the diagnostic: elem_type of a non-list is nonsense --
// elem_type("int") is "i" -- so an unchecked read-index feeds a type that
// does not exist into everything downstream. Catching it here is what stops
// that nonsense from being reported as if it were a type.

tc_g4(int id) {
  if((import nkind)[id] == "arr") {
    chk_arr(id);
  }
  if((import nkind)[id] == "index") {
    chk_access(id);
  }
  tc_g5(id);
} return void;
given idxfix ((import rgidx_node)):() then calls chk_access:((import rgidx_node))
given call2_setup ((import cm_push_call)):() then (import chkfail)[0]:(0)
given sd_use_fixture ((import sd_iz)):() then (import chkfail)[0]:(1)

chk_index(int id) {
  string bt = base_type(id);
  if(ty_known(bt) == 1 && ty_is_list(bt) == 0) {
    ix_err(id, "cannot index a " + bt + ix_hint(bt));
  } else {
    chk_index2(id);
  }
} return void;
given idxfix ((import rgidx_node)):() then calls ix_err:((import rgidx_node), "cannot index a int")
given idxquiet ((import idx_node3)):() then calls chk_index2:((import idx_node3))

chk_index2(int id) {
  int i2_of_v = (import ni2)[id];
  string it = type_of(i2_of_v);
  if(ty_known(it) == 1 && it != "int") {
    tc_diag(id, "E0614", "list index must be int, got " + it, it, "an index counts elements, so only an int can say which one", "use an int index, or convert it first, as in to_int(x)");
  }
} return void;
