// Pushing onto something that is not a list is idc.py's "push expects a list"
// -- a different check -- so a non-list first argument is left alone here.
chk_push2(int id, int[] args, string lt) {
  string et = elem_type(lt);
  if(ty_is_list(lt) == 1 && bad_store(et, args[1]) == 1) {
    string type_of_v = type_of(args[1]);
    tc_err(id, "cannot push a " + type_of_v + " onto a " + lt);
  }
} return void;
