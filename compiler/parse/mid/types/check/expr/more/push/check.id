// `[]` carries no element type, so it is only meaningful where something else
// supplies one. arr_ok asks whether any node in the program uses this literal
// in such a position.
chk_arr(int id) {
  int[] l1_of_v = l1_of(id);
  if(len(l1_of_v) == 0 && arr_ok(id) == 0) {
    tc_err(id, "an empty list literal needs a known list type here (e.g. on a typed declaration)");
  }
} return void;
