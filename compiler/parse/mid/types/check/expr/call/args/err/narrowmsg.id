narrow_err_msg(int id, int fn, int i, string t) {
  string pname = param_name(fn, i);
  string pt = param_type(fn, i);
  string msg = narrow_err_msg2(id, pname, pt, t);
} return string msg;

narrow_err_msg2(int id, string pname, string pt, string t) {
  string callname = s1_of(id);
  string msg = "argument '" + pname + "' of '" + callname + "' narrows " + t + " to " + pt + "; declare a " + pt + " local and pass that";
} return string msg;
