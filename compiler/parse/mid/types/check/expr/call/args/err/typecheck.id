// The parameter's declared type, for the bad-store test and reused as the
// "expects" half of the mismatch message.
param_type(int fn, int i) {
  int[] ps = l1_of(fn);
  string t = s1_of(ps[i]);
} return string t;
given argfn_d ((import argfn_fn), 0):("int")
given argfn_match_call ((import argfn_call_match), 0):("1")

chk_arg_typecheck(int id, int fn, int i, int a) {
  string pt = param_type(fn, i);
  if(bad_store(pt, a) == 1) {
    string type_of_v = type_of(a);
    arg_err(id, fn, i, type_of_v);
  } else {
    string type_of_v2 = type_of(a);
    chk_narrow(id, fn, i, type_of_v2);
  }
} return void;
