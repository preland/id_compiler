// What is wrong with one value of a `bind`, or "" when nothing is. The three
// answers in the order they are asked: the value is not the parameter's type,
// it narrows into it (an argument may not, docs/SPEC.md 1), or the parameter's
// type is one a closure cannot hold (docs/SPEC.md 1.1.1).

bind_val_msg(int id, int i, string pt, int v) {
  string who = bind_who(id, i);
  string t = type_of(v);
  string msg = bind_cap_msg(who, pt);
} chain (int id, int i, string pt, int v) {
  if(bad_store(pt, v) == 1) {
    msg = who + " expects " + pt + ", got " + t;
  } else if(ty_narrows(pt, t) == 1) {
    msg = who + " narrows " + t + " to " + pt + "; declare a " + pt + " local and pass that";
  }
} return string msg;
given bind_fixture ((import bind_str), 0, "string", (import bind_lit)):("'bind' value 0 for 'fx_target' expects string, got int")
given bind_fixture ((import bind_str), 0, "int", (import bind_big)):("'bind' value 0 for 'fx_target' narrows word to int; declare a int local and pass that")

bind_cap_msg(string who, string pt) {
  string msg = "";
  if(ty_kind_is(pt, "struct") == 1) {
    msg = who + " cannot be captured: it is a " + pt + ", a struct, which is a reference the closure would share with its owner; capture the fields it needs as separate values";
  } else if(bind_nested(pt) == 1) {
    msg = who + " cannot be captured: it is a " + pt + ", a list whose elements are themselves lists or structs, so a copy would still share them; capture a list of ints, words, floats or strings (one row, or the rows flattened into one list)";
  }
} return string msg;
given bind_fixture ("w", "int[][]"):("w cannot be captured: it is a int[][], a list whose elements are themselves lists or structs, so a copy would still share them; capture a list of ints, words, floats or strings (one row, or the rows flattened into one list)")
given bind_fixture ("w", "int[]"):("")

bind_nested(string pt) {
  string et = elem_type(pt);
  int ok = 0;
  if(ty_is_list(pt) == 1 && (ty_is_list(et) == 1 || ty_kind_is(et, "struct") == 1)) {
    ok = 1;
  }
} return int ok;
given bind_fixture ("int[][]"):(1)
given bind_fixture ("string[]"):(0)
