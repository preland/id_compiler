// A `bind` whose first argument is not the name of a function. Three things it
// can be -- a builtin, a variable of function type, any other expression -- and
// a fourth, a name nothing declares, which the access pass reports as the
// undefined variable it is, so this reports nothing for it (its type is "").

bind_notfn(int id, int a) {
  string msg = bind_notfn_msg(a);
  if(msg != "") {
    tc_err(id, msg);
  }
} return void;
given bind_fixture ((import bind_var), (import bind_cvar)):() then (import chkfail)[0]:(1)
given bind_fixture ((import bind_var), (import bind_unknown)):() then (import chkfail)[0]:(0)

bind_notfn_msg(int a) {
  string t = type_of(a);
  string nm = (import ns1)[a];
  string msg = bind_kind_msg(t);
} chain (int a) {
  if((import nkind)[a] == "var" && is_builtin(nm) == 1) {
    msg = "'bind' cannot bind '" + nm + "': it is a builtin, not a function defined in id; write a function that calls '" + nm + "' and bind that";
  } else if(ty_is_func(t) == 1) {
    msg = "'bind' takes the name of a function written in id, but '" + nm + "' is a variable of type " + t + "; bind the function by its own name where it is known, or pass '" + nm + "' on unchanged";
  }
} return string msg;
given bind_fixture ((import bind_cvar)):("'bind' takes the name of a function written in id, but 'cv' is a variable of type func(int) return int; bind the function by its own name where it is known, or pass 'cv' on unchanged")
given bind_fixture ((import bind_lit)):("'bind' takes the name of a function written in id as its first argument, but it is a int; write bind(NAME, value, ...)")
given bind_fixture ((import bind_blt)):("'bind' cannot bind 'len': it is a builtin, not a function defined in id; write a function that calls 'len' and bind that")

bind_kind_msg(string t) {
  string msg = "";
  if(t != "") {
    msg = "'bind' takes the name of a function written in id as its first argument, but it is a " + t + "; write bind(NAME, value, ...)";
  }
} return string msg;
("int"):("'bind' takes the name of a function written in id as its first argument, but it is a int; write bind(NAME, value, ...)")
