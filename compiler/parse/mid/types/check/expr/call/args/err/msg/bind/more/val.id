given bind_fixture ((import bind_ok), ["int"], 1):() then (import chkfail)[0]:(0)

bind_val(int id, string[] pts, int i) {
  int v = (import nl1)[id][i + 1];
  string msg = bind_val_msg(id, i, pts[i], v);
  if(msg != "") {
    tc_err(v, msg);
  }
} return void;
