// The values of a `bind`, one at a time, each against the parameter it fixes.
// The values are the arguments after the first, so value i is argument i + 1.

bind_vals(int id, string[] pts, int nbound) {
  int i = 0;
  while(i < nbound) {
    bind_val(id, pts, i);
    i = i + 1;
  }
} return void;
