
bi_ok2(string want, string t) {
  int ok = bi_ok3(want, t);
  if(want == "list" && ty_is_list(t) == 0 && t != "bytes") {
    ok = 0;
  }
} return int ok;
("list", "int[]"):(1)
("list", "int"):(0)
("list", "bytes"):(1)

bi_ok3(string want, string t) {
  int ok = 1;
  if(want == "strlist" && bi_strlist(t) == 0) {
    ok = 0;
  } else if((want == "word" || want == "addr") && ty_kind_is(t, "int") == 0) {
    ok = 0;
  }
} return int ok;
given env_init {
  ("word", "int"):(1)
  ("word", "string"):(0)
}

// `len` is the one builtin that accepts two unrelated shapes, because a
// string's length and a list's length are the same question to a reader even
// though they are different C calls.
bi_strlist(string t) {
  int ok = 0;
  if(t == "string" || t == "bytes" || ty_is_list(t) == 1) {
    ok = 1;
  }
} return int ok;
("string"):(1)
("int"):(0)
("bytes"):(1)
