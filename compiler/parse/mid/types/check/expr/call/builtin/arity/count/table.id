// How many arguments each builtin takes. Two is the common case and so the
// default; the other two are listed, and str_sub is the one builtin of three.

bi_arity(string name) {
  int n = 2;
  if(bi_zero(name) == 1) {
    n = 0;
  } else if(bi_one(name) == 1) {
    n = 1;
  }
} chain (string name) {
  if(name == "str_sub") {
    n = 3;
  }
} return int n;
("flush"):(0)
("push"):(2)
("str_sub"):(3)

bi_zero(string name) {
  int ok = 0;
  if(name == "input" || name == "read_all" || name == "flush" || name == "getkey" || name == "ticks" || name == "store_size") {
    ok = 1;
  }
} return int ok;
("flush"):(1)
("push"):(0)

bi_one(string name) {
  int ok = 0;
  if(name == "print" || name == "eprint" || name == "len" || name == "pop" || name == "to_int" || name == "chr" || name == "put" || name == "sleep_ms" || name == "mem_of_str" || name == "alloc" || name == "fail" || name == "bits_of_float" || name == "float_of_bits" || name == "bits32_of_float" || name == "float_of_bits32" || is_peekfn(name) == 1) {
    ok = 1;
  }
} return int ok;
("print"):(1)
("push"):(0)
("fail"):(1)
("bits32_of_float"):(1)
