// What argument `i` of a builtin must be, as a word this file's neighbours
// turn into a test and a message. "" means "anything".
//
//   string   exactly a string          list     any T[]
//   int      exactly an int            strlist  a string or any T[]
//   index    an int, worded as an index (character_code_at's second argument)
//   word     an int or a word          addr     the same, worded as an address
//   float    exactly a float           uword    exactly a word (an int is refused)

bi_wants(string name, int i) {
  string s = bi_wants_bytes(name, i, bi_wants2(name, i));
  if(name == "to_int" || name == "mem_of_str" || name == "fail" || (name == "character_code_at" || name == "str_sub") && i == 0) {
    s = "string";
  }
  if(name == "uword_of_int") {
    s = "int";
  }
} chain (string name, int i) {
  if(name == "umul_hi") {
    s = "uword";
  }
} return string s;
("umul_hi", 1):("uword")
("uword_of_int", 0):("int")
("rotl", 1):("word")
("to_int", 0):("string")
("push", 0):("list")
("fail", 0):("string")
("str_sub", 0):("string")
("bytes_append", 1):("bytes")
("bytes_of_string", 0):("string")

// character_code_at's first argument was taken above, so what reaches here is its
// second: the index, which idc.py words as an index rather than as a type.
bi_wants2(string name, int i) {
  string s = bi_wants3(name, i);
  if(name == "chr" || name == "sleep_ms" || name == "str_sub") {
    s = "int";
  } else if(name == "character_code_at") {
    s = "index";
  }
} chain (string name, int i) {
  if(name == "bits_of_float" || name == "bits32_of_float") {
    s = "float";
  }
} return string s;
("chr", 0):("int")
("character_code_at", 1):("index")
("bits32_of_float", 0):("float")
("str_sub", 2):("int")

bi_wants3(string name, int i) {
  string s = bi_wants4(name);
  if(name == "pop" || name == "push" && i == 0) {
    s = "list";
  }
} return string s;
("pop", 0):("list")
("push", 1):("")
