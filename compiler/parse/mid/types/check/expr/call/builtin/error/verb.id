// "a int" would be wrong and "a string or list" is not a type name, so the
// two that do not fit "expects a <want>" are listed.
bi_verb(string want) {
  string s = "expects a " + want;
  if(want == "int") {
    s = "expects an int";
  } else if(want == "strlist") {
    s = "expects a string or list";
  }
} return string s;
("list"):("expects a list")
("int"):("expects an int")

bi_flush_setup() {
  call2_setup();
  int[] none = [];
  export int bi_flush_call = node_call("flush", none);
} return void;
():() then check_failed:(0)
():() then init_units:(0)
