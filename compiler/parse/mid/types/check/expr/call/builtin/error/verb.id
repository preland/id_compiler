bi_verb(string want) {
  string s = "expects a " + want;
  if(want == "int") {
    s = "expects an int";
  } else if(want == "strlist") {
    s = "expects a string or list";
  }
} return string s;
("list"):("expects a list")
("int"):("expects an int")

