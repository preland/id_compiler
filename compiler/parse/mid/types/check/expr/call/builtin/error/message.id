bi_arg_err(int id, int i, string want, string t) {
  if(want == "index") {
    tc_diag(id, "E0636", "character_code_at index must be int, got " + t, "character_code_at", "a position in a string is a whole number", "pass an int index, as in character_code_at(s, 0)");
  } else {
    bi_arg_err2(id, i, want, t);
  }
} return void;
