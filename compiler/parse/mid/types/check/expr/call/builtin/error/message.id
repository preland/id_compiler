// str_of_mem names neither the position nor the type: both of its arguments
// are addresses-or-lengths, and idc.py says so once.
bi_arg_err2(int id, int i, string want, string t) {
  if(want == "addr") {
    tc_diag(id, "E0637", "str_of_mem takes an address and a length, both int: argument " + i + " is " + t, "str_of_mem", "an address and a length are whole numbers, and a string or a list is neither", "pass the address and the length as ints, as in str_of_mem(address, 5)");
  } else {
    bi_arg_err3(id, i, want, t);
  }
} return void;
