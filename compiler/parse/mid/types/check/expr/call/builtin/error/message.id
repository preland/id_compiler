// The flat-store group is the only family that reports at the *argument's*
// line rather than the call's -- idc.py raises it from inside the loop over
// the arguments, and its calls are the ones most likely to be written across
// several lines.
bi_arg_err3(int id, int i, string want, string t) {
  if(want == "word") {
    int[] l1_of_v = (import nl1)[id];
    string s1_of_v = (import ns1)[id];
    tc_diag(l1_of_v[i], "E0638", s1_of_v + " expects int or word arguments, got " + t, s1_of_v, "it works on whole numbers and unsigned words, and argument " + i + " is " + t, "pass an int or word for argument " + i + ", converting it first if it is text or a float");
  } else {
    string s1_of_v2 = (import ns1)[id];
    string bi_verb_v = bi_verb(want);
    tc_err(id, s1_of_v2 + " " + bi_verb_v + ", got " + t);
  }
} return void;
