// node that is not a call at all (cm_var_node, for is_mut_call's own k_of
// gate), and a `push` on a local, unregistered name rather than
// `(import NAME)` (cm_push_local_call, for chk_const_mut2's "not import"
// gate and chk_const_mut3's "not a registered constant" one).

cm_call_var(string name) {
  int argn = node_var(name);
  int valn = node_int("9", 9, 0);
  int d = node_call("push", [argn, valn]);
} return int d;
