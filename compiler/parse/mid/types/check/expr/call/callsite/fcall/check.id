// Calling through a variable of function type: the questions a call to a
// defined function answers (../site.id) -- arity first, then each argument
// against its parameter -- asked of the parameter types the variable's type
// spells, since there is no function node to read them from. Every message
// names that type: the function that runs is not visible at the call, and the
// type is the only signature the reader of the call has.

chk_fcall(int id) {
  string vt = callee_var_type(id);
  if(ty_is_func(vt) == 1) {
    fcall_arity(id, vt);
  }
} return void;
given h_call_match ((import h_call_1)):() then calls fcall_arity:((import h_call_1), "func(int) return int")
given call2_setup ((import cm_push_call)):() then check_failed:(0)

fcall_arity(int id, string vt) {
  string[] pts = fn_params(vt);
  if(len(pts) != flat_arg_count(id)) {
    fcall_arity_err(id, vt, pts);
  } else {
    fcall_args(id, vt, pts);
  }
} return void;
given h_call_match ((import h_call_1), "func(int) return int"):() then calls fcall_args:((import h_call_1), "func(int) return int", ["int"])
given h_call_mismatch ((import h_call_0), "func(int) return int"):() then calls fcall_arity_err:((import h_call_0), "func(int) return int", ["int"])

fcall_args(int id, string vt, string[] pts) {
  int i = 0;
  while(i < len(pts)) {
    fcall_arg_at(id, vt, pts, i);
    i = i + 1;
  }
} return void;
given h_call_match ((import h_call_1), "func(int) return int", ["int"]):() then calls fcall_arg_at:[1]
given h_call_mismatch ((import h_call_0), "func() return int", []):() then calls fcall_arg_at:[0]
