// A `push` call on `(import NAME)`, built the same way for every positive
// scenario in this directory's cases: cm_setup registers a list constant,
// cm_scalar_setup a scalar one, both calling cm_call to build the call node
// that reads it. setup.id's cm_other_setup covers the two negatives.

cm_call(string kind, string name) {
  int argn = node_txt(kind, name);
  int valn = node_txt2("int", "9", 9, 0);
  int d = node_call("push", [argn, valn]);
} return int d;
given cm_setup ("import", "clist"):(8)
given cm_scalar_setup ("import", "cscalar"):(7)
given cm_other_setup ("var", "locallist"):(6)
given cm_other_setup ("var", "other"):(6)

cm_setup() {
  lc_env();
  lc_reg_list1("clist", "1", 1);
  export int cm_push_call = cm_call("import", "clist");
} return void;
():() then (import chkfail)[0]:(0)
():() then init_units:(0)

cm_scalar_setup() {
  lc_env();
  lc_reg_int("cscalar", "2", 2);
  export int cm_push_scalar_call = cm_call("import", "cscalar");
} return void;
