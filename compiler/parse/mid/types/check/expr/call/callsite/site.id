// The func node behind a called name, or -1 when there is none to check
// against: a builtin, or an asm function (its parameters live in the asm
// tables, and idc.py does not check a call to one either). A `native`
// declaration is a func node like any other, so a call to one is checked.
func_node(string name) {
  int n = 0 - 1;
  int idx = find_str((import fnames), name);
  if(idx >= 0) {
    n = (import fnodes)[idx];
  }
} return int n;
given argfn_d ("g"):((import argfn_fn))
given neg1_setup ("push"):((import neg1))

// A call to a function this program defines is checked against its node
// (arity/); any other call may be through a variable of function type, which
// fcall/ checks when it is one.
chk_site_at(int id, int fn) {
  if(fn >= 0) {
    chk_arity(id, fn);
  } else {
    chk_fcall(id);
  }
} return void;
