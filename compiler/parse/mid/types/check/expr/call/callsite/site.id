// Calling a function this program defines: the right number of arguments, of
// the right types, and the right thing returned.
//
// These are the checks that need more of the callee than its return type --
// they need its parameter list -- which is why the symbol table carries a
// node id per function. Everything else in mid/ has only ever had to answer
// "what does this evaluate to"; this family answers "may it be written that
// way", and that is the difference between a diagnostic here and an
// undeclared-function error from `cc` about generated code.

chk_callsite(int id) {
  string s1_of_v = s1_of(id);
  int fn = func_node(s1_of_v);
  chk_site_at(id, fn);
} return void;

// The func node behind a called name, or -1 when there is none to check
// against: a builtin, or an asm function (its parameters live in the asm
// tables, and idc.py does not check a call to one either). A `native`
// declaration is a func node like any other, so a call to one is checked.
func_node(string name) {
  int n = 0 - 1;
  int idx = find_str((import fnames), name);
  if(idx >= 0) {
    n = (import fnodes)[idx];
  }
} return int n;

// A call to a function this program defines is checked against its node
// (arity/); any other call may be through a variable of function type, which
// fcall/ checks when it is one.
chk_site_at(int id, int fn) {
  if(fn >= 0) {
    chk_arity(id, fn);
  } else {
    chk_fcall(id);
  }
} return void;
