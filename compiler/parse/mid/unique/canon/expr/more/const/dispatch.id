// Entry point for canon_bin's constant-based simplification.
//
// bin_simplify looks only at the two operand ids -- no canonicalising yet --
// and asks bin_const to try a fold (./fold) and then an identity rewrite
// (./ident). bin_fallback is what canon_bin calls next: "" means neither
// applied, so it falls back to the plain "op(left,right)" form, which is the
// only place either operand is canonicalised when a simplification did not
// fire.

bin_simplify(int id, string op) {
  int lid = i1_of(id);
  int rid = i2_of(id);
  string ret_s = bin_const(op, lid, rid);
} return string ret_s;

bin_const(string op, int lid, int rid) {
  string ret_s = bin_fold(op, lid, rid);
  if(ret_s == "") {
    ret_s = bin_identity(op, lid, rid);
  }
} return string ret_s;

bin_fallback(int id, string op, string simple_s) {
  string ret_s = simple_s;
  if(simple_s == "") {
    string pair_v = bin_pair(id);
    ret_s = "b" + op + pair_v;
  }
} return string ret_s;
