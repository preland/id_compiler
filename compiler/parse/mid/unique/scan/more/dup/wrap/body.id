// Which functions can be constant wrappers, and the state one walk keeps.

// Only a scalar result can be a constant. main is the entry point whatever it
// returns, and a native declaration has no body. A list is left alone on
// purpose: a list literal builds a fresh list on every call, so each caller
// owns what it got, and one shared conf.id global could not behave that way.
cw_shape(int id) {
  string rt = s2_of(id);
  int ok = rt == "int" || rt == "word" || rt == "float" || rt == "string";
  if(is_native(id) == 1 || s1_of(id) == "main") {
    ok = 0;
  }
} return int ok;

cw_body(int id) {
  string s1_of_v = s1_of(id);
  cw_begin(s1_of_v);
  string val = cw_walk(id);
} return string val;

// Start the walk of function `name`: canon_expr's position map is emptied as
// for a fingerprint (uq_begin), and the locals seen so far are forgotten.
//
//   cw_names  each local declared or assigned, in body order
//   cw_vals   the fingerprint of the value it was given there
cw_begin(string name) {
  uq_begin(name);
  export string[] cw_names = [];
  export string[] cw_vals = [];
} return void;
