// A statement's value, for the constant-wrapper walk (../../dup/wrap/): a
// scalar literal fingerprints as before (canon_expr); a list literal of
// nothing but literal elements fingerprints as its own spelling, tagged 'A'
// so cw_is_lit (dup/wrap/more/result/lit.id) recognises it the same way it
// recognises 'I'/'F'/'S' -- everything else, a list built from anything that
// is not a literal included, keeps canon_expr's 'ar(...)' shape, which no tag
// matches, so the walk correctly treats it as an effect and stops there.

cw_value_of(int e) {
  string val = canon_expr(e);
  if(k_of(e) == "arr" && cw_arr_lit(e) == 1) {
    val = "A" + cw_arr_spell(e);
  }
} return string val;
given cwv_setup ((import cwv_arr)):("A[1, \"hi\"]")
given ret_widens_fn ((import widen_f)):("?func#1")
