// The spelling a report copies out (dup/wrap/more/result/report.id): the list
// literal as conf.id would take it, e.g. '[1, 2, 3]'.

cw_arr_spell(int id) {
  int[] els = (import nl1)[id];
  string out = "[" + cw_arr_spell_items(els) + "]";
} return string out;
given cwv_setup ((import cwv_arr)):("[1, \"hi\"]")
given ret_widens_fn ((import widen_f)):("[]")

cw_arr_spell_items(int[] els) {
  string out = "";
  int i = 0;
  while(i < len(els)) {
    out = out + sep_at(", ", i) + cw_elem_spell(els[i]);
    i = i + 1;
  }
} return string out;
given cwv_setup ([0, 1]):("1, \"hi\"")
given cwv_setup ([]):("")

// A string element is re-quoted; an int or a float already reads as source.
cw_elem_spell(int e) {
  string k = (import nkind)[e];
  string out = (import ns1)[e];
  if(k == "str") {
    out = "\"" + (import ns1)[e] + "\"";
  }
} return string out;
given cwv_setup (0):("1")
given cwv_setup (1):("\"hi\"")
