// resv_names: resv_names is deliberately left uncased, because a regression here is
// caught louder downstream. --list-untested still reports it, and will keep
// reporting it: that tool counts cases, and nothing in it records a decision
// not to write them. The disagreement is expected, not a drift to repair.
// A reserved word let through as an identifier, or
// one rejected that was fine, fails immediately in the checks that read this
// table. A reader would be a second witness to something already unmissable.
init_resv_names() {
  export string[] resv_names = [];
  int i = 0;
  while(i < len((import resv_names_src))) {
    i = take_name((import resv_names_src), i, (import resv_names));
  }
} return void;
