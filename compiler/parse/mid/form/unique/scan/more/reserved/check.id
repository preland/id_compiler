// eprint is named on its own because (import resv_names) is idc.py's list,
// and idc.py has no eprint: its helper, id_eprint, is emitted beside the
// prelude rather than in it (back/tgt/c/emit/prog/head/decl/eprint.id).

is_reserved_name(int i) {
  string s1_of_v = s1_of((import prog)[i]);
  int ok = find_str((import resv_names), s1_of_v) >= 0 || s1_of_v == "eprint";
} return int ok;
