// Reading a value back out of its fingerprint.

// canon_expr tags a literal with one letter -- I an integer, F a float, S a
// string -- and no other fingerprint starts with any of the three. cw_value_of
// (../../../reserved/arrlit/value.id) tags a list of nothing but literals with
// a fourth, 'A', that canon_expr itself never produces. 73, 70, 83 and 65 are
// those letters.
cw_is_lit(string fp) {
  int tag = charat(fp, 0);
  int ok = tag == 73 || tag == 70 || tag == 83 || tag == 65;
} return int ok;
("A[1, 2]"):(1)
("ar(I1)"):(0)

// The value as conf.id spells it: the fingerprint after its tag (zeros_tail is
// the tail of a string from an index). A negative integer is always the fold
// of a subtraction, and `-1` would be the unary operator, which the fold does
// not reduce, so it is spelled as the subtraction that does. 45 is '-'.
cw_spell(string val) {
  string lit = zeros_tail(val, 1);
  if(charat(lit, 0) == 45) {
    string mag = zeros_tail(lit, 1);
    lit = "0 - " + mag;
  }
} return string lit;
