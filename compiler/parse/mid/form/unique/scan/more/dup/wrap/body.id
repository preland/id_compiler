// Which functions can be constant wrappers, and the state one walk keeps.

// A scalar result, or a list one: a conf.id constant can be either now
// (docs/PROJECT.md 5), so a function whose whole job is to build and return
// one is the same complaint as a function that only returns a scalar. main is
// the entry point whatever it returns, and a native declaration has no body.
cw_shape(int id) {
  string rt = (import ns2)[id];
  int ok = rt == "int" || rt == "word" || rt == "float" || rt == "string" || rt == "int[]" || rt == "word[]" || rt == "float[]" || rt == "string[]";
  if(is_native(id) == 1 || (import ns1)[id] == "main") {
    ok = 0;
  }
} return int ok;
given cwv_setup ((import cwv_func)):(1)
given ret_widens_fn ((import widen_f)):(1)

cw_body(int id) {
  string s1_of_v = (import ns1)[id];
  cw_begin(s1_of_v);
  int[] l2_of_v = (import nl2)[id];
} chain (int id) {
  string val = "";
  if(cw_stmts(l2_of_v) == 1) {
    val = cw_ret(id);
  }
} return string val;
given cwv_setup ((import cwv_func)):("A[1, \"hi\"]")
given ret_widens_fn ((import widen_f)):("I5")

// Start the walk of function `name`: canon_expr's position map is emptied as
// for a fingerprint (uq_begin), and the locals seen so far are forgotten.
//
//   cw_names  each local declared or assigned, in body order
//   cw_vals   the fingerprint of the value it was given there
cw_begin(string name) {
  uq_begin(name);
  export string[] cw_names = [];
  export string[] cw_vals = [];
} return void;
("foo"):() then (import cself)[0]:("foo")
("bar"):() then (import cself)[0]:("bar")
