// The other "no two functions may be the same" rule: two functions may not
// share a NAME. It sits with the logic-uniqueness scan because they are the
// same rule at two strengths, and because getting this one wrong makes that
// one lie -- two functions called `f` with identical bodies are reported by
// the logic check as duplicates of each other, naming `f` as a duplicate of
// `f` at its own line, which explains nothing.
//
// idc.py raises this while building its function table, before any other
// check runs; here it runs first among the body checks, which is the same
// place in the order.

chk_dupfn() {
  int i = 0;
  while(i < len((import prog))) {
    dupfn_at(i);
    i = i + 1;
  }
} return void;
given dup_prog_fixture("dupe", "dupe", 1, 5) ():() then calls dupfn_err:(1, 0)
given dup_prog_fixture("twin", "twin", 2, 7) ():() then prints:("b.id:7: error: function 'twin' already defined at a.id:2 [E0401]\n  at: twin\n  why: a function is called by its name alone, so a name can mean only one function\n  help: rename this function so each name is its own; if the two do the same thing, keep one and call it from both places\n  related: a.id:2: note: the first definition of 'twin'\n")
given clean_prog_fixture ():() then calls dupfn_err:[0]

// Reported against every definition after the first, so three functions of
// one name draw two diagnostics rather than one -- the checker reports every
// violation, and each later definition is one.
// The reserved-name check rides this walk rather than opening its own: it is
// the same question asked of the same name -- is this name already taken --
// and a second pass over `prog` to ask it would be a function whose only job
// is to call resv_at. That call was resv_at's only caller and its last
// action, so its one action (../reserved/runtime.id) is inlined directly
// above rather than kept as a separate function.
dupfn_at(int i) {
  string s1_of_v = (import ns1)[((import prog)[i])];
  int j = first_fn(s1_of_v);
  if((import rtc)[0] == 0 && is_reserved_name(i)) {
    resv_err(i);
  }
} chain (int i) {
  if(j < i && i < len((import pfile))) {
    dupfn_err(i, j);
  }
  if(string_starts_with(s1_of_v, "idsq_") == 1) {
    string prog_loc_v = prog_loc(i);
    var_report(prog_loc_v + "names beginning 'idsq_' are reserved for the C target's temporaries; rename '" + s1_of_v + "'");
  }
} return void;
given dup_prog_fixture("dupe", "dupe", 1, 5) (1):() then calls dupfn_err:(1, 0)
given dup_prog_fixture("twin", "twin", 2, 7) (1):() then prints:("b.id:7: error: function 'twin' already defined at a.id:2 [E0401]\n  at: twin\n  why: a function is called by its name alone, so a name can mean only one function\n  help: rename this function so each name is its own; if the two do the same thing, keep one and call it from both places\n  related: a.id:2: note: the first definition of 'twin'\n")
given dup_prog_fixture("dupe", "dupe", 1, 5) (0):() then calls dupfn_err:[0]

dupfn_err(int i, int j) {
  string dupfn_where = diag_prog_loc(i);
  string dupfn_first = diag_prog_loc(j);
  string dupfn_name = (import ns1)[((import prog)[i])];
} chain (int i, int j) {
  diag("E0401", dupfn_where, "function '" + dupfn_name + "' already defined at " + dupfn_first, dupfn_name, "a function is called by its name alone, so a name can mean only one function", "rename this function so each name is its own; if the two do the same thing, keep one and call it from both places");
  diag_related(dupfn_first, "the first definition of '" + dupfn_name + "'");
} return void;
given dup_prog_fixture("dupe", "dupe", 1, 5) {
  (0, 1):() then prints:("a.id:1: error: function 'dupe' already defined at b.id:5 [E0401]\n  at: dupe\n  why: a function is called by its name alone, so a name can mean only one function\n  help: rename this function so each name is its own; if the two do the same thing, keep one and call it from both places\n  related: b.id:5: note: the first definition of 'dupe'\n")
  (1, 0):() then prints:("b.id:5: error: function 'dupe' already defined at a.id:1 [E0401]\n  at: dupe\n  why: a function is called by its name alone, so a name can mean only one function\n  help: rename this function so each name is its own; if the two do the same thing, keep one and call it from both places\n  related: a.id:1: note: the first definition of 'dupe'\n")
}
