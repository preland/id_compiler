// The result: what the return clause names. The parser allows only a literal
// or a name there, so a literal is its own value and a name is looked up among
// the locals walked -- a parameter's name is not among them, and answers "".

cw_ret(int id) {
  int i1_of_v = (import ni1)[id];
  string val = cw_value_of(i1_of_v);
  if((import nkind)[i1_of_v] == "var") {
    string s1_of_v = (import ns1)[i1_of_v];
    val = cw_get(s1_of_v);
  }
} return string val;
given cwv_setup ((import cwv_func)):("A[1, \"hi\"]")
given ret_widens_fn ((import widen_f)):("I5")

cw_get(string name) {
  string val = "";
  int i = 0;
  while(i < len((import cw_names))) {
    val = cw_pick(i, name, val);
    i = i + 1;
  }
} return string val;
given cw_named_fixture ("x"):("I3")
given cw_named_fixture ("q"):("")

cw_pick(int i, string name, string val) {
  if((import cw_names)[i] == name) {
    val = (import cw_vals)[i];
  }
} return string val;
given cw_named_fixture (0, "x", ""):("I3")
given cw_named_fixture (0, "q", "prev"):("prev")
