// The body, statement by statement. Every one must give one of the
// function's own locals a literal value; a call, an export, a loop, a branch or
// a write through an index is an effect or a dependency, and ends the walk.
// The walk itself is the chain cw_body (../body.id) runs once its own block
// is full.

// The loop leaves at the first statement that is not a literal store: the flag
// in the condition is how a loop leaves early here.
cw_stmts(int[] stmts) {
  int ok = 1;
  int i = 0;
  while(i < len(stmts) && ok == 1) {
    ok = cw_stmt(stmts[i]);
    i = i + 1;
  }
} return int ok;
given cw_decl_fixture ((import cw_decl_list)):(1)
given cw_decl_fixture ((import cw_func_list)):(0)

cw_stmt(int id) {
  int ok = 0;
  if((import nkind)[id] == "decl" && (import ni2)[id] != 1) {
    string s2_of_v = (import ns2)[id];
    ok = cw_put(id, s2_of_v);
  }
  if((import nkind)[id] == "assign") {
    ok = cw_assign(id);
  }
} return int ok;
given cw_decl_fixture ((import cw_decl_x)):(1)
given cw_decl_fixture ((import cwv_func)):(0)

// "x = 4" once "x" is declared, and "y = 5" while it is not -- for
// ../val.id's cw_assign.
cw_assign_fixture() {
  cw_named_fixture();
  int e2 = node_int("4", 4, 0);
  export int cw_assign_x = node_assign("x", e2);
} chain () {
  int e3 = node_int("5", 5, 0);
  export int cw_assign_y = node_assign("y", e3);
} return void;
