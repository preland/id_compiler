// The diagnostic, at the function's own line, naming the value and the
// declaration that replaces the function -- so the fix can be copied out of it.

cw_report(int id, string val) {
  note_failure();
  string lit = cw_spell(val);
  string name = (import ns1)[id];
} chain (int id, string val) {
  string rt = (import ns2)[id];
  cw_say(name, rt, lit);
} return void;
given ret_widens_fn ((import widen_f), "I5"):() then prints:("<stdin>:1: error: 'f' only returns the constant 5; declare it in conf.id as 'word f = 5;' and read it with (import f)\n")
given cwv_setup ((import cwv_func), "A[1, \"hi\"]"):() then prints:("<stdin>:1: error: 'f' only returns the constant [1, \"hi\"]; declare it in conf.id as 'int[] f = [1, \"hi\"];' and read it with (import f)\n")

cw_say(string name, string rt, string lit) {
  string loc_at_v = dup_loc(name);
  print(loc_at_v + "'" + name + "' only returns the constant " + lit + "; declare it in conf.id as '" + rt + " " + name + " = " + lit + ";' and read it with (import " + name + ")");
} return void;
given env_init ("f", "int", "5"):() then prints:("<stdin>:1: error: 'f' only returns the constant 5; declare it in conf.id as 'int f = 5;' and read it with (import f)\n")
given env_init ("g", "void", "0"):() then prints:("<stdin>:1: error: 'g' only returns the constant 0; declare it in conf.id as 'void g = 0;' and read it with (import g)\n")
