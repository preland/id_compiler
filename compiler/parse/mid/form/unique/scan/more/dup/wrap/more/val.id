// Appended rather than overwritten, so an assignment needs no search to write;
// the latest entry for a name is its value (cw_get).
cw_put(int id, string name) {
  int i1_of_v = (import ni1)[id];
  string val = cw_value_of(i1_of_v);
  push((import cw_names), name);
} chain (int id, string name) {
  push((import cw_vals), val);
  int ok = cw_is_lit(val);
} return int ok;
