// env_init() plus init_rtc() (rtc/fsc/bnames/resv_names -- dupfn_at reads
// (import rtc)[0], which needs rtc, as well as resv_names), shared by this
// file's two fixtures and by ../../reserved/check.id's resv_scan_fixture --
// so the calling segment, not the setup itself, is what the per-segment
// fingerprint sees.
resv_env_setup() {
  env_init();
  init_rtc();
} return void;
():() then len((import tyname)):(6)
():() then (import rtc)[0]:(0)
():() then calls env_init:[1]
():() then init_units:(0)

// Two functions registered in `prog`/`pfile`/`pline` the way a real duplicate
// declaration would be (front/parse/decl/top/decl/decl_top.id), for dup_name.id's
// own cases, for ../../pass/check.id's check_bodies and for ../../reserved/
// check.id's: two named "dupe" at a.id:1 and b.id:5 (dup_prog_fixture("dupe",
// "dupe", 1, 5)), or "eprint" at a.id:3 and an ordinary name at b.id:9
// (dup_prog_fixture("eprint", "plain_name", 3, 9)) for resv_err's. Built
// directly through node_func/push rather than parsed, since a program with a
// real duplicate name is a compile error before this pass would ever see it.
dup_prog_fixture(string dpf_n1, string dpf_n2, int dpf_l1, int dpf_l2) {
  resv_env_setup();
  int[] none = [];
  int dnf1 = node_func(dpf_n1, "void", none, none, 0 - 1);
} chain (string dpf_n1, string dpf_n2, int dpf_l1, int dpf_l2) {
  push((import prog), dnf1);
  push((import pfile), "a.id");
  push((import pline), dpf_l1);
} chain (string dpf_n1, string dpf_n2, int dpf_l1, int dpf_l2) {
  int dnf2 = node_func(dpf_n2, "void", none, none, 0 - 1);
  push((import prog), dnf2);
  push((import pfile), "b.id");
} chain (string dpf_n1, string dpf_n2, int dpf_l1, int dpf_l2) {
  push((import pline), dpf_l2);
} return void;
("dupe", "dupe", 1, 5):() then len((import prog)):(2)
("eprint", "plain_name", 3, 9):() then (import pline)[1]:(9)
("dupe", "dupe", 1, 5):() then calls resv_env_setup:[1]
("eprint", "plain_name", 3, 9):() then init_units:(0)

// A `prog` with no duplicate names, no reserved-name collisions and no
// constant wrappers -- check_bodies' quiet path. Each function returns a
// call's result rather than a literal, so cw_value_of's fingerprint is
// tagged 'c', not one of 'I'/'F'/'S'/'A', and neither is mistaken for a
// wrapper.
clean_prog_fixture() {
  resv_env_setup();
  int[] none = [];
  int cpca = node_call("cpc_a", none);
} chain () {
  int cpf1 = node_func("alpha", "int", none, none, cpca);
  push((import prog), cpf1);
  push((import pfile), "a.id");
} chain () {
  push((import pline), 1);
  int cpcb = node_call("cpc_b", none);
  int cpf2 = node_func("beta", "string", none, none, cpcb);
} chain () {
  push((import prog), cpf2);
  push((import pfile), "b.id");
  push((import pline), 5);
} return void;
():() then len((import prog)):(2)
():() then (import pfile)[1]:("b.id")
():() then calls resv_env_setup:[1]
():() then init_units:(0)
