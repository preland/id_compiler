// The i-side of report_dup's message: the location the diagnostic points at.
// Split out so that block stays within the action limit -- fname_at(i) was
// read three times over in the original and nothing between the reads could
// change it, so it is read once, in report_dup's own chain, and passed
// through.

dup_loc(string name_i) {
  int func_line_v = func_line(name_i);
  string loc_at_v = loc_at(name_i, func_line_v);
} return string loc_at_v;
