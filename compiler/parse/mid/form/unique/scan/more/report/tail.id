// The j-side of report_dup's message: where the earlier, colliding function
// was defined. Also read three times over in the original for no reason, so
// fname_at(j) is read once and passed through. What to do about it is the
// diagnostic's help line, not part of this.

dup_tail(int j) {
  string name_j = fname_at(j);
  string func_file_v = func_file(name_j);
  int func_line_v2 = func_line(name_j);
} chain (int j) {
  string ret_s = "'" + name_j + "' (defined at " + func_file_v + ":" + func_line_v2 + ")";
} return string ret_s;
given lz_o (0):("'dup5' (defined at <stdin>:1)")
given lz_o (1):("'dup9' (defined at <stdin>:1)")

// The same place as `FILE:LINE`, for the diagnostic's related line.
dup_loc_of(int j) {
  string name_j = fname_at(j);
  int line_j = func_line(name_j);
  string loc_j = diag_fn_loc(name_j, line_j);
} return string loc_j;
given lz_o (0):("<stdin>:1")
given lz_o (1):("<stdin>:1")
