// Fixtures for this directory's own cases (uq_fill, find_dup) and for
// blank_push (../../canon/stmt/more/seam.id): every directory near seam.id
// is at the 3-entry cap, and this one had a function's worth of room left
// once cfp_len and dup_pair_fixture existed.

// len((import cfp)) has no other zero-argument reader; uq_fill's own effect
// is exactly that this count changes to match the current `prog`.
cfp_len() {
  int n = len((import cfp));
} return int n;
given lz_o ():(2)
given farm_k ():(3)

// Two functions, no params, whose bodies are nothing but a literal return
// -- so their strict fingerprints collide and find_dup(1) must name 0.
// Built directly through node_func/newnode rather than parsed, since a
// program with two duplicate functions is otherwise a compile error before
// this pass ever runs.
dup_pair_fixture() {
  env_init();
  int[] dpf_none = [];
  int dpf_e1 = node_int("5", 5, 0);
} chain () {
  int dpf_f1 = node_func("pa", "int", dpf_none, dpf_none, dpf_e1);
  push((import prog), dpf_f1);
  int dpf_e2 = node_int("5", 5, 0);
} chain () {
  int dpf_f2 = node_func("pb", "int", dpf_none, dpf_none, dpf_e2);
  push((import prog), dpf_f2);
  uq_fill();
} return void;
():() then check_failed:(0)
():() then init_units:(0)

// A "blank" leaf and a literal, in a fresh tree so the pushed value can be
// named without guessing a node id.
blank_push_fixture() {
  env_init();
  export int bp_blank = newleaf("blank", 0, 0, "", "");
  export int bp_lit = node_int("3", 3, 0);
} chain () {
  export int[] bp_kept_after = [bp_lit];
} return void;
():() then check_failed:(0)
():() then init_units:(0)
