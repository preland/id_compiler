ul_find(int i) {
  int ul_j = 0;
  int ul_found = 0 - 1;
  while(ul_j < i && ul_found < 0) {
    ul_found = ul_probe(i, ul_j);
    ul_j = ul_j + 1;
  }
} return int ul_found;
