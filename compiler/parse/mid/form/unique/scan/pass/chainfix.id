// Chain functions for this directory's duplicate cases (find_dup, uq_scan):
// whole-function comparison means two chain functions collide only when every
// segment matches, not when their last segments happen to.

// One function, no parameters: `int NAMEa = VAL;` then a seam of kind KIND
// then `int NAMEb = 1;`, returning 1. Kind "chain" makes it a chain function;
// kind "blank" is erased from the fingerprint, which makes it the plain
// function with the same two statements.
chain_fn_make(string cfm_name, int cfm_val, string cfm_kind) {
  int cfm_lit = node_txt2("int", "" + cfm_val, cfm_val, 0);
  int cfm_one = node_txt2("int", "1", 1, 0);
  int cfm_d1 = node_decl("int", cfm_name + "a", cfm_lit, 0);
} chain (string cfm_name, int cfm_val, string cfm_kind) {
  int cfm_d2 = node_decl("int", cfm_name + "b", cfm_one, 0);
  int cfm_mark = newleaf(cfm_kind, 0 - 1, 0, "", "");
  int[] cfm_body = [cfm_d1, cfm_mark, cfm_d2];
} chain (string cfm_name, int cfm_val, string cfm_kind) {
  int[] cfm_none = [];
  int cfm_fn = node_func(cfm_name, "int", cfm_none, cfm_body, cfm_one);
  push((import prog), cfm_fn);
} return void;
given env_init {
  ("ca", 1, "chain"):() then len((import prog)):(1)
  ("cd", 2, "blank"):() then len((import prog)):(1)
}

// prog = [ca, cb, cc, cd]: ca and cb are the same chain function under
// different local names; cc differs from them in its first segment only; cd is
// the same two statements with no seam, a plain function.
chain_dup_fixture() {
  env_init();
  chain_fn_make("ca", 1, "chain");
  chain_fn_make("cb", 1, "chain");
} chain () {
  chain_fn_make("cc", 2, "chain");
  chain_fn_make("cd", 1, "blank");
  uq_fill();
} return void;
():() then len((import prog)):(4)
():() then len((import cfp)):(4)
():() then calls chain_fn_make:[4]
():() then init_units:(0)
