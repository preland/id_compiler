// Function-logic uniqueness: two functions with the same signature and the
// same logic are one function written twice, and that is a compile error.
//
// This is the rule that most shapes how id is written -- it is why a magic
// number gets one named accessor instead of being repeated, and why "just like
// X but for Y" has to become a parameter. It is also the rule with the most to
// lose from being wrong: rejecting a legal program stops real work, so the
// comparison is deliberately conservative. Anything two functions could
// possibly be distinguished by -- an operator, a literal, a called name, a
// type -- is kept in the fingerprint, and only the spelling of a function's
// own variables is thrown away.
//
// Everything here is decided from `prog` and the node tables, so it holds for
// every backend.

// What check_program() calls in place of check_funcs(): the per-function body
// walks (the action and nesting limits), then the whole-program comparison.
check_bodies() {
  check_funcs();
  chk_dupfn();
  uq_fill();
} chain () {
  uq_scan();
  int i = 0;
  while(i < len((import prog))) {
    cw_at(i);
    i = i + 1;
  }
} return void;
given dupfn_fixture ():() then (import chkfail)[0]:(1)
given clean_prog_fixture ():() then (import chkfail)[0]:(0)

// Fingerprint every function once. Comparing is quadratic in the number of
// functions but canonicalising is not, and canonicalising is the expensive
// half, so the two passes are kept apart.
//
// `cfpfn` records which function each fingerprint belongs to; the walk itself
// is ../fill.id, which explains why the owner is kept separately.
// cfp: len((import cfp)) has no other zero-argument reader; uq_fill's own effect
// is exactly that this count changes to match the current `prog`.
uq_fill() {
  export string[] cfp = [];
  export int[] cfpfn = [];
  uq_fill_all();
} return void;
given dupfn_fixture ():() then len((import cfp)):(2)
given fn_fixture ():() then len((import cfp)):(1)
