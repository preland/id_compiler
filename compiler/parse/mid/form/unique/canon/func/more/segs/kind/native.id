// Which shape of function is being fingerprinted.
//
// A `native` declaration has no body, so it has no segments and must keep the
// fingerprint canon_func gives it -- its signature and its *name*
// (../../parts/native.id). Building a signature-and-empty-body unit for it
// instead makes every native with the same signature identical, which is how
// this split first went wrong: twenty idstd natives (fs_read/fs_write,
// fs_size/fs_exists, the gfx and sock handles) were reported as duplicates of
// one another.

// A canonicalisation begun over lz_j's program rather than lz_g's.
// canon_begun_fixture stops at lz_g, which builds eleven nodes (0 to 10); the
// function nodes the strict canonicaliser is tested on are ids 11 and 15,
// created two links further along by lz_h and lz_j. Only canon_func calls
// uq_begin itself, so everything below it needs the map already filled.
canon_begun_j_fixture() {
  lz_j();
  uq_begin("f");
} return void;
():() then calls uq_begin:("f")
():() then calls node_txt:("var", "y")
():() then init_units:(0)

unit_kind(int id) {
  string unit_fp = "";
  if(is_native(id) == 1) {
    unit_fp = unit_native(id);
  } else {
    unit_fp = unit_plain(id);
  }
} return string unit_fp;
given lz_o (22):("|()->int=>v0{d:int 0=I5}")
given lz_o (23):("|()->int=>v0{d:int 0=I9}")

// One unit, from canon_func, which already dispatches a native to canon_native
// and resets the position map on the way. Delegating rather than repeating it
// is also what keeps canon_func reachable now that uq_fill_at no longer calls
// it directly.
unit_native(int id) {
  string fp = canon_func(id);
  string unit_fp = "|" + fp;
} return string unit_fp;
given lz_o (22):("|()->int{d:int 0=I5}=>v0")
given lz_o (23):("|()->int{d:int 0=I9}=>v0")
