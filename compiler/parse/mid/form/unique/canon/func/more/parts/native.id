// A `native` declaration has no logic to compare, so its fingerprint is its
// signature and its name -- the way an `asm` function is identified by name
// and triple. Two natives with one signature are two functions, not one
// written twice.
// canon_begun_fixture with one name already numbered, so cn and cn_add have a
// non-empty position map to answer against: from an empty one they both
// answer 0 whatever the name, which is no pair at all. Filed here because
// names.id, state.id and more/func.id are each at the three-function limit.
cn_seeded_fixture() {
  canon_begun_fixture();
  push((import cnames), "already");
} return void;
():() then check_failed:(0)
():() then init_units:(0)

canon_native(int id, string out) {
  string ret_s = "(" + out + ")->" + s2_of(id) + " native " + s1_of(id);
} return string ret_s;
given paramlist_begun_fixture ((import f_other), "int 0"):("(int 0)->int native other")
given paramlist_begun_fixture ((import f_other), ""):("()->int native other")

// farm_a's param node with a canonicalisation begun over it. farm_a runs
// fwd_env, so the symbol index is there too -- but it is a sibling of
// fwd_env's other users rather than a link in lz_g's chain, which is why
// canon_begun_fixture cannot reach f_pa.
param_begun_fixture() {
  farm_a();
  uq_begin("f");
} return void;
