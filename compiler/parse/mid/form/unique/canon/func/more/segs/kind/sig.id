// The first step of canonicalising a function, exactly as canon_func does it:
// uq_begin empties the position map and names the function whose calls count
// as recursion. It is done once per function, so a local declared in one
// segment keeps its number in the next: the segments are one function's scope,
// and the whole body is one fingerprint (../chain.id).
unit_sig(int id) {
  string nm = (import ns1)[id];
  uq_begin(nm);
  string ret_s = unit_sig2(id);
} return string ret_s;
given lz_o (22):("()->int=>v0")
given lz_o (23):("()->int=>v0")

// The signature half of a function's unit: the same parameters and return that
// canon_logic (../../parts/tail.id) puts around a whole body, without the body.
// Split from unit_sig so that it stays within the action limit once the
// position map is reset there.
unit_sig2(int id) {
  int[] params = (import nl1)[id];
  string sigparams = canon_params(params);
  string ret_s = "(" + sigparams + ")->" + (import ns2)[id] + "=>" + canon_ret(id);
} return string ret_s;
given lz_o (22):("()->int=>v0")
given lz_o (23):("()->int=>v0")
