// Entry point for canon_bin's constant-based simplification.
//
// bin_simplify looks only at the two operand ids -- no canonicalising yet --
// and tries a fold (./fold) and then an identity rewrite
// (./ident). canon_bin falls back on "" to the plain "op(left,right)" form,
// which is the only place either operand is canonicalised when a
// simplification did not fire.
//
// Both rewrites read a literal's value, so neither runs while the
// literal-insensitive table is made (cloose, ../lit.id): `x + 0` and `x + 1`
// must come out the same there, as the literals they differ in are all that
// separates them.

bin_simplify(int id, string op) {
  int lid = (import ni1)[id];
  int rid = (import ni2)[id];
  string ret_s = "";
} chain (int id, string op) {
  if((import nkind)[lid] == "int" && (import nkind)[rid] == "int" && (import cloose)[0] == 0) {
    ret_s = bin_fold2(op, lid, rid);
  }
  if(ret_s == "" && (import cloose)[0] == 0) {
    ret_s = bin_identity(op, lid, rid);
  }
} return string ret_s;
