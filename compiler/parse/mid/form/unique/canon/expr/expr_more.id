// The rest of the expression kinds. ce5 ends the chain, so its default is the
// empty string: every expression node the parser can build is handled above it
// or in it.

ce4(int id) {
  string out = ce5(id);
  if(k_of(id) == "un") {
    int i1_of_v = i1_of(id);
    out = "u" + s1_of(id) + "(" + canon_expr(i1_of_v) + ")";
  }
  if(k_of(id) == "index") {
    int i1_of_v2 = i1_of(id);
    int i2_of_v = i2_of(id);
    out = "ix" + canon_pair(i1_of_v2, i2_of_v);
  }
} return string out;
given un_fixture ((import neg_node)):("u-(I7)")
given lw_fix_arr ((import fix_arr_n)):("ar(I1)")

// The end of the chain. Its default is reached only by an expression kind
// nobody above recognised, which today cannot happen -- every kind the parser
// builds is handled. It still answers with something unrepeatable (the kind
// and the node's own id) rather than with the empty string, so that a kind
// added later and forgotten here makes functions look *more* different than
// they are. A missed duplicate is a gap; a duplicate reported against a legal
// program stops work.
ce5(int id) {
  string out = "?" + k_of(id) + "#" + id;
  if(k_of(id) == "call") {
    out = call_fp(id);
  }
  if(k_of(id) == "arr") {
    int[] l1_of_v2 = l1_of(id);
    out = "ar(" + canon_args(l1_of_v2) + ")";
  }
} return string out;
given lw_fix_arr ((import fix_arr_n)):("ar(I1)")
given lw_fix_arr_empty ((import fix_arr_empty_n)):("ar()")

// A callee keeps its name -- except a call to the function being canonicalised
// itself, which becomes a fixed marker so that two identical recursive
// functions, each recursing into its own name, still collide; and a call
// through a parameter or local of function type, which is that variable's
// position like any other use of it. The position map holds only the
// function's own variables, and no variable shares a function's name.
canon_callee(string name) {
  string out = name;
  if(name == cur_self()) {
    out = "self";
  }
  if(find_str((import cnames), name) >= 0) {
    out = "v" + cn(name);
  }
} return string out;
