// Canonicalising a statement, mirroring idc.py's _canon_stmt. Same eager
// chain as the expression side: two statement kinds per link.
//
// Each kind is tagged, so a statement can never canonicalise to the same
// string as a statement of another kind.

canon_stmt(int id) {
  string out = cst2(id);
  if(k_of(id) == "decl") {
    out = canon_decl(id);
  }
  if(k_of(id) == "assign") {
    string s1_of_v = s1_of(id);
    int i1_of_v = i1_of(id);
    out = "a:" + cn(s1_of_v) + "=" + canon_expr(i1_of_v);
  }
} return string out;
given canon_begun_fixture ((import lz_declid)):("d:int 0=I3")
given canon_begun_fixture ((import lz_assignid)):("a:0=I3")

cst2(int id) {
  string out = cst3(id);
  if(k_of(id) == "iassign") {
    out = canon_iassign(id);
  }
  if(k_of(id) == "exprstmt") {
    int i1_of_v = i1_of(id);
    out = "e:" + canon_expr(i1_of_v);
  }
} return string out;
given canon_begun_fixture ((import lz_exprstmt)):("e:c(foo:I3)")
given blank_stmts_fixture ((import chain_node)):("|")

// The two compound statements. An if carries its else arm (which may be
// nothing at all), and the two are told apart by their tag, so `if(c){}` and
// `wh(c){}` over the same body are never the same statement.
// The seam and the default sit one link further along, in more/seam.id.
cst3(int id) {
  string out = cst4(id);
  if(k_of(id) == "if") {
    out = cst_if(id);
  }
  if(k_of(id) == "while") {
    int i1_of_v2 = i1_of(id);
    int[] l1_of_v2 = l1_of(id);
    out = "wh(" + canon_expr(i1_of_v2) + "){" + canon_body(l1_of_v2) + "}";
  }
} return string out;
given blank_stmts_fixture ((import chain_node)):("|")
given blank_stmts_fixture ((import blank_node)):("")
