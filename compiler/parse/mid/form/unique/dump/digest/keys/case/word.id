given dg_t_claim (0):("-5465788173469261037")
given dg_t_built (99):("-")

// The row of the case's function, or -1 when the case has no token range
// (only a hand-built fixture's case is without one).
dg_case_fn(int dgc) {
  int dgf = 0 - 1;
  if(dgc < len((import caseend))) {
    dgf = dg_fn_named((import ns1)[((import casefn)[dgc])]);
  }
} return int dgf;
given dg_t_built (2):(1)
given dg_t_built (99):(-1)
given dg_t_claim (0):(0)

dg_fn_named(string dgnm) {
  int dgf = hash_map_get((import dg_fk), (import dg_fv), (import dg_fu), dgnm, 0 - 1);
} return int dgf;
