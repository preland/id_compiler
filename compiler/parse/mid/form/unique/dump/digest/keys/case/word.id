// One case's key, or "-" when the case has no token range (only a hand-built
// fixture's case lacks one; every real case, scaling claim and volatile
// native included, has a key: ../emit.id).

dg_case_word(int dgc) {
  int dgf = dg_case_fn(dgc);
  string dgs = "-";
  if(dgf >= 0) {
    dgs = dg_case_hash(dgc, dgf);
  }
} return string dgs;
