// One case's key, or "-" when it must run every build (../emit.id says which
// cases those are and why).

dg_case_word(int dgc) {
  int dgf = dg_case_fn(dgc);
  string dgs = "-";
  if(dgf >= 0) {
    dgs = dg_case_hash(dgc, dgf);
  }
} return string dgs;
