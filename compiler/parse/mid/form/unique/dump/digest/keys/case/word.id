given dg_t_claim (0):("-")

// The row of the case's function, or -1 when the case cannot have a key: it
// carries a scaling claim, or it was never given a token range (only a
// hand-built fixture's case is).
dg_case_fn(int dgc) {
  int dgf = 0 - 1;
  if(dgc < len((import caseend)) && lst_index_of((import conscase), dgc) < 0) {
    dgf = dg_fn_named(s1_of((import casefn)[dgc]));
  }
} return int dgf;
given dg_t_built (2):(1)
given dg_t_claim (0):(-1)

dg_fn_named(string dgnm) {
  int dgf = hmap_get((import dg_fk), (import dg_fv), (import dg_fu), dgnm, 0 - 1);
} return int dgf;
