given dg_t_scc (2):(5376189763659863551)

dg_case_toks(word[] dgacc, int dgfrom, int dgto) {
  while(dgfrom < dgto) {
    dg_case_tok(dgacc, dgfrom);
    dgfrom = dgfrom + 1;
  }
} return void;
