// A case's hash: its function's component, then each of its tokens. dgacc is
// [hash, dirt]; dirt is the classes of the components the case reaches folded
// together with `|` (../../graph/build/rows/nat.id). Every case is keyed. Bit 2
// -- the case reaches a native bin/idc watches (file-pure, or marked when it
// does anything else) -- adds " f" after the hash, which tells bin/idc to
// record the files the case reads beside the key. A case that reaches a native
// nothing can see into (the clock, a window) is keyed all the same: the weekly
// expiry in bin/idc is what runs it again.

dg_case_hash(int dgc, int dgf) {
  word[] dgacc = [0, 0];
  dgacc[0] = dg_mix(dg_deep_fn(dgf), 3);
  dgacc[1] = (import dg_dirty)[(import dg_comp)[dgf]];
} chain (int dgc, int dgf) {
  dg_case_toks(dgacc, (import casestart)[dgc], (import caseend)[dgc]);
  string dgs = "" + dgacc[0];
  if((dgacc[1] & 2) != 0) {
    dgs = dgs + " f";
  }
} return string dgs;
given dg_t_built (0, 0):("-5465788173469261037")
given dg_t_built (2, 1):("1118206258217500576")
given dg_t_nat (0, 0):("-5465788173469261037 f")
given dg_t_nat (2, 1):("-3492214503910558658 f")
given dg_t_natv (2, 1):("1118206258217500576")

dg_deep_fn(int dgf) {
  word dgd = (import dg_deep)[(import dg_comp)[dgf]];
} return word dgd;
given dg_t_scc {
  (0):(4863496796159887835)
  (2):(5376189763659863551)
}

dg_case_toks(word[] dgacc, int dgfrom, int dgto) {
  while(dgfrom < dgto) {
    dg_case_tok(dgacc, dgfrom);
    dgfrom = dgfrom + 1;
  }
} return void;
