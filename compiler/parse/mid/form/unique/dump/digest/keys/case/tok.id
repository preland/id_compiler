// The hash of the component sealed last, for dg_seal's own cases (../../scc/
// seal/hash.id, whose directory was at the since-dropped three-entry cap).
dg_deep_last() {
  int dgl = len((import dg_deep)) - 1;
  word dgd = (import dg_deep)[dgl];
} return word dgd;
