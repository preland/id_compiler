// One token of a case: its text, and -- when it names a function of the
// build -- that function's component, which is how a `given` setup, a `then`
// check, a `calls` target and a function passed as an argument all come to
// be part of the key without the case line being parsed a second time.

dg_case_tok(word[] dgacc, int dgt) {
  dgacc[0] = dg_tok1(dgacc[0], dgt);
  if((import tkind)[dgt] == "ident") {
    dg_case_ref(dgacc, (import ttext)[dgt]);
  }
} return void;
