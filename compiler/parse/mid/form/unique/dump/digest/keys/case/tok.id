dg_case_ref(word[] dgacc, string dgnm) {
  int dgg = dg_fn_named(dgnm);
  if(dgg >= 0) {
    dgacc[0] = dg_mix(dgacc[0], dg_deep_fn(dgg));
    dgacc[1] = dgacc[1] + (import dg_dirty)[(import dg_comp)[dgg]];
  }
} return void;
