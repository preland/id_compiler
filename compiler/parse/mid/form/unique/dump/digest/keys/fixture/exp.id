// Two exports over the parsed pair: gx declared by fa, a function of the
// build, and gy by a name that is not one -- which dg_exports must skip rather
// than map to a row.

dg_t_exp() {
  dg_t_built();
  add_export("gx", "int", "fa");
  add_export("gy", "int", "nobody");
} return void;
():() then dg_nexp:("exp 0")
():() then dg_nfn:(2)

dg_nexp() {
  string dgn_t = "exp " + (hash_map_count((import dg_ec)));
} return string dgn_t;
given dg_t_exp ():("exp 0")
given dg_t_built ():("exp 0")

