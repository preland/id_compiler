// The same additions made before the tables are built, so they are in them;
// and the prepared pair with fa's run marked as having raised a diagnostic.

tk_t_exp() {
  tk_t_parsed();
  add_export("gx", "int", "fa");
  tk_prepare();
} return void;
():() then tk_etype_gx:("int")
():() then tk_nkeys:("keys 2")

tk_t_asm() {
  tk_t_parsed();
  asmfx_push();
  tk_prepare();
} return void;
():() then tk_asm_foo:(1)
():() then tk_nkeys:("keys 2")

tk_t_bad2() {
  tk_t_prep();
  lset((import tkbad), 0, 1);
} return void;
():() then tk_nbad:("bad 1")
():() then tk_nkeys:("keys 2")
