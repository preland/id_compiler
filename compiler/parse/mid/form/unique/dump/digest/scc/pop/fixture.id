// rfn refilled by hand with "conf.id" alone and its index not yet rebuilt,
// for rfn_reindex's own case (mid/names/exports/reach/dead/more/add/, at its
// three-function caps): the index still puts "conf.id" at position 1, past
// the end, so is_reach does not believe it until rfn_reindex runs.
rfn_hand() {
  init_reach();
  clear_strs((import rfn));
  push((import rfn), "conf.id");
} return void;
():() then conf_reached:(0)
():() then rfn_len:(1)

