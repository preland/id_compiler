// Readers of the type check cache's tables, for `then` checks.

tk_nin() {
  string tkn_t = "in " + (hash_map_count((import tkic)));
} return string tkn_t;
given tk_t_warm ():("in 1")
given tk_t_prep ():("in 0")

tk_etype_gx() {
  string tkt = tk_etype("gx");
} return string tkt;
given tk_t_exp ():("int")
given tk_t_prep ():("")

tk_asm_foo() {
  int tka = tk_is_asm("foo");
} return int tka;
given tk_t_asm ():(1)
given tk_t_prep ():(0)
