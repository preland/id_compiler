dg_visit(int dgv) {
  lset((import dg_ix), dgv, (import dg_ctr)[0]);
  lset((import dg_low), dgv, (import dg_ctr)[0]);
  lset((import dg_ctr), 0, (import dg_ctr)[0] + 1);
} chain (int dgv) {
  push((import dg_stk), dgv);
  lset((import dg_on), dgv, 1);
  dg_succ(dgv, 0);
} chain (int dgv) {
  if((import dg_low)[dgv] == (import dg_ix)[dgv]) {
    dg_pop(dgv);
  }
} return void;
