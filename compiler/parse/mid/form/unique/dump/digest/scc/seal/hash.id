// Sealing a component: its hash, and whether it is dirty.
//
// The hash is two sums, mixed together at the end -- the members' own hashes,
// and one term per edge that leaves the component, the hash of the component
// it reaches. A sum does not care what order the stack or an out-list holds
// things in, and every component an edge leaves for is sealed already
// (../visit/tarjan.id), so its hash is final. An edge that stays inside the
// component adds nothing: which member calls which is in the members' tokens.
//
// The members are the stack from dgp up; the component's number is the next
// row of dg_deep.

dg_seal(int dgp) {
  word[] dgacc = [0, 0];
  int[] dgbad = [0];
  dg_seal_run(dgacc, dgbad, dgp);
} chain (int dgp) {
  word dgd = dg_mix(dgacc[0], dgacc[1]);
  push((import dg_deep), dgd);
  push((import dg_dirty), dgbad[0]);
} return void;
