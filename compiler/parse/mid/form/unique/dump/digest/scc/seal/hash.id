dg_seal_run(word[] dgacc, int[] dgbad, int dgp) {
  while(dgp < len((import dg_stk))) {
    dg_seal_one(dgacc, dgbad, (import dg_stk)[dgp]);
    dgp = dgp + 1;
  }
} return void;
