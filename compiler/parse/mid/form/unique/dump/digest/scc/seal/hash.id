dg_seal_one(word[] dgacc, int[] dgbad, int dgm) {
  dgacc[0] = dgacc[0] + dg_mix((import dg_own)[dgm], 7);
  dgbad[0] = dgbad[0] | (import dg_nat)[dgm];
  dg_seal_out(dgacc, dgbad, dgm, 0);
} return void;
