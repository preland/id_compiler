// One member's out-edges, into the sums dg_seal (seal.id) is building.

dg_seal_out(word[] dgacc, int[] dgbad, int dgm, int dgi) {
  while(dgi < len((import dg_out)[dgm])) {
    dg_seal_edge(dgacc, dgbad, (import dg_out)[dgm][dgi]);
    dgi = dgi + 1;
  }
} return void;
