// An edge to a sealed component adds that component's hash and dirt. One to
// a function with no component yet is one the walk has not finished, which
// Tarjan's order rules out; it is taken as dirty rather than trusted.
dg_seal_edge(word[] dgacc, int[] dgbad, int dgw) {
  int dgwc = (import dg_comp)[dgw];
  if(dgwc < 0) {
    dgbad[0] = 1;
  } else if(dgwc < len((import dg_deep))) {
    dgacc[1] = dgacc[1] + dg_mix((import dg_deep)[dgwc], 13);
    dgbad[0] = dgbad[0] | (import dg_dirty)[dgwc];
  }
} return void;
