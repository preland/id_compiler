// The row a node points at, or -1. A call, and a variable read that names a
// function -- a function value, reached exactly as a call reaches it
// (scan_reach, mid/names/exports/reach/dead/sweep.id) -- point at that
// function; a name that is a builtin or a local is in neither table and points
// nowhere -- except a call to one of cache_volatile_builtins (compiler/parse/
// conf.id: the clock, the terminal), which points at the row every asm routine
// shares (../edge/asm.id, the one past prog), so a case calling it is never
// cached. An `(import NAME)` points at the function that declares NAME
// (../rows/own.id's dg_exports).

dg_target(int dgid) {
  string dgkd = (import nkind)[dgid];
  string dgnm = (import ns1)[dgid];
  int dgw = 0 - 1;
} chain (int dgid) {
  if(dgkd == "call" || dgkd == "var") {
    dgw = hash_map_get((import dg_fk), (import dg_fv), (import dg_fu), dgnm, dgw);
  } else if(dgkd == "import") {
    dgw = hash_map_get((import dg_ek), (import dg_ev), (import dg_eu), dgnm, dgw);
  }
  if(dgw < 0 && dgkd == "call" && list_string_index((import cache_volatile_builtins), dgnm) >= 0) {
    dgw = len((import prog));
  }
} return int dgw;
given dg_t_rows (16):(0)
given dg_t_rows (1):(-1)
given dg_t_vol (16):(2)
given dg_t_vol (1):(-1)

dg_link(int dgf, int dgw) {
  push((import dg_out)[dgf], dgw);
} return void;
given dg_t_graph (1, 3):() then dg_nout1:("out1 3")
given dg_t_graph (0, 3):() then dg_nout1:("out1 2")

// The same edge into dg_cout, unless node dgid is an `(import NAME)`: reading
// an export is a dependency for a key, but it runs nothing, so a setup does
// not reach the export's owner through it.
dg_clink(int dgf, int dgw, int dgid) {
  if((import nkind)[dgid] != "import") {
    push((import dg_cout)[dgf], dgw);
  }
} return void;
given dg_t_rows (1, 0, 16):() then dg_ncout1:(1)
given dg_t_exp_node (1, 0, (import dg_t_imp)):() then dg_ncout1:(0)
