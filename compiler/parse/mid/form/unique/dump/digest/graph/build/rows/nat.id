// native is to the digest (front/tree/node/field/native.id), and built.
// fixture dg_t_natv leaves it named fa, which is not on a purity list.
dg_t_natv() {
  dg_t_parsed();
  lset((import ni2), (import prog)[0], 1);
  dg_build();
} return void;
