// One function's row. A function whose tokens were never recorded -- only a
// hand-built test fixture has one -- is marked like a native: its key could
// not see an edit to it, so no case reaching it may be cached.
dg_fill_one(int dgf) {
  string dgnm = (import ns1)[((import prog)[dgf])];
  hash_map_put((import dg_fk), (import dg_fv), (import dg_fu), (import dg_fc), dgnm, dgf);
  word dgo = dg_own_of(dgf, dgnm);
} chain (int dgf) {
  int dgn = dg_nat_class(dgf, (import ns1)[((import prog)[dgf])]);
  dg_add(dgo, dgn);
} return void;
