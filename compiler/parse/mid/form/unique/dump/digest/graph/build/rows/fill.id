// Building the digest over the whole of `prog`, while it is still the program
// as parsed: the test harness narrows `prog` right after this runs
// (back/drive/target/tests/keep.id), and both the node ranges the edges are
// read from and ptoks/ptoke line up only with the unnarrowed list.

dg_build() {
  dg_init();
  int dgf = 0;
  while(dgf < len((import prog))) {
    dg_fill_one(dgf);
    dgf = dgf + 1;
  }
} chain () {
  dg_asm_row();
  dg_const_rows();
  dg_exports(0);
} chain () {
  dg_edges_all();
  dg_scc_all();
} return void;
