dg_add(word dgo, int dgn) {
  push((import dg_own), dgo);
  push((import dg_out), []);
  push((import dg_nat), dgn);
} chain (word dgo, int dgn) {
  push((import dg_ix), 0 - 1);
  push((import dg_low), 0);
  push((import dg_on), 0);
} chain (word dgo, int dgn) {
  push((import dg_comp), 0 - 1);
  push((import dg_cout), []);
} return void;
