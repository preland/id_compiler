// A five-function call graph built straight into the digest's rows, with no
// parse behind it, for the walk's own cases (../../scc/):
//
//   0 <-> 1 -> 2        a cycle calling a leaf
//   4 -> 3 (native)     a caller of a body the digest cannot see
//
// so the walk finds four components -- {2}, {0,1}, {3}, {4}, completed in
// that order -- and only the last two are dirty.

dg_t_graph() {
  dg_init();
  dg_add(1, 0);
  dg_add(2, 0);
} chain () {
  dg_add(3, 0);
  dg_add(4, 1);
  dg_add(5, 0);
} chain () {
  dg_link(0, 1);
  dg_link(1, 0);
  dg_link(1, 2);
} chain () {
  dg_link(4, 3);
} return void;
():() then calls dg_add:(1, 0)
():() then len((import dg_comp)):(5)

dg_t_scc() {
  dg_t_graph();
  dg_scc_all();
} return void;
():() then (import dg_ctr)[1]:(4)
():() then len((import dg_comp)):(5)


// The parsed pair's second function calling `ticks` where it called fa: a
// call to a volatile builtin, which dg_target sends to the row every asm
// routine shares (../build/edge/asm.id), the one past prog.
dg_t_vol() {
  dg_t_rows();
  string_list_set((import ns1), 16, "ticks");
  string_list_set((import nkind), 16, "call");
} return void;
():() then (import ns1)[16]:("ticks")
():() then len((import dg_comp)):(2)
