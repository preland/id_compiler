// Which report `report_mode` (../fix/run/entry.id) prints for the shared mode
// of --fingerprints and --keeps: both are rows about the parsed program.

keeps_or_fp(int kp_mode) {
  if(kp_mode == 8) {
    keeps_print();
  } else {
    print_fingerprints();
  }
} return void;
given lz_o {
  (8):() then calls keeps_print:[1]
  (1):() then calls print_fingerprints:[1]
}

keeps_at(int kp_x) {
  string kp_nm = (import fnames)[kp_x];
  int kp_n = len((import nl1)[(import fnodes)[kp_x]]);
  int kp_m = esc_mask(kp_nm);
} chain (int kp_x) {
  string kp_ln = keeps_row(kp_nm, kp_m, kp_n);
} return string kp_ln;
given esc_fix {
  (0):("fa_sink\t11\t1")
  (1):("fa_loc\t1\t0")
}
