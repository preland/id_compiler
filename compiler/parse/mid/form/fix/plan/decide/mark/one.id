fix_mark_rest(int last) {
  fix_mark_cls(last, 3);
  fix_mark_imports(last);
} return void;

// A trapping read (an index, or an operator that can trap) and an import read
// move only when some call ahead of them that also moves could write -- the
// only way either could see a different value (docs/PROJECT.md, --fix).
fix_mark_imports(int last) {
  if(fix_touches(last) == 1) {
    fix_mark_cls(last, 2);
    fix_mark_cls(last, 4);
  }
} return void;

fix_mark_cls(int last, int wcl) {
  int i = 0;
  while(i <= last) {
    if((import fixe_cl)[i] == wcl) {
      lset((import fixe_mv), i, 1);
    }
    i = i + 1;
  }
} return void;
