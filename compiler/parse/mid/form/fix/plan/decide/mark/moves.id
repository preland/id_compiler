fix_check_and_emit(int sn, int last) {
  string why = fix_why(sn, last);
  if(why == "") {
    fix_emit_stmt(sn, last);
  } else {
    fix_refuse(last, why);
  }
} return void;

fix_last_m() {
  int i = 0;
  int last = 0 - 1;
  while(i < len((import fixe_cl))) {
    if((import fixe_cl)[i] == 3) {
      last = i;
    }
    i = i + 1;
  }
} return int last;

// Calls and trapping reads first: whether an import moves depends on which
// calls do.
fix_mark_moves(int last) {
  fix_mark_cls(last, 1);
  fix_mark_cls(last, 2);
  fix_mark_rest(last);
} return void;
