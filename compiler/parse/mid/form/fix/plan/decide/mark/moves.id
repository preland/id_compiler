fix_last_m() {
  int i = 0;
  int last = 0 - 1;
  while(i < len((import fixe_cl))) {
    if((import fixe_cl)[i] == 3) {
      last = i;
    }
    i = i + 1;
  }
} return int last;

// Calls first: whether a trapping read or an import moves depends on which
// calls do.
fix_mark_moves(int last) {
  fix_mark_cls(last, 1);
  fix_mark_rest(last);
} return void;
