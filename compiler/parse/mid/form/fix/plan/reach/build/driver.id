// fixd_wm: 1 for each function, indexed as fnames is, that can run a function
// declaring an export -- directly or through calls -- or that calls through a
// function value, which could run anything. An import read only has to move
// ahead of a call that can.
//
// Built backwards: every function whose body declares an export or calls
// through a value is a seed, and a function that calls or names a marked one
// is marked. One pass collects the edges, one walk follows them.
fix_wbuild() {
  fix_winit();
  fix_wedges(0, 0);
  while(len((import fixd_wq)) > 0) {
    int gi = pop((import fixd_wq));
    fix_wprop(gi);
  }
} return void;
given fix_wbuild_fixture ():() then calls fix_wprop:(0)
given fix_wbuild_fixture ():() then (import fixd_wm)[0]:(1)
given full_env ():() then calls fix_wprop:[0]

//   fixd_wadj  for each function, the functions that call or name it
//   fixd_wq    marked functions whose callers are not marked yet
// fixd_wadj: fixd_wadj as a whole, for fix_wedge's own cases (edge/ref/main.id is at
// the three-function cap) -- push cannot be witnessed with 'then calls' (it
// is a builtin), and reading the whole table avoids hard-coding which row.
// fixd_wadj: fixd_wadj has no reader elsewhere in the build, for fix_wrow's own cases
// (plan/reach/build/fill.id is at the three-function cap).
fix_winit() {
  export int[] fixd_wm = [];
  export int[][] fixd_wadj = [];
  fix_winit2();
} return void;
given fix_fixture ():() then calls fix_winit2:[1] then len((import fixd_wm)):(0) then len((import fixd_wadj)):(0)
given fix_touch_fixture ():() then calls fix_winit2:[1] then (import fixd_wadj):([])

fix_winit2() {
  export int[] fixd_wq = [];
  int i = 0;
  while(i < len((import fnames))) {
    push((import fixd_wm), 0);
    fix_wrow();
    i = i + 1;
  }
} return void;
