fix_wref2(int x, int ow, int ci, string name) {
  if(ci >= 0) {
    fix_wedge(ci, ow);
  } else if(k_of(x) == "call" && is_builtin(name) == 0) {
    fix_wseed(ow);
  }
} return void;

fix_wedge(int ci, int ow) {
  int[] row = (import fixd_wadj)[ci];
  push(row, ow);
} return void;

fix_wseed(int ow) {
  if(ow >= 0 && (import fixd_wm)[ow] == 0) {
    lset((import fixd_wm), ow, 1);
    push((import fixd_wq), ow);
  }
} return void;
