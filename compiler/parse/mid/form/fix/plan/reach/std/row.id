fix_std_row(int i, int[] cnt) {
  if((import dvunit)[i] == 0 && (import dvexp)[i] == 0) {
    fix_std_count(i, cnt);
  }
} return void;

fix_std_count(int i, int[] cnt) {
  if(str_starts((import dvname)[i], "idstd_") == 1) {
    cnt[0] = cnt[0] + 1;
  } else {
    cnt[1] = cnt[1] + 1;
  }
} return void;
