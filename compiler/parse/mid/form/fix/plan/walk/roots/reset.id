//   fixe_cl  0 pure, 1 a call, 2 an index or an operator that can trap, 3 a
//            value that must be named, 4 an import read
//   fixe_cd  1 inside the right operand of && or ||
fix_ev_reset2() {
  export int[] fixe_cl = [];
  export int[] fixe_cd = [];
  fix_ev_reset3();
} return void;

//   fixe_nt  the parameter type a narrowing argument is declared as
//   fixe_mv  1 for an event that moves before the statement
fix_ev_reset3() {
  export string[] fixe_nt = [];
  export int[] fixe_mv = [];
  fix_ev_reset4();
} return void;

//   fixe_sep  1 for a moved event that gets a declaration of its own
//   fixe_nm   the name it is given
//   fixe_an   set only for the node at the top of a call's argument: the
//             whole-argument name to use if it is named as one (out/emit/).
fix_ev_reset4() {
  export int[] fixe_sep = [];
  export string[] fixe_nm = [];
  export string[] fixe_an = [];
} return void;
