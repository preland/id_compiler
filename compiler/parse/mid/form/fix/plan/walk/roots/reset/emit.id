//   fixe_sep  1 for a moved event that gets a declaration of its own
//   fixe_nm   the name it is given
//   fixe_an   set only for the node at the top of a call's argument: the
//             whole-argument name to use if it is named as one (out/emit/).
fix_ev_reset4() {
  export int[] fixe_sep = [];
  export string[] fixe_nm = [];
  fix_ev_reset5();
} return void;

//   fixe_ru  1 for a call event whose name is reused from an earlier
//            identical, still-trustworthy call (out/emit/name/pick/reuse/):
//            its text is still replaced by the name, but it gets no
//            declaration of its own -- the reused name's already has one.
fix_ev_reset5() {
  export string[] fixe_an = [];
  export int[] fixe_ru = [];
} return void;
