// fixe_nm: fixe_nm holds one entry per event, pushed empty by fix_push4 (../../kind/
// push.id) and set by fix_name_at (out/emit/name/drive.id), so its length is
// what a function that resets or pushes an event column changes. Filed here
// rather than beside its export in emit.id, which is at its three-function
// cap in a directory at the since-dropped three-entry one.
fix_ev_reset4() {
  export int[] fixe_sep = [];
  export string[] fixe_nm = [];
  fix_ev_reset5();
} return void;
