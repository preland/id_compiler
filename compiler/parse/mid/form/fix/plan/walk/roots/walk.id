fix_walk_kids(int e, int cd) {
  if(k_of(e) == "call") {
    fix_walk_args(e, cd);
  } else if(k_of(e) == "bin" || k_of(e) == "index") {
    fix_walk_bin(e, cd);
  } else {
    fix_walk_more(e, cd);
  }
} return void;
