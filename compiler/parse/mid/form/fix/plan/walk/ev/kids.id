fix_walk_args(int e, int cd) {
  int[] args = l1_of(e);
  int i = 0;
  while(i < len(args)) {
    fix_walk_arg(e, i, cd);
    i = i + 1;
  }
} return void;

fix_walk_arg(int e, int i, int cd) {
  int a = l1_of(e)[i];
  string nt = fix_narrow(e, i, a);
  fix_walk(a, 1, cd, nt);
} return void;

// An index is its list and then its position, as an operator is its two
// operands; only && and || may leave the right one unevaluated.
fix_walk_bin(int e, int ca, int cd) {
  int a = i1_of(e);
  fix_walk(a, ca, cd, "");
  fix_walk_rhs(e, ca, cd);
} return void;
