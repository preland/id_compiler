fix_condop(int e, int cd) {
  int c = cd;
  if(s1_of(e) == "&&" || s1_of(e) == "||") {
    c = 1;
  }
} return int c;

fix_walk_more(int e, int cd) {
  if(k_of(e) == "un") {
    int a = i1_of(e);
    fix_walk(a, 0, cd, "", "");
  } else if(k_of(e) == "arr") {
    fix_walk_arr(e, cd);
  }
} return void;
