fix_class2(int e) {
  int cl = fix_class3(e);
  if(k_of(e) == "call") {
    cl = 1;
  } else if(k_of(e) == "index") {
    cl = 2;
  }
} return int cl;

// An import read is judged apart: it gives the same value after a call unless
// that call can run the function declaring the export (plan/reach/).
fix_class3(int e) {
  int cl = 0;
  if(k_of(e) == "import") {
    cl = 4;
  } else if(k_of(e) == "bin" && fix_traps(e) == 1) {
    cl = 2;
  }
} return int cl;
