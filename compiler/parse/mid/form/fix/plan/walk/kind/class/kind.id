// An import read is judged apart: it gives the same value after a call unless
// that call can run the function declaring the export (plan/reach/).
fix_class3(int e) {
  int cl = 0;
  if((import nkind)[e] == "import") {
    cl = 4;
  } else if((import nkind)[e] == "bin" && fix_traps(e) == 1) {
    cl = 2;
  }
} return int cl;
given fix_class3_setup ((import ck_import)):(4)
given fix_class3_setup ((import ck_int)):(0)

fix_class3_setup() {
  fix_fixture();
  export int ck_import = newleaf("import", 0, 0, "x", "");
  export int ck_int = newleaf("int", 1, 0, "1", "");
} return void;
():() then ck_import_check:("import")
():() then (import chkfail)[0]:(0)

ck_import_check() {
  string k = (import nkind)[(import ck_import)];
} return string k;
given fix_class3_setup ():("import")
given fix_class3_setup ():("import") then (import chkfail)[0]:(0)
