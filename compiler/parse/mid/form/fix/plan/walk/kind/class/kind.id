// An import read is judged apart: it gives the same value after a call unless
// that call can run the function declaring the export (plan/reach/).
fix_class3(int e) {
  int cl = 0;
  if(k_of(e) == "import") {
    cl = 4;
  } else if(k_of(e) == "bin" && fix_traps(e) == 1) {
    cl = 2;
  }
} return int cl;
given fix_class3_setup ((import ck_import)):(4)
given fix_class3_setup ((import ck_int)):(0)

fix_class3_setup() {
  fix_fixture();
  export int ck_import = newleaf("import", 0, 0, "x", "");
  export int ck_int = newleaf("int", 1, 0, "1", "");
} return void;
