fix_push4(int cd, string nt) {
  push((import fixe_cd), cd);
  push((import fixe_nt), nt);
  push((import fixe_mv), 0);
} chain (int cd, string nt) {
  push((import fixe_sep), 0);
  push((import fixe_nm), "");
} return void;

// A call inside another call's argument must be named; so must an argument
// that narrows, whatever it is; so must an argument that is not itself a call
// but has one somewhere inside it -- named whole, rather than naming the call
// alone, since naming the call alone would still leave it inside the
// argument of the call this argument belongs to. Anything else is named only
// if something evaluated after it moves (plan/decide/). This used to be its
// own function, fix_class, called exactly once as the last action of
// fix_walk (../roots/walk.id); it now chains there directly.
