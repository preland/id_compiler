// Finding the first block of a function that is over the three-action limit,
// outermost first: an inner block of it moves with it, and is found in the
// next round if it is still too long on its own. Only the arms of an if and the
// body of a while are blocks; the function's own body is chained instead.

fix_xfind(int[] xbody, int xinloop) {
  int xfi = 0;
  while(xfi < len(xbody) && len((import fixx_hit)) == 0) {
    fix_xnode(xbody[xfi], xinloop);
    xfi = xfi + 1;
  }
} return void;
given fix_xnodes ([5], 0):() then calls fix_xrecord:([1, 2, 3, 4], 0)
given fix_xnodes ([9], 0):() then calls fix_xrecord:[0]
given fix_xnodes ([1, 6], 0):() then calls fix_xrecord:([1, 2, 3, 4], 1)

fix_xnode(int xnd, int xinloop) {
  if((import nkind)[xnd] == "if" || (import nkind)[xnd] == "while") {
    fix_xarms(xnd, xinloop);
  }
} return void;
given fix_xnodes (5, 0):() then calls fix_xrecord:([1, 2, 3, 4], 0)
given fix_xnodes (1, 0):() then calls fix_xrecord:[0]

fix_xblock(int[] xarm, int xinloop) {
  if(count_actions(xarm) > 3) {
    fix_xrecord(xarm, xinloop);
  } else {
    fix_xfind(xarm, xinloop);
  }
} return void;
given fix_xnodes ([1, 2, 3, 4], 0):() then calls fix_xrecord:([1, 2, 3, 4], 0)
given fix_xnodes ([1, 2], 0):() then calls fix_xrecord:[0]
