// The helper's parameters: every local the block reads or assigns that it does
// not declare itself, in the order they were first met, with their types.

fix_xparams(int xplo2, int xpf2) {
  export string[] fixx_par = [];
  export string[] fixx_pty = [];
  fix_xneed((import fixx_rd), xplo2, xpf2);
} chain (int xplo2, int xpf2) {
  fix_xneed((import fixx_wr), xplo2, xpf2);
} return void;
given fix_xparamed (0, 12):() then (import fixx_par):(["a", "b"])
given fix_xparamed (0, 12):() then (import fixx_pty):(["int", "string"])

fix_xneed(string[] xnlist, int xnlo, int xnf2) {
  int xnj = 0;
  while(xnj < len(xnlist)) {
    fix_xtake(xnlist[xnj], xnlo, xnf2);
    xnj = xnj + 1;
  }
} return void;
given fix_xparamed (["zed"], 0, 12):() then (import fixx_par):(["a", "b", "zed"])
given fix_xparamed (["a", "b"], 0, 12):() then (import fixx_par):(["a", "b"])

fix_xtake(string xkname, int xklo, int xkf) {
  if(find_str((import fixx_dc), xkname) < 0 && find_str((import fixx_par), xkname) < 0) {
    push((import fixx_par), xkname);
    push((import fixx_pty), fix_xtype(xkname, xklo, xkf));
  }
} return void;
given fix_xparamed ("b", 0, 12):() then (import fixx_par):(["a", "b"])
given fix_xparamed ("zed", 0, 12):() then (import fixx_pty):(["int", "string", ""])
