fix_decls(int sn, int last) {
  int i = 0;
  while(i <= last) {
    fix_decl_at(sn, i);
    i = i + 1;
  }
} return void;

// A reused event (fixe_ru, out/emit/name/pick/reuse/) is still sep -- its
// text is still replaced by the name (fix_resid, out/emit/resid/resid.id) --
// but the name it reused already has a declaration, so this one gets none.
fix_decl_at(int sn, int i) {
  if((import fixe_sep)[i] == 1 && (import fixe_ru)[i] == 0) {
    fix_decl(sn, i);
  }
} return void;

fix_decl(int sn, int i) {
  string head = fix_decl_head(sn, i);
  string subs = fix_subs(i);
  print(head + subs);
} return void;
