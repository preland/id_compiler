// A name for event i: an earlier identical, still-trustworthy call's, if one
// is cached (fix_rcache_find) -- in which case it gets no declaration of its
// own (fixe_ru, out/emit/decl/decl.id), only its text replaced by the name.
// Otherwise the tree's own convention (fix_pick), cached for a later call to
// find in turn.
fix_name_pick(int i) {
  string name = fix_rcache_find(i);
  if(name == "") {
    name = fix_pick(i);
    fix_rcache_add(i, name);
  } else {
    lset((import fixe_ru), i, 1);
  }
} return string name;

// Only a call can be found -- a whole argument or a narrowed value is not a
// repeat of anything, whatever else shares its text.
fix_rcache_find(int i) {
  int e = (import fixe_n)[i];
  string name = "";
  if(k_of(e) == "call") {
    string key = fix_rkey(e);
    int ix = find_str((import fixd_rk), key);
    name = fix_rcache_find_at(ix);
  }
} return string name;

fix_rcache_find_at(int ix) {
  string name = "";
  if(ix >= 0) {
    name = (import fixd_rn)[ix];
  }
} return string name;
