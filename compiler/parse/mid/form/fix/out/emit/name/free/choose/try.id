// <stem>_v, then <stem>_v2, <stem>_v3: the numbering the tree already uses for
// a second value of the same call. ret_i, then ret_i2, the same way.
fix_try(string bstem, string sfx, string t) {
  string name = bstem + sfx;
  int nn = 1;
  while(fix_free(name, t) == 0) {
    nn = nn + 1;
    name = bstem + sfx + nn;
  }
} return string name;
given fix_fixture ("foo", "_v", "int"):("foo_v")
given fix_env4 ("baz", "_v", "int"):("baz_v2")

// fix_fixture with a name already used, for fix_free_var's negative case ("bar")
// and for an argument stem already claimed by an earlier argument ("callee_a0").
fix_taken(string fx_used) {
  fix_fixture();
  push((import fixd_used), fx_used);
} return void;
("bar"):() then (import fixd_used):(["bar"])
("callee_a0"):() then (import fixd_used):(["callee_a0"])
("bar"):() then calls fix_fixture:[1]
("callee_a0"):() then init_units:(0)

