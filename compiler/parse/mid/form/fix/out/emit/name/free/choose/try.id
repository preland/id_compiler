// <stem>_v, then <stem>_v2, <stem>_v3: the numbering the tree already uses for
// a second value of the same call. ret_i, then ret_i2, the same way.
fix_try(string bstem, string sfx, string t) {
  string name = bstem + sfx;
  int nn = 1;
  while(fix_free(name, t) == 0) {
    nn = nn + 1;
    name = bstem + sfx + nn;
  }
} return string name;
given fix_fixture ("foo", "_v", "int"):("foo_v")
given fix_env4 ("baz", "_v", "int"):("baz_v2")

