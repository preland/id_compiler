// The tree's convention: a call's value is <callee>_v. A value that is not a
// call is named after what it reads first -- a list, an import, a variable.
fix_stem(int e) {
  string s = fix_stem2(e);
  if(k_of(e) == "index" || k_of(e) == "bin" || k_of(e) == "un") {
    int a = i1_of(e);
    s = fix_stem(a);
  }
} return string s;
given fix_stem_fixture (0):("list")
given fix_stem_fixture (2):("len")

fix_stem2(int e) {
  string s = s1_of(e);
  if(k_of(e) == "arr") {
    s = "list";
  } else if(k_of(e) == "int" || k_of(e) == "float" || k_of(e) == "str") {
    s = "lit";
  }
} return string s;
given fix_stem_fixture (0):("list")
given fix_stem_fixture (1):("len")

// e0 an "arr" node (fix_stem2's own override), e1 an "ident" leaf "len", e2 a
// "-" unary wrapping e1 -- fix_stem(2) recurses through e2 into e1's stem.
fix_stem_fixture() {
  env_init();
  int[] none = [];
  int e0 = node_arr(none);
} chain () {
  int e1 = newleaf("ident", 0, 0, "len", "");
  int e2 = node_un("-", e1);
} return void;
