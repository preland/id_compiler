// A stem named with suffix "_v" (<stem>_v), or, for a whole argument named
// because it has a call somewhere inside it (plan/walk/kind/push.id), with no
// suffix at all: <callee>_a0, then <callee>_a02 if that is somehow taken too
// (fix_try's own numbering, with an empty suffix).
fix_choose(string stem, string sfx, string t) {
  string bstem = fix_prefixed(stem);
  string name = fix_choose_base(bstem, sfx, t);
} return string name;
given fix_fixture ("foo", "_v", "int"):("foo_v")
given fix_fixture ("bar", "_v", "string"):("bar_v")
given fix_taken("callee_a0") ("callee_a0", "", "int"):("callee_a02")
given fix_fixture ("foo_a0", "", "int"):("foo_a0")

fix_choose_base(string bstem, string sfx, string t) {
  string name = fix_try(bstem, sfx, t);
  fix_take(name, t);
} return string name;
given fix_fixture {
  ("foo", "_v", "int"):("foo_v")
  ("bar", "_v", "string"):("bar_v")
}

// A leaf node at token 0 of ../../pick/reuse/lookup/at.id's
// fix_tokline_fixture3, for a fix_span case that needs a token position
// other than out/emit/decl/subs.id's fix_tokline_node_fixture.
fix_tokline_node_fixture2() {
  fix_tokline_fixture3();
  int e = newleaf("ident", 0, 0, "len", "");
  fix_span_fixture2(e);
} return void;
given fix_tokline_fixture3 {
  ():() then calls newleaf:("ident", 0, 0, "len", "")
  ():() then (import fixd_gcl)[0]:(-1)
  ():() then init_units:(0)
}
