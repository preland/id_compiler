// The body's closing brace: back from the clause's value, past its type, to
// `return`, and one more.
fix_close(int e) {
  int t0 = fix_nbeg(e) - 1;
  while(t0 > 0 && ((import tkind)[t0] != "kw" || (import ttext)[t0] != "return")) {
    t0 = t0 - 1;
  }
  int cb = t0 - 1;
} return int cb;
given fix_ret_fixture {
  (5):(-1)
  (1):(0)
  (0):(0)
}

fix_ret_emit(int f, int e, string t) {
  string name = fix_ret_name(t);
  fix_ret_decl(f, e, t, name);
  fix_replace(e, name);
} return void;
given fix_ret_fixture {
  (2, 0, "int"):() then prints:("@D||10|5|1|5|int ret_i = |10|5|10|8\n@R||10|5|10|8|2|ret_i\n")
  (3, 0, "string"):() then prints:("@D||10|5|1|0|string ret_s = |10|5|10|8\n@R||10|5|10|8|2|ret_s\n")
}

fix_ret_name(string t) {
  string sfx = fix_tsuf(t);
  string bstem = fix_prefixed("ret_" + sfx);
  string name = fix_choose_base(bstem, "", t);
} return string name;
given fix_fixture {
  ("int"):("ret_i")
  ("string"):("ret_s")
}
