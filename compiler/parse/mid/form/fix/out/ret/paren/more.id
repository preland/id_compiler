fix_paren_pts(int b, int e) {
  string p1 = fix_at(b);
  string p2 = fix_after(e);
  fix_paren_rec(p1, p2);
} return void;

fix_paren_rec(string p1, string p2) {
  fix_emit_pt(p1, "(");
  fix_emit_pt(p2, ")");
} return void;

fix_in_moved(int c) {
  int b = fix_nbeg(c);
  int e = fix_nend(c);
  int ok = fix_within(b, e);
} return int ok;
