// A parameter or a declaration anywhere in the function reserves its name.
fix_used_at(int x) {
  if(k_of(x) == "decl" || k_of(x) == "param") {
    string s2_of_v = s2_of(x);
    push((import fixd_used), s2_of_v);
  }
} return void;

fix_body(int f) {
  int[] l2_of_v = l2_of(f);
  fix_block(l2_of_v);
} return void;

fix_block(int[] stmts) {
  int i = 0;
  while(i < len(stmts)) {
    fix_stmt(stmts[i], 0);
    i = i + 1;
  }
} return void;
