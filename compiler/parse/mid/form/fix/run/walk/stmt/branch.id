// md says how often a statement's expression is evaluated: 0 once, where it
// stands; 1 a while condition, every iteration; 2 an else-if condition, only
// when every earlier branch was not taken. A value named before the statement
// is the same value only for 0.

fix_stmt(int sn, int md) {
  if(k_of(sn) == "if") {
    fix_if(sn, md);
  } else if(k_of(sn) == "while") {
    fix_while(sn);
  } else {
    fix_simple(sn);
  }
} return void;
given fix_if_fixture (1, 0):() then calls fix_if:(1, 0)
given fix_if_fixture (2, 0):() then calls fix_while:(2)

fix_if(int sn, int md) {
  fix_cond(sn, md);
  fix_then(sn);
  int[] els = l2_of(sn);
} chain (int sn, int md) {
  if(i2_of(sn) == 1) {
    fix_stmt(els[0], 2);
  } else {
    fix_block(els);
  }
} return void;
given fix_if_fixture (1, 0):() then calls fix_cond:(1, 0)
given fix_if_fixture (1, 0):() then calls fix_block:[2]

// A declaration, an assignment and an expression statement keep their one
// expression where an if and a while keep their condition.
fix_cond(int sn, int md) {
  int c = i1_of(sn);
  int[] fixp_roots = [c];
  fix_plan(sn, fixp_roots, md);
} return void;
given fix_if_fixture (1, 0):() then calls fix_plan:(1, [0], 0)
given fix_if_fixture (2, 1):() then calls fix_plan:(2, [0], 1)
