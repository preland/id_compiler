// The events of one statement, reset by declaring them again (plan/walk/).
//   fixe_n   each node, in the order it is evaluated
//   fixe_lo  the index of the first event of its subtree
// fixe_lo: The other column pushed in step with it: the first event of the subtree.
// fixe_n: fixe_n gets one entry per event and is pushed here and nowhere else, so its
// length is what this function changes. A `then` check takes no parameters,
// so a function whose whole effect is a push can only be observed through a
// reader of the column it pushes to -- fixe_cl already has fix_pr_cl0
// (../one/push.id).
fix_ev_reset() {
  export int[] fixe_n = [];
  export int[] fixe_lo = [];
  fix_ev_reset2();
} return void;
