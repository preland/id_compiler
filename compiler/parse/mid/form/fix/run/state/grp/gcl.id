// fixd_gcl: the closing parenthesis of the outermost grouping parentheses
// written around each node, or -1.
fix_gcl() {
  export int[] fixd_gcl = [];
  fix_gcl_fill();
  int i = 0;
} chain () {
  while(i < len((import ngrp))) {
    fix_gcl_at(i);
    i = i + 1;
  }
} return void;
given env_init ():() then check_failed:(0)
given fix_gcl_nodes ():() then check_failed:(0)

// fixd_gcl is deliberately left uncased, on fixture cost. fix_gcl exports it
// and runs both writers in one chain -- this fill, then fix_gcl_at over ngrp
// (../more.id) -- so every setup that reaches the export has already applied
// them, and the values fix_gcl_at reads come from ngrpc, which the token
// loader fills and no fix fixture does. Telling the lset apart would need
// grouping-paren token state built by hand: fix state plus the lexer, two
// subsystems for one write.
fix_gcl_fill() {
  int i = 0;
  while(i < len((import nkind))) {
    push((import fixd_gcl), 0 - 1);
    i = i + 1;
  }
} return void;
given fix_fixture ():() then check_failed:(0)
given fix_gcl_fill_fixture ():() then check_failed:(0)

// Two nodes, so fix_gcl's own cases have something other than an empty tree
// to size fixd_gcl against.
fix_gcl_nodes() {
  env_init();
  int e1 = node_int("1", 1, 0);
  int e2 = node_int("2", 2, 0);
} return void;
():() then check_failed:(0)
():() then init_units:(0)
