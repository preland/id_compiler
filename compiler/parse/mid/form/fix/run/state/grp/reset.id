given env_init ():() then init_units:(0)

// The repeated-call cache (out/emit/name/pick/reuse/) is a function's own
// too: a name good in one function says nothing about another.
fix_state3b() {
  export int[] fixd_hi = [];
  fix_rcache_reset();
} return void;
given env_init ():() then check_failed:(0)
given env_init ():() then init_units:(0)

