// Per function, reset by running this again (run/walk/enter.id):
//   fixd_used         every name the function declares, and each new one
//   fixd_lo, fixd_hi  the token ranges this run replaces, so that no other
//                     edit lands inside text that is going away
fix_state3() {
  export string[] fixd_used = [];
  export int[] fixd_lo = [];
  fix_state3b();
} return void;

// The repeated-call cache (out/emit/name/pick/reuse/) is a function's own
// too: a name good in one function says nothing about another.
fix_state3b() {
  export int[] fixd_hi = [];
  fix_rcache_reset();
} return void;
