// The state of one fix run.
//   fixd_nm, fixd_ty  every name this run introduced, and its type, so two
//                     functions cannot give one new name two types
//   fixd_seq          the order edits were printed in
//   fixd_std          1 when new names take the idstd_ prefix (plan/reach/std/)
//   fixd_file         the file of the function being fixed

fix_state() {
  fix_state1();
  fix_state2();
  fix_gcl();
} return void;
given env_init ():() then (import chkfail)[0]:(0)
given env_init ():() then init_units:(0)

fix_state1() {
  export string[] fixd_nm = [];
  export string[] fixd_ty = [];
  export int[] fixd_seq = [0];
} return void;
given env_init ():() then (import chkfail)[0]:(0)
given env_init ():() then init_units:(0)

// fixd_file: A reader for run/walk/enter.id's fix_setfile: fixd_file holds one cell
// (run/state/init.id), so, as fixd_std_on does for fixd_std, reading it is
// the witness -- fix_setfile pops then pushes, leaving the length the same,
// so a length check would not see the pop/push land the wrong string.
// fixd_std: fixd_std is one cell, not a list that grows: fix_init (../entry.id) lsets
// the answer into it and nothing pushes, so neither a length nor a sum is
// the right witness -- reading the cell is, the same shape check_failed and
// is_runtime use for their own flags. Filed here rather than beside the
// export in ../state/init.id, which is at its three-function cap.
fix_state2() {
  export int[] fixd_std = [0];
  export string[] fixd_file = [""];
  fix_state3();
} return void;
given fix_fixture given lset((import fixd_std), 0, 1) ():() then (import fixd_std)[0]:(0)
given fix_ret_fixture given fix_setfile(1) ():() then (import fixd_file)[0]:("")
given fix_fixture ():() then calls fix_state3:[1]
given fix_touch_fixture ():() then calls fix_state3:[1]
