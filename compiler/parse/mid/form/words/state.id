// The vocabulary the word scan (./scan.id, E0311) checks names against, and the
// record of which names it has already judged. bin/idc hands the vocabulary in
// as `wrd WORD` lines ahead of the tokens, one per word of data/words/english.txt
// (less denied.txt), short.txt and data/words/allowed.txt, only under --word-scan; this file
// holds the tables those lines fill (front/tokens/load/more/wrd.id).
//
//   vocab_keys/vals/used/count        every word of the vocabulary, as a set
//   vocab_seen_keys/vals/used/count   every name judged so far, as a set: a name
//                                     declared in a hundred functions is
//                                     judged, and reported, once
//   vocab_totals                      [names judged, names not spelled in words]

vocab_init() {
  export string[] vocab_keys = [];
  export int[] vocab_vals = [];
  export int[] vocab_used = [];
} chain () {
  export int[] vocab_count = [];
  hmap_init((import vocab_keys), (import vocab_vals), (import vocab_used), (import vocab_count));
  vocab_init_seen();
} return void export vocab_count;
():() then (import vocab_count)[0]:(0)
():() then len((import vocab_vals)):(8)

vocab_init_seen() {
  export string[] vocab_seen_keys = [];
  export int[] vocab_seen_vals = [];
  export int[] vocab_seen_used = [];
} chain () {
  export int[] vocab_seen_count = [];
  export int[] vocab_totals = [0, 0];
  hmap_init((import vocab_seen_keys), (import vocab_seen_vals), (import vocab_seen_used), (import vocab_seen_count));
} return void export vocab_totals;
():() then (import vocab_seen_count)[0]:(0)
():() then (import vocab_totals)[1]:(0)

vocab_words() {
  hset_add((import vocab_keys), (import vocab_vals), (import vocab_used), (import vocab_count), "buffer");
  hset_add((import vocab_keys), (import vocab_vals), (import vocab_used), (import vocab_count), "width");
  hset_add((import vocab_keys), (import vocab_vals), (import vocab_used), (import vocab_count), "utf8");
} return void;
given full_env ():() then (import vocab_count)[0]:(3)
given full_env ():() then (import chkfail)[0]:(0)
