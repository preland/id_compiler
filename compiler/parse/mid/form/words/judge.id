// One name, judged the first time it is met: recorded as seen, counted, and
// reported if any piece of it is not a word.

vocab_judge(string vocab_name, int vocab_kind, int vocab_row) {
  hash_set_add((import vocab_seen_keys), (import vocab_seen_vals), (import vocab_seen_used), (import vocab_seen_count), vocab_name);
  integer_list_set((import vocab_totals), 0, (import vocab_totals)[0] + 1);
  string vocab_failed = vocab_bad(vocab_name);
} chain (string vocab_name, int vocab_kind, int vocab_row) {
  if(vocab_failed != "") {
    vocab_report(vocab_name, vocab_kind, vocab_row, vocab_failed);
  }
} return void;
