// The pieces of a name that are not words, in the order they occur, as the text
// the diagnostic prints ("fb, w"); "" when every piece is one. The scan splits
// on `_` and on PascalCase/camelCase boundaries (string_snake), so `__` makes an
// empty piece, `GlyphRun` is glyph and run, and a name with neither is its own
// single piece.

vocab_bad(string vocab_name) {
  string[] vocab_pieces = string_split(string_snake(vocab_name), "_");
  string vocab_acc = "";
  int vocab_i = 0;
} chain (string vocab_name) {
  while(vocab_i < len(vocab_pieces)) {
    vocab_acc = vocab_bad_add(vocab_acc, vocab_pieces[vocab_i], len(vocab_pieces));
    vocab_i = vocab_i + 1;
  }
} return string vocab_acc;
given full_env {
  given vocab_words ("buffer_width"):("")
  given vocab_words ("fb_w"):("fb, w")
  given vocab_words ("fb_width"):("fb")
  given vocab_words ("UTF8_BUFFER"):("")
  given vocab_words ("buffer__width"):("(empty)")
  given vocab_words ("fb"):("fb")
  given vocab_words ("buffer_x"):("")
  given vocab_words ("BUFFER_Y"):("")
  given vocab_words ("z"):("z")
  given vocab_words ("BufferWidth"):("")
  given vocab_words ("FbWidth"):("Fb")
  given vocab_words ("BufferFbW"):("Fb, W")
}
