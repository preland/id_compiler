// regrow_e (names/symbols/check/access/report/more/callvar/check.id) exports one
// name, "g", with a type but no owner; the word scan reports an export at its
// owner's place, so this adds the owner the cases of whatever reads the export
// table (walk.id, loc.id) need.

vocab_export_row() {
  regrow_e();
  push((import eowners), "f");
} return void;
():() then len((import eowners)):(1)
():() then (import enames)[0]:("g")

vocab_world() {
  vocab_export_row();
  fn_fixture_build();
  edge_loc(7);
} chain () {
  edge_fixture_caller();
  vocab_words();
} return void;
():() then len((import prog)):(2)
():() then len((import dvname)):(1)

// The export table with one conf.id constant of the given name in it: the
// owner the parser gives a constant (reg_const) is "conf.id", not a function,
// and the scan must judge it like any other export.
vocab_const_row(string vocab_const_name) {
  vocab_export_row();
  list_string_delete((import enames), 0);
  push((import enames), vocab_const_name);
} chain (string vocab_const_name) {
  list_string_delete((import eowners), 0);
  push((import eowners), "conf.id");
  vocab_words();
} return void;
("bt_min"):("bt_min") then (import enames)[0]:("bt_min")
("buffer_width"):("buffer_width") then (import eowners)[0]:("conf.id")
