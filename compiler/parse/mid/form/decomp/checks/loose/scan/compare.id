// Comparing the loose fingerprints, mirroring mid/form/unique/scan/compare.id's
// uq_scan/uq_at: each function against every earlier one, reported against
// the first match. ./more/probe.id excludes a pair the strict duplicate-logic
// rule (mid/form/unique/) already rejects as an error -- this warns about the
// gap that rule leaves, not about what it already covers.

lz_scan() {
  int i = 0;
  while(i < len((import cfp2))) {
    lz_at(i);
    i = i + 1;
  }
} return void;
given lz_p ():() then calls lz_at:(0) then calls lz_at:(1)
given lz_empty ():() then calls lz_at:[0]

lz_at(int i) {
  int j = lz_find(i);
  if(j >= 0) {
    lz_report(i, j);
  }
} return void;
given lz_p (1):() then calls lz_report:(1, 0)
given lz_p (0):() then calls lz_report:[0]

// prog = [dup5, dup9] (index 1: dup9), and the real strict fingerprint pass
// over it: dup5/dup9's strict fps differ (they keep the literal's value).
lz_o() {
  lz_n();
  push((import prog), (import lz_fn9));
  uq_fill();
} return void;
():() then check_failed:(0)
():() then init_units:(0)
