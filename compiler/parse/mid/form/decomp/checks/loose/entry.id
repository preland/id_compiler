check_loose_dup() {
  lz_fill();
  lz_scan();
} return void;

// [0] and [1] are int literal nodes with different values -- enough to show
// lz_expr (canon/expr/expr.id) fingerprints a literal by its kind alone.
lz_fixture() {
  env_init();
  lz_build();
} return void;
():() then check_failed:(0)
():() then init_units:(0)

lz_build() {
  export int lz_id_a = node_int("5", 5, 0);
  export int lz_id_b = node_int("99", 99, 0);
} return void;
