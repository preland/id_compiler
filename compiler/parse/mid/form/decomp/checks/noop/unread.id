// E0410: a local that is declared and never read afterwards. Everything a
// function reads sits between its declaration and the function's own node: the
// condition of an `if`, an argument, the right side of an assignment and the
// return clause are all made before the function node is. A name that appears as
// a `var` node nowhere in that stretch is read nowhere. An assignment to the name
// (`x = f(y)`) counts as a use too: it is how a call's result is taken and
// ignored, and the call is the point. An exported local is read by other
// functions as `(import NAME)`, so it is never reported.

noop_unread(int nzx_decl) {
  string nzx_name = (import ns2)[nzx_decl];
  int nzx_owner = noop_owner(nzx_decl);
  int nzx_left = noop_reads(nzx_name, nzx_decl + 1, nzx_owner);
} chain (int nzx_decl) {
  if(noop_dead(nzx_decl, nzx_owner, nzx_left) == 1) {
    noop_unread_report(nzx_decl, nzx_owner);
  }
} return void;
