// Whether two terms of a flattened sum (./cancel.id) cancel: one is added, the
// other subtracted, and they are the same expression. Rows of the comparison are
// one function and the cells of a row another, so each stays a single loop.

noop_pair(int[] nzp_terms, int[] nzp_signs) {
  int nzp_i = 0;
  int nzp_hit = 0;
  while(nzp_i < len(nzp_terms) && nzp_hit == 0) {
    nzp_hit = noop_row(nzp_terms, nzp_signs, nzp_i);
    nzp_i = nzp_i + 1;
  }
} return int nzp_hit;
given noop_world ([(import wx_va), (import wx_vb), (import wx_vb)], [1, 1, -1]):(1)
given noop_world ([(import wx_va), (import wx_vb), (import wx_vb)], [1, 1, 1]):(0)
given noop_world ([], []):(0)

noop_row(int[] nzw_terms, int[] nzw_signs, int nzw_i) {
  int nzw_j = nzw_i + 1;
  int nzw_hit = 0;
  while(nzw_j < len(nzw_terms) && nzw_hit == 0) {
    nzw_hit = noop_opposite(nzw_terms, nzw_signs, nzw_i, nzw_j);
    nzw_j = nzw_j + 1;
  }
} return int nzw_hit;
given noop_world ([(import wx_va), (import wx_vb), (import wx_vb)], [1, 1, -1], 1):(1)
given noop_world ([(import wx_va), (import wx_vb), (import wx_vb)], [1, 1, -1], 0):(0)
given noop_world ([(import wx_va), (import wx_vb), (import wx_vb)], [1, 1, -1], 2):(0)

noop_opposite(int[] nzd_terms, int[] nzd_signs, int nzd_i, int nzd_j) {
  int nzd_hit = 0;
  if(nzd_signs[nzd_i] + nzd_signs[nzd_j] == 0) {
    nzd_hit = noop_same(nzd_terms[nzd_i], nzd_terms[nzd_j]);
  }
} return int nzd_hit;
given noop_world ([(import wx_va), (import wx_vb), (import wx_vb)], [1, 1, -1], 1, 2):(1)
given noop_world ([(import wx_va), (import wx_vb), (import wx_vb)], [1, 1, 1], 1, 2):(0)
given noop_world ([(import wx_va), (import wx_vb), (import wx_vb)], [1, 1, -1], 0, 2):(0)
