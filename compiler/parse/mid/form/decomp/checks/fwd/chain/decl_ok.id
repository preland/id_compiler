// A void return (`retvar` -1) is checked first, on its own: `id`'s `&&` does
// not short-circuit, so folding this into one big condition with the reads
// below it would read node -1 whenever a forwarder candidate returns void.
fwd_decl_ok2(int retvar, int callid, int stmt) {
  int ok = 0;
  if(retvar >= 0) {
    ok = fwd_decl_ok3(retvar, callid, stmt);
  }
} return int ok;
given farm_d (3, 2, 4):(1)
given farm_d (-1, 2, 4):(0)

fwd_decl_ok3(int retvar, int callid, int stmt) {
  int ok = 0;
  if(k_of(retvar) == "var" && s1_of(retvar) == s2_of(stmt) && k_of(callid) == "call") {
    ok = 1;
  }
} return int ok;
given farm_d (3, 2, 4):(1)
given farm_d (1, 2, 4):(0)

