// The void forwarder shape (return void, the call left unused): unlike a
// non-void forwarder, no local to check -- just that the statement's own
// expression is a call.
fwd_expr_ok(int fid, int stmt) {
  int callid = (import ni1)[stmt];
  int ok = 0;
  if((import ni1)[fid] == 0 - 1 && (import nkind)[callid] == "call") {
    ok = 1;
  }
} return int ok;
given farm_i {
  (10, 9):(1)
  (6, 9):(0)
}

fwd_verify(int i, int fid, int callid) {
  string callee_name = (import ns1)[callid];
  int ok = fwd_ok(fid, callid, callee_name);
  fwd_verify_tail(i, callee_name, ok);
} return void;
given farm_k {
  (0, 6, 2):() then calls fwd_report:(0, "target")
  (0, 12, 2):() then calls fwd_ok:(12, 2, "target")
  (0, 12, 2):() then calls fwd_report:[0]
}

fwd_verify_tail(int i, string callee_name, int ok) {
  if(ok == 1) {
    fwd_report(i, callee_name);
  }
} return void;
given farm_i {
  (0, "target", 1):() then calls fwd_report:(0, "target")
  (0, "other", 1):() then calls fwd_report:(0, "other")
  (0, "target", 0):() then calls fwd_report:[0]
}
