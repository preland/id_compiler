// file:line: error: function 'F' only forwards to 'G' [E0406], with the rule's
// why and, as the help, the deletion and the call sites to rewrite
// (docs/ERRORS.md). It calls diag, so the build fails: the fix is always
// available, and a build that keeps the forwarder keeps a name that adds nothing.
fwd_report(int i, string callee_name) {
  string fwd_m = fwd_msg(i, callee_name);
  string fwd_h = fwd_help(i, callee_name);
  string fwd_loc = diag_prog_loc(i);
} chain (int i, string callee_name) {
  diag("E0406", fwd_loc, fwd_m, (import ns1)[((import prog)[i])], (import fwdd_why), fwd_h);
} return void;
