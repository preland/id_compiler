// The env every fwd/ (../../fwd/) case fixture builds on: env_init, the
// symbol index (fn_node_of needs it), and a reusable typed empty list (an
// inline `[]` argument has no type to infer here).
fwd_env() {
  env_init();
  init_idx();
  export int[] f_none = [];
} return void;
():() then check_failed:(0)
():() then init_units:(0)

// param "a":int and the var "a" that reads it -- id 0 and 1 of every fwd/
// case fixture below.
farm_a() {
  fwd_env();
  export int f_pa = node_param("param", "int", "a");
  export int f_argv = node_var("a");
} return void;
():() then check_failed:(0)
():() then init_units:(0)

strip_idstd_prefix(string name) {
  int nlen = len(name);
  string ret_s = name;
  if(nlen > 6 && slice(name, 0, 6) == "idstd_") {
    ret_s = slice(name, 6, nlen);
  }
} return string ret_s;
("idstd_v"):("v")
("idstd_ret_i"):("ret_i")
("idstd_str_slice_v"):("str_slice_v")
("v"):("v")
("asset_at_v"):("asset_at_v")
