// The `--fix` convention (../more/match.id) or the `ret_i`/`ret_s` return-value
// style (../more/retstyle.id) this compiler's own source uses throughout.
// Before checking, strip a leading idstd_ prefix (stdlib names all start with
// idstd_, so idstd_v is not generated; after stripping to v, it clearly is not).
is_genparam(string name) {
  int ok = 0;
  string check = strip_idstd_prefix(name);
  if(ends_v(check) == 1 || is_retstyle(check) == 1) {
    ok = 1;
  }
} return int ok;
