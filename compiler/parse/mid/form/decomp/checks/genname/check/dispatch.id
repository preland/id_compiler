// One parameter: read its name, decide, report.

genname_check(int i, int[] params, int pk) {
  int pid = params[pk];
  genname_param(i, pid);
} return void;
given gn_env (0, (import f_pgen_list), 0):() then calls genname_report:(0, "ret_i")
given gn_env (0, [11], 0):() then calls genname_report:[0]

genname_param(int i, int pid) {
  string name = s2_of(pid);
  if(is_genparam(name) == 1) {
    genname_report(i, name);
  }
} return void;
