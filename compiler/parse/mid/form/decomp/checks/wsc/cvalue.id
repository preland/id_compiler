// Whether a case reads a function as a value -- `bind(f, 3)` in an argument or an
// expected value, or in a `then` check. The fingerprint pass that finds the uses
// in function bodies (fwd_used_as_value) does not see cases, and a function a
// case passes around cannot be replaced by its expression. The walk follows
// each expression from its root: a flat scan of the nodes would also find the
// `var` node the parser builds and discards for every call's callee.

wsc_cvalue(string wcv_name) {
  int wcv_r = 0;
  int wcv_i = 0;
  while(wcv_i < len((import casenode))) {
    wcv_r = wcv_r + wsc_case_refs(wcv_name, (import casenode)[wcv_i]);
    wcv_i = wcv_i + 1;
  }
} chain (string wcv_name) {
  wcv_i = 0;
  while(wcv_i < len((import thennode))) {
    wcv_r = wcv_r + wsc_refs_list(wcv_name, (import nl1)[((import thennode)[wcv_i])]);
    wcv_i = wcv_i + 1;
  }
} return int wcv_r;
given wsc_marks ("wsget"):(1)
given wsc_marks ("wsnest"):(2)
given wsc_marks ("wsput"):(0)

wsc_case_refs(string wcc_name, int wcc_c) {
  int wcc_a = wsc_refs_list(wcc_name, (import nl1)[wcc_c]);
  int wcc_e = wsc_refs_list(wcc_name, (import nl2)[wcc_c]);
  int wcc_r = wcc_a + wcc_e;
} return int wcc_r;
given wsc_marks ("wsget", (import wx_case)):(1)
given wsc_marks ("wsput", (import wx_case)):(0)

wsc_refs_list(string wrl_name, int[] wrl_l) {
  int wrl_r = 0;
  int wrl_i = 0;
  while(wrl_i < len(wrl_l)) {
    wrl_r = wrl_r + wsc_refs(wrl_name, wrl_l[wrl_i]);
    wrl_i = wrl_i + 1;
  }
} return int wrl_r;
given wsc_marks ("wsget", (import wx_cargs)):(1)
given wsc_marks ("wsput", (import wx_cargs)):(0)
