// One statement of a body that can be part of a single expression: a
// declaration with an initialiser that is not exported and is not a bare
// variable. `word aw = a;` is a conversion -- the declared type is the point of
// it, as in a shift or a product computed in 64 bits from two ints -- and
// writing `a` where `aw` was used would compute something else.

wsc_decl(int wdc_s) {
  int wdc_ok = 0;
  if((import nkind)[wdc_s] == "decl" && (import ni2)[wdc_s] != 1 && (import ni1)[wdc_s] >= 0) {
    wdc_ok = wsc_plain((import ni1)[wdc_s]);
  }
} return int wdc_ok;
