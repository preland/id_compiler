// Whether a case somewhere uses the function as a setup (`given NAME`) or as a
// check (`then NAME:(VALUE)`): such a function is a test fixture, and replacing
// it with its expression is a different edit from replacing a function of the
// program. `then calls NAME` is not a use: it names a call the code under test
// makes.

wsc_used(string wus_name) {
  int wus_g = wsc_given(wus_name);
  int wus_t = wsc_then(wus_name);
  int wus_r = (wus_g + wus_t) > 0;
} return int wus_r;
given wsc_marks {
  ("wsget"):(1)
  ("wsadd"):(1)
  ("wsdead"):(0)
}

wsc_given(string wgv_name) {
  int wgv_i = 0;
  int wgv_r = 0;
  while(wgv_i < len((import casegiven))) {
    string[] wgv_set = string_split((import casegiven)[wgv_i], " ");
    if(find_str(wgv_set, wgv_name) >= 0) {
      wgv_r = 1;
    }
    wgv_i = wgv_i + 1;
  }
} return int wgv_r;
given wsc_marks {
  ("wsget"):(1)
  ("wsput"):(0)
}

wsc_then(string wth_name) {
  int wth_i = 0;
  int wth_r = 0;
  while(wth_i < len((import thennode))) {
    if((import nkind)[((import thennode)[wth_i])] == "then" && (import ns1)[((import thennode)[wth_i])] == wth_name) {
      wth_r = 1;
    }
    wth_i = wth_i + 1;
  }
} return int wth_r;
given wsc_marks {
  ("wsadd"):(1)
  ("wsdead"):(0)
}
