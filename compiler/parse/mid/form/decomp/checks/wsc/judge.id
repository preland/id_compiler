// The two further questions of a hit, asked only of a function whose shape
// already fits, because the fixture question (./fixture.id) walks every node of
// the program.

wsc_judge(int wju_f) {
  if(wsc_hit(wju_f, 1, 0) == 1) {
    wsc_late(wju_f);
  }
} return void;
