wsc_caller_ok(int wco_f, int wco_g, int wco_d) {
  int wco_ok = 0;
  if(wco_g == wco_f) {
    wco_ok = 1;
  } else if(wco_g >= 0) {
    wco_ok = wsc_fixture(wco_g, wco_d - 1);
  }
} return int wco_ok;
