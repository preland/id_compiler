// Whether a function is a hit. The weight (./ops.id) must have reached every
// local the function declares, once each -- a local that is unused is work that
// is no part of the expression, and one used twice is not a substitution -- and
// have between 1 and N operations. A literal in the expression disqualifies it
// unless `lit_ok` is 1: E0408 wants operands that are parameters and imports
// only, a literal being a value that deserves a name; E0407's help asks the
// question with literals allowed, since the literals are what its functions
// differ in.

wsc_hit(int wht_f, int wht_n, int wht_lit) {
  int wht_root = wsc_root(wht_f);
  int wht_ok = 0;
  if(wht_root >= 0) {
    wht_ok = wsc_fit(wht_f, wht_root, wht_n, wht_lit);
  }
} return int wht_ok;
given wsc_world {
  ((import wx_fget), 1, 0):(1)
  ((import wx_fadd), 1, 1):(0)
  ((import wx_fadd), 2, 1):(1)
  ((import wx_fadd), 2, 0):(0)
  ((import wx_fif), 2, 0):(0)
}

wsc_fit(int wft_f, int wft_root, int wft_n, int wft_lit) {
  int wft_w = wsc_ops(wft_f, wft_root);
  int wft_ops = wft_w % 1000;
  int wft_ok = 0;
} chain (int wft_f, int wft_root, int wft_n, int wft_lit) {
  if((wft_w / 1000) % 1000 == wsc_want(wft_f) && wft_ops >= 1 && wft_ops <= wft_n && (wft_lit == 1 || wft_w / 1000000 == 0)) {
    wft_ok = 1;
  }
} return int wft_ok;
given wsc_world ((import wx_fget), (import wx_rv), 1, 0):(1)
given wsc_world ((import wx_fget), (import wx_rv), 0, 0):(0)
given wsc_world ((import wx_fdead), (import wx_vw), 1, 0):(0)
given wsc_world ((import wx_fput), (import wx_foo), 1, 0):(1)
given wsc_pair ((import wx_fa), (import wx_vr), 1, 0):(0)
given wsc_pair ((import wx_fa), (import wx_vr), 1, 1):(1)

wsc_want(int wwn_f) {
  int wwn_n = 0;
  if((import ni1)[wwn_f] >= 0) {
    wwn_n = len((import nl2)[wwn_f]);
  }
} return int wwn_n;
given wsc_world {
  ((import wx_fadd)):(2)
  ((import wx_fput)):(0)
}
