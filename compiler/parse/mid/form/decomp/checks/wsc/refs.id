// The reads of one name as a variable (or, in a case, as a "cfn" function value) in the expression tree under a node.
// Only the node kinds that have children are followed: an operator and an index
// through their operands, a call and a list literal through their lists.

wsc_refs(string wrf_name, int wrf_e) {
  string wrf_k = (import nkind)[wrf_e];
  int wrf_r = wsc_refs_list(wrf_name, (import nl1)[wrf_e]);
  if((wrf_k == "var" || wrf_k == "cfn") && (import ns1)[wrf_e] == wrf_name) {
    wrf_r = 1;
  }
} chain (string wrf_name, int wrf_e) {
  if(wrf_k == "bin" || wrf_k == "index") {
    wrf_r = wsc_refs(wrf_name, (import ni1)[wrf_e]) + wsc_refs(wrf_name, (import ni2)[wrf_e]);
  }
  if(wrf_k == "un") {
    wrf_r = wsc_refs(wrf_name, (import ni1)[wrf_e]);
  }
} return int wrf_r;
given wsc_marks {
  ("wsget", (import wx_bindcall)):(1)
  ("wsput", (import wx_bindcall)):(0)
  ("a", (import wx_sum)):(1)
  ("a", (import wx_neg)):(1)
  ("b", (import wx_neg)):(0)
}
