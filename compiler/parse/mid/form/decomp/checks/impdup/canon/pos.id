// An import in a fingerprint is the position at which the function first read
// it, like a local (cn, ../../../../unique/canon/func/names.id), and the names
// go in a separate list, `cimps`, that seg_text (./text.id) puts in front of
// each function's text. Two functions are one function written twice only if
// both the text and the names agree; a pair that agrees on the text alone
// differs only in which imports it reads (../scan/). No function is exempt, however short: a
// one-statement accessor per global is the same function written once per
// global, and the fix is the same parameter.

imp_fp(int imp_id) {
  string imp_name = (import ns1)[imp_id];
  int imp_at = imp_pos(imp_name);
  string ret_s = "g(" + imp_at + ")";
} return string ret_s;
given lz_c ((import lz_imp)):("g(0)")
given imp_seed_fixture ((import lz_imp)):("g(1)")

imp_pos(string imp_key) {
  string[] imp_seen = (import cimps);
  int imp_idx = find_str(imp_seen, imp_key);
  if(imp_idx < 0) {
    push(imp_seen, imp_key);
    imp_idx = len(imp_seen) - 1;
  }
} return int imp_idx;
given lz_c ("cfg"):(0)
given imp_seed_fixture ("cfg"):(1)

imp_vec() {
  string ret_s = str_join((import cimps), ",");
} return string ret_s;
given imp_seed_fixture ():("first")
given lz_c ():("")
