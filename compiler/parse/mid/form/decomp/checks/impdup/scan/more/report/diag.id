// prog = [tha, thb]: each returns a different import and has no statements,
// so each is a named accessor, and check_imp_dup reports the pair like any other.
imd_thin_base() {
  env_init();
  int[] imd_none = [];
  int imd_e1 = node_import("alpha");
} chain () {
  int imd_f1 = node_func("tha", "int", imd_none, imd_none, imd_e1);
  push((import prog), imd_f1);
  int imd_e2 = node_import("beta");
} chain () {
  int imd_f2 = node_func("thb", "int", imd_none, imd_none, imd_e2);
  push((import prog), imd_f2);
  uq_fill();
} return void;
