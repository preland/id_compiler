// file:line: error: function 'F' and 'G' differ only in the imported value
// they read -- an error, unlike the decomposition warnings: it calls
// note_failure, because the fix (a parameter) is always available and a
// build that keeps both is writing one function twice.

imd_report(int imd_x, int imd_y) {
  note_failure();
  string imd_nx = imd_name(imd_x);
  string imd_ny = imd_name(imd_y);
} chain (int imd_x, int imd_y) {
  string imd_vs = imd_vals(imd_x, imd_y);
  string imd_line = imd_msg(imd_nx, imd_ny, imd_vs);
  print(imd_line);
} return void;
