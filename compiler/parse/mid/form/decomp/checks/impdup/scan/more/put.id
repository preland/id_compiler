// Cutting a segment's fingerprint (canon/text.id) into its import names and
// its text, and filing both under function slot `imd_at`.

imd_set(string[] imd_out, int imd_slot, string imd_fp) {
  string imd_txt = imd_text(imd_fp);
  imd_out[imd_slot] = imd_out[imd_slot] + len(imd_txt) + ":" + imd_txt;
  imd_out[imd_slot + 1] = imd_head(imd_fp);
} return void;
(["", ""], 0, "a|X"):(["1:X", "a"])
(["p", "q", "", ""], 2, "|YY"):(["p", "q", "2:YY", ""])

imd_head(string imd_fp) {
  int imd_bar = str_find(imd_fp, "|");
  string ret_s = str_sub(imd_fp, 0, imd_bar);
} return string ret_s;
("a,b|x{}"):("a,b")
("|y"):("")

imd_text(string imd_fp) {
  int imd_bar = str_find(imd_fp, "|");
  int imd_rest = len(imd_fp) - imd_bar - 1;
  string ret_s = str_sub(imd_fp, imd_bar + 1, imd_rest);
} return string ret_s;
("a,b|x{}"):("x{}")
("|y"):("y")
