given imd_pair_base given imd_fill ():() then (import chkfail)[0]:(1)

imd_at(int imd_x) {
  int imd_y = imd_find(imd_x);
  if(imd_y >= 0) {
    imd_report(imd_x, imd_y);
  }
} return void;
given imd_pair_base given imd_fill (1):() then (import chkfail)[0]:(1)
given imd_pair_base given imd_fill (0):() then (import chkfail)[0]:(0)

imd_find(int imd_x) {
  int imd_y = 0;
  int imd_found = 0 - 1;
  while(imd_y < imd_x && imd_found < 0) {
    imd_found = imd_probe(imd_x, imd_y);
    imd_y = imd_y + 1;
  }
} return int imd_found;
