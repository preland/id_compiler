// Each function against every earlier one, reported against the first match,
// the pairing mid/form/unique/scan/pass/compare.id uses for the strict rule.

imd_scan() {
  int imd_i = 0;
  while(imd_i < len((import prog))) {
    imd_at(imd_i);
    imd_i = imd_i + 1;
  }
} return void;
