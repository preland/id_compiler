// One name out of the listing. Names are separated by a newline and the last
// one has a newline after it, so there is no empty name to guard against and
// the loop lands exactly on len(buf).

drv_one(string path, int[] buf, int at) {
  int end = drv_eol(buf, at);
  drv_entry(path, buf, at, end);
  int ret_i = end + 1;
} return int ret_i;
("p", [97, 46, 105, 100, 10], 0):(5) then prints:("p/a.id\n")
("p", [46, 103, 105, 116, 47, 10], 0):(6) then prints:("")

drv_eol(int[] buf, int at) {
  while(at < len(buf) && buf[at] != 10) {
    at = at + 1;
  }
} return int at;
([104, 105, 10, 120], 0):(2)
([104, 105], 0):(2)

// A name ending in '/' is a directory; that is how fs_list says so, and the
// slash is dropped here rather than carried into the path.
drv_entry(string path, int[] buf, int lo, int hi) {
  if(buf[hi - 1] == 47) {
    drv_sub(path, buf, lo, hi - 1);
  } else {
    drv_file(path, buf, lo, hi);
  }
} return void;
("p", [46, 103, 105, 116, 47], 0, 5):() then prints:("")
("p", [97, 46, 105, 100], 0, 4):() then prints:("p/a.id\n")
