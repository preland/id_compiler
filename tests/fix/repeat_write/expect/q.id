combine(int a, int b) {
  int s = a * 2 + b;
} return int s;

// cur_next writes into the exported cursor, so the two calls must never
// share one name or one evaluation, however identical their text. `deep` is a
// second, single violation beside it.
use1() {
  int combine_v = combine(cur_next(), 1);
  int combine_v2 = combine(cur_next(), 1);
  int r = combine(combine_v, combine_v2);
} return int r;

deep() {
  int combine_v = combine(cur_next(), 1);
  int d = combine(combine_v, 2);
} return int d;
