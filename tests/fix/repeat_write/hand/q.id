combine(int a, int b) {
  int s = a * 2 + b;
} return int s;

use1() {
  int combine_v = combine(cur_next(), 1);
  int combine_v2 = combine(cur_next(), 1);
  int r = combine(combine_v, combine_v2);
} return int r;

deep() {
  int combine_v = combine(cur_next(), 1);
  int d = combine(combine_v, 2);
} return int d;
