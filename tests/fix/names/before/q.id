// twice_v is a string in this unit, so the repair cannot use it for an int;
// twice_v3 is already declared in this function.
go(int[] c) {
  int twice_v3 = 3;
  int x = twice(twice(bump(c))) + twice_v3;
} return int x;

// twice_v2 is a function, so it is not free either.
twice_v2(int k) {
  int j = k + 1;
} return int j;

run(int[] c) {
  print(twice(twice(bump(c))));
} return void;
