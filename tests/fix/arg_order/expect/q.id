pair(int a, int b) {
  int s = a + b;
} return int s;

// The first argument is a whole non-call expression with a call inside it;
// the second is a call on its own. step must still run before mark.
use1(int[] c, int x) {
  int pair_a0 = step(c) + 1;
  int mark_v = mark(x);
  int r = pair(pair_a0, mark_v);
} return int r;
