pair(int a, int b) {
  int s = a + b;
} return int s;

// The first argument is a whole non-call expression with a call inside it,
// legal on its own; the second is a call with a call inside it, which is the
// violation. step must still run before mark, so --fix names step(c) as well,
// ahead of the repair it was asked for.
use1(int[] c, int x) {
  int r = pair(step(c) + 1, mark(mark(x)));
} return int r;

deep(int x) {
  int d = pair(mark(mark(x)), 1);
} return int d;
