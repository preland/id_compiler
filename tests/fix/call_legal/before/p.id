// One level of call nesting inside a call's argument is legal, so --fix has
// nothing to repair here and must not touch the line.
pick(int x) {
  int y = x + 1;
} return int y;
(1):(2)
(2):(3)

pair(int a, int b) {
  int s = a * 2 + b;
} return int s;
(1, 2):(4)
(2, 2):(6)

show(int x) {
  int r = pair(x, pick(x) + 1);
} return int r;
(1):(5)
(2):(8)
