// inf_pow2 writes nothing, so two identical calls share one name and one
// evaluation instead of running twice. `deep` is a second, single violation
// beside it.
use1(int log) {
  int inf_pow2_v = inf_pow2(inf_pow2(log));
  int r = combine(inf_pow2_v, inf_pow2_v);
} return int r;

deep(int log) {
  int inf_pow2_v = inf_pow2(inf_pow2(log));
  int d = combine(inf_pow2_v, 1);
} return int d;
