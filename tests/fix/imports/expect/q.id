setat(int[] xs, int i, int v) {
  xs[i] = v;
} return void;

// bump cannot run tab_init, so the import is read where it stands.
keep(int[] c) {
  int bump_v = bump(c);
  int twice_v = twice(bump_v);
  setat((import tab), 0, twice_v);
} return void;

// again runs tab_init, so the list is read ahead of it, as it was.
move(int[] c) {
  int[] tab_v = (import tab);
  int again_v = again(c);
  int twice_v = twice(again_v);
  setat(tab_v, 1, twice_v);
} return void;
