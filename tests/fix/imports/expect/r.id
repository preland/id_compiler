again(int[] c) {
  tab_init();
  int n = bump(c);
} return int n;

// An index read can trap, and a call can change the list it reads, so it is
// read ahead of the calls that follow it.
guard(int[] c, int[] xs) {
  int xs_v = xs[c[0]];
  int bump_v = bump(c);
  int twice_v = twice(bump_v);
  print(xs_v + twice_v);
} return void;
