again(int[] c) {
  tab_init();
  int n = bump(c);
} return int n;

// bump cannot run tab_init and touches no export, so xs[c[0]] is read where
// it stands -- only the call nested in twice's argument has to move.
guard(int[] c, int[] xs) {
  int bump_v = bump(c);
  int print_a0 = xs[c[0]] + twice(bump_v);
  print(print_a0);
} return void;
