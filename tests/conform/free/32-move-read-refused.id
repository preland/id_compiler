// The moved name is read after the push, so the list must not free it: row
// still reaches the block. A free here would be caught by ID_FREE_GUARD as a
// use of a freed list.
build(int n) {
  int[][] rows = [];
  int[] row = [n, n + 1];
  push(rows, row);
} chain (int n) {
  int t = len(rows) + row[1];
} return int t;

main(int argc, string[] argv) {
  int a = build(3);
  print(a);
} return int 0;
