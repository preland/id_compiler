// A linked list of 10000 cells, each holding a list of at most one successor (built by recursion: the wasm build links an 8 MiB stack, and wasmtime's own call-stack limit is what stops a much longer chain there).
// Freeing it with idfr_Cell must not recurse once per cell, or the C stack would
// not hold it (and a wasm stack even less): the runtime walks a work list of
// its own. Freed: a struct and a list of successors per cell, 20000 lists.
build(int n) {
  Cell[] nx = [];
  if(n > 1) {
    push(nx, build(n - 1));
  }
  Cell c = Cell(nx, n);
} return Cell c;

total(Cell c) {
  Cell[] nx = c.next;
  int s = c.v;
  if(len(nx) > 0) {
    s = s + nx[0].v;
  }
} return int s;
