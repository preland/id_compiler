merge(int[] a, int[] b, int[] out) {
  int i = 0;
  int j = 0;
  int k = 0;
} chain (int[] a, int[] b, int[] out) {
  while(i < len(a) && j < len(b)) {
    if(b[j] < a[i]) {
      out[k] = b[j];
      j = j + 1;
    } else {
      out[k] = a[i];
      i = i + 1;
    }
    k = k + 1;
  }
  while(i < len(a)) {
    out[k] = a[i];
    i = i + 1;
    k = k + 1;
  }
  while(j < len(b)) {
    out[k] = b[j];
    j = j + 1;
    k = k + 1;
  }
} return void;

show(int[] xs) {
  string s = "";
  int i = 0;
  while(i < len(xs)) {
    s = s + xs[i] + " ";
    i = i + 1;
  }
} chain (int[] xs) {
  print(s);
} return void;

main(int argc, string[] argv) {
  int[] a = [1, 4, 6];
  int[] b = [2, 3, 9, 10];
  int[] out = [0, 0, 0, 0, 0, 0, 0];
} chain (int argc, string[] argv) {
  merge(a, b, out);
  show(out);
  int[] small = [0, 0, 0, 0, 0, 0];
} chain (int argc, string[] argv) {
  merge(a, b, small);
  print("unreachable");
} return int 0;
