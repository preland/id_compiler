reach(int[] xs, int n) {
  int s = 0;
  int j = 0;
  int c = 0;
} chain (int[] xs, int n) {
  while(j < n) {
    s = s + xs[j + c];
    c = c + 5;
    j = j + 1;
  }
} return int s;

main(int argc, string[] argv) {
  int[] xs = [1, 2, 3, 4, 5, 6, 7, 8];
  print("" + reach(xs, 2));
  int t = reach(xs, 3);
} chain (int argc, string[] argv) {
  print("unreachable " + t);
} return int 0;
