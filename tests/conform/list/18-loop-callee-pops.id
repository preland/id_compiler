shrink(int[] xs) {
  pop(xs);
  pop(xs);
} return void;

drain(int[] xs, int n) {
  int j = 0;
  while(j < n) {
    print("" + j + " " + xs[j]);
    shrink(xs);
    j = j + 1;
  }
} return void;

main(int argc, string[] argv) {
  int[] xs = [5, 6, 7, 8];
  drain(xs, 4);
  print("unreachable");
} return int 0;
