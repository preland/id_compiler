pick(int[] xs, int n) {
  int s = 0;
  int j = 0;
  while(j < n) {
    s = s + xs[j * 3 + 1];
    print("" + j + " " + s);
    j = j + 1;
  }
} return int s;

main(int argc, string[] argv) {
  int[] xs = [10, 11, 12, 13, 14, 15, 16];
  int t = pick(xs, 3);
  print("unreachable " + t);
} return int 0;
