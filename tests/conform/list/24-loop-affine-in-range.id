gather(int[] xs, int n, int w, int c) {
  int s = 0;
  int j = 0;
  while(j < n) {
    s = s + xs[j * w + c];
    j = j + 1;
  }
} return int s;

spread(int[] out, int n) {
  int j = 0;
  while(j < n) {
    out[2 * j + 1] = j + 1;
    j = j + 1;
  }
} return void;

main(int argc, string[] argv) {
  int[] xs = [1, 2, 3, 4, 5, 6, 7, 8];
  print("" + gather(xs, 3, 3, 1));
  print("" + gather(xs, 4, 0 - 1, 5));
} chain (int argc, string[] argv) {
  int[] o = [0, 0, 0, 0, 0, 0];
  spread(o, 3);
  print("" + o[1] + " " + o[3] + " " + o[5]);
} chain (int argc, string[] argv) {
  print("" + gather(xs, 3, 3, 2));
} return int 0;
