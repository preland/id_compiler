heap_ones(word p, int n) {
  int[] xs = [0];
  while(len(xs) < n) {
    push(xs, len(xs));
  }
  check(p, alloc(16), len(xs));
} return void;

check(word p, word q, int n) {
  poke64(p, 123456789);
  poke64(q, n);
  print("" + peek64(p) + " " + peek64(q));
} return void;

main(int argc, string[] argv) {
  word p = alloc(16);
  heap_ones(p, 1200000);
} return int 0;
