main() {
  word neg = (0 - 1);
  show_signed(neg);
} return int 0;

show_signed(word neg) {
  string a = "" + (neg / 2) + " " + udiv(neg, 2);
  string b = "" + ult(neg, 2) + " " + (neg < 2);
  show_shift(neg, a + " " + b);
} return void;

show_shift(word neg, string head) {
  string t = "" + (neg >> 1) + " " + ushr(neg, 1);
  print(head + " " + t);
} return void;
