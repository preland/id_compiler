// The closure a bind makes on every pass is a local assigned only from bind and
// never kept, so id_clo_free gives it back with the copy of the list it
// captured: one freed list per pass. What stays allocated is argv and the list
// literal handed to spin, which main does not own.
pick_at(int[] xs, int i) {
  int r = xs[i];
} return int r;

spin(int[] xs, int n) {
  int t = 0;
  int i = 0;
  while(i < n) {
    func(int) return int f = bind(pick_at, xs);
    t = t + f(1);
    i = i + 1;
  }
} return int t;

main(int argc, string[] argv) {
  int r = spin([3, 4], 5);
  print(r);
} return int 0;
