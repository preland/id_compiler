// Rows built in a loop body and moved into a list of lists are given back with
// it: each pass allocates one row and the list frees all of them, so allocated
// minus freed does not grow with N.
build(int n) {
  int[][] rows = [];
  int i = 0;
  while(i < n) {
    int[] row = [i, i];
    push(rows, row);
    i = i + 1;
  }
} chain (int n) {
  int t = len(rows) + rows[0][1];
} return int t;

main(int argc, string[] argv) {
  int r = build(50);
  print(r);
} return int 0;
