// an early return from inside a loop inside an if: the first even value, or
// -1 when there is none; and a void function that returns before printing.
first_even(int[] xs) {
  int i = 0;
  int none = 0 - 1;
  while(i < len(xs)) {
    if(xs[i] % 2 == 0) {
      int found = xs[i];
      return found;
    }
    i = i + 1;
  }
} return int none;

say_if_positive(int x) {
  if(x <= 0) {
    return;
  }
  print("positive " + x);
} return void;

main(int argc, string[] argv) {
  int e1 = first_even([3, 7, 8, 10]);
  int e2 = first_even([1, 3]);
  print("" + e1 + " " + e2);
} chain (int argc, string[] argv) {
  say_if_positive(0 - 4);
  say_if_positive(5);
} return int 0;
