lsn(string lpath) {
  string[] lnames = exec_ls(lpath);
  int lcount = len(lnames) + 0;
} return int lcount;
("/nonexistent/x"):(1)
("/nonexistent/y"):(1)

scratch(string sbody) {
  string sdir = fs_mktemp("idwd", 1);
  int sdrop = fs_drop_exit(sdir);
  int sput = exec_file_put(sdir + "/f.txt", sbody, 420);
} chain (string sbody) {
  string[] sls = exec_ls(sdir);
} return string[] sls;
("a"):(["f.txt", ""])
("bb"):(["f.txt", ""])

lsof(string opath) {
  string[] oe = exec_ls(opath);
} return string[] oe;
("/nonexistent/x"):([""])
("/nonexistent/y"):([""])
