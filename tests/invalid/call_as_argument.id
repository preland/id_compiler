// EXPECT: argument 0 of 'sq' has a call nested inside a call; an argument may hold one level of call, not two -- name the inner call's result and pass the name
// IDCPY-ACCEPTS
dbl(int a) {
  int r = a + a;
} return int r;

sq(int a) {
  int r = a * a;
} return int r;

main(int argc, string[] argv) {
  int v = sq(dbl(dbl(3)));
  print(v);
} return int 0;
