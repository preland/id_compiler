// EXPECT: same signature and logic
// A chain function is one unit for duplicate checking: two chain functions that
// agree in the signature and in every segment, in order, are one function
// written twice, whatever they call their locals. (Agreeing in only some
// segments is not a duplicate: tests_feature.sh accepts that.)
inc_pair(int x) {
  int a = x + 1;
  int b = a * 2;
  int c = b - 3;
} chain (int x) {
  int r = c + a;
} return int r;

bump_pair(int y) {
  int p = y + 1;
  int q = p * 2;
  int s = q - 3;
} chain (int y) {
  int t = s + p;
} return int t;

main(int argc, string[] argv) {
  int u = inc_pair(1) + bump_pair(2);
} return int 0;
