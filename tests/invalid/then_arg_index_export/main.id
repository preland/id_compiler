// EXPECT: the index of an indexed export in a check is a literal or a conf.id constant, and (import cnt)[0] is neither; write the index as a literal
mk() {
  export int[] cnt = [0, 5];
} return void;

pick(int v) {
  int w = v + 1;
} return int w;
(1):(2)
(2):(3)

wrap(int k) {
  int a = k * 3;
} return int a;
given mk (0):(0) then pick((import cnt)[(import cnt)[0]]):(6)
given mk (1):(3) then pick((import cnt)[1]):(6)
