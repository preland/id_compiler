// EXPECT: no such function 'to_flot'
// A call to a name that is neither a function of this program nor a builtin.
// There is nowhere else it could be resolved from -- a backend's functions are
// declared `native` in its source -- so it is a typo, and the message lists the
// builtins rather than leaving it to surface as an error from the C compiler.
main(int argc, string[] argv) {
  print(to_flot("1"));
} return int 0;
