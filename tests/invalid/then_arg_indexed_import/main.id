// EXPECT: an indexed export, (import cnt)[...], is accepted only as an argument of a then check, as in 'then f((import cnt)[1]):(value)'
mk() {
  export int[] cnt = [0, 5];
} return void;

pick(int v) {
  int w = v + 1;
} return int w;
(1):(2)
(2):(3)

wrap(int k) {
  int a = k * 3;
} return int a;
given mk ((import cnt)[1]):(15)
given mk (1):(3)
