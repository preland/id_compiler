// EXPECT: performs 4 actions
// a chain segment is held to the same 3-action limit as the function itself,
// measured per segment rather than over the concatenated body
main(int argc, string[] argv) {
  int a = 1;
  int b = 2;
  int c = 3;
} chain (int argc, string[] argv) {
  int d = 4;
  int e = 5;
  int f = 6;
  int g = 7;
} return int 0;
