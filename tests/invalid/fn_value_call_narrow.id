// EXPECT: argument 0 of 'step' (a func(int) return void) narrows word to int; declare a int local and pass that
// EXPECT-IDCPY: expected a type (int, string, void, or a T[] array type), found 'func'
tick(int n) {
  print(n);
} return void;

run_frame(func(int) return void step, word w) {
  step(w);
} return void;

main(int argc, string[] argv) {
  run_frame(tick, 16);
} return int 0;
