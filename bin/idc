#!/usr/bin/env bash
# idc -- the self-hosted `id` compiler driver.
#
# This is the PRIMARY way to build `id` programs. It bootstraps the two
# id-written compiler stages -- the lexer (compiler/lex -> idlex) and the
# parser/C-emitter (compiler/parse -> idparse) -- from the CHECKED-IN C in
# bootstrap/, which those same two stages emitted; `cc` turns that C back into
# a working compiler with no other compiler involved. It caches the resulting
# binaries, and from then on builds every program by piping its concatenated
# source through those two id-written binaries and handing the emitted C to
# `cc`. See bootstrap/README.md.
#
# The semantic checks live in idparse, in id: the action-per-block limit,
# nesting depth, 3-functions-per-file, name-type consistency, export/import
# access, function-logic uniqueness, the type checks, and unresolved calls.
# The six structural checks (a legacy-named or nested conf.id, a directory
# sharing its parent's name, a generic file name, a numbered sibling, a file
# named like its own directory; a directory has no entry limit) are checked
# by tools/idlayout, an `id` program this driver builds
# and runs (run_idlayout below) -- `id` reads a directory's own listing
# through idstd's fs_list now, so this is no longer a rule the language
# cannot express, only one this driver still has to call before it knows
# what tree it is compiling.
#
# Usage:
#   bin/idc PATH [-o OUTPUT] [--emit-c FILE] [--keep-c] [--cc CC]
#           [--backend DIR]... [--triple TRIPLE]
#   bin/idc PATH --lib [-o DIR/NAME]   a project with no main as DIR/libNAME.so,
#                            DIR/libNAME.a and DIR/NAME.h, callable from C and
#                            anything that can call C (docs/INTEROP.md);
#                            --lib-state keeps memory between calls
#   bin/idc PATH --check     the rules only: no C, no cc, no cases, no link
#   bin/idc PATH --fix       rewrite PATH's own .id files to resolve what has
#                            one mechanical, behaviour-preserving repair
#
# PATH is a single .id file or a project directory (its whole .id tree, in
# the same sorted-full-path order idc.py uses).
set -u

# phase NAME -- under IDC_TIMES=1, one stderr line with the wall time since
# this invocation started, so a build's slow stage can be named rather than
# guessed. No fork: EPOCHREALTIME is read, not date.
PHASE_T0="${EPOCHREALTIME/[.,]/}"
phase() {
    [ -n "${IDC_TIMES:-}" ] || return 0
    local now="${EPOCHREALTIME/[.,]/}" us
    us=$((now - PHASE_T0))
    printf 'idc: times: phase %-10s +%d.%03ds\n' "$1" $((us / 1000000)) $((us % 1000000 / 1000)) >&2
}

# A build that checks only the part of the library a program reaches is handed
# the plan naming it (run_std_precheck_lazy) and the library's root. Taken off
# the environment here so that no build this one starts -- a tool, a backend --
# inherits it and takes itself for that check.
STD_PLAN_IN="${IDC_STD_PLAN:-}"
STD_PLAN_ROOT="${IDC_STD_PLAN_ROOT:-}"
unset IDC_STD_PLAN IDC_STD_PLAN_ROOT

# ---------------------------------------------------------------------------
# locate the repo root (this script lives in <root>/bin/idc)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
    echo "usage: idc PATH [-o OUTPUT] [--target c|llvm|wasm] [--freestanding] [--runtime] [-O 0|1|2|3|s] [--emit-c FILE] [--emit-llvm FILE] [--lib | --lib-state] [--keep-c] [--cc CC] [--backend DIR]... [--triple TRIPLE] [--require-tests] [--allow-untested] [--list-untested] [--fingerprints] [--calls] [--check] [--bool-strict] [--given-blocks-strict] [--word-scan] [--fix] [--print-std] [--exports list|all] [--no-js]" >&2
    echo "       idc PATH [--diagnostics human|json|plain] [--color auto|always|never]    how diagnostics are printed (docs/DIAGNOSTICS.md)" >&2
    echo "       idc --explain CODE                                                       the long explanation of an error code, e.g. E0501" >&2
    echo "       idc --where NAME [PATH]                                                  FILE:LINE and signature of a function, in PATH or idstd; NAME or FILE::NAME" >&2
}

PATH_ARG=""
OUTPUT=""
BUILD_DIR="build"
EMIT_C=""
EMIT_LLVM=""
TARGET=c
OPT=1
OPT_GIVEN=0
FREESTANDING=0
RUNTIME=0
KEEP_C=0
LIB=0
LIB_STATE=0
CC=cc
CC_EXPLICIT=0
TRIPLE=""
REQUIRE_TESTS=1
ALLOW_UNTESTED=0
LIST_UNTESTED=0
EMIT_SOURCES=0
FINGERPRINTS=0
KEEPS=0
CALLS=0
CHECK=0
WORD_SCAN=0
BOOL_STRICT=0
GIVEN_STRICT=0
FOR_STRICT=0
FIX=0
PRINT_STD=0
WEXPORT_SCOPE=list
NO_JS=0
NO_STD=0
STD_DIR=""
BACKENDS=()          # from --backend flags: an override, or a backend of its own
FOUND_BACKENDS=()    # every directory holding a backend.id in a collected tree
CONSTS=()            # constant declarations from every conf.id reached
# Set by a structural check that found a real violation but could keep going
# without losing or misattributing anything (an over-full directory, a nested
# or legacy-named conf.id, an out-of-order conf.id line): the check prints its
# message immediately, same as before, but no longer exits. That lets idlex
# and idparse still run and report everything else wrong with the project --
# otherwise the first such violation hid every one of idparse's own
# diagnostics, which is how idem/engine's 1,115 errors were once read as "1
# error". Checked at every success exit below; any violation turns it into 1.
STRUCT_VIOLATIONS=0
# How diagnostics are printed (docs/DIAGNOSTICS.md): human is a source snippet
# with a caret under each, json is one object per line, plain is the compiler's
# own text; the colour is only ever on for a terminal. The default, auto, is human on a terminal and plain when stderr is piped, so a grep or a parser sees FILE:LINE: error: ... as it always has.
DIAG_FORMAT="${IDC_DIAGNOSTICS:-auto}"
DIAG_COLOR=auto
EXPLAIN=""
WHERE=""

while [ $# -gt 0 ]; do
    case "$1" in
        -o|--output)
            OUTPUT="${2:?idc: $1 needs an argument}"; shift 2 ;;
        --emit-c)
            EMIT_C="${2:?idc: --emit-c needs an argument}"; shift 2 ;;
        --keep-c)
            KEEP_C=1; shift ;;
        --lib)
            LIB=1; shift ;;
        --lib-state)
            LIB=1; LIB_STATE=1; shift ;;
        --cc)
            CC="${2:?idc: --cc needs an argument}"; CC_EXPLICIT=1; shift 2 ;;
        --backend)
            BACKENDS+=("${2:?idc: --backend needs an argument}"); shift 2 ;;
        --triple)
            TRIPLE="${2:?idc: --triple needs an argument}"; shift 2 ;;
        --require-tests)
            REQUIRE_TESTS=1; shift ;;
        --allow-untested)
            ALLOW_UNTESTED=1; shift ;;
        --list-untested)
            LIST_UNTESTED=1; shift ;;
        --emit-sources)
            EMIT_SOURCES=1; shift ;;
        --keeps)
            FINGERPRINTS=1; KEEPS=1; shift ;;
        --fingerprints)
            FINGERPRINTS=1; shift ;;
        --calls)
            CALLS=1; shift ;;
        --check)
            CHECK=1; shift ;;
        --for-strict)
            FOR_STRICT=1; shift ;;
        --given-blocks-strict)
            GIVEN_STRICT=1; shift ;;
        --bool-strict)
            BOOL_STRICT=1; shift ;;
        --word-scan)
            WORD_SCAN=1; shift ;;
        --fix)
            FIX=1; shift ;;
        --print-std)
            PRINT_STD=1; shift ;;
        --exports)
            WEXPORT_SCOPE="${2:?idc: --exports needs list or all}"
            case "$WEXPORT_SCOPE" in
                list|all) ;;
                *) echo "idc: --exports takes 'list' (the functions named in conf.id's lib_exports, the default) or 'all' (every function of the project and its imports, idstd excluded; a debugging escape), not '$WEXPORT_SCOPE'" >&2
                   exit 2 ;;
            esac
            shift 2 ;;
        --diagnostics=*)
            DIAG_FORMAT="${1#*=}"; shift ;;
        --diagnostics)
            DIAG_FORMAT="${2:?idc: --diagnostics needs human, json or plain}"; shift 2 ;;
        --color=*)
            DIAG_COLOR="${1#*=}"; shift ;;
        --color)
            DIAG_COLOR="${2:?idc: --color needs auto, always or never}"; shift 2 ;;
        --explain)
            EXPLAIN="${2:?idc: --explain needs an error code, such as E0501}"; shift 2 ;;
        --where)
            WHERE="${2:?idc: --where needs a function name, such as add or src/a.id::add}"; shift 2 ;;
        --no-js)
            NO_JS=1; shift ;;
        --no-std)
            NO_STD=1; shift ;;
        --std)
            STD_DIR="${2:?idc: --std needs an argument}"; shift 2 ;;
        --target)
            TARGET="${2:?idc: --target needs an argument}"
            case "$TARGET" in
                c|llvm|wasm) ;;
                *) echo "idc: unknown --target '$TARGET' (this driver has 'c', 'llvm' and 'wasm')" >&2
                   exit 2 ;;
            esac
            shift 2 ;;
        --freestanding)
            FREESTANDING=1; TARGET=llvm; shift ;;
        --runtime)
            RUNTIME=1; FREESTANDING=1; TARGET=llvm; shift ;;
        -O)
            OPT="${2:?idc: -O needs a level: 0, 1, 2, 3 or s}"; OPT_GIVEN=1; shift 2 ;;
        -O0|-O1|-O2|-O3|-Os)
            OPT="${1#-O}"; OPT_GIVEN=1; shift ;;
        --emit-llvm)
            EMIT_LLVM="${2:?idc: --emit-llvm needs an argument}"; TARGET=llvm; shift 2 ;;
        -h|--help)
            usage; exit 0 ;;
        --)
            shift; break ;;
        -*)
            echo "idc: unknown option: $1" >&2; usage; exit 2 ;;
        *)
            if [ -n "$PATH_ARG" ]; then
                echo "idc: unexpected extra argument: $1 (idc takes exactly one path)" >&2
                usage; exit 2
            fi
            PATH_ARG="$1"; shift ;;
    esac
done
if [ -n "${1:-}" ] && [ -z "$PATH_ARG" ]; then
    PATH_ARG="$1"; shift
fi
if [ "$DIAG_FORMAT" = auto ]; then
    if [ -t 2 ]; then DIAG_FORMAT=human; else DIAG_FORMAT=plain; fi
fi
case "$DIAG_FORMAT" in
    human|json|plain) ;;
    *) echo "idc: --diagnostics takes 'human' (a source snippet under each diagnostic), 'json' (one object per line) or 'plain' (the compiler's own text), not '$DIAG_FORMAT'" >&2
       exit 2 ;;
esac
case "$DIAG_COLOR" in
    auto|always|never) ;;
    *) echo "idc: --color takes 'auto' (a terminal, and NO_COLOR unset), 'always' or 'never', not '$DIAG_COLOR'" >&2
       exit 2 ;;
esac

# explain_code CODE -- the section of docs/ERRORS.md headed `## CODE`: what the
# error means, why the rule exists, and an incorrect and a correct program.
explain_code() {
    local code doc="$ROOT/../docs/ERRORS.md" text codes
    code=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
    case "$code" in [0-9]*) code=$(printf 'E%04d' "$((10#$code))" 2>/dev/null) || code="E$code" ;; esac
    [ -f "$doc" ] || { echo "idc: --explain reads $doc, which does not exist; the explanations are docs/ERRORS.md in the id_development checkout" >&2; return 1; }
    text=$(awk -v c="$code" '$1 == "##" && $2 == c { p = 1; sub(/^## /, ""); print; next } /^## / { p = 0 } p' "$doc")
    if [ -z "$text" ]; then
        codes=$(awk '$1 == "##" && $2 ~ /^E[0-9]+$/ { printf "%s ", $2 }' "$doc")
        echo "idc: no error code '$1'; the codes that have an explanation are: $codes" >&2
        return 1
    fi
    printf '%s\n' "$text"
}
if [ -n "$EXPLAIN" ]; then
    explain_code "$EXPLAIN"
    exit $?
fi

if [ -z "$PATH_ARG" ] && [ -z "$WHERE" ]; then
    echo "idc: missing PATH" >&2; usage; exit 2
fi

# -O LEVEL, on every target (docs/BACKENDS.md, "Optimisation levels"). The level
# trades build time and speed against binary size by how much of the program
# the C compiler may inline across id functions; the test harness is always -O0.
#
#   0  nothing is inlined: every id function is a call. Quickest build.
#   1  -O1 per unit; what a unit can see of the others is only its prototypes.
#   2  -O2 -ftree-vectorize plus whole-program inlining at link time (LTO). The default.
#   3  -O3 plus whole-program inlining and a larger inline budget.
#   s  -Os plus whole-program inlining: the smallest binary.
case "$OPT" in
    0|1|2|3|s) ;;
    *) echo "idc: -O takes 0, 1, 2, 3 or s, not '$OPT'; 2 is the default, 0 builds fastest and s builds the smallest binary" >&2
       exit 2 ;;
esac
CLEVEL=2
[ "$OPT_GIVEN" -eq 1 ] && CLEVEL="$OPT"
CC_OFLAGS=("-O$CLEVEL" -fwrapv)
CC_INLINE=()
CC_LTO=0
case "$CLEVEL" in
    2) CC_LTO=1; CC_OFLAGS+=(-ftree-vectorize) ;;
    s) CC_LTO=1 ;;
    3) CC_LTO=1; CC_INLINE=(--param max-inline-insns-auto=60 --param inline-unit-growth=80) ;;
esac
IR_OPT="$OPT"
[ "$IR_OPT" = s ] && IR_OPT=1

# cc_lto_setup -- true if this build may link its units with link-time
# optimisation, and then CC_LTO_COMPILE / CC_LTO_LINK hold the flags. gcc takes
# a job count at link time and clang does not, so the compiler is asked which it
# is; a cc that is neither gets no LTO.
CC_LTO_COMPILE=()
CC_LTO_LINK=()
CC_LTO_CHECKED=0
cc_lto_setup() {
    if [ "$CC_LTO_CHECKED" -eq 0 ]; then
        CC_LTO_CHECKED=1
        local macros
        macros=$(printf '' | "$CC" -dM -E -x c - 2>/dev/null)
        case "$macros" in
            *__clang__*) CC_LTO_COMPILE=(-flto=thin); CC_LTO_LINK=(-flto=thin) ;;
            *__GNUC__*)  CC_LTO_COMPILE=(-flto); CC_LTO_LINK=("-flto=${IDC_UNIT_JOBS:-4}") ;;
            *)           CC_LTO=0 ;;
        esac
    fi
    [ "$CC_LTO" -eq 1 ]
}

# resolve_stdlib -- the standard library this invocation would merge, if any,
# left in STDLIB (absolute, no trailing slash, or "" for none). Resolution
# order: --no-std, then --std, then IDC_NO_STD, then $IDSTD_HOME, then an `idstd`
# directory beside this repository or the one above it. Mirrors idc.py's
# resolve_stdlib. Shared by --print-std (below) and the real merge further
# down, which collects STDLIB's source once this has answered which directory
# it is.
resolve_stdlib() {
    STDLIB=""
    if [ "$NO_STD" -eq 1 ] && [ -n "$STD_DIR" ]; then
        echo "idc: --no-std and --std $STD_DIR contradict each other; drop --no-std to build against that library, or drop --std to build without one" >&2
        exit 1
    fi
    if [ "$NO_STD" -eq 0 ] && { [ -n "$STD_DIR" ] || [ -z "${IDC_NO_STD:-}" ]; }; then
        if [ -n "$STD_DIR" ]; then
            [ -d "$STD_DIR" ] || { echo "idc: --std: not a directory: $STD_DIR" >&2; exit 1; }
            STDLIB="$STD_DIR"
        elif [ -n "${IDSTD_HOME:-}" ]; then
            [ -d "$IDSTD_HOME" ] || { echo "idc: \$IDSTD_HOME: not a directory: $IDSTD_HOME" >&2; exit 1; }
            STDLIB="$IDSTD_HOME"
        elif [ -d "$ROOT/../idstd" ]; then
            STDLIB="$ROOT/../idstd"
        elif [ -d "$ROOT/../../idstd" ]; then
            STDLIB="$ROOT/../../idstd"
        fi
    fi
    [ -n "$STDLIB" ] && STDLIB="$(cd "$STDLIB" && pwd -P)"
}

# --print-std answers, alone, the question a caller like tools/idxpack.sh
# needs before it runs --calls: which stdlib root this exact invocation --
# same flags, same environment -- would merge, so a caller can tell a
# project file from a stdlib file by where THIS build's library actually is,
# not by guessing at a hard-coded path substring. No source is collected, no
# layout is checked, no stage is bootstrapped -- just the same resolution the
# real build below does, printed and done.
if [ "$PRINT_STD" -eq 1 ]; then
    resolve_stdlib
    printf '%s\n' "$STDLIB"
    exit 0
fi

# At most IDC_JOBS builds run at once on this machine -- by default a quarter
# of its cores -- because a build is several single-core stages back to back
# and a dozen of them at once starve everything else. A build holds one slot
# file under flock for its whole run, and a build with every slot taken waits
# on one rather than polling. A build started from inside another (a compiler
# stage, a driver tool, a library pre-check) is part of its parent's work and
# takes no second slot, which is also what keeps a nested build from waiting
# on its own parent. A build that waits longer than a second says so on
# stderr (a terminal, or IDC_PROGRESS set), so a stalled build is not mistaken
# for a slow one. IDC_NO_SLOTS=1 takes no slot at all: tests/run.sh sets it, so
# a check that times one compile never counts the wait for a slot.
if [ -z "${IDC_SLOT_HELD:-}" ] && [ -z "${IDC_NO_SLOTS:-}" ] && [ -z "$WHERE" ] && command -v flock >/dev/null 2>&1; then
    idc_jobs=${IDC_JOBS:-$(( $(nproc 2>/dev/null || echo 4) / 4 ))}
    [ "$idc_jobs" -ge 1 ] 2>/dev/null || idc_jobs=1
    slot_dir="${XDG_RUNTIME_DIR:-/tmp}/idc-slots"
    mkdir -p "$slot_dir"
    slot_got=0
    for slot_i in $(seq 0 $((idc_jobs - 1))); do
        exec 8>>"$slot_dir/slot$slot_i"
        if flock -n 8; then slot_got=1; break; fi
        exec 8>&-
    done
    if [ "$slot_got" -eq 0 ]; then
        exec 8>>"$slot_dir/slot$((RANDOM % idc_jobs))"
        if ! flock -w 1 8; then
            if [ -n "${IDC_PROGRESS:-}" ] || { [ -t 2 ] && [ -z "${IDC_NO_PROGRESS:-}" ]; }; then
                echo "idc: waiting for a build slot ($idc_jobs in use; IDC_JOBS raises the limit)" >&2
            fi
            flock 8
        fi
    fi
    export IDC_SLOT_HELD=1
fi

# Every function carries at least two test cases, on every build, so that what
# a function does is pinned where it is declared and cannot drift unnoticed
# (docs/TESTS.md). --require-tests is that default restated. --allow-untested
# is the one way out, and it exists only until the tree has its cases.
if [ "$ALLOW_UNTESTED" -eq 1 ]; then
    REQUIRE_TESTS=0
fi

# --emit-c writes the C a build compiles, and an LLVM build compiles none. The
# LLVM path never looked at the flag: it built an object file at the default
# output instead, printed nothing about it, and exited 0.
if [ -n "$EMIT_C" ] && [ "$TARGET" = llvm ]; then
    echo "idc: --emit-c writes C, but this build targets LLVM (--target llvm, --emit-llvm or --freestanding); use --emit-llvm FILE" >&2
    exit 2
fi

# ---------------------------------------------------------------------------
# The platform this build is for, as one triple.
#
# It used to be asked twice and answered differently each time: idparse fell
# back to a hard-coded x86_64-unknown-linux-gnu when --triple was not passed,
# and the native-backend resolver ran its own `uname -s`. Neither could be
# overridden together, so `--triple aarch64-apple-darwin` selected aarch64 asm
# while still compiling the backend's Linux sources. One value answers both
# now, it is derived from the host when nothing says otherwise, and --triple
# moves the whole build rather than half of it.
host_triple() {
    local arch
    arch="$(uname -m)"
    case "$arch" in
        x86_64|amd64)   arch=x86_64 ;;
        aarch64|arm64)  arch=aarch64 ;;
    esac
    case "$(uname -s)" in
        Linux*)   echo "$arch-unknown-linux-gnu" ;;
        Darwin*)  echo "$arch-apple-darwin" ;;
        *)        echo "$arch-unknown-$(uname -s | tr '[:upper:]' '[:lower:]')" ;;
    esac
}

# The platform key a backend.id is indexed by, read out of the triple's OS
# field. `unknown` is the vendor slot and never the OS, so it is not matched.
triple_platform() {
    case "$1" in
        *-linux|*-linux-*)   echo linux ;;
        *-darwin|*-darwin*)  echo darwin ;;
        *-none|*-none-*)     echo none ;;
        *)                   echo "${1##*-}" ;;
    esac
}

# A freestanding build has no OS to name, so its default is the bare-metal
# triple rather than the host's -- which is what the kernel's asm functions are
# written for, and what clang was already being handed here.
if [ -z "$TRIPLE" ]; then
    if [ "$FREESTANDING" -eq 1 ]; then
        TRIPLE="$(host_triple)"
        TRIPLE="${TRIPLE%%-*}-unknown-none"
    else
        TRIPLE="$(host_triple)"
    fi
fi

# ---------------------------------------------------------------------------
# IDC_MEM_LIMIT -- a virtual-memory ceiling, in megabytes, applied to every
# subprocess that does real compilation work: idlex, idparse, and the C
# compiler or clang. This is defense in depth against the self-hosted
# compiler's own runaway memory use, not a fix for it -- a blowup in idparse
# still happens, but now it dies against this ceiling with one clear line
# instead of taking down the machine it runs on. The default was chosen with
# ample headroom over the largest legitimate builds in this tree; see
# idc/README.md for the measurements. 0 disables it.
MEM_LIMIT_MB="${IDC_MEM_LIMIT:-4096}"
case "$MEM_LIMIT_MB" in
    ''|*[!0-9]*)
        echo "idc: \$IDC_MEM_LIMIT must be a whole number of megabytes (0 disables it), got '$MEM_LIMIT_MB'" >&2
        exit 2 ;;
esac

MEM_INHERITED=$(ulimit -v)
MEM_CAP_KB=$((MEM_LIMIT_MB * 1024))
MEM_CAP_FROM=IDC_MEM_LIMIT
if [ "$MEM_INHERITED" != unlimited ] \
   && { [ "$MEM_CAP_KB" -eq 0 ] || [ "$MEM_INHERITED" -lt "$MEM_CAP_KB" ]; }; then
    MEM_CAP_KB=$MEM_INHERITED
    MEM_CAP_FROM=inherited
fi

# capped CMD... -- run CMD under MEM_CAP_KB, the limit actually in force. A
# caller's own tighter `ulimit -v` is inherited and left alone: an unprivileged
# process cannot raise its limit, and trying printed "cannot modify limit" once
# per stage.
#
# Once tools/ccrun is built (see ensure_ccrun below), this delegates to it:
# `ccrun MEM_KB CPU_SECONDS ARGV_LINES` applies the same RLIMIT_AS via
# proc_spawn_limited, forwards CMD's stdout/stderr byte for byte to this
# script's, and exits with CMD's exit status -- the same contract the old
# `ulimit -v` subshell gave, including how mem_ceiling_hit/mem_ceiling_error
# below detect and report a ceiling hit, since both read the exit status and
# CMD's stderr (captured by the caller's own `2>file`), never how CMD was
# actually spawned.
#
# Before $CCRUN exists -- building it needs a working idlex/idparse, so it is
# not ready the first few times capped() is called in a from-scratch build --
# this falls back to the plain `ulimit -v` subshell, set in a subshell so it
# bounds only CMD, never this script or anything that runs after it. ccrun
# cannot depend on itself to get built, and this fallback is what makes that
# possible without a second copy of the capping logic.
#
# ensure_ccrun is called lazily, from here, rather than unconditionally near
# the top of the script: a build that never actually reaches this branch --
# IDC_MEM_LIMIT=0, or a caller's own tighter inherited `ulimit -v` -- must not
# pay for building ccrun. CCRUN_CHECKED guards it to once per process --
# stale() is one `find`, cheap, but there is no reason to pay it on every one
# of a build's dozen-plus capped() calls.
#
# ccrun and idlayout are the driver's own tools, not the user's program: they
# are built against the idstd this driver would use with no --std/--no-std of
# its own (resolve_tool_std), regardless of what the actual build's flags or
# environment say -- a --no-std or --std OTHER_LIB build (the kernel's is the
# one in this tree) must still get a working ccrun and idlayout, or a program
# that legitimately wants no standard library could never build in a checkout
# that has one to find at all.
TOOL_STD_RESOLVED=0
TOOL_STD_ARGS=()
resolve_tool_std() {
    [ "$TOOL_STD_RESOLVED" -eq 1 ] && return 0
    TOOL_STD_RESOLVED=1
    local dir=""
    if [ -n "${IDSTD_HOME:-}" ]; then
        [ -d "$IDSTD_HOME" ] || { echo "idc: \$IDSTD_HOME: not a directory: $IDSTD_HOME" >&2; exit 1; }
        dir="$IDSTD_HOME"
    elif [ -d "$ROOT/../idstd" ]; then
        dir="$ROOT/../idstd"
    elif [ -d "$ROOT/../../idstd" ]; then
        dir="$ROOT/../../idstd"
    else
        echo "idc: tools/ccrun and tools/idlayout need idstd to build, and none was found; set \$IDSTD_HOME, or check out idstd beside $(basename "$ROOT")" >&2
        exit 1
    fi
    TOOL_STD_ARGS=(--std "$dir")
}
CCRUN_CHECKED=0
ensure_ccrun() {
    [ "$CCRUN_CHECKED" -eq 1 ] && return 0
    CCRUN_CHECKED=1
    [ -n "${IDC_BUILDING_CCRUN:-}" ] && return 0
    if stale "$CCRUN" "$ROOT/tools/ccrun"; then
        resolve_tool_std
        progress bootstrap "ccrun (from tools/ccrun)"
        IDC_BUILDING_CCRUN=1 \
            "$SCRIPT_DIR/idc" --cc "$CC" "${TOOL_STD_ARGS[@]}" --allow-untested "$ROOT/tools/ccrun" -o "$CCRUN" >&2 \
            || { progress_clear; echo "idc: failed to build tools/ccrun; falling back to a plain ulimit subshell" >&2; }
    fi
}

# tools/idlayout -- the id-written walk of the six structural checks
# (run_idlayout below), built and cached the same lazy way as
# ccrun above, and for the same reason: it needs a working idlex/idparse, so
# it is not ready the first few times a directory's structure has to be
# checked in a from-scratch build. IDC_BUILDING_IDLAYOUT breaks the same
# bootstrap cycle IDC_BUILDING_CCRUN does: building tools/idlayout means
# checking tools/idlayout's own directory structure, which would call
# ensure_idlayout again before idlayout exists to check anything with. That
# inner call returns having built nothing, and run_idlayout's own -x guard
# is what skips the check for that one build rather than erroring -- there is
# no bash left to fall back to, and tools/idlayout's structure is checked
# again, for real, on every build after this first one.
IDLAYOUT_CHECKED=0
ensure_idlayout() {
    [ "$IDLAYOUT_CHECKED" -eq 1 ] && return 0
    IDLAYOUT_CHECKED=1
    [ -n "${IDC_BUILDING_IDLAYOUT:-}" ] && return 0
    if stale "$IDLAYOUT" "$ROOT/tools/idlayout"; then
        resolve_tool_std
        progress bootstrap "idlayout (from tools/idlayout)"
        IDC_BUILDING_IDLAYOUT=1 \
            "$SCRIPT_DIR/idc" --cc "$CC" "${TOOL_STD_ARGS[@]}" --allow-untested "$ROOT/tools/idlayout" -o "$IDLAYOUT.tmp.$$" >&2 \
            && mv -f "$IDLAYOUT.tmp.$$" "$IDLAYOUT" \
            || { progress_clear; echo "idc: failed to build tools/idlayout; see the errors above" >&2; exit 1; }
    fi
}

# tools/libgen, built and cached the way idlayout is. Only a --lib build asks
# for it, so no other build pays for it.
LIBGEN_CHECKED=0
ensure_libgen() {
    [ "$LIBGEN_CHECKED" -eq 1 ] && return 0
    LIBGEN_CHECKED=1
    if stale "$LIBGEN" "$ROOT/tools/libgen"; then
        resolve_tool_std
        progress bootstrap "libgen (from tools/libgen)"
            "$SCRIPT_DIR/idc" --cc "$CC" "${TOOL_STD_ARGS[@]}" "$ROOT/tools/libgen" -o "$LIBGEN" >&2 \
            || { progress_clear; echo "idc: failed to build tools/libgen; see the errors above" >&2; exit 1; }
    fi
}

# tools/jsgen, built and cached the way libgen is. Only a --target wasm build
# that writes bindings asks for it, so no other build pays for it.
JSGEN_CHECKED=0
ensure_jsgen() {
    [ "$JSGEN_CHECKED" -eq 1 ] && return 0
    JSGEN_CHECKED=1
    if stale "$JSGEN" "$ROOT/tools/jsgen"; then
        resolve_tool_std
        progress bootstrap "jsgen (from tools/jsgen)"
            "$SCRIPT_DIR/idc" --cc "$CC" "${TOOL_STD_ARGS[@]}" "$ROOT/tools/jsgen" -o "$JSGEN" >&2 \
            || { progress_clear; echo "idc: failed to build tools/jsgen; see the errors above" >&2; exit 1; }
    fi
}

# resolve_export_list WHAT -- the functions a library or a wasm module exports:
# exactly those named in `string[] lib_exports = [...];` in the project's root
# conf.id, wherever in the tree they are defined (docs/INTEROP.md, "Which
# functions are exported"). The list is read here, by text, and only tools read
# it: the program never mentions it, so the compiler keeps it only where it
# keeps every constant (a project with no main). Sets PROGRAM_FILES (every
# source file but idstd's and the runtime's) and ELIST (the names, validated);
# every problem found is reported, each with its fix, before the build goes on.
# --exports all (wasm only) is the debugging escape: every function of the
# project and its imports, no list read.
resolve_export_list() {
    local what="$1" f name conf="" own="" std="" text="" bad=0 is_cmd=0
    local -a std_files=() names=()
    PROGRAM_FILES=()
    ELIST=()
    for f in "${SRC_FILES[@]}"; do
        if [ -n "$STDLIB" ] && [[ "$f" == "$STDLIB"/* ]]; then std_files+=("$f")
        elif [[ "$f" != "$ROOT"/runtime/* ]]; then PROGRAM_FILES+=("$f"); fi
    done
    [ "${#PROGRAM_FILES[@]}" -gt 0 ] && own=$(grep -hoE '^(pure )?[A-Za-z_][A-Za-z0-9_]*\(' "${PROGRAM_FILES[@]}" | sed -E 's/^pure //' | tr -d '(' | sort -u)
    if [ "$WEXPORT_SCOPE" = all ]; then
        while IFS= read -r name; do [ -n "$name" ] && ELIST+=("$name"); done <<< "$own"
        return 0
    fi
    [ -d "$PATH_ARG" ] && conf="${PATH_ARG%/}/conf.id"
    [ -n "$conf" ] && [ -f "$conf" ] && text=$(sed 's://.*$::' "$conf" | awk '/^string\[\][ \t]+lib_exports[ \t]*=/ {on=1} on {print} on && /;/ {exit}')
    grep -q '^int main(' "$C_OUT" && is_cmd=1
    if [ -z "$text" ]; then
        [ "$TARGET" = wasm ] && [ "$is_cmd" -eq 1 ] && return 0
        progress_clear
        if [ -d "$PATH_ARG" ]; then
            printf 'idc: %s needs to know which functions to export: add\n  string[] lib_exports = ["first_fn", "second_fn"];\nto %s/conf.id (after its import lines), naming the functions a host may call; they can be defined anywhere in the project tree (docs/INTEROP.md, "Which functions are exported")\n' "$what" "${PATH_ARG%/}" >&2
        else
            echo "idc: $what needs to know which functions to export, and a single file has no conf.id; put '$PATH_ARG' in a directory with a conf.id that holds \`string[] lib_exports = [\"first_fn\"];\`, and build the directory (docs/INTEROP.md, \"Which functions are exported\")" >&2
        fi
        exit 1
    fi
    while IFS= read -r name; do names+=("$name"); done < <(printf '%s\n' "$text" | grep -oE '"[^"]*"' | tr -d '"')
    if [ "${#names[@]}" -eq 0 ]; then
        progress_clear
        echo "idc: lib_exports in $conf lists no function; name at least one, e.g. \`string[] lib_exports = [\"first_fn\"];\`" >&2
        exit 1
    fi
    [ "${#std_files[@]}" -gt 0 ] && std=$(grep -hoE '^(pure )?[A-Za-z_][A-Za-z0-9_]*\(' "${std_files[@]}" | sed -E 's/^pure //' | tr -d '(' | sort -u)
    local -A seen=()
    progress_clear
    for name in "${names[@]}"; do
        if [ -n "${seen[$name]:-}" ]; then
            echo "idc: $conf: lib_exports lists '$name' twice; remove one of the entries" >&2; bad=1; continue
        fi
        seen[$name]=1
        if [ "$name" = main ]; then
            echo "idc: $conf: lib_exports lists 'main', which cannot be exported; move what main does into a function and list that one" >&2; bad=1
        elif printf '%s\n' "$own" | grep -qxF -- "$name"; then
            ELIST+=("$name")
        elif [ -n "$std" ] && printf '%s\n' "$std" | grep -qxF -- "$name"; then
            echo "idc: $conf: lib_exports lists '$name', a function of the standard library, which a project cannot re-export; define a function of your own that calls it and list that one" >&2; bad=1
        else
            echo "idc: $conf: lib_exports lists '$name', which is not a function of this project; check the spelling against its definition, or remove the entry (a function must be defined in the project's tree or in a tree it imports)" >&2; bad=1
        fi
    done
    [ "$bad" -eq 0 ] || exit 1
}

# tools/iddiag, built and cached the way idlayout is, and only when there is a
# diagnostic to print: a build that passes never pays for it. A build that cannot
# make it prints its diagnostics as the compiler wrote them.
IDDIAG_CHECKED=0
ensure_iddiag() {
    [ "$IDDIAG_CHECKED" -eq 1 ] && return 0
    IDDIAG_CHECKED=1
    if stale "$IDDIAG" "$ROOT/tools/iddiag"; then
        resolve_tool_std
        progress bootstrap "iddiag (from tools/iddiag)"
        IDC_BUILDING_IDDIAG=1 \
            "$SCRIPT_DIR/idc" --cc "$CC" "${TOOL_STD_ARGS[@]}" --allow-untested "$ROOT/tools/iddiag" -o "$IDDIAG" >&2 \
            || { progress_clear; echo "idc: failed to build tools/iddiag; printing diagnostics as the compiler wrote them" >&2; rm -f "$IDDIAG"; }
    fi
}

# show_diag FILE... -- the diagnostics in the FILEs, printed to stderr in the
# format --diagnostics chose. Plain is the compiler's own text, which is also what
# every build nested inside another one (a tool, a library check, a bootstrap
# stage) prints, since its parent prints it again.
show_diag() {
    local f stream color=never
    stream=$(mktemp "${TMPDIR:-/tmp}/idc-diag.XXXXXX") || { cat "$@" >&2; return 0; }
    for f in "$@"; do
        if [ -s "$f" ]; then cat "$f" >> "$stream"; fi
    done
    if [ ! -s "$stream" ]; then
        rm -f "$stream"
        return 0
    fi
    if [ "$DIAG_FORMAT" != plain ] && [ -z "${IDC_BUILDING_CCRUN:-}${IDC_BUILDING_IDLAYOUT:-}${IDC_BUILDING_IDDIAG:-}${IDC_BUILDING_LIB_PRECHECK:-}${IDC_STAGE_LEX:-}" ]; then
        ensure_iddiag
    fi
    if [ "$DIAG_FORMAT" = plain ] || [ ! -x "$IDDIAG" ] || [ -n "${IDC_BUILDING_CCRUN:-}${IDC_BUILDING_IDLAYOUT:-}${IDC_BUILDING_IDDIAG:-}${IDC_BUILDING_LIB_PRECHECK:-}${IDC_STAGE_LEX:-}" ]; then
        cat "$stream" >&2
    else
        case "$DIAG_COLOR" in
            always) color=always ;;
            auto) if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ] && [ -t 2 ]; then color=always; fi ;;
        esac
        "$IDDIAG" "--format=$DIAG_FORMAT" "--color=$color" < "$stream" >&2
    fi
    rm -f "$stream"
}

# run_idlayout ROOT -- every one of the six structural checks over ROOT's
# tree, in one call. Used at every place that used to call the bash
# check_* functions: the project itself, each dependency a conf.id names,
# each --backend directory, and the standard library.
run_idlayout() {
    ensure_idlayout
    if [ -x "$IDLAYOUT" ]; then
        local layout_out layout_rc
        progress layout "$1"
        layout_out=$(mktemp "${TMPDIR:-/tmp}/idc-layout.XXXXXX") || layout_out=/dev/null
        "$IDLAYOUT" "$1" "$BUILD_DIR" > "$layout_out"
        layout_rc=$?
        show_diag "$layout_out"
        [ "$layout_out" = /dev/null ] || rm -f "$layout_out"
        [ "$layout_rc" -ne 0 ] && STRUCT_VIOLATIONS=1
    fi
}
capped() {
    if [ "$MEM_CAP_FROM" = IDC_MEM_LIMIT ] && [ "$MEM_CAP_KB" -ne 0 ]; then
        ensure_ccrun
        if [ -x "$CCRUN" ]; then
            "$CCRUN" "$MEM_CAP_KB" 0 - "$(printf '%s\n' "$@")"
        else
            ( ulimit -v "$MEM_CAP_KB"; exec "$@" )
        fi
    else
        "$@"
    fi
}

# capped_from INPUT CMD... -- like capped(), but CMD's stdin is INPUT, a real
# file. ccrun does not read its own stdin at all (see tools/ccrun/main.id):
# every stage that needs to feed a child something now names the file
# explicitly, which is also what let ccrun drop the poll-every-round relay
# of its own stdin that cost ~13s on a build that needs under a second of
# real work (see run_lex_parse below, and README/HACKING for the measurement).
capped_from() {
    local input="$1"; shift
    if [ "$MEM_CAP_FROM" = IDC_MEM_LIMIT ] && [ "$MEM_CAP_KB" -ne 0 ]; then
        ensure_ccrun
        if [ -x "$CCRUN" ]; then
            "$CCRUN" "$MEM_CAP_KB" 0 "$input" "$(printf '%s\n' "$@")"
        else
            ( ulimit -v "$MEM_CAP_KB"; exec "$@" ) < "$input"
        fi
    else
        "$@" < "$input"
    fi
}

# run_lex_parse SRC_FILE LEX_ARG... -- idlex|idparse, SRC_FILE through idlex
# (LEX_ARG... appended) and idlex's own output through idparse ($PARSE_ARGS),
# writing $RAW_OUT/$LEX_ERR/$PARSE_ERR and setting lex_rc/parse_rc, exactly as
# the two-stage bash pipe this replaces did (PIPESTATUS[0]/[1] there). Two
# sequential capped_from calls through a real intermediate file
# ($WORK/lex_out) rather than one live bash pipe between two ccrun instances:
# idlex is "well under a second" (bin/idc's own bootstrap comment) next to
# idparse's ~80% of the wall time, so losing the OS-level overlap between the
# two costs nothing worth measuring, and it is what lets neither ccrun
# instance ever have to relay a live, unbounded stdin of its own.
run_lex_parse() {
    local src="$1"; shift
    local lex_out="$WORK/lex_out"
    progress lex "$(plural "${#SRC_FILES[@]}" file)"
    capped_from "$src" "$IDLEX" "$@" 2>"$LEX_ERR" > "$lex_out"
    lex_rc=$?
    if [ -n "$EXT_HEAD" ] || [ -n "${WORD_HEAD:-}" ] || { [ -n "${TC_FILE:-}" ] && [ -s "$TC_FILE" ]; }; then
        {
            [ -z "$EXT_HEAD" ] || cat "$EXT_HEAD" "$EXT_STREAM"
            [ -z "${WORD_HEAD:-}" ] || cat "$WORD_HEAD"
            [ -z "${TC_FILE:-}" ] || [ ! -s "$TC_FILE" ] || sed 's/^/tcc /' "$TC_FILE"
            cat "$lex_out"
        } > "$lex_out.tc" && lex_out="$lex_out.tc"
    fi
    progress parse "tokens -> C"
    capped_from "$lex_out" "$IDPARSE" "${PARSE_ARGS[@]}" > "$RAW_OUT" 2>"$PARSE_ERR"
    parse_rc=$?
}

# mem_ceiling_hit RC [STDERR_FILE] -- true if a capped stage's failure looks
# like the ceiling rather than a bug in its own logic. Observed by hand at a
# few ceilings from 1 MB up: the id runtime checks its own allocations and
# says so in words (bootstrap/idlex.c, bootstrap/idparse.c: id_alloc/
# id_realloc); cc's cc1 also checks and exits cleanly with its own "out of
# memory" or "virtual memory exhausted" line; tight enough that cc1 itself
# segfaults mid-allocation, gcc catches that and reports an "internal
# compiler error" instead; and a program that checks nothing dies by signal,
# uncaught, when malloc returns NULL somewhere it never expected -- hence
# RC > 128 (128 + the signal number). Always false when the ceiling is off,
# so a signal from an unrelated cause is never misreported as this.
#
# Below roughly 5 MB on this machine the ceiling is too tight even for the
# dynamic loader to map libc into a new process ("failed to map segment from
# shared object"), which none of the above catches -- every default this
# driver would ever choose sits far above that floor, so it is left unhandled
# rather than grown into a pattern match that could paper over a real linker
# problem.
mem_ceiling_hit() {
    [ "$MEM_CAP_KB" -eq 0 ] && return 1
    [ "$1" -gt 128 ] && return 0
    [ -n "${2:-}" ] && [ -s "$2" ] \
        && grep -qiE 'out of memory|virtual memory exhausted|internal compiler error' "$2"
}

# mem_ceiling_error STAGE -- the one line printed in place of a generic
# failure report once mem_ceiling_hit is true. Deliberately not the
# "this is a bug in the self-hosted compiler" block: the compiler was not
# necessarily wrong, it was just refused the memory to keep going.
mem_ceiling_error() {
    if [ "$MEM_CAP_FROM" = inherited ]; then
        echo "idc: $1 exceeded the memory limit idc was started under ($((MEM_CAP_KB / 1024)) MB, from ulimit -v); IDC_MEM_LIMIT cannot raise a limit set by the caller" >&2
    else
        echo "idc: $1 exceeded the memory ceiling ($MEM_LIMIT_MB MB); set \$IDC_MEM_LIMIT to raise it, or to 0 to disable it" >&2
    fi
    echo "idc: this means the compiler used more memory than allowed, not that it is broken" >&2
}

# ---------------------------------------------------------------------------
# bootstrap idlex/idparse (from the checked-in C in bootstrap/, only when
# missing or stale) and cache them
# IDC_CACHE_DIR moves the bootstrap cache elsewhere, so two builds running at
# once cannot write the same idlex/idparse. The default is the one everybody
# shares, which is right when there is one build.
CACHE_DIR="${IDC_CACHE_DIR:-$ROOT/.idc-cache}"
mkdir -p "$CACHE_DIR" || { echo "idc: cannot create cache dir $CACHE_DIR" >&2; exit 1; }
IDLEX="$CACHE_DIR/idlex"
IDPARSE="$CACHE_DIR/idparse"
BOOT_DIR="$ROOT/bootstrap"
STAGE0_LEX="$CACHE_DIR/idlex0"
STAGE0_PARSE="$CACHE_DIR/idparse0"
# tools/ccrun -- see capped() below. Set here (before capped() is ever
# called) even though it is only built further down, once idlex/idparse
# exist to build it with: capped() reads it by name at call time, and
# `[ -x "$CCRUN" ]` is false until the build below has actually run.
CCRUN="$CACHE_DIR/ccrun"
# tools/idlayout -- see ensure_idlayout below. Set here for the same reason
# CCRUN is: ensure_idlayout reads it by name at call time.
IDLAYOUT="$CACHE_DIR/idlayout"
# tools/libgen -- the C header and wrappers of a --lib build (ensure_libgen).
LIBGEN="$CACHE_DIR/libgen"
# tools/jsgen -- the JS and TypeScript bindings of a --target wasm build (ensure_jsgen).
JSGEN="$CACHE_DIR/jsgen"
# tools/iddiag -- prints diagnostics for a person or as JSON (show_diag).
IDDIAG="$CACHE_DIR/iddiag"

# --std, if given, points the bootstrap at the same library the build will use.
# --no-std deliberately does NOT propagate: it says the user's program wants no
# library, not that the compiler can be built without one. IDC_NO_STD is
# likewise not honoured here, for the same reason -- tests/run.sh exports it for
# every program it builds, and the compiler is not one of those programs.
STD_ARGS=()
[ -n "$STD_DIR" ] && STD_ARGS=(--std "$STD_DIR")

# ---------------------------------------------------------------------------
# One line of progress, rewritten in place.
#
# It goes to stderr and ONLY when stderr is a terminal. Both halves matter:
# stdout carries real output (`--emit-c -`, and the idlex|idparse pipeline
# itself), and a carriage return in the middle of emitted C would be a bug;
# while a non-terminal stderr is a log or a test capture, and
# tests/invalid.sh compares diagnostics against expected text, so a single
# extra character there fails the whole negative suite. When stderr is
# not a tty every function below is a no-op -- not "quieter", silent.
#
# The line is cleared before anything else is written, so a diagnostic never
# lands on top of half a progress bar.
PROGRESS=0
[ -t 2 ] && [ -z "${IDC_NO_PROGRESS:-}" ] && PROGRESS=1
PROGRESS_OPEN=0
PROG_COLS=80
PROG_STAGE=""
PROG_NOTE=""
PROG_RAN=""
PROG_CACHED=""
PROG_T0=0
PROG_S0=0
PROG_FMT=""
PROG_FIT=""
TICK_PID=""
TICK_FD=""
if [ "$PROGRESS" -eq 1 ]; then
    PROG_T0=$((${EPOCHREALTIME/[.,]/} / 1000))
    PROG_S0=$PROG_T0
    read -r _ PROG_COLS < <(stty size <&2 2>/dev/null)
    case "$PROG_COLS" in ''|*[!0-9]*) PROG_COLS=80 ;; esac
    [ "$PROG_COLS" -ge 40 ] || PROG_COLS=40
fi

# "1 file", not "1 files": the line is read on every build, so it is worth
# the two lines it costs.
plural() { [ "$1" -eq 1 ] && printf '%s %s' "$1" "$2" || printf '%s %ss' "$1" "$2"; }

# progress_secs START_MS -- sets PROG_FMT to the time since START_MS, "4.21s".
progress_secs() {
    local d=$(( ${EPOCHREALTIME/[.,]/} / 1000 - $1 ))
    printf -v PROG_FMT '%d.%02ds' "$((d / 1000))" "$(( (d % 1000) / 10 ))"
}

# progress_fit TEXT ROOM -- sets PROG_FIT to TEXT cut to ROOM columns, "..."
# where it was cut, so a line never wraps (a wrapped line leaves its first
# half behind when it is rewritten).
progress_fit() {
    if [ "${#1}" -le "$2" ]; then PROG_FIT="$1"; else PROG_FIT="${1:0:$(($2 - 3))}..."; fi
}

# A stage that ends is left on screen with the time it took; the stage after
# it takes the live line. Calling progress with the stage already running only
# rewrites its detail.
progress_stage() { # progress_stage NAME
    [ "$1" = "$PROG_STAGE" ] && return 0
    progress_stop_ticker
    if [ -n "$PROG_STAGE" ]; then
        progress_secs "$PROG_S0"
        progress_fit "$PROG_FMT${PROG_NOTE:+  ($PROG_NOTE)}" $((PROG_COLS - 14))
        printf '\r\033[K  \033[2m%-9s %s\033[0m\n' "$PROG_STAGE" "$PROG_FIT" >&2
    fi
    PROG_NOTE=""
    PROG_STAGE="$1"
    PROG_S0=$((${EPOCHREALTIME/[.,]/} / 1000))
}

progress() { # progress STAGE [DETAIL]
    [ "$PROGRESS" -eq 1 ] || return 0
    progress_stage "$1"
    PROGRESS_OPEN=1
    progress_fit "${2:-}" $((PROG_COLS - 14))
    printf '\r\033[K  %-9s %s' "$1" "$PROG_FIT" >&2
}

# The live case counter. The harness writes one '.' to $IDTC_TICK's descriptor
# after each case it runs; every shard inherits the same pipe, so a one-byte
# write (atomic) from any of them lands in one place and the renderer, a
# background loop here, only counts bytes. Its read times out every tenth of a
# second, which is what limits the redraw rate. The pipe is opened read-write
# so it never reports end of file; progress_stop_ticker kills the loop.
progress_render() { # progress_render TODO CACHED SHARDS
    local todo="$1" got=0 last=-1 chunk bar pad filled note
    note="$2 cached"
    [ "$3" -gt 1 ] && note="$note, $3 shards"
    while :; do
        if [ "$got" -ne "$last" ]; then
            last=$got
            bar=""
            if [ "$PROG_COLS" -ge 70 ]; then
                filled=$((got * 20 / todo))
                printf -v bar '%*s' "$filled" ''
                printf -v pad '%*s' "$((20 - filled))" ''
                bar="[${bar// /#}${pad// /.}] "
            fi
            progress_fit "$bar$got/$todo  ($note)" $((PROG_COLS - 14))
            printf '\r\033[K  %-9s %s' test "$PROG_FIT" >&2
        fi
        read -r -t 0.1 -N 65536 -u "$TICK_FD" chunk
        got=$((got + ${#chunk}))
        [ "$got" -le "$todo" ] || got=$todo
    done
}

progress_start_ticker() { # progress_start_ticker TODO CACHED SHARDS
    [ "$PROGRESS" -eq 1 ] && [ "$1" -gt 0 ] || return 0
    local fifo="$WORK/tick"
    mkfifo "$fifo" 2>/dev/null || return 0
    exec {TICK_FD}<>"$fifo" || { TICK_FD=""; return 0; }
    rm -f "$fifo"
    PROGRESS_OPEN=1
    progress_render "$@" &
    TICK_PID=$!
}

progress_stop_ticker() {
    [ -n "$TICK_PID" ] || return 0
    kill "$TICK_PID" 2>/dev/null
    wait "$TICK_PID" 2>/dev/null
    TICK_PID=""
    [ -z "$TICK_FD" ] || exec {TICK_FD}<&-
    TICK_FD=""
}

# Wipe the line. Called before any real output, and on exit, so nothing is
# ever printed over a partial line and no terminal is left with one. The
# counter loop is stopped first: a redraw after the wipe would land on top of
# the diagnostic that follows.
progress_clear() {
    [ "$PROGRESS" -eq 1 ] && [ "$PROGRESS_OPEN" -eq 1 ] || return 0
    progress_stop_ticker
    printf '\r\033[K' >&2
    PROGRESS_OPEN=0
}

# The last stage's line, then one summary line: what was built, the time the
# whole invocation took, and how many cases ran against how many were cached.
progress_done() { # progress_done SUMMARY
    progress_clear
    [ "$PROGRESS" -eq 1 ] || return 0
    progress_stage ""
    local tail
    progress_secs "$PROG_T0"
    tail="$PROG_FMT total"
    [ -z "$PROG_RAN" ] || tail="$tail, $PROG_RAN cases run, $PROG_CACHED cached"
    progress_fit "$1" $((PROG_COLS - 6 - ${#tail}))
    printf '  %s  (%s)\n' "$PROG_FIT" "$tail" >&2
}

# exit_ok -- every success path below calls this instead of `exit 0`. A
# structural violation recorded along the way (STRUCT_VIOLATIONS) still means
# the whole invocation failed even when everything after it went fine, because
# the driver's own rule was broken, not idlex/idparse's.
exit_ok() {
    [ "$STRUCT_VIOLATIONS" -eq 1 ] && exit 1
    exit 0
}

# check_ok_line -- the one line --check prints on success: the tree, and how
# many functions and test cases its own files (not its dependencies or the
# library) hold. A function ends in exactly one `} return` line and a case is
# a line that starts in column 0 with `(` or `given `.
check_ok_line() {
    local counts
    counts=$(awk '/^\} return/ { f++ } /^\(|^given / { c++ } END { printf "%d functions, %d cases", f, c }' "${OWN_FILES[@]}")
    printf 'ok: %s (%s)\n' "$PATH_ARG" "$counts"
}

stale() { # stale BIN SRC_DIR -- true if BIN is missing or older than any .id under SRC_DIR
    local bin="$1" src="$2"
    [ -x "$bin" ] || return 0
    find "$src" -name '*.id' -newer "$bin" 2>/dev/null | grep -q . && return 0
    return 1
}

# The bootstrap binaries are judged by what went into them, not by file times:
# a stamp beside each holds the sha256 of its inputs (every .id file of a source
# directory with its own hash, or the one .c file, plus the stage-0 binary for
# stage 1), so a workspace refreshed by unpacking identical sources rebuilds
# nothing. The stamp's second line is a signature of the inputs' sizes and
# times, the fast path that skips the hashing; it is compared for equality, not
# for "newer", because a file restored with its old time (cp -p, tar, git) is
# changed content that no -newer test can see.
stamp_sig() { # stamp_sig SRC [EXTRA] -- the inputs' names, sizes and times
    {
        if [ -d "$1" ]; then
            (cd "$1" && find . -type f -name '*.id' -printf '%p %s %T@\n' | LC_ALL=C sort)
        else
            stat -c '%s %Y' "$1"
        fi
        if [ -n "${2:-}" ]; then stat -c '%s %Y' "$2"; fi
    } | sha256sum | cut -d' ' -f1
}

stamp_value() { # stamp_value SRC [EXTRA] -- the inputs' hash; SRC is a directory of .id or one file
    {
        if [ -d "$1" ]; then
            (cd "$1" && find . -type f -name '*.id' -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum)
        else
            sha256sum < "$1"
        fi
        if [ -n "${2:-}" ]; then sha256sum < "$2"; fi
    } | sha256sum | cut -d' ' -f1
}

stamp_write() { # stamp_write BIN SRC [EXTRA] -- record the inputs of a binary that was just built
    printf '%s\n%s\n' "$(stamp_value "$2" "${3:-}")" "$(stamp_sig "$2" "${3:-}")" > "$1.stamp"
}

stamp_stale() { # stamp_stale BIN SRC [EXTRA] -- true unless BIN exists with a stamp equal to its inputs' hash
    local bin="$1" src="$2" extra="${3:-}" stamp="$1.stamp"
    [ -x "$bin" ] || return 0
    [ -f "$stamp" ] || return 0
    local want_sig
    want_sig=$(stamp_sig "$src" "$extra")
    [ "$(sed -n 2p "$stamp")" = "$want_sig" ] && return 1
    if [ "$(stamp_value "$src" "$extra")" = "$(sed -n 1p "$stamp")" ]; then
        printf '%s\n%s\n' "$(sed -n 1p "$stamp")" "$want_sig" > "$stamp"
        return 1
    fi
    return 0
}

boot_stage0() { # boot_stage0 NAME BIN -- compile bootstrap/NAME.c with cc into BIN
    local name="$1" bin="$2" err="$CACHE_DIR/boot.$1.err" rc
    rm -f "$bin.stamp"
    progress bootstrap "${name}0 (from bootstrap/$name.c)"
    capped "$CC" -std=c11 -O2 -o "$bin" "$BOOT_DIR/$name.c" 2>"$err"; rc=$?
    if [ "$rc" -ne 0 ]; then
        progress_clear
        if mem_ceiling_hit "$rc" "$err"; then
            mem_ceiling_error "cc (compiling $BOOT_DIR/$name.c)"
        else
            cat "$err" >&2
            echo "idc: failed to compile $BOOT_DIR/$name.c" >&2
        fi
        return 1
    fi
    stamp_write "$bin" "$BOOT_DIR/$name.c"
}

boot_stage1() { # boot_stage1 NAME SRC BIN STAGE0 -- rebuild a compiler stage from source through stage 0
    local name="$1" src="$2" bin="$3" stage0="$4"
    rm -f "$bin.stamp"
    progress bootstrap "$name (from source, via stage 0)"
    env -u IDC_NO_STD IDC_STAGE_LEX="$STAGE0_LEX" IDC_STAGE_PARSE="$STAGE0_PARSE" \
        "$SCRIPT_DIR/idc" --cc "$CC" "${STD_ARGS[@]}" --allow-untested "$src" -o "$bin" >&2 \
        || { progress_clear; echo "idc: failed to bootstrap $name (needs idstd -- see --std)" >&2; return 1; }
    stamp_write "$bin" "$src" "$stage0"
}

# idc --where NAME [PATH] -- where a function is defined: `FILE:LINE: SIGNATURE ->
# TYPE` for NAME in PATH (a project directory, default the current one), and in
# the standard library when PATH has none. NAME may be FILE::NAME to pick one of
# several by the end of its path. It reads source text and answers without
# parsing, so it takes no build slot and never rebuilds the compiler; tools/idwhere,
# an `id` program, is built and cached the way tools/iddiag is, and rebuilt only
# when its own source changes.
if [ -n "$WHERE" ]; then
    resolve_stdlib
    resolve_tool_std
    IDWHERE="$CACHE_DIR/idwhere"
    if [ ! -x "$IDWHERE" ] || find "$ROOT/tools/idwhere" "$ROOT/tools/lib/fnhead" -name '*.id' -newer "$IDWHERE" 2>/dev/null | grep -q .; then
        "$SCRIPT_DIR/idc" --cc "$CC" "${TOOL_STD_ARGS[@]}" --allow-untested "$ROOT/tools/idwhere" -o "$IDWHERE" >&2 \
            || { echo "idc: failed to build tools/idwhere; see the errors above" >&2; exit 1; }
    fi
    where_roots=("${PATH_ARG:-.}")
    [ -f "$PATH_ARG" ] && where_roots=("$(dirname "$PATH_ARG")")
    [ -n "$STDLIB" ] && where_roots+=("$STDLIB")
    exec "$IDWHERE" "$WHERE" "${where_roots[@]}"
fi

# The bootstrap stages are built WITH the standard library, because they use it:
# both call idstd's `lset`, and each used to carry a private copy of it. The
# rule that made those copies an error is the one-name-one-type rule doing its
# job -- if a dependency already has the function, a program should not define
# it again -- and the compiler does not get an exemption from its own rules.
#
# The cost is real and is the reason this comment is long: `id_development` now
# needs an `idstd` checkout to build its own compiler, and a fresh clone without
# one gets "no such function 'lset'" here rather than a working idc. That is the
# trade taken deliberately. Resolution order is the same as for any program:
# --std, then $IDSTD_HOME, then a sibling idstd/.
#
# Two stages, and the split is the whole point.
#
# STAGE 0 is bootstrap/idlex.c and bootstrap/idparse.c compiled by `cc`. That C
# was emitted by these same two programs, so stage 0 is a working `id` compiler
# obtained without any other compiler -- which is what lets `id` stop shipping
# one. It is a SNAPSHOT: it understands the language as of the commit that
# regenerated it, not as of the working tree.
#
# STAGE 1 is compiler/lex and compiler/parse rebuilt FROM SOURCE through stage
# 0, and it is what every later build actually runs. Nothing but stage 0 is
# frozen, so a change to the compiler takes effect on the next build -- and a
# NEW construct is added in two commits, one teaching the compiler to compile
# it and regenerating stage 0, the next using it.
#
# Stage 1 is this same script, re-entered with the stage pinned, so the source
# is collected, checked and piped exactly as it is for any other project rather
# than through a second copy of that logic. IDC_STAGE_LEX/PARSE at the top of
# the file is where the recursion stops.
if [ -z "${IDC_STAGE_LEX:-}" ]; then
    boot_pid_lex=""; boot_pid_parse=""; boot_failed=0
    if stamp_stale "$STAGE0_LEX" "$BOOT_DIR/idlex.c"; then
        boot_stage0 idlex "$STAGE0_LEX" & boot_pid_lex=$!
    fi
    if stamp_stale "$STAGE0_PARSE" "$BOOT_DIR/idparse.c"; then
        boot_stage0 idparse "$STAGE0_PARSE" & boot_pid_parse=$!
    fi
    [ -z "$boot_pid_lex" ] || wait "$boot_pid_lex" || boot_failed=1
    [ -z "$boot_pid_parse" ] || wait "$boot_pid_parse" || boot_failed=1
    [ "$boot_failed" -eq 0 ] || exit 1
    boot_pid_lex=""; boot_pid_parse=""
    if stamp_stale "$IDLEX" "$ROOT/compiler/lex" "$STAGE0_LEX"; then
        boot_stage1 idlex "$ROOT/compiler/lex" "$IDLEX" "$STAGE0_LEX" & boot_pid_lex=$!
    fi
    if stamp_stale "$IDPARSE" "$ROOT/compiler/parse" "$STAGE0_PARSE"; then
        boot_stage1 idparse "$ROOT/compiler/parse" "$IDPARSE" "$STAGE0_PARSE" & boot_pid_parse=$!
    fi
    [ -z "$boot_pid_lex" ] || wait "$boot_pid_lex" || boot_failed=1
    [ -z "$boot_pid_parse" ] || wait "$boot_pid_parse" || boot_failed=1
    [ "$boot_failed" -eq 0 ] || exit 1
else
    IDLEX="$IDC_STAGE_LEX"
    IDPARSE="$IDC_STAGE_PARSE"
fi

# ---------------------------------------------------------------------------
# Hidden entries are invisible to a project, exactly as in idc.py's
# collect_project, which prunes them from its os.walk: a `.git` beside three
# source directories is not a fourth entry, and nothing under it is source.
# This used to differ -- bin/idc counted and descended into them -- so a
# project with a repository inside it built with one compiler and was rejected
# by the other. Hidden *files* are not pruned; idc.py prunes only dirnames.
#
# collect_ids ROOT -- append every .id file under ROOT to SRC_FILES, in
# idc.py's order (sorted full path, LC_ALL=C to match Python's string sort).
# conf.id is a dependency manifest, not source -- never compiled. backend.id is
# a backend's link facts (see backend_decls), and is not compiled either.
#
# ROOT is also recorded in SRC_ROOTS, in the order roots are added: one root is
# one COMPILATION UNIT (the program's own tree, then each dependency, then the
# standard library and its dependencies), and a unit is the scope of the
# one-type-per-name rule. The compiler cannot see the filesystem, so the unit
# travels to it in the `#file` marker -- see emit_sources.
#
# ROOT/build is pruned too: it is where this driver writes a project's output
# (BUILD_DIR), so it is never source, and a library whose build/ exists beside
# its source -- because someone built it in place -- must compile the same as
# one that was never built.
#
# A directory holding a backend.id is a backend, wherever a collected tree
# holds it, and goes on FOUND_BACKENDS. That is how a library carries the
# backends its modules wrap without naming them: idstd's host/io/fs is a backend
# because its backend.id is there, not because a manifest says so. The other
# way -- a self-relative `import "host/io/fs"` in the library's own conf.id --
# is a second copy of the layout to keep in step with the tree, and would make
# each such subdirectory a compilation unit of its own (a unit is a root; see
# emit_sources). Finding a backend costs a program nothing: what is compiled
# and linked is decided by the natives the build reaches (backends_for).
collect_ids() {
    local root="$1" f
    SRC_ROOTS+=("$root")
    while IFS= read -r f; do
        case "$f" in
            */backend.id) FOUND_BACKENDS+=("${f%/backend.id}") ;;
            *)            SRC_FILES+=("$f") ;;
        esac
    done < <(find "$root" -mindepth 1 \
                 \( -type d -name '.*' -prune \) -o \
                 \( -type d -path "${root%/}/$BUILD_DIR" -prune \) -o \
                 \( -name '*.id' ! -name 'conf.id' -print \) \
            | LC_ALL=C sort)
}

STD_PLAN_MODE=0
STD_PLAN_FILE=""

# std_plan_collect ROOT -- ROOT, the library, as a project of the files and
# constants a plan names (IDC_STD_PLAN, written by run_std_precheck_lazy) in
# place of its whole tree: the library's own check of the functions a program
# reaches, and no others.
std_plan_collect() {
    local root="$1" f entry
    local -a plan_consts
    SRC_ROOTS+=("$root")
    STD_PLAN_FILE="$STD_PLAN_IN"
    while IFS= read -r f; do
        SRC_FILES+=("$f")
    done < <(awk -F'\t' '$1 == "S" { print $2 }' "$STD_PLAN_IN" | LC_ALL=C sort -u)
    while IFS= read -r f; do
        FOUND_BACKENDS+=("${f%/backend.id}")
    done < <(find "$root" -mindepth 1 \
                 \( -type d -name '.*' -prune \) -o \
                 \( -type d -path "${root%/}/$BUILD_DIR" -prune \) -o \
                 \( -name backend.id -print \) | LC_ALL=C sort)
    mapfile -t plan_consts < <(awk -F'\t' '$1 == "K" { print $4 }' "$STD_PLAN_IN")
    for entry in ${plan_consts[@]+"${plan_consts[@]}"}; do
        CONSTS+=("$entry")
    done
}

# ---------------------------------------------------------------------------
# collect .id source files: a single file is just itself; a project directory
# is its whole tree.
SRC_FILES=()
SRC_ROOTS=()
if [ -f "$PATH_ARG" ]; then
    SRC_FILES=("$PATH_ARG")
    SRC_ROOTS=("$PATH_ARG")
elif [ -d "$PATH_ARG" ] && [ -n "$STD_PLAN_IN" ] && [ "$(cd "$PATH_ARG" && pwd -P)" = "$STD_PLAN_ROOT" ]; then
    STD_PLAN_MODE=1
    std_plan_collect "$PATH_ARG"
elif [ -d "$PATH_ARG" ]; then
    collect_ids "$PATH_ARG"
else
    echo "idc: no such file or directory: '$PATH_ARG'" >&2
    exit 1
fi
# The six structural checks (run_idlayout, above). Everything else belongs in idparse.
if [ -d "$PATH_ARG" ]; then
    run_idlayout "$PATH_ARG"
fi

if [ ${#SRC_FILES[@]} -eq 0 ]; then
    echo "idc: no .id files in this project" >&2
    exit 1
fi

OWN_FILES=("${SRC_FILES[@]}")

# Dependencies from the project's conf.id, resolved TRANSITIVELY: every dir is
# merged in as additional id source and has its own conf.id read in turn, and
# a backend dir (backend.id) is also linked. Mirrors idc.py's
# parse_import_manifest + resolve_deps. conf.id lines are
# `import "relative/dir"`.
#
# Transitivity is what lets a library declare its own dependencies. Without it
# a graphics library cannot say it needs backends/gfx -- every program using
# one line of it has to name the backend itself, which is not a library.
#
# SEEN_DEPS holds each resolved path once, which is also what makes a cycle
# (a <-> b) and a diamond terminate rather than recurse forever.
SEEN_DEPS=()

seen_dep() { # seen_dep RESOLVED -- true if already visited
    local d
    for d in ${SEEN_DEPS+"${SEEN_DEPS[@]}"}; do
        [ "$d" = "$1" ] && return 0
    done
    return 1
}

# A constant has one home: the conf.id of the root that declares it. A root can
# be reached more than once -- imported whole, and through one or more of its
# subdirectories -- so CONST_ROOTS holds each resolved directory whose
# constants are already in CONSTS, and CONST_AT maps each name to `manifest:line` for
# each constant taken, so a second declaration of a name is reported at both.
CONST_ROOTS=()
declare -A CONST_AT=()

# seen_const_root RESOLVED -- true if its constants are already taken.
seen_const_root() {
    local d
    for d in ${CONST_ROOTS+"${CONST_ROOTS[@]}"}; do
        [ "$d" = "$1" ] && return 0
    done
    return 1
}

# const_declared_at NAME -- true if NAME was already declared, with where in `at`.
const_declared_at() {
    [ -n "${CONST_AT[$1]+x}" ] || return 1
    at="${CONST_AT[$1]}"
}

# enclosing_root DIR -- the nearest directory strictly above DIR that has a
# conf.id, printed; nothing and false if there is none up to `/`.
#
# This is what "the project a subdirectory belongs to" means, decided from the
# file tree alone: a conf.id is the only thing that marks a root. A root with no
# conf.id declares no constants, so walking past it loses nothing a nearer
# answer would have given. DIR is already resolved (pwd -P), so `..` and
# symlinks cannot make one directory have two enclosing roots.
enclosing_root() {
    local d="$1"
    while [ "$d" != / ]; do
        d="$(dirname "$d")"
        [ -f "$d/conf.id" ] && { printf '%s' "$d"; return 0; }
    done
    return 1
}

# read_manifest DIR [consts] -- process DIR/conf.id, appending source dirs to
# the queue and backends to MANIFEST_BACKENDS. With `consts`, only its
# constants are taken: that is how a subdirectory imported on its own reads
# its enclosing root, whose imports it was imported to leave out.
read_manifest() {
    # Separate statements, not one `local a=… b="$a/…"`: the whole `local`
    # command word-expands before it runs, so the second assignment would read
    # an unset `root` -- which under `set -u` is a hard error, not an empty
    # string.
    local root="$1" mode="${2:-}" lineno=0 line trimmed dep deppath manifest seen_const=0
    local root_key taken=0 name at up
    local const_re='^(int|word|float|string)(\[\])?[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=.*;$'
    manifest="$root/conf.id"
    [ -f "$manifest" ] || return 0
    root_key="$(cd "$root" && pwd -P)"
    if seen_const_root "$root_key"; then
        taken=1
    else
        CONST_ROOTS+=("$root_key")
    fi
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        trimmed="${line#"${line%%[![:space:]]*}"}"
        [ -z "$trimmed" ] && continue
        case "$trimmed" in //*) continue ;; esac
        # lib_exports (the functions a library or wasm build exports) is read
        # by the driver, resolve_export_list, and goes no further: the program
        # never sees it, so no compiler rule can object to it, and a library
        # that imports another library's tree does not collide with that
        # library's own list. Constants come after imports: a reader sees where the code comes
        # from before what it is configured with. They are collected here and
        # injected into the source stream by emit_sources, because idparse is
        # what checks and emits them and `id` cannot read a file.
        if [[ "$trimmed" =~ $const_re ]]; then
            seen_const=1
            [ "$taken" -eq 1 ] && continue
            name="${BASH_REMATCH[3]}"
            if [ "$name" = lib_exports ]; then
                if [ "${BASH_REMATCH[1]}${BASH_REMATCH[2]}" != "string[]" ]; then
                    echo "idc: $manifest:$lineno: lib_exports must be a list of strings, \`string[] lib_exports = [\"first_fn\", \"second_fn\"];\`, on one line; '$trimmed' is not" >&2
                    STRUCT_VIOLATIONS=1
                fi
                continue
            fi
            if const_declared_at "$name"; then
                echo "$manifest:$lineno: error: constant '$name' is already declared at $at; a constant has one home -- rename one of them" >&2
                STRUCT_VIOLATIONS=1
                continue
            fi
            CONST_AT[$name]="$manifest:$lineno"
            CONSTS+=("$trimmed")
            continue
        fi
        if [ "$seen_const" -eq 1 ] && [ "$taken" -eq 0 ]; then
            # Ordering only, not content: the import below is perfectly
            # resolvable, so recording this and still resolving it costs
            # nothing -- unlike a missing directory or a malformed line, where
            # continuing would mean guessing at a dependency that was never
            # named.
            echo "idc: $manifest:$lineno: imports come before constants in conf.id; '$trimmed' follows a constant declaration" >&2
            STRUCT_VIOLATIONS=1
        fi
        dep=$(printf '%s' "$trimmed" \
            | sed -n 's/^import[[:space:]]*"\([^"]*\)"[[:space:]]*$/\1/p')
        if [ -z "$dep" ]; then
            echo "idc: $manifest:$lineno: malformed line: $trimmed" >&2
            echo "idc: each dependency is a line:  import \"relative/dir\", and each" >&2
            echo "idc: constant a line:  int name = value;" >&2
            exit 2
        fi
        [ "$mode" = consts ] && continue
        # An absolute dependency path is used as it stands. It used to be
        # pasted onto the project root unconditionally, which turned every
        # absolute import into a path that does not exist -- reported, wrongly,
        # as "is not a directory" about a directory that is one. idc.py accepts
        # both forms (os.path.join drops the left side of an absolute right
        # side), so this is the same rule, spelled out.
        case "$dep" in
            /*) deppath="$dep" ;;
            *)  deppath="$root/$dep" ;;
        esac
        if [ ! -d "$deppath" ]; then
            echo "idc: $manifest:$lineno: import \"$dep\": no such directory: $deppath" >&2
            exit 1
        fi
        deppath="$(cd "$deppath" && pwd -P)"
        seen_dep "$deppath" && continue
        SEEN_DEPS+=("$deppath")
        # A backend is a dependency like any other: its .id files -- the
        # `native` declarations of what it links -- are merged as source under
        # the same limits, and collect_ids finds its backend.id.
        run_idlayout "$deppath"
        collect_ids "$deppath"
        DEP_QUEUE+=("$deppath")
        if [ ! -f "$deppath/conf.id" ] && up=$(enclosing_root "$deppath"); then
            read_manifest "$up" consts
        fi
    done < "$manifest"
}

# walk_deps ROOT -- read ROOT's manifest and every manifest it reaches.
walk_deps() {
    DEP_QUEUE=()
    read_manifest "$1"
    while [ "${#DEP_QUEUE[@]}" -gt 0 ]; do
        local next="${DEP_QUEUE[0]}"
        DEP_QUEUE=("${DEP_QUEUE[@]:1}")
        read_manifest "$next"
    done
}

if [ -d "$PATH_ARG" ]; then
    SEEN_DEPS=("$(cd "$PATH_ARG" && pwd -P)")
    [ "$STD_PLAN_MODE" -eq 1 ] || walk_deps "$PATH_ARG"
fi

# A --backend directory is merged exactly as a conf.id import of it is, so a
# call into it is checked against its declarations however it was attached.
# seen_dep keeps a backend named both ways to one copy of its source.
for b in ${BACKENDS[@]+"${BACKENDS[@]}"}; do
    [ -d "$b" ] || { echo "idc: --backend: no such directory: $b" >&2; exit 1; }
    b="$(cd "$b" && pwd -P)"
    seen_dep "$b" && continue
    SEEN_DEPS+=("$b")
    run_idlayout "$b"
    collect_ids "$b"
    walk_deps "$b"
done

# cache_prune DIR MAX -- keep only the MAX most-recently-touched entries
# directly under DIR, deleting the rest, so neither cache below can grow
# without bound. Recency is mtime, and a hit touch(1)es its entry, so "most
# recently touched" is "most recently reused or created".
cache_prune() {
    local dir="$1" max="$2"
    [ -d "$dir" ] || return 0
    find "$dir" -mindepth 1 -maxdepth 1 -printf '%T@ %p\n' 2>/dev/null \
        | LC_ALL=C sort -rn | tail -n +"$((max + 1))" | cut -d' ' -f2- \
        | while IFS= read -r old; do rm -rf "$old"; done
}

# ---------------------------------------------------------------------------
# The standard library is loaded by use.
#
# idstd is implicit in every build, but a build parses, checks and compiles
# only the part of it the program reaches. Parsing all of it cost 0.3 s on a
# four-line program and grew with the library. Three things make that sound:
#
#   * an INDEX of the library, built once per content and kept in $STD_IDX_BASE
#     (default $CACHE_DIR/stdidx). idparse --index reads each source file and
#     writes, per function, native and struct: its name, file and line, its
#     fingerprints, the names its body reaches and the names its cases reach,
#     its exports and its variables. A file's records are kept under that
#     file's content hash, so a changed file is the only one re-read, and a
#     moved file is not re-read at all: a record carries no path, the path is
#     put back when the index is assembled.
#   * a PLAN per build: the program's own tokens name what it reaches (every
#     identifier, which over-reaches harmlessly), and the index's edges give
#     the closure. The plan lists the line ranges of the library files to
#     load, so a function nothing reaches is blank lines in the stream and is
#     never parsed. A function loaded here has its cases cut: the library's
#     own cases are never run in a program's harness.
#   * the rest of the index goes to idparse as `ext` lines ahead of the tokens,
#     for the two checks that compare the program against functions it did not
#     load: duplicate logic and import-duplicates. A name collision needs no
#     such line: a name the program writes is an identifier, so the function
#     it collides with is reached and loaded, and the ordinary check finds it.
#
# IDC_STD_FULL=1 turns all of it off and merges the whole library as before.
# So does a build that lists or rewrites the library (--fingerprints, --calls,
# --list-untested, --fix, --emit-sources), the compiler's own stage builds, a
# program that lives inside the library's own tree (its files would be both the
# program's and the library's), and a library the index cannot describe (a syntax
# error, an asm declaration, a name defined twice, a conf.id line that is not a
# constant).
STD_CONF_DIR=""
STD_LAZY=0
STD_IDX_BASE="${IDC_STD_IDX_DIR:-$CACHE_DIR/stdidx}"
STD_IDX=""
STD_PKEY=""
EXT_HEAD=""
EXT_STREAM=""
EXT_ID=""

std_lazy_wanted() {
    [ -n "$STDLIB" ] || return 1
    [ -z "${IDC_STD_FULL:-}" ] || return 1
    [ -z "${IDC_NO_CACHE:-}" ] || return 1
    [ -z "${IDC_STAGE_LEX:-}" ] || return 1
    [ "$FINGERPRINTS$CALLS$LIST_UNTESTED$FIX$EMIT_SOURCES" = 00000 ] || return 1
    [ -x "$IDLEX" ] && [ -x "$IDPARSE" ] || return 1
    local r
    for r in "${SRC_ROOTS[@]}"; do
        [ -d "$r" ] || r=$(dirname "$r")
        r=$(cd "$r" 2>/dev/null && pwd -P) || continue
        case "$r/" in "$STDLIB"/*) return 1 ;; esac
    done
    return 0
}

# std_source_list -- the library's source files exactly as collect_ids would
# list them, less the backend.id files it files separately.
std_source_list() {
    find "$STDLIB" -mindepth 1 \
         \( -type d -name '.*' -prune \) -o \
         \( -type d -path "${STDLIB%/}/$BUILD_DIR" -prune \) -o \
         \( -name '*.id' ! -name 'conf.id' ! -name 'backend.id' -print \) \
        | LC_ALL=C sort
}

# std_consts_k -- the library's conf.id as K records: `K NAME LINE EDGES TEXT`,
# one per constant, EDGES the other constants its initialiser names. Exit 3 for
# a line that is not a constant on one line, which the index cannot carry.
std_consts_k() {
    [ -f "$STD_CONF_DIR/conf.id" ] || return 0
    awk '
        BEGIN { FS = "\t"; OFS = "\t" }
        {
            t = $0
            sub(/^[ \t]+/, "", t); sub(/[ \t]+$/, "", t)
            if (t == "" || t ~ /^\/\//) next
            if (t ~ /^(int|word|float|string)(\[\])?[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=.*;$/) {
                head = t; sub(/[ \t]*=.*$/, "", head)
                m = split(head, hw, /[ \t]+/)
                if (hw[m] == "lib_exports") next
                k++; NM[k] = hw[m]; TX[k] = t; LN[k] = FNR; IS[hw[m]] = 1
                next
            }
            bad = 1
        }
        END {
            if (bad) exit 3
            for (k = 1; k <= length(NM); k++) {
                rhs = TX[k]; sub(/^[^=]*=/, "", rhs)
                m = split(rhs, w, /[^A-Za-z0-9_]+/)
                e = ""
                for (i = 1; i <= m; i++) if (w[i] in IS && w[i] != NM[k] && index(" " e " ", " " w[i] " ") == 0) e = e " " w[i]
                print "K", NM[k], LN[k], substr(e, 2), TX[k]
            }
        }' "$STD_CONF_DIR/conf.id"
}

# std_index_build BASE MAP TMP -- idparse --index over the files of MAP (`PATH
# TAB HASH` lines) that have no records yet, and the records filed under their
# hashes. 0 done, 3 the library cannot be indexed, anything else a failure
# that may not recur.
std_index_build() {
    local base="$1" map="$2" tmp="$3" miss="$3/idx.miss" src="$3/idx.src" rc f
    awk -F'\t' -v dir="$base/shards" '
        BEGIN { cmd = "ls \"" dir "\" 2>/dev/null"; while ((cmd | getline h) > 0) have[h] = 1; close(cmd) }
        !($2 in have) { print }' "$map" > "$miss"
    [ -s "$miss" ] || return 0
    std_consts_k > "$tmp/idx.consts"
    [ $? -eq 0 ] || return 3
    {
        awk -F'\t' '{ printf "#const\n%s\n", $5 }' "$tmp/idx.consts"
        awk -F'\t' '{ printf "#file 0|%s\n", $1; while ((getline line < $1) > 0) print line; close($1); print "" }' "$miss"
    } > "$src"
    capped_from "$src" "$IDLEX" > "$tmp/idx.lex" 2>/dev/null || return 1
    capped_from "$tmp/idx.lex" "$IDPARSE" --triple "$(host_triple)" --index > "$tmp/idx.out" 2>/dev/null
    awk -v map="$miss" -v dir="$base/shards" -v pid="$$" '
        BEGIN { FS = "\t"; while ((getline l < map) > 0) { split(l, a, "\t"); H[a[1]] = a[2] } }
        /^\/\* ---- index ---- \*\/$/ { on = 1; next }
        on == 0 { next }
        $1 == "@" { cur = $2; next }
        $1 == "Z" { bad = bad $2 " "; next }
        $1 == "F" { OWN[$2] = cur; B[cur] = B[cur] $0 "\n"; next }
        $1 == "X" || $1 == "V" { XV[++nxv] = $0; next }
        { B[cur] = B[cur] $0 "\n" }
        END {
            if (!on) exit 2
            if (bad != "") exit 3
            for (i = 1; i <= nxv; i++) { split(XV[i], f, "\t"); p = OWN[f[2]]; if (p != "") B[p] = B[p] XV[i] "\n" }
            for (p in H) { out = dir "/" H[p] ".tmp." pid; printf "%s", B[p] > out; close(out) }
        }' "$tmp/idx.out"
    rc=$?
    [ "$rc" -eq 0 ] || return "$rc"
    for f in "$base/shards/"*".tmp.$$"; do
        [ -e "$f" ] && mv -f "$f" "${f%.tmp.$$}"
    done
    return 0
}

# std_index_assemble BASE MAP KEY TMP -- the records of every file, in path
# order, as the three files a build reads: graph (the edges and extents, for
# the plan), ext (the lines idparse is handed) and full (everything, for a
# reader). 0 done, 3 the library cannot be indexed.
std_index_assemble() {
    local base="$1" map="$2" key="$3" out="$1/idx/$3.tmp.$$" rc
    local -a args
    cut -f2 "$map" | LC_ALL=C sort | uniq -d | grep -q . && return 3
    mkdir -p "$out" || return 1
    mapfile -t args < <(awk -F'\t' -v dir="$base/shards" '{ print dir "/" $2 }' "$map")
    [ "${#args[@]}" -gt 0 ] || return 1
    awk -v list="$map" -v dir="$base/shards" -v graph="$out/graph" -v full="$out/full" -v ext="$out/ext" '
        BEGIN {
            FS = "\t"; OFS = "\t"
            while ((getline l < list) > 0) { split(l, a, "\t"); PATHOF[dir "/" a[2]] = a[1]; HASHOF[a[1]] = a[2] }
        }
        FNR == 1 { path = PATHOF[FILENAME] }
        $1 == "F" { id = ++n; NAME[id] = $2; KIND[id] = $3; FILE[id] = path; LINE[id] = $4; CEND[id] = $5; NF_[path] = NF_[path] " " id; FPN[id] = 0; next }
        $1 == "P" { FPN[id]++; PK[id, FPN[id]] = $2; FP[id, FPN[id]] = $3; next }
        $1 == "I" { IK[id] = $2; IN[id] = $3; next }
        $1 == "D" { DE[id] = $2; next }
        $1 == "C" { CE[id] = $2; next }
        $1 == "X" { XO[++nx] = $2; XNM[nx] = $3; XTY[nx] = $4; next }
        $1 == "V" { VROWS[++nv] = $0; next }
        END {
            lastf = ""
            for (id = 1; id <= n; id++) {
                if (NAME[id] in SEEN) exit 4
                SEEN[NAME[id]] = 1
                if ((FILE[id] SUBSEP LINE[id]) in AT) exit 4
                AT[FILE[id], LINE[id]] = 1
                nxt = 0
                m = split(NF_[FILE[id]], ids, " ")
                for (j = 1; j <= m; j++) { o = ids[j]; if (o != id && LINE[o] > LINE[id] && (nxt == 0 || LINE[o] < nxt)) nxt = LINE[o] }
                fend = (nxt > 0) ? nxt - 1 : 0
                bend = (CEND[id] > 0) ? CEND[id] : fend
                sig = ""
                if (FPN[id] > 0) { sig = FP[id, 1]; sub(/^[^|]*\|/, "", sig); sub(/=>.*/, "", sig) }
                print "E", id, NAME[id], KIND[id], FILE[id], LINE[id], bend, fend, DE[id], CE[id], HASHOF[FILE[id]] > graph
                print "F", NAME[id], KIND[id], FILE[id], LINE[id], CEND[id], sig > full
                if (FILE[id] != lastf) { printf "ext Z\t%s\n", FILE[id] > ext; lastf = FILE[id] }
                printf "ext F\t%s\t%s\t%s\n", NAME[id], KIND[id], LINE[id] > ext
                for (k = 1; k <= FPN[id]; k++) { printf "ext P\t%s\n", PK[id, k] > ext; print "P", PK[id, k], FP[id, k] > full }
                if (IK[id] != "") { printf "ext I\t%s\t%s\n", IK[id], IN[id] > ext; print "I", IK[id], IN[id] > full }
            }
            for (k = 1; k <= nx; k++) { print "X", XNM[k], XO[k] > graph; print "X", XO[k], XNM[k], XTY[k] > full }
            for (id = 1; id <= n; id++) FILEOF[NAME[id]] = FILE[id]
            for (k = 1; k <= nv; k++) {
                print VROWS[k] > full
                split(VROWS[k], vf, "\t")
                if (!(vf[3] in VSEEN) && (vf[2] in FILEOF)) { VSEEN[vf[3]] = 1; printf "ext V\t%s\t%s\t%s\t%s\n", vf[3], vf[4], FILEOF[vf[2]], vf[5] > ext }
            }
        }' "${args[@]}"
    rc=$?
    [ "$rc" -eq 0 ] || { rm -rf "$out"; return 3; }
    cat "$4/idx.consts" >> "$out/graph" 2>/dev/null
    printf ok > "$out/ok"
    mv -T "$out" "$STD_IDX" 2>/dev/null || { rm -rf "$out"; [ -f "$STD_IDX/ok" ]; }
}

# std_index_ensure -- STD_IDX, the index of the library as it is now, built
# if no build has yet. False when the library cannot be indexed: the caller
# merges it whole.
std_index_ensure() {
    local cid base tmp map files conf key sig rc=0
    cid=$({ sha256sum < "$IDLEX"; sha256sum < "$IDPARSE"; } | sha256sum | cut -c1-16)
    base="$STD_IDX_BASE/$cid"
    mkdir -p "$base/shards" "$base/idx" "$base/bad" "$base/stat" 2>/dev/null || return 1
    sig=$({ find "$STDLIB" -mindepth 1 \
              \( -type d -name '.*' -prune \) -o \
              \( -type d -path "${STDLIB%/}/$BUILD_DIR" -prune \) -o \
              \( -name '*.id' ! -name 'backend.id' -printf '%p\0%s\0%T@\0%C@\0' \)
            [ "$STD_CONF_DIR" = "$STDLIB" ] || find "$STD_CONF_DIR" -maxdepth 1 -name conf.id -printf '%p\0%s\0%T@\0%C@\0'
          } | LC_ALL=C sort -z | sha256sum | cut -c1-40)
    if [ -f "$base/stat/$sig" ]; then
        STD_IDX="$base/idx/$(cat "$base/stat/$sig")"
        if [ -f "$STD_IDX/ok" ]; then touch "$base/stat/$sig"; return 0; fi
    fi
    tmp=$(mktemp -d) || return 1
    map="$tmp/std.map"; files="$tmp/std.files"
    std_source_list > "$files"
    if [ ! -s "$files" ]; then rm -rf "$tmp"; return 1; fi
    xargs -d '\n' -r sha256sum < "$files" | awk '{ h = $1; sub(/^[0-9a-f]+  /, ""); printf "%s\t%s\n", $0, h }' > "$map"
    conf=""
    [ -f "$STD_CONF_DIR/conf.id" ] && conf=$(sha256sum < "$STD_CONF_DIR/conf.id")
    key=$({ printf 'v1\n%s\n' "$conf"; cat "$map"; } | sha256sum | cut -c1-40)
    STD_IDX="$base/idx/$key"
    if [ -f "$STD_IDX/ok" ]; then printf '%s' "$key" > "$base/stat/$sig"; rm -rf "$tmp"; return 0; fi
    if [ -f "$base/bad/$key" ]; then rm -rf "$tmp"; return 1; fi
    progress index "the standard library"
    std_index_build "$base" "$map" "$tmp"; rc=$?
    if [ "$rc" -eq 0 ]; then
        [ -f "$tmp/idx.consts" ] || std_consts_k > "$tmp/idx.consts" || rc=3
    fi
    [ "$rc" -eq 0 ] && { std_index_assemble "$base" "$map" "$key" "$tmp"; rc=$?; }
    progress_clear
    [ "$rc" -eq 3 ] && : > "$base/bad/$key"
    rm -rf "$tmp"
    cache_prune "$STD_IDX_BASE" 4
    cache_prune "$base/idx" 8
    cache_prune "$base/shards" 8000
    cache_prune "$base/stat" 64
    [ "$rc" -eq 0 ] && [ -f "$STD_IDX/ok" ] || return 1
    printf '%s' "$key" > "$base/stat/$sig"
}

# std_closure MODE ROOTS GRAPH -- the plan, on stdout: what the names in ROOTS
# reach through GRAPH's edges. Mode A is what a program needs, a function's
# body; mode B is what its cases need as well, which is what the library's own
# check of those functions loads. A plan is lines of
#   S PATH FROM TO HASH    a range of a file, and that file's content hash
#   K NAME LINE TEXT       a constant, in conf.id order
#   L NAME ...             the names loaded, a hundred to a line
std_closure() {
    awk -v mode="$1" -v roots="$2" '
        function push(id) { if (!(id in VIS)) { VIS[id] = 1; Q[++qn] = id } }
        function pushc(c) { if (!(c in CVIS)) { CVIS[c] = 1; CQ[++cn] = c } }
        function want(n,   o) {
            if (n in BYNAME) push(BYNAME[n])
            else if (n in OWNER) { o = OWNER[n]; if (o in BYNAME) push(BYNAME[o]) }
            else if (n in KT) pushc(n)
        }
        BEGIN { FS = "\t"; OFS = "\t" }
        $1 == "E" { NAME[$2] = $3; PATH[$2] = $5; LINE[$2] = $6; BEND[$2] = $7; FEND[$2] = $8; DE[$2] = $9; CE[$2] = $10; HASH[$2] = $11; BYNAME[$3] = $2; next }
        $1 == "X" { OWNER[$2] = $3; next }
        $1 == "K" { KT[$2] = $5; KE[$2] = $4; KL[$2] = $3; KORD[++nk] = $2; next }
        END {
            while ((getline r < roots) > 0) want(r)
            qh = 1; ch = 1
            while (qh <= qn || ch <= cn) {
                while (qh <= qn) {
                    id = Q[qh++]
                    m = split(DE[id], w, " "); for (i = 1; i <= m; i++) want(w[i])
                    if (mode == "B") { m = split(CE[id], w, " "); for (i = 1; i <= m; i++) want(w[i]) }
                }
                while (ch <= cn) {
                    c = CQ[ch++]
                    m = split(KE[c], w, " "); for (i = 1; i <= m; i++) want(w[i])
                }
            }
            for (id = 1; id in NAME; id++) if (id in VIS) {
                to = (mode == "B") ? FEND[id] : BEND[id]
                if (to == 0) to = 999999999
                print "S", PATH[id], LINE[id], to, HASH[id]
                nm = nm " " NAME[id]
                if (++cnt % 100 == 0) { print "L", substr(nm, 2); nm = "" }
            }
            for (o = 1; o <= nk; o++) if (KORD[o] in CVIS) {
                print "K", KORD[o], KL[KORD[o]], KT[KORD[o]]
                nm = nm " " KORD[o]
                if (++cnt % 100 == 0) { print "L", substr(nm, 2); nm = "" }
            }
            if (nm != "") print "L", substr(nm, 2)
        }' "$3"
}

# std_lazy_plan -- once the program's own files and constants are known and
# emit_sources exists: lex the program alone, take its identifiers for roots,
# and add what the plan loads to SRC_FILES and CONSTS. Sets STD_PLAN_FILE,
# STD_PKEY, EXT_HEAD, EXT_STREAM and EXT_ID. The plan is a pure function of the
# program's own stream, the index and the names conf.id's lib_exports lists
# (they are functions of the program that no token of it spells), so it is kept
# under the hash of those and a build of an unchanged program does not lex or
# search again. False, with nothing changed, when it cannot be done.
std_lazy_plan() {
    local progsrc="$WORK/prog.src" roots="$WORK/roots" plan="$WORK/std.plan" pdir pkey name line entry exports=""
    local -a std_paths std_consts
    emit_sources > "$progsrc"
    if [ -d "$PATH_ARG" ] && grep -q lib_exports "$PATH_ARG/conf.id" 2>/dev/null; then
        exports=$(sed 's://.*$::' "$PATH_ARG/conf.id" | awk '/^string\[\][ \t]+lib_exports[ \t]*=/ {on=1} on {print} on && /;/ {exit}' | grep -oE '"[^"]*"' | tr -d '"')
    fi
    pdir="${STD_IDX%/idx/*}/plans"
    pkey=$({ cat "$progsrc"; printf '\0plan-v1\0%s\0%s\0' "${STD_IDX##*/}" "$exports"; } | sha256sum | cut -c1-40)
    STD_PKEY="$pkey"
    if [ -f "$pdir/$pkey" ]; then
        cp "$pdir/$pkey" "$plan" && touch "$pdir/$pkey"
    else
        { capped_from "$progsrc" "$IDLEX" 2>/dev/null | awk '$1 == "ident" { print $2 }'; printf '%s\n' $exports; } | LC_ALL=C sort -u > "$roots"
        std_closure A "$roots" "$STD_IDX/graph" > "$plan" || return 1
        mkdir -p "$pdir" && cp "$plan" "$pdir/$pkey.tmp.$$" && mv -f "$pdir/$pkey.tmp.$$" "$pdir/$pkey"
        cache_prune "$pdir" 300
    fi
    if [ "${#CONST_AT[@]}" -gt 0 ] && ! seen_const_root "$STD_CONF_DIR"; then
        while IFS=$'\t' read -r _ name line _; do
            if const_declared_at "$name"; then
                echo "$STD_CONF_DIR/conf.id:$line: error: constant '$name' is already declared at $at; a constant has one home -- rename one of them" >&2
                STRUCT_VIOLATIONS=1
            fi
        done < <(awk -F'\t' '$1 == "K"' "$STD_IDX/graph")
    fi
    [ -z "${IDC_TIMES:-}" ] || echo "idc: times: stdlib: $(grep -c '^S' "$plan") of $(grep -c '^E' "$STD_IDX/graph") functions loaded" >&2
    mapfile -t std_paths < <(awk -F'\t' '$1 == "S" { print $2 }' "$plan" | LC_ALL=C sort -u)
    mapfile -t std_consts < <(awk -F'\t' '$1 == "K" { print $2 "\t" $4 }' "$plan")
    if ! seen_const_root "$STD_CONF_DIR"; then
        for entry in ${std_consts[@]+"${std_consts[@]}"}; do
            const_declared_at "${entry%%$'\t'*}" || CONSTS+=("${entry#*$'\t'}")
        done
    fi
    SRC_FILES+=(${std_paths[@]+"${std_paths[@]}"})
    mapfile -t SRC_FILES < <(printf '%s\n' "${SRC_FILES[@]}" | LC_ALL=C sort -u)
    STD_PLAN_FILE="$plan"
    EXT_HEAD="$WORK/ext.head"
    { printf 'ext M\tlazy\n'; awk -F'\t' '$1 == "L" { print "ext L\t" $2 }' "$plan"; } > "$EXT_HEAD"
    EXT_STREAM="$STD_IDX/ext"
    EXT_ID="${STD_IDX##*/}"
}

# ---------------------------------------------------------------------------
# The standard library, imported by DEFAULT -- no conf.id line, no flag. It
# is merged exactly like a source dependency: same layout checks, and its
# own conf.id is followed. The backends it carries are found by their
# backend.id (collect_ids), so every program has them and none links one it
# does not reach.
#
# A checkout with no idstd beside it has no standard library, and that is not
# an error -- the compiler has to keep building the language's own bootstrap
# in a tree where it does not exist. resolve_stdlib (above, shared with
# --print-std) answers which directory, if any; this collects its source.
#
# STD_UNIT_START is recorded here, before the merge below runs: every root
# SRC_ROOTS gains from this point on -- STDLIB itself and everything its own
# conf.id reaches -- is the library, and nothing gained before it (the
# project's own tree, its own dependencies, an explicit --backend) is. It is
# the compilation-unit index (the `#file N|PATH` marker's N, emit_sources
# above) a --std-unit N passed to idparse means "at or past this is the
# library" by (back/drive/target/tests/ + mid/names/symbols/lookup/more/
# std_unit.id's case_is_std): when STDLIB is already one of SRC_ROOTS --
# building the library itself, PATH_ARG resolved to it -- seen_dep skips the
# merge and no more roots are gained, so the boundary excludes nothing and
# every one of the library's own cases stays seeded, which is what its own
# build (and bin/idc's pre-check of it, below) needs.
resolve_stdlib
STD_CONF_DIR="$STDLIB"
[ -n "$STDLIB" ] && [ -n "${IDC_STD_CONF_DIR:-}" ] && STD_CONF_DIR="$(cd "$IDC_STD_CONF_DIR" && pwd -P)"
STD_UNIT_START=${#SRC_ROOTS[@]}
if [ -n "$STDLIB" ]; then
    if ! seen_dep "$STDLIB"; then
        SEEN_DEPS+=("$STDLIB")
        run_idlayout "$STDLIB"
        if std_lazy_wanted && std_index_ensure; then
            STD_LAZY=1
            SRC_ROOTS+=("$STDLIB")
            while IFS= read -r f; do
                FOUND_BACKENDS+=("${f%/backend.id}")
            done < <(find "$STDLIB" -mindepth 1 \
                         \( -type d -name '.*' -prune \) -o \
                         \( -type d -path "${STDLIB%/}/$BUILD_DIR" -prune \) -o \
                         \( -name backend.id -print \) | LC_ALL=C sort)
        else
            collect_ids "$STDLIB"
            if [ "$STD_CONF_DIR" = "$STDLIB" ]; then walk_deps "$STDLIB"; else read_manifest "$STD_CONF_DIR" consts; fi
        fi
    fi
fi

# ---------------------------------------------------------------------------
# A directory with a backend.id is a library exactly like the stdlib: its own
# cases must not run in the harness of whatever imports it, and a failure in
# them is the backend's fault, never the program's (run_lib_precheck,
# further down). STD_UNIT_START's boundary already covers a backend merged
# into the stdlib's own range by directory walk alone (collect_ids's
# FOUND_BACKENDS comment, above) -- idstd's host/io/fs is such a backend, and
# every one of its cases is already >= STD_UNIT_START. What it cannot name is
# a backend that is its own compilation unit -- --backend, or a conf.id
# import, by the project or one of its dependencies (or, in principle, the
# stdlib's own conf.id) -- outside that range: a --no-std program importing
# idstd's fs backend directly is exactly this, and STDLIB is "" there, so the
# boundary excludes nothing at all.
#
# BACKENDS and FOUND_BACKENDS are both final now (every collect_ids call that
# can add to either has already run, above), and so is SRC_ROOTS, so this can
# answer "which unit is DIR" before PARSE_ARGS is built. backend_lib_scan
# resolves DIR against SRC_ROOTS the same way backend_of does further down
# (Native backends, below) -- that section runs later and reads BACKENDS/
# FOUND_BACKENDS afresh, so duplicating the resolve here costs nothing it
# would otherwise share.
#
# EXCLUDE_UNITS is passed to idparse as --exclude-units, a comma-joined list
# (mid/names/symbols/lookup/more/std_unit.id's unit_excluded) -- chosen over
# repeating --std-unit's single-boundary flag because these units are not a
# contiguous range the way the stdlib's own is. LIB_PRECHECK_DIRS/_UNITS are
# the subset that also has id code to pre-check (run_lib_precheck, run
# alongside run_std_precheck, below) -- a pure-native backend (backend.id
# plus only a C/H source) has no cases to fail, so it is excluded from the
# harness the same way but never built again just to find that out.
EXCLUDE_UNITS=()
LIB_PRECHECK_DIRS=()
LIB_PRECHECK_UNITS=()
# PATH_ARG_KEY -- PATH_ARG resolved, the same way run_std_precheck's own
# path_key is (below): a backend directory built AS ITSELF (bin/idc
# recursing into one, from run_backend_prechecks, or a user building it
# directly) must run every one of its own cases as itself, the same reason
# STD_UNIT_START's own comment gives for the stdlib -- excluding it here
# would leave its own pre-check nothing to run and every rc=0 regardless of
# what its cases say.
PATH_ARG_KEY=""
[ -d "$PATH_ARG" ] && PATH_ARG_KEY="$(cd "$PATH_ARG" && pwd -P)"
backend_lib_scan() { # backend_lib_scan DIR
    local d="$1" real i r unit=-1 u
    real=$(cd "$d" 2>/dev/null && pwd -P) || return 0
    [ "$real" = "$PATH_ARG_KEY" ] && return 0
    for i in "${!SRC_ROOTS[@]}"; do
        r=$(cd "${SRC_ROOTS[$i]}" 2>/dev/null && pwd -P) || continue
        [ "$r" = "$real" ] && { unit=$i; break; }
    done
    [ "$unit" -ge 0 ] || return 0
    [ -n "$STDLIB" ] && [ "$unit" -ge "$STD_UNIT_START" ] && return 0
    for u in ${EXCLUDE_UNITS[@]+"${EXCLUDE_UNITS[@]}"}; do
        [ "$u" = "$unit" ] && return 0
    done
    EXCLUDE_UNITS+=("$unit")
    if find "$real" -mindepth 1 \
            \( -type d -name '.*' -prune \) -o \
            \( -type d -path "${real%/}/$BUILD_DIR" -prune \) -o \
            \( -name '*.id' ! -name 'backend.id' ! -name 'conf.id' -print -quit \) \
         | grep -q .; then
        LIB_PRECHECK_DIRS+=("$real")
        LIB_PRECHECK_UNITS+=("$unit")
    fi
}
for b in ${BACKENDS[@]+"${BACKENDS[@]}"} ${FOUND_BACKENDS[@]+"${FOUND_BACKENDS[@]}"}; do
    backend_lib_scan "$b"
done

# One global sort over every source file, project and dependencies together,
# and one dedupe -- exactly idc.py's `sorted(set(source_files))`.
#
# This used to be a concatenation of per-root sorted lists, which agreed with
# idc.py only as long as no project had a source dependency. It cannot stay
# that way now that the standard library is a source dependency of EVERY
# build: the project's paths arrive as the user spelled them (usually
# relative) and a dependency's are resolved absolute, so '/' sorting before a
# letter puts the stdlib first under a global sort and last under a
# concatenation. File order decides the order of functions in the emitted C,
# so the two compilers would stop being byte-identical on every program at
# once. LC_ALL=C to match Python's byte-wise string sort.
if [ "${#SRC_FILES[@]}" -gt 0 ]; then
    mapfile -t SRC_FILES < <(printf '%s\n' "${SRC_FILES[@]}" | LC_ALL=C sort -u)
fi

# Per-unit C compilation (unit_build, below): idparse marks where each source
# file's functions begin (--units), and the C is compiled as a handful of
# translation units cached one by one, so an edit recompiles the unit it is
# in. Off with the caches (IDC_NO_CACHE) and under IDC_UNITS=0. The driver's
# own compiler stages use them too: a cold bootstrap is the one build that is
# too long to start over, and a run stopped part way keeps every unit it had
# finished. A stage 0 that predates --units writes no markers, unit_build then
# says no, and the stage is compiled whole as it always was.
# (Measured on idparse itself, built both ways from the same C: 7.75 s and
# 7.78 s on the same input, so units cost the program nothing measurable.)
UNITS_ON=1
[ "${IDC_UNITS:-1}" = 0 ] && UNITS_ON=0
[ -n "${IDC_NO_CACHE:-}" ] && UNITS_ON=0

PARSE_ARGS=()
# The target triple selects among a program's `asm` overloads, and is always
# passed: leaving it out let idparse's own default answer the question, which
# is how the driver and the compiler came to disagree about the platform.
PARSE_ARGS+=(--triple "$TRIPLE")
# Every function must carry at least two test cases (docs/TESTS.md). On unless
# --allow-untested turned it off; the self-hosted compiler checks it.
#
# --calls is the exception: agents use it to find what to test next, in a
# tree that is short of cases by construction, so requiring cases here would
# fail on exactly the functions it exists to point at.
if [ "$REQUIRE_TESTS" -eq 1 ] && [ "$CALLS" -eq 0 ]; then
    PARSE_ARGS+=(--require-tests)
fi
# --fingerprints is a report about the parsed program, not a build of it -- see
# the note where the pipeline's exit codes are handled, below -- so it builds no
# harness. Otherwise the written cases run on every build (see run_cases):
# idparse emits their harness ahead of the program on the same stream, so asking
# costs no second parse, and the program part is exactly what it is without it.
#
# --natives appends the natives the program and the cases reach, which is what
# decides the backends linked (see backends_for); the program part is unchanged.
#
# --host-triple is what the harness is built for: the machine doing the build,
# which for a --freestanding build is not the program's triple. It is also what
# decides which functions cannot be tested here (see --list-untested, below).
PARSE_ARGS+=(--host-triple "$(host_triple)")
[ "$WORD_SCAN" -eq 1 ] && PARSE_ARGS+=(--word-scan)
[ "$BOOL_STRICT" -eq 1 ] && PARSE_ARGS+=(--bool-strict)
[ "$GIVEN_STRICT" -eq 1 ] && PARSE_ARGS+=(--given-blocks-strict)
[ "$FOR_STRICT" -eq 1 ] && PARSE_ARGS+=(--for-strict)
if [ "$FINGERPRINTS" -eq 1 ]; then
    if [ "$KEEPS" -eq 1 ]; then PARSE_ARGS+=(--keeps); else PARSE_ARGS+=(--fingerprints); fi
elif [ "$CALLS" -eq 1 ]; then
    PARSE_ARGS+=(--calls)
elif [ "$LIST_UNTESTED" -eq 1 ]; then
    PARSE_ARGS+=(--require-tests --untested)
elif [ "$FIX" -eq 1 ]; then
    PARSE_ARGS+=(--fixes)
elif [ "$CHECK" -eq 1 ]; then
    PARSE_ARGS+=(--check)
    PARSE_ARGS+=(--std-unit "$STD_UNIT_START")
else
    PARSE_ARGS+=(--harness)
    PARSE_ARGS+=(--natives)
    [ "$UNITS_ON" -eq 1 ] && PARSE_ARGS+=(--units)
    [ -z "${IDC_NO_CACHE:-}" ] && [ -z "${IDC_STAGE_LEX:-}" ] && PARSE_ARGS+=(--tc-keys)
    # Each case runs in the root of the source tree that owns its function
    # (compiler/parse/back/tgt/c/emit/prog/test/judge/claims/): absolute, one
    # per unit in SRC_ROOTS order, joined by byte 31 -- a single-file build's
    # root is the file's directory. A stage-0 idparse ignores the flag, and
    # its cases run where the harness is started, the project root, as before.
    UNIT_ROOTS=""
    for ui in "${!SRC_ROOTS[@]}"; do
        r="${SRC_ROOTS[$ui]}"
        [ -d "$r" ] || r=$(dirname "$r")
        r=$(cd "$r" 2>/dev/null && pwd -P) || r=""
        [ "$ui" -gt 0 ] && UNIT_ROOTS="$UNIT_ROOTS"$'\x1f'
        UNIT_ROOTS="$UNIT_ROOTS$r"
    done
    PARSE_ARGS+=(--unit-roots "$UNIT_ROOTS")
    # The harness narrows by unit with it, and every build uses it to tell the
    # library's variables from the program's (one type per name, E0303).
    PARSE_ARGS+=(--std-unit "$STD_UNIT_START")
    if [ "${#EXCLUDE_UNITS[@]}" -gt 0 ]; then
        EXCLUDE_UNITS_CSV=$(IFS=,; echo "${EXCLUDE_UNITS[*]}")
        PARSE_ARGS+=(--exclude-units "$EXCLUDE_UNITS_CSV")
    fi
fi

WORK=$(mktemp -d) || { echo "idc: mktemp failed" >&2; exit 1; }
trap '[ -n "${PRE_PID:-}" ] && stop_prechecks; progress_clear; rm -rf "$WORK"; for o in ${BACKEND_OBJS[@]+"${BACKEND_OBJS[@]}"}; do rm -f "$o"; done' EXIT

if [ "$TARGET" = llvm ]; then
    PARSE_ARGS+=(--target llvm --opt "$IR_OPT")
    [ "$FREESTANDING" -eq 1 ] && PARSE_ARGS+=(--freestanding)
    [ "$RUNTIME" -eq 1 ] && PARSE_ARGS+=(--runtime)
fi

C_OUT="$WORK/out.c"
RAW_OUT="$WORK/raw.out"
HARNESS_C="$WORK/harness.c"
LEX_ERR="$WORK/lex.err"
PARSE_ERR="$WORK/parse.err"

# Feed the sources as one stream, with a `#file N|PATH` marker between them.
# The self-hosted stages see a single concatenated input, so without these
# markers they cannot tell where one file ends and the next begins -- which is
# what the 3-functions-per-file rule counts, and what lets a diagnostic name a
# file.
#
# N is the file's compilation unit: the index of its source root in SRC_ROOTS.
# It rides in the marker because that is the only channel to a compiler with no
# filesystem access, and it costs the lexer nothing -- the marker's text is
# already taken verbatim. A file's root is the LONGEST of SRC_ROOTS that
# prefixes it (a dependency nested inside the project belongs to the
# dependency), earliest on a tie. The unit is derived per file rather than per
# run of files because SRC_FILES is sorted globally, so units interleave.
#
# One awk rather than a `cat` per file: a 400-file project forked 400 times
# and spent 0.4 s doing it. The lexer resets its line counter at every
# `#file`, so the blank line awk leaves after a file that does not end in a
# newline changes no diagnostic.
emit_sources() {
    # Constants first: they belong to no file, need no initialiser, and must be
    # in scope for every source that follows.
    local c
    # The marker on its own line, the declaration as ordinary source after it:
    # that way the existing declaration parser reads the constant, instead of a
    # second parser having to be written for a marker's payload.
    for c in ${CONSTS[@]+"${CONSTS[@]}"}; do printf '#const\n%s\n' "$c"; done
    { printf '%s\n' "${SRC_ROOTS[@]}"; printf '%s\n' "${SRC_FILES[@]}"; } \
    | awk -v nroots="${#SRC_ROOTS[@]}" -v plan="$STD_PLAN_FILE" '
        BEGIN { if (plan != "") while ((getline l < plan) > 0) { split(l, a, "\t"); if (a[1] == "S") { k = ++SN[a[2]]; SF[a[2], k] = a[3] + 0; ST[a[2], k] = a[4] + 0 } } }
        NR <= nroots { root[NR - 1] = $0; next }
        { best = -1; unit = 0
          for (i = 0; i < nroots; i++) {
              n = length(root[i])
              if (n > best && substr($0, 1, n) == root[i]) { best = n; unit = i }
          }
          printf "#file %d|%s\n", unit, $0
          if ($0 in SN) {
              ln = 0
              while ((getline line < $0) > 0) {
                  ln++; keep = 0
                  for (k = 1; k <= SN[$0]; k++) if (ln >= SF[$0, k] && ln <= ST[$0, k]) keep = 1
                  print (keep ? line : "")
              }
          } else while ((getline line < $0) > 0) print line
          close($0)
          print "" }'
}

# --emit-sources prints the marker-annotated stream the pipeline consumes and
# stops. It exists because assembling that stream is now real work -- the
# standard library's roots and unit numbers are part of it -- and a test that
# re-implements the assembly (tests/run.sh's `project_cat` did) tests its own
# copy rather than the compiler's. With it, the self-hosting and fixpoint
# checks pipe the compiler's real input through whichever binaries they mean to
# compare.
if [ "$EMIT_SOURCES" -eq 1 ]; then
    emit_sources
    exit_ok
fi

# --fix needs each token's columns (idlex --cols), and --fix-std when the
# project it rewrites is the standard library this build resolved, whose locals
# all take the idstd_ prefix (compiler/parse/mid/form/fix/plan/reach/std/).
LEX_ARGS=()
if [ "$FIX" -eq 1 ]; then
    LEX_ARGS=(--cols)
    if [ -n "$STDLIB" ] && [ -d "$PATH_ARG" ] && [ "$(cd "$PATH_ARG" && pwd -P)" = "$STDLIB" ]; then
        PARSE_ARGS+=(--fix-std)
    fi
fi

if [ "$STD_LAZY" -eq 1 ]; then
    std_lazy_plan || { progress_clear; echo "idc: could not work out which of the standard library this program reaches; set IDC_STD_FULL=1 to merge all of it" >&2; exit 1; }
    phase planned
fi

# ---------------------------------------------------------------------------
# Build cache. idlex|idparse is the expensive part of a build (measured at
# ~80% of the wall time on compiler/parse -- idlex itself is under a second),
# and it is a pure function of the exact source stream, the lex/parse flags,
# the two stage binaries' own identity, and the few environment variables that
# can change dependency resolution or the memory ceiling. When none of that
# has changed since a previous build, its output (RAW_OUT/LEX_ERR/PARSE_ERR,
# and the exit codes that go with them) is reused instead of recomputed, and
# everything downstream -- split_harness, the harness build, running the
# cases, the final cc -- runs exactly as it would have on a fresh parse. The
# cases are never skipped: a cache hit only ever saves the parse, so a build
# whose cases fail cannot come back green because it was cached.
#
# IDC_NO_CACHE=1 turns this (and the object cache in run_cases/the final cc
# below) off entirely -- both read and write -- so a suspect result can always
# be reproduced from a clean run. --fix mutates the project's own files as it
# reruns idlex|idparse, so its input is a moving target and it is excluded
# rather than keyed on one.
CACHE_ON=1
[ -n "${IDC_NO_CACHE:-}" ] && CACHE_ON=0
[ "$FIX" -eq 1 ] && CACHE_ON=0

CACHE_MAX="${IDC_CACHE_ENTRIES:-50}"
OBJ_CACHE_DIR="$CACHE_DIR/obj"
# The library pre-check's own cache (run_lib_precheck, below -- the stdlib's
# own entries and every backend library's share it, keyed by what each one
# hashes to): never $CACHE_DIR/fe or $CACHE_DIR/obj themselves, so a program
# build's own front-end and object entry counts are exactly what they were
# before the pre-check existed -- tests/cache.sh counts those two directly.
# The directory keeps its original name: tests/stdlib.sh already counts
# entries under it by this literal path.
STD_PRECHECK_DIR="$CACHE_DIR/std_precheck"

# obj_cache_key TAG FILE... -- a sha256 identifying a compiled artifact: TAG
# (so a harness binary and a program binary can never collide on the same
# hash even from identical C), cc's own identity, what backends_for decided
# this link needs (LINK_FLAGS/LINK_OBJS -- read from the caller's scope, as
# they stand whenever this is called), and every FILE's content. Used for both
# the test harness and the final program below: same reasoning, same cache.
obj_cache_key() {
    local tag="$1" cc_path o f; shift
    {
        printf '%s\0%s\0' "$tag" "$CC"
        printf '%s\0' ${LINK_FLAGS[@]+"${LINK_FLAGS[@]}"}
        cc_path="$(command -v "$CC" 2>/dev/null)"
        [ -n "$cc_path" ] && sha256sum < "$cc_path"
        for o in ${LINK_OBJS[@]+"${LINK_OBJS[@]}"}; do sha256sum < "$o"; done
        for f in "$@"; do sha256sum < "$f"; done
    } | sha256sum | cut -d' ' -f1
}

# obj_cache_get KEY DEST -- true and DEST populated (executable) if KEY is
# cached; touches the entry so it counts as recently used. False, and DEST
# untouched, on a miss -- including when caching is off, so every call site
# can use this without its own CACHE_ON check.
obj_cache_get() {
    [ "$CACHE_ON" -eq 1 ] || return 1
    local entry="$OBJ_CACHE_DIR/$1"
    [ -f "$entry/bin" ] || return 1
    cp "$entry/bin" "$2" && chmod +x "$2" && touch "$entry"
}

# obj_cache_put KEY SRC -- cache SRC (already built and known good -- this is
# never called on a failed compile) under KEY. Best-effort: a failure here
# loses nothing but the chance to skip this compile next time.
obj_cache_put() {
    [ "$CACHE_ON" -eq 1 ] || return 0
    local entry="$OBJ_CACHE_DIR/$1"
    rm -rf "$WORK/obj_entry"
    mkdir -p "$WORK/obj_entry" && cp "$2" "$WORK/obj_entry/bin" && chmod +x "$WORK/obj_entry/bin" || return 0
    mkdir -p "$OBJ_CACHE_DIR"
    rm -rf "$entry"
    mv -f "$WORK/obj_entry" "$entry"
    cache_prune "$OBJ_CACHE_DIR" "$CACHE_MAX"
}

phase collected
progress read "$(plural "${#SRC_FILES[@]}" file)"
FE_HIT=0
# --word-scan hands idparse the vocabulary as `wrd WORD` lines ahead of the
# tokens, the way the type-check keys travel: data/words/english.txt is the
# dictionary and data/words/allowed.txt the names that are valid but not in it
# (a line starting with # is a comment), data/words/short.txt the real one- and
# two-letter words, and data/words/denied.txt the abbreviations the dictionary
# lists that must still fail: it removes a word from english.txt only, so a word
# allowed.txt or short.txt names is accepted. idparse checks every declared name
# against the result (E0311). data/words/filler.txt travels as `wrd !WORD` lines,
# which only file and directory names are checked against; those names travel as
# `wrp KINDPATH` lines (KIND the letter d or f, PATH from the project root, a file
# without its .id), one per distinct component of the files of the program's own
# roots, the standard library's excluded. Only under the flag: no other build reads these files.
WORD_HEAD=""
if [ "$WORD_SCAN" -eq 1 ]; then
    for wf in denied english short allowed filler; do
        [ -f "$ROOT/data/words/$wf.txt" ] || { echo "idc: --word-scan reads $ROOT/data/words/$wf.txt, which does not exist" >&2; exit 1; }
    done
    WORD_HEAD="$WORK/words.head"
    awk 'FILENAME ~ /filler[.]txt$/ { if ($1 !~ /^#/ && NF > 0) print "wrd !" $1; next }
         FILENAME ~ /denied[.]txt$/ { if ($1 !~ /^#/ && NF > 0) denied[$1] = 1; next }
         /^#/ || NF == 0 { next }
         FILENAME ~ /english[.]txt$/ && ($1 in denied) { next }
         { print "wrd " $1 }' "$ROOT/data/words/denied.txt" "$ROOT/data/words/english.txt" \
        "$ROOT/data/words/short.txt" "$ROOT/data/words/allowed.txt" "$ROOT/data/words/filler.txt" > "$WORD_HEAD"
    { printf '%s\n' "${SRC_ROOTS[@]}"; printf '%s\n' "${SRC_FILES[@]}"; } \
    | awk -v nroots="${#SRC_ROOTS[@]}" -v nown="$STD_UNIT_START" '
        NR <= nroots { root[NR - 1] = $0; next }
        { best = -1; unit = 0
          for (i = 0; i < nroots; i++) {
              n = length(root[i])
              if (n > best && substr($0, 1, n) == root[i]) { best = n; unit = i }
          }
          if (unit >= nown) next
          rel = $0
          if (length($0) > best) { rel = substr($0, best + 1); sub(/^\/+/, "", rel) }
          else { k = split($0, base, "/"); rel = base[k] }
          sub(/[.]id$/, "", rel)
          n = split(rel, comp, "/"); acc = ""
          for (k = 1; k <= n; k++) {
              acc = (k > 1 ? acc "/" : "") comp[k]
              key = (k < n ? "d" : "f") acc
              if (!(key in seen)) { seen[key] = 1; print "wrp " key }
          } }' >> "$WORD_HEAD"
fi
# Materialised unconditionally, cache on or off: capped_from (see capped(),
# above) needs a real path for idlex's input regardless, since ccrun no
# longer touches its own stdin at all (see its own comments) -- and the
# cache-on path already needed this file for its hash, so there is now one
# copy of "emit the source stream" instead of two.
SOURCES_TMP="$WORK/sources"
[ "$STD_LAZY" -eq 1 ] || emit_sources > "$SOURCES_TMP"
if [ "$CACHE_ON" -eq 1 ]; then
    FE_CACHE_DIR="$CACHE_DIR/fe"
    # cc's identity is not part of what idlex|idparse can vary with -- it
    # never runs cc -- but is hashed anyway so this key can be built the same
    # way as the object cache's, below, and so the two never need to
    # disagree about what "the same build" means.
    FE_KEY=$(
        { sha256sum < "$IDLEX"; sha256sum < "$IDPARSE"
          printf '%s\0' "${LEX_ARGS[@]+"${LEX_ARGS[@]}"}" "${PARSE_ARGS[@]}"
          printf 'IDSTD_HOME=%s\0IDC_NO_STD=%s\0STDLIB=%s\0IDC_MEM_LIMIT=%s\0CC=%s\0' \
              "${IDSTD_HOME:-}" "${IDC_NO_STD:-}" "$STDLIB" "${IDC_MEM_LIMIT:-}" "$CC"
          if [ "$TARGET" = wasm ]; then
              printf 'WASI=%s|%s|%s|%s\0' "${IDC_WASI_CLANG:-}" \
                  "${IDC_WASI_SYSROOT_INCLUDE:-}" "${IDC_WASI_LIBDIR:-}" "${IDC_WASI_COMPILER_RT:-}"
          fi
          cc_path="$(command -v "$CC" 2>/dev/null)"
          [ -n "$cc_path" ] && sha256sum "$cc_path"
          [ -z "$EXT_HEAD" ] || { printf 'EXT=%s\0' "$EXT_ID"; cat "$EXT_HEAD"; }
          [ -z "$WORD_HEAD" ] || { printf 'WORDS\0'; cat "$WORD_HEAD"; }
          if [ "$STD_LAZY" -eq 1 ]; then printf 'STDPLAN=%s\0' "$STD_PKEY"; else cat "$SOURCES_TMP"; fi
        } | sha256sum | cut -d' ' -f1
    )
    FE_ENTRY="$FE_CACHE_DIR/$FE_KEY"
    if [ -f "$FE_ENTRY/rc" ]; then
        cp "$FE_ENTRY/raw.out" "$RAW_OUT"
        cp "$FE_ENTRY/lex.err" "$LEX_ERR"
        cp "$FE_ENTRY/parse.err" "$PARSE_ERR"
        read -r lex_rc parse_rc < "$FE_ENTRY/rc"
        touch "$FE_ENTRY"
        FE_HIT=1
    fi
fi
# The type check's cache (compiler/parse/mid/types/check/walk/check/tk/):
# idparse keys each function on its own tokens and on what every name in them
# means program-wide, and skips the check of a function whose key has come out
# clean before. The keys it is handed are the TC_FILE list, as `tcc KEY` lines
# ahead of the tokens (run_lex_parse); a build that succeeds writes back every
# clean key it has, after everything else, behind a separator tc_record cuts
# off. What the keys cannot see -- the compiler, the platform the build is for,
# and the conf.id constants -- names the list. Only the flags that can change
# what a check says go into that name, so a --check, --calls or ordinary
# build of one program all share one list. Off with the other caches, and
# for the bootstrap's stage-0 builds, whose idparse predates it.
TC_FILE=""
if [ "$CACHE_ON" -eq 1 ] && [ -z "${IDC_STAGE_LEX:-}" ]; then
    TC_FILE=$(
        { sha256sum < "$IDLEX"; sha256sum < "$IDPARSE"
          tc_skip=0
          for a in "${PARSE_ARGS[@]}"; do
              case "$a" in
                  --harness|--natives|--units|--tc-keys|--check|--calls|--fingerprints|--keeps|--untested|--require-tests) ;;
                  --std-unit|--exclude-units|--unit-roots) tc_skip=1 ;;
                  *) [ "$tc_skip" -eq 1 ] && tc_skip=0 || printf '%s\0' "$a" ;;
              esac
          done
          printf '%s\0' ${CONSTS[@]+"${CONSTS[@]}"}
        } | sha256sum | cut -d' ' -f1)
    TC_FILE="$CACHE_DIR/tc/$TC_FILE"
fi

# tc_record -- cut the clean keys off the end of RAW_OUT and add them to
# TC_FILE: newest last, at most IDC_TC_KEYS (default 200000), written beside
# the list and renamed over it.
tc_record() {
    grep -qxF '/* ---- tc keys ---- */' "$RAW_OUT" || return 0
    awk -v out="$WORK/tc.new" -v raw="$WORK/raw.cut" '
        { line[NR] = $0 } $0 == "/* ---- tc keys ---- */" { at = NR }
        END { for (i = 1; i < at; i++) print line[i] > raw
              printf "" > raw
              for (i = at + 1; i <= NR; i++) print line[i] > out
              printf "" > out }' "$RAW_OUT" && mv -f "$WORK/raw.cut" "$RAW_OUT"
    [ -n "$TC_FILE" ] && [ -s "$WORK/tc.new" ] || return 0
    mkdir -p "${TC_FILE%/*}" || return 0
    local tmp="$TC_FILE.$$.tmp"
    { [ -f "$TC_FILE" ] && cat "$TC_FILE"; cat "$WORK/tc.new"; } \
        | tac | awk '!seen[$0]++' | head -n "${IDC_TC_KEYS:-200000}" | tac > "$tmp" && mv -f "$tmp" "$TC_FILE"
    rm -f "$tmp"
    cache_prune "${TC_FILE%/*}" "$CACHE_MAX"
}

# ---------------------------------------------------------------------------
# A library's own pre-check: its cases run once, as a check of the library
# itself, before the program's own harness (run_cases, below) -- a failure
# there must still fail the build, but reported as the library's, never the
# program's. One routine (run_lib_precheck, below) does this for any library
# root: the stdlib (run_std_precheck) and every backend directory that is its
# own compilation unit and has id code to run (LIB_PRECHECK_DIRS/_UNITS,
# computed above, once SRC_ROOTS was final).
#
# lib_precheck_key ROOT -- keyed by exactly what decides the answer: the two
# stage binaries (a different compiler could parse or run a case
# differently), the cc the pre-check itself builds ROOT with
# (LIB_PRECHECK_CC, below -- never this build's own --cc: see
# run_lib_precheck), and the content of every file under ROOT (pruned the way
# collect_ids prunes source: hidden directories and BUILD_DIR are never
# source, and a library built in place must hash the same as one that was
# never built -- which is also why a backend's .gen.o is left out: a build
# running beside this one writes it into the library for as long as it runs,
# and hashing it made every concurrent build miss). Nothing about the PROGRAM
# being built is in it, so two different programs against the same library and
# compiler hit one entry.
lib_precheck_key() {
    local root="$1" cc_path
    shift
    {
        # A backend library that calls the standard library is checked with
        # it, so the answer depends on that library's content as well as its
        # own. The stdlib's own pre-check names itself and adds nothing.
        if [ "${1:-}" = "--std" ] && [ "${2:-}" != "$root" ]; then
            lib_precheck_key "$2"
            if [ -n "${LIB_PRECHECK_TIER:-}" ]; then
                echo "tier root"
                [ -f "$LIB_PRECHECK_TIER/conf.id" ] && sha256sum < "$LIB_PRECHECK_TIER/conf.id"
                tier_shim_key "$LIB_PRECHECK_TIER" "$root"
            fi
        else
            echo "no separate library"
        fi
        # One sha256sum over every file, run from inside ROOT so the paths it
        # prints are relative: ROOT's own path is not part of what determines
        # this answer (a checkout at a different path, or backends.sh's own
        # fresh mktemp directory every run, must hit the same entry), while a
        # file's name and place in the tree are. $IDLEX/$IDPARSE are hashed
        # from stdin, content only: their path is $CACHE_DIR, and a copied
        # compiler tree must hit the entries its source tree wrote.
        sha256sum < "$IDLEX"; sha256sum < "$IDPARSE"
        cc_path="$(command -v "$LIB_PRECHECK_CC" 2>/dev/null)"
        [ -n "$cc_path" ] && sha256sum < "$cc_path"
        # A pre-check of only what a program reaches (LIB_PRECHECK_PLAN) is
        # decided by those functions' text, which the plan carries by content
        # hash, and by the files that are not source -- a backend's C and
        # headers, which a case that reads or links them depends on.
        if [ -n "${LIB_PRECHECK_PLAN:-}" ]; then
            cat "$LIB_PRECHECK_PLAN"
            (cd "$root" && find . -mindepth 1 \
                 \( -type d -name '.*' -prune \) -o \
                 \( -type d -path "./$BUILD_DIR" -prune \) -o \
                 \( -type f ! -name '*.gen.o' ! \( -name '*.id' ! -name backend.id ! -name conf.id \) ! -name conf.id -print0 \) \
                | LC_ALL=C sort -z \
                | xargs -0 -r sha256sum)
        else
            (cd "$root" && find . -mindepth 1 \
                 \( -type d -name '.*' -prune \) -o \
                 \( -type d -path "./$BUILD_DIR" -prune \) -o \
                 \( -type f ! -name '*.gen.o' -print0 \) \
                | LC_ALL=C sort -z \
                | xargs -0 -r sha256sum)
        fi
    } | sha256sum | cut -d' ' -f1
}

# tier_reach_hint TIER ROOT OUT -- after a backend library's pre-check failed:
# each function OUT says does not exist that the library TIER (idstd) defines
# outside its core/, with the fix. A backend is built with core/ alone, the
# freestanding tier everything stands on, so a host/ or kit/ function is not
# there to call; the plain "no such function" would not say why.
tier_reach_hint() {
    local tier="$1" root="$2" out="$3" name hit
    while IFS= read -r name; do
        hit=$(grep -rnE --include='*.id' "^(pure |native )?$name\\(" "$tier" 2>/dev/null | grep -v "^$tier/core/" | head -1 | cut -d: -f1,2)
        [ -n "$hit" ] || continue
        echo "idc: '$name' is defined at $hit, outside idstd's core/ tier, and a backend library (the one at $root) is built with core/ alone so that backends stay below host/ and kit/. Move '$name' into core/ if it needs no host service, or move the code that calls it out of the backend into the host/ or kit/ library that wraps it." >&2
    done < <(grep -oE "no such function '[A-Za-z0-9_]+'" "$out" | sed "s/.*'\\(.*\\)'/\\1/" | sort -u | head -5)
}

# tier_other_backends TIER SELF -- every backend directory of the idstd checkout
# TIER (a directory holding a backend.id, under host/ or kit/, hidden
# directories skipped) except SELF, one per line, in a fixed order.
tier_other_backends() {
    local tier="$1" self="$2" b
    find "$tier/host" "$tier/kit" \( -type d -name '.*' -prune \) -o -name backend.id -printf '%h\n' 2>/dev/null \
        | LC_ALL=C sort | while IFS= read -r b; do [ "$b" = "$self" ] || printf '%s\n' "$b"; done
}

# tier_native_lines DIR -- the `native` declarations of the id files under DIR
# (hidden directories and BUILD_DIR skipped), in file order.
tier_native_lines() {
    (cd "$1" && find . -mindepth 1 \( -type d -name '.*' -prune \) -o \( -type d -path "./$BUILD_DIR" -prune \) \
         -o \( -type f -name '*.id' ! -name backend.id ! -name conf.id -print0 \) \
        | LC_ALL=C sort -z | xargs -0 -r grep -h '^native ')
}

# tier_native_shims TIER SELF DEST -- sets TIER_SHIM_ARGS to a `--backend DIR`
# pair for every other backend of TIER that declares a native. Each DIR under
# DEST holds that backend's backend.id and its non-id files (its C, headers and
# scripts, so a case that calls one of its natives links) and its native
# declarations as an id file each, named for the native plus `_decl` (a file holds
# at most three functions, and a numbered file is refused: `proc_dup2` beside
# `proc_dup` would be one if the name ended the file name).
# A backend may call any backend's natives -- a native is
# a leaf C call, so the id layering above it still holds -- but not another
# backend's id functions, which are what is left out. A backend's pre-check is
# built with core/ alone (run_backend_prechecks), so this is how another
# backend's natives are there to call and nothing else of it is.
tier_native_shims() {
    local tier="$1" self="$2" dest="$3" b n l d i=0
    TIER_SHIM_ARGS=()
    while IFS= read -r b; do
        [ -n "$(tier_native_lines "$b")" ] || continue
        n="$dest/s$i"; i=$((i + 1))
        mkdir -p "$n"
        (cd "$b" && find . -mindepth 1 \( -type d -name '.*' -prune \) -o \( -type d -path "./$BUILD_DIR" -prune \) \
             -o \( -type f ! -name '*.id' ! -name '*.gen.o' -print0 \) | xargs -0 -r cp --parents -t "$n")
        cp "$b/backend.id" "$n/backend.id"
        while IFS= read -r l; do d="${l#native }"; printf '%s\n' "$l" > "$n/${d%%(*}_decl.id"; done < <(tier_native_lines "$b")
        TIER_SHIM_ARGS+=(--backend "$n")
    done < <(tier_other_backends "$tier" "$self")
}

# tier_shim_key TIER SELF -- what tier_native_shims would build, as a hash: each
# other backend's native declarations and non-id files by relative path, so the
# pre-check's cache entry follows them and not where they are checked out.
tier_shim_key() {
    local tier="$1" self="$2" b
    while IFS= read -r b; do
        tier_native_lines "$b" | sha256sum
        (cd "$b" && find . -mindepth 1 \( -type d -name '.*' -prune \) -o \( -type d -path "./$BUILD_DIR" -prune \) \
             -o \( -type f ! -name '*.id' ! -name '*.gen.o' -print0 \) | LC_ALL=C sort -z | xargs -0 -r sha256sum)
        sha256sum < "$b/backend.id"
    done < <(tier_other_backends "$tier" "$self")
}

# run_lib_precheck ROOT KIND STDARG... -- see the comment above. A miss
# builds ROOT as its own project (a library with no main, so the output is a
# discarded .o -- --allow-untested, since whether the library has enough
# cases is --list-untested's question, not this one) through a SEPARATE
# binary cache seeded from this build's own idlex/idparse/ccrun/idlayout --
# so it costs no re-bootstrap -- but with its OWN fe/ and obj/
# subdirectories, never this build's, which is what keeps a program build's
# own cache-entry counts exactly what they always were (tests/cache.sh).
# Only a pass is kept. A failure is found again by running again: the key names
# the library's content, so a failure kept under it would outlast the cause --
# and the cause can be the machine (two builds writing the same backend object
# at once) rather than the library.
# STDARG... is --std "$STDLIB" for the stdlib itself, or --no-std for a
# backend directory checked standing alone -- exactly how a --no-std program
# that imports it directly already has to build (fs's own README/comments:
# it "still builds on its own, imported by a --no-std program"), so this
# checks precisely the thing a program depending on it depends on.
#
# The library's own validation always builds with plain "cc", never this
# build's own --cc: a caller's --cc is often a wrapper built to observe or
# constrain THIS build (tests/backends.sh's cc-invocation loggers are
# exactly that), and a library's own correctness is a property of the
# library, not of whichever such wrapper happens to be in scope. A real
# cross-cc concern (does the library also build clean under the triple's
# actual toolchain) is a different question from "do its cases pass," which
# is all this answers.
#
# IDC_BUILDING_LIB_PRECHECK marks the recursive build so it never triggers a
# pre-check of its own (a backend nested inside another backend, or inside
# the stdlib this same call is checking) -- the same reasoning run_std_precheck
# already applied to itself before this generalised, now shared by both.
LIB_PRECHECK_CC=cc
run_lib_precheck() {
    local root="$1" kind="$2"; shift 2
    local key="" entry=""
    if [ "$CACHE_ON" -eq 1 ]; then
        key=$(lib_precheck_key "$root" "$@")
        entry="$STD_PRECHECK_DIR/$key"
        if [ -f "$entry/rc" ] && [ "$(cat "$entry/rc")" -eq 0 ]; then
            touch "$entry"
            return 0
        fi
    fi

    progress lib "$root"
    # idlex0/idparse0 copied first, idlex/idparse last: bin/idc rebuilds
    # stage 1 from stage 0 whenever stage 0's mtime is newer than stage 1's
    # (the bootstrap section, above), so copying stage 1 first would leave
    # stage 0 the newer file by a few milliseconds and force a real
    # stage-0-only rebuild here -- one the OLD, frozen stage 0 runs every
    # case with, none of this file's narrowing included.
    local inner_cache="$STD_PRECHECK_DIR/.bincache" f
    mkdir -p "$inner_cache"
    for f in idlex0 idparse0 ccrun idlayout idlex idparse; do
        if [ -x "$CACHE_DIR/$f" ]; then
            cp "$CACHE_DIR/$f" "$inner_cache/$f" 2>/dev/null && chmod +x "$inner_cache/$f"
            cp "$CACHE_DIR/$f.stamp" "$inner_cache/$f.stamp" 2>/dev/null || true
        fi
    done

    local lib_work out rc
    lib_work=$(mktemp -d) || { echo "idc: mktemp failed" >&2; exit 1; }
    out="$lib_work/out"
    TIER_SHIM_ARGS=()
    [ -n "${LIB_PRECHECK_TIER:-}" ] && tier_native_shims "$LIB_PRECHECK_TIER" "$root" "$lib_work/shims"
    env IDC_CACHE_DIR="$inner_cache" IDC_BUILDING_LIB_PRECHECK=1 IDC_STD_CONF_DIR="${LIB_PRECHECK_TIER:-}" IDC_STD_PLAN="${LIB_PRECHECK_PLAN:-}" IDC_STD_PLAN_ROOT="$root" IDC_STD_IDX_DIR="$STD_IDX_BASE" \
        "$SCRIPT_DIR/idc" --cc "$LIB_PRECHECK_CC" --allow-untested "$@" ${TIER_SHIM_ARGS[@]+"${TIER_SHIM_ARGS[@]}"} "$root" -o "$lib_work/out.bin" \
        >"$out" 2>&1
    rc=$?
    progress_clear

    if [ "$CACHE_ON" -eq 1 ] && [ "$rc" -eq 0 ]; then
        mkdir -p "$lib_work/entry"
        cp "$out" "$lib_work/entry/out"
        printf '%s\n' "$rc" > "$lib_work/entry/rc"
        mkdir -p "$STD_PRECHECK_DIR"
        rm -rf "$entry"
        mv -f "$lib_work/entry" "$entry"
        cache_prune "$STD_PRECHECK_DIR" "$CACHE_MAX"
    fi

    if [ "$rc" -ne 0 ]; then
        echo "idc: the $kind at $root failed its own test cases (this is not an error in your program):" >&2
        cat "$out" >&2
        [ -n "${LIB_PRECHECK_TIER:-}" ] && tier_reach_hint "$LIB_PRECHECK_TIER" "$root" "$out"
        rm -rf "$lib_work"
        exit 1
    fi
    rm -rf "$lib_work"
}

# run_std_precheck -- the stdlib through run_lib_precheck, above. Skipped for
# --no-std/IDC_NO_STD (STDLIB is then ""), for the bootstrap's own re-entries
# and tool builds (IDC_STAGE_LEX, IDC_BUILDING_CCRUN, IDC_BUILDING_IDLAYOUT),
# for a nested library pre-check (IDC_BUILDING_LIB_PRECHECK), and when
# PATH_ARG already IS the library: that build runs every one of its own
# cases as itself (see STD_UNIT_START's comment, above), which this would
# only repeat. --std "$STDLIB" pins the recursive build to exactly the
# library this pre-check is of -- never IDSTD_HOME or a sibling idstd/,
# which could name a different directory than --std/$IDSTD_HOME resolved
# this build to and would otherwise merge a second, unrelated library into
# the one under test (and recurse into a pre-check of THAT one, of
# PATH_ARG=STDLIB again).
run_std_precheck() {
    [ -z "$STDLIB" ] && return 0
    [ -n "${IDC_STAGE_LEX:-}" ] && return 0
    [ -n "${IDC_BUILDING_CCRUN:-}" ] && return 0
    [ -n "${IDC_BUILDING_IDLAYOUT:-}" ] && return 0
    [ -n "${IDC_BUILDING_LIB_PRECHECK:-}" ] && return 0
    local path_key=""
    [ -d "$PATH_ARG" ] && path_key="$(cd "$PATH_ARG" && pwd -P)"
    [ "$path_key" = "$STDLIB" ] && return 0
    if [ "$STD_LAZY" -eq 1 ]; then
        run_std_precheck_lazy
        return $?
    fi
    run_lib_precheck "$STDLIB" "standard library" --std "$STDLIB"
}

# run_std_precheck_lazy -- the library's own check of what this program
# reaches and no more: the functions the plan loaded, and what their cases
# reach (mode B of std_closure), built as a project of their own with their
# cases run. Cached by the plan, so a program build that reaches the same
# functions of an unchanged library runs nothing, and a changed function is the
# only one whose cases run again. A type error in a function the program does
# not reach is not this program's concern, and never fails it: the library's
# own build (idc IDSTD, idstd/run.sh) is what finds it.
run_std_precheck_lazy() {
    local roots="$WORK/roots.b" plan="$WORK/std.plan.b" pdir="${STD_IDX%/idx/*}/plans"
    if [ -f "$pdir/B-$STD_PKEY" ]; then
        cp "$pdir/B-$STD_PKEY" "$plan" && touch "$pdir/B-$STD_PKEY"
    else
        awk -F'\t' '$1 == "L" { n = split($2, w, " "); for (i = 1; i <= n; i++) print w[i] }' "$STD_PLAN_FILE" > "$roots"
        std_closure B "$roots" "$STD_IDX/graph" > "$plan" || return 1
        cp "$plan" "$pdir/B-$STD_PKEY.tmp.$$" && mv -f "$pdir/B-$STD_PKEY.tmp.$$" "$pdir/B-$STD_PKEY"
    fi
    grep -q '^S' "$plan" || return 0
    LIB_PRECHECK_PLAN="$plan" run_lib_precheck "$STDLIB" "standard library" --std "$STDLIB"
}

# tier_root_of DIR -- the idstd checkout DIR lies inside, printed; nothing and
# false if it lies inside none. An idstd checkout is the nearest ancestor with
# core/, host/ and a conf.id (the constants core's functions read). A backend
# library found by this is built with that checkout's core/, so the answer does
# not depend on whether the program being built attaches idstd at all.
tier_root_of() {
    local d="$1"
    while [ "$d" != / ]; do
        d="$(dirname "$d")"
        [ -d "$d/core" ] && [ -d "$d/host" ] && [ -f "$d/conf.id" ] && { printf '%s' "$d"; return 0; }
    done
    return 1
}

# run_backend_prechecks -- every LIB_PRECHECK_DIRS entry through
# run_lib_precheck, above, with idstd's core/ and nothing else of idstd -- of
# the library's own
# backends, only those a lazy build's plan loads a declaration from, as the rest
# of the library is checked only where the program reaches it: a backend directory
# has no conf.id of its own (Native backends, below -- backend.id is link
# facts, not a dependency manifest), so it either builds with core/ or it
# does not. core/ is the freestanding foundation, always present, so a backend
# may call it; host/ and kit/ are above backends, so a backend that calls one
# fails (tier_reach_hint says so). A backend outside any idstd checkout is built
# with the whole standard library when there is one, else standing alone
# (--no-std). Skipped for the same re-entries and tool builds run_std_precheck
# skips, and for whichever of LIB_PRECHECK_DIRS PATH_ARG already IS.
run_backend_prechecks() {
    [ -n "${IDC_STAGE_LEX:-}" ] && return 0
    [ -n "${IDC_BUILDING_CCRUN:-}" ] && return 0
    [ -n "${IDC_BUILDING_IDLAYOUT:-}" ] && return 0
    [ -n "${IDC_BUILDING_LIB_PRECHECK:-}" ] && return 0
    local path_key="" i dir tier in_std
    [ -d "$PATH_ARG" ] && path_key="$(cd "$PATH_ARG" && pwd -P)"
    for i in "${!LIB_PRECHECK_DIRS[@]}"; do
        dir="${LIB_PRECHECK_DIRS[$i]}"
        [ "$dir" = "$path_key" ] && continue
        tier=""
        in_std=0
        [ -n "$STDLIB" ] && [[ "$dir/" == "$STDLIB"/* ]] && in_std=1
        if [ "$in_std" -eq 1 ]; then
            if [ "$STD_LAZY" -eq 1 ] && ! awk -F'\t' -v d="$dir/" '$1 == "S" && index($2, d) == 1 { f = 1 } END { exit !f }' "$STD_PLAN_FILE"; then
                continue
            fi
            [ -d "$STDLIB/core" ] && tier="$STDLIB"
        else
            tier=$(tier_root_of "$dir") || tier=""
        fi
        [ -n "$tier" ] && [[ "$dir/" == "$tier"/core/* ]] && tier=""
        if [ -n "$tier" ]; then
            LIB_PRECHECK_TIER="$tier" run_lib_precheck "$dir" "backend library" --std "$tier/core"
        elif [ "$in_std" -eq 0 ] && [ -n "$STDLIB" ]; then
            run_lib_precheck "$dir" "backend library" --std "$STDLIB"
        else
            run_lib_precheck "$dir" "backend library" --no-std
        fi
    done
}

# The library pre-checks (above) depend on nothing the program's own lex and
# parse produce, and one that misses costs more than the parse itself, so they
# start first and run beside it: start_prechecks, here, and await_prechecks at
# the point the sequential build ran them. The job's stderr is held back and
# replayed there, so a program's own diagnostics still come first and a library
# failure reads exactly as before; a build that stops before that point kills
# the job, along with everything it started (its own process group).
PRE_PID=""
start_prechecks() {
    [ "$FIX" -eq 0 ] && [ "$LIST_UNTESTED" -eq 0 ] && [ "$CHECK" -eq 0 ] || return 0
    set -m
    ( PROGRESS=0; run_std_precheck; run_backend_prechecks ) </dev/null 2>"$WORK/pre.err" &
    PRE_PID=$!
    set +m
}
stop_prechecks() {
    [ -n "$PRE_PID" ] || return 0
    kill -- "-$PRE_PID" 2>/dev/null
    wait "$PRE_PID" 2>/dev/null
    PRE_PID=""
}
await_prechecks() {
    local rc
    [ -n "$PRE_PID" ] || { run_std_precheck; run_backend_prechecks; return 0; }
    progress precheck "standard library"
    wait "$PRE_PID"
    rc=$?
    PRE_PID=""
    [ "$rc" -eq 0 ] && return 0
    progress_clear
    cat "$WORK/pre.err" >&2
    exit 1
}
phase fe_key
[ "$FE_HIT" -eq 0 ] && start_prechecks
if [ "$FE_HIT" -eq 0 ]; then
    [ "$STD_LAZY" -eq 0 ] || emit_sources > "$SOURCES_TMP"
    run_lex_parse "$SOURCES_TMP" ${LEX_ARGS[@]+"${LEX_ARGS[@]}"}
    if [ "$CACHE_ON" -eq 1 ]; then
        rm -rf "$WORK/fe_entry"
        if mkdir -p "$WORK/fe_entry" \
           && cp "$RAW_OUT" "$WORK/fe_entry/raw.out" \
           && cp "$LEX_ERR" "$WORK/fe_entry/lex.err" \
           && cp "$PARSE_ERR" "$WORK/fe_entry/parse.err" \
           && printf '%s %s\n' "$lex_rc" "$parse_rc" > "$WORK/fe_entry/rc"; then
            mkdir -p "$FE_CACHE_DIR"
            rm -rf "$FE_ENTRY"
            mv -f "$WORK/fe_entry" "$FE_ENTRY"
            cache_prune "$FE_CACHE_DIR" "$CACHE_MAX"
        fi
    fi
fi
tc_record
phase frontend

# The self-hosted stages cover the whole language, so a failure here is a bug
# in this compiler, not an input it cannot reach. Falling back to idc.py would
# hide that -- and worse, would hand the program to a compiler that does not
# check nine of the language's rules. There is no fallback, and since stage 0
# became bootstrap/*.c there is no bootstrap either: this driver does not run
# idc.py at all.
compiler_bug() { # compiler_bug REASON
    progress_clear
    echo "idc: internal error: $1" >&2
    [ -s "${C_OUT:-}" ] && echo "idc: the generated C is at $C_OUT" >&2
    echo "idc: this is a bug in the self-hosted compiler; please report it." >&2
    exit 1
}

# Checked before parse_rc==1 below: idlex and idparse also exit 1 when their
# own allocator gives up (see mem_ceiling_hit), which is not the program
# breaking a language rule, and would otherwise be misread as exactly that.
if mem_ceiling_hit "$lex_rc" "$LEX_ERR"; then
    progress_clear
    mem_ceiling_error "idlex"
    exit 1
fi
if mem_ceiling_hit "$parse_rc" "$PARSE_ERR"; then
    progress_clear
    mem_ceiling_error "idparse"
    exit 1
fi

# ---------------------------------------------------------------------------
# --fix: idparse --fixes prints, after the diagnostics, the edits that resolve
# the violations with one mechanical, behaviour-preserving repair, and a
# refusal for each that looks repairable but is not
# (compiler/parse/mid/form/fix/run/entry.id has the format). They are applied
# with tools/fixapply.awk and the tree is checked again, until a run finds
# nothing more to edit: a return clause named in one run can hold a call that
# must be named in the next, and each run's edits are computed against the
# source as that run read it. What is left is then reported, as it stands.
FIX_MAX_ROUNDS=16
declare -A FIX_SNAP=()
FIX_ORDER=()
FIX_NEW=()

fix_stage_ok() {
    if [ "$lex_rc" -ne 0 ] || { [ "$parse_rc" -ne 0 ] && [ "$parse_rc" -ne 1 ]; }; then
        progress_clear
        [ -s "$LEX_ERR" ] && cat "$LEX_ERR" >&2
        [ -s "$PARSE_ERR" ] && cat "$PARSE_ERR" >&2
        compiler_bug "idlex or idparse failed on this input"
    fi
    if mem_ceiling_hit "$parse_rc" "$PARSE_ERR"; then
        progress_clear
        mem_ceiling_error "idparse"
        exit 1
    fi
}

# fix_file FILE -- apply this run's edits for FILE, keeping its original the
# first time it is touched so the report can show every edit against it. Only a
# file of the project itself may be named; anything else is the compiler's bug.
fix_file() {
    local f="$1" snap
    case "$f" in
        "$PATH_ARG"|"${PATH_ARG%/}"/*) ;;
        *) compiler_bug "idparse --fixes named a file outside $PATH_ARG: $f" ;;
    esac
    [ -f "$f" ] || compiler_bug "idparse --fixes named a file that does not exist: $f"
    if [ -z "${FIX_SNAP[$f]:-}" ]; then
        snap="$WORK/snap.${#FIX_ORDER[@]}"
        cp "$f" "$snap" || exit 1
        FIX_SNAP[$f]="$snap"
        FIX_ORDER+=("$f")
    fi
    awk -F'|' -v f="$f" '$2 == f' "$WORK/edits" > "$WORK/edits.one"
    LC_ALL=C awk -v efile="$WORK/edits.one" -f "$ROOT/tools/fixapply.awk" "$f" > "$WORK/fixed" \
        || compiler_bug "idparse --fixes gave overlapping edits for $f"
    cat "$WORK/fixed" > "$f" || exit 1
}

# Every edit, as FILE:LINE with the lines before and after it.
fix_report_edits() {
    local f
    for f in ${FIX_ORDER[@]+"${FIX_ORDER[@]}"}; do
        diff -U0 "${FIX_SNAP[$f]}" "$f" | awk -v f="$f" '
            /^(---|\+\+\+) / { next }
            /^@@/ { split($2, o, ","); n = substr(o[1], 2) + 0
                    if (o[2] == "0") n++
                    print f ":" n; next }
            { print "  " $0 }'
    done
}

# What was not fixed: each refusal with its reason, then every diagnostic left,
# counted by kind -- the message with its names and numbers taken out.
fix_report_created() {
    local f
    for f in ${FIX_NEW[@]+"${FIX_NEW[@]}"}; do echo "$f: created, holds the block pulled out of an overlong one"; done
    [ "${#FIX_NEW[@]}" -gt 0 ] && echo "note: the created function(s) have no test cases yet; the build reports each until two are added"
    return 0
}

fix_report_rest() {
    local nedits=0 f
    for f in ${FIX_ORDER[@]+"${FIX_ORDER[@]}"}; do
        nedits=$((nedits + $(diff -U0 "${FIX_SNAP[$f]}" "$f" | grep -c '^@@')))
    done
    echo "idc --fix: $nedits edit(s) in $(plural "${#FIX_ORDER[@]}" file), $1 run(s)"
    grep '^@N|' "$RAW_OUT" | awk -F'|' '{ r = $0; sub(/^@N\|[^|]*\|[^|]*\|/, "", r)
        if ($2 == "") print "not fixed: " r; else print $2 ":" $3 ": not fixed: " r }'
    grep -v '^@\|^  \(at\|why\|help\|edit\|related\): ' "$RAW_OUT" > "$WORK/left"
    if [ -s "$WORK/left" ]; then
        echo "left for a person ($(wc -l < "$WORK/left") diagnostic(s)), by kind:"
        sed -E 's/^[^ ]*:[0-9]+: (error|note): //' "$WORK/left" \
            | sed -E "s/'[^']*'/'_'/g; s/[0-9]+/N/g" | LC_ALL=C sort | uniq -c | sort -rn
    fi
}

run_fix() {
    local round=0 rc
    while :; do
        fix_stage_ok
        if [ ! -d "$PATH_ARG" ]; then
            awk -F'|' '$1 == "@X" { print "@N|" $2 "|" $3 "|the block has more than 3 actions; extracting it into a helper needs a project directory, because the helper goes in a new file; run --fix on the directory, or shorten the block by hand"; next } { print }' "$RAW_OUT" > "$WORK/raw.single"
            cat "$WORK/raw.single" > "$RAW_OUT"
        fi
        grep -E '^@[RDX]\|' "$RAW_OUT" > "$WORK/edits"
        [ -s "$WORK/edits" ] || break
        round=$((round + 1))
        if [ "$round" -gt "$FIX_MAX_ROUNDS" ]; then
            progress_clear
            echo "idc: --fix still found edits after $FIX_MAX_ROUNDS runs; stopping, which is a bug in the fixes" >&2
            STRUCT_VIOLATIONS=1
            break
        fi
        cut -d'|' -f2 "$WORK/edits" | LC_ALL=C sort -u > "$WORK/files"
        while IFS= read -r f; do fix_file "$f"; done < "$WORK/files"
        while IFS= read -r f; do SRC_FILES+=("$f"); FIX_NEW+=("$f"); done < <(awk -F"|" '$1 == "@X" { d = $2; sub(/[^\/]*$/, "", d); print d $8 ".id" }' "$WORK/edits")
        progress fix "run $((round + 1))"
        emit_sources > "$SOURCES_TMP"
        run_lex_parse "$SOURCES_TMP" --cols
    done
    progress_clear
    fix_report_edits
    fix_report_created
    fix_report_rest "$((round + 1))"
    grep -v '^@' "$RAW_OUT" > "$WORK/left_diag"
    show_diag "$WORK/left_diag" "$PARSE_ERR"
    [ "$parse_rc" -eq 1 ] && exit 1
    exit_ok
}

if [ "$FIX" -eq 1 ]; then
    run_fix
fi

# --fingerprints is a report about the parsed program, not a build of it, so
# it does not stop at a rule the program broke the way an ordinary build
# does: idparse prints every function's fingerprint after its diagnostics
# (compiler/parse/back/drive/run/check/dce/guarded_emit.id) whenever parsing
# reached that point at all, so this hands both straight to stdout and exits
# with whatever idparse decided rather than treating parse_rc 1 as fatal.
# parse_rc outside {0,1} is still the compiler's own bug, same as below.
if [ "$FINGERPRINTS" -eq 1 ]; then
    progress_clear
    if [ "$lex_rc" -ne 0 ] || { [ "$parse_rc" -ne 0 ] && [ "$parse_rc" -ne 1 ]; }; then
        [ -s "$LEX_ERR" ] && cat "$LEX_ERR" >&2
        [ -s "$PARSE_ERR" ] && cat "$PARSE_ERR" >&2
        compiler_bug "idlex or idparse failed on this input"
    fi
    cat "$RAW_OUT"
    [ -s "$PARSE_ERR" ] && cat "$PARSE_ERR" >&2
    rm -f "$RAW_OUT"
    exit "$parse_rc"
fi

# --calls: every resolved call edge of the collected program, then the
# case-count section, each sorted (LC_ALL=C) and deduplicated. print_calls
# (compiler/parse/back/drive/run/check/dce/emit/calls/cases.id) prints both
# kinds of row to the same stream in traversal order; an edge row always has
# 5 pipe-fields (caller|caller_file:line|callee|callee_file:line|kind, the
# last field empty for kind=builtin) and a case row always has 3
# (fn|file:line|cases), so awk routes each by field count rather than a
# marker. The case-count section has one row per ordinary function
# (print_call_cases, same file) and one per asm declaration (print_asm_cases,
# compiler/parse/back/drive/run/check/dce/emit/guard/guarded_emit.id), case
# count fixed at 0 for the latter -- an asm function has no cases -- which is
# what lets a row-consuming tool (idc/tools/idxpack.sh's FILES section) find
# an asm body's file the way it finds an ordinary function's. Like
# --fingerprints, this is a report about the parsed program, not
# a build of it, so it prints regardless of parse_rc (see the comment there)
# -- but unlike --fingerprints, which just cats RAW_OUT as it is, this sorts
# the two report sections apart from each other, so any OTHER diagnostic
# print_calls' own checks did not stop (a "no such function", an action-limit
# or argument error -- --calls turns off --require-tests, not the rest of the
# language) is routed to stderr rather than silently dropped for matching
# neither shape.
if [ "$CALLS" -eq 1 ]; then
    progress_clear
    if [ "$lex_rc" -ne 0 ] || { [ "$parse_rc" -ne 0 ] && [ "$parse_rc" -ne 1 ]; }; then
        [ -s "$LEX_ERR" ] && cat "$LEX_ERR" >&2
        [ -s "$PARSE_ERR" ] && cat "$PARSE_ERR" >&2
        compiler_bug "idlex or idparse failed on this input"
    fi
    awk -F'|' -v e="$WORK/calls.edges" -v c="$WORK/calls.cases" -v d="$WORK/calls.diag" '
        NF == 5 { print > e; next }
        NF == 3 { print > c; next }
        { print > d }
    ' "$RAW_OUT"
    [ -f "$WORK/calls.edges" ] || : > "$WORK/calls.edges"
    [ -f "$WORK/calls.cases" ] || : > "$WORK/calls.cases"
    LC_ALL=C sort -u "$WORK/calls.edges"
    echo
    echo "fn|file:line|cases"
    LC_ALL=C sort -u "$WORK/calls.cases"
    [ -s "$WORK/calls.diag" ] && cat "$WORK/calls.diag" >&2
    [ -s "$PARSE_ERR" ] && cat "$PARSE_ERR" >&2
    rm -f "$RAW_OUT"
    exit "$parse_rc"
fi

# --list-untested reports, one row per function, what the two-case minimum
# would say about the build without building it:
#
#   short|FILE:LINE|NAME|N      a function with N (< 2) cases
#   exempt|FILE:LINE|NAME       a function that cannot be tested on the build host
#
# The rows are the compiler's own diagnostics for those two rules, re-spelled,
# so the list cannot disagree with what a build prints. idc/tools/statusgen
# counts by it. Any other diagnostic goes to stderr and fails the listing,
# because a list from a program that breaks another rule is not the whole list.
if [ "$LIST_UNTESTED" -eq 1 ]; then
    progress_clear
    if [ "$lex_rc" -ne 0 ] || { [ "$parse_rc" -ne 0 ] && [ "$parse_rc" -ne 1 ]; }; then
        [ -s "$LEX_ERR" ] && cat "$LEX_ERR" >&2
        [ -s "$PARSE_ERR" ] && cat "$PARSE_ERR" >&2
        compiler_bug "idlex or idparse failed on this input"
    fi
    SHORT_RE="^(.*):([0-9]+): error: function '([^']*)' has ([0-9]+) test case\(s\); --require-tests needs at least 2 .*"
    EXEMPT_RE="^([^ ].*):([0-9]+): note: function '([^']*)' cannot be tested on the build host .*"
    sed -E -n -e "s/$SHORT_RE/short|\1:\2|\3|\4/p" -e "s/$EXEMPT_RE/exempt|\1:\2|\3/p" "$RAW_OUT"
    OTHER=$(awk '
        /^  (at|why|help|edit|related): / { if (keep) print; next }
        /: error: function .* has [0-9]+ test case\(s\); --require-tests needs at least 2 / { keep = 0; next }
        /: note: function .* cannot be tested on the build host / { keep = 0; next }
        { keep = 1; print }
    ' "$RAW_OUT")
    [ -s "$PARSE_ERR" ] && cat "$PARSE_ERR" >&2
    if [ -n "$OTHER" ]; then
        printf '%s\n' "$OTHER" >&2
        exit 1
    fi
    exit_ok
fi

# Exit code 1 from idparse means the *program* broke a rule of the language,
# not that the self-hosted stages could not cope. Those diagnostics are the
# answer, so report them and stop -- falling back here would hand the program
# to idc.py, which would either repeat the error or, for a rule it does not
# check, quietly accept it.
if [ "$parse_rc" -eq 1 ]; then
    progress_clear
    show_diag "$RAW_OUT" "$PARSE_ERR"
    rm -f "$RAW_OUT"
    exit 1
fi

# --check stops here. A program that broke a rule has just been reported by the
# same lines a build uses; one that did not has only its exemption notes, which
# a build prints before running any case (split_harness, below).
if [ "$CHECK" -eq 1 ]; then
    progress_clear
    if [ "$lex_rc" -ne 0 ] || [ "$parse_rc" -ne 0 ]; then
        [ -s "$LEX_ERR" ] && cat "$LEX_ERR" >&2
        [ -s "$PARSE_ERR" ] && cat "$PARSE_ERR" >&2
        compiler_bug "idlex or idparse failed on this input"
    fi
    show_diag "$RAW_OUT" "$PARSE_ERR"
    [ "$STRUCT_VIOLATIONS" -eq 0 ] && check_ok_line
    exit_ok
fi

if [ "$lex_rc" -ne 0 ] || [ "$parse_rc" -ne 0 ] || [ ! -s "$RAW_OUT" ]; then
    progress_clear
    [ -s "$LEX_ERR" ] && cat "$LEX_ERR" >&2
    [ -s "$PARSE_ERR" ] && cat "$PARSE_ERR" >&2
    C_OUT="$RAW_OUT"
    compiler_bug "idlex or idparse failed on this input"
fi

# idparse's own decomposition warnings (docs/PROJECT.md, "decomposition
# warnings") are on stderr, separate from the notes embedded in RAW_OUT above:
# a normal build reaches here having emitted real C, and this is the one place
# on that path where PARSE_ERR is otherwise never read.
show_diag "$PARSE_ERR"

# ---------------------------------------------------------------------------
# Native backends, linked by what the build reaches.
#
# A backend is attached by being in the build: a directory with a backend.id
# in any collected tree -- the standard library's, a conf.id import, the
# project's own, or a --backend directory -- and its `native` declarations are
# merged as source however it arrived. Attaching one does not link it. idparse lists
# every native reachable from main, and separately every one reachable from
# the test cases, with the call that reaches it and the file that declares it
# (--natives; compiler/parse/back/drive/sink/natives/). A backend is compiled
# and linked only when it declares one of those: an attached backend nothing
# calls costs no compile, no object and no link flag, which is what lets a
# standard library name every backend without hello-world linking X11.
#
# What PROVIDES a native is where it is declared: the attached backend whose
# directory holds the declaring .id file. Not a list of names in its backend.id
# -- a second copy of the declarations, typed in nothing and checked by
# nothing -- and not the object's symbols, which do not exist until the sources
# are compiled, and compiling them is the cost being avoided. A name is declared
# once in a build (a second is "already defined"), so the declaring file
# answers the question exactly, and the declaration is the one the calls were
# type-checked against.
#
# The objects are built at most once per build, shared by the harness and the
# final link, and removed on exit.
PLATKEY_BUILD="$(triple_platform "$TRIPLE")"
BACKEND_OBJS=()
LINK_OBJS=()
LINK_FLAGS=()
declare -A BE_BUILT=() BE_OBJS=() BE_LINK=() BD=() BD_AT=()
BD_NAMES=()
BD_FILE=""
BE_ERR=""
# backends come from both --backend flags and the collected trees. The same
# backend reached both ways must be linked once: twice compiles its sources
# twice and hands cc the same object file twice, which is "multiple definition"
# for every symbol it exports. Collapse by resolved path, first mention winning
# (idc.py: dedupe_backends).
ALL_BACKENDS=()
for d in "${BACKENDS[@]}" "${FOUND_BACKENDS[@]}"; do
    real=$(cd "$d" 2>/dev/null && pwd -P) || real="$d"
    dup=0
    for seen in "${ALL_BACKENDS[@]}"; do
        s=$(cd "$seen" 2>/dev/null && pwd -P) || s="$seen"
        [ "$s" = "$real" ] && dup=1 && break
    done
    [ "$dup" -eq 0 ] && ALL_BACKENDS+=("$d")
done

# backend_of FILE -- the attached backend (as ALL_BACKENDS spells it) whose
# directory holds FILE, or nothing. The deepest wins, so a backend nested in
# another's tree provides its own natives.
backend_of() {
    local dir best="" bestlen=0 d real
    dir="$(cd "$(dirname "$1")" 2>/dev/null && pwd -P)" || return 0
    for d in ${ALL_BACKENDS[@]+"${ALL_BACKENDS[@]}"}; do
        real=$(cd "$d" 2>/dev/null && pwd -P) || continue
        case "$dir/" in
            "$real"/*) [ "${#real}" -gt "$bestlen" ] && { best="$d"; bestlen=${#real}; } ;;
        esac
    done
    printf '%s' "$best"
}

# backend_impl DIR -- set BE_IMPL to the directory whose backend.id links the
# backend DIR is: DIR itself, unless a --backend directory declares the same
# `name`, in which case that one.
#
# This is what --backend is for once the standard library carries the
# backends. The declarations stay where they are -- they are what every call
# was checked against -- and the platform's sources are what a build may want
# to choose: another windowing system on the same platform, or a backend being
# ported. So an override is a directory with a backend.id and its sources and
# no declarations, and it applies to exactly the builds that pass it. Two for
# one backend is refused, not ordered: a build that names both has not chosen.
# Only a declared name matches, so two backends that both leave `name` out are
# never taken for one.
declare -A BE_NAME=()
backend_impl() {
    local d="$1" o real dreal
    BE_IMPL="$d"
    dreal=$(cd "$d" && pwd -P)
    backend_name "$d"
    for o in ${BACKENDS[@]+"${BACKENDS[@]}"}; do
        real=$(cd "$o" && pwd -P)
        [ "$real" = "$dreal" ] && continue
        backend_name "$o"
        [ -n "${BE_NAME[$o]}" ] && [ "${BE_NAME[$o]}" = "${BE_NAME[$d]}" ] || continue
        if [ "$BE_IMPL" != "$d" ]; then
            progress_clear
            echo "idc: --backend: $BE_IMPL and $o both implement backend '${BE_NAME[$d]}'; pass one of them" >&2
            exit 1
        fi
        BE_IMPL="$o"
    done
}

# backend_name DIR -- BE_NAME[DIR]: the name DIR's backend.id declares, or ""
# for none. Read once per directory.
backend_name() {
    [ -n "${BE_NAME[$1]+set}" ] && return 0
    BE_NAME[$1]=""
    [ -f "$1/backend.id" ] || return 0
    backend_decls "$1/backend.id"
    BE_NAME[$1]="${BD[name]-}"
}

# A backend's facts are `id` constant declarations in its backend.id: its name,
# and per compiler target and platform key what that target needs to link it.
#
#   string name = "gfx";
#   string c_header = "gfx.h";                     TARGET_FIELD
#   string[] c_linux_sources = ["gfx_linux.c"];    TARGET_PLATFORM_sources
#   string[] c_linux_cflags = [];                  TARGET_PLATFORM_cflags
#   string[] c_linux_link = ["-lX11"];             TARGET_PLATFORM_link
#   string[] c_linux_pkg = ["sqlite3"];            TARGET_PLATFORM_pkg
#
# A platform exists for a target when its _sources is declared; _cflags, _link
# and _pkg default to empty. _pkg names pkg-config packages: their --cflags
# join _cflags and their --libs join _link (backend_pkg). The target of any other name is the text before its
# first underscore, which is how "its manifest declares" lists them.
#
# The file is never compiled. Were these constants, every name in it would be
# reserved program-wide and emitted as a global in every build that attaches
# the backend, and two backends could not both declare c_linux_sources. Read
# here instead, one backend.id at a time, nothing in it reaches a program, and
# no two backends can collide. It is read the way read_manifest reads conf.id:
# a line is a string or a string[] of string literals without escapes, and any
# other line is refused at its line rather than guessed at.
BD_STR='^string[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*"([^"\\]*)"[[:space:]]*;$'
BD_LIST='^string\[\][[:space:]]+([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*\[[[:space:]]*("[^"\\]*"([[:space:]]*,[[:space:]]*"[^"\\]*")*)?[[:space:]]*\][[:space:]]*;$'
BD_PLAT='^([A-Za-z0-9]+_.+)_(sources|cflags|link|pkg)$'
BD_FIELD='^[A-Za-z0-9]+_[A-Za-z0-9]+$'

bd_fail() { # bd_fail LINE REASON
    progress_clear
    echo "idc: $BD_FILE:$1: invalid backend declarations: $2" >&2
    exit 1
}

# bd_line LINENO TRIMMED -- one declaration into BD, a list's elements joined
# by \x1f, its line into BD_AT and its name onto BD_NAMES.
bd_line() {
    local n="$1" t="$2" kind want name e
    local -a elems=()
    if [[ "$t" =~ $BD_STR ]]; then
        kind=string; name="${BASH_REMATCH[1]}"; BD[$name]="${BASH_REMATCH[2]}"
    elif [[ "$t" =~ $BD_LIST ]]; then
        kind="string[]"; name="${BASH_REMATCH[1]}"
        while IFS= read -r e; do elems+=("${e:1:${#e}-2}"); done \
            < <(printf '%s' "${BASH_REMATCH[2]}" | grep -o '"[^"]*"')
        BD[$name]=$(IFS=$'\x1f'; printf '%s' "${elems[*]}")
    else
        bd_fail "$n" "'$t' is not a string or string[] constant with a literal value"
    fi
    if [ -n "${BD_AT[$name]:-}" ]; then
        bd_fail "$n" "'$name' is already declared at line ${BD_AT[$name]}"
    fi
    if [ "$name" = name ] || [[ "$name" =~ $BD_FIELD ]]; then
        want=string
    elif [[ "$name" =~ $BD_PLAT ]]; then
        want="string[]"
    else
        bd_fail "$n" "'$name' is not name, TARGET_FIELD, or TARGET_PLATFORM_sources, _cflags, _link or _pkg"
    fi
    [ "$kind" = "$want" ] || bd_fail "$n" "'$name' is a $want, not a $kind"
    BD_AT[$name]="$n"
    BD_NAMES+=("$name")
}

# backend_decls FILE -- read and check a backend.id into BD, BD_AT, BD_NAMES.
backend_decls() {
    local lineno=0 line trimmed name
    BD_FILE="$1"
    BD=()
    BD_AT=()
    BD_NAMES=()
    while IFS= read -r line || [ -n "$line" ]; do
        lineno=$((lineno + 1))
        trimmed="${line#"${line%%[![:space:]]*}"}"
        trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
        [ -z "$trimmed" ] && continue
        case "$trimmed" in //*) continue ;; esac
        bd_line "$lineno" "$trimmed"
    done < "$BD_FILE"
    for name in ${BD_NAMES[@]+"${BD_NAMES[@]}"}; do
        [[ "$name" =~ $BD_PLAT ]] || continue
        [ -n "${BD_AT[${BASH_REMATCH[1]}_sources]:-}" ] \
            || bd_fail "${BD_AT[$name]}" "'$name' has no ${BASH_REMATCH[1]}_sources, which is what declares a platform"
    done
}

# A backend's object is cached by content, so a build that already compiled
# these sources does not run cc over them again (0.5 s a build for the three
# the stdlib's windowing programs reach). Only with the default cc: an explicit
# --cc is a wrapper built to observe this build's compiles (tests/backends.sh),
# and a cache hit would hide the call. Kept apart from OBJ_CACHE_DIR, whose
# entry counts tests/cache.sh asserts.
BACKEND_OBJ_DIR="$CACHE_DIR/backend_obj"

# backend_obj_key DIR SRC CFLAGS... -- what decides the object: cc and its
# flags, the platform, and every file under DIR (the sources and the headers
# beside them; a backend's own .gen.o is output, not input, and hidden
# directories and BUILD_DIR are pruned as collect_ids prunes them).
backend_obj_key() {
    local d="$1" cc_path kcc="${BE_CC:-$CC}"
    shift
    {
        printf '%s\0' "$kcc" "$TRIPLE" "$PLATKEY_BUILD" "$@"
        cc_path="$(command -v "$kcc" 2>/dev/null)"
        [ -n "$cc_path" ] && sha256sum < "$cc_path"
        (cd "$d" && find . -mindepth 1 \
             \( -type d -name '.*' -prune \) -o \
             \( -type d -path "./$BUILD_DIR" -prune \) -o \
             \( -type f ! -name '*.gen.o' -print0 \) \
            | LC_ALL=C sort -z \
            | xargs -0 -r sha256sum)
    } | sha256sum | cut -d' ' -f1
}

# backend_obj_put KEY OBJ -- keep OBJ under KEY. Best-effort, like obj_cache_put.
backend_obj_put() {
    local entry="$BACKEND_OBJ_DIR/$1" tmp
    tmp=$(mktemp -d "$WORK/bo.XXXXXX") && cp "$2" "$tmp/o" || return 0
    mkdir -p "$BACKEND_OBJ_DIR" && rm -rf "$entry" && mv -f "$tmp" "$entry"
    cache_prune "$BACKEND_OBJ_DIR" "$CACHE_MAX"
}

# backend_pkg DIR PKG... -- resolve pkg-config packages a backend.id names into
# PKG_CFLAGS and PKG_LIBS. A missing pkg-config or package stops the build and
# names the fix. The resolved flags are appended to the backend's own, so they
# are in backend_obj_key (the object) and in LINK_FLAGS, which obj_cache_key
# hashes (the program): a library that moved or changed flags rebuilds both.
backend_pkg() {
    local d="$1" pkg out
    shift
    PKG_CFLAGS=()
    PKG_LIBS=()
    if ! command -v pkg-config >/dev/null 2>&1; then
        progress_clear
        echo "idc: $d/backend.id: c_${PLATKEY_BUILD}_pkg names '$*', which needs pkg-config, and none is on PATH; run under the devshell (nix develop), or install pkg-config, or replace _pkg with literal _cflags and _link" >&2
        exit 1
    fi
    for pkg in "$@"; do
        [ -z "$pkg" ] && continue
        if ! out=$(pkg-config --print-errors --exists "$pkg" 2>&1); then
            progress_clear
            echo "idc: $d/backend.id: c_${PLATKEY_BUILD}_pkg names '$pkg', and pkg-config cannot find it (${out%%$'\n'*}); add the package that provides it to the devshell (flake.nix buildInputs), or install its development files, or point PKG_CONFIG_PATH at the directory holding $pkg.pc" >&2
            exit 1
        fi
    done
    out=$(pkg-config --cflags "$@") && read -ra PKG_CFLAGS <<< "$out"
    out=$(pkg-config --libs "$@") && read -ra PKG_LIBS <<< "$out"
}

# backend_build DIR -- compile DIR's sources for this platform, once per build.
# Declarations that cannot serve this build set BE_ERR and return 1, so the
# caller can say which reached native needed it. A C-target program that links with
# LTO gets its backends compiled for it too (fat objects, -std=gnu17 -- cc has to
# see the same language as the units, or it will not inline across them -- and
# -fwrapv), so a native like sqrt can inline; a --lib, llvm or wasm build, or a
# clang cc (thin LTO objects do not link without -flto), keeps the plain -O2 object.
backend_build() {
    local d="$1" sources_line cflags_line link_line pkg_line src src_path obj backend_rc bkey bcc="$CC" btag=""
    local -a srcs=() cflags=() objs=() pkgs=() links=() ltof=()
    local -a PKG_CFLAGS=() PKG_LIBS=()
    BE_ERR=""
    [ "${BE_LLVM_LTO:-0}" -eq 1 ] && [ "$LIB" -eq 0 ] && [ "$CC_LTO" -eq 1 ] && command -v clang >/dev/null 2>&1 && { bcc=clang; btag="|llvm"; }
    BE_TAG="$btag"
    [ -n "${BE_BUILT[$d$btag]:-}" ] && return 0
    backend_supports "$d" || return 1
    sources_line="${BD[c_${PLATKEY_BUILD}_sources]}"
    cflags_line="${BD[c_${PLATKEY_BUILD}_cflags]:-}"
    link_line="${BD[c_${PLATKEY_BUILD}_link]:-}"
    IFS=$'\x1f' read -ra srcs <<< "$sources_line"
    IFS=$'\x1f' read -ra cflags <<< "$cflags_line"
    pkg_line="${BD[c_${PLATKEY_BUILD}_pkg]:-}"
    if [ -n "$pkg_line" ]; then
        IFS=$'\x1f' read -ra pkgs <<< "$pkg_line"
        backend_pkg "$d" "${pkgs[@]}"
        cflags+=(${PKG_CFLAGS[@]+"${PKG_CFLAGS[@]}"})
        IFS=$'\x1f' read -ra links <<< "$link_line"
        links+=(${PKG_LIBS[@]+"${PKG_LIBS[@]}"})
        link_line=$(IFS=$'\x1f'; printf '%s' "${links[*]}")
    fi
    [ "$LIB" -eq 1 ] && cflags+=(-fPIC -ffunction-sections -fdata-sections)
    [ "$LIB" -eq 0 ] && [ "$TARGET" = c ] && [ "$CC_LTO" -eq 1 ] && cc_lto_setup && [ "${CC_LTO_COMPILE[*]}" = -flto ] && ltof=(-std=gnu17 -flto -ffat-lto-objects -fwrapv)
    [ -n "$btag" ] && ltof=(-std=gnu17 -flto -ffat-lto-objects -fwrapv)
    BE_CC="$bcc"
    for src in ${srcs[@]+"${srcs[@]}"}; do
        [ -z "$src" ] && continue
        src_path="$d/$src"
        obj="${src_path%.*}.gen.o"
        bkey=""
        [ "$CACHE_ON" -eq 1 ] && [ "$CC_EXPLICIT" -eq 0 ] && bkey=$(backend_obj_key "$d" "$src_path" ${ltof[@]+"${ltof[@]}"} ${cflags[@]+"${cflags[@]}"})
        if [ -n "$bkey" ] && [ -f "$BACKEND_OBJ_DIR/$bkey/o" ] && cp "$BACKEND_OBJ_DIR/$bkey/o" "$obj"; then
            touch "$BACKEND_OBJ_DIR/$bkey"
        else
            capped "$bcc" -O2 ${ltof[@]+"${ltof[@]}"} -c "$src_path" -o "$obj" ${cflags[@]+"${cflags[@]}"}; backend_rc=$?
            if [ "$backend_rc" -ne 0 ]; then
                progress_clear
                if mem_ceiling_hit "$backend_rc"; then
                    mem_ceiling_error "cc (backend: $src_path)"
                else
                    echo "idc: backend compile failed for $src_path" >&2
                fi
                exit 1
            fi
            [ -n "$bkey" ] && backend_obj_put "$bkey" "$obj"
        fi
        BACKEND_OBJS+=("$obj")
        objs+=("$obj")
    done
    BE_OBJS[$d$btag]=$(IFS=$'\x1f'; printf '%s' "${objs[*]}")
    BE_LINK[$d$btag]="$link_line"
    BE_BUILT[$d$btag]=1
}

# backend_supports DIR -- read DIR's backend.id into BD, and return 1 with
# BE_ERR set when it has nothing for the C target on this build's platform.
# Nothing is compiled, so a build can ask before it has built anything.
backend_supports() {
    local d="$1" file name have n
    BE_ERR=""
    file="$d/backend.id"
    if [ ! -f "$file" ]; then
        progress_clear
        echo "idc: backend has no backend.id: $file" >&2
        exit 1
    fi
    backend_decls "$file"
    name="${BD[name]-backend}"
    if [ -z "${BD_AT[c_${PLATKEY_BUILD}_sources]:-}" ]; then
        have=""
        # A target is compiled for only when it declares something; the C
        # target's absence is named before any platform is asked about.
        if ! printf '%s\n' ${BD_NAMES[@]+"${BD_NAMES[@]}"} | grep -q '^c_'; then
            for n in $(printf '%s\n' ${BD_NAMES[@]+"${BD_NAMES[@]}"} | grep -v '^name$' | sed 's/_.*//' | LC_ALL=C sort -u); do
                have="${have:+$have, }$n"
            done
            BE_ERR="backend '$name' has no implementation for the C target (its manifest declares: ${have:-none})"
            return 1
        fi
        # Name the triple, not just the key: the key is derived from it, and
        # the triple is the thing the user can change. Naming what the backend
        # does have turns "unsupported" into a choice between porting it and
        # picking a platform it already covers.
        for n in $(printf '%s\n' ${BD_NAMES[@]+"${BD_NAMES[@]}"} | sed -n 's/^c_\(.*\)_sources$/\1/p' | LC_ALL=C sort); do
            have="${have:+$have, }$n"
        done
        BE_ERR="backend '$name' has no support for platform '$PLATKEY_BUILD' (building for '$TRIPLE'); it is implemented for: ${have:-no platform at all}"
        return 1
    fi
}

# backends_for KIND [check] -- set LINK_OBJS and LINK_FLAGS to what the natives
# KIND reaches need ("program": from main; "harness": from the cases), building
# any backend not built yet, in the order the backends were attached. A reached
# native nothing attached can link stops the build at the call that reaches
# it, rather than at the linker naming id_<name>. With `check`, only that
# question is asked: backend.id files are read and nothing is compiled.
backends_for() {
    local kind="$1" mode="${2:-link}" from=main row_kind name site decl be d msg
    local -A need_site=() need_name=() be_of=()
    local -a objs=() flags=()
    [ "$kind" = harness ] && from="a test case"
    LINK_OBJS=()
    LINK_FLAGS=()
    while IFS='|' read -r row_kind name site decl; do
        [ "$row_kind" = "$kind" ] || continue
        if [ -z "${be_of[$decl]+x}" ]; then
            be_of[$decl]=$(backend_of "$decl")
        fi
        be="${be_of[$decl]}"
        if [ -z "$be" ]; then
            progress_clear
            echo "$site: error: native '$name', reached from $from by this call, has no implementation for platform '$PLATKEY_BUILD' (building for '$TRIPLE'): it is declared in $decl, which is not in an attached backend" >&2
            exit 1
        fi
        [ -n "${need_site[$be]:-}" ] && continue
        need_site[$be]="$site"
        need_name[$be]="$name"
    done < "$NATIVES"
    for d in ${ALL_BACKENDS[@]+"${ALL_BACKENDS[@]}"}; do
        [ -n "${need_site[$d]:-}" ] || continue
        backend_impl "$d"
        if [ "$mode" = check ]; then
            backend_supports "$BE_IMPL" && continue
        elif backend_build "$BE_IMPL"; then
            IFS=$'\x1f' read -ra objs <<< "${BE_OBJS[$BE_IMPL$BE_TAG]}"
            IFS=$'\x1f' read -ra flags <<< "${BE_LINK[$BE_IMPL$BE_TAG]}"
            LINK_OBJS+=(${objs[@]+"${objs[@]}"})
            LINK_FLAGS+=(${flags[@]+"${flags[@]}"})
            continue
        fi
        progress_clear
        msg="${BE_ERR/"' has "/"', which has "}"
        echo "${need_site[$d]}: error: native '${need_name[$d]}', reached from $from by this call, is implemented by $msg" >&2
        exit 1
    done
}

# backends_for_program -- backends_for program, but only when the build
# actually has a `main` to link them into (have_main, set by each target
# before this runs); a .o has nothing to link them into, so a backend the
# program reaches is named but left unbuilt. Shared by the C and LLVM
# targets: both link the program's own natives the same way, into the same
# objects and flags, so the collection lives once rather than being copied.
backends_for_program() {
    LINK_OBJS=()
    LINK_FLAGS=()
    if [ "$have_main" -eq 0 ]; then
        if grep -q '^program|' "$NATIVES"; then
            echo "idc: backend(s) ignored: this project has no main (builds to a .o);" \
                 "link the backend into the final program" >&2
        fi
    else
        [ "$TARGET" = llvm ] && BE_LLVM_LTO=1
        backends_for program
    fi
}

# ---------------------------------------------------------------------------
# The cases written under the program's functions run on every build, before
# any output exists, and a case that does not pass fails the build -- there is
# no flag, and no way to get a program out of a tree whose cases fail
# (docs/TESTS.md). Every function in the build is covered: the program's own
# tree, its dependencies and the standard library.
#
# idparse wrote the harness ahead of the program, up to a separator line. An
# empty harness means no function in the build has a case, and then nothing
# runs and nothing is required of the build.
HARNESS_SEP='/* ---- end of test harness ---- */'

# A stage 0 older than --harness ignores the flag and writes no separator. That
# can only be the bootstrap building stage 1 from a bootstrap/*.c that predates
# the harness, and it is said rather than skipped; any other missing separator
# is a compiler bug.
#
# The natives list (see backends_for) follows the program behind a separator of
# its own. A stage 0 older than --natives writes none, and building the
# compiler reaches no native, so there an absent list is an empty one.
NATIVES_SEP='/* ---- natives ---- */'
NATIVES="$WORK/natives"
# The exemption notes, when the build has any, follow the natives behind a
# separator of their own (compiler/parse/back/drive/sink/notes.id) and are
# printed on stderr before any case runs.
NOTES_SEP='/* ---- notes ---- */'
NOTES="$WORK/notes"
split_harness() {
    : > "$NATIVES"
    : > "$NOTES"
    if ! grep -qxF "$NATIVES_SEP" "$RAW_OUT" && [ -z "${IDC_STAGE_PARSE:-}" ]; then
        C_OUT="$RAW_OUT"
        compiler_bug "idparse did not emit the natives list"
    fi
    if grep -qxF "$HARNESS_SEP" "$RAW_OUT"; then
        awk -v sep="$HARNESS_SEP" -v nsep="$NATIVES_SEP" -v msep="$NOTES_SEP" -v h="$HARNESS_C" -v p="$C_OUT" -v n="$NATIVES" -v m="$NOTES" '
            BEGIN { o = h; printf "" > h; printf "" > p; printf "" > n; printf "" > m }
            o == h && $0 == sep { o = p; next }
            o == p && $0 == nsep { o = n; next }
            o == n && $0 == msep { o = m; next }
            { print > o }' "$RAW_OUT"
    elif [ -n "${IDC_STAGE_PARSE:-}" ]; then
        mv "$RAW_OUT" "$C_OUT"
        : > "$HARNESS_C"
        progress_clear
        echo "idc: note: stage 0 (bootstrap/idparse.c) predates the test harness, so the cases" \
             "of this stage's build were not run; tools/regen_bootstrap.sh brings it forward" >&2
    else
        C_OUT="$RAW_OUT"
        compiler_bug "idparse did not emit the test harness separator"
    fi
}

# ---------------------------------------------------------------------------
# The case-result cache. idparse writes a key for every case at the top of
# the harness, `// idtc key N KEY` (compiler/parse/mid/form/unique/dump/
# digest/keys/emit.id): a hash of the case's own tokens and of every function
# it can reach -- the conf.id constants it reads, directly or through another
# constant's initialiser, included -- `KEY f` for a case that reaches natives
# which only read files or are marked when they do anything else (see "Files a
# case reads", below), or `std` for a library case the program's harness never
# runs. Every other case, a scaling claim's or one that reaches the clock, has
# a plain KEY; `-` is left only for a harness without keys. What
# the source cannot say is hashed here, once per build, into the name of the
# pass list the keys are looked up in: the two compiler stages (which also
# write the runtime and the harness), cc, and the host. A case whose key is on
# that list is not run; when no case is left, the harness is neither compiled
# nor run. A key joins the list only when the harness itself reports its case
# as passed, so a failing case is never taken for a pass. Each entry carries
# the time it was recorded, and one older than IDC_CASE_MAX_AGE_DAYS (default
# 7; 0 reruns everything) is run again, which is what keeps a case that no
# hash can invalidate (a clock, a device) honest. The cases of a scaling claim
# are skipped together or run together, since the claim compares their counts.
#
# IDC_NO_CACHE=1 turns this off with the other caches: every case runs.
# IDC_FRESH_CASES=PATH runs every case whose function belongs to the source
# tree at PATH, and caches the rest as usual (idc/tools/tmpguard uses it).
# IDC_CASE_STATS=1 prints `idc: cases: N total, H already passed, T to run`
# on stderr once the plan is made, which tests/cache.sh counts reruns by.
CASE_CACHE_DIR="$CACHE_DIR/cases"
CASE_KEEP="${IDC_CASE_KEYS:-200000}"
CASE_MAX_AGE_DAYS="${IDC_CASE_MAX_AGE_DAYS:-7}"

# case_cache_global BACKENDHASH -- the build's part of every case key: see above.
# BACKENDHASH covers the C and JS sources of the backends the harness's natives
# link, so editing a shim reruns the cases of the programs that link it.
case_cache_global() {
    local cc_path
    {
        sha256sum < "$IDLEX"
        sha256sum < "$IDPARSE"
        printf '%s\0' "$CC" "$(host_triple)" "pass list v3: backend sources" "${1:-}"
        cc_path="$(command -v "$CC" 2>/dev/null)"
        [ -n "$cc_path" ] && sha256sum < "$cc_path"
    } | sha256sum | cut -d' ' -f1
}

# Files a case reads. A key followed by ` f` in the harness (`// idtc key N KEY
# f`) is a case whose only natives are file-pure (compiler/parse/conf.id,
# cache_file_natives): it has a real key, but what it passes on also depends on
# the files it read. idstd's fs backend logs every path a case reads or probes,
# found or not, to $IDTC_READS/N (idstd host/io/fs/fs_posix.c), and a write or a
# device marks the case with a T line, which is never cached. When the case
# passes, case_record hashes each logged path and stores the key, with every
# (kind, hash, path) the case read, as one tab-separated line of the pass
# list:
#
#   KEY/BACKENDHASH TAB epoch [TAB kind TAB hash TAB path]...
#
# and case_plan skips the case only when KEY/BACKENDHASH is on the list and
# every path still hashes as recorded, each distinct path hashed once per
# build (reads_probe). A kind says what the case asked of the path, so what is
# hashed is what it could have seen: r the bytes of a file it opened (- when
# there was none), s its size, m its mtime, e whether it exists, l the sorted
# names, each with a d or other type letter, of a directory it listed. The
# backend's own source is part of the key, because a read log written by other
# code means nothing.

# case_backend_key -- a hash of the backend directories the harness's natives
# are implemented by, for the keys of cases that read files.
case_backend_key() {
    local row_kind name site decl be d
    local -A seen=() of=()
    local -a dirs=()
    while IFS='|' read -r row_kind name site decl; do
        [ "$row_kind" = harness ] || continue
        [ -n "${of[${decl%/*}]+x}" ] || of[${decl%/*}]=$(backend_of "$decl")
        be="${of[${decl%/*}]}"
        [ -n "$be" ] && [ -z "${seen[$be]:-}" ] || continue
        seen[$be]=1
        backend_impl "$be"
        dirs+=("$BE_IMPL")
    done < "$NATIVES"
    [ "${#dirs[@]}" -gt 0 ] || return 0
    find "${dirs[@]}" -mindepth 1 \
         \( -type d -name '.*' -prune \) -o \
         \( -type d -name "$BUILD_DIR" -prune \) -o \
         \( -type f ! -name '*.gen.o' -print0 \) \
        | LC_ALL=C sort -z | xargs -0 -r sha256sum | sha256sum | cut -c1-16
}

# reads_probe WANT OUT -- WANT is `kind TAB path` lines; OUT gets `kind TAB path
# TAB hash TAB ident` for each: the hash described above, and the stamp
# (size:mtime to the nanosecond) the fs backend logs for r and l, which is what
# lets case_record see that a file changed while the case ran. One stat, one
# sha256sum and one find per directory serve every path.
reads_probe() {
    local want="$1" out="$2" prior="${3:-/dev/null}" st="$WORK/rd.stat" sh="$WORK/rd.sha" dh="$WORK/rd.dirs" d h
    local need='BEGIN { while ((getline line < prior) > 0) { split(line, g, "\t"); PI[g[1] "\t" g[2]] = g[4] } }
        FNR == NR { t[$1] = $2; id[$1] = $3 ":" $5; next }
        ($2 in t) && PI[$1 "\t" $2] != id[$2]'
    cut -f2- "$want" | LC_ALL=C sort -u | tr '\n' '\0' \
        | xargs -0 -r stat -L -c $'%n\t%F\t%s\t%Y\t%.9Y' -- > "$st" 2>/dev/null
    awk -F'\t' -v prior="$prior" "$need"' && $1 == "r" && t[$2] ~ /^regular/ { print $2 }' "$st" "$want" \
        | LC_ALL=C sort -u | tr '\n' '\0' | xargs -0 -r sha256sum -- > "$sh" 2>/dev/null
    : > "$dh"
    while IFS= read -r d; do
        h=$(find -L "$d" -mindepth 1 -maxdepth 1 -printf '%y %f\0' 2>/dev/null | LC_ALL=C sort -z | sha256sum | cut -c1-64)
        printf '%s\t%s\n' "$d" "$h" >> "$dh"
    done < <(awk -F'\t' -v prior="$prior" "$need"' && $1 == "l" && t[$2] == "directory" { print $2 }' "$st" "$want" | LC_ALL=C sort -u)
    awk -F'\t' -v st="$st" -v sh="$sh" -v dh="$dh" -v prior="$prior" '
        BEGIN {
            while ((getline line < st) > 0) {
                n = split(line, f, "\t"); T[f[1]] = f[2]; Z[f[1]] = f[3]; M[f[1]] = f[4]; I[f[1]] = f[3] ":" f[5]
            }
            while ((getline line < sh) > 0) S[substr(line, 67)] = substr(line, 1, 64)
            while ((getline line < dh) > 0) { n = split(line, f, "\t"); D[f[1]] = f[2] }
            while ((getline line < prior) > 0) { n = split(line, f, "\t"); PH[f[1] "\t" f[2]] = f[3]; PI[f[1] "\t" f[2]] = f[4] }
        }
        {
            k = $1; p = $2; h = "-"; id = "-"; kp = k "\t" p
            if (p in T) {
                id = I[p]
                if (k == "e") { h = "1"; id = h }
                else if (k == "s") { h = Z[p]; id = h }
                else if (k == "m") { h = M[p]; id = h }
                else if (k == "r") h = (T[p] !~ /^regular/) ? "x" : (PI[kp] == id) ? PH[kp] : (p in S) ? S[p] : "?"
                else if (k == "l") h = (T[p] != "directory") ? "-" : (PI[kp] == id) ? PH[kp] : (p in D) ? D[p] : "?"
            } else if (k == "e") { h = "0"; id = h }
            if (k == "l" && (!(p in T) || T[p] != "directory")) id = "-"
            printf "%s\t%s\t%s\t%s\n", k, p, h, id
        }' "$want" > "$out"
}

# case_plan_awk TOTAL HAVE -- case_plan's awk. Without HAVE (a file of
# reads_probe's output) a case whose recorded files cannot be judged yet counts
# as one to run and its (kind, path) pairs are written to rd.want; with it they
# are judged. A case runs when its key is not on the pass list, when its entry
# is older than CASE_MAX_AGE_SECONDS, when it lives in the tree IDC_FRESH_CASES
# names, or when it shares a scaling claim with a case that runs (the claim
# compares their counts, so a group is all skipped or none).
case_plan_awk() {
    awk -v n="$1" -v list="$CASE_FILE" -v have="$2" -v bh="$CASE_BH" -v want="$WORK/rd.want" \
        -v now="$CASE_NOW" -v maxage="$CASE_MAX_AGE_SECONDS" -v fresh="$CASE_FRESH" -v cdir="$CASE_DEFAULT_DIR" '
        function fresh_case(k,   d) {
            d = (k in D) ? D[k] : cdir
            return fresh != "" && (d == fresh || index(d, fresh "/") == 1)
        }
        BEGIN {
            while ((getline line < list) > 0) { k = line; sub(/\t.*/, "", k); ok[k] = line }
            if (have != "") while ((getline line < have) > 0) { c = split(line, f, "\t"); H[f[1] "\t" f[2]] = f[3] }
        }
        /^\/\/ idtc key / { K[$4] = $5; F[$4] = $6; next }
        /^    idtc_dir\[[0-9]+\] = "/ {
            t = $0; sub(/^    idtc_dir\[/, "", t); i = t; sub(/\].*$/, "", i)
            sub(/^[^"]*"/, "", t); sub(/";.*$/, "", t); D[i] = t
        }
        /idtc_claim\(\(int\[\]\)\{/ {
            t = $0; sub(/^[^{]*\{/, "", t); sub(/\}.*$/, "", t)
            groups[++ng] = t
        }
        END {
            for (k = 0; k < n; k++) {
                if (!(k in K)) continue
                key = K[k]
                if (key == "std") { skip[k] = 1; continue }
                if (key == "-" || fresh_case(k)) continue
                lk = (F[k] == "f") ? key "/" bh : key
                if (!(lk in ok)) continue
                c = split(ok[lk], f, "\t")
                if (maxage >= 0 && now - f[2] >= maxage) continue
                if (F[k] != "f") { skip[k] = 1; hit[k] = 1; continue }
                good = 1
                for (i = 3; i + 2 <= c; i += 3) {
                    q = f[i] "\t" f[i + 2]
                    if (have == "") {
                        if (!(q in asked)) { asked[q] = 1; print q > want }
                        good = 0
                    } else if (!(q in H) || H[q] != f[i + 1]) good = 0
                }
                if (good) { skip[k] = 1; hit[k] = 1 }
            }
            do {
                changed = 0
                for (g = 1; g <= ng; g++) {
                    c = split(groups[g], a, ", ")
                    all = 1
                    for (i = 1; i <= c; i++) if (!(a[i] in skip)) all = 0
                    if (all) continue
                    for (i = 1; i <= c; i++) if (a[i] in hit) { delete skip[a[i]]; delete hit[a[i]]; changed = 1 }
                }
            } while (changed)
            s = ""; hits = 0; todo = 0
            for (k = 0; k < n; k++) {
                s = s ((k in skip) ? "1" : "0")
                if (k in hit) hits++
                else if ((k in K) && !(k in skip)) todo++
            }
            print hits, todo, s
        }' "$HARNESS_C"
}

# case_plan -- which cases this build still has to run. Sets CASE_FILE (the
# pass list), CASE_MASK (one character per case, '1' for a case not to run:
# the harness's $IDTC_SKIP), CASE_HITS (cases skipped because their key has
# already passed) and CASE_TODO (cases left to run). With the cache off, or a
# harness with no keys in it -- stage 0's, until it is regenerated -- the mask
# is empty, which the harness reads as "run everything".
case_plan() {
    CASE_FILE="" CASE_MASK="" CASE_HITS=0 CASE_TODO=1 CASE_TRACK=0 CASE_BH=""
    [ "$CACHE_ON" -eq 1 ] || return 0
    grep -q '^// idtc key ' "$HARNESS_C" || return 0
    CASE_BH=$(case_backend_key)
    CASE_FILE="$CASE_CACHE_DIR/$(case_cache_global "$CASE_BH")"
    local total plan
    total=$(sed -n 's/^#define IDTC_N //p' "$HARNESS_C")
    CASE_NOW=$(date +%s)
    case "$CASE_MAX_AGE_DAYS" in
        ''|*[!0-9]*) CASE_MAX_AGE_SECONDS=$((7 * 86400)) ;;
        *) CASE_MAX_AGE_SECONDS=$((CASE_MAX_AGE_DAYS * 86400)) ;;
    esac
    CASE_DEFAULT_DIR="$PATH_ARG"
    [ -d "$CASE_DEFAULT_DIR" ] || CASE_DEFAULT_DIR=$(dirname "$CASE_DEFAULT_DIR")
    CASE_DEFAULT_DIR=$(realpath -m "$CASE_DEFAULT_DIR")
    CASE_FRESH=""
    [ -z "${IDC_FRESH_CASES:-}" ] || CASE_FRESH=$(realpath -m "$IDC_FRESH_CASES")
    if grep -q '^// idtc key [0-9]* [^ ]* f$' "$HARNESS_C"; then
        CASE_TRACK=1
    fi
    : > "$WORK/rd.want"
    plan=$(case_plan_awk "$total" "")
    if [ "$CASE_TRACK" -eq 1 ] && [ -s "$WORK/rd.want" ] && reads_probe "$WORK/rd.want" "$WORK/rd.have"; then
        plan=$(case_plan_awk "$total" "$WORK/rd.have")
    fi
    read -r CASE_HITS CASE_TODO CASE_MASK <<< "$plan"
    # The mask travels in the environment, where one string may not pass
    # 128 KiB on Linux; past that, every case runs rather than none starting.
    [ "${#CASE_MASK}" -gt 100000 ] && CASE_MASK=""
}

# case_record_reads -- the pass-list lines of the cases that passed and read
# files (see "Files a case reads", above), on stdout. A case that wrote outside the
# trees it made (a T line in its log) is recorded all the same: what it reads
# from a path that changed while it ran is left out of its entries, since its
# own writes made it change, and the weekly expiry covers what no read shows. A
# case is left out when two of its lines disagree about a path, when a path no
# longer has the stamp the case saw and the case wrote nothing (it changed
# while the case ran: the hash taken now would not be what the case read), or
# when another case with the same key was left out for any of these.
case_record_reads() {
    local rec="$WORK/rd.rec" want="$WORK/rd.rwant" have="$WORK/rd.rhave"
    : > "$rec"
    : > "$want"
    awk -v bh="$CASE_BH" -v dir="$WORK/reads" -v rec="$rec" -v want="$want" 'FNR == NR { p[$1] = 1; next }
        /^\/\/ idtc key / && ($4 in p) && $6 == "f" && $5 != "-" {
            lk = $5 "/" bh; lg = dir "/" $4
            print lk "\t\t\t" > rec
            while ((r = (getline line < lg)) > 0) {
                split(line, f, "\t")
                if (f[1] == "T") { print lk "\tBAD\t\t" > rec; continue }
                print lk "\t" f[1] "\t" f[2] "\t" f[3] > rec
                q = f[1] "\t" f[3]
                if (!(q in asked)) { asked[q] = 1; print q > want }
            }
            close(lg)
        }' "$WORK/passed" "$HARNESS_C"
    [ -s "$rec" ] || return 0
    : > "$have"
    [ -s "$want" ] && { reads_probe "$want" "$have" "$WORK/rd.have" || return 0; }
    awk -F'\t' -v have="$have" -v now="$now" '
        BEGIN {
            while ((getline line < have) > 0) { split(line, f, "\t"); H[f[1] "\t" f[2]] = f[3]; I[f[1] "\t" f[2]] = f[4] }
        }
        {
            if (FNR == NR) { if ($2 == "BAD") wrote[$1] = 1; next }
            lk = $1
            if (!(lk in seen)) { seen[lk] = 1; order[++m] = lk }
            if ($2 == "BAD") next
            if ($2 == "") next
            q = $2 "\t" $4
            if (H[q] == "?" || (($2 == "r" || $2 == "l") ? I[q] != $3 : H[q] != $3)) { if (!(lk in wrote)) bad[lk] = 1; next }
            if (!((lk, q) in got)) { got[lk, q] = 1; ln[lk] = ln[lk] "\t" $2 "\t" H[q] "\t" $4 }
        }
        END { for (i = 1; i <= m; i++) if (!(order[i] in bad)) print order[i] "\t" now ln[order[i]] }' "$rec" "$rec"
}

# case_record -- add the key of every case the harness reported as passed
# ($WORK/passed, which only the harness writes) to CASE_FILE. Called whether
# or not the run passed as a whole: a case that passed in a failing build
# still passed. The list is written whole beside itself and renamed over the
# old one, so a build reading it at the same moment sees one list or the
# other; the newest CASE_KEEP keys are kept, newest last.
case_record() {
    [ -n "$CASE_FILE" ] && [ -s "$WORK/passed" ] || return 0
    mkdir -p "$CASE_CACHE_DIR" || return 0
    local tmp="$CASE_FILE.$$.tmp" now
    now=$(date +%s)
    if [ "${CASE_RC:-0}" -ne 0 ]; then
        awk 'FNR == NR { p[$1] = 1; next }
            /idtc_claim\(\(int\[\]\)\{/ { t = $0; sub(/^[^{]*\{/, "", t); sub(/\}.*$/, "", t); c = split(t, a, ", "); for (i = 1; i <= c; i++) drop[a[i]] = 1 }
            END { for (k in p) if (!(k in drop)) print k }' "$WORK/passed" "$HARNESS_C" > "$WORK/passed.kept" && mv -f "$WORK/passed.kept" "$WORK/passed"
    fi
    {
        [ -f "$CASE_FILE" ] && cat "$CASE_FILE"
        awk -v now="$now" 'FNR == NR { p[$1] = 1; next }
             /^\/\/ idtc key / && ($4 in p) && $5 != "-" && $5 != "std" && $6 != "f" { print $5 "\t" now }' \
            "$WORK/passed" "$HARNESS_C"
        [ "$CASE_TRACK" -eq 1 ] && case_record_reads
    } | tac | awk -F'\t' '!seen[$1]++' | head -n "$CASE_KEEP" | tac > "$tmp" && mv -f "$tmp" "$CASE_FILE"
    rm -f "$tmp"
    cache_prune "$CASE_CACHE_DIR" "$CACHE_MAX"
}

# ---------------------------------------------------------------------------
# Per-unit compilation (UNITS_ON, above). The C idparse writes is, in order:
# the runtime prelude, the forward declarations, the exported variables, the
# function definitions -- each file's preceded by its `/* idc unit: PATH */`
# marker -- and then the main wrapper or, in a harness, the case table from
# `#define IDTC_N` on. unit_split cuts it into:
#
#   idc.h  the prelude, every prototype, and an `extern` for each exported
#          variable and for each piece of the prelude's own state -- which is
#          `static` in one translation unit and has to be one object here
#   u0.c   that state and those variables, defined once
#   uN.c   the definitions, a run of source files each: a run ends before a
#          file whose path hashes to 0 modulo IDC_UNIT_FILES (default 16), so
#          where one ends depends on that file's path alone and adding or
#          removing a file moves at most its own run's edges. 1 is a unit
#          per file; but every unit parses idc.h, all the prototypes, so on
#          the compiler's own tree (1100 files) 16 compiled cold in 2.4 s at
#          -O2 with four jobs, 4 took 4.4 s, and one whole file 4.3 s
#   ut.c   the main wrapper, or the case table with every case the harness
#          will skip (CASE_MASK) cut out, so a build that runs a few cases
#          compiles a few
#
# The prelude's functions stay `static` in idc.h, so every unit can still
# inline them -- `static inline`, which is what keeps cc from generating all
# of them in every unit at -O0 (0.35 s a unit on the compiler's harness,
# against 0.07 s) -- and the three it defines with external linkage (id_alloc,
# id_store_span, which native backends call, and id_str_of_cstr, which the wasm
# host calls) become weak. `list` is the units
# in link order; `syms` names what was `static` state, which a relocatable
# object (a program with no main) makes local again after linking.
unit_split() { # unit_split C_FILE DIR MASK
    awk -v dir="$2" -v mask="$3" -v g="${IDC_UNIT_FILES:-16}" -v ucases="${IDC_CASE_UNITS:-6}" '
        function emit(line) { print line > (dir "/" cur) }
        function begin_unit(name) {
            cur = name; print "#include \"idc.h\"" > (dir "/" cur); print cur > (dir "/list") }
        function declname(d,   n) {
            n = d; sub(/[ \t]*;[ \t]*$/, "", n); sub(/[ \t]*\[.*$/, "", n); match(n, /[A-Za-z_][A-Za-z0-9_]*$/)
            return substr(n, RSTART, RLENGTH) }
        function extern_of(line,   d) {
            d = line; sub(/[ \t]*\/\*.*\*\/[ \t]*$/, "", d); sub(/;[ \t]*$/, "", d); sub(/ = .*$/, "", d)
            sub(/^static /, "", d); return "extern " d ";" }
        function phash(s,   i, h) {
            h = 0; for (i = 1; i <= length(s); i++) h = (h * 31 + ord[substr(s, i, 1)]) % 1000003
            return h }
        BEGIN {
            for (i = 0; i < 256; i++) ord[sprintf("%c", i)] = i
            h = dir "/idc.h"; st = "pre"; nu = 0; skipping = 0; indef = 0
            begin_unit("u0.c") }
        /^\/\/ idtc key / { next }
        st == "pre" && $0 == "/* forward declarations */" { st = "fwd"; print > h; next }
        st == "pre" {
            if ($0 ~ /^#[ \t]*(if|ifdef|ifndef|else|elif|endif)/) { print > h; print > (dir "/u0.c"); next }
            if ($0 ~ /^static / && $0 !~ /\(/ && $0 ~ /;[ \t]*(\/\*.*\*\/)?[ \t]*$/) {
                print extern_of($0) > h; d = $0; sub(/^static /, "", d); print d > (dir "/u0.c")
                print declname(substr(extern_of($0), 8)) > (dir "/syms"); next }
            if ($0 ~ /^ID_CLO [A-Za-z_][^;=]*\) *\{/) { sub(/^ID_CLO /, "ID_CLO inline "); print > h; next }
            if ($0 ~ /^[A-Za-z_].*\) *\{/ && $0 !~ /^(static|typedef)/) { print "__attribute__((weak)) " $0 > h; next }
            if ($0 ~ /^static [A-Za-z_][^;=]*\) *\{/) { if ($0 !~ /^static inline /) sub(/^static /, "static inline "); print > h; next }
            print > h; next }
        st == "fwd" && $0 == "/* exported variables */" { st = "exp"; print > h; next }
        st == "exp" && $0 == "" { st = "defs"; next }
        st == "exp" { print extern_of($0) > h; print > (dir "/u0.c"); next }
        st == "fwd" && $0 !~ /^\/\* idc unit: / && $0 !~ /^[A-Za-z_].*\) *\{$/ { print > h; next }
        st == "fwd" { st = "defs" }
        st == "defs" && /^static void idfr_[A-Za-z0-9_]+\(IdList\* p\) \{ id_free_walk\(p, .*\); \}$/ {
            d = $0; sub(/^static /, "static inline ", d); print d > h; next }
        st == "defs" && indef == 0 && /^static [A-Za-z_].*\) *\{$/ {
            d = $0; sub(/^static /, "", d); proto = d; sub(/ *\{$/, ";", proto); print proto > h
            print declname(substr(proto, 1, index(proto, "(") - 1)) > (dir "/syms")
            print d > (dir "/u0.c"); inzero = 1; next }
        inzero { print > (dir "/u0.c"); if ($0 == "}") inzero = 0; next }
        st == "defs" && /^\/\* idc unit: .* \*\/$/ {
            p = $0; sub(/^\/\* idc unit: /, "", p); sub(/ \*\/$/, "", p)
            if (nu == 0 || phash(p) % g == 0) { nu++; begin_unit("u" nu ".c") }
            next }
        st == "defs" && ($0 ~ /^#define IDTC_N / || $0 ~ /^int main\(/) { st = "tail"; begin_unit("ut.c") }
        st == "defs" {
            if (nu == 0) { nu = 1; begin_unit("u1.c") }
            emit($0); next }
        st == "tail" && skipping { if ($0 == "}") skipping = 0; next }
        st == "tail" && incase { print > (dir "/" cfile); if ($0 == "}") incase = 0; next }
        st == "tail" && /^#define IDTC_N [0-9]+$/ {
            shared = shared $0 "\n"; csz = int(($3 + ucases - 1) / ucases); if (csz < 1) csz = 1 }
        st == "tail" && /^static .*\[IDTC_N\];$/ {
            shared = shared extern_of($0) "\n"; sub(/^static /, ""); emit($0); next }
        st == "tail" && /^static (int|void) idtc_(eq|show)[A-Za-z0-9_]*\(IdList\* a(, IdList\* b)?\)(;| \{)$/ {
            sub(/^static /, "")
            if ($0 ~ /;$/) shared = shared $0 "\n"
            emit($0); next }
        st == "tail" && match($0, /^static int idtc_case_[0-9]+\(int idtc_fd\) \{$/) {
            k = $0; sub(/^static int idtc_case_/, "", k); sub(/\(.*$/, "", k)
            if (substr(mask, k + 1, 1) == "1") { skipping = 1; next }
            if (ucases > 1 && csz > 0) {
                ci = int(k / csz) + 1; cfile = "ut" ci ".c"
                if (!(ci in made)) {
                    made[ci] = 1; print "#include \"idc.h\"" > (dir "/" cfile); print cfile > (dir "/list")
                    printf "%s", shared > (dir "/" cfile) }
                sub(/^static /, ""); print > (dir "/" cfile)
                $0 = $0; sub(/ \{$/, ";"); emit($0); incase = 1; next } }
        st == "tail" && $0 == "static void idtc_setup(void) {" { insetup = 1 }
        st == "tail" && insetup && $0 == "}" { insetup = 0 }
        st == "tail" && insetup && /^    idtc_where\[[0-9]+\] = .* idtc_case\[[0-9]+\] = idtc_case_[0-9]+;$/ {
            k = $0; sub(/^    idtc_where\[/, "", k); sub(/\].*$/, "", k)
            if (substr(mask, k + 1, 1) == "1") sub(/idtc_case_[0-9]+;$/, "idtc_case_std_skip;")
            emit($0); next }
        st == "tail" { emit($0); next }
        END { if (st != "defs" && st != "tail") exit 1 }' "$1"
}

# unit_build C_FILE KIND OUT -- C_FILE through unit_split, each unit compiled
# at KIND's flags (harness: -O0; program: the -O level's, with -flto where the
# level has it and the program has a main -- the units are then linked by gcc's
# whole-program step, which is where small functions are inlined across units,
# at the price of one whole-program compile per relink; IDC_TIMES=1 prints what
# the units and the link cost) into $CACHE_DIR/units, keyed by
# the unit's own text, idc.h's, cc's identity and the flags, and linked into
# OUT: an executable (harness, or a program with a main) or a relocatable
# object. Up to IDC_UNIT_JOBS (default 4) units compile at once, the last
# listed first: that is the case table or the main wrapper, the one unit that
# can be as large as all the others together. False on any
# failure at all, having printed nothing: the caller then compiles C_FILE
# whole, the way every build did before units, so what a failing build says
# is exactly what it always said.
UNIT_CACHE_DIR="$CACHE_DIR/units"
UNIT_HITS=0
UNIT_BUILT=0
unit_build() {
    local src="$1" kind="$2" out="$3" udir="$WORK/units.$2" mask="" xcf=() xlf=() t0="${EPOCHREALTIME:-0}" t1=0
    local opt=("${CC_OFLAGS[@]}" ${CC_INLINE[@]+"${CC_INLINE[@]}"})
    [ "$kind" = harness ] && { opt=(-O0 -fwrapv); mask="$CASE_MASK"; }
    if [ "$kind" = program ] && [ "$have_main" -eq 1 ] && [ "$CC_LTO" -eq 1 ] && cc_lto_setup; then
        xcf=("${CC_LTO_COMPILE[@]}"); xlf=("${CC_LTO_LINK[@]}")
    fi
    mkdir -p "$udir" "$UNIT_CACHE_DIR" || return 1
    : > "$udir/syms"
    unit_split "$src" "$udir" "$mask" || return 1
    grep -qx '' "$udir/syms" && return 1
    local ctx cc_path
    cc_path="$(command -v "$CC" 2>/dev/null)"
    ctx=$({ sha256sum < "$udir/idc.h"; printf '%s\0' "$CC" -std=c11 "${opt[@]}" "$kind" ${xcf[@]+"${xcf[@]}"}
            [ -n "$cc_path" ] && sha256sum < "$cc_path"; } | sha256sum | cut -c1-32)
    local objs=() todo=() u key
    while read -r key u; do
        u="${u##*/}"
        objs+=("$UNIT_CACHE_DIR/$key-$ctx.o")
        if [ -f "$UNIT_CACHE_DIR/$key-$ctx.o" ]; then
            touch "$UNIT_CACHE_DIR/$key-$ctx.o"; UNIT_HITS=$((UNIT_HITS + 1))
        else
            todo+=("$u $key")
        fi
    done < <(cd "$udir" && sha256sum $(cat list))
    local jobs="${IDC_UNIT_JOBS:-4}" running=0 i="${#todo[@]}" t
    while [ "$i" -gt 0 ]; do
        i=$((i - 1))
        read -r u key <<< "${todo[$i]}"
        ( capped "$CC" -std=c11 "${opt[@]}" ${xcf[@]+"${xcf[@]}"} -c "$udir/$u" -o "$udir/$u.o" 2>"$udir/$u.err" \
            && mv -f "$udir/$u.o" "$UNIT_CACHE_DIR/$key-$ctx.o" ) &
        running=$((running + 1))
        if [ "$running" -ge "$jobs" ]; then wait -n; running=$((running - 1)); fi
    done
    wait
    for t in ${todo[@]+"${todo[@]}"}; do
        read -r u key <<< "$t"
        [ -f "$UNIT_CACHE_DIR/$key-$ctx.o" ] || return 1
        UNIT_BUILT=$((UNIT_BUILT + 1))
    done
    t1=${EPOCHREALTIME:-0}
    cache_prune "$UNIT_CACHE_DIR" "${IDC_UNIT_ENTRIES:-4000}"
    # The link is cached too, by the objects' names -- which are their
    # content -- so a harness whose units and case table are all unchanged
    # (a build that reruns only its always-run cases) is not relinked.
    local lkey
    printf '%s\n' "${objs[@]##*/}" > "$udir/objlist"
    lkey=$(obj_cache_key "link:$kind:${have_main:--}:${xlf[*]:-}:${opt[*]}" "$udir/objlist")
    obj_cache_get "$lkey" "$out" && return 0
    if [ "$kind" = harness ]; then
        capped "$CC" -std=c11 -O0 "${objs[@]}" ${LINK_OBJS[@]+"${LINK_OBJS[@]}"} -o "$out" -lm ${LINK_FLAGS[@]+"${LINK_FLAGS[@]}"} 2>"$udir/link.err" || return 1
    elif [ "$have_main" -eq 1 ]; then
        capped "$CC" -std=c11 "${opt[@]}" ${xcf[@]+"${xcf[@]}"} ${xlf[@]+"${xlf[@]}"} "${objs[@]}" ${LINK_OBJS[@]+"${LINK_OBJS[@]}"} -o "$out" ${LINK_FLAGS[@]+"${LINK_FLAGS[@]}"} 2>"$udir/link.err" || return 1
    else
        command -v objcopy >/dev/null 2>&1 || return 1
        capped "$CC" -r -nostdlib "${objs[@]}" -o "$udir/out.o" 2>"$udir/link.err" \
            && objcopy $(sed 's/^/--localize-symbol=/' "$udir/syms") "$udir/out.o" "$out" 2>>"$udir/link.err" || return 1
    fi
    [ -z "${IDC_TIMES:-}" ] || awk -v a="$t0" -v b="$t1" -v c="${EPOCHREALTIME:-0}" -v k="$kind" 'BEGIN { printf "idc: times: %s: %.2fs compiling units, %.2fs linking\n", k, b - a, c - b }' >&2
    obj_cache_put "$lkey" "$out"
}

# shard_cases DIR -- run the harness as several processes at once, each given
# its own $IDTC_SKIP, when the cache is on (CASE_MASK says which cases are
# left): the cases keyed `-` (the ones that reach volatile natives, which are never
# cached and so run on every build) and those keyed `KEY f` (which are slow for
# the same reason, loading a font or a corpus) are dealt round-robin over up to 8 shards,
# a scaling claim's cases all to one shard because the claim compares their
# counts against each other, and the cases that do have a key to one more.
# Returns 0 only when every shard passed, leaving every pass in $WORK/passed;
# otherwise (cache off, one core, fewer than two shards, or any failure)
# returns 1 and the caller runs the whole harness once, as it always has, so a
# failure is reported in exactly the order and wording it had before.
shard_cases() {
    local dir="$1" n s m live p ok=0
    local -a pids=() shards=()
    [ -n "$CASE_MASK" ] || return 1
    n=$(nproc 2>/dev/null || echo 1)
    [ "$n" -gt 8 ] && n=8
    [ "$n" -gt 1 ] || return 1
    live=$(awk -v n="$n" -v mask="$CASE_MASK" -v dir="$WORK" '
        function find(x) { while (par[x] != x) x = par[x]; return x }
        /^\/\/ idtc key / && ($5 == "-" || $6 == "f") { alw[$4] = 1 }
        /idtc_claim\(\(int\[\]\)\{/ {
            t = $0; sub(/^[^{]*\{/, "", t); sub(/\}.*$/, "", t)
            c = split(t, a, ", ")
            for (i = 1; i <= c; i++) { if (!(a[i] in par)) par[a[i]] = a[i] }
            for (i = 2; i <= c; i++) par[find(a[i])] = find(a[1])
        }
        END {
            for (k = 0; k < length(mask); k++) {
                sh = -1
                if (substr(mask, k + 1, 1) == "0") {
                    if (!(k in alw) && !(k in par)) sh = 0
                    else if (k in par) {
                        r = find(k)
                        if (!(r in gs)) gs[r] = (rr++ % n) + 1
                        sh = gs[r]
                    } else sh = (rr++ % n) + 1
                }
                for (s = 0; s <= n; s++) line[s] = line[s] ((sh == s) ? "0" : "1")
                if (sh >= 0) has[sh] = 1
            }
            for (s = 0; s <= n; s++) if (s in has) { print line[s] > (dir "/smask." s); close(dir "/smask." s); c2++ }
            print c2 + 0
        }' "$HARNESS_C")
    [ "${live:-0}" -ge 2 ] || return 1
    progress_start_ticker "$CASE_TODO" "$CASE_HITS" "$live"
    [ -z "$TICK_FD" ] || export IDTC_TICK="$TICK_FD"
    for s in $(seq 0 "$n"); do
        [ -s "$WORK/smask.$s" ] || continue
        m=$(cat "$WORK/smask.$s")
        (cd "$dir" && IDSTD_GFX=none IDTC_SKIP="$m" IDTC_PASSED="$WORK/passed.$s" "$WORK/harness" </dev/null >/dev/null 2>"$WORK/cases.err.$s") &
        pids+=($!)
    done
    for p in "${pids[@]}"; do
        wait "$p" || ok=1
    done
    [ "$ok" -eq 0 ] || { progress_stop_ticker; return 1; }
    cat "$WORK"/passed.* > "$WORK/passed"
}

# teardown_obj -- compile interop/idtc_teardown.c into the harness's link. The
# harness cleans up after each case (rmtree, pipe drain), and the libc headers
# that needs are kept out of its translation unit, which also holds the
# program's global variables under their own names (see that file).
teardown_obj() {
    local obj="$WORK/idtc_teardown.o"
    if ! capped "$CC" -std=c11 -O0 -c "$ROOT/interop/idtc_teardown.c" -o "$obj" 2>"$WORK/teardown.err"; then
        progress_clear
        sed 's/^/idc:   /' "$WORK/teardown.err" >&2
        echo "idc: the test harness's teardown object did not build ($ROOT/interop/idtc_teardown.c)" >&2
        exit 1
    fi
    LINK_OBJS+=("$obj")
}

# The harness runs every case in a process of its own, with its own time and
# memory limits, and prints each failure as FILE:LINE. It is built for and run
# on this machine. A --freestanding build's harness is the same source built
# for this machine, and its object is built only once every case has passed
# here; a function that cannot run here was already exempted, or its cases
# refused, by idparse (docs/TESTS.md). A hosted build for another triple is
# refused, naming why, rather than built without its cases.
#
# Every case runs with IDSTD_GFX=none, which makes gfx_open and glwin_open
# report "no display" without touching X11 or Wayland, so a build opens no
# window whatever session it runs in. A case that needs a window sets
# IDSTD_GFX itself with env_put (docs/TESTS.md).
run_cases() {
    [ -s "$HARNESS_C" ] || return 0
    local n host hrc
    n=$(grep -c '^static int idtc_case_[0-9]*(int idtc_fd) {$' "$HARNESS_C")
    host="$(host_triple)"
    if [ "$FREESTANDING" -eq 0 ] && [ "$TRIPLE" != "$host" ]; then
        progress_clear
        echo "idc: this build has $(plural "$n" "test case"), which run on this machine ('$host'), but it is for '$TRIPLE'; build for '$host' to run them" >&2
        exit 1
    fi
    case_plan
    [ -n "${IDC_CASE_STATS:-}" ] && [ -n "$CASE_FILE" ] && echo "idc: cases: $n total, $CASE_HITS already passed, $CASE_TODO to run" >&2
    PROG_RAN=$CASE_TODO PROG_CACHED=$CASE_HITS
    [ -n "$CASE_MASK" ] || PROG_RAN=$n
    if [ "$CASE_TODO" -eq 0 ]; then
        progress test "$(plural "$n" case), all $CASE_HITS already passed"
        PROG_NOTE="$PROG_RAN run, $PROG_CACHED cached"
        touch "$CASE_FILE" 2>/dev/null
        return 0
    fi
    backends_for harness
    teardown_obj
    progress harness "building the test runner"
    # The compile is cached by content (see obj_cache_key); running it is
    # not -- a hit only skips cc, and the cases below always run for real, so
    # a build whose cases fail can never come back green because it was
    # cached.
    local hkey=""
    [ "$CACHE_ON" -eq 1 ] && [ "$UNITS_ON" -eq 0 ] && hkey=$(obj_cache_key harness "$HARNESS_C")
    if [ "$UNITS_ON" -eq 1 ] && unit_build "$HARNESS_C" harness "$WORK/harness"; then
        :
    elif [ -z "$hkey" ] || ! obj_cache_get "$hkey" "$WORK/harness"; then
        local hcmd=("$CC" -std=c11 -O0 -fwrapv "$HARNESS_C" ${LINK_OBJS[@]+"${LINK_OBJS[@]}"} -o "$WORK/harness" -lm ${LINK_FLAGS[@]+"${LINK_FLAGS[@]}"})
        capped "${hcmd[@]}" 2>"$WORK/harness.err"; hbuild_rc=$?
        if [ "$hbuild_rc" -ne 0 ]; then
            progress_clear
            if mem_ceiling_hit "$hbuild_rc" "$WORK/harness.err"; then
                mem_ceiling_error "cc (test harness)"
            else
                sed 's/^/idc:   /' "$WORK/harness.err" >&2
                echo "idc: the test harness did not build (command: ${hcmd[*]})" >&2
            fi
            exit 1
        fi
        [ -n "$hkey" ] && obj_cache_put "$hkey" "$WORK/harness"
    fi
    # Each case enters the root of the tree that owns its function (the
    # --unit-roots table, emitted into the harness as idtc_dir) before it
    # runs, so a library's cases read their files from the library however it
    # is imported. The harness itself starts in the project root, which is
    # where a case with no entry in that table -- none, in a build whose
    # idparse writes it -- stays.
    local case_dir="$PATH_ARG"
    [ -d "$case_dir" ] || case_dir=$(dirname "$case_dir")
    : > "$WORK/passed"
    progress test "$(plural "$n" case) ($CASE_HITS already passed)"
    unset IDTC_TICK IDTC_READS
    if [ "$CASE_TRACK" -eq 1 ] && mkdir -p "$WORK/reads"; then
        export IDTC_READS="$WORK/reads"
    fi
    if shard_cases "$case_dir"; then
        hrc=0
    else
        : > "$WORK/passed"
        rm -f "$WORK"/reads/*
        unset IDTC_TICK
        progress_start_ticker "$PROG_RAN" "$CASE_HITS" 1
        [ -z "$TICK_FD" ] || export IDTC_TICK="$TICK_FD"
        (cd "$case_dir" && IDSTD_GFX=none IDTC_SKIP="$CASE_MASK" IDTC_PASSED="$WORK/passed" "$WORK/harness" </dev/null >/dev/null 2>"$WORK/cases.err")
        hrc=$?
    fi
    progress_stop_ticker
    unset IDTC_TICK IDTC_READS
    PROG_NOTE="$PROG_RAN run, $PROG_CACHED cached"
    CASE_RC=$hrc
    case_record
    [ "$hrc" -eq 0 ] && return 0
    progress_clear
    cat "$WORK/cases.err" >&2
    [ -s "$WORK/cases.err" ] || echo "idc: the test harness stopped (status $hrc) without saying why" >&2
    exit 1
}

split_harness
if [ -s "$NOTES" ]; then
    progress_clear
    cat "$NOTES" >&2
fi
# A reached native the build's platform cannot link is the most specific thing
# wrong with a build for another platform, and the one a port has to fix. The
# refusal to run that build's cases here (run_cases) would otherwise hide it,
# and the standard library always has cases. So the program's natives are
# checked first -- backend.id files read, nothing compiled, so what is built
# and in what order does not change. --emit-c writes C and links nothing, so
# it does not ask; the LLVM target asks the same question its own way, in its
# own branch below (backends_for_program), once it knows have_main.
if [ "$TARGET" = c ] && [ -z "$EMIT_C" ] && grep -q '^int main(' "$C_OUT"; then
    backends_for program check
fi
await_prechecks
phase prechecks
if [ "$LIB" -eq 1 ] && [ "$TARGET" = c ] && ! grep -q '^int main(' "$C_OUT"; then
    resolve_export_list "--lib"
elif [ "$TARGET" = wasm ]; then
    resolve_export_list "a wasm build of a project with no main"
fi
run_cases
phase cases

# The output path, chosen the same way whichever target produced the code:
# the project directory's name or the file's stem, an executable when the
# program has a main and a .o when it does not. Reads have_main and OUTPUT.
choose_output() {
    # default output name: the project directory's name, or the file's stem
    # (idc.py: os.path.basename(first if isdir else splitext(first)[0]))
    if [ -n "$OUTPUT" ]; then
        OUT="$OUTPUT"
    else
        first="${PATH_ARG%/}"
        if [ -d "$first" ]; then
            base="$(basename "$first")"
        else
            base="$(basename "$first")"
            base="${base%.*}"
        fi
        if [ "$have_main" -eq 1 ]; then OUT="$BUILD_DIR/$base"; else OUT="$BUILD_DIR/$base.o"; fi
        mkdir -p "$BUILD_DIR" || exit 1
    fi

    # An explicit -o can still land on a directory, and cc then fails with "cannot
    # open output file: Is a directory", which this driver used to report as "a bug
    # in the self-hosted compiler". A name this driver chose, it re-chooses; a name
    # the user chose with -o, it reports. Mirrors idc.py's choose_output_path.
    if [ -d "$OUT" ]; then
        if [ -n "$OUTPUT" ]; then
            echo "idc: -o '$OUT' is a directory; choose a different output path" >&2
            exit 1
        fi
        if [ -d "$OUT.out" ]; then
            echo "idc: '$OUT' and '$OUT.out' are both directories; pass -o NAME to name the executable" >&2
            exit 1
        fi
        echo "idc: '$OUT' is the project directory, so the executable cannot take its name;" >&2
        echo "idc: writing it to '$OUT.out' instead (pass -o NAME to choose)" >&2
        OUT="$OUT.out"
    fi
}

# stamp_build_info OUT SOURCE -- make an ELF executable say which source built
# it: `idc-build-info<TAB>SOURCE<NUL>` is appended after the last section, where
# the loader never looks and `grep -a idc-build-info` finds it, so the launcher
# can list a binary built before the record existed together with its source.
# Appended after the link and after obj_cache_put, never into the object cache:
# a cached program reused for another source path therefore cannot carry the
# wrong path. Best-effort; non-ELF outputs are left alone.
stamp_build_info() {
    [ "$(head -c 4 -- "$1" 2>/dev/null | od -An -c | tr -d ' ')" = '177ELF' ] || return 0
    printf 'idc-build-info\t%s\0' "$2" >> "$1" 2>/dev/null
    return 0
}

# Every executable built for the user is one line of the build record the
# launcher lists: absolute output, absolute source, target, build time in
# milliseconds. The compiler's own tools (under CACHE_DIR) and IDC_RECORD=0
# runs (the test suites), programs whose sources sit under /tmp and outputs in
# /tmp or /run/user (throwaway
# workspaces) are left out; a record that cannot be written never
# fails the build. Every such executable, recorded or not, is also stamped
# with its source (stamp_build_info).
record_built() {
    [ "$have_main" -eq 1 ] || return 0
    local out_abs src_abs record_dir
    out_abs=$(realpath -- "$OUT" 2>/dev/null) || return 0
    case "$out_abs" in "$(realpath -- "$CACHE_DIR" 2>/dev/null)"/*) return 0 ;; esac
    src_abs=$(realpath -- "$PATH_ARG" 2>/dev/null) || return 0
    stamp_build_info "$out_abs" "$src_abs"
    [ "${IDC_RECORD:-1}" != 0 ] || return 0
    case "$src_abs" in /tmp/*) return 0 ;; esac
    case "$out_abs" in /tmp/*|/run/user/*) return 0 ;; esac
    record_dir="${XDG_STATE_HOME:-$HOME/.local/state}/id"
    mkdir -p "$record_dir" 2>/dev/null || return 0
    printf '%s\t%s\t%s\t%s\n' "$out_abs" "$src_abs" "$1" "$(date +%s%3N)" >> "$record_dir/built.tsv" 2>/dev/null
    return 0
}

# ---------------------------------------------------------------------------
# --target llvm: the emitted text is LLVM IR, not C, so everything below --
# the C syntax gate, the cc link, --emit-c -- is the wrong tool. The IR is
# checked with llvm-as (the assembler is the only authority on whether a
# module parses), the runtime is asked of the compiler itself (`--target crt`
# prints the same prelude with external linkage), and clang links the two.
#
# This is the one place the LLVM target still touches C. The runtime written
# in `id` replaces it -- see docs/LLVM.md.
if [ "$TARGET" = llvm ]; then
    LL_OUT="$WORK/out.ll"
    mv "$C_OUT" "$LL_OUT"

    if command -v llvm-as >/dev/null 2>&1; then
        progress verify "checking the emitted LLVM IR"
        if ! llvm-as "$LL_OUT" -o /dev/null 2>"$WORK/llas.err"; then
            progress_clear
            sed 's/^/idc:   /' "$WORK/llas.err" >&2
            C_OUT="$LL_OUT"
            compiler_bug "the self-hosted compiler emitted LLVM IR that does not assemble"
        fi
    fi

    if [ -n "$EMIT_LLVM" ]; then
        progress_done "wrote $EMIT_LLVM ($(plural "${#SRC_FILES[@]}" "source file"))"
        cp "$LL_OUT" "$EMIT_LLVM" || exit 1
        echo "wrote $EMIT_LLVM"
        exit_ok
    fi

    # Freestanding: there is no host to link against and no C runtime to
    # compile beside the module, so the result is always an object file. What
    # links it is a linker script and a boot stub -- see docs/KERNEL.md.
    if [ "$FREESTANDING" -eq 1 ]; then
        have_main=0
        choose_output
        LLVM_CC=clang
        command -v clang >/dev/null 2>&1 || LLVM_CC="$CC"
        cmd=("$LLVM_CC" -c "-O$CLEVEL" -Wno-override-module -ffreestanding -fno-builtin
             -mno-red-zone -fno-stack-protector -fno-asynchronous-unwind-tables -Wno-unused-command-line-argument
             -target "$TRIPLE" "$LL_OUT" -o "$OUT")
        progress link "clang -> $(basename "$OUT")"
        capped "${cmd[@]}" 2>"$WORK/clang.err"; cmd_rc=$?
        if [ "$cmd_rc" -ne 0 ]; then
            progress_clear
            if mem_ceiling_hit "$cmd_rc"; then
                mem_ceiling_error "$LLVM_CC"
            else
                [ -s "$WORK/clang.err" ] && sed 's/^/idc:   /' "$WORK/clang.err" >&2
                echo "idc: freestanding compilation failed (command: ${cmd[*]})" >&2
            fi
            exit 1
        fi
        progress_done "built $OUT ($(wc -c < "$OUT" | tr -d " ") bytes, $(plural "${#SRC_FILES[@]}" "source file"))"
        exit_ok
    fi

    have_main=0
    grep -q '^define i32 @main(' "$LL_OUT" && have_main=1
    choose_output
    # The backends the program's reached natives need, same as the C target
    # (backends_for_program, above): built now, from this same $TRIPLE and
    # $PLATKEY_BUILD, and linked into the same clang invocation below.
    backends_for_program
    RT_C="$WORK/runtime.c"
    RT_LEX_OUT="$WORK/runtime_lex.out"
    capped "$IDLEX" < /dev/null > "$RT_LEX_OUT" \
        && capped_from "$RT_LEX_OUT" "$IDPARSE" --target crt > "$RT_C" || {
        progress_clear; echo "idc: could not obtain the C runtime from idparse" >&2; exit 1; }

    LLVM_CC=clang
    command -v clang >/dev/null 2>&1 || LLVM_CC="$CC"
    # The module and the C runtime are two inputs of one clang run, which
    # compiles them separately, so no id function can inline the runtime's
    # accessors (id_list_get, id_concat, ...): they stay calls. -flto lets clang
    # see both. If the toolchain cannot link that way, the build is retried
    # without it rather than failed.
    lto_flag=()
    [ "$have_main" -eq 1 ] && [ "$CC_LTO" -eq 1 ] && lto_flag=(-flto -Wl,-plugin-opt=-inline-threshold=400)
    cmd=("$LLVM_CC" "-O$CLEVEL" ${lto_flag[@]+"${lto_flag[@]}"} -Wno-override-module)
    [ "$have_main" -eq 0 ] && cmd+=(-c "$LL_OUT") || cmd+=("$RT_C" "$LL_OUT")
    cmd+=(${LINK_OBJS[@]+"${LINK_OBJS[@]}"} -o "$OUT" ${LINK_FLAGS[@]+"${LINK_FLAGS[@]}"})

    progress link "clang -> $(basename "$OUT")"
    capped "${cmd[@]}" 2>"$WORK/clang.err"; cmd_rc=$?
    if [ "$cmd_rc" -ne 0 ] && [ "${#lto_flag[@]}" -gt 0 ]; then
        nolto=()
        for a in "${cmd[@]}"; do case "$a" in -flto|-Wl,-plugin-opt=*) ;; *) nolto+=("$a") ;; esac; done
        cmd=("${nolto[@]}")
        capped "${cmd[@]}" 2>"$WORK/clang.err"; cmd_rc=$?
    fi
    if [ "$cmd_rc" -ne 0 ]; then
        progress_clear
        if mem_ceiling_hit "$cmd_rc"; then
            mem_ceiling_error "$LLVM_CC"
        else
            [ -s "$WORK/clang.err" ] && sed 's/^/idc:   /' "$WORK/clang.err" >&2
            echo "idc: LLVM compilation failed (command: ${cmd[*]})" >&2
        fi
        exit 1
    fi
    record_built llvm
    progress_done "built $OUT ($(wc -c < "$OUT" | tr -d " ") bytes, $(plural "${#SRC_FILES[@]}" "source file"))"
    exit_ok
fi

# idlex/idparse can exit 0 while having silently mis-lexed something (e.g. a
# float literal) into C that doesn't even parse. Since --emit-c has no cc
# link step to catch that, and a build's later cc invocation would produce a
# confusing error attributed to "C compilation failed" instead of the real
# cause, gate on a real C compiler's syntax check now -- cheap (no linking)
# and it's the one authoritative way to know the self-hosted output is sound.
progress verify "checking the emitted C"
capped "$CC" -std=c11 -fsyntax-only "$C_OUT" 2>"$WORK/syntax.err"; syntax_rc=$?
if [ "$syntax_rc" -ne 0 ]; then
    progress_clear
    if mem_ceiling_hit "$syntax_rc" "$WORK/syntax.err"; then
        mem_ceiling_error "cc -fsyntax-only"
        exit 1
    fi
    # Show what the C compiler actually said. Without this the message is
    # just "emitted C that does not compile", which is true and unusable --
    # the real diagnostic (a name colliding with a libc symbol, say) is
    # sitting right here.
    sed 's/^/idc:   /' "$WORK/syntax.err" >&2
    compiler_bug "the self-hosted compiler emitted C that does not compile"
fi

# ---------------------------------------------------------------------------
# --emit-c: write the generated C and stop (matches idc.py --emit-c). The unit
# markers are the driver's business, not the program's: without them the file
# is byte for byte what a build without --units writes. It is also the compiler's
# raw output, which tools/regen_bootstrap.sh --check compares with the bootstrap,
# so the rewrite below does not apply to it.
if [ -n "$EMIT_C" ]; then
    progress_done "wrote $EMIT_C ($(plural "${#SRC_FILES[@]}" "source file"))"
    sed '/^\/\* idc unit: .* \*\/$/d' "$C_OUT" > "$EMIT_C" || exit 1
    echo "wrote $EMIT_C"
    exit_ok
fi

# The runtime's accessors (id_list_get and the rest of the prelude's `static`
# functions) are small, and gcc inlines a `static` function only when it
# chooses to; `static inline` makes it try. The unit path used to rewrite them
# (unit_split) while every other path that compiles -- the whole-file fallback,
# --lib, --target wasm -- compiled them without the keyword and left them as
# calls, so the same program ran several times slower depending on how it was
# built. The rewrite is done once here, on the text every later path starts
# from (final.c, --keep-c's output, the library's unit, the wasm's C). Only the
# prelude is touched: it ends at the forward declarations. Writing the keyword
# in the prelude's own source (compiler/parse/back/tgt/c/runtime/) would make
# --emit-c say it too, at the price of regenerating the bootstrap.
awk '
    /^\/\* forward declarations \*\/$/ { pre = 0 }
    BEGIN { pre = 1 }
    pre && /^static [A-Za-z_][^;=]*\) *\{/ && !/^static inline / { sub(/^static /, "static inline ") }
    { print }' "$C_OUT" > "$C_OUT.inl" && mv -f "$C_OUT.inl" "$C_OUT" \
    || { echo "idc: could not mark the runtime's accessors inline" >&2; exit 1; }

# ---------------------------------------------------------------------------
# --target wasm: the same C the C target compiles, recompiled for
# wasm32-wasi and linked as a WASI reactor (no _start; JS calls _initialize
# once, then the program's own functions). No new AST walk -- this is the C
# target's own output, so it gets the C target's own test run above for free.
#
# The toolchain is read from env vars the umbrella flake's devshell sets
# (IDC_WASI_CLANG/IDC_WASI_SYSROOT_INCLUDE/IDC_WASI_LIBDIR/IDC_WASI_COMPILER_RT)
# rather than a hard-coded store path, so this only runs inside `nix develop`.
if [ "$TARGET" = wasm ]; then
    for v in IDC_WASI_CLANG IDC_WASI_SYSROOT_INCLUDE IDC_WASI_LIBDIR IDC_WASI_COMPILER_RT; do
        if [ -z "${!v:-}" ]; then
            echo "idc: --target wasm needs \$$v; run inside 'nix develop' (flake.nix sets it)" >&2
            exit 1
        fi
    done

    if [ -n "$OUTPUT" ]; then
        WOUT="$OUTPUT"
    else
        first="${PATH_ARG%/}"
        base="$(basename "$first")"
        [ -f "$first" ] && base="${base%.*}"
        WOUT="$BUILD_DIR/$base.wasm"
        mkdir -p "$BUILD_DIR" || exit 1
    fi

    # What the module exports is the list in conf.id (resolve_export_list,
    # above, ran before the cases): PROGRAM_FILES and ELIST. --exports all is
    # the old every-function behaviour, for debugging. A command (a program
    # with main) with no list exports nothing and is driven by run().
    WEXPORTS=(id_alloc id_str_of_cstr _initialize)
    WEXPORT_NAMES=()
    for name in ${ELIST[@]+"${ELIST[@]}"}; do
        WEXPORTS+=("id_$name")
        WEXPORT_NAMES+=("$name")
    done

    WEXPORT_FLAGS=()
    for name in "${WEXPORTS[@]}"; do WEXPORT_FLAGS+=(-Wl,--export="$name"); done

    c_path="$WORK/final.c"
    if [ "$KEEP_C" -eq 1 ]; then
        c_path="${WOUT%.*}.c"
    fi
    cp "$C_OUT" "$c_path" || exit 1
    cat "$ROOT/tools/jsbind/shim.c" >> "$c_path" || exit 1

    # The natives this program reaches (the same rows the C target links
    # backends from) and how the wasm target answers each one: a backend that
    # declares wasm_wasi_sources has them compiled for wasm32-wasi and linked
    # (libc over WASI: standard input and output), and one that declares
    # wasm_js has the rest left as imports, `env.id_NAME`, that its JS module
    # answers once jsgen bundles it into the module's .mjs. A backend that
    # declares neither contributes nothing, so a reached native of it is an
    # undefined symbol at the link, reported below at the call that reaches it.
    # Like the C target, a native is only linked when something reaches it:
    # wasm-ld's --gc-sections drops the code that would have imported it.
    WNAT_MAP="$WORK/wasm_natives"
    WALLOW="$WORK/wasm_allow"
    : > "$WNAT_MAP"
    : > "$WALLOW"
    WBE_OBJS=()
    declare -A WBE_OF=() WBE_NAME=() WBE_JS=() WBE_SRCS=() WBE_CF=() WBE_DONE=() WBE_SITE=() WBE_NATIVE_BE=()
    while IFS='|' read -r row_kind name site decl; do
        [ "$row_kind" = program ] || continue
        if [ -z "${WBE_OF[$decl]+x}" ]; then WBE_OF[$decl]=$(backend_of "$decl"); fi
        be="${WBE_OF[$decl]}"
        [ -n "$be" ] || continue
        if [ -z "${WBE_NAME[$be]+x}" ]; then
            backend_impl "$be"
            backend_decls "$BE_IMPL/backend.id"
            WBE_NAME[$be]="${BD[name]:-$(basename "$BE_IMPL")}"
            WBE_JS[$be]="${BD[wasm_js]:-}"
            WBE_SRCS[$be]="${BD[wasm_wasi_sources]:-}"
            WBE_CF[$be]="${BD[wasm_wasi_cflags]:-}"
            WBE_DONE[$be]="$BE_IMPL"
            if [ -n "${WBE_JS[$be]}" ] && [ ! -f "$BE_IMPL/${WBE_JS[$be]}" ]; then
                progress_clear
                echo "idc: $BE_IMPL/backend.id: wasm_js names '${WBE_JS[$be]}', which is not a file in $BE_IMPL; write it (an ES module whose default export is function(host) returning the natives) or remove the line" >&2
                exit 1
            fi
        fi
        WBE_SITE[$name]="$site"
        WBE_NATIVE_BE[$name]="${WBE_NAME[$be]}"
        [ -n "${WBE_JS[$be]}${WBE_SRCS[$be]}" ] || continue
        printf '%s\t%s\t%s\n' "$name" "${WBE_NAME[$be]}" "${WBE_JS[$be]:+${WBE_DONE[$be]}/${WBE_JS[$be]}}" >> "$WNAT_MAP"
        echo "id_$name" >> "$WALLOW"
        if [ -n "${WBE_SRCS[$be]}" ] && [ "${WBE_SRCS[$be]}" != compiled ]; then
            IFS=$'\x1f' read -ra wsrcs <<< "${WBE_SRCS[$be]}"
            IFS=$'\x1f' read -ra wcfl <<< "${WBE_CF[$be]}"
            progress compile "clang -> wasm32-wasi (backend ${WBE_NAME[$be]})"
            for wsrc in "${wsrcs[@]}"; do
                [ -n "$wsrc" ] || continue
                wobj="$WORK/wbe_${#WBE_OBJS[@]}.o"
                wbcmd=("$IDC_WASI_CLANG" --target=wasm32-wasi -isystem "$IDC_WASI_SYSROOT_INCLUDE"
                       "-O$CLEVEL" -ffunction-sections -fdata-sections -I"${WBE_DONE[$be]}" ${wcfl[@]+"${wcfl[@]}"}
                       -c "${WBE_DONE[$be]}/$wsrc" -o "$wobj")
                capped "${wbcmd[@]}" 2>"$WORK/wasibe.err"; wbe_rc=$?
                if [ "$wbe_rc" -ne 0 ]; then
                    progress_clear
                    sed 's/^/idc:   /' "$WORK/wasibe.err" >&2
                    echo "idc: wasm32-wasi compilation of backend source ${WBE_DONE[$be]}/$wsrc failed (command: ${wbcmd[*]})" >&2
                    exit 1
                fi
                WBE_OBJS+=("$wobj")
            done
            WBE_SRCS[$be]=compiled
        fi
    done < "$NATIVES"
    sort -u -o "$WALLOW" "$WALLOW"

    progress compile "clang -> wasm32-wasi"
    WLTO=(); WLTO_LINK=()
    if [ "$CC_LTO" -eq 1 ]; then
        wlto_level=2; [ "$CLEVEL" = 3 ] && wlto_level=3
        WLTO=(-flto); WLTO_LINK=(-flto "-Wl,--lto-O$wlto_level")
    fi
    ccmd=("$IDC_WASI_CLANG" --target=wasm32-wasi -isystem "$IDC_WASI_SYSROOT_INCLUDE"
          "-O$CLEVEL" -fwrapv ${WLTO[@]+"${WLTO[@]}"} -ffunction-sections -fdata-sections -c "$c_path" -o "$WORK/out.o")
    capped "${ccmd[@]}" 2>"$WORK/wasicc.err"; wcc_rc=$?
    if [ "$wcc_rc" -ne 0 ]; then
        progress_clear
        if mem_ceiling_hit "$wcc_rc" "$WORK/wasicc.err"; then
            mem_ceiling_error "$IDC_WASI_CLANG"
        else
            sed 's/^/idc:   /' "$WORK/wasicc.err" >&2
            echo "idc: wasm32-wasi compilation failed (command: ${ccmd[*]})" >&2
        fi
        exit 1
    fi

    # A program with a main is a WASI command -- _start runs it, as wasmtime
    # does -- and one without is a reactor whose functions a host calls, the
    # same split the C target makes between an executable and a .o.
    wcrt="$IDC_WASI_LIBDIR/crt1-reactor.o"
    wentry=(-Wl,--no-entry "${WEXPORT_FLAGS[@]}")
    if grep -q '^int main(' "$C_OUT"; then
        wcrt="$IDC_WASI_LIBDIR/crt1-command.o"
        wentry=()
    fi

    progress link "wasm-ld -> $(basename "$WOUT")"
    lcmd=("$IDC_WASI_CLANG" --target=wasm32-wasi -nostdlib "$WORK/out.o" ${WBE_OBJS[@]+"${WBE_OBJS[@]}"}
          "$wcrt" -L"$IDC_WASI_LIBDIR" -lc "$IDC_WASI_COMPILER_RT"
          -Wl,--allow-undefined-file="$WALLOW" ${WLTO_LINK[@]+"${WLTO_LINK[@]}"}
          -Wl,-z,stack-size=8388608 -Wl,--gc-sections ${wentry[@]+"${wentry[@]}"} -o "$WOUT")
    capped "${lcmd[@]}" 2>"$WORK/wasild.err"; wld_rc=$?
    [ "$KEEP_C" -eq 1 ] || rm -f "$c_path"
    if [ "$wld_rc" -ne 0 ]; then
        progress_clear
        if mem_ceiling_hit "$wld_rc" "$WORK/wasild.err"; then
            mem_ceiling_error "$IDC_WASI_CLANG (link)"
        else
            wundef=$(sed -n 's/.*undefined symbol: id_\([A-Za-z0-9_]*\).*/\1/p' "$WORK/wasild.err" | head -1)
            if [ -n "$wundef" ] && [ -n "${WBE_SITE[$wundef]:-}" ]; then
                echo "${WBE_SITE[$wundef]}: error: native '$wundef', reached from this program by this call, is declared by backend '${WBE_NATIVE_BE[$wundef]}', which has no implementation for the wasm target; add \`string wasm_js = \"FILE.mjs\";\` (a JS module) or \`string[] wasm_wasi_sources = [...];\` to its backend.id (docs/INTEROP.md, \"id and JavaScript\"), or stop calling it from code this module keeps" >&2
            else
                sed 's/^/idc:   /' "$WORK/wasild.err" >&2
            fi
            echo "idc: wasm32-wasi link failed (command: ${lcmd[*]})" >&2
        fi
        exit 1
    fi
    WBIND=""
    if [ "$NO_JS" -eq 0 ]; then
        ensure_jsgen
        wgen=(--wasm "$WOUT" --glue "$ROOT/tools/jsbind/glue.mjs" --natives "$WNAT_MAP")
        if [ "$WEXPORT_SCOPE" = list ]; then
            wgen+=(--strict 1)
            [ "${#WEXPORT_NAMES[@]}" -gt 0 ] && wgen+=(--names "$(IFS=,; echo "${WEXPORT_NAMES[*]}")")
        fi
        for f in "${PROGRAM_FILES[@]}"; do wgen+=(--src "$f"); done
        if ! "$JSGEN" "${wgen[@]}"; then
            progress_clear
            echo "idc: the JS bindings could not be written; the .wasm is built (--no-js stops idc writing them)" >&2
            exit 1
        fi
        keeps_bk=()
        for b in ${BACKENDS[@]+"${BACKENDS[@]}"}; do keeps_bk+=(--backend "$b"); done
        if "$SCRIPT_DIR/idc" "$PATH_ARG" --allow-untested ${keeps_bk[@]+"${keeps_bk[@]}"} --keeps >"$WORK/keeps.tsv" 2>/dev/null; then
            awk -F'\t' -v w="$(IFS=,; echo "${WEXPORT_NAMES[*]}")" 'BEGIN { printf "const IDW_KEEPS = {" } NF == 3 && (w == "" || index("," w ",", "," $1 ",")) { printf "%s\"%s\":[\"%s\",%s]", (n++ ? "," : ""), $1, $2, $3 } END { print "};" }' "$WORK/keeps.tsv" >> "${WOUT%.wasm}.mjs"
        fi
        WBIND=", bindings ${WOUT%.wasm}.mjs, .d.mts and .d.ts"
    fi
    progress_done "built $WOUT ($(wc -c < "$WOUT" | tr -d " ") bytes, $(plural "${#SRC_FILES[@]}" "source file"), $(plural "${#WEXPORTS[@]}" export)$WBIND)"
    exit_ok
fi

# ---------------------------------------------------------------------------
# --lib: a project with no `main` becomes a shared library, a static archive
# and a C header (docs/INTEROP.md, "id as a library").
#
# The cases have already run (run_cases, above), so a library whose cases fail
# does not build. What is exported is the functions named in conf.id's
# lib_exports (resolve_export_list, run before the cases), wherever in the
# tree they are defined; the wasm target reads the same list. Their signatures come from
# `idparse --fingerprints` over the whole program, and tools/libgen turns those into the
# header and one C wrapper per function. The wrappers, idc/interop/idl.c and
# the program's C are compiled as one translation unit, so the wrappers can
# reach the runtime's own statics; -fvisibility=hidden plus objcopy
# --localize-hidden leave the library's own entry points as its only symbols.
if [ "$LIB" -eq 1 ]; then
    if [ "$TARGET" != c ]; then
        echo "idc: --lib builds through the C target; drop --target $TARGET (the wasm target already exports a project's functions to JavaScript)" >&2
        exit 1
    fi
    if grep -q '^int main(' "$C_OUT"; then
        echo "idc: --lib needs a project with no main, and this one has one; move what main does into functions in the project's root directory, or build the executable without --lib" >&2
        exit 1
    fi
    if [ -n "$OUTPUT" ]; then
        LIBDIR="$(dirname "$OUTPUT")"
        LIBBASE="$(basename "$OUTPUT")"
    else
        first="${PATH_ARG%/}"
        LIBBASE="$(basename "$first")"
        [ -f "$first" ] && LIBBASE="${LIBBASE%.*}"
        LIBDIR="$BUILD_DIR"
    fi
    mkdir -p "$LIBDIR" || exit 1
    LIBNAME="$(printf '%s' "$LIBBASE" | tr -c 'A-Za-z0-9_' '_')"
    case "$LIBNAME" in
        [0-9]*|"")
            echo "idc: the library name '$LIBBASE' is not a C identifier; name it with -o, for example -o build/my_lib" >&2
            exit 1 ;;
    esac

    LIB_EXPORTS=("${ELIST[@]}")

    if [ "$LIB_STATE" -eq 0 ]; then
        for name in "${LIB_EXPORTS[@]}"; do
            if grep -qF "/* exported by $name() */" "$C_OUT"; then
                echo "idc: '$name' declares an exported variable, which later calls would read; a library frees what each call allocated, so that value would not survive the call. Build with --lib-state to keep memory until NAME_shutdown(), or pass the value in and out as arguments and results" >&2
                exit 1
            fi
        done
    fi

    ensure_libgen
    progress libgen "signatures of ${#LIB_EXPORTS[@]} functions"
    capped_from "$SOURCES_TMP" "$IDLEX" > "$WORK/lib_lex" 2>/dev/null \
        && capped_from "$WORK/lib_lex" "$IDPARSE" --host-triple "$(host_triple)" --fingerprints > "$WORK/lib_ast" 2>"$WORK/lib_ast.err" || {
        progress_clear; cat "$WORK/lib_ast.err" >&2; echo "idc: could not read the program's signatures (idparse --fingerprints failed)" >&2; exit 1; }
    "$LIBGEN" header "$LIBNAME" "${LIB_EXPORTS[@]}" < "$WORK/lib_ast" > "$LIBDIR/$LIBNAME.h" || { progress_clear; rm -f "$LIBDIR/$LIBNAME.h"; exit 1; }
    "$LIBGEN" wrap "$LIBNAME" "${LIB_EXPORTS[@]}" < "$WORK/lib_ast" > "$WORK/lib_wrappers.c" 2>/dev/null || exit 1

    LIB_DEFS=(-DIDL_LIB="$LIBNAME")
    grep -q 'idc_const_init' "$C_OUT" && LIB_DEFS+=(-DIDL_HAS_CONST_INIT)
    [ "$LIB_STATE" -eq 1 ] && LIB_DEFS+=(-DIDL_KEEP)
    { cat "$ROOT/interop/idl_pre.h" "$LIBDIR/$LIBNAME.h" "$C_OUT" "$ROOT/interop/idl.c" "$WORK/lib_wrappers.c"; } > "$WORK/lib_unit.c"

    backends_for program
    progress cc "$CC -> lib$LIBNAME"
    lcmd=("$CC" -std=c11 "${CC_OFLAGS[@]}" ${CC_INLINE[@]+"${CC_INLINE[@]}"} -fPIC -fvisibility=hidden -ffunction-sections -fdata-sections -pthread "${LIB_DEFS[@]}" -c "$WORK/lib_unit.c" -o "$WORK/lib_unit.o")
    capped "${lcmd[@]}" 2>"$WORK/lib_cc.err"; lib_rc=$?
    if [ "$lib_rc" -ne 0 ]; then
        progress_clear
        sed 's/^/idc:   /' "$WORK/lib_cc.err" >&2
        echo "idc: the library did not compile (command: ${lcmd[*]})" >&2
        exit 1
    fi
    printf '{\n  global: %s_*;\n  local: *;\n};\n' "$LIBNAME" > "$WORK/lib.map"
    LIB_KEEP=()
    for name in error free strs_free table_free shutdown "${LIB_EXPORTS[@]}"; do
        LIB_KEEP+=(-u "${LIBNAME}_${name#"${LIBNAME}"_}")
    done
    LIB_AR=("$WORK/lib_unit.o" ${LINK_OBJS[@]+"${LINK_OBJS[@]}"})
    if command -v objcopy >/dev/null 2>&1 && command -v ld >/dev/null 2>&1; then
        if ld -r --gc-sections "${LIB_KEEP[@]}" "${LIB_AR[@]}" -o "$WORK/lib_all.o" 2>/dev/null \
           && objcopy -w --keep-global-symbol="${LIBNAME}_*" -K "${LIBNAME}_*" --strip-unneeded "$WORK/lib_all.o" "$WORK/lib_local.o" 2>/dev/null; then
            LIB_AR=("$WORK/lib_local.o")
        fi
    fi
    rm -f "$LIBDIR/lib$LIBNAME.a" "$LIBDIR/lib$LIBNAME.so"
    ar rcs "$LIBDIR/lib$LIBNAME.a" "${LIB_AR[@]}" || { progress_clear; echo "idc: ar failed" >&2; exit 1; }
    scmd=("$CC" -shared -pthread -Wl,--gc-sections -Wl,--as-needed -Wl,--version-script="$WORK/lib.map" "${LIB_AR[@]}" -o "$LIBDIR/lib$LIBNAME.so" ${LINK_FLAGS[@]+"${LINK_FLAGS[@]}"})
    capped "${scmd[@]}" 2>"$WORK/lib_ld.err" || {
        progress_clear; sed 's/^/idc:   /' "$WORK/lib_ld.err" >&2
        echo "idc: linking the shared library failed (command: ${scmd[*]})" >&2; exit 1; }
    for o in ${BACKEND_OBJS[@]+"${BACKEND_OBJS[@]}"}; do rm -f "$o"; done
    progress_done "built $LIBDIR/lib$LIBNAME.so, lib$LIBNAME.a and $LIBNAME.h (${#LIB_EXPORTS[@]} functions; link the archive with -pthread)"
    exit_ok
fi

# does the program have a `main`? idc.py builds a real executable when it
# does, and a .o (for linking into something else, e.g. demos/engine) when
# it doesn't. The emitted C mirrors idc.py's byte-for-byte, so grepping for
# the C main() wrapper it prints is an exact proxy for "have_main".
have_main=0
grep -q '^int main(' "$C_OUT" && have_main=1

choose_output

# ---------------------------------------------------------------------------
# The backends the program's reached natives need (backends_for_program,
# above), built if the test harness has not already built them. A .o is not
# the whole program: what its natives need is linked into whatever links it,
# so it is named only when some function the object keeps calls one.
backends_for_program

# ---------------------------------------------------------------------------
# hand the emitted C to cc (mirrors idc.py's build_c)
c_path="$WORK/final.c"
if [ "$KEEP_C" -eq 1 ]; then
    c_path="${OUT%.*}.c"
fi
cp "$C_OUT" "$c_path" || exit 1

# The triple chose the sources; it cannot choose the code generator. `cc` here
# is the host's, so building a darwin triple on Linux would compile the darwin
# sources -- Objective-C, Cocoa -- with a Linux compiler and, where that
# happened to succeed, produce a host binary wearing another platform's name.
# Refusing is the honest answer, and --cc is the way to mean it: point it at a
# cross compiler and the build is yours. (--target llvm hands the triple to
# clang with -target, so it is genuinely cross-capable and does not come here.)
HOSTPLAT="$(triple_platform "$(host_triple)")"
if [ "$CC_EXPLICIT" -eq 0 ] && [ "$PLATKEY_BUILD" != "$HOSTPLAT" ]; then
    progress_clear
    echo "idc: cannot build for '$TRIPLE' here: the C target compiles with the host's" \
         "cc, which targets '$HOSTPLAT', not '$PLATKEY_BUILD'." >&2
    echo "idc: pass --cc with a cross compiler for '$PLATKEY_BUILD', or use --target llvm," \
         "which hands the triple to clang." >&2
    exit 1
fi

# Cached the same way the test harness is (see obj_cache_key/run_cases): the
# key folds in whether this is a -c compile (the tag names have_main), so it
# cannot be reused across a change in that shape even from identical C.
PROG_KEY=""
[ "$CACHE_ON" -eq 1 ] && PROG_KEY=$(obj_cache_key "program:$have_main:${CC_OFLAGS[*]}:${CC_INLINE[*]:-}:$CC_LTO" "$c_path")
if [ -n "$PROG_KEY" ] && obj_cache_get "$PROG_KEY" "$OUT"; then
    cc_rc=0
else
    cmd=("$CC")
    [ "$have_main" -eq 0 ] && cmd+=("-c")
    cmd+=("-std=c11" "${CC_OFLAGS[@]}" ${CC_INLINE[@]+"${CC_INLINE[@]}"} "$c_path" ${LINK_OBJS[@]+"${LINK_OBJS[@]}"} "-o" "$OUT" ${LINK_FLAGS[@]+"${LINK_FLAGS[@]}"})

    progress cc "$CC -> $(basename "$OUT")"
    if [ "$UNITS_ON" -eq 1 ] && unit_build "$c_path" program "$OUT"; then
        cc_rc=0
    else
        capped "${cmd[@]}" 2>"$WORK/cc.err"
        cc_rc=$?
    fi
    [ "$cc_rc" -eq 0 ] && [ -n "$PROG_KEY" ] && obj_cache_put "$PROG_KEY" "$OUT"
fi

[ "$KEEP_C" -eq 1 ] || rm -f "$c_path"
for o in "${BACKEND_OBJS[@]}"; do rm -f "$o"; done

# The generated C already passed -fsyntax-only above, so a failure here is a
# *link* or environment failure -- a missing backend object, a library that
# isn't installed, an unwritable output path -- and not evidence that the
# self-hosted compiler emitted bad code. It used to be reported as exactly
# that ("this is a bug in the self-hosted compiler; please report it"), with
# cc's own stderr captured and then thrown away, so the one line that said
# what actually went wrong was the one line the user never saw. Show it, and
# describe the failure as what it is.
if [ "$cc_rc" -ne 0 ]; then
    progress_clear
    if mem_ceiling_hit "$cc_rc" "$WORK/cc.err"; then
        mem_ceiling_error "cc (linking $OUT)"
        exit 1
    fi
    [ -s "$WORK/cc.err" ] && sed 's/^/idc:   /' "$WORK/cc.err" >&2
    echo "idc: C compilation failed (command: ${cmd[*]})" >&2
    echo "idc: the generated C passed a syntax check, so this is a link or environment" >&2
    echo "idc: failure rather than bad codegen -- unless the errors above name id_*" >&2
    echo "idc: symbols, which would be a bug in the self-hosted compiler worth reporting." >&2
    exit 1
fi
UNIT_NOTE=""
[ $((UNIT_BUILT + UNIT_HITS)) -gt 0 ] && UNIT_NOTE=", $UNIT_BUILT of $((UNIT_BUILT + UNIT_HITS)) units compiled"
phase linked
record_built c
progress_done "built $OUT ($(wc -c < "$OUT" | tr -d " ") bytes, $(plural "${#SRC_FILES[@]}" "source file")$UNIT_NOTE)"
exit_ok
