// The narrow half of `peek`.
//
// docs/SPEC.md 6 bounds-checks every store access against the high-water mark.
// A kernel has nowhere to report a failed check to and nothing to exit to, so
// these are the load instruction and nothing else; the address a kernel hands
// itself is the kernel's own business.

peek8(word a) {
  word ret_w = ld8(a);
} return word ret_w;
given store_setup(64) given poke64((import tsb), 578437695752307201) ((import tsb)):(1)
given store_setup(64) given poke64((import tsb), 511) ((import tsb)):(255)

peek16(word a) {
  word ret_w = ld16(a);
} return word ret_w;
given store_setup(64) given poke64((import tsb), 578437695752307201) ((import tsb)):(513)
given store_setup(64) given poke64((import tsb), 131071) ((import tsb)):(65535)
