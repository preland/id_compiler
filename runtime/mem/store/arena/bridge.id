given store_setup(64) given store_near given poke64((import tsb), 578437695752307201) ((import tsb), (import tsp), 3):(3) then cell_is((import tsp), 197121):(1)

str_of_mem(word a, word z) {
  word p = str_blk(z);
  word copy_bytes_v = copy_bytes(a, p + 8, z);
  string ret_s = str_of_mem_at(p, copy_bytes_v);
} return string ret_s;
