// Giving list blocks back: one free list per size class, heads kept in the
// arena after the bump pointer (../alloc.id), so a recycled block is found
// without an initialiser having run.
//
// Class 0 is the 24-byte list header. Class k >= 1 is a cell array of
// 4 * 2^(k-1) cells, which are the only capacities a list ever has because it
// starts at four and doubles. A freed block's first word links to the next
// block of its class. Classes 36 and up are string blocks (lang/str/free/give.id); the flat store never comes from these lists.

pool_head(word cls) {
  word a = heap_ptr();
  word top = arena_top(a);
  word ret_w = a + 8 + cls * 8;
} return word ret_w;
given store_setup(64) given store_heads (0):((import th0))
given store_setup(64) given store_heads (3):((import th3))

pool_take(word cls, word z) {
  word h = pool_head(cls);
  word b = ld64(h);
  word blk = pool_next(h, b, z);
} return word blk;
given store_setup(64) (3, 16):((import tnx)) then top_gap((import tnx)):(16)
given store_setup(64) given pool_give(3, (import tsb)) (3, 16):((import tsb)) then top_gap((import tnx)):(0)

pool_next(word h, word b, word z) {
  if(b == 0) {
    b = mem_alloc(z);
  } else {
    st64(h, ld64(b));
  }
} return word b;
