// The high-water mark, as an address rather than as a count of bytes used --
// the store here *is* the machine's memory, so the mark and the first address
// past the last allocation are the same number.
mem_size() {
  word heap_ptr_v = heap_ptr();
  word ret_w = arena_top(heap_ptr_v);
} return word ret_w;

// The free-list heads at the front of the arena, zeroed: 36 words from `a`.
pool_wipe(word a, int i) {
  while(i < 36) {
    st64(a + i * 8, 0);
    i = i + 1;
  }
} return void;

// A block returned to its size class (pool.id): the old head of the list goes
// in its first word and the block becomes the head.
pool_give(word cls, word b) {
  word h = pool_head(cls);
  st64(b, ld64(h));
  st64(h, b);
} return void;
