// Function values on the freestanding target (docs/SPEC.md 1.1.1): the objects
// the hosted runtimes make, as raw words in the arena. A module the LLVM target
// printed never looks inside one; it calls these. An object is three words --
// the adapter, the plain function (0 for a closure), the number of captured
// cells -- and then the cells, eight bytes each. A word is an address here, as a
// `ptr` is in the module that calls it, and an object is not freed: nothing
// proves it dead (docs/MEMORY.md 3.5), and the arena only bumps.

clo_make(word kfn, int kn) {
  word ko = mem_alloc(24 + kn * 8);
  st64(ko, kfn);
  st64(ko + 8, 0);
} chain (word kfn, int kn) {
  st64(ko + 16, kn);
} return word ko;
given store_setup(64) given poke64((import tn8), 123) (11, 2):((import tnx)) then clo_word((import tnx), 0):(11) then clo_word((import tnx), 1):(0) then clo_word((import tnx), 2):(2) then top_gap((import tnx)):(40)
given store_setup(64) (5, 0):((import tnx)) then clo_word((import tnx), 0):(5) then clo_word((import tnx), 2):(0) then top_gap((import tnx)):(24)

clo_set(word ko, int ki, word kv) {
  st64(ko + 24 + ki * 8, kv);
} return word ko;
given store_setup(64) ((import tsb), 1, 42):((import tsb)) then clo_word((import tsb), 4):(42) then clo_word((import tsb), 3):(0)
given store_setup(64) ((import tsb), 0, 7):((import tsb)) then clo_word((import tsb), 3):(7) then clo_word((import tsb), 4):(0)

fn_plain(word kfn, word kraw) {
  word ko = clo_make(kfn, 0);
  st64(ko + 8, kraw);
} return word ko;
given store_setup(64) (21, 22):((import tnx)) then clo_word((import tnx), 0):(21) then clo_word((import tnx), 1):(22) then clo_word((import tnx), 2):(0)
given store_setup(64) given poke64((import tn8), 9) (3, 4):((import tnx)) then clo_word((import tnx), 1):(4) then top_gap((import tnx)):(24)
