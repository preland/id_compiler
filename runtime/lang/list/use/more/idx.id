// Reading and writing a cell.
//
// docs/SPEC.md 5 says an index outside the list traps. There is no stderr to
// trap to here and nothing to exit to, so these are the address arithmetic and
// nothing else -- the one place this runtime is less safe than the hosted one,
// and the reason is the absence of a place to report to rather than a judgement
// that the check is not worth it.

cell_at(int[] xs, int i) {
  word l2w_v = l2w(xs);
  word ret_w = ld64(l2w_v + 16) + i * 8;
} return word ret_w;
given rlist_fix given list_c2 ((import tlx), 2):((import tle))
given rlist_fix ((import tlx), 0):((import tlc))

list_get(int[] xs, int i) {
  word cell_at_v = cell_at(xs, i);
  word ret_w = ld64(cell_at_v);
} return word ret_w;
([5, 6, 7], 1):(6)
([5, 6, 7], 0):(5)

list_set(int[] xs, int i, word v) {
  word cell_at_v = cell_at(xs, i);
  st64(cell_at_v, v);
} return void;
given rlist_fix ((import tlx), 1, 9):() then (import tlx):([4, 9, 6])
given rlist_fix ((import tlx), 2, 0):() then (import tlx):([4, 5, 0])
