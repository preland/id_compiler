// The tail of `list_pop`, once the length has been decremented: reading the
// cell the length now points just past, which is the one just dropped.
list_pop_at(word p) {
  word ld64_v = ld64(p);
  st64(p, ld64_v - 1);
  word ret_w = list_pop_read(p);
} return word ret_w;

list_pop_read(word p) {
  word addr = ld64(p + 16);
  word count = ld64(p);
  word ret_w = ld64(addr + count * 8);
} return word ret_w;

// One cell of a list being freed with its elements (more/init.id,
// list_free_deep): the cell is a list, and goes back as one. Filed here beside
// the other cell reader because init.id has no room for it.
list_free_at(word fa_p, word fa_k) {
  word fa_cells = ld64(fa_p + 16);
  word fa_e = ld64(fa_cells + 8 * fa_k);
  list_free(w2l(fa_e));
} return void;
