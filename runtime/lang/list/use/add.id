// Appending, and the growth that makes it always possible.
//
// Capacity doubles, so the copying a long run of pushes does is proportional
// to the list rather than to the square of it. Growth gives the old cell array
// back to its size class (more/pool.id), as the hosted `realloc` does, so a
// list that grows through n doublings does not leave every earlier array behind
// it in the arena.

list_push(int[] xs, word v) {
  word l2w_v = l2w(xs);
  word p = list_room(l2w_v);
  list_push_at(p, v);
} return void;

list_room(word p) {
  if(ld64(p) >= ld64(p + 8)) {
    word ld64_v = ld64(p + 8);
    list_grow(p, ld64_v * 2);
  }
} return word p;

list_grow(word p, word z) {
  word cls = pool_cls(4, 1, z);
  word a = pool_take(cls, z * 8);
  word ld64_v = ld64(p + 16);
} chain (word p, word z) {
  list_grow_copy(p, a, z, ld64_v);
  pool_give(cls - 1, ld64_v);
} return void;
