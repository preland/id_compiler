// Giving back a list of strings and the strings in it (drop.id's list_free for
// the pieces as well). The compiler calls list_free_strs (as id_list_free_strs)
// for a local string list whose pieces it proved fresh and unshared. A list
// already freed has cap -1 and frees nothing, as list_free_deep does.

list_free_strs(int[] ls_xs) {
  word ls_p = l2w(ls_xs);
  list_free_each(ls_p);
  list_free(ls_xs);
} return void;
given strs_fix given strs_fill ((import twr)):() then str_head((import twsc)):(1) then list_cap_of((import twr)):(-1)
given strs_fix given strs_fill given list_free((import twr)) ((import twr)):() then str_head((import twsc)):(0)

list_free_each(word le_p) {
  word le_k = 0;
  while(le_p != 0 && ld64(le_p + 8) > 0 && le_k < ld64(le_p)) {
    str_free_at(le_p, le_k);
    le_k = le_k + 1;
  }
} return void;
given strs_fix given strs_fill ((import twp)):() then str_head((import twsc)):(1) then str_head((import twsa)):(0) then list_cap_of((import twr)):(4)
given strs_fix given strs_fill given list_free((import twr)) ((import twp)):() then str_head((import twsc)):(0)

str_free_at(word sa_p, word sa_k) {
  word sa_cells = ld64(sa_p + 16);
  word sa_e = ld64(sa_cells + 8 * sa_k);
  str_free(w2s(sa_e));
} return void;
