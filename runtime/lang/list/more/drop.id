list_give(word p) {
  word cap = ld64(p + 8);
  word cells = ld64(p + 16);
  word cls = pool_cls(4, 1, cap);
} chain (word p) {
  pool_give(cls, cells);
  st64(p + 8, 0 - 1);
  pool_give(0, p);
} return void;
