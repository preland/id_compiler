// `rotl` at both widths, with no instruction of its own: a rotate is the two
// shifts that move the bits out and the bits that wrap round, or-ed together.
//
// The count is taken modulo the width by masking, so a negative count rotates
// the other way and a count at or past the width means something. A count of
// zero makes the second shift an unshifted copy, and or-ing a value with itself
// is the value, so no branch is needed for it. The 32-bit form sign-extends its
// result, as the hosted runtime's `(int)` cast does, so an int result needs no
// further work at the call.

rotl(word a, word v) {
  word rt_k = v & 63;
  word ret_w = (a << rt_k) | ushr(a, (64 - rt_k) & 63);
} return word ret_w;

rotl32(word a, word v) {
  word rt_v = a & 4294967295;
  word rt_j = v & 31;
  word rt_r = ((rt_v << rt_j) | ushr(rt_v, (32 - rt_j) & 31)) & 4294967295;
} chain (word a, word v) {
  word ret_w = (rt_r ^ 2147483648) - 2147483648;
} return word ret_w;
