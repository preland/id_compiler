// `mul_checked` at both widths. A 32-bit product of sign-extended operands fits
// a machine word, so it is judged by whether it still fits an int.
//
// A 64-bit product is judged by dividing it back: it wrapped unless the quotient
// is the other operand. Two operands break that test. Zero divides nothing, and
// a product of zero never wraps. Minus one is the divisor for which the word
// divide itself would trap, and the one pair that overflows with it is
// minus one times the most negative word.

mul_checked(word a, word v) {
  word ck_p = a * v;
  if(mul_wrapped(a, v, ck_p) == 1) {
    fail("integer overflow");
  }
} return word ck_p;

mul_checked32(word a, word v) {
  word ck_p = a * v;
  if(ck_p > 2147483647 || ck_p < 0 - 2147483648) {
    fail("integer overflow");
  }
} return word ck_p;

mul_wrapped(word a, word v, word p) {
  word mw_r = 0;
  if(a == 0 - 1 && v == 0 - 9223372036854775807 - 1) {
    mw_r = 1;
  }
  if(a != 0 && a != 0 - 1 && p / a != v) {
    mw_r = 1;
  }
} return word mw_r;
(-1, -9223372036854775808, -9223372036854775808):(1)
(-1, 5, -5):(0)
(0, 5, 0):(0)
(4611686018427387904, 2, -9223372036854775808):(1)
(3, 4, 12):(0)
