given desc_fix ((import tdb), 5):(5)

fw_num(word fq_b, word fq_o) {
  word fq_n = 0;
  while(ld8(fq_b + fq_o) != 59) {
    fq_n = fq_n * 10 + ld8(fq_b + fq_o) - 48;
    fq_o = fq_o + 1;
  }
} return word fq_n;
