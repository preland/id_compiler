// Following `@N;` back-references to the node they name, which is how a type
// that holds itself ends. The number is read in place, digit by digit.

fw_ref(word fr_b, word fr_o) {
  while(ld8(fr_b + fr_o) == 64) {
    fr_o = fw_num(fr_b, fr_o + 1);
  }
} return word fr_o;
given desc_fix ((import tdb), 11):(0)
