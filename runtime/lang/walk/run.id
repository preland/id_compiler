fw_kids_l(int[] fx_st, word fx_b, word fx_p, word fx_o) {
  word fx_k = ld64(fx_p);
  if(ld8(fx_b + fx_o + 1) == 46) {
    fx_k = 0;
  }
  word fx_i = 0;
} chain (int[] fx_st, word fx_b, word fx_p, word fx_o) {
  while(fx_i < fx_k) {
    fw_push(fx_st, fx_p, fx_i, fx_o + 1);
    fx_i = fx_i + 1;
  }
} return void;
