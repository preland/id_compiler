// The first half of `concat`: how much room the two strings need (their bytes,
// a NUL, and the count word in front, which is written here), and the first of
// them copied in behind the count.
concat_alloc(string s, string r) {
  int len_v = len(s) + len(r);
  word p = str_blk(len_v);
  st64(p, len_v);
} return word p;

concat_at(string s, string r, word p) {
  word a = concat_copy1(s, p);
  string ret_s = concat_copy2(r, p, a);
} return string ret_s;

concat_copy1(string s, word p) {
  word s2w_v = s2w(s);
  int len_v3 = len(s);
  word a = p + 8 + copy_bytes(s2w_v, p + 8, len_v3);
} return word a;
