given strs_fix given strs_w ((import twk)):() then str_head((import twsc)):(1) then str_head((import twsa)):(0)

str_dup(string sd_s) {
  word sd_w = s2w(sd_s);
  word sd_n = len(sd_s);
  string ret_s = str_of_mem(sd_w, sd_n);
} return string ret_s;
