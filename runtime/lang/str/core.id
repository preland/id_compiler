// A string is a NUL-terminated byte sequence reached through a pointer, with
// its byte count in the eight bytes just before the first byte -- the layout
// the hosted runtime and the LLVM module's literals use (runtime/prelude.id),
// so one `id` program means the same thing on either. Every string made here
// writes that count (make/, store/arena/bridge.id), and the NUL stays after the
// bytes for code that wants one.
//
// Which makes `len` one load, and `charat` O(1) however many strings are being
// walked at once: there is no memo to outgrow.

len(string s) {
  word s2w_v = s2w(s);
  int ret_i = ld64(s2w_v - 8);
} return int ret_i;

character_code_at(string s, int i) {
  int c = 0 - 1;
  if(i >= 0 && i < len(s)) {
    word s2w_v = s2w(s);
    c = ld8(s2w_v + i);
  }
} return int c;
