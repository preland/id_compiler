// A string is a NUL-terminated byte sequence reached through a pointer, which
// is the representation docs/SPEC.md 4 already describes -- and the reason a
// string cannot contain a NUL there is the reason it cannot here.
//
// Which means the length is a scan, and `charat` needs the length to know
// where the end is -- so walking a string is O(n^2) unless the length is
// remembered. The hosted runtime learned that twice: once with a memo of one
// string, and again when one turned out not to be enough for a program that
// reads its input and builds a string at the same time. This one starts where
// that ended up, with a memo of several (see mem/lm/).

len(string s) {
  word s2w_v = s2w(s);
  int ret_i = lm_len(s2w_v);
} return int ret_i;

charat(string s, int i) {
  int c = 0 - 1;
  if(i >= 0 && i < len(s)) {
    word s2w_v = s2w(s);
    c = ld8(s2w_v + i);
  }
} return int c;

// The scan itself, for when the memo does not have the answer.
len_scan(word a, int n) {
  while(ld8(a + n) != 0) {
    n = n + 1;
  }
} return int n;
