// One protocol file, by path, read to its end.
wg_scan(string vs_path) {
  string vs_xml = fs_read_text(vs_path);
  wg_walk(vs_xml);
} return void;
given wg_init given fs_temp_text("<a><interface name=\"w\" version=\"2\"/></a>") ((import fs_temp_path)):() then wg_t_state:("1 0 0")
given wg_init given fs_temp_text("<a/>") ((import fs_temp_path)):() then wg_t_state:("0 0 0")

// A document read to its end: every element is told to wg_step with its name and the five attributes the generator looks at (name, value, version, type, interface). A fault ends the loop, because xr_next answers 0 after one, and is reported on standard error.
wg_walk(string vs_xml) {
  int[] vl_bytes = exec_bytes(vs_xml);
  XmlR vr_r = xml_reader_open(vl_bytes);
  int vi_k = xml_reader_next(vr_r);
} chain (string vs_xml) {
  while (vi_k != 0) {
    string[] vz_a = [xml_reader_attribute(vr_r, "name"), xml_reader_attribute(vr_r, "value"), xml_reader_attribute(vr_r, "version"), xml_reader_attribute(vr_r, "type"), xml_reader_attribute(vr_r, "interface")];
    wg_step(vi_k, xml_reader_get(vr_r, (import xml_reader_k_name)), vz_a);
    vi_k = xml_reader_next(vr_r);
  }
  string vs_err = xml_reader_get(vr_r, (import xml_reader_k_error));
  if (len(vs_err) > 0) {
    eprint(vs_err);
  }
} return void;
given wg_init ("<p><interface name=\"a\" version=\"3\"><request name=\"go\"/><event name=\"up\"/></interface></p>"):() then wg_t_state:("1 2 0")
given wg_init ("<p><interface name=\"a\" version=\"1\"><enum name=\"e\"><entry name=\"x\" value=\"1\"/></enum></interface></p>"):() then wg_t_state:("1 0 1")
