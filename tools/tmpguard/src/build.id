// Building one tree: the command, and running it.

// The command that builds tree under tg_idc_root into tg_out, with IDC_NO_STD
// removed from its environment so the standard library and its cases are part
// of the build, and every case of the tree itself run fresh (IDC_FRESH_CASES)
// while the library's cases and every object stay cached.
tg_argv(string tg_idc_root, string tg_tree_path, string tg_out) {
  string tg_head = "env\n-u\nIDC_NO_STD\nIDC_FRESH_CASES=" + tg_tree_path + "\nTMPDIR=" + tg_out + "/tmp\n" + tg_idc_root + "/bin/idc\n" + tg_tree_path;
  string tg_lines = tg_head + "\n--allow-untested\n-o\n" + tg_out + "/bin\n";
} return string tg_lines;
("/r", "t", "/tmp/x"):("env\n-u\nIDC_NO_STD\nIDC_FRESH_CASES=t\nTMPDIR=/tmp/x/tmp\n/r/bin/idc\nt\n--allow-untested\n-o\n/tmp/x/bin\n")
("/idc", "demos/hello", "/tmp/b/o"):("env\n-u\nIDC_NO_STD\nIDC_FRESH_CASES=demos/hello\nTMPDIR=/tmp/b/o/tmp\n/idc/bin/idc\ndemos/hello\n--allow-untested\n-o\n/tmp/b/o/bin\n")

// Builds tg_tree_path, keeping the compiler's output and showing it on stderr
// only when the build fails. Answers the build's status.
tg_build(string tg_idc_root, string tg_tree_path, string tg_out) {
  string tg_lines = tg_argv(tg_idc_root, tg_tree_path, tg_out);
  int[] tg_none = [];
  int[] tg_said = [];
} chain (string tg_idc_root, string tg_tree_path, string tg_out) {
  int tg_rc = exec_run(tg_lines, 0, 0, tg_none, tg_said, tg_said, (import tg_ms));
  string tg_text = exec_text(tg_said);
  if (tg_rc != 0 && len(tg_text) > 0) {
    eprint(tg_text);
  }
} return int tg_rc;
given tg_t_fake(0, 0) ((import tg_t_root), "t", "/dev/null"):(0)
given tg_t_fake(3, 0) ((import tg_t_root), "t", "/dev/null"):(3)
