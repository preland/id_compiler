// libgen turns the signatures of an id library's exported functions into the
// C header a host includes and the C wrappers that implement it. `idc --lib`
// runs it; docs/INTEROP.md, "id as a library", says what the output means.
//
// One row per id type, in the same order in every table below. `$` stands for
// the C name of the parameter and `@` for the library's name. A table entry
// that is empty means the type has no such form: a `string[][]` can be
// returned but not taken, and `void` can only be returned.
string[] lg_tname = ["int", "word", "float", "string", "int[]", "word[]", "float[]", "string[]", "string[][]", "void"];

// The C parameters a host passes for an id parameter.
string[] lg_tparam = ["int32_t $", "int64_t $", "double $", "const char* $, size_t $_len", "const int32_t* $, size_t $_len", "const int64_t* $, size_t $_len", "const double* $, size_t $_len", "const char* const* $, const size_t* $_lens, size_t $_count", "", ""];

// The expression handed to the id function for that parameter.
string[] lg_targ = ["$", "$", "$", "idl_in_str($, $_len)", "idl_in_ints($, $_len)", "idl_in_words($, $_len)", "idl_in_floats($, $_len)", "idl_in_strs($, $_lens, $_count)", "", ""];

// The out parameters that carry an id result back to the host.
string[] lg_tout = ["int32_t* out", "int64_t* out", "double* out", "char** out, size_t* out_len", "int32_t** out, size_t* out_len", "int64_t** out, size_t* out_len", "double** out, size_t* out_len", "@_strs* out", "@_table* out", ""];

// What the id function returns, as the program's own C spells it.
string[] lg_tctype = ["int", "long long", "double", "char*", "IdList*", "IdList*", "IdList*", "IdList*", "IdList*", ""];

// Run before anything can trap, so a failed call leaves the host's outs empty.
string[] lg_tzero = ["*out = 0;", "*out = 0;", "*out = 0;", "*out = NULL; *out_len = 0;", "*out = NULL; *out_len = 0;", "*out = NULL; *out_len = 0;", "*out = NULL; *out_len = 0;", "out->count = 0; out->items = NULL; out->lens = NULL;", "out->rows = 0; out->row = NULL;", ""];

// Copies the id result into memory the host owns.
string[] lg_tstore = ["*out = r;", "*out = r;", "*out = r;", "idl_out_str(out, out_len, r);", "idl_out_ints(out, out_len, r);", "idl_out_words(out, out_len, r);", "idl_out_floats(out, out_len, r);", "idl_out_strs(out, r);", "idl_out_table(out, r);", ""];

// Exported id functions that would take a symbol the runtime already owns.
string[] lg_reserved = ["free", "error", "shutdown", "strs", "table", "strs_free", "table_free"];

// The part of the header that comes before the function declarations.
string[] lg_head = ["/* @.h -- the C interface of the id library '@', generated by idc --lib.", " *", " * Every function returns 0 on success, 1 if the id code trapped (a bounds", " * error, a division by zero, out of memory, exit) and 2 if an argument was", " * invalid (a NUL byte in a string). On failure @_error() describes it and", " * every out parameter is empty. Results are written through the trailing", " * 'out' parameters; they belong to the caller. Release them with @_free,", " * @_strs_free or @_table_free. Calls are serialised by a lock inside the", " * library, so a host may call from several threads. See docs/INTEROP.md. */", "#ifndef IDL_HEADER_@", "#define IDL_HEADER_@", "#include <stddef.h>", "#include <stdint.h>", "#ifdef __cplusplus", "extern \"C\" {", "#endif", "#ifndef IDL_API", "#define IDL_API", "#endif", "", "typedef struct @_strs { size_t count; char** items; size_t* lens; } @_strs;", "typedef struct @_table { size_t rows; @_strs* row; } @_table;", "", "IDL_API const char* @_error(void);", "IDL_API void @_free(void* p);", "IDL_API void @_strs_free(@_strs* s);", "IDL_API void @_table_free(@_table* t);", "IDL_API void @_shutdown(void);", ""];

// The part of the header that comes after them.
string[] lg_tail = ["", "#ifdef __cplusplus", "}", "#endif", "#endif"];
