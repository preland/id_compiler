// Driving the generator over the exported functions.

// Print one exported function's text (its declaration in header mode, its
// wrapper otherwise), or say why it cannot be exported. 0 or 1.
lg_one(string lg_mode, string lg_lib, string lg_nm, string[] lg_lines) {
  string lg_ln = lg_find(lg_lines, lg_nm);
  string lg_why = lg_why_of(lg_ln, lg_lib, lg_nm);
  int lg_rc = lg_flag(lg_why);
} chain (string lg_mode, string lg_lib, string lg_nm, string[] lg_lines) {
  if (lg_rc == 0 && lg_mode == "header") {
    print(lg_decl(lg_ln, lg_lib));
  } else if (lg_rc == 0) {
    print(lg_wrap(lg_ln, lg_lib));
  } else {
    eprint(lg_why);
  }
} return int lg_rc;
("header", "m", "add", ["|(int 0)->int=>b\tadd\tf.id:1"]):(0) then prints:("/* add(int) return int */\nIDL_API int m_add(int32_t in_0, int32_t* out);\n\n")
("wrap", "m", "tick", ["|()->void=>b\ttick\tf.id:2"]):(0) then prints:("IDL_API int m_tick(void) {\n    IDL_BEGIN\n    id_tick();\n    IDL_END\n}\n\n")
("wrap", "m", "nope", []):(1) then eprints:("libgen: the program has no function 'nope'\n")
("wrap", "m", "free", ["|()->void=>b\tfree\tf.id:1"]):(1) then eprints:("libgen: 'free' would be exported as m_free, the name of one of the library's own entry points; rename the function\n")

// Every named function, in order, framed by the header text in header mode.
// The number of functions that could not be exported.
lg_all(string lg_mode, string lg_lib, string[] lg_fns, string[] lg_lines) {
  int lg_nbad = 0;
  int lg_i = 0;
  print(lg_top(lg_mode, (import lg_head), lg_lib));
} chain (string lg_mode, string lg_lib, string[] lg_fns, string[] lg_lines) {
  while (lg_i < len(lg_fns)) {
    lg_nbad = lg_nbad + lg_one(lg_mode, lg_lib, lg_fns[lg_i], lg_lines);
    lg_i = lg_i + 1;
  }
  print(lg_bottom(lg_mode, (import lg_tail)));
} return int lg_nbad;
("wrap", "m", ["a", "b"], ["|()->void=>b\ta\tf.id:1", "|(float 0)->float=>b\tb\tf.id:2"]):(0) then prints:("\nIDL_API int m_a(void) {\n    IDL_BEGIN\n    id_a();\n    IDL_END\n}\n\nIDL_API int m_b(double in_0, double* out) {\n    *out = 0;\n    IDL_BEGIN\n    double r = id_b(in_0);\n    *out = r;\n    IDL_END\n}\n\n\n")
("wrap", "m", ["a", "zz"], ["|()->void=>b\ta\tf.id:1"]):(1) then eprints:("libgen: the program has no function 'zz'\n")
