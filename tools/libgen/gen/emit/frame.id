// What the header says before and after its function declarations. The
// wrapper file has no such framing, so both come back empty in wrap mode.

// The text before the declarations, with the library's name in.
lg_top(string lg_mode, string[] lg_lines, string lg_lib) {
  string lg_hdtext = "";
  string lg_joined = string_join(lg_lines, "\n");
  if (lg_mode == "header") {
    lg_hdtext = lg_sub(lg_joined, "@", lg_lib);
  }
} return string lg_hdtext;
("header", ["#ifndef IDL_HEADER_@", "typedef @_t;"], "m"):("#ifndef IDL_HEADER_m\ntypedef m_t;")
("wrap", ["#ifndef IDL_HEADER_@"], "m"):("")

// The text after the declarations.
lg_bottom(string lg_mode, string[] lg_lines) {
  string lg_tltext = "";
  if (lg_mode == "header") {
    lg_tltext = string_join(lg_lines, "\n");
  }
} return string lg_tltext;
("header", ["}", "#endif"]):("}\n#endif")
("wrap", ["}"]):("")
