// Skip pump_in entirely on the "-" (no input) path: the common case -- most
// capped() calls are a plain `cc`/`clang` that never reads stdin at all --
// pays nothing for input handling once child/setup.id's open_input_if_any
// has already closed the child's stdin.
maybe_pump_in(int timeout_ms) {
  int has = (import cr_has_in);
  if(has) {
    pump_in(timeout_ms);
  }
} return void;
