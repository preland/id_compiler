// Rebind cr_h to a live child that runs the command given: `sh -c` of "sleep 0.1; exit 7" for a
// child that exits 7 a moment later, of "exit 0" for one that exits 0 straight away. run_capped
// is the sole exporter of cr_h and always closes it, so this spawns afresh into the slot that
// close just freed (idstd's proc_spawn takes the lowest free slot), leaving cr_h naming a child
// pump_finish has yet to wait on.
ccrun_fx_live_exit(string ccrun_fx_le_cmd) {
  int ccrun_fx_le_h = proc_spawn_limited(ccrun_fx_le_cmd, 0, 0);
} return void;
("sh\n-c\nsleep 0.1; exit 7\n"):() then calls proc_spawn_limited:("sh\n-c\nsleep 0.1; exit 7\n", 0, 0)
("sh\n-c\nexit 0\n"):() then calls proc_spawn_limited:("sh\n-c\nexit 0\n", 0, 0)

// What cr_h's child exits with, waited on for up to two seconds.
ccrun_fx_wait_value() {
  int ccrun_fx_wv_code = proc_wait((import cr_h), 2000);
} return int ccrun_fx_wv_code;
given ccrun_fx_run_capped_true given ccrun_fx_live_exit("sh\n-c\nsleep 0.1; exit 7\n") ():(7)
given ccrun_fx_run_capped_true given ccrun_fx_live_exit("sh\n-c\nexit 0\n") ():(0)
