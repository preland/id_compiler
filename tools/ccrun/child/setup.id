// All per-run state pump_round/pump_finish/close_all and
// tools/ccrun/input/round.id's pump_in share, set up once before the first
// round: a 4096-byte scratch buffer for the child's stdout and stderr, and
// -- only when INPUT names a real file, never for "-" -- an open handle on
// it plus a matching 4096-byte staging buffer (4096 is PIPE_BUF: idstd's
// proc_linux.c caps a single proc_write at 4096 bytes and a Linux pipe
// write of that size is atomic, so a write is always all-or-nothing and
// there is never a partial chunk to re-slice).
//
// cr_has_in says which case this run is, once, for pump_round and
// close_all to read; cr_in/cr_pending are exported by open_input (below)
// only on the has-input path, so nothing ever reads them uninitialised.
//
// cr_pending_n/cr_in_eof/cr_in_done are boxed (a 1-element list, not a
// plain int) and declared here, not where they used to be re-exported
// (input/round.id's pump_in, input/close.id's do_close_in): a plain export
// can only ever be declared by the one function that owns it, so pump_in
// re-exporting them on every round left them undeclared until pump_in's
// own first call -- fine in a real build (an int import reads 0 before its
// declaring function has run), but a test case traps on exactly that read
// (docs/SPEC.md §8's "any type in a test case" row), and no `given` could
// reach past it since nothing else was allowed to declare them first. A
// boxed list is still owned by one function -- this one -- but its cells
// can be written from anywhere by index, the same way spawn_qemu's qm_buf
// (tools/qmon) is pushed onto from outside its own exporter.
setup_io(string input) {
  export int[] cr_chunk = [];
  lst_fill((import cr_chunk), 4096, 0);
  export int cr_has_in = input != "-";
} chain (string input) {
  export int[] cr_pending_n = [0];
  export int[] cr_in_eof = [0];
  export int[] cr_in_done = [0];
} chain (string input) {
  open_input_if_any(input);
} return void;
given ccrun_fx_run_capped_true ("-"):("-") then calls open_input_if_any:("-")
("main.id"):("main.id") then calls open_input_if_any:("main.id")

// A real file, or "-": no input at all, and the child's stdin is closed at
// once -- the same immediate EOF `capped()` gave a child that never read
// its inherited stdin either.
open_input_if_any(string input) {
  int has = input != "-";
  if(has) {
    open_input(input);
  } else {
    int closed = proc_close_in((import cr_h));
  }
} return void;
given ccrun_fx_run_capped_true ("-"):("-") then calls open_input:[0]
("main.id"):("main.id") then calls open_input:("main.id")

open_input(string input) {
  export int cr_in = fs_open(input, "r");
  export int[] cr_pending = [];
  lst_fill((import cr_pending), 4096, 0);
} return void;
("main.id"):("main.id") then calls lst_fill:[1]
("child/setup.id"):("child/setup.id") then calls lst_fill:[1]
