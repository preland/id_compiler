// pump_in (round.id) takes timeout_ms, so a `given` cannot name it directly;
// this gives it a fixed, harmless timeout for cases that need one real round
// run before the case's own call.
ccrun_fx_pump_once() {
  pump_in(50);
} return void;
given ccrun_fx_setup_input_main ():() then calls pump_in:(50)
