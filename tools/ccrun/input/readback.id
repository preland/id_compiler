// Test check: whether the child's stdin has been closed, as the whole input
// flag list. maybe_close_in (close.id) reads the flag to decide whether to
// close, so a check of the flag alone would repeat its own read.
cr_in_text() {
  string cr_in_t = lst_text((import cr_in_done), ",");
  string cr_in_s = "input " + len((import cr_in_done)) + ":" + cr_in_t;
} return string cr_in_s;
