// A real, empty file: fs_mktemp's file is removed right after setup_io opens
// it -- Linux keeps an already-open handle valid past unlink, so this leaves
// nothing in /tmp. Read from it (round.id's pump_in, via ccrun_fx_pump_once)
// gets a real, immediate 0-byte result, unlike ccrun_fx_setup_input_main's
// real content.
ccrun_fx_empty_input() {
  string p = fs_mktemp("ccrun_empty_", 0);
  fs_drop_exit(p);
  setup_io(p);
} chain () {
  int rm = fs_remove(p);
} return void;
():() then ccrun_fx_pending_value:(0)
