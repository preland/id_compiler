given ccrun_fx_run_capped_true given ccrun_fx_setup_input_main ():() then ccrun_fx_in_done_value:(1)

// The file cr_in was opened from (child/setup.id's open_input), closed once
// at the very end -- called from child/finish.id's close_all, only on the
// has-input path: cr_in is never opened on the "-" path, so there is
// nothing here to close.
close_input_if_any() {
  int has = (import cr_has_in);
  if(has) {
    int ci = fs_close((import cr_in));
  }
} return void;
