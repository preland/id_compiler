// One round's worth of relaying cr_in (child/setup.id's open_input; this is
// only ever called when there is one -- see child/round.id's maybe_pump_in)
// to the child: finish sending whatever chunk is already staged in
// cr_pending (a successful proc_write always accepts it whole -- see
// ../child/setup.id's comment on PIPE_BUF -- so there is never a partial
// chunk to re-slice, only "sent" or "not yet"), then, once nothing is
// staged and we have not hit cr_in's own EOF, stage the next chunk from it.
// cr_pending_n/cr_in_eof are read and re-exported here every round; nothing
// else ever assigns them, so a stale read racing a fresher write cannot
// happen.
pump_in(int timeout_ms) {
  int pending = (import cr_pending_n);
  int eof = (import cr_in_eof);
  if(pending > 0) {
    int wrote = proc_write((import cr_h), (import cr_pending), pending, timeout_ms);
    if(wrote == pending) {
      pending = 0;
    }
  }
} chain (int timeout_ms) {
  if(pending == 0 && eof == 0) {
    int got = fs_read((import cr_in), (import cr_pending), 4096);
    pending = got;
    eof = got == 0;
  }
  export int cr_pending_n = pending;
  export int cr_in_eof = eof;
} chain (int timeout_ms) {
  maybe_close_in();
} return void;

// run_capped, spawning a real ("true") child under no limits with real
// stdout/stderr streams, is the sole exporter of cr_h/cr_out/cr_err
// (main.id): nothing else may declare them, so this is the only way any
// other case gets a real (if, by the time this returns, already drained and
// closed) value for cr_h. Reused by every case below that needs one.
ccrun_fx_run_capped_true() {
  int ccrun_fx_rc_code = run_capped("true\n", "-", 0, 0);
} return void;
():() then calls run_capped:("true\n", "-", 0, 0)
():() then calls setup_io:("-")

// setup_io, the sole exporter of cr_chunk/cr_has_in (child/setup.id), run on
// a real file in this project's own tree: cr_has_in ends up 1, and
// open_input (the sole exporter of cr_in/cr_pending) runs too. Composes
// with ccrun_fx_run_capped_true for a case that needs both cr_h and a
// has-input state.
ccrun_fx_setup_input_main() {
  setup_io("main.id");
} return void;
():() then calls setup_io:("main.id")
():() then calls open_input:("main.id")
