// Breadth-first traversal of the call graph (parse/tables.id's ix_ecaller/
// ix_ecallee, kind "call" only -- a function merely named as a value is not
// necessarily invoked, so a "value" edge does not extend an import closure).
// bfs_visited: How many names the last `bfs_run` reached -- a witness for BFS's own
// tests that does not depend on the order names were visited in.
bfs_run(string root_fn) {
  export string[] bfs_visited = [];
  bfs_visit(root_fn);
  string[] ret_li = (import bfs_visited);
} return string[] ret_li;
given ix_test_setup ("a"):(["a", "b"])
given ix_test_setup_empty ("z"):(["z"])

bfs_visit(string name) {
  int already = idx_find_str((import bfs_visited), name);
  if(already < 0) {
    bfs_visit_new(name);
  }
} return void;
given bfs_test_setup ("a"):() then len((import bfs_visited)):(2)
given bfs_test_setup ("q"):() then len((import bfs_visited)):(3)

