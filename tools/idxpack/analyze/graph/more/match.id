// Is edge `i` a direct call from `caller`? ("value" edges -- a function
// merely named, not invoked -- never extend the BFS.)
edge_is_call_from(int i, string caller) {
  string ec = (import ix_ecaller)[i];
  string ek = (import ix_ekind)[i];
  int out_i = 0;
} chain (int i, string caller) {
  if(str_cmp(ec, caller) == 0 && str_cmp(ek, "call") == 0) {
    out_i = 1;
  }
} return int out_i;
