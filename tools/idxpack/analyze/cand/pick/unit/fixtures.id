// The three states std.id's path_is_std cases need: a real stdlib root, no
// ===STD=== line at all (the pre-fix index format), and a line present but
// naming no library (a build made with --no-std). Each also seeds ix_fn via
// ix_init, purely so total_funcs (analyze/graph/bfs.id) is a second, distinct
// witness alongside std_present_get -- two cases that both used
// std_present_get alone would check the same fixed state and collide.
std_unit_fixture_root() {
  string[] no_edges = [];
  ix_init(no_edges, ["z|f.id|1|2"]);
  std_root_set("/repo/idstd", 1);
} return void;
():() then len((import ix_fn)):(1)
():() then calls std_root_set:("/repo/idstd", 1)

std_unit_fixture_fallback() {
  string[] no_edges = [];
  ix_init(no_edges, no_edges);
  std_root_set("", 0);
} return void;
():() then len((import ix_fn)):(0)
():() then calls std_root_set:("", 0)

std_unit_fixture_empty() {
  string[] no_edges = [];
  ix_init(no_edges, no_edges);
  std_root_set("", 1);
} return void;
():() then len((import ix_fn)):(0)
():() then calls std_root_set:("", 1)
