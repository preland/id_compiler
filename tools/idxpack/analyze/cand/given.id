// Every zero-parameter void function in the build whose transitive call
// closure (analyze/graph/bfs.id) reaches every name in `required` -- the
// legal `given` setups for a case that needs all of them initialised.
find_givens(string[] required) {
  string[] out_li = [];
  int i = 0;
  while(i < len((import ix_fn))) {
    string cand = (import ix_fn)[i];
    if(is_zero_void(cand) == 1 && given_reaches(cand, required) == 1) {
      push(out_li, cand);
    }
    i = i + 1;
  }
} return string[] out_li;
given ix_export_fixture (["setter"]):(["setter"])
given ix_export_fixture (["nope"]):([])

// Does `candidate`'s own transitive call closure include every name in
// `required`?
given_reaches(string candidate, string[] required) {
  string[] reached = bfs_run(candidate);
  int i = 0;
  int out_i = 1;
} chain (string candidate, string[] required) {
  while(i < len(required)) {
    if(idx_find_str(reached, required[i]) < 0) {
      out_i = 0;
    }
    i = i + 1;
  }
} return int out_i;
given ix_export_fixture ("setter", ["setter"]):(1)
given ix_export_fixture ("setter", ["nope"]):(0)

// Zero parameters (the header line's "NAME()") and a `void` return (the
// function's own "} return void" line, found by joining its body once
// rather than scanning line by line for the one clause that has it).
is_zero_void(string name) {
  string[] body = func_body_lines(name);
  int out_i = 0;
  if(len(body) >= 1 && str_find(body[0], "()") >= 0) {
    string joined = str_join(body, "\n");
    if(str_find(joined, "} return void") >= 0) {
      out_i = 1;
    }
  }
} return int out_i;
given ix_export_fixture ("setter"):(1)
given ix_import_fixture ("r"):(0)
