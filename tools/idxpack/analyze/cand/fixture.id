// Shared test state for everything under analyze/: one function, one edge,
// one file -- enough for every reader here (total_funcs, total_edges,
// total_files, and every BFS/scan/candidate function below) to have a
// concrete `given` to point at, without each rebuilding its own tables.
ix_test_setup() {
  ix_init(["a|b|call"], ["a|f.id|1|2"]);
  fx_init(["===F:f.id===", "a() { } return void;"]);
} return void;
():() then len((import ix_fn)):(1)
():() then len((import fx_path)):(1)

ix_test_setup_empty() {
  string[] no_lines = [];
  ix_init(no_lines, no_lines);
  fx_init(no_lines);
} return void;
():() then len((import ix_fn)):(0)
():() then len((import fx_path)):(0)

// bfs_visited exported and populated (parse state included), for cases
// that exercise a single BFS step rather than the whole `bfs_run` sweep.
bfs_test_setup() {
  ix_init(["a|b|call"], ["a|f.id|1|2"]);
  bfs_run("a");
} return void;
():() then len((import ix_fn)):(1)
():() then len((import bfs_visited)):(2)
