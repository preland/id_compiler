// The function table, as parallel lists: one entry per --calls case-count
// row the shell wrapper reformatted to "name|file_l|line_l|cases" (splitting
// the original "file_l:line_l" field so idxpack never has to parse a colon).
ix_fill_funcs(string[] fn, string[] file_l, int[] line_l, int[] cases, string[] lines, int i) {
  while(i < len(lines)) {
    ix_row_fn(fn, file_l, line_l, cases, lines[i]);
    i = i + 1;
  }
} return void;
([], [], [], [], [], 0):([], [], [], [], [])
([], [], [], [], ["a|b.id|3|2"], 0):(["a"], ["b.id"], [3], [2], ["a|b.id|3|2"])

ix_row_fn(string[] fn, string[] file_l, int[] line_l, int[] cases, string fn_row_text) {
  string[] parts = string_split(fn_row_text, "|");
  int line_n = to_int(parts[2]);
  int cases_n = to_int(parts[3]);
} chain (string[] fn, string[] file_l, int[] line_l, int[] cases, string fn_row_text) {
  push(fn, parts[0]);
  push(file_l, parts[1]);
  push(line_l, line_n);
} chain (string[] fn, string[] file_l, int[] line_l, int[] cases, string fn_row_text) {
  push(cases, cases_n);
} return void;
([], [], [], [], "a|b.id|3|2"):(["a"], ["b.id"], [3], [2])
(["x"], ["y.id"], [1], [0], "a|b.id|3|2"):(["x", "a"], ["y.id", "b.id"], [1, 3], [0, 2])

// Per-file-bucket function counts -- the counting pass of func_end_line's
// CSR (the same counting-sort shape rev/build.id's rev_counts uses, keyed
// by ix_fbucket instead of a call edge's callee), so finding "the next
// function in this file" never rescans every function in the build.
ix_fg_counts(int num_buckets, int fcount) {
  int[] counts = [];
  int i = 0;
  while(i < num_buckets) {
    push(counts, 0);
    i = i + 1;
  }
} chain (int num_buckets, int fcount) {
  int fi = 0;
  while(fi < fcount) {
    int b = (import ix_fbucket)[fi];
    counts[b] = counts[b] + 1;
    fi = fi + 1;
  }
} return int[] counts;
