// The path named by one "===F:<path>===" marker line: strip the fixed
// 5-character prefix and 3-character suffix idc/tools/idxpack.sh writes
// around every path.
fx_marker_path(string cur) {
  int n = len(cur);
  string mid = str_sub(cur, 5, n - 8);
} return string mid;
("===F:a.id==="):("a.id")
("===F:x/y.id==="):("x/y.id")

// One file's block: its path, and its lines up to (not including) the next
// marker. Returns the index the scan should resume at.
fx_fill_block(string[] paths, string[][] blocks, string[] lines, int i, string cur) {
  string path = fx_marker_path(cur);
  int n = len(lines);
  int body_from = i + 1;
} chain (string[] paths, string[][] blocks, string[] lines, int i, string cur) {
  int j = find_next_file_marker(lines, body_from);
  string[] block = slice_lines(lines, body_from, j);
  push(paths, path);
} chain (string[] paths, string[][] blocks, string[] lines, int i, string cur) {
  push(blocks, block);
} return int j;
([], [], ["===F:a.id===", "x", "y"], 0, "===F:a.id==="):(3)
([], [], ["===F:a.id===", "x", "===F:b.id===", "z"], 0, "===F:a.id==="):(2)

// One body line's export name, registered against `fn_idx` in the export
// hmap and appended to ix_ename/ix_efn -- a line that does not declare an
// export contributes nothing to either.
ix_scan_export_line(string export_src_line, int fn_idx) {
  int p = string_find(export_src_line, "export ");
  int rest_n = len(export_src_line) - p - 7;
  string name = "";
} chain (string export_src_line, int fn_idx) {
  if(p >= 0) {
    string rest = str_sub(export_src_line, p + 7, rest_n);
    string[] parts = string_split(rest, " ");
    name = parts[1];
  }
  if(string_compare(name, "") != 0) {
    hash_map_put((import ix_ekeys), (import ix_evals), (import ix_eused), (import ix_ecnt), name, fn_idx);
    push((import ix_ename), name);
    push((import ix_efn), fn_idx);
  }
} return void;
given ix_export_fixture ("  export int gv = 0;", 0):() then calls hash_map_put:[1] then len((import ix_ename)):(2)
given ix_export_fixture ("plain line", 0):() then calls hash_map_put:[0] then len((import ix_ename)):(1)
