// Walk the FILES section, one marker block at a time.
fx_fill(string[] paths, string[][] blocks, string[] lines, int i) {
  while(i < len(lines)) {
    i = fx_fill_step(paths, blocks, lines, i);
  }
} return void;
([], [], [], 0):([], [], [])
([], [], ["===F:a.id===", "x"], 0):(["a.id"], [["x"]], ["===F:a.id===", "x"])

fx_fill_step(string[] paths, string[][] blocks, string[] lines, int i) {
  string cur = lines[i];
  int is_marker = str_starts(cur, "===F:");
  int ret_i = i + 1;
} chain (string[] paths, string[][] blocks, string[] lines, int i) {
  if(is_marker == 1) {
    ret_i = fx_fill_block(paths, blocks, lines, i, cur);
  }
} return int ret_i;
([], [], ["not a marker"], 0):(1)
([], [], ["===F:a.id===", "x"], 0):(2)

// Every "export TYPE name = ..." line in one function's body, registered
// against its own index in the export hmap ix_init builds once -- so
// find_declaring_fn (analyze/scan/exports.id) never rescans every
// function's body per name it is asked about.
ix_scan_exports_in(string[] body, int fn_idx) {
  int i = 0;
  while(i < len(body)) {
    ix_scan_export_line(body[i], fn_idx);
    i = i + 1;
  }
} return void;
given ix_export_fixture (["export int zz = 1;", "plain line"], 0):() then calls hash_map_put:[1] then len((import ix_ename)):(2)
given ix_test_setup (["a", "b"], 5):() then calls hash_map_put:[0] then len((import ix_ename)):(0)
