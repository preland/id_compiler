// The call graph, as parallel lists the caller passes in explicitly (kept
// as plain parameters, not exports, so these are testable as ordinary list
// mutators -- docs/TESTS.md's `fill` idiom -- and the only place that reads
// them through `(import ...)` is tables.id's ix_init, once).
ix_fill_edges(string[] ecaller, string[] ecallee, string[] ekind, string[] lines, int i) {
  while(i < len(lines)) {
    ix_row_edge(ecaller, ecallee, ekind, lines[i]);
    i = i + 1;
  }
} return void;
([], [], [], [], 0):([], [], [], [])
([], [], [], ["a|b|call"], 0):(["a"], ["b"], ["call"], ["a|b|call"])

ix_row_edge(string[] ecaller, string[] ecallee, string[] ekind, string edge_line) {
  string[] parts = string_split(edge_line, "|");
  push(ecaller, parts[0]);
  push(ecallee, parts[1]);
} chain (string[] ecaller, string[] ecallee, string[] ekind, string edge_line) {
  push(ekind, parts[2]);
} return void;
([], [], [], "a|b|call"):(["a"], ["b"], ["call"])
(["x"], ["y"], ["z"], "c|d|value"):(["x", "c"], ["y", "d"], ["z", "value"])

// Second CSR pass for func_end_line's file-grouping: place each function's
// own index into its file bucket's slot range (ix_fg_counts's prefix sum,
// via rev/build.id's rev_prefix) -- the same CSR-fill shape rev_flat uses,
// keyed by file bucket instead of call-edge callee.
ix_fg_fill(int[] fgstart, int fcount) {
  int[] flat = [];
  list_fill(flat, fcount, 0);
  int[] cursor = list_copy(fgstart);
} chain (int[] fgstart, int fcount) {
  int fi = 0;
  while(fi < fcount) {
    ix_fg_place(flat, cursor, fi);
    fi = fi + 1;
  }
} return int[] flat;
given rev_edge_fixture ([0, 2], 2):([0, 1])
given ix_test_setup ([0, 1], 1):([0])
