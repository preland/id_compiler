// Cutting source text into identifiers, for the slice of idstd's conf.id that the
// kernel's library reads (slice.id).

// 1 when c is a character an identifier is made of: a letter, a digit or an underscore.
kb_ident(int c) {
  int ok = 0;
  if (character_is_alphanumeric(c) == 1 || c == 95) {
    ok = 1;
  }
} return int ok;
(97):(1)
(95):(1)
(46):(0)

// The index just past the identifier that starts at at, or at itself when none does.
kb_word_end(string text, int at) {
  int end = at;
  while (end < len(text) && kb_ident(character_code_at(text, end)) == 1) {
    end = end + 1;
  }
} return int end;
("ab_1 c", 0):(4)
("ab_1 c", 4):(4)

// One step along a line from at: the identifier that starts there is pushed onto
// found, and the answer is where the next step starts (one on when nothing started).
kb_word_step(string line, int at, string[] found) {
  int end = kb_word_end(line, at);
  if (end > at) {
    push(found, str_sub(line, at, end - at));
  }
  int next = end + (end == at);
} return int next;
("ab c", 0, []):(2)
("ab c", 2, []):(3)
