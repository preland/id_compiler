// The steps in order, and running them until one fails.

// The command that has to run first, as the line exec_run takes: the runtime, which
// is the one thing built without a library. The library staging (kb_stage) comes
// after it and the rest (kb_plan_img) after that.
kb_plan_rt(string root) {
  string[] steps = [];
  push(steps, kb_idc(root, root + "/runtime", "--no-std\n--runtime\n--allow-untested", root + "/build/runtime.o"));
} return string[] steps;
("/r"):(["/r/bin/idc\n/r/runtime\n--no-std\n--runtime\n--allow-untested\n--triple\nx86_64-unknown-none\n-o\n/r/build/runtime.o\n"])
("/idc"):(["/idc/bin/idc\n/idc/runtime\n--no-std\n--runtime\n--allow-untested\n--triple\nx86_64-unknown-none\n-o\n/idc/build/runtime.o\n"])

// Runs each command of plan in order and stops at the first that fails, its
// output shown as it would have been from a shell. Answers 0 when every step
// passed, otherwise the failing step's exit status -- or 1 where that was not a
// status (a command that could not start, or ran past kb_ms).
kb_steps(string[] plan) {
  int[] none = [];
  int rc = 0;
  int i = 0;
} chain (string[] plan) {
  while (i < len(plan) && rc == 0) {
    rc = exec_show(plan[i], none, 0, (import kb_ms));
    i = i + 1;
  }
  if (rc < 0) {
    rc = 1;
  }
} return int rc;
(["true\n", "true\n"]):(0)
(["true\n", "sh\n-c\nexit 3\n", "true\n"]):(3)

// The line kbuild ends on: "built OUT (N bytes)", with OUT as the caller wrote it.
kb_report(string out, int size) {
  string line = "built " + out + " (" + size + " bytes)";
} return string line;
("build/kernel.elf", 1234):("built build/kernel.elf (1234 bytes)")
("/x/k.elf", 0):("built /x/k.elf (0 bytes)")
