// Printing the screen: every line up to the last one with text, blank lines
// between them kept, and one empty line for a blank screen.

fb_print(string[] strs) {
  int last = fb_last(strs);
  fb_emit(strs, last);
} return void;
(["a", "", "b", ""]):(["a", "", "b", ""]) then prints:("a\n\nb\n")
(["", ""]):(["", ""]) then prints:("\n")
(["a", ""]):(["a", ""])
([]):([])

fb_emit(string[] strs, int last) {
  int i = 0;
  while(i <= last) {
    print(strs[i]);
    i = i + 1;
  }
  if(last < 0) {
    print("");
  }
} return void;
(["a", "b"], 1):(["a", "b"], 1) then prints:("a\nb\n")
(["a", "b"], 0):(["a", "b"], 0) then prints:("a\n")
(["a"], 0):(["a"], 0)
([""], -1):([""], -1)
