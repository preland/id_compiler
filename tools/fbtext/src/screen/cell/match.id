// Which glyph a cell is.

// A cell with no pixel lit is a space without a search.
fb_match(int[] rows, int[] font) {
  int sum = lst_sum(rows);
  int ch = 32;
  if(sum > 0) {
    ch = fb_best(rows, font);
  }
} return int ch;
([0, 0], [0, 0, 2, 1]):(32)
([2, 1], [0, 0, 2, 1]):(33)

// bs is [best code so far, its distance].
fb_best(int[] rows, int[] font) {
  int[] bs = [32, (import fb_far)];
  fb_scan(bs, rows, font);
  int best = bs[0];
} return int best;
([2, 1], [0, 0, 2, 1]):(33)
([3], [1, 2]):(32)

// Every glyph in code-point order. A glyph is as many font bytes as the cell
// has rows.
fb_scan(int[] bs, int[] rows, int[] font) {
  int gi = 0;
  while(gi * len(rows) < len(font)) {
    fb_try(bs, rows, font, gi);
    gi = gi + 1;
  }
} return void;
([32, 1000000000], [3], [1, 2]):([32, 1], [3], [1, 2])
([32, 1000000000], [2], [1, 2]):([33, 0], [2], [1, 2])
