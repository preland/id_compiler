// Header numbers, one at a time, onto the end of hd.

ppm_take(int[] hd, int[] d, int[] pos) {
  int v = ppm_num(d, pos);
  push(hd, v);
} return void;
([], [32, 55, 32], [0]):([7], [32, 55, 32], [2])
([1], [49, 50], [0]):([1, 12], [49, 50], [2])

ppm_take2(int[] hd, int[] d, int[] pos) {
  ppm_take(hd, d, pos);
  ppm_take(hd, d, pos);
} return void;
([], [49, 32, 50], [0]):([1, 2], [49, 32, 50], [3])
([9], [32, 51, 10, 52, 10], [0]):([9, 3, 4], [32, 51, 10, 52, 10], [4])

// A number may be preceded by whitespace and by comments, which run from '#'
// to the end of the line.
ppm_num(int[] d, int[] pos) {
  ppm_skip(d, pos);
  int v = ppm_digits(d, pos);
} return int v;
([32, 32, 52, 50], [0]):(42)
([35, 10, 55], [0]):(7)
