// A call through a function value: the slot holds the function's id.
vm_calli(int pc, int fp, int d, int a, int apos, int csz) {
  int fid = (import ex_vals)[fp + a];
  int ent = vm_call(pc, fp, d, fid, apos, csz);
} return int ent;
