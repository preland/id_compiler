// A cell of function fid's row in the function table.
vm_fn(int fid, int col) {
  int v = (import ex_ft)[fid * (import ft_n) + col];
} return int v;
given vb_boot given tf_fn(10, 1, 7, 2, 4) (0, 2):(7)
given vb_boot given tf_fn(10, 1, 7, 2, 4) given tf_fn(20, 3, 9, 5, 6) (1, 1):(3)

// A call: the callee's frame starts csz slots above the caller's, which is
// where the caller's own slots (and its constants) end. Arguments are copied
// in as its first slots, its constants after, and its pc is the next one.
vm_call(int pc, int fp, int d, int fid, int apos, int csz) {
  int nfp = fp + csz;
  int sz = vm_fn(fid, (import ft_sz));
  vm_room(nfp + sz);
} chain (int pc, int fp, int d, int fid, int apos, int csz) {
  int np = vm_fn(fid, (import ft_np));
  vm_args(fp, nfp, apos, np);
  int k0 = vm_fn(fid, (import ft_k0));
} chain (int pc, int fp, int d, int fid, int apos, int csz) {
  int k1 = vm_fn(fid, (import ft_k1));
  vm_consts(nfp, k0, k1);
  vm_frame(pc + (import i_n), fp, d, nfp);
} chain (int pc, int fp, int d, int fid, int apos, int csz) {
  int ent = vm_fn(fid, (import ft_pc));
} return int ent;
