vm_give(int fp, int to, int a) {
  word[] vals = (import ex_vals);
  float[] fvals = (import ex_fvals);
  vals[to] = vals[fp + a];
} chain (int fp, int to, int a) {
  fvals[to] = fvals[fp + a];
} return void;
