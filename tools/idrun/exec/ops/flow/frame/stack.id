// Take the frame the callee returns to off the call stack, give the caller
// the value (both views of the slot: the callee's type is not known here),
// and make the caller's frame current again.
vm_pop(int fp, int a) {
  int[] cs = (import ex_cs);
  int d = pop(cs);
  int cfp = pop(cs);
} chain (int fp, int a) {
  int rpc = pop(cs);
  if (d >= 0) {
    vm_give(fp, cfp + d, a);
  }
  vm_back(cfp);
} return int rpc;
