// Constant-pool rows k0 up to k1 into the new frame.
vm_consts(int nfp, int k0, int k1) {
  while (k0 < k1) {
    vm_const(nfp, k0);
    k0 = k0 + 1;
  }
} return void;
given vb_boot given ld_kpush(2, 5, 0.0) given ld_kpush(4, 6, 1.5) (0, 0, 2):() then tf_v8:([0, 0, 5, 0, 6, 0, 0, 0]) then tf_f8:([0.0, 0.0, 0.0, 0.0, 1.5, 0.0, 0.0, 0.0])
given vb_boot given ld_kpush(2, 5, 0.0) given ld_kpush(4, 6, 1.5) (2, 1, 2):() then tf_v8:([0, 0, 0, 0, 0, 0, 6, 0])

