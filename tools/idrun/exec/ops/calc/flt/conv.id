// binary32 pair), which cross between the word and float register files.
vm_bitsop(int op, int fp, int d, int a) {
  word[] vals = (import ex_vals);
  float[] fvals = (import ex_fvals);
  if (op == (import o_bitsf)) {
    vals[fp + d] = bits_of_float(fvals[fp + a]);
  }
} chain (int op, int fp, int d, int a) {
  if (op == (import o_bits32f)) {
    vals[fp + d] = bits32_of_float(fvals[fp + a]);
  }
  if (op == (import o_fbits)) {
    fvals[fp + d] = float_of_bits(vals[fp + a]);
  }
  if (op == (import o_f32bits)) {
    fvals[fp + d] = float_of_bits32(vals[fp + a]);
  }
} return void;
