// Float arithmetic. A float slot is read from ex_fvals, never ex_vals.
vm_fadd(int fp, int d, int a, int b) {
  float[] fvals = (import ex_fvals);
  fvals[fp + d] = fvals[fp + a] + fvals[fp + b];
} return void;
given vb_boot given tf_setf(1, 1.5) given tf_setf(2, 2.25) (0, 3, 1, 2):() then (import ex_fvals)[3]:(3.75)
given vb_boot given tf_setf(2, 0.5) given tf_setf(1, 4.0) (1, 2, 1, 0):() then (import ex_fvals)[3]:(4.5)

vm_fsub(int fp, int d, int a, int b) {
  float[] fvals = (import ex_fvals);
  fvals[fp + d] = fvals[fp + a] - fvals[fp + b];
} return void;
given vb_boot given tf_setf(1, 1.5) given tf_setf(2, 2.25) (0, 3, 1, 2):() then (import ex_fvals)[3]:(-0.75)
given vb_boot given tf_setf(2, 0.5) given tf_setf(1, 4.0) (1, 2, 1, 0):() then (import ex_fvals)[3]:(-3.5)

vm_fmul(int fp, int d, int a, int b) {
  float[] fvals = (import ex_fvals);
  fvals[fp + d] = fvals[fp + a] * fvals[fp + b];
} return void;
given vb_boot given tf_setf(1, 2.5) given tf_setf(2, 4.0) (0, 3, 1, 2):() then (import ex_fvals)[3]:(10.0)
given vb_boot given tf_setf(2, 0.5) given tf_setf(1, 4.0) (1, 2, 1, 0):() then (import ex_fvals)[3]:(2.0)
