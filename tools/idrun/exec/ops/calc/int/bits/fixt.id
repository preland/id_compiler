// Fixtures for the exported-variable cases: write a global's cell, growing the
// table to reach it, and read cell 2 back.
tf_gset(int g, word wv) {
  word[] gv = (import ex_gv);
  while (len(gv) <= g) {
    push(gv, 0);
  }
  gv[g] = wv;
} return void;
given vb_boot (2, 5):() then (import ex_gv)[2]:(5)
given vb_boot (3, 8):() then (import ex_gv)[2]:(0)

tf_gsetf(int g, float f) {
  float[] gf = (import ex_gf);
  while (len(gf) <= g) {
    push(gf, 0.0);
  }
  gf[g] = f;
} return void;
given vb_boot (2, 1.5):() then (import ex_gf)[2]:(1.5)
given vb_boot (4, 2.5):() then (import ex_gf)[2]:(0.0)

