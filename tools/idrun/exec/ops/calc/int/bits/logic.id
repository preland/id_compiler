// Bitwise operations are the same at 32 and 64 bits: both operands are
// sign-extended, and so is the result.
vm_and(int fp, int d, int a, int b) {
  word[] vals = (import ex_vals);
  vals[fp + d] = vals[fp + a] & vals[fp + b];
} return void;
