// 32-bit arithmetic. The slots hold a sign-extended word, so the low 32 bits
// of the 64-bit result are the 32-bit result: narrowing into an int wraps,
// and storing the int back widens it again.
vm_add32(int fp, int d, int a, int b) {
  word[] vals = (import ex_vals);
  int r = vals[fp + a] + vals[fp + b];
  vals[fp + d] = r;
} return void;
given vb_boot given tf_set(1, 2147483647) given tf_set(2, 1) (0, 3, 1, 2):() then tf_v3:(-2147483648)
given vb_boot given tf_set(2, 5) given tf_set(1, 7) (1, 2, 1, 0):() then tf_v3:(12)

vm_sub32(int fp, int d, int a, int b) {
  word[] vals = (import ex_vals);
  int r = vals[fp + a] - vals[fp + b];
  vals[fp + d] = r;
} return void;
