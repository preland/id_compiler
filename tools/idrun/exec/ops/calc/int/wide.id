// 64-bit arithmetic: a word wraps on its own.
vm_add64(int fp, int d, int a, int b) {
  word[] vals = (import ex_vals);
  vals[fp + d] = vals[fp + a] + vals[fp + b];
} return void;
given vb_boot given tf_set(1, 5000000000) given tf_set(2, 1) (0, 3, 1, 2):() then (import ex_vals)[3]:(5000000001)
given vb_boot given tf_set(2, 5) given tf_set(1, 7) (1, 2, 1, 0):() then (import ex_vals)[3]:(12)

vm_sub64(int fp, int d, int a, int b) {
  word[] vals = (import ex_vals);
  vals[fp + d] = vals[fp + a] - vals[fp + b];
} return void;
given vb_boot given tf_set(1, 5000000000) given tf_set(2, 1) (0, 3, 1, 2):() then (import ex_vals)[3]:(4999999999)
given vb_boot given tf_set(2, 5) given tf_set(1, 7) (1, 2, 1, 0):() then (import ex_vals)[3]:(-2)

vm_mul64(int fp, int d, int a, int b) {
  word[] vals = (import ex_vals);
  vals[fp + d] = vals[fp + a] * vals[fp + b];
} return void;
given vb_boot given tf_set(1, 4294967296) given tf_set(2, 3) (0, 3, 1, 2):() then (import ex_vals)[3]:(12884901888)
given vb_boot given tf_set(2, 6) given tf_set(1, -7) (1, 2, 1, 0):() then (import ex_vals)[3]:(-42)
