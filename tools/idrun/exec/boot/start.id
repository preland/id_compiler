// Test check: the whole argument-position list -- how many entries, then each.
// ld_call and ld_calld read where the arguments of a call end, so a check of
// one entry alone would repeat their own read.
vm_argp_text() {
  string vm_argp_t = lst_text((import ex_argp), ",");
  string vm_argp_s = "args " + len((import ex_argp)) + ":" + vm_argp_t;
} return string vm_argp_s;
