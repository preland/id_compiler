// List 0 and string 0 stand for an exported variable whose declaring function
// has not run, which is what a zero cell holds. A list operation on list 0 is
// the trap the compiled runtime raises on a null list.
vb_nil() {
  word[] nil = [];
  push((import ex_lists), nil);
  push((import ex_llock), 0);
} return void;
