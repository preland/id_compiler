// Make the value stack at least n slots long, in both of its views. A frame
// is a window of it, so a call that would reach past the end asks for room
// first (ops/flow/call.id).
vm_room(int n) {
  word[] vals = (import ex_vals);
  float[] fvals = (import ex_fvals);
  while (len(vals) < n) {
    push(vals, 0);
    push(fvals, 0.0);
  }
} return void;
given vb_boot (5000):() then len((import ex_vals)):(5000) then len((import ex_fvals)):(5000)
given vb_boot (10):() then len((import ex_vals)):(4096) then len((import ex_fvals)):(4096)

// A trap of this interpreter's own: the same line the compiled program's
// runtime writes, then the run stops with status 1.
vm_trap(string msg) {
  int[] rg = (import ex_rg);
  eprint("id: " + msg);
  rg[(import r_halt)] = 1;
} chain (string msg) {
  rg[(import r_status)] = 1;
} return void;
given vb_boot ("boom"):() then eprints:("id: boom\n") then (import ex_rg):([0, 1, 1])
given vb_boot ("x y"):() then eprints:("id: x y\n") then (import ex_rg):([0, 1, 1])


// Test check: the whole code list -- how many cells, then each one, five to an
// instruction. The loader's writers (ld_link, ld_patch, ld_call) read the list's
// length to know where the next instruction goes, so a check of one cell
// alone would repeat their own read.
vm_cd_text() {
  string vm_cd_t = list_text((import ex_cd), ",");
  string vm_cd_s = "code " + len((import ex_cd)) + ":" + vm_cd_t;
} return string vm_cd_s;
given vb_boot ():("code 0:")
given vb_boot given ld_emit(1, 3, 1, 2, 0) ():("code 5:1,3,1,2,0")
