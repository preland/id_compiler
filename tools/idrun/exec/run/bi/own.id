// The helpers from id_str_sub on that are not function values (conf.id):
// id_concat_f is a concatenation whatever its freshness mask says, id_str_dup
// answers the string it was given, and the three frees answer nothing and touch
// nothing. Strings and lists live for the whole run, so a program that frees
// what it should not still reads what it wrote.
vm_bg(int id, word wa, word wb, word wc) {
  word wr = 0;
  if (id == (import b_str_sub)) {
    wr = vm_b_str_sub(wa, wb, wc);
  } else if (id == (import b_concat_f)) {
    wr = vm_b_concat(wa, wb);
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_str_dup)) {
    wr = wa;
  } else if (id == (import b_clo_setl)) {
    wr = vm_bk((import b_clo_set), wa, wb, wc);
  }
} return word wr;
