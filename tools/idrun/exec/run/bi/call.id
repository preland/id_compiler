// A call to a runtime helper. The loader pads every such call to three
// argument slots, so all three are read; a helper takes the ones it needs.
// The helper's answer lands in d unless d is -1, and a trap it raised ends
// the run by turning the next pc into -1.
vm_bcall(int fp, int d, int bid, int apos, int nx) {
  int[] ap = (import ex_argp);
  word[] vals = (import ex_vals);
  word wa = vals[fp + ap[apos]];
} chain (int fp, int d, int bid, int apos, int nx) {
  word wb = vals[fp + ap[apos + 1]];
  word wc = vals[fp + ap[apos + 2]];
  word wr = vm_bi(bid, wa, wb, wc);
} chain (int fp, int d, int bid, int apos, int nx) {
  if (bid == (import b_list_lit)) {
    wr = vm_b_list_lit(fp, apos);
  }
  if (d >= 0) {
    vals[fp + d] = wr;
  }
  if ((import ex_rg)[(import r_halt)] != 0) {
    nx = 0 - 1;
  }
} return int nx;
