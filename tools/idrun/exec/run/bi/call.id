// Which group of helpers id belongs to (conf.id numbers them so a group is a
// range), then that group's own chain.
vm_bi(int id, word wa, word wb, word wc) {
  word wr = 0;
  if (id < (import b_strs_end)) {
    wr = vm_bs(id, wa, wb, wc);
    return wr;
  }
  if (id < (import b_lists_end)) {
    wr = vm_bl(id, wa, wb, wc);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id < (import b_io_end)) {
    wr = vm_bc(id, wa, wb, wc);
    return wr;
  }
  if (id < (import b_arith_end)) {
    wr = vm_ba(id, wa, wb, wc);
    return wr;
  }
  if (id >= (import b_free0)) {
    wr = vm_bf(id, wa, wb, wc);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id >= (import b_peek8s)) {
    wr = vm_bn(id, wa, wb, wc);
    return wr;
  }
  wr = vm_bm(id, wa, wb, wc);
} return word wr;
