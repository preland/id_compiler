// The function-value helpers (conf.id, b_clo0 and after), by what they do to the
// object, which is a list (cell.id's vm_k_make): make a plain function's, make a
// closure's, store a captured cell, copy a list, and read the plain function,
// the adapter or a captured cell.
vm_bk(int id, word wa, word wb, word wc) {
  word wr = 0;
  int hl = wa;
  int ci = wb + 3;
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_fn_plain)) {
    wr = vm_k_plain(wa, wb);
    return wr;
  }
  if (id == (import b_clo_make)) {
    wr = vm_k_make(wa, wb, 0);
    return wr;
  }
  if (id == (import b_clo_set)) {
    word[] l = (import ex_lists)[hl];
    l[ci] = wc;
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_clo_copy)) {
    wr = vm_k_copy(wa);
    return wr;
  }
  if (id == (import b_clo_cell)) {
    wr = vm_cell(hl, ci);
    return wr;
  }
  if (id == (import b_clo_fn)) {
    wr = vm_cell(hl, 0);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  wr = vm_cell(hl, 1);
} return word wr;
