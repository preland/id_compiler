// id_fn_plain: the object of a plain function, made once for each adapter (wa)
// and kept in ex_fo, so every use of a function is one object, as in the other
// runtimes. wb is the function itself.
vm_k_plain(word wa, word wb) {
  int[] fo = (import ex_fo);
  int h = 0 - 1;
  int i = 0;
} chain (word wa, word wb) {
  while (i < len(fo) && h < 0) {
    word[] o = (import ex_lists)[fo[i]];
    if (o[0] == wa) {
      h = fo[i];
    }
    i = i + 1;
  }
  if (h < 0) {
    h = vm_k_make(wa, 0, wb);
    push(fo, h);
  }
} return int h;
