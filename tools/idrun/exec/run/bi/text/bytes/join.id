// Joining and cutting bytes. append copies the source's cells to the end of the
// destination (a bytes appended to itself doubles); sub is a new bytes of n
// cells from i, and a span past either end is a trap.
vm_b_bytes_append(word wa, word wb) {
  int hd = wa;
  int hs = wb;
  int ok = vm_live(hd);
} chain (word wa, word wb) {
  if (ok == 1) {
    ok = vm_live(hs);
  }
  if (ok == 1) {
    vm_bcopy(hd, hs, 0, len((import ex_lists)[hs]));
  }
} return void;
