given vb_boot given tf_lnew given vm_b_list_push(1, 1) given vm_b_list_push(1, 2) (1, 1):() then (import ex_lists):([[], [1, 2, 1, 2]])

vm_b_bytes_sub(word wa, word wb, word wc) {
  int hl = wa;
  int ok = vm_live(hl);
  int bl = len((import ex_lists)[hl]);
} chain (word wa, word wb, word wc) {
  int i = wb;
  int n = wc;
  int h = vm_lnew();
} chain (word wa, word wb, word wc) {
  if (ok == 1 && (wb < 0 || wc < 0 || (wc > 0 && wb + wc > bl))) {
    vm_bspan(wb, wc, bl);
    ok = 0;
  }
  if (ok == 1) {
    vm_bcopy(h, hl, i, n);
  }
} return int h;
