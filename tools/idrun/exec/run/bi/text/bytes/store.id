// A bytes copied into freshly allocated store, and the address; 0 for the null
// bytes after its trap. And id_list_lit, a call with n then n cells, which is
// the one helper that reads more than three argument slots, so it takes the
// frame and the argument position and not three words.
vm_b_memory_of_bytes(word wa) {
  int hl = wa;
  word ad = 0;
  int i = 0;
} chain (word wa) {
  word[] l = (import ex_lists)[hl];
  if (vm_live(hl) == 1) {
    ad = alloc(len(l));
  }
  while (i < len(l)) {
    poke8(ad + i, l[i]);
    i = i + 1;
  }
} return word ad;
