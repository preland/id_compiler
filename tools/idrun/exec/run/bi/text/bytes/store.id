vm_b_list_lit(int fp, int apos) {
  word[] vals = (import ex_vals);
  int n = vals[fp + (import ex_argp)[apos]];
  int h = vm_lnew();
} chain (int fp, int apos) {
  word[] l = (import ex_lists)[h];
  int i = 0;
  while (i < n) {
    push(l, vals[fp + (import ex_argp)[apos + 1 + i]]);
    i = i + 1;
  }
} return int h;
