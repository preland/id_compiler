// that asks for it again.
tf_fo(word wa, word wr) {
  int h = vm_k_plain(wa, wr);
} return void;
given vb_boot (7, 3):() then (import ex_fo):([1])
given vb_boot (8, 4):() then (import ex_lists):([[], [8, 4, 0]])

// A wall clock has no literal to compare against, so a case stamps ticks()
// just before the call under test, and expects the same millisecond back.
tf_clock() {
  export word tf_t0 = ticks();
} return void;
():() then tf_clock_ok:(1)
():() then tf_clock_ok:(1) then prints:("")

tf_clock_ok() {
  int ok = ticks() >= (import tf_t0);
} return int ok;
given tf_clock ():(1)
given tf_clock ():(1) then prints:("")
