// A remainder, and the two shifts: a count past the width is zero and a
// negative count traps, both as the host's own operators have it.
vm_b_smod(word wa, word wb) {
  word wr = wa % wb;
} return word wr;
(5000000001, 10):(1)
(-9, 4):(-1)

vm_b_shl(word wa, word wb) {
  word wr = wa << wb;
} return word wr;
(1, 31):(2147483648)
(1, 70):(0)

vm_b_sar(word wa, word wb) {
  word wr = wa >> wb;
} return word wr;
(-8, 1):(-4)
(4, 70):(0)
