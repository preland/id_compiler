// The arithmetic helpers the IR calls instead of an instruction, because each
// has a defined answer for the inputs C leaves undefined. The host's own
// operators have exactly those answers, so they are used as they stand.
vm_b_idiv(word wa, word wb) {
  int x = wa;
  int y = wb;
  int r = x / y;
} return int r;
(7, 2):(3)
(-7, 2):(-3)

vm_b_imod(word wa, word wb) {
  int x = wa;
  int y = wb;
  int r = x % y;
} return int r;
(7, 3):(1)
(-7, 2):(-1)

vm_b_sdiv(word wa, word wb) {
  word wr = wa / wb;
} return word wr;
(5000000000, 2):(2500000000)
(-9, 2):(-4)
