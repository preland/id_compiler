// The arithmetic helpers, by id. A remainder and the two shifts take the host's own operators: a count past
// the width is zero and a negative count traps, both as they have it.
vm_ba(int id, word wa, word wb, word wc) {
  word wr = 0;
  if (id == (import b_idiv)) {
    wr = vm_b_idiv(wa, wb);
    return wr;
  }
  if (id == (import b_imod)) {
    wr = vm_b_imod(wa, wb);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_sdiv)) {
    wr = wa / wb;

    return wr;
  }
  if (id == (import b_smod)) {
    wr = wa % wb;

    return wr;
  }
  if (id == (import b_shl)) {
    wr = wa << wb;

    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_sar)) {
    wr = wa >> wb;

    return wr;
  }
  if (id == (import b_ushr)) {
    wr = ushr(wa, wb);
    return wr;
  }
  if (id == (import b_udiv)) {
    wr = udiv(wa, wb);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_umod)) {
    wr = umod(wa, wb);
    return wr;
  }
  wr = ult(wa, wb);
} return word wr;
