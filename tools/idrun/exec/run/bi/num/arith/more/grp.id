// The arithmetic helpers, by id.
vm_ba(int id, word wa, word wb, word wc) {
  word wr = 0;
  if (id == (import b_idiv)) {
    wr = vm_b_idiv(wa, wb);
    return wr;
  }
  if (id == (import b_imod)) {
    wr = vm_b_imod(wa, wb);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_sdiv)) {
    wr = vm_b_sdiv(wa, wb);
    return wr;
  }
  if (id == (import b_smod)) {
    wr = vm_b_smod(wa, wb);
    return wr;
  }
  if (id == (import b_shl)) {
    wr = vm_b_shl(wa, wb);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_sar)) {
    wr = vm_b_sar(wa, wb);
    return wr;
  }
  if (id == (import b_ushr)) {
    wr = vm_b_ushr(wa, wb);
    return wr;
  }
  if (id == (import b_udiv)) {
    wr = vm_b_udiv(wa, wb);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_umod)) {
    wr = vm_b_umod(wa, wb);
    return wr;
  }
  wr = vm_b_ult(wa, wb);
} return word wr;
