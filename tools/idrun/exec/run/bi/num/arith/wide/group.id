// The helpers after id_clo_free (conf.id), which carry the integer builtins the
// compiler lowers to a call: the high half of a product, rotates and the
// overflow-trapping arithmetic, each in the 64-bit form and, where the width
// of the operand matters, a 32-bit form. The host performs them with the same
// builtins, so a trap is the host's own `id: integer overflow`.
vm_bw(int id, word wa, word wb, word wc) {
  word wr = 0;
  if (id == (import b_umul_hi)) {
    wr = umul_hi(wa, wb);
  }
  if (id == (import b_rotl)) {
    wr = rotl(wa, wb);
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_rotl32)) {
    wr = vm_b_rotl32(wa, wb);
  }
  if (id == (import b_uword_of_int)) {
    wr = vm_b_uword_of_int(wa);
  }
  if (id == (import b_add_checked)) {
    wr = add_checked(wa, wb);
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_add_checked32)) {
    wr = vm_b_add32(wa, wb);
  }
  if (id == (import b_sub_checked)) {
    wr = sub_checked(wa, wb);
  }
  if (id == (import b_sub_checked32)) {
    wr = vm_b_sub32(wa, wb);
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_mul_checked)) {
    wr = mul_checked(wa, wb);
  }
  if (id == (import b_mul_checked32)) {
    wr = vm_b_mul32(wa, wb);
  }
  if (id >= (import b_bytes0)) {
    wr = vm_bb(id, wa, wb, wc);
  }
} return word wr;
