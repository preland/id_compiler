// Eight bytes in the flat store holding v, their address exported as tf_addr,
// and the first of them read back as a word or a byte.
tf_mem8(word wv) {
  word ad = alloc(8);
  poke64(ad, wv);
  export word tf_addr = ad;
} return void;
