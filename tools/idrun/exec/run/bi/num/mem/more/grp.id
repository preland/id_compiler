// The store helpers, by id. The flat store: the program's alloc, peek and poke go straight to the
// host's, so its addresses, sizes and out-of-range trap are the host's.
vm_bm(int id, word wa, word wb, word wc) {
  word wr = 0;
  if (id == (import b_mem_alloc)) {
    wr = alloc(wa);
    return wr;
  }
  if (id == (import b_mem_size)) {
    wr = store_size();
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_peek8)) {
    wr = peek8(wa);
    return wr;
  }
  if (id == (import b_peek16)) {
    wr = peek16(wa);
    return wr;
  }
  if (id == (import b_peek32)) {
    wr = peek32(wa);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_peek64)) {
    wr = peek64(wa);
    return wr;
  }
  if (id == (import b_poke8)) {
    poke8(wa, wb);
    return wr;
  }
  if (id == (import b_poke16)) {
    poke16(wa, wb);
    return wr;
  }
} chain (int id, word wa, word wb, word wc) {
  if (id == (import b_poke32)) {
    poke32(wa, wb);
    return wr;
  }
  poke64(wa, wb);
} return word wr;
