// Make the program's first frame and answer the pc to start at. The frame is
// main's: its two parameters (argc and a list of the program's arguments)
// are the first two slots, then its constants like any other call's.
vm_start(int fid, string[] pargs) {
  int hl = vm_lnew();
  vm_pushargs(hl, pargs);
  word[] vals = (import ex_vals);
} chain (int fid, string[] pargs) {
  vals[0] = len(pargs);
  vals[1] = hl;
  vm_consts(0, vm_fn(fid, (import ft_k0)), vm_fn(fid, (import ft_k1)));
} chain (int fid, string[] pargs) {
  int pc = vm_fn(fid, (import ft_pc));
} return int pc;
