// Run from pc until something returns -1: main returning, or a trap. The
// frame pointer is read every instruction because a call or return moves it.
vm_run(int pc) {
  while (pc >= 0) {
    int fp = (import ex_rg)[(import r_fp)];
    pc = vm_step(pc, fp);
  }
} return int pc;
