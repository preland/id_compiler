// Test check: the whole register file -- how many registers, then each -- the
// state vm_run's loop leaves behind. The loop reads the frame pointer from it
// on every instruction, so a check of one register alone would repeat part of
// its own read.
vm_rg_text() {
  string vm_rg_t = list_text((import ex_rg), ",");
  string vm_rg_s = "regs " + len((import ex_rg)) + ":" + vm_rg_t;
} return string vm_rg_s;
