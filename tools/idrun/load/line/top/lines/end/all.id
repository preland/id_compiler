// Read the whole text: set it, read every line, finish.
ld_all(int[] bytes) {
  ld_start(bytes);
  ld_lines();
  ld_finish();
} return void;
given lb_boot given vb_boot ([98, 48, 58, 10, 32, 32, 114, 101, 116, 32, 118, 111, 105, 100, 10]):() then tf_cd:([7, 0, 0, 0, 0]) then tf_blk:([0])
given lb_boot given vb_boot ([]):() then tf_cd:([])

ld_start(int[] bytes) {
  export int[] ld_b = bytes;
} return void;
given lb_boot ([97]):() then ld_at:(97)
given lb_boot ([]):() then ld_at:(-1)

// With every line read: branches get their pcs, and a call to a function the
// text never defined is reported.
ld_finish() {
  ld_link();
  ld_undef();
} return void;
given tf_ld("") given ld_blkset(1, 15) given ld_emit(4, 0, 0, 0, 1) ():() then tf_cd:([4, 0, 0, 0, 15])
