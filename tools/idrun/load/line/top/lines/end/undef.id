// A function that was named and never defined is a native, or from a library
// idrun does not read. Calling it would jump to nowhere, so it is an error
// before anything runs.
ld_undef() {
  int i = 0;
  while (i < len((import ld_fn))) {
    ld_undef1(i);
    i = i + 1;
  }
} return void;
given tf_ld("") given tf_get("f", "id_a") given tf_get("f", "id_b") ():() then eprints:("idrun: 'id_a' is called but not defined: it is a native or comes from the standard library, which idrun cannot run yet (docs/INTERPRETER.md, milestone 2); compile this program with idc\nidrun: 'id_b' is called but not defined: it is a native or comes from the standard library, which idrun cannot run yet (docs/INTERPRETER.md, milestone 2); compile this program with idc\n")
given tf_ld("") given tf_get("f", "id_a") ():() then eprints:("idrun: 'id_a' is called but not defined: it is a native or comes from the standard library, which idrun cannot run yet (docs/INTERPRETER.md, milestone 2); compile this program with idc\n")
given tf_ld("") ():() then eprints:("")

ld_undef1(int i) {
  if (vm_fn(i, (import ft_pc)) < 0) {
    ld_err("'" + (import ld_fn)[i] + "' is called but not defined: it is a native or comes from the standard library, which idrun cannot run yet (docs/INTERPRETER.md, milestone 2); compile this program with idc");
  }
} return void;
given tf_ld("") given tf_get("f", "id_a") (0):() then eprints:("idrun: 'id_a' is called but not defined: it is a native or comes from the standard library, which idrun cannot run yet (docs/INTERPRETER.md, milestone 2); compile this program with idc\n")
given tf_ld("") given tf_get("f", "id_a") given tf_get("f", "id_b") (1):() then eprints:("idrun: 'id_b' is called but not defined: it is a native or comes from the standard library, which idrun cannot run yet (docs/INTERPRETER.md, milestone 2); compile this program with idc\n")
given tf_ld("") given tf_get("f", "id_a") given ld_ftset(0, 0, 5) (0):() then eprints:("")
