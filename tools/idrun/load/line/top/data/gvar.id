// The alias line of a string constant, `alias i8, getelementptr inbounds (i8, ptr @other, i64 8)`: the
// name is the bytes of @other, past the length in front of them, so it is given the same text.
ld_galias(int h) {
  ld_to(64);
  ld_adv(1);
  string tn = ld_word();
} chain (int h) {
  string[] ts = (import ex_strs);
  int hd = ld_get("s", tn);
  ts[h] = ts[hd];
} return void;
