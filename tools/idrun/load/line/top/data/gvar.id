// The initial value: a float, a @name (a string constant), or an integer;
// null stays the zero the global started as.
ld_ginit(int g, int ty) {
  word[] gv = (import ex_gv);
  float[] gf = (import ex_gf);
  int c = ld_at();
} chain (int g, int ty) {
  if (ty == (import t_dbl)) {
    gf[g] = ld_fnum();
    return;
  }
  if (c == 64) {
    gv[g] = ld_cptr();
    return;
  }
  if (c != 110) {
    gv[g] = ld_num();
  }
} return void;
