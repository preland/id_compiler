// A global line: `@name = global T init`, or a string constant
// `@name = private unnamed_addr constant [N x i8] c"..."`, with the string's length in front of its
// bytes in the packed form `<{ i64, [N x i8] }>`, or the alias `@name = private alias i8, getelementptr
// (i8, ptr @other, i64 8)` that names the bytes of one such constant.
ld_global() {
  ld_adv(1);
  string nm = ld_word();
  ld_to(61);
} chain () {
  ld_adv(1);
  string kind = ld_word();
  ld_gdef(nm, kind);
} return void;
given tf_ld("@x = global i32 7") ():() then (import ex_gv):([7])
given tf_ld("@.s = private unnamed_addr constant [3 x i8] c\"\\68\\69\\00\"") ():() then (import ex_strs):(["", "hi"])

ld_gdef(string nm, string kind) {
  if (kind == "global") {
    ld_gvar(nm);
  } else {
    ld_gstr(nm);
  }
} return void;
given tf_ld(" i32 5") ("x", "global"):() then (import ex_gv):([5])
given tf_ld(" c\"\\68\\00\"") (".s", "private"):() then (import ex_strs):(["", "h"])

ld_gstr(string nm) {
  string[] ts = (import ex_strs);
  int h = ld_get("s", nm);
  string w = ld_word();
} chain (string nm) {
  if (w == "alias") {
    ld_galias(h);
    return;
  }
  if (string_starts_with(nm, "idfrd_") == 1) {
    return;
  }
  ts[h] = ld_cstr();
} return void;
given tf_ld("c\"S1l@0;\\00\"") ("idfrd_Node"):() then (import ex_strs):(["", ""])
given tf_ld("c\"S2ss;\\00\"") ("idfrd_P"):() then (import ex_strs):(["", ""])
given tf_ld("c\"\\68\\69\\00\"") (".a"):() then (import ex_strs):(["", "hi"])
given tf_ld("c\"\\6F\\00\"") (".a"):() then (import ex_strs):(["", "o"])
given tf_ld("c\"\\68\\69\\00\"\nalias i8, getelementptr inbounds (i8, ptr @.d, i64 8)") given ld_gstr(".d") given ld_eol() (".a"):() then (import ex_strs):(["", "hi", "hi"])
