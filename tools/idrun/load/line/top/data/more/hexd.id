// The byte written as the escape at index i of the constant starting at q0.
ld_byte(int q0, int i) {
  int hi = ld_hexd(ld_bat(q0 + i * 3 + 1));
  int lo = ld_hexd(ld_bat(q0 + i * 3 + 2));
  int b = hi * 16 + lo;
} return int b;
given tf_ld("\\68\\69") (0, 0):(104)
given tf_ld("\\68\\69") (0, 1):(105)
given tf_ld("x\\FF") (1, 0):(255)

// A hex digit's value; the printer writes capitals.
ld_hexd(int c) {
  int n = c - 48;
  if (c > 57) {
    n = c - 55;
  }
} return int n;
(48):(0)
(57):(9)
(65):(10)
(70):(15)
