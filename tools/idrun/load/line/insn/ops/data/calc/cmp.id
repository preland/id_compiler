  if (code == (import p_zext) && t1 == (import t_i32)) {
    op = (import o_zext32);
  }
  if (code == (import p_trunc) && t2 == (import t_i32)) {
    op = (import o_trunc32);
  }
} chain (int code, int t1, int t2) {
  if (code == (import p_sitofp)) {
    op = (import o_sitofp);
  }
  if (code == (import p_fptosi)) {
    op = (import o_fptosi);
  }
} return int op;
