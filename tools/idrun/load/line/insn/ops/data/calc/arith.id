// fadd fsub fmul fdiv are consecutive in both numberings.
ld_fbin(int code, int d) {
  int ty = ld_ty();
  int fa = ld_val(ty);
  ld_emit((import o_fadd) + code - (import p_fadd), d, fa, ld_val(ty), 0);
} return void;
