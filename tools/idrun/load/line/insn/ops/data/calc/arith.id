// add sub mul and or xor: the 32-bit form for an i32, the 64-bit one otherwise.
ld_bin(int code, int d) {
  int ty = ld_ty();
  int a = ld_val(ty);
  int b = ld_val(ty);
} chain (int code, int d) {
  ld_emit(ld_binop(code, ty), d, a, b, 0);
} return void;
given tf_ld("i32 %v1, %v2") (3, 8):() then (import ex_cd):([1, 8, 0, 1, 0])
given tf_ld("i64 %v1, 5") (4, 8):() then (import ex_cd):([14, 8, 0, 1, 0]) then (import ex_kv):([5])

