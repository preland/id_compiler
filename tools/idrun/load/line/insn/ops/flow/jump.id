// br label %bN, or br i1 %c, label %bT, label %bF. A target is a block
// number here and a pc once ld_link has seen every label.
ld_br() {
  ld_skip();
  int c = ld_at();
  if (c == 108) {
    ld_word();
    ld_emit((import o_br), 0, 0, 0, ld_label());
    return;
  }
} chain () {
  ld_word();
  int a = ld_val((import t_i1));
  ld_word();
} chain () {
  int tt = ld_label();
  ld_word();
  int ff = ld_label();
} chain () {
  ld_emit((import o_cbr), 0, a, tt, ff);
} return void;
given tf_ld("label %b7") ():() then (import ex_cd):([4, 0, 0, 0, 7])
given tf_ld("i1 %v3, label %b1, label %b2") ():() then (import ex_cd):([3, 0, 0, 1, 2])
given tf_ld("i1 %v3, label %b1, label %b2") given tf_ns ():() then (import ex_cd):([3, 0, 1, 1, 2])

// %bN: the number N. Any other label is not a branch target in the -O0 form.
ld_label() {
  string w = ld_sig();
  int n = ld_pnum(w, 98);
} return int n;
given tf_ld(" %b12,") ():(12) then (import ld_pr)[(import pr_p)]:(5)
given tf_ld("%v3") ():(-1)

ld_ret() {
  int ty = ld_ty();
  int a = 0;
  if (ty != (import t_void)) {
    a = ld_val(ty);
  }
} chain () {
  ld_emit((import o_ret), 0, a, 0, 0);
} return void;
given tf_ld("void") ():() then (import ex_cd):([7, 0, 0, 0, 0])
given tf_ld("i32 %v4") given tf_ns ():() then (import ex_cd):([7, 0, 1, 0, 0])
