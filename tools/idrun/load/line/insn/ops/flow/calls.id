// A named callee is a runtime helper, one of the three float helpers, or a
// function of the program, in that order of lookup.
ld_calld(int d, int apos) {
  ld_adv(1);
  string nm = ld_word();
  int n = ld_args();
} chain (int d, int apos) {
  int bid = ld_look("b:" + nm);
  int fbi = ld_look("x:" + nm);
  ld_pad(bid, n);
} chain (int d, int apos) {
  if (bid >= 0) {
    ld_emit((import o_bcall), d, bid, apos, 0);
    return;
  }
  if (fbi >= 0) {
    ld_emit((import o_boxf) + fbi, d, (import ex_argp)[apos], 0, 0);
    return;
  }
  ld_emit((import o_call), d, ld_get("f", nm), apos, 0);
} return void;
