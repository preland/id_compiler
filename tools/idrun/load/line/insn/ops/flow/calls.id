// call T @f(args), or call T %v(args) through a function value.
ld_call(int d) {
  int ty = ld_ty();
  ld_skip();
  int apos = len((import ex_argp));
} chain (int d) {
  if (ld_at() == 64) {
    ld_calld(d, apos);
  } else {
    ld_calli(d, apos);
  }
} return void;
