given tf_ld("void %v7(i32 %v1)") (-1):() then tf_cd:([30, -1, 0, 0, 0]) then tf_argp:([1])

ld_calli(int d, int apos) {
  int sl = ld_var();
  int n = ld_args();
  ld_emit((import o_calli), d, sl, apos, 0);
} return void;
