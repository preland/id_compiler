// The loader reads its text, a list of bytes, one cursor at a time: the text
// is ld_b, the cursor is a cell of ld_pr. It never touches the flat store, so
// the program it loads sees the store exactly as a compiled one would: the
// text is a list, and the words made from it are built with chr. Every token
// reader below moves the cursor and returns what it read, so the instruction
// parsers never pass an index.
ld_pos() {
  int p = (import ld_pr)[(import pr_p)];
} return int p;
given tf_ld("abc") ():(0)
given tf_ld("abc") given ld_adv(2) ():(2)

// The byte at p, or -1 past either end.
ld_bat(int p) {
  int c = 0 - 1;
  if (p >= 0 && p < len((import ld_b))) {
    c = (import ld_b)[p];
  }
} return int c;
given tf_ld("abc") (1):(98)
given tf_ld("abc") (3):(-1)
given tf_ld("abc") (-1):(-1)

// The byte under the cursor.
ld_at() {
  int c = ld_bat(ld_pos());
} return int c;
given tf_ld("abc") ():(97)
given tf_ld("abc") given ld_adv(3) ():(-1)
