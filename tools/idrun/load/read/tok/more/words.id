// Each space-separated word of src is a key under kind, valued by its position.
lb_seed(string kind, string src) {
  int a = 0;
  int i = 0;
  while (a < len(src)) {
    a = lb_one(kind, src, a, i);
    i = i + 1;
  }
} return void;
given tf_key("k:c") given lb_tables ("k", "a b c"):() then tf_look:(2)
given tf_key("k:c") given lb_tables ("k", "c d"):() then tf_look:(0)

// One word starting at a, put in the table; answers where the next starts.
lb_one(string kind, string src, int a, int i) {
  int e = lb_end(src, a);
  ld_put(kind + ":" + ld_sub(src, a, e), i);
  int nx = e + 1;
} return int nx;
given tf_key("k:c") given lb_tables ("k", "ab c", 3, 5):(5) then tf_look:(5)
given tf_key("k:c") given lb_tables ("k", "ab c", 0, 5):(3) then tf_look:(-1)

lb_end(string src, int e) {
  while (character_code_at(src, e) != 32 && character_code_at(src, e) >= 0) {
    e = e + 1;
  }
} return int e;
("ab cd", 0):(2)
("ab cd", 3):(5)
