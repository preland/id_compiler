// Consume a '.', and say whether there was one.
ld_dot() {
  int dot = ld_at() == 46;
  ld_adv(dot);
} return int dot;
given tf_ld(".5") ():(1) then ld_pos:(1)
given tf_ld("5") ():(0) then ld_pos:(0)

// Ten to the k as a float: exact up to 10^22, so a literal of at most 15
// digits is the correctly rounded quotient of two exact floats.
ld_pow10(int k) {
  float f = 1.0;
  while (k > 0) {
    f = f * 10.0;
    k = k - 1;
  }
} return float f;
(0):(1.0)
(3):(1000.0)

// A decimal literal: all its digits as one integer, divided by ten to the
// number that came after the point.
ld_fnum() {
  int neg = ld_neg();
  word wv = ld_digits(0);
  int dot = ld_dot();
} chain () {
  int p0 = ld_pos();
  wv = ld_digits(wv);
  float f = wv;
} chain () {
  f = f / ld_pow10(ld_pos() - p0);
  if (neg == 1) {
    f = 0.0 - f;
  }
} return float f;
given tf_ld("1.5") ():(1.5)
given tf_ld("-2.25") ():(-2.25)
given tf_ld("3") ():(3.0)
given tf_ld("0.1") ():(0.1)
given tf_ld("123456789.0") ():(123456789.0)
