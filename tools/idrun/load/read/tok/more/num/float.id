given tf_ld("+5") (43):(1) then (import ld_pr)[(import pr_p)]:(1)
given tf_ld("5") (43):(0) then (import ld_pr)[(import pr_p)]:(0)

// Ten to the k as a float: exact up to 10^22, so a literal of at most 15
// digits is the correctly rounded quotient of two exact floats.
ld_pow10(int k) {
  float f = 1.0;
  while (k > 0) {
    f = f * 10.0;
    k = k - 1;
  }
} return float f;
(0):(1.0)
(3):(1000.0)

// A decimal literal: all its digits as one integer, scaled by ten to the
// exponent less the number of digits that came after the point.
ld_fnum() {
  int neg = ld_neg();
  word wv = ld_digits(0);
  int dot = ld_eat(46);
} chain () {
  int p0 = (import ld_pr)[(import pr_p)];
  wv = ld_digits(wv);
  float f = wv;
} chain () {
  int fd = (import ld_pr)[(import pr_p)] - p0;
  int ex = ld_exp();
  f = ld_scale(f, ex - fd);
} chain () {
  if (neg == 1) {
    f = 0.0 - f;
  }
} return float f;
