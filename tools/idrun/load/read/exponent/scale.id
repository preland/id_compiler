// f times ten to the n: multiplied by it when n is not negative, divided by it
// when it is.
ld_scale(float f, int n) {
  if (n >= 0) {
    f = f * ld_pow10(n);
  } else {
    f = f / ld_pow10(0 - n);
  }
} return float f;
