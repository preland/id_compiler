// The slot of value number n in the current function, assigned on first
// sight: a value can be used in a block that is printed before its
// definition's.
ld_local(int n) {
  int[] vs = (import ld_vslot);
  while (len(vs) <= n) {
    push(vs, 0 - 1);
  }
  int sl = vs[n];
} chain (int n) {
  if (sl < 0) {
    sl = ld_newslot();
    vs[n] = sl;
  }
} return int sl;
given lb_boot (3):(0) then (import ld_vslot):([-1, -1, -1, 0])
given lb_boot given tf_ns (1):(1) then (import ld_vslot):([-1, 1])

// The number in a name that is ch followed by digits (%v12, b7), or -1.
ld_pnum(string w, int ch) {
  int n = 0 - 1;
  if (character_code_at(w, 0) == ch && character_is_digit(character_code_at(w, 1)) == 1) {
    n = ld_dsum(w, 1, 0);
  }
} return int n;
("v12", 118):(12)
("x1", 118):(-1)
("b3", 98):(3)
("v", 118):(-1)

// The decimal digits of w from i, added onto n.
ld_dsum(string w, int i, int n) {
  while (character_is_digit(character_code_at(w, i)) == 1) {
    n = n * 10 + character_code_at(w, i) - 48;
    i = i + 1;
  }
} return int n;
("v12", 1, 0):(12)
("v12x", 1, 5):(512)
("v", 1, 7):(7)
