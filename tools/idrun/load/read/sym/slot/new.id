// What a new name is: "f" a function-table row, "g" a global, "s" a string,
// anything else a slot in the current frame.
ld_make(string kind, string name) {
  int id = 0;
  if (kind == "f") {
    id = ld_newfn();
    push((import ld_fn), name);
    return id;
  }
  if (kind == "g") {
    id = ld_newg();
    return id;
  }
} chain (string kind, string name) {
  if (kind == "s") {
    id = vm_sput("");
    return id;
  }
  id = ld_newslot();
} return int id;
