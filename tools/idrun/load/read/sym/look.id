// The id a key was given, or -1.
ld_look(string key) {
  int id = hmap_get((import ld_sk), (import ld_sv), (import ld_su), key, 0 - 1);
} return int id;
given lb_tables ("x"):(-1)
given lb_tables given ld_put("x", 7) ("x"):(7)

ld_put(string key, int v) {
  hmap_put((import ld_sk), (import ld_sv), (import ld_su), (import ld_sn), key, v);
} return void;
given tf_key("a") given lb_tables ("a", 3):() then tf_look:(3)
given tf_key("a") given lb_tables ("b", 3):() then tf_look:(-1)

// A name's id, made on first mention: a call, a store or a string may name
// something defined further down the file.
ld_get(string kind, string name) {
  string key = kind + ":" + name;
  int id = ld_look(key);
  if (id < 0) {
    id = ld_make(kind, name);
    ld_put(key, id);
  }
} return int id;
given lb_boot given vb_boot ("s", ".a"):(1) then (import ex_strs):(["", ""])
given lb_boot given vb_boot given tf_get("s", ".a") ("s", ".a"):(1) then (import ex_strs):(["", ""])
given lb_boot given vb_boot given tf_get("s", ".a") ("s", ".b"):(2) then (import ex_strs):(["", "", ""])
given lb_boot given vb_boot ("f", "id_x"):(0) then (import ld_fn):(["id_x"])
