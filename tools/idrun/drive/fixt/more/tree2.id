// Remove the tree tf_tree made, files first; 0 when everything went.
tf_rmtree() {
  int bad = fs_remove((import tf_root) + "/conf.id") + fs_remove((import tf_root) + "/a.id");
  bad = bad + fs_remove((import tf_root) + "/z/b.id") + fs_remove((import tf_root) + "/.hid/c.id");
  bad = bad + fs_remove((import tf_root) + "/build/d.id") + fs_remove((import tf_root) + "/z");
} chain () {
  bad = bad + fs_remove((import tf_root) + "/.hid") + fs_remove((import tf_root) + "/build");
  bad = bad + fs_remove((import tf_root));
} return int bad;
