// A directory to hold the scratch directories dr_tryd makes: tf_stm is a name
// inside it, tf_d0 and tf_d1 the first two scratch names that stem gives.
tf_stem() {
  export string tf_base = fs_mktemp("idrun_s_", 1);
  export string tf_stm = (import tf_base) + "/s-";
  export string tf_d0 = (import tf_stm) + "0";
} chain () {
  export string tf_d1 = (import tf_stm) + "1";
  fs_drop_exit(tf_base);
} return void;
