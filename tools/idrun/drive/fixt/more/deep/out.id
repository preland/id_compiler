// The flags and an output list, which a case hands a function by name so that
// a `then` can read them after.
tf_fl() {
  export int[] tf_flags = [0, 0];
} return void;
():() then (import tf_flags):([0, 0])
given tf_fl ():() then (import tf_flags):([0, 0])

tf_ol() {
  export string[] tf_out = [];
} return void;
():() then (import tf_out):([])
given tf_ol ():() then (import tf_out):([])
