// Fixtures for the driver's cases. A case's files are made with idstd's
// fs_mktemp, so two runs never share a name, and removed by a `then` check.
tf_file(string s) {
  export string tf_path = fs_mktemp("idrun_t_", 0);
  int h = fs_open((import tf_path), "w");
  int wn = fs_write_mem(h, mem_of_str(s), len(s));
} chain (string s) {
  int shut = fs_close(h);
  fs_drop_exit(tf_path);
} return void;
("abc"):() then tf_size:(3) then tf_rm:(0)
(""):() then tf_size:(0) then tf_rm:(0)

tf_size() {
  int n = fs_size((import tf_path));
} return int n;
given tf_file("hello") ():(5) then tf_rm:(0)
given tf_file("x") ():(1) then tf_rm:(0)

// Remove the file tf_file made; 0 when it went.
tf_rm() {
  int gone = fs_remove((import tf_path));
} return int gone;
given tf_file("x") ():(0)
given tf_file("x") ():(0) then tf_rm:(-1)
