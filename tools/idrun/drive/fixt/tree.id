// Write a file with the given text.
tf_put(string path, string text) {
  int h = fs_open(path, "w");
  int wn = fs_write_mem(h, mem_of_str(text), len(text));
  int shut = fs_close(h);
} return void;
given tf_file("") ((import tf_path), "hey"):() then tf_size:(3) then tf_rm:(0)
given tf_file("long") ((import tf_path), ""):() then tf_size:(0) then tf_rm:(0)

// A project tree: a conf.id, a source file, a source file in a subdirectory,
// and a hidden directory and a build directory that are not source.
tf_tree() {
  export string tf_root = fs_mktemp("idrun_d_", 1);
  fs_drop_exit(tf_root);
  tf_put((import tf_root) + "/conf.id", "int k = 3;\n// c\n");
} chain () {
  tf_put((import tf_root) + "/a.id", "x\n");
  int m1 = fs_mkdir((import tf_root) + "/z");
  tf_put((import tf_root) + "/z/b.id", "y\n");
} chain () {
  int m2 = fs_mkdir((import tf_root) + "/.hid");
  tf_put((import tf_root) + "/.hid/c.id", "h\n");
  int m3 = fs_mkdir((import tf_root) + "/build");
} chain () {
  tf_put((import tf_root) + "/build/d.id", "b\n");
} return void;
():() then tf_rmtree:(0)
