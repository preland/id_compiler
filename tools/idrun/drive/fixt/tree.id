// What the walk should answer for that tree, built from dr_one: tf_ww for the
// sources, tf_wwp with the constant ahead of it, tf_wwb when build is not the
// output directory of the root, tf_wz for the subdirectory alone.
tf_want() {
  export string tf_ww = dr_one((import tf_root) + "/a.id") + dr_one((import tf_root) + "/z/b.id");
  export string tf_wz = dr_one((import tf_root) + "/z/b.id");
  export string tf_wwp = "printf '#const\\n%s\\n' 'int k = 3;'; " + (import tf_ww);
} chain () {
  export string tf_wbd = dr_one((import tf_root) + "/build/d.id");
  export string tf_wwb = dr_one((import tf_root) + "/a.id") + (import tf_wbd) + (import tf_wz);
} return void;
