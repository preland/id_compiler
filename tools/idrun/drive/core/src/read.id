// The bytes a..e of a list as a string, built with chr: reading text into the
// flat store would move the addresses the program being run sees.
dr_str(int[] buf, int a, int e) {
  string s = "";
  while (a < e) {
    s = s + chr(buf[a]);
    a = a + 1;
  }
} return string s;
([104, 105, 106], 0, 3):("hij")
([104, 105, 106], 1, 2):("i")

// The first directory on $PATH that holds name, or "." when none does.
dr_which(string name) {
  string[] dirs = str_split(environment_text("PATH"), ":");
  string pdir = "";
  int i = 0;
} chain (string name) {
  while (i < len(dirs) && pdir == "") {
    pdir = dr_pick(dirs[i], name);
    i = i + 1;
  }
  if (pdir == "") {
    pdir = ".";
  }
} return string pdir;
