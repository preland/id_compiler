// Where idlex and idparse are: $IDC_CACHE_DIR, or the .idc-cache beside the
// directory this program was started from (found on $PATH when it was started
// by bare name, as a `#!/usr/bin/env idrun` line does).
dr_tools(string a0) {
  string dir = env_text("IDC_CACHE_DIR");
  if (dir == "") {
    dir = dr_home(a0) + "/../.idc-cache";
  }
} return string dir;
given env_put("IDC_CACHE_DIR", "/x/cache") ("a/b"):("/x/cache")
given env_put("IDC_CACHE_DIR", "") ("/p/bin/idrun"):("/p/bin/../.idc-cache")
