// Where idlex and idparse are: $IDC_CACHE_DIR, or the .idc-cache beside the
// directory this program was started from.
dr_tools(string a0) {
  string dir = dr_env("IDC_CACHE_DIR");
  if (dir == "") {
    dir = fs_dir_of(a0) + "/../.idc-cache";
  }
} return string dir;
given env_put("IDC_CACHE_DIR", "/x/cache") ("a/b"):("/x/cache")
given env_put("IDC_CACHE_DIR", "") ("/p/bin/idrun"):("/p/bin/../.idc-cache")

dr_env(string name) {
  string s = "";
  if (env_has(name) == 1) {
    s = dr_envget(name);
  }
} return string s;
given env_put("IDRUN_T_A", "val") ("IDRUN_T_A"):("val")
("IDRUN_T_UNSET_ZZ"):("")

dr_envget(string name) {
  int[] buf = [];
  lst_fill(buf, 4096, 0);
  int n = env_get(name, buf, 4096);
} chain (string name) {
  string s = dr_str(buf, 0, n);
} return string s;
given env_put("IDRUN_T_A", "val") ("IDRUN_T_A"):("val")
given env_put("IDRUN_T_B", "hello world") ("IDRUN_T_B"):("hello world")
