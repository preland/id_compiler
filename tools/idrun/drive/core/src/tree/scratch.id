// The directory this program was started from. Started by path, that is the
// path's own directory; started by bare name, it is the $PATH entry holding it.
dr_home(string a0) {
  string home = fs_dir_of(a0);
  if (str_find(a0, "/") < 0) {
    home = dr_which(a0);
  }
} return string home;
