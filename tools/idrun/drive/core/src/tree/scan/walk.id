// The entries of a directory, sorted as fs_list gives them; a subdirectory's
// name ends in a slash.
dr_ents(string dir) {
  int[] buf = [];
  int n = fs_list(dir, buf, 0);
  list_fill(buf, n, 0);
} chain (string dir) {
  int got = fs_list(dir, buf, n);
  string[] ents = dr_lines(buf);
} return string[] ents;
given tf_tree ((import tf_root)):([".hid/", "a.id", "build/", "conf.id", "z/", ""]) then tf_rmtree:(0)
