// Every .id file under dir, in sorted-full-path order, which is the order
// bin/idc's `find | sort` gives: a directory's slash sorts it after a file
// whose name merely starts the same.
dr_walk(string dir, int root) {
  string[] ents = dr_ents(dir);
  string frag = "";
  int i = 0;
} chain (string dir, int root) {
  while (i < len(ents)) {
    frag = frag + dr_entry(dir, ents[i], root);
    i = i + 1;
  }
} return string frag;
