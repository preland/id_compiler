// A string as one shell word: in single quotes, each quote inside closed,
// escaped and reopened.
dr_q(string s) {
  string q = "'";
  int i = 0;
  while (i < len(s)) {
    q = q + dr_qc(character_code_at(s, i));
    i = i + 1;
  }
} chain (string s) {
  q = q + "'";
} return string q;
("a b"):("'a b'")
("it's"):("'it'\\''s'")
(""):("''")
