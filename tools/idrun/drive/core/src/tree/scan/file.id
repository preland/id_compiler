// A hidden directory is not source, and nor is the build output directory of
// the project's own root.
dr_sub(string dir, string name, int root) {
  string frag = "";
  if (character_code_at(name, 0) != 46 && (root == 0 || name != "build/")) {
    string sub = dir + "/" + ld_sub(name, 0, len(name) - 1);
    frag = dr_walk(sub, 0);
  }
} return string frag;
