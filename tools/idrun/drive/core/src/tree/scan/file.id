// conf.id is a manifest and backend.id a link recipe; neither is compiled.
dr_file(string dir, string name) {
  string frag = "";
  if (str_ends(name, ".id") == 1 && name != "conf.id" && name != "backend.id") {
    frag = dr_one(dir + "/" + name);
  }
} return string frag;
("/x", "a.id"):("printf '#file 0|%s\\n' '/x/a.id'; cat '/x/a.id'; echo; ")
