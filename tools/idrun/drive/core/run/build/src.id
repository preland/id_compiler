
// Compile into a scratch directory named from stem, run what came out, remove
// the directory. When the compile fails the IR file holds idparse's
// diagnostics, not IR, so they are printed to stderr before the directory goes.
dr_src(string[] argv, int at, int[] fl, string stem) {
  string tool = dr_tools(argv[0]);
  string dir = dr_tryd(stem, 0);
  int rc = dr_compile(argv[at], tool, dir, fl[1]);
} chain (string[] argv, int at, int[] fl, string stem) {
  int code = 1;
  if (rc == 0) {
    code = dr_exec(fs_read_bytes(dir + "/ll"), list_string_tail(argv, at));
  } else {
    dr_diag(dir + "/ll");
  }
} chain (string[] argv, int at, int[] fl, string stem) {
  dr_clean(dir);
} return int code;
given environment_put("IDC_CACHE_DIR", "../../.idc-cache") given tf_stem given tf_file("main(int argc, string[] argv) {\n  print(\"x\");\n} return int 3;\n") (["idrun", (import tf_path)], 1, [0, 1], (import tf_stm)):(3) then prints:("x\n") then tf_nod0:("tf_nod0 true") then tf_rmstem:(0) then tf_rm:(0)
given environment_put("IDC_CACHE_DIR", "../../.idc-cache") given tf_stem (["idrun", "/nonexistent/idrun-src"], 1, [0, 1], (import tf_stm)):(1) then eprints:("idrun: no such file or directory: /nonexistent/idrun-src\n") then tf_nod0:("tf_nod0 true") then tf_rmstem:(0)

// Prints what the failed compile left in the IR file, without the trailing
// newline eprint would double; nothing when the file is empty or missing.
dr_diag(string path) {
  string raw = fs_read_text(path);
  string text = string_trim(raw);
  if (len(text) > 0) {
    eprint(text);
  }
} return void;
given tf_file("x.id:1: error: bad\n") ((import tf_path)):() then eprints:("x.id:1: error: bad\n")
