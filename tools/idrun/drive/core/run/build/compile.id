// Run idlex and idparse over PATH, leaving the IR in dir/ll. Answers the shell's
// status for the line: 0 when both stages succeeded (each prints its own
// diagnostics when one does not), and 1 for a path that is not there.
dr_compile(string path, string tool, string dir, int untested) {
  int rc = 1;
  if (fs_exists(path) == 1) {
    rc = fs_run(dr_cmd(path, tool, dir, untested));
  } else {
    eprint("idrun: no such file or directory: " + path);
  }
} return int rc;
