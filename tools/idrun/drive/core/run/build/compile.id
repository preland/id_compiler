// The shell line. The sources are assembled by the shell (cat) rather than read
// into this program, which keeps them out of its memory and out of the flat
// store. The lexer's output goes through a file so that a failing lexer stops
// the line, which a pipe would not.
dr_cmd(string path, string tool, string dir, int untested) {
  string prep = "{ " + dr_prep(path) + "} > " + dr_q(dir + "/src");
  string lex = dr_q(tool + "/idlex") + " < " + dr_q(dir + "/src") + " > " + dr_q(dir + "/lex");
  string flags = " --triple " + (import host_triple) + dr_gate(untested) + " --host-triple " + (import host_triple) + " --target llvm --opt 0";
} chain (string path, string tool, string dir, int untested) {
  string parse = dr_q(tool + "/idparse") + flags + " < " + dr_q(dir + "/lex") + " > " + dr_q(dir + "/ll");
  string cmd = prep + " && " + lex + " && " + parse;
} return string cmd;
