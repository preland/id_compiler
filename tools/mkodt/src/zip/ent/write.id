// The checksum and the offset are what the headers need that the bytes do not
// say. The offset is taken before anything of this entry is written.
zw_both(int[] out, int[] cd, string name, int[] body) {
  word crc = zc_crc(body);
  int at = len(out);
  zw_emit(out, cd, name, body, crc, at);
} return void;
