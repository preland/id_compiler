// One entry: its local header and bytes onto the archive, and its record onto
// the central directory.

// The text as bytes, one cell each; the entries here are ASCII XML.
zw_entry(int[] out, int[] cd, string name, string s) {
  int[] body = [];
  zw_str(body, s);
  zw_both(out, cd, name, body);
} return void;
