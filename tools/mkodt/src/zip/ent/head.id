// The two headers an entry has.

// Signature 0x04034b50, the fields both headers share, then the name.
zw_local(int[] out, string name, int[] body, word crc) {
  zw_list(out, [80, 75, 3, 4]);
  zw_fields(out, name, body, crc);
  zw_str(out, name);
} return void;
