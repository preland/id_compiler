// No comment, disk 0, no internal attributes, and external attributes
// 0x01800000 -- mode 0600 in the high word, which zipfile gives an entry it
// was handed as text -- then where the entry's local header starts, and the
// name.
zw_tail(int[] cd, string name, int at) {
  zw_list(cd, [0, 0, 0, 0, 0, 0, 0, 0, 128, 1]);
  zw_u32(cd, at);
  zw_str(cd, name);
} return void;
