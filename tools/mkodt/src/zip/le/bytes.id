// Runs of bytes, appended to the archive.

// The bytes of s, one cell each: a name in a header, or an entry's text.
zw_str(int[] out, string s) {
  int i = 0;
  while(character_code_at(s, i) >= 0) {
    int c = character_code_at(s, i);
    push(out, c);
    i = i + 1;
  }
} return void;
([], "ab"):([97, 98], "ab")
([1], ""):([1], "")

// The end record's last two fields: where the central directory starts, and
// an archive comment of no bytes.
zw_last(int[] out, int at) {
  zw_u32(out, at);
  list_extend(out, [0, 0]);
} return void;
([], 1):([1, 0, 0, 0, 0, 0], 1)
([4], 65536):([4, 0, 0, 1, 0, 0, 0], 65536)
