// The layout: US QWERTY, by make code. A row of keys is a run of consecutive
// codes, so each is its first code and the characters it types unshifted and
// shifted.

km_fill(int[] lo, int[] hi) {
  km_rows(lo, hi, 0, 3);
  km_rows(lo, hi, 3, 6);
  km_same(lo, hi);
} return void;
