// The number row and the two letter rows above the shift keys.
km_rows(int[] lo, int[] hi) {
  km_row(lo, hi, 0x02, "1234567890-=", "!@#$%^&*()_+");
  km_row(lo, hi, 0x10, "qwertyuiop[]", "QWERTYUIOP{}");
  km_row(lo, hi, 0x1e, "asdfghjkl;'", "ASDFGHJKL:\"");
} return void;
