// The backquote and backslash keys, which sit apart from their rows, and the
// bottom letter row.
km_rows2(int[] lo, int[] hi) {
  km_row(lo, hi, 0x29, "`", "~");
  km_row(lo, hi, 0x2b, "\\", "|");
  km_row(lo, hi, 0x2c, "zxcvbnm,./", "ZXCVBNM<>?");
} return void;
