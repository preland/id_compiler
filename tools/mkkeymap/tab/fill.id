// Rows from first up to but not including last of the layout: 0 to 3 are the
// number row and the two letter rows above the shift keys, 3 to 6 the backquote
// and backslash keys, which sit apart from their rows, and the bottom letter row.
km_rows(int[] lo, int[] hi, int first, int last) {
  int r = first;
  while(r < last) {
    km_row(lo, hi, (import km_codes)[r], (import km_lows)[r], (import km_highs)[r]);
    r = r + 1;
  }
} return void;
