// The unshifted-equals-shifted keys, and the empty tables.

km_pairs(int[] lo, int[] hi, int[] codes, int[] vals) {
  int i = 0;
  while(i < len(codes)) {
    km_both(lo, hi, codes[i], vals[i]);
    i = i + 1;
  }
} return void;
([0, 0, 0], [0, 0, 0], [2, 0], [7, 8]):([8, 0, 7], [8, 0, 7], [2, 0], [7, 8])
([4], [5], [], []):([4], [5], [], [])

km_both(int[] lo, int[] hi, int code, int v) {
  lo[code] = v;
  hi[code] = v;
} return void;
([0, 0], [0, 0], 1, 9):([0, 9], [0, 9], 1, 9)
([1], [2], 0, 3):([3], [3], 0, 3)

km_zeros(int n) {
  int[] xs = [];
  lst_fill(xs, n, 0);
} return int[] xs;
(3):([0, 0, 0])
(0):([])
