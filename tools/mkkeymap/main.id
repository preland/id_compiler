// mkkeymap -- scancode set 1 to ASCII, as the kernel's keymap constants.
//
//   mkkeymap    the keymap block of kernel/prog/conf.id, on stdout
//
// Two tables of 128 bytes, unshifted and shifted, as hexadecimal text for the
// same reason the font is (tools/mkfont): `id` has no byte-array literal, and
// a keymap is mostly zeros, which a string cannot hold. Zero means "no
// character" -- a modifier, a function key, or a code this layout does not
// use -- and the driver treats it as nothing happening rather than as a NUL.
//
// This program only prints; tools/mkkeymap.sh puts the block into conf.id.
main(int argc, string[] argv) {
  int[] lo = km_zeros((import km_size));
  int[] hi = km_zeros((import km_size));
  km_emit(lo, hi);
} return int 0;
