// mkkeymap writes its tables through the hex tree shared with the other
// tools in idc/tools.
import "../lib/hex"

// Scancode set 1 has 128 make codes; a release is the same code with the high
// bit set, which the driver strips.
int km_size = 128;

// The prose conf.id carries around the two tables.
string km_head = "// GENERATED by tools/mkkeymap.sh -- do not edit. Scancode set 1 to\n// ASCII, 128 entries, two hexadecimal digits each.\n//\n// Zero means no character: a modifier, a function key, or a code this\n// layout does not use. Hexadecimal rather than a string of characters\n// because a string cannot hold a NUL and this table is mostly zeros --\n// the same reason the font is hexadecimal (tools/mkfont.sh).\n";
string km_tail = "// GENERATED by tools/mkkeymap.sh -- do not edit. See kb_low above.\n";
