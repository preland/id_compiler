// qmon -- drive the kernel under QEMU: type at it, photograph it, read what
// it said. The id replacement for tools/qmon.py; see tools/buildrun for how it is run and the
// command line below and idstd's host/os/proc/README.md and host/io/net/sock/README.md for the seam
// this is written against.
//
//   qmon build/kernel.elf --wait 2 --type "ls;uname" --shot out.ppm
//
// Serial output goes to stdout, exactly as qmon.py's did.
main(int argc, string[] argv) {
  init(argc, argv);
  int rc = drive();
} return int rc;
