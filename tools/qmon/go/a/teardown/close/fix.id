// close_sockets' only observable effect: after it runs, a raw recv on either
// handle fails (-1), against 0 (no data yet, but still open) beforehand --
// so its own 2 cases below are close_sockets not yet called, and called.
qa_check_close() {
  int qa_h1 = (import qm_qmph);
  int[] qa_buf1 = [0];
  int qa_r1 = sock_recv(qa_h1, qa_buf1, 1, 10);
} chain () {
  int qa_h2 = (import qm_serh);
  int[] qa_buf2 = [0];
  int qa_r2 = sock_recv(qa_h2, qa_buf2, 1, 10);
} chain () {
  int qa_ok = qa_r1 == -1 && qa_r2 == -1;
} return int qa_ok;
