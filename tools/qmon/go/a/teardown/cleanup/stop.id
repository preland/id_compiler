// Stop QEMU: give it 10 seconds to exit after "quit" (like qmon.py's
// proc.wait(timeout=10)), and kill it if it has not. This always runs, quit
// having been sent or not -- see go/a/session/drive.id.
reap_qemu() {
  int rc = proc_wait((import qm_qh), 10000);
  kill_if_needed(rc);
  proc_close((import qm_qh));
} return void;
given qa_init_fast given mk_paths given spawn_qemu ():() then calls kill_if_needed:(1) then qa_check_spawn:(1)
