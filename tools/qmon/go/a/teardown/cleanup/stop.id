// proc_wait returns -1 (ETIMEDOUT) for a child still running past the
// deadline; see idstd's host/os/proc/README.md.
kill_if_needed(int rc) {
  if(rc < 0) {
    proc_kill((import qm_qh));
  }
} return void;
