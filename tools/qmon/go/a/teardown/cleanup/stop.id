// Cased with listeners connected first, then a qemu spawned on the same
// paths: qemu replaces the listeners' socket files, fails on its bad -kernel
// and exits at once (its stale socket files are why qa_check_nc1 reads 0),
// so the reap is prompt and never reaches kill_if_needed's kill.
cleanup() {
  reap_qemu();
  close_sockets();
  output();
} return void;
