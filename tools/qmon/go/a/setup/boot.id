// Start QEMU, then connect to both sockets it will go on to create --
// before either is read from or written to, so the serial socket is ready
// as early as possible (go/a/setup/conn/qmp.id explains why).
boot() {
  mk_paths();
  spawn_qemu();
} return void;
given qa_init_fast ():() then qa_check_spawn:(1)
given qa_init_fast ():() then qa_check_spawn:(1) then qa_check_spawn:(1)

connect_both() {
  connect_qmp();
  connect_serial();
} return void;
given qa_both_ready ():() then qa_check_nc1:(1) then calls connect_qmp:[1] then calls connect_serial:[1]
given mk_paths given qa_sock_full ():() then qa_free_sock:(1) then calls connect_qmp:[1] then calls connect_serial:[1]

// Not cased: boot() picks its socket paths itself (mk_paths), so no given can
// bind a listener on them first; against a bad -kernel qemu dies at once and
// connect_qmp then connect_serial each wait out their full 10s sock_connect
// timeout. Two cases of this made the whole qmon build exceed 60s in 2 of 3
// runs. run() and drive() (session/drive.id) call it and inherit that cost.
setup() {
  boot();
  connect_both();
  greet();
} return void;
