// Where QEMU's two sockets live, and the argv that starts it.
//
// qmon.py put both sockets in a directory from tempfile.mkdtemp -- a call id
// has no equivalent of (no getenv, no mkdtemp; docs/RELIANCES.md §2). ticks()
// (monotonic milliseconds) is used for uniqueness instead: good enough for
// this tool's own callers, which only ever run one qmon at a time, and no
// worse than qmon.py's own temp directory, which it never removes either.
mk_paths() {
  int t = ticks();
  export string qm_qmp_path = "/tmp/qmon." + t + ".qmp";
  export string qm_ser_path = "/tmp/qmon." + t + ".ser";
} return void;
():() then qa_check_paths:(1)
():() then qa_check_paths:(1) then qa_check_paths:(1)

// The full command line, one argument per line -- see
// idstd's host/os/proc/README.md for why proc_spawn takes it that way.
// Matches qmon.py's qemu list exactly: a socket chardev carries the serial
// port (rather than a plain -serial file) so the same port can be typed at
// and read from, and QMP is the second socket.
build_argv() {
  string a = "qemu-system-x86_64\n-kernel\n" + (import qm_kernel) + "\n-display\nnone\n-vga\nstd\n-no-reboot\n-chardev\nsocket,id=s0,path=" + (import qm_ser_path) + ",server=on,wait=off\n-serial\nchardev:s0\n-qmp\nunix:" + (import qm_qmp_path) + ",server,nowait";
} return string a;
given qa_init_fast given mk_paths given qa_want_argv ():((import qa_want))
given qmb_init_seed_a given mk_paths given qa_want_argv ():((import qa_want))

// QEMU is driven over its two sockets, never its stdin, so that is closed at
// once: it reads EOF, as it did when proc_spawn gave every child /dev/null.
spawn_qemu() {
  string a = build_argv();
  export int qm_qh = proc_spawn(a);
  export int[] qm_buf = [];
} chain () {
  int qm_in_closed = proc_close_in((import qm_qh));
} return void;
given qa_init_fast given mk_paths ():() then qa_check_spawn:(1)
given qa_init_fast given mk_paths ():() then qa_check_spawn:(1) then qa_check_spawn:(1)
