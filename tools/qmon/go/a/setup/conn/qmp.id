// Connect to QEMU's QMP socket, retrying while it does not exist yet
// (sock_connect does this -- see idstd's sys/io/ipc/sock/README.md). The
// handshake (greet, go/a/setup/boot.id) waits until the serial socket is
// also connected: QEMU starts running the guest the moment it is spawned,
// with "wait=off" on both chardevs, and a socket chardev with nobody
// connected yet has nowhere to put what the guest writes to it -- so
// connecting late loses the earliest output, however fast this tool reads
// afterward.
connect_qmp() {
  export int qm_qmph = sock_connect((import qm_qmp_path), 10000);
  warn_if_bad_qmp();
} return void;
given mk_paths given qa_sock_full ():() then qa_free_sock:(1) then qa_check_qmph:("qa_check_qmph 0")
given qa_both_ready ():() then qa_check_nc1:(1) then qa_check_qmph:("qa_check_qmph 1")

// A connect that timed out is reported the way qmon.py's sys.exit did
// (go/b/qmp/line.id's byte-at-a-time read returns nothing for a bad handle,
// so the rest of the run proceeds harmlessly rather than hanging).
warn_if_bad_qmp() {
  if((import qm_qmph) < 0) {
    eprint("qmon: QEMU never opened its QMP socket");
  }
} return void;
given mk_paths given qa_sock_full given connect_qmp ():() then qa_free_sock:(1) then eprints:("qmon: QEMU never opened its QMP socket\n")
given qa_both_ready given connect_qmp ():() then qa_check_nc1:(1) then eprints:("")

greet() {
  string g = qmp_read_line();
  qmp_cmd((import qm_msg_capabilities));
} return void;
given qa_both_ready given connect_qmp ():() then qa_check_nc1:(1) then calls qmp_cmd:("{\"execute\": \"qmp_capabilities\"}\n")
given qa_both_ready given connect_qmp ():() then qa_check_nc1:(1) then calls qmp_read_line:[2] then calls qmp_cmd:[1]
