// The guest's serial port is a second Unix-domain socket (see
// go/a/setup/paths.id): connect to it the same way, and this is also the
// point at which qmon.py would have gone on to type and photograph, or
// sys.exit if either socket never appeared -- so it is where the exit code
// is decided (go/a/setup/conn/rc.id's conn_bad).
connect_serial() {
  export int qm_serh = sock_connect((import qm_ser_path), 10000);
  warn_if_bad_serial();
  set_rc();
} return void;
given qa_both_ready given connect_qmp given qa_sock_full ():() then qa_free_sock:(1) then qa_check_nc1:(1) then qa_check_serh:(0)
given qa_both_ready given connect_qmp ():() then qa_check_nc1:(1) then qa_check_serh:(1)

warn_if_bad_serial() {
  if((import qm_serh) < 0) {
    eprint("qmon: QEMU never opened its serial socket");
  }
} return void;
given qa_both_ready given connect_qmp given qa_sock_full given connect_serial ():() then qa_free_sock:(1) then qa_check_nc1:(1) then eprints:("qmon: QEMU never opened its serial socket\n")
given qa_both_ready given connect_qmp given connect_serial ():() then qa_check_nc1:(1) then eprints:("")

// qm_rc: set_rc's export, read back directly.
set_rc() {
  int bad = conn_bad();
  export int qm_rc = bad;
} return void;
given qa_both_ready given connect_qmp given connect_serial ():() then qa_check_nc1:(1) then (import qm_rc):(0)
