// --shot: ask QEMU to write the framebuffer out as a PPM. qmon.py passed an
// absolute path (os.path.abspath); qmon's callers (tests/kernel.sh) already
// pass one, since it is built from a mktemp -d directory, so this does not
// absolutise it itself -- id has no realpath native to do that with.
maybe_shot() {
  string path = (import qm_shot);
  if(len(path) > 0) {
    do_shot(path);
  }
} return void;
given qa_init_zero ():() then calls do_shot:[0]
given qa_init_shot given qa_both_ready given connect_qmp ():() then qa_check_nc1:(1) then calls do_shot:("/qa-shot.ppm")

do_shot(string path) {
  string msg = string_wrap((import qm_dump_pre), (import qm_dump_post), path);
  qmp_cmd(msg);
} return void;
given qa_both_ready given connect_qmp ("/qa-shot-a.ppm"):() then qa_check_nc1:(1) then calls qmp_cmd:("{\"execute\": \"screendump\", \"arguments\": {\"filename\": \"/qa-shot-a.ppm\"}}\n")
given qa_both_ready given connect_qmp ("/qa-shot-b.ppm"):() then qa_check_nc1:(1) then calls qmp_cmd:("{\"execute\": \"screendump\", \"arguments\": {\"filename\": \"/qa-shot-b.ppm\"}}\n")
