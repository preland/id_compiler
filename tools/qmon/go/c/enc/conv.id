// string -> bytes, the inverse of bytes_str.
str_bytes(string s) {
  int[] out = [];
  int n = len(s);
  fill_bytes(out, s, n, 0);
} return int[] out;
("hi"):([104, 105])
(""):([])

fill_bytes(int[] out, string s, int n, int i) {
  while(i < n) {
    i = push_one_byte(out, s, i);
  }
} return void;
([], "hi", 2, 0):([104, 105])
([200], "abc", 3, 1):([200, 98, 99])

push_one_byte(int[] out, string s, int i) {
  int c = character_code_at(s, i);
  push(out, c);
  int j = i + 1;
} return int j;
given qmb_conv_buf_setup ((import qmb_conv_buf), "hi", 0):(1) then qmb_conv_buf_probe:(2)
given qmb_conv_buf_setup ((import qmb_conv_buf), "abc", 1):(2) then qmb_conv_buf_probe:(2)
