// "|" is a bare pause (qmon.py: 0.3s); anything else is a QEMU key name,
// sent as a send-key command and followed by qmon.py's 0.03s pause.
key_or_pause(string[] toks, int i) {
  int j = i + 1;
  if(toks[i] == "|") {
    sleep_ms(300);
    j = i + 1;
  } else {
    j = send_key_tok(toks, i);
  }
} return int j;
(["|", "x"], 0):(1)
given qmb_qmp_hello_ser_empty (["ret", "x"], 0):(1) then calls send_key_tok:(["ret", "x"], 0)

send_key_tok(string[] toks, int i) {
  string msg = msg_sendkey(toks[i]);
  qmp_cmd(msg);
  int j = after_key(i);
} return int j;
given qmb_qmp_hello_ser_empty (["ret"], 0):(1) then calls qmp_cmd:("{\"execute\": \"send-key\", \"arguments\": {\"keys\": [{\"type\": \"qcode\", \"data\": \"ret\"}]}}\n")
given qmb_qmp_hello_ser_empty (["x", "y", "a"], 2):(3) then calls qmp_cmd:("{\"execute\": \"send-key\", \"arguments\": {\"keys\": [{\"type\": \"qcode\", \"data\": \"a\"}]}}\n")

after_key(int i) {
  sleep_ms(30);
  drain_serial();
  int j = i + 1;
} return int j;
given qmb_qmp_hello_ser_empty (0):(1) then calls drain_serial:[1]
given qmb_qmp_hello_ser_empty (5):(6) then calls drain_serial:[1]
