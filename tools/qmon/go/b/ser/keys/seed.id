// qm_keys' sole exporter is init_rest (arg/more.id); these seed the export
// for send_keys' cases without needing a live socket at all -- send_keys
// only reads the flag, it does not use it until send_keys_list dispatches.
qmb_keys_pause_seed() {
  init_rest(4, ["qmon", "k.elf", "--keys", "| |"]);
} return void;
():() then qm_keys_now:("| |")
():() then calls init_rest:(4, ["qmon", "k.elf", "--keys", "| |"]) then qm_keys_now:("| |")

qmb_keys_empty_seed() {
  init_rest(2, ["qmon", "k.elf"]);
} return void;
():() then qm_keys_now:("")
():() then calls init_rest:(2, ["qmon", "k.elf"]) then qm_keys_now:("")

qm_keys_now() {
  string k = (import qm_keys);
} return string k;
given qmb_keys_pause_seed ():("| |")
given qmb_init_seed_b ():("tab")
