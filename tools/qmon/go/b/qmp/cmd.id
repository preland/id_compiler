// Run one QMP command: send it, read the response (skipping any events --
// go/b/qmp/resp.id), and report an error the way qmon.py's Qmp.cmd did
// (`print(f"qmon: {name}: ...", file=sys.stderr)`) -- to stderr, with eprint.
qmp_cmd(string msg) {
  sock_send_str((import qm_qmph), msg);
  string r = qmp_read_response();
  check_error(r);
} return void;
given qmb_qmp_peer("oops \"error\" seen") ("ping"):() then eprints:("qmon: oops \"error\" seen\n")
given qmb_qmp_peer("again \"error\" here") ("ping"):() then eprints:("qmon: again \"error\" here\n")
given qmb_qmp_peer("hello") ("ping"):() then eprints:("")

check_error(string r) {
  int idx = string_find(r, "\"error\"");
  report_if_error(idx, r);
} return void;
("{\"error\": {\"desc\": \"bad\"}}"):() then eprints:("qmon: {\"error\": {\"desc\": \"bad\"}}\n")
("x \"error\" y"):() then eprints:("qmon: x \"error\" y\n")
("{\"return\": {}}"):("{\"return\": {}}")
("{\"error\": {\"desc\": \"bad\"}}"):("{\"error\": {\"desc\": \"bad\"}}")

report_if_error(int idx, string r) {
  if(idx >= 0) {
    eprint("qmon: " + r);
  }
} return void;
(0, "bad"):() then eprints:("qmon: bad\n")
(5, "worse"):() then eprints:("qmon: worse\n")
(-1, "ok"):(-1, "ok")
(0, "bad"):(0, "bad")
