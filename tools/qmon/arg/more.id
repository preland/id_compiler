// Continuing init: --keys and --type default to "" (qmon.py's argparse
// default=""), --settle to 1 second.
init_rest(int argc, string[] argv) {
  export string qm_keys = scan_value(argv, argc, "--keys", 2);
  export string qm_text = scan_value(argv, argc, "--type", 2);
  init_settle(argc, argv);
} return void;
given qmb_init_seed_a (2, ["qmon", "k.elf"]):() then qm_args_summary_now:("other.elf|4000|||1000||")
given qmb_init_seed_a (6, ["qmon", "k.elf", "--keys", "a b", "--type", "x;y"]):() then qm_args_summary_now:("other.elf|4000|a b|x;y|1000||")

init_settle(int argc, string[] argv) {
  string v = scan_value(argv, argc, "--settle", 2);
  export int qm_settle_ms = ms_of(v, 1000);
  init_rest2(argc, argv);
} return void;
given qmb_init_seed_a (2, ["qmon", "k.elf"]):() then qm_args_summary_now:("other.elf|4000|ret esc|ls;pwd|1000||")
given qmb_init_seed_a (4, ["qmon", "k.elf", "--settle", "5"]):() then qm_args_summary_now:("other.elf|4000|ret esc|ls;pwd|5000||")

// "" (not found) means the default, given in milliseconds; qmon.py's own is 2.0
// seconds for --wait and 1.0 for --settle. id has no float-parsing builtin (to_int
// parses a leading integer, SPEC.md §3), so --wait and --settle are whole seconds
// -- every caller, including tests/kernel.sh, only ever passes an integer.
ms_of(string v, int dflt_ms) {
  int ms = dflt_ms;
  if(len(v) > 0) {
    int secs = to_int(v);
    ms = secs * 1000;
  }
} return int ms;
("2", 1000):(2000)
("", 1000):(1000)
("4", 2000):(4000)
("", 2000):(2000)
