// The two commands buildrun runs: the tool's build, and the tool.

// Builds tools/TOOL under root into tmp/TOOL, all of the build's output going to
// stderr. Answers the build's status, after saying which tool failed when it
// did not succeed.
br_build(string root, string tool, string tmp) {
  string lines = br_build_argv(root, tool, tmp);
  int[] none = [];
  int rc = exec_show(lines, none, 1, (import br_ms));
} chain (string root, string tool, string tmp) {
  if (rc != 0) {
    eprint("buildrun: failed to build tools/" + tool);
  }
} return int rc;
given br_t_fake(0) ((import br_t_root), "hello", (import br_t_root)):(0) then br_t_done:("done 1")
given br_t_fake(3) ((import br_t_root), "hello", (import br_t_root)):(3) then eprints:("buildrun: failed to build tools/hello\n") then br_t_done:("done 1")

// Runs tmp/argv[at + 1] with the arguments after it (argv up to argc), in as its
// stdin. Answers the tool's exit status.
br_exec(string tmp, string[] argv, int at, int argc, int[] in) {
  string exe = tmp + "/" + argv[at + 1];
  string rest = br_lines(argv, at + 2, argc);
  int rc = exec_show(exe + "\n" + rest, in, 0, (import br_ms));
} return int rc;
("/usr/bin", ["b", "/r", "env", "echo", "hi"], 1, 5, []):(0) then prints:("hi\n")
("/usr/bin", ["b", "/r", "env", "false"], 1, 4, []):(1)
