(["s", "--write"], "false", "idc", "/nonexistent_sg_root", "/nonexistent_sg_root", "/nonexistent_sg_root"):(2) then eprints:("statusgen: cannot write docs/STATUS.md under /nonexistent_sg_root; run from the checkout root, or pass --root DIR\n")
(["s", "--check"], "false", "idc", "/nonexistent_sg_root", "/nonexistent_sg_root", "/nonexistent_sg_root"):(1) then eprints:("statusgen: docs/STATUS.md is stale: it is not what statusgen prints now; regenerate it with 'statusgen --write' (idc/bin/idc idc/tools/statusgen -o statusgen), from the checkout root\n")

// Dispatches on --untested; --mut names the mutscore results.
sg_mode(string[] sgm_argv, string sgm_mut, string sgm_root, string sgm_std) {
  string sgm_idc = path_join(sgm_root, "idc/bin/idc");
  string sgm_res = sg_or(sg_arg(sgm_argv, "--mut"), path_join(sgm_root, "bench/results/mutscore"));
  int sgm_un = list_string_index(sgm_argv, "--untested") >= 0;
} chain (string[] sgm_argv, string sgm_mut, string sgm_root, string sgm_std) {
  int sgm_rc = 0;
  if(sgm_un == 1) {
    sgm_rc = sg_modeU(sgm_mut, sgm_idc, sgm_root, sgm_std, sg_tree_arg(sgm_argv));
  }
  if(sgm_un == 0) {
    sgm_rc = sg_modeP(sgm_argv, sgm_mut, sgm_idc, sgm_root, sgm_std, sgm_res);
  }
} return int sgm_rc;
