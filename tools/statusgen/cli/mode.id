// What the command line asks for once the checkout, the compiler and the mutscore
// program are known.

// `--untested`: the short functions of the trees sgu_tree asks for, one per line.
sg_modeU(string sgu_mut, string sgu_idc, string sgu_root, string sgu_std, string sgu_tree) {
  string[] sgu_out = [];
  sg_ulist(sgu_out, sgu_mut, sgu_idc, sgu_root, sgu_std, sgu_tree);
  if(len(sgu_out) > 0) {
    print(str_join(sgu_out, "\n"));
  }
} return int 0;
given sg_t_tree ("sh\n-c\nprintf '#h\\ncase\\ta.id\\tf\\t3\\tc\\ncase\\ta.id\\tf\\t4\\tc\\nsummary\\t2\\t1\\t0\\t0\\t0\\n'\nsh", "idc", (import sg_t_root), "/nonexistent_sg_root", ""):(0) then prints:("sub/b.id:1 g (0 cases)\nsub/more/c.id:1 h (0 cases)\n")
("false", "idc", "/nonexistent_sg_root", "/nonexistent_sg_root", ""):(0) then prints:("")

// The page itself: made, then written, compared or printed (sg_emit). 2 when it
// could not be made.
sg_modeP(string[] sgp_argv, string sgp_mut, string sgp_idc, string sgp_root, string sgp_std, string sgp_res) {
  string sgp_page = sg_report((import sg_pg), sgp_mut, sgp_idc, sgp_root, sgp_std, sgp_res);
  int sgp_rc = 2;
  if(sgp_page != "") {
    sgp_rc = sg_emit(sgp_argv, sgp_root, (import sg_page_rel), sgp_page);
  }
} return int sgp_rc;
