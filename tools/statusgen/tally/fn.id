sg_tfuncs(int[] sgu_t, string[] sgu_r, string[] sgu_ex, string sgu_root) {
  int sgu_i = 0;
  while(sgu_i < len(sgu_r)) {
    sg_tfn(sgu_t, sgu_r[sgu_i], sgu_ex, sgu_root);
    sgu_i = sgu_i + 1;
  }
} return void;
