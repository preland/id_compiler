// The tally of a tree: sgk_e its walk entries, sgk_fr its functions (sg_frow
// rows), sgk_ex the exempt rows, sgk_root the tree's directory, sgk_rows the
// lint output.
sg_tally(string[] sgk_e, string[] sgk_fr, string[] sgk_ex, string sgk_root, string[] sgk_rows) {
  int[] sgk_t = sg_zeros((import sg_k_len));
  sg_tfiles(sgk_t, sgk_e);
  sg_tfuncs(sgk_t, sgk_fr, sgk_ex, sgk_root);
} chain (string[] sgk_e, string[] sgk_fr, string[] sgk_ex, string sgk_root, string[] sgk_rows) {
  sg_tlint(sgk_t, sgk_rows);
} return int[] sgk_t;
