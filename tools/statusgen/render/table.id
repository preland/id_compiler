// A whole table, head and rows.

sg_table(int sgt_kind, string[] sgt_labels, int[][] sgt_ts) {
  string[] sgt_rows = sg_rows(sgt_labels, sgt_ts, sgt_kind);
  string sgt_body = string_join(sgt_rows, "\n");
  string sgt_text = (import sg_hdr)[sgt_kind - 1] + "\n" + sgt_body;
} return string sgt_text;
