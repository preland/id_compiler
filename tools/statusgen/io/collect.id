// Reading the source files of a tree and measuring it.

// The sg_frow rows of the file sgo_ent under sgo_root, appended to sgo_fr; a
// directory entry adds none.
sg_cone(string[] sgo_fr, string sgo_root, string sgo_ent, string[] sgo_rows, string[] sgo_idx) {
  if(string_ends_with(sgo_ent, ".id") == 1) {
    string sgo_text = fs_read_text(path_join(sgo_root, sgo_ent));
    list_string_extend(sgo_fr, sg_funcs(sgo_ent, sgo_text, sgo_rows, sgo_idx));
  }
} return void;
given sg_t_tree ([], (import sg_t_root), "a.id", ["case\ta.id\tf\t3\tc", "case\ta.id\tf\t4\tc"], ["a.id\t0"]):(["a.id\t1\tf\t2"])
given sg_t_tree ([], (import sg_t_root), "sub/", [], []):([])

// The functions of every source file among the walk's entries sgc_ents.
sg_collect(string sgc_root, string[] sgc_ents, string[] sgc_rows, string[] sgc_idx) {
  string[] sgc_fr = [];
  int sgc_i = 0;
  while(sgc_i < len(sgc_ents)) {
    sg_cone(sgc_fr, sgc_root, sgc_ents[sgc_i], sgc_rows, sgc_idx);
    sgc_i = sgc_i + 1;
  }
} return string[] sgc_fr;
given sg_t_tree ((import sg_t_root), ["a.id", "sub/", "sub/b.id"], [], []):(["a.id\t1\tf\t0", "sub/b.id\t1\tg\t0"])
("/nonexistent_sg_root", [], [], []):([])

// The tally of the tree sgt_label in the directory sgt_dir of the checkout
// sgt_root: mutscore (the command sgt_mut) says its cases, the compiler (sgt_idc)
// which functions are exempt. A tree mutscore printed no summary for could not be
// measured, and says so with -1 in its file cell.
sg_tree(string sgt_mut, string sgt_idc, string sgt_root, string sgt_label, string sgt_dir) {
  string[] sgt_rows = sg_lint(sgt_mut, sgt_dir);
  string[] sgt_ents = sg_walk(sgt_dir);
  string[] sgt_ex = sg_exempt(sgt_idc, sgt_root, sgt_label);
} chain (string sgt_mut, string sgt_idc, string sgt_root, string sgt_label, string sgt_dir) {
  string[] sgt_idx = sg_idx(sgt_rows);
  string[] sgt_fr = sg_collect(sgt_dir, sgt_ents, sgt_rows, sgt_idx);
  int[] sgt_t = sg_tally(sgt_ents, sgt_fr, sgt_ex, sgt_dir, sgt_rows);
} chain (string sgt_mut, string sgt_idc, string sgt_root, string sgt_label, string sgt_dir) {
  if(sg_pick(sgt_rows, "summary\t") == "") {
    sgt_t[(import sg_k_files)] = 0 - 1;
  }
} return int[] sgt_t;
