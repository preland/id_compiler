// mkfont reads the PSF through the file tree and writes its glyphs through
// the hex tree; both are shared with the other tools in idc/tools. The header
// is read by idstd's pcsf_head, which idem/tools/mkfont shares.
import "../lib/file"
import "../lib/hex"

// The glyphs the kernel console carries: printable ASCII, which is all it
// needs yet.
int mf_first = 32;
int mf_last = 126;
int mf_height = 16;

// Glyphs per constant, to keep each string literal short: the lexer builds a
// string literal with `+`, and that is quadratic.
int mf_per = 24;

// The fixed prose of the header conf.id carries above the font. The parts
// that name the font, its size and the number of constants are written by
// mf_top and mf_split around these.
string mf_why = "// row, most significant bit leftmost.\n//\n// Hexadecimal text rather than bytes, because `id` has no byte-array\n// literal and a string cannot hold a NUL -- which a font is mostly made\n// of. font_init decodes it once at boot.\n//\n";
string mf_quad = " constants because the lexer builds a string\n// literal by concatenation, which is quadratic (docs/TODO.md item 10):\n// one literal of six thousand characters costs measurably more than\n// ";
string mf_allhead = "// GENERATED by tools/mkfont.sh -- do not edit. See conf.id.\n//\n// The whole font, in order. Concatenating the parts is the one place\n// the quadratic cost is paid, and it is paid once at boot.\n\n";
