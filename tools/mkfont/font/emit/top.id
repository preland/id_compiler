// The font block of conf.id: its header, then one constant per chunk.

mf_conf(string name, int[] d, int[] hd, int n) {
  string top = mf_top(name);
  put(top + (import mf_why));
  mf_body(d, hd, n);
} return void;
("q.psf", [], [0, 1, 16, 8], 0):("q.psf", [], [0, 1, 16, 8], 0) then prints:("// GENERATED by tools/mkfont.sh from q.psf -- do not\n// edit. An 8x16 bitmap font, glyphs 32 to 126, one byte per\n// row, most significant bit leftmost.\n//\n// Hexadecimal text rather than bytes, because `id` has no byte-array\n// literal and a string cannot hold a NUL -- which a font is mostly made\n// of. font_init decodes it once at boot.\n//\n// Split across 0 constants because the lexer builds a string\n// literal by concatenation, which is quadratic (docs/TODO.md item 10):\n// one literal of six thousand characters costs measurably more than\n// 0 of a few hundred.\n")
