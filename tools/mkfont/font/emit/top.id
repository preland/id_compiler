// The two header lines that say which font this is and what it covers.
mf_top(string name) {
  string top = "// GENERATED by tools/mkfont.sh from " + name + " -- do not\n// edit. An 8x" + (import mf_height) + " bitmap font, glyphs " + (import mf_first) + " to " + (import mf_last) + ", one byte per\n";
} return string top;
("f.psf"):("// GENERATED by tools/mkfont.sh from f.psf -- do not\n// edit. An 8x16 bitmap font, glyphs 32 to 126, one byte per\n")
("lat0-16.psfu.gz"):("// GENERATED by tools/mkfont.sh from lat0-16.psfu.gz -- do not\n// edit. An 8x16 bitmap font, glyphs 32 to 126, one byte per\n")

// g is everything a chunk needs to find its glyphs: [glyph offset, bytes per
// glyph, rows per glyph, first code, last code, glyphs per chunk].
mf_body(int[] d, int[] hd, int n) {
  mf_split(n);
  int[] g = [hd[0], hd[1], (import mf_height), (import mf_first), (import mf_last), (import mf_per)];
  mf_chunks(d, g, n);
} return void;
