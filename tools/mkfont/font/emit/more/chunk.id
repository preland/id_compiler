// The last header line, which counts the constants, and the constants.

mf_split(int n) {
  put("// Split across " + n + (import mf_quad) + n + " of a few hundred.\n");
} return void;
(4):(4)
(2):(2)

mf_chunks(int[] d, int[] g, int n) {
  int i = 0;
  while(i < n) {
    mf_chunk(d, g, i);
    i = i + 1;
  }
} return void;
([10, 11, 12], [0, 1, 1, 0, 2, 2], 2):([10, 11, 12], [0, 1, 1, 0, 2, 2], 2)
([], [0, 1, 1, 0, 2, 2], 0):([], [0, 1, 1, 0, 2, 2], 0)

mf_chunk(int[] d, int[] g, int i) {
  string hex = mf_chunk_hex(d, g, i);
  put("string font_rom" + i + " = \"" + hex + "\";\n");
} return void;
([10, 11, 12], [0, 1, 1, 0, 2, 2], 1):([10, 11, 12], [0, 1, 1, 0, 2, 2], 1)
([10, 11, 12], [0, 1, 1, 0, 2, 2], 0):([10, 11, 12], [0, 1, 1, 0, 2, 2], 0)
