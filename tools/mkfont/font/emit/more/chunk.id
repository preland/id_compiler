mf_chunks(int[] d, int[] g, int n) {
  int i = 0;
  while(i < n) {
    mf_chunk(d, g, i);
    i = i + 1;
  }
} return void;
([10, 11, 12], [0, 1, 1, 0, 2, 2], 3):([10, 11, 12], [0, 1, 1, 0, 2, 2], 3) then prints:("string font_rom0 = \"0a0b\";\nstring font_rom1 = \"0c\";\nstring font_rom2 = \"\";\n")
([10, 11, 12], [0, 1, 1, 0, 2, 2], 1):([10, 11, 12], [0, 1, 1, 0, 2, 2], 1) then prints:("string font_rom0 = \"0a0b\";\n")
