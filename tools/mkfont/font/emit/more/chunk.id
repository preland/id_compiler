mf_split(int n) {
  put("// Split across " + n + (import mf_quad) + n + " of a few hundred.\n");
} return void;
(5):(5) then prints:("// Split across 5 constants because the lexer builds a string\n// literal by concatenation, which is quadratic (docs/TODO.md item 10):\n// one literal of six thousand characters costs measurably more than\n// 5 of a few hundred.\n")
