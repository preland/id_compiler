([], [0, 1, 1, 0, 2, 2], 0):([], [0, 1, 1, 0, 2, 2], 0)

mf_chunk(int[] d, int[] g, int i) {
  string hex = mf_chunk_hex(d, g, i);
  put("string font_rom" + i + " = \"" + hex + "\";\n");
} return void;
