// One chunk's glyphs as hexadecimal text. g is described in ../top.id.

// Chunk i holds codes from first + i * per, and the last chunk stops at the
// last code rather than at a whole chunk.
mf_chunk_hex(int[] d, int[] g, int i) {
  int lo = g[3] + i * g[5];
  int hi = fx_min(lo + g[5], g[4] + 1);
  string hex = mf_glyphs(d, g, lo, hi);
} return string hex;
([10, 11, 12], [0, 1, 1, 0, 2, 2], 0):("0a0b")
([10, 11, 12], [0, 1, 1, 0, 2, 2], 1):("0c")

mf_glyphs(int[] d, int[] g, int lo, int hi) {
  string[] strs = [];
  mf_glyph_run(strs, d, g, lo, hi);
  string hex = str_join(strs, "");
} return string hex;
([10, 11, 12, 13], [0, 2, 2, 0, 1, 2], 0, 2):("0a0b0c0d")
([10, 11, 12, 13], [1, 1, 1, 0, 3, 3], 1, 3):("0c0d")

// A glyph's rows are the first `height` of its bytes: a PSF glyph can carry
// more, and the console reads one byte per row.
mf_glyph_run(string[] strs, int[] d, int[] g, int lo, int hi) {
  int c = lo;
  while(c < hi) {
    string one = hex_of(d, g[0] + c * g[1], g[2]);
    push(strs, one);
    c = c + 1;
  }
} return void;
([], [5, 6], [0, 1, 1, 0, 1, 2], 0, 2):(["05", "06"], [5, 6], [0, 1, 1, 0, 1, 2], 0, 2)
(["z"], [5, 6], [0, 1, 1, 0, 1, 2], 1, 1):(["z"], [5, 6], [0, 1, 1, 0, 1, 2], 1, 1)
