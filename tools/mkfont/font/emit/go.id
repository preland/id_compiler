mf_go(int rc, string[] argv, int[] d, int[] hd) {
  int n = mf_nchunk((import mf_last) - (import mf_first) + 1, (import mf_per));
  if(rc == 0 && argv[3] == "all") {
    mf_all(n);
  }
  if(rc == 0 && argv[3] == "conf") {
    mf_conf(argv[2], d, hd, n);
  }
} return void;
