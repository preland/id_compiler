// What to print: a reason for a font that cannot be used, or one of the two
// outputs.

mf_say(int rc, string[] argv, int[] hd) {
  if(len(hd) != 5) {
    eprint(argv[2] + ": not a PSF font");
  }
  if(len(hd) == 5 && rc == 1) {
    eprint(argv[2] + ": " + hd[3] + "x" + hd[2] + ", wanted 8x" + (import mf_height));
  }
} return void;
