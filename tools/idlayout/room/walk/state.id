// --room's own candidate list, parallel to check mode's violation buckets
// (audit/check/report/state.id): one entry per file or directory the walk
// found with free capacity, the four lists kept in step by index -- its
// path, whether it is a "file" or a "dir", how many more fit, and its
// distance from DIR. Reset once per run, before the walk pushes into it.

lay_room_reset() {
  export string[] room_paths = [];
  export string[] room_kinds = [];
  export int[] room_free = [];
} chain () {
  export int[] room_dist = [];
} return void;
():() then prints:("")
():() then lay_room_count:(0)

lay_room_push(string path, string role, int free, int dist) {
  push((import room_paths), path);
  push((import room_kinds), role);
  push((import room_free), free);
} chain (string path, string role, int free, int dist) {
  push((import room_dist), dist);
} return void;
given lay_room_reset ("d", "dir", 2, 0):() then lay_room_count:(1)
given lay_room_reset ("d/a.id", "file", 1, 1):() then lay_room_count:(1)

lay_room_count() {
  int n = len((import room_paths));
} return int n;
given lay_room_reset ():(0)
given lay_room_reset ():(0) then prints:("")
