// Descending into the tree (mirrors audit/walk/list.id's own lay_walk/
// lay_walk_listed): a subdirectory is skipped if hidden or -- only directly
// under ROOT -- the build output directory, the same filter
// audit/check/rule/dir/entrylimit/count.id applies for the entry-limit rule;
// otherwise it is walked in turn. A directory's own entry total is
// lay_count_all's (audit/check/rule/dir/entrylimit/{count,scan}.id), read
// back the same way lay_check_entrylimit does, so a directory candidate's
// free count always agrees with the rule that would otherwise flag it.

lay_room_handle_dir(int[] buf, int lo, int hi, string dir, string root, int is_root) {
  string name = lay_name_of(buf, lo, hi);
  int hidden = charat(name, 0) == 46;
  int pruned = is_root == 1 && name == "build";
} chain (int[] buf, int lo, int hi, string dir, string root, int is_root) {
  if(hidden == 0 && pruned == 0) {
    string child = dir + "/" + name;
    lay_room_walk(child, root, 0);
  }
} return void;
