lay_room_walk_listed(string dir, string root, int is_root, int size) {
  int[] buf = lay_list_read(dir, size);
  lay_count_all(buf, "build", is_root);
  int total = len((import lay_scratch_names));
} chain (string dir, string root, int is_root, int size) {
  lay_room_emit_dir(dir, root, total);
  lay_room_scan(buf, dir, root, is_root, 0);
} return void;
