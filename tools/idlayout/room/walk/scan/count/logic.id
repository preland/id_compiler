// How many functions a *.id file's own bytes declare, matching the compiler's
// own 3-functions-per-file rule (compiler/parse/mid/names/limits/report/
// file_count.id counts one `prog` entry per parsed function): a chain
// continuation is the same function continuing, not a new one
// (compiler/parse/front/parse/decl/func/sig/chain/tail.id folds every segment
// into the one body the function already has), so it is written `} chain (`
// -- starting with `}`, not a signature -- and never adds to the count here.
// A line opens a new function when it starts at column 0 with an identifier
// and ends in `{`: every other top-level line in this codebase's own style
// -- a case, a comment, a chain seam, a return -- starts with `(`, `/`, `}`
// or `given`, none of which end a line in `{`.

lay_room_is_func_line(int[] bytes, int at, int eol) {
  int hit = 0;
  int first = 0;
  if(eol > at) {
    first = bytes[at];
  }
} chain (int[] bytes, int at, int eol) {
  int ident = chr_is_alpha(first) == 1 || first == 95;
  if(ident == 1 && eol > at) {
    int last = bytes[eol - 1];
    if(last == 123) {
      hit = 1;
    }
  }
} return int hit;
([102, 40, 41, 32, 123], 0, 5):(1)
([32, 105, 102, 40, 41, 32, 123], 0, 7):(0)
([125, 32, 99, 104, 97, 105, 110, 32, 123], 0, 9):(0)

lay_room_count_step(int[] bytes, int at) {
  int eol = lay_eol(bytes, at);
  int hit = lay_room_is_func_line(bytes, at, eol);
  if(hit == 1) {
    push((import room_func_hits), at);
  }
} chain (int[] bytes, int at) {
  int next = eol + 1;
} return int next;
given lay_room_hits_reset ([102, 40, 41, 32, 123, 10], 0):(6) then lay_room_hits_len:(1)
given lay_room_hits_reset ([32, 97, 10], 0):(3) then lay_room_hits_len:(0)

lay_room_count_funcs(int[] bytes) {
  lay_room_hits_reset();
  int at = 0;
  while(at < len(bytes)) {
    at = lay_room_count_step(bytes, at);
  }
} chain (int[] bytes) {
  int n = len((import room_func_hits));
} return int n;
([]):(0)
([102, 40, 41, 32, 123, 10, 125, 32, 114, 101, 116, 117, 114, 110, 59, 10]):(1)
