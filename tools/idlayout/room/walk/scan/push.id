// Turning one visited node into a candidate, if it has room: a directory
// already knows its own entry total (walk/scan/tree/recurse.id's
// lay_room_walk_listed, from the same lay_count_all the entry-limit rule
// uses); a file is read through the file tree (conf.id) and its functions
// counted (count/logic.id). Either way the distance is measured from
// room_ref_segs, the one DIR the whole run was asked about
// (room/main.id), against this node's own segments (walk/seg/path.id).

lay_room_emit_dir(string dir, string root, int total) {
  string[] segs = lay_room_segs(root, dir);
  string[] ref = (import room_ref_segs);
  int d = lay_room_dist(ref, segs);
} chain (string dir, string root, int total) {
  if(total < 3) {
    int free = 3 - total;
    lay_room_push(dir, "dir", free, d);
  }
} return void;
given lay_room_ref_fixture ("/r", "/r", 2):() then len((import room_paths)):(1)
given lay_room_ref_fixture ("/r", "/r", 3):() then len((import room_paths)):(0)

lay_room_emit_file(string dir, string root, string name) {
  string path = dir + "/" + name;
  int[] bytes = file_bytes(path);
  int n = lay_room_count_funcs(bytes);
} chain (string dir, string root, string name) {
  string[] segs = lay_room_segs(root, path);
  string[] ref = (import room_ref_segs);
  int d = lay_room_dist(ref, segs);
} chain (string dir, string root, string name) {
  if(n < 3) {
    int free = 3 - n;
    lay_room_push(path, "file", free, d);
  }
} return void;
given lay_room_ref_fixture ("/r", "/r", "does-not-exist-xyz-room-file.id"):() then len((import room_paths)):(1)
given lay_room_ref_fixture ("room/walk/scan", "room", "push.id"):() then len((import room_paths)):(0)

// A known, empty DIR-reference for the two cases above: `given` takes no
// arguments, and this is the only way to hand a case a fresh room_ref_segs
// alongside a fresh candidate list.
lay_room_ref_fixture() {
  lay_room_reset();
  string[] no_segs = [];
  lay_room_set_ref(no_segs);
} return void;
():() then prints:("")
