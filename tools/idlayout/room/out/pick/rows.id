// The same nearest-first rows emit.id prints, as a list -- so that a violation
// found by the layout check can name the places that have room for what it
// found too much of, instead of leaving the reader to run `--room` afterwards.

lay_room_rows(int cap) {
  int n = len((import room_paths));
  int[] taken = [];
  lst_fill(taken, n, 0);
} chain (int cap) {
  string[] rows = [];
  int idx = lay_room_find_min(taken);
  while(len(rows) < cap && idx != -1) {
    push(rows, lay_room_line(idx));
    taken[idx] = 1;
    idx = lay_room_find_min(taken);
  }
} return string[] rows;
given lay_room_two_fixture (10):(["dir /a 2", "file /b.id 1"])
given lay_room_two_fixture (1):(["dir /a 2"])
given lay_room_two_fixture (0):([])

// Up to three of the nearest places with room, as `KIND PATH FREE` rows joined
// by `; `, with the project root left out of each path (`.` for the root
// itself), or "" when the tree has none. A `dir` row has FREE more entries
// free; a `file` row has room for FREE more functions.
lay_room_hint(string root, string dir) {
  lay_room_prepare(root, dir);
  string[] rows = lay_room_rows(3);
  string shown = str_join(rows, "; ");
} chain (string root, string dir) {
  string inside = str_replace(shown, root + "/", "");
  string hint = str_replace(inside, root, ".");
} return string hint;
