// Printing every violation, grouped and ordered exactly as bin/idc used to
// call the five bash checks -- legacy, entry limit, nested manifest, same
// name as parent, generic name -- so the first line a multi-violation build
// prints is the same line the bash checks would have printed first, and
// every line after it is new.

lay_print_one(string[] msgs, int i) {
  string line = msgs[i];
  print(line);
  int next = i + 1;
} return int next;
(["x"], 0):(1) then prints:("x\n")
(["a", "b"], 1):(2) then prints:("b\n")

lay_print_all(string[] msgs) {
  int i = 0;
  while(i < len(msgs)) {
    i = lay_print_one(msgs, i);
  }
} return int i;
([]):(0) then prints:("")
(["a", "b"]):(2) then prints:("a\nb\n")

lay_report() {
  int a = lay_print_all((import lay_hit_legacy));
  int b = lay_print_all((import lay_hit_entry));
  int c = lay_print_all((import lay_hit_nested));
} chain () {
  int d = lay_print_all((import lay_hit_samename));
  int e = lay_print_all((import lay_hit_generic));
  int total = a + b + c + d + e;
} return int total;
given lay_reset ():(0) then prints:("")
given lay_fixture_two_hits ():(2) then prints:("a.id:1: error: x\nb.id:1: error: y\n")
