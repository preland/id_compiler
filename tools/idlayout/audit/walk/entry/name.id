// A directory's own name, for the same-name-as-parent check: the text after
// its last '/', or the whole string if it has none.

lay_last_slash(string path) {
  int i = len(path) - 1;
  while(i >= 0 && character_code_at(path, i) != 47) {
    i = i - 1;
  }
} return int i;
("a/b"):(1)
("abc"):(-1)

lay_basename(string path) {
  int i = lay_last_slash(path);
  int n = len(path);
  string name = str_sub(path, i + 1, n - i - 1);
} return string name;
("a/b"):("b")
("abc"):("abc")
("a/b/c"):("c")
