// A real, known one-file directory (one generic-named file, so it also
// exercises a real violation end to end) for lay_walk/lay_walk_listed's own
// cases, and its exact fs_list size, for the case that has to hand
// lay_walk_listed a size without calling fs_list from a case's own ARGS.

lay_walk_fixture_bad() {
  export string lay_wfb = fs_mktemp("idlayout_wfb_", 1);
  int w1 = fs_open(lay_wfb + "/util.id", "w");
  int c1 = fs_close(w1);
} chain () {
  fs_drop_exit(lay_wfb);
  lay_reset();
} return void;
():() then prints:("")
():() then lay_report:(0)

lay_walk_listed_fixture() {
  lay_walk_fixture_bad();
  export int lay_wl_size = lay_list_size((import lay_wfb));
} return void;
():() then prints:("")
():() then lay_report:(0)
