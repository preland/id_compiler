// One directory, fully: list it (walk/list.id), scan each entry for
// the six structural violations and recurse into every subdirectory reached. A directory that
// cannot be read (fs_list < 0) lists as nothing, same as `find` skipping it.

lay_walk(string dir, string root, string build, int is_root) {
  int size = lay_list_size(dir);
  if(size >= 0) {
    lay_walk_listed(dir, root, build, is_root, size);
  }
} return void;
("does-not-exist-xyz-idlayout-walk", "does-not-exist-xyz-idlayout-walk", "build", 1):() then prints:("")
given lay_walk_fixture_bad ((import lay_wfb), (import lay_wfb), "build", 1):() then lay_report:(1)

lay_walk_listed(string dir, string root, string build, int is_root, int size) {
  int[] buf = lay_list_read(dir, size);
  string self = lay_basename(dir);
  lay_scan(buf, dir, root, build, is_root, self, 0);
} chain (string dir, string root, string build, int is_root, int size) {
  lay_check_numbered(dir, build, is_root, buf);
} return void;
