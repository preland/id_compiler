lay_check_entrylimit(string dir, string root) {
  int total = len((import lay_scratch_names));
  if(total > 3) {
    string list = str_join((import lay_scratch_names), ", ");
    string msg = lay_entry_msg(dir, total, list, root);
    push((import lay_hit_entry), msg);
  }
} return void;
