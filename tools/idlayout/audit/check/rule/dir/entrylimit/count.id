// What counts toward a directory's own 3-entry total: a subdirectory,
// unless it is hidden or (only directly under the root) the build output
// directory; a *.id file, unless it is conf.id or backend.id. Mirrors
// check_entry_limit's own filter. Each counted name is pushed onto
// lay_scratch_names (scan.id resets it once per directory), so the count is
// just that list's length and the same names make the over-limit message.

lay_count_dir_entry(int[] buf, int lo, int hi, string build, int is_root) {
  string name = lay_name_of(buf, lo, hi);
  int hidden = charat(name, 0) == 46;
  int pruned = is_root == 1 && name == build;
} chain (int[] buf, int lo, int hi, string build, int is_root) {
  if(hidden == 0 && pruned == 0) {
    push((import lay_scratch_names), name);
  }
} return void;
given lay_scratch_reset ([46, 103, 105, 116], 0, 4, "build", 1):() then lay_scratch_len:(0)
given lay_scratch_reset ([115, 114, 99], 0, 3, "build", 1):() then lay_scratch_len:(1)

lay_count_file_entry(int[] buf, int lo, int hi) {
  lay_keep_file((import lay_scratch_names), buf, lo, hi);
} return void;
given lay_scratch_reset ([99, 111, 110, 102, 46, 105, 100], 0, 7):() then lay_scratch_len:(0)
given lay_scratch_reset ([109, 46, 105, 100], 0, 4):() then lay_scratch_len:(1)

lay_count_check(int[] buf, int lo, int hi, string build, int is_root) {
  if(buf[hi - 1] == 47) {
    lay_count_dir_entry(buf, lo, hi - 1, build, is_root);
  } else {
    lay_count_file_entry(buf, lo, hi);
  }
} return void;
given lay_scratch_reset ([100, 47], 0, 2, "build", 0):() then lay_scratch_len:(1)
given lay_scratch_reset ([97, 46, 105, 100], 0, 4, "build", 0):() then lay_scratch_len:(1)
