// One bucket per bash check (check_legacy_manifest, check_nested_manifest,
// check_same_name_as_parent, check_generic_names, check_numbered_sibling,
// check_file_named_like_dir), holding every violation it finds rather than
// bash's `head -1`. Reset once, at the start of a run, before the walk
// pushes into any of them.

lay_reset() {
  export string[] lay_hit_legacy = [];
  export string[] lay_hit_nested = [];
  export string[] lay_hit_samename = [];
} chain () {
  export string[] lay_hit_generic = [];
  export string[] lay_hit_numbered = [];
  export string[] lay_hit_samefile = [];
} return void;
():() then prints:("")
():() then lay_report:(0)

// A violation with the record's extra lines (docs/DIAGNOSTICS.md): the head line
// carries the code, and the why and help follow it, indented, for tools/iddiag.
lay_diag(string path, string lay_code, string text, string why, string help) {
  string head = str_cat3(path, ":1: error: ", text + " [" + lay_code + "]");
  string full = head + "\n  why: " + why + "\n  help: " + help;
} return string full;
("a/b.id", "E0090", "bad", "because", "do this"):("a/b.id:1: error: bad [E0090]\n  why: because\n  help: do this")
("d", "E0704", "worse", "reason", "fix"):("d:1: error: worse [E0704]\n  why: reason\n  help: fix")
