// Choosing what to do with the command line.

// Why the run cannot start, or "": ms_sh is the shard ([] when it was not
// I/N) and ms_al the mutants found.
ms_cm_why(string[] ms_cf, int[] ms_sh, string[] ms_al) {
  string ms_wy = "";
  if(len(ms_sh) == 0) {
    ms_wy = "mutscore: --shard must be I/N with 0 <= I < N, such as 0/4 (got " + ms_cf[(import ms_cf_shard)] + ")";
  }
  if(len(ms_sh) == 2 && len(ms_al) == 0) {
    ms_wy = "mutscore: no mutants under " + ms_cf[(import ms_cf_root)] + "; check that it holds .id files with functions, and that --area names a path inside it";
  }
} return string ms_wy;
(["/r", "", "", "", "", "", "", "", "", "9/3", ""], [], ["x"]):("mutscore: --shard must be I/N with 0 <= I < N, such as 0/4 (got 9/3)")
(["/r", "a/", "", "", "", "", "", "", "", "0/1", ""], [0, 1], []):("mutscore: no mutants under /r; check that it holds .id files with functions, and that --area names a path inside it")
(["/r", "", "", "", "", "", "", "", "", "0/1", ""], [0, 1], ["x"]):("")

// Runs the shard's share of the mutants (see ms_cm_go), or says it is done.
// ms_el is the milliseconds this run has used so far. Answers 0, or why it
// could not.
ms_cm_next(string[] ms_cf, string[] ms_al, int[] ms_sh, int ms_el) {
  int ms_m = fs_mkdir_p(ms_cf[(import ms_cf_out)]);
  string ms_pa = ms_cm_pa(ms_cf, ms_sh);
  string[] ms_ks = ms_dr_done(ms_pa);
} chain (string[] ms_cf, string[] ms_al, int[] ms_sh, int ms_el) {
  int[] ms_tq = ms_dr_todo(ms_al, ms_sh, ms_ks);
  int[] ms_td = ms_dr_scat(ms_tq);
  int ms_rc = 0;
} chain (string[] ms_cf, string[] ms_al, int[] ms_sh, int ms_el) {
  if(len(ms_td) == 0) {
    put("mutscore: shard " + ms_cf[(import ms_cf_shard)] + " is complete\n");
  }
  if(len(ms_td) > 0) {
    ms_rc = ms_cm_go(ms_cf, ms_al, ms_td, ms_pa, ms_el);
  }
} return int ms_rc;
given ms_t_tree ([(import ms_t_root), "", "sh\n-c\ngrep -rq \"a - b\" \"$1\" && echo \"t.id:1: test failed: x\"; exit 0\nidc", (import ms_t_work), "", "", "", "", "", "0/2", "40"], ["src/a.id\tadd\t32\t33\tarith\t-", "src/a.id\tadd\t50\t51\tret0\t0", "src/a.id\tadd\t50\t51\tret1\t1"], [0, 2], 0):(0) then prints:("mutscore: shard 0/2: built 2 of 2 mutants, 0 left\n")
given ms_t_tree ([(import ms_t_root), "", "sh\n-c\ngrep -rq \"a - b\" \"$1\" && echo \"t.id:1: test failed: x\"; exit 0\nidc", (import ms_t_work), "", "", "", "", "", "0/2", "40"], [], [0, 2], 0):(0) then prints:("mutscore: shard 0/2 is complete\n")

// Does what the command ms_cm of the command line ms_av says, or prints the
// usage. Answers the exit status: 0, 1 when a report has no results, 2 for a
// usage error or a run that could not start, 3 or 4 for a baseline that is
// red or still building.
ms_cl_cmd(string[] ms_av, string ms_cm) {
  int ms_ok = list_string_index((import ms_cmds), ms_cm) >= 0 && len(ms_av) >= 3 && (ms_cm != "run" || len(ms_cl_arg(ms_av, "--out")) > 0);
  string ms_pt = ms_cl_abs(list_string_get_or(ms_av, 2, ""), environment_text("PWD"));
  int ms_rc = 2;
} chain (string[] ms_av, string ms_cm) {
  if(ms_ok == 0) {
    eprint((import ms_usage));
  }
  if(ms_ok == 1 && ms_cm == "list") {
    ms_rc = ms_cm_list(ms_pt, ms_cl_arg(ms_av, "--area"));
  }
  if(ms_ok == 1 && ms_cm == "lint") {
    ms_rc = ms_cm_lint(ms_pt, ms_cl_arg(ms_av, "--area"), ms_cl_has(ms_av, "--tsv"));
  }
} chain (string[] ms_av, string ms_cm) {
  if(ms_ok == 1 && ms_cm == "report") {
    ms_rc = ms_cm_report(ms_pt, ms_cl_has(ms_av, "--tsv"));
  }
  if(ms_ok == 1 && ms_cm == "run") {
    ms_rc = ms_cm_run(ms_av);
  }
} return int ms_rc;
(["m", "bogus", "x"], "bogus"):(2) then eprints:("usage: mutscore list ROOT [--area SUB]\n       mutscore run ROOT --out DIR [--idc IDC] [--shard I/N] [--area SUB] [--with A,B] [--std] [--budget SECONDS]\n       mutscore report DIR [--tsv]\n       mutscore lint ROOT [--area SUB] [--tsv]\n")
(["m", "run", "/r"], "run"):(2) then eprints:("usage: mutscore list ROOT [--area SUB]\n       mutscore run ROOT --out DIR [--idc IDC] [--shard I/N] [--area SUB] [--with A,B] [--std] [--budget SECONDS]\n       mutscore report DIR [--tsv]\n       mutscore lint ROOT [--area SUB] [--tsv]\n")
given ms_t_tree (["m", "list", (import ms_t_root)], "list"):(0) then prints:("mutscore: 3 mutants\n  cmp 0\n  arith 1\n  logic 0\n  lit 0\n  idx 0\n  del 0\n  ret0 1\n  ret1 1\n")
given ms_t_tree (["m", "lint", (import ms_t_root)], "lint"):(0) then prints:("lint: 2 cases in 1 functions; silent 0, echo 0, bare 0, count 0, constant 0\n")
(["m", "report", "/no/such/dir_ms"], "report"):(1) then eprints:("mutscore: no results in /no/such/dir_ms; run 'mutscore run ROOT --out /no/such/dir_ms --idc IDC' first\n")
given ms_t_tree (["m", "run", (import ms_t_root), "--out", (import ms_t_work), "--idc", "sh\n-c\ngrep -rq \"a - b\" \"$1\" && echo \"t.id:1: test failed: x\"; exit 0\nidc", "--shard", "0/2"], "run"):(0) then prints:("mutscore: shard 0/2: built 2 of 2 mutants, 0 left\n")
