// Which mutants a run owns: shard i of n takes every mutant whose index is
// i modulo n, so any number of short runs together cover the lot.

// The shard spelled ms_sp ("I/N", 0 <= I < N) as [I, N]; [] when it is not.
ms_dr_sh(string ms_sp) {
  string[] ms_ps = str_split(ms_sp, "/");
  int[] ms_sv = [];
  if(len(ms_ps) == 2 && to_int(ms_ps[1]) > 0 && to_int(ms_ps[0]) >= 0 && to_int(ms_ps[0]) < to_int(ms_ps[1])) {
    push(ms_sv, to_int(ms_ps[0]));
    push(ms_sv, to_int(ms_ps[1]));
  }
} return int[] ms_sv;
("2/5"):([2, 5])
("0/1"):([0, 1])
("5/5"):([])
("1/0"):([])
("-1/3"):([])
("x"):([])

// 1 when the mutant at index ms_ix belongs to the shard ms_sh ([I, N]).
ms_dr_mine(int ms_ix, int[] ms_sh) {
  int ms_m = ms_ix % ms_sh[1] == ms_sh[0];
} return int ms_m;
(7, [2, 5]):(1)
(8, [2, 5]):(0)
(0, [0, 1]):(1)

// The mutant a result line ms_rl is about, in the form the enumeration
// writes it (file, function, start, end, operator, replacement); "" for a
// line that is not a result.
ms_dr_key(string ms_rl) {
  string[] ms_fd = str_split(ms_rl, "\t");
  string ms_ky = "";
  if(len(ms_fd) >= 8) {
    ms_ky = ms_fd[2] + "\t" + ms_fd[3] + "\t" + ms_fd[4] + "\t" + ms_fd[5] + "\t" + ms_fd[6] + "\t" + ms_fd[7];
  }
} return string ms_ky;
("killed\t2\ta.id\tf\t3\t4\tcmp\t<=\tx  =>  y"):("a.id\tf\t3\t4\tcmp\t<=")
("survived\t2\ta.id\tf\t3\t9\tdel\t\tx;  =>  "):("a.id\tf\t3\t9\tdel\t")
("junk"):("")
