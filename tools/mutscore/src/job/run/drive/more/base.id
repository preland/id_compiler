given ms_t_tree ([(import ms_t_root), "", "sh\n-c\nexit 1\nidc", (import ms_t_work), (import ms_t_work), (import ms_t_root), "", (import ms_t_root)], "K", (import ms_t_log), 20000):(0) then ms_t_logtxt:("")
given ms_t_tree ([(import ms_t_root), "", "sh\n-c\nsleep 5\nidc", (import ms_t_work), (import ms_t_work), (import ms_t_root), "", (import ms_t_root)], "K", (import ms_t_log), 100):(2)

// 1 when the unmutated copy builds and passes its cases, 0 when it does not,
// 2 when it has not finished within ms_ms milliseconds (the cases it did finish are
// cached, so running again continues). A green copy is remembered in the out
// directory under the key ms_ky, which names the source, so the next run of
// the same source does not build it again.
ms_dr_base(string[] ms_cf, string ms_ky, int ms_ms) {
  string ms_mk = path_join(ms_cf[(import ms_cf_out)], "base.ok");
  int ms_v = 1;
  if(fs_read_text(ms_mk) != ms_ky) {
    ms_v = ms_dr_try(ms_cf, ms_ky, ms_mk, ms_ms);
  }
} return int ms_v;
given ms_t_tree given ms_t_wlog("K") ([(import ms_t_root), "", "sh\n-c\nexit 1\nidc", (import ms_t_work), (import ms_t_work), (import ms_t_root), "", (import ms_t_root)], "K", 20000):(1)
given ms_t_tree ([(import ms_t_root), "", "sh\n-c\nexit 1\nidc", (import ms_t_work), (import ms_t_work), (import ms_t_root), "", (import ms_t_root)], "K", 20000):(0)
