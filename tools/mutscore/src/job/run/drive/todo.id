// The indexes, in order, of the mutants of ms_al that shard ms_sh owns and
// ms_ks has no answer for.
ms_dr_todo(string[] ms_al, int[] ms_sh, string[] ms_ks) {
  int[] ms_td = [];
  int ms_i = 0;
  while(ms_i < len(ms_al)) {
    if(ms_dr_mine(ms_i, ms_sh) == 1 && list_string_index(ms_ks, ms_al[ms_i]) < 0) {
      push(ms_td, ms_i);
    }
    ms_i = ms_i + 1;
  }
} return int[] ms_td;
