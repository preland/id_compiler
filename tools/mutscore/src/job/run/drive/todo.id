// The results file of a shard, and what is still to do given what it holds.

// Appends ms_tx to the file ms_pa, creating it. Answers the bytes written,
// -1 when the file cannot be opened.
ms_dr_add(string ms_pa, string ms_tx) {
  int ms_h = fs_open(ms_pa, "a");
  int ms_n = -1;
  if(ms_h >= 0) {
    ms_n = fs_write(ms_h, exec_bytes(ms_tx), len(ms_tx));
  }
} chain (string ms_pa, string ms_tx) {
  fs_close(ms_h);
} return int ms_n;
