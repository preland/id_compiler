// The mutants a results file already has an answer for, as keys.
ms_dr_done(string ms_pa) {
  string[] ms_lns = str_lines(fs_read_text(ms_pa));
  string[] ms_ks = [];
  int ms_i = 0;
} chain (string ms_pa) {
  while(ms_i < len(ms_lns)) {
    if(len(ms_dr_key(ms_lns[ms_i])) > 0) {
      push(ms_ks, ms_dr_key(ms_lns[ms_i]));
    }
    ms_i = ms_i + 1;
  }
} return string[] ms_ks;
