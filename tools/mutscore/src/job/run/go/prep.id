// Making the scratch copy the mutants are built in. Nothing here writes
// outside the directory the caller made with fs_mktemp.

// Runs the program ms_ag (one word per line) to its end, 30 s at most, and
// answers its exit status.
ms_rn_sh(string ms_ag) {
  int[] ms_in = [];
  int[] ms_ob = [];
  int ms_rc = exec_run(ms_ag, 0, 0, ms_in, ms_ob, ms_ob, 30000);
} return int ms_rc;
("true\n"):(0)
