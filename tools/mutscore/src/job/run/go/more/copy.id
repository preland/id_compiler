("/no/such/dir_ms"):(-1)

// Copies the tree ms_root into ms_work (as a directory of the same name),
// links the siblings of ms_wi beside it, and, when ms_sd is 1, writes the
// library's program. Answers 1 when every step worked.
ms_rn_prep(string ms_root, string[] ms_wi, int ms_sd, string ms_work) {
  string ms_dst = path_join(ms_work, path_base(ms_root));
  int ms_rc = ms_rn_sh("cp\n-r\n" + ms_root + "\n" + ms_dst + "\n");
  int ms_k = ms_rn_links(ms_root, ms_wi, ms_work);
} chain (string ms_root, string[] ms_wi, int ms_sd, string ms_work) {
  int ms_ok = ms_rc == 0 && ms_k == 0;
  if(ms_sd == 1 && ms_ok == 1) {
    ms_ok = ms_rn_prog(ms_work) > 0;
  }
} return int ms_ok;
