// Fills in the fields of the configuration ms_cf that depend on the scratch
// directory ms_work: it, the copy of the root, what idc is pointed at, and the
// library home. A run on a library has a non-empty library field to begin with.
ms_rn_cfg(string[] ms_cf, string ms_work) {
  string ms_dst = path_join(ms_work, path_base(ms_cf[(import ms_cf_root)]));
  ms_cf[(import ms_cf_work)] = ms_work;
  ms_cf[(import ms_cf_copy)] = ms_dst;
} chain (string[] ms_cf, string ms_work) {
  ms_cf[(import ms_cf_prog)] = ms_dst;
  if(len(ms_cf[(import ms_cf_std)]) > 0) {
    ms_cf[(import ms_cf_prog)] = path_join(ms_work, "prog");
    ms_cf[(import ms_cf_std)] = ms_dst;
  }
} return void;
