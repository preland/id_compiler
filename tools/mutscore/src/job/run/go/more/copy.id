// The scratch copy of a tree: made once per run, then mutated in place.

// Writes a program that builds and passes by itself, prog/main.id under
// ms_work, for a run whose subject is the library: building it is what runs
// the library's cases. Answers the bytes written.
ms_rn_prog(string ms_work) {
  int ms_d = fs_mkdir(path_join(ms_work, "prog"));
  string ms_pm = path_join(ms_work, "prog/main.id");
  int ms_n = exec_file_put(ms_pm, "main(int argc, string[] argv) {\n} return int 0;\n(1, [\"p\"]):(0)\n(2, [\"p\", \"a\"]):(0)\n", 420);
} return int ms_n;
