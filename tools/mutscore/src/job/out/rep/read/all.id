// The lines of ms_rg_m1 for every row of ms_rows that gets one.
ms_rg_muts(string[] ms_rows, int ms_tab) {
  string ms_ml = "";
  int ms_i = 0;
  while(ms_i < len(ms_rows)) {
    ms_ml = ms_ml + ms_rg_m1(ms_rows[ms_i], ms_tab);
    ms_i = ms_i + 1;
  }
} return string ms_ml;
