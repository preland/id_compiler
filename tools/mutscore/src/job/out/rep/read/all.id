// Every result of the out directory ms_out, one row per mutant, the later
// shard's line standing where two files disagree.
ms_rp_rows(string ms_out) {
  string[] ms_fl = ms_rp_files(ms_out);
  string[] ms_rows = [];
  string[] ms_ks = [];
} chain (string ms_out) {
  int ms_i = 0;
  while(ms_i < len(ms_fl)) {
    ms_rp_add(ms_rows, ms_ks, path_join(ms_out, ms_fl[ms_i]));
    ms_i = ms_i + 1;
  }
} return string[] ms_rows;
