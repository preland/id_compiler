// The report line for the result row ms_rw: in the tab form (ms_tab 1) every
// row as mutant, file, function, operator, line, answer, change; in the form
// to read only a survivor, as file:line: function [operator] change. "" for
// a row that gets no line.
ms_rg_m1(string ms_rw, int ms_tab) {
  string[] ms_fd = string_split(ms_rw, "\t");
  string ms_df = list_string_get_or(ms_fd, 8, "");
  string ms_ln = "";
} chain (string ms_rw, int ms_tab) {
  if(ms_tab == 1) {
    ms_ln = "mutant\t" + ms_fd[2] + "\t" + ms_fd[3] + "\t" + ms_fd[6] + "\t" + ms_fd[1] + "\t" + ms_fd[0] + "\t" + ms_df + "\n";
  }
  if(ms_tab == 0 && ms_fd[0] == "survived") {
    ms_ln = ms_fd[2] + ":" + ms_fd[1] + ": " + ms_fd[3] + " [" + ms_fd[6] + "]  " + ms_df + "\n";
  }
} return string ms_ln;
