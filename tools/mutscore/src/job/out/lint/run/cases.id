// ["LINE\ttext"] for the line ms_tx (number ms_no) when it can be a case
// (it is not blank and not a comment), [] otherwise.
ms_lt_pick(string ms_tx, int ms_no) {
  string ms_tt = string_trim(ms_tx);
  string[] ms_o = [];
  if(len(ms_tt) > 0 && string_starts_with(ms_tt, "//") == 0) {
    push(ms_o, "" + ms_no + "\t" + ms_tt);
  }
} return string[] ms_o;
