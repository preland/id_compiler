// The fourth weak shape, `count`: a case whose only assertions are call
// counts (`then calls F:[n]`), which show a callee ran but not what the
// function did. kind.id uses ms_lt_counted to tell it from a case that also
// pins a value, an exact call or a printed line.

// What the clause text ms_wzx (one `then` clause without the word) weighs: 0
// when it is empty or the silent `prints:("")` / `eprints:("")`, 1 when it is
// a call count `calls F:[n]`, 1000 for anything else.
ms_lt_part(string ms_wzx) {
  string ms_wzq = string_trim(ms_wzx);
  int ms_wzk = 1000;
  if(len(ms_wzq) == 0 || ms_wzq == "prints:(\"\")" || ms_wzq == "eprints:(\"\")") {
    ms_wzk = 0;
  }
} chain (string ms_wzx) {
  if(string_starts_with(ms_wzq, "calls ") == 1 && string_find(ms_wzq, ":[") > 6 && str_sub(ms_wzq, len(ms_wzq) - 1, 1) == "]") {
    ms_wzk = 1;
  }
} return int ms_wzk;
("calls f:[1] "):(1)
("calls f:(1)"):(1000)
("prints:(\"\") "):(0)
("prints:(\"x\")"):(1000)
(""):(0)
("calls f:[1] x"):(1000)
("traps:(\"\")"):(1000)

// 1 when the clauses ms_rs of a case are at least one `then calls F:[n]` and
// nothing else but other counts and the silent prints.
ms_lt_counted(string ms_rs) {
  string[] ms_wzl = string_split(ms_rs, "then ");
  int ms_wzn = 0;
  int ms_wzi = 0;
} chain (string ms_rs) {
  while(ms_wzi < len(ms_wzl)) {
    ms_wzn = ms_wzn + ms_lt_part(ms_wzl[ms_wzi]);
    ms_wzi = ms_wzi + 1;
  }
  int ms_wzr = ms_wzn >= 1 && ms_wzn < 1000;
} return int ms_wzr;
("then calls f:[1]"):(1)
("then calls f:[1] then calls g:[2] then prints:(\"\")"):(1)
("then calls f:(1)"):(0)
("then calls f:[1] then calls g:(1)"):(0)
("then calls f:[1] then prints:(\"x\")"):(0)
("then prints:(\"\")"):(0)
(""):(0)
