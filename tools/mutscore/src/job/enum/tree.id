// Which files of a tree are mutated, and all of their mutants.

// 1 when the file ms_rel (relative to the root) is source under the area
// ms_ar: a .id file, other than conf.id, below the path ms_ar, with no
// directory or file whose name starts with a dot.
ms_en_ok(string ms_rel, string ms_ar) {
  int ms_ok = str_ends(ms_rel, ".id") == 1 && str_starts(ms_rel, ms_ar) == 1 && charat(ms_rel, 0) != 46;
  int ms_hid = str_find(ms_rel, "/.") >= 0 || ms_rel == "conf.id" || str_ends(ms_rel, "/conf.id") == 1;
  int ms_yes = ms_ok == 1 && ms_hid == 0;
} return int ms_yes;
("src/a.id", ""):(1)
("src/a.id", "src/"):(1)
("src/a.id", "lib/"):(0)
("src/a.txt", ""):(0)
(".hid/c.id", ""):(0)
("src/.x/c.id", ""):(0)
("conf.id", ""):(0)
("src/conf.id", ""):(0)

// Every mutant line of every source file under ms_root that ms_en_ok accepts
// for the area ms_ar, files in path order.
ms_en_all(string ms_root, string ms_ar) {
  string[] ms_fl = path_files(ms_root);
  string[] ms_o = [];
  int ms_i = 0;
} chain (string ms_root, string ms_ar) {
  while(ms_i < len(ms_fl)) {
    if(ms_en_ok(ms_fl[ms_i], ms_ar) == 1) {
      lst_str_extend(ms_o, ms_en_file(ms_root, ms_fl[ms_i]));
    }
    ms_i = ms_i + 1;
  }
} return string[] ms_o;
given ms_t_tree ((import ms_t_root), ""):(["src/a.id\tadd\t32\t33\tarith\t-", "src/a.id\tadd\t50\t51\tret0\t0", "src/a.id\tadd\t50\t51\tret1\t1"])
given ms_t_tree ((import ms_t_root), "lib/"):([])
