given ms_t_lex("push(a, 1);") ("push(a, 1);", (import ms_t_tk), 0):(0)

// The constant a value of type ms_y (a list when ms_l is 1) is replaced by,
// or "" when there is none (a struct, a function value, void).
ms_mu_zero(string ms_y, int ms_l) {
  string ms_z = "";
  if(ms_y == "int" || ms_y == "word") {
    ms_z = "0";
  }
  if(ms_y == "float") {
    ms_z = "0.0";
  }
} chain (string ms_y, int ms_l) {
  if(ms_y == "string") {
    ms_z = "\"\"";
  }
  if(ms_l == 1) {
    ms_z = "[]";
  }
} return string ms_z;
