// Replacing what a function returns.

// The rows that make the function whose return clause spans tokens ms_r
// (`return`) to ms_e (`;`) return a constant: the type's zero, and 1 for an
// integer. None for `void`, a literal, or a type without a zero.
ms_mu_ret(string ms_s, int[] ms_tk, int ms_r, int ms_e) {
  int ms_v = ms_e - 1;
  string ms_y = ms_tk_str(ms_s, ms_tk, ms_r + 1);
  string ms_z = ms_mu_zero(ms_y, ms_tk_ch(ms_s, ms_tk, ms_r + 2) == 91);
} chain (string ms_s, int[] ms_tk, int ms_r, int ms_e) {
  int ms_ok = ms_tk_get(ms_tk, ms_v, 0) == (import ms_k_id) && ms_e - ms_r > 2 && len(ms_z) > 0;
  string[] ms_o = [];
  if(ms_ok == 1) {
    push(ms_o, ms_mu_row(ms_s, ms_tk, ms_v, ms_v, "ret0", ms_z));
  }
} chain (string ms_s, int[] ms_tk, int ms_r, int ms_e) {
  if(ms_ok == 1 && (ms_y == "int" || ms_y == "word") && ms_z != "[]") {
    push(ms_o, ms_mu_row(ms_s, ms_tk, ms_v, ms_v, "ret1", "1"));
  }
} return string[] ms_o;
