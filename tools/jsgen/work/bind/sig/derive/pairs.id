// A definition's parameters as one flat list, [name, type, name, type, ...], and
// the first whose type is not one that crosses the boundary: int, float, word,
// string, bytes, or a list of int, float or string.

jg_pairs(string[] jg_dr) {
  string[] jg_fl = [];
  int jg_i = 3;
  while (jg_i < len(jg_dr)) {
    list_string_extend(jg_fl, jg_param(jg_dr[jg_i]));
    jg_i = jg_i + 1;
  }
} return string[] jg_fl;
(["f", "int", "x:1", "int a", "string[] s"]):(["a", "int", "s", "string[]"])
(["f", "int", "x:1"]):([])
(["f", "int", "x:1", "z"]):(["z", "?"])

jg_bad_at(string[] jg_fl) {
  int jg_at = -1;
  int jg_i = 0;
  while (jg_i < len(jg_fl) && jg_at < 0) {
    if (list_string_index((import jg_supported), jg_fl[jg_i + 1]) < 0) {
      jg_at = jg_i;
    }
    jg_i = jg_i + 2;
  }
} return int jg_at;
(["a", "int", "s", "string[]"]):(-1)
(["a", "int", "b", "bytes"]):(-1)
(["a", "int", "b", "bytes[]"]):(2)
(["a", "int", "s", "string[][]"]):(2)
(["z", "?"]):(0)
([]):(-1)

jg_ret_bad(string jg_ty) {
  int jg_bad = jg_ty == "" || (jg_ty != "void" && list_string_index((import jg_supported), jg_ty) < 0);
} return int jg_bad;
("int[]"):(0)
("bytes"):(0)
("bytes[]"):(1)
("void"):(0)
(""):(1)
("string[][]"):(1)
("Point"):(1)
