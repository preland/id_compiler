// What one definition becomes: a sig row [name, return type, "file:line", then
// name and type of each parameter], or, when it cannot cross the boundary, a skip
// row [name, why].

jg_sig_row(string[] jg_dr, string[] jg_fl) {
  string[] jg_sr = [jg_dr[0], jg_dr[1], jg_dr[2]];
  list_string_extend(jg_sr, jg_fl);
} return string[] jg_sr;
(["f", "int", "x:1", "int a"], ["a", "int"]):(["f", "int", "x:1", "a", "int"])
(["g", "void", "y:2"], []):(["g", "void", "y:2"])

jg_derive_one(string[] jg_dr, string[][] jg_sigs, string[][] jg_skips) {
  string[] jg_fl = jg_pairs(jg_dr);
  int jg_bad = jg_bad_at(jg_fl);
  int jg_rbad = jg_ret_bad(jg_dr[1]);
} chain (string[] jg_dr, string[][] jg_sigs, string[][] jg_skips) {
  if (jg_bad >= 0) {
    push(jg_skips, [jg_dr[0], jg_why_param(jg_fl, jg_bad)]);
  } else if (jg_rbad == 1) {
    push(jg_skips, [jg_dr[0], jg_why_ret(jg_dr[1])]);
  }
  if (jg_bad < 0 && jg_rbad == 0) {
    push(jg_sigs, jg_sig_row(jg_dr, jg_fl));
  }
} return void;
(["f", "int", "x:1", "int a"], [], []):(["f", "int", "x:1", "int a"], [["f", "int", "x:1", "a", "int"]], [])
(["f", "int", "x:1", "Point p"], [], []):(["f", "int", "x:1", "Point p"], [], [["f", "parameter 'p' has type Point, which does not cross the boundary (int, float, word, string, bytes and lists of int, float or string do)"]])
(["f", "", "x:1", "int a"], [], []):(["f", "", "x:1", "int a"], [], [["f", "it returns null, which does not cross the boundary"]])
(["f", "string[][]", "x:1", "Point p"], [], []):(["f", "string[][]", "x:1", "Point p"], [], [["f", "parameter 'p' has type Point, which does not cross the boundary (int, float, word, string, bytes and lists of int, float or string do)"]])
