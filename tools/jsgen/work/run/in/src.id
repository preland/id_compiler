// The source files, and what is checked once the module and the signatures are
// known: the command line itself, and the two refusals about the names conf.id
// listed.

jg_usage_err(string[] jg_cf, string[] jg_errs) {
  if (jg_cf[(import jg_c_wasm)] == "" || jg_cf[(import jg_c_glue)] == "") {
    push(jg_errs, (import jg_usage));
  }
} return void;
