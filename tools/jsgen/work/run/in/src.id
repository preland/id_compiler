jg_read_src(string[] jg_sl, string[][] jg_defs, string[] jg_errs) {
  string jg_unr = "";
  if (len(jg_errs) == 0) {
    jg_unr = jg_unreadable(jg_sl);
  }
  blank;
} chain (string[] jg_sl, string[][] jg_defs, string[] jg_errs) {
  if (jg_unr != "") {
    push(jg_errs, "cannot read " + jg_unr);
  } else if (len(jg_errs) == 0) {
    jg_defs_add(jg_defs, jg_defs_load(jg_sl));
  }
} return void;
given jg_t_proj ([(import jg_t_src)], [], []):([(import jg_t_src)], [["twice", "int", "api.id:1", "int a"], ["bad", "int", "api.id:4", "string[][] g"]], [])
