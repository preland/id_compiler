jg_check(string[] jg_cf, string[] jg_exps, string[][] jg_skips, string[] jg_errs) {
  string jg_e1 = jg_names_err(jg_cf[(import jg_c_names)], jg_exps);
  string jg_e2 = jg_strict_err(jg_cf[(import jg_c_strict)], jg_skips);
  blank;
} chain (string[] jg_cf, string[] jg_exps, string[][] jg_skips, string[] jg_errs) {
  if (len(jg_errs) == 0 && jg_e1 != "") {
    push(jg_errs, jg_e1);
  } else if (len(jg_errs) == 0 && jg_e2 != "") {
    push(jg_errs, jg_e2);
  }
} return void;
