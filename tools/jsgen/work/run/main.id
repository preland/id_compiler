jg_run(string[] jg_cf, string[] jg_sl) {
  string[] jg_errs = [];
  jg_usage_err(jg_cf, jg_errs);
  if (len(jg_errs) == 0) {
    jg_work(jg_cf, jg_sl, jg_errs);
  }
} chain (string[] jg_cf, string[] jg_sl) {
  int jg_rc = 0;
  if (len(jg_errs) > 0) {
    eprint("idc: jsbind: " + jg_errs[0]);
    jg_rc = 1;
  }
} return int jg_rc;
