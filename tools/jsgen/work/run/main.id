// jsgen: the generator for a wasm module's JS bindings. Reads the wasm binary's
// imports and exports, the natives map, the runtime glue.mjs and the source
// files' signatures, and writes <name>.mjs, <name>.d.mts and <name>.d.ts.

jg_work(string[] jg_cf, string[] jg_sl, string[] jg_errs) {
  string[][] jg_in = jg_lists(4);
  string[][] jg_ub = jg_lists(4);
  string[][] jg_defs = [];
} chain (string[] jg_cf, string[] jg_sl, string[] jg_errs) {
  string[][] jg_sigs = [];
  string[][] jg_skips = [];
  jg_read_wasm(jg_cf, jg_in, jg_errs);
} chain (string[] jg_cf, string[] jg_sl, string[] jg_errs) {
  jg_read_nat(jg_cf, jg_in, jg_errs);
  jg_read_src(jg_sl, jg_defs, jg_errs);
  jg_derive(jg_defs, jg_in[2], jg_sigs, jg_skips);
} chain (string[] jg_cf, string[] jg_sl, string[] jg_errs) {
  jg_check(jg_cf, jg_in[2], jg_skips, jg_errs);
  jg_imports_all(jg_in[0], jg_in[1], jg_in[3], jg_ub, jg_errs);
  jg_emit_glue(jg_cf, jg_sigs, jg_ub, jg_errs);
} chain (string[] jg_cf, string[] jg_sl, string[] jg_errs) {
  jg_emit_dts(jg_cf, jg_sigs, jg_skips, jg_errs);
  jg_say(jg_cf, jg_sigs, jg_skips, jg_ub, jg_errs);
} return void;
