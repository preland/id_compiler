jg_emit_glue(string[] jg_cf, string[][] jg_sigs, string[][] jg_ub, string[] jg_errs) {
  string jg_pre = jg_prefix(jg_cf[(import jg_c_wasm)], jg_cf[(import jg_c_out)]);
  string jg_gt = "";
  if (len(jg_errs) == 0) {
    jg_gt = jg_make_glue(jg_cf, jg_sigs, jg_ub, jg_errs);
  }
} chain (string[] jg_cf, string[][] jg_sigs, string[][] jg_ub, string[] jg_errs) {
  if (len(jg_errs) == 0) {
    jg_write(jg_pre + ".mjs", jg_gt, jg_errs);
  }
} return void;
