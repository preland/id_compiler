// Writing the module: glue.mjs with this build's facts in its four //@gen
// lines and the JS module of each backend the wasm reaches appended.

jg_write(string jg_dst, string jg_tx, string[] jg_errs) {
  int jg_wr = fs_save(jg_dst, mem_of_str(jg_tx), len(jg_tx));
  if (jg_wr < 0) {
    push(jg_errs, "cannot write " + jg_dst);
  }
} return void;
given jg_t_proj ((import jg_t_glue), "hello", []):((import jg_t_glue), "hello", []) then jg_t_nlines:(1)
("/nonexistent/jg/out.mjs", "x", []):("/nonexistent/jg/out.mjs", "x", ["cannot write /nonexistent/jg/out.mjs"])

jg_make_glue(string[] jg_cf, string[][] jg_sigs, string[][] jg_ub, string[] jg_errs) {
  string[] jg_ls = string_split(fs_read_text(jg_cf[(import jg_c_glue)]), "\n");
  string jg_name = path_base(jg_prefix(jg_cf[(import jg_c_wasm)], jg_cf[(import jg_c_out)]));
  string[] jg_tl = jg_glue_texts(jg_name, jg_sigs, jg_ub);
} chain (string[] jg_cf, string[][] jg_sigs, string[][] jg_ub, string[] jg_errs) {
  jg_glue_apply(jg_ls, jg_tl, jg_cf[(import jg_c_glue)], jg_errs);
  string[] jg_bodies = [];
  if (len(jg_errs) == 0) {
    jg_be_all(jg_ub[2], jg_ub[3], jg_bodies, jg_errs);
  }
} chain (string[] jg_cf, string[][] jg_sigs, string[][] jg_ub, string[] jg_errs) {
  string jg_gt = "";
  if (len(jg_errs) == 0) {
    jg_gt = jg_glue_text(path_base(jg_cf[(import jg_c_wasm)]), jg_ls, jg_bodies);
  }
} return string jg_gt;
