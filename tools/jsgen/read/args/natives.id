// The natives map: one `NATIVE TAB BACKEND TAB JSFILE` row per line, empty lines
// skipped. When a native appears twice the later row is the one that counts.

jg_field(string jg_rs, int jg_k) {
  string[] jg_fs = str_split(jg_rs, "\t");
  string jg_fv = lst_str_get_or(jg_fs, jg_k, "");
} return string jg_fv;
("a\tb\tc", 1):("b")
("a\tb", 2):("")
("a", 0):("a")

jg_nat_rows(string jg_t) {
  string[] jg_ls = str_split(jg_t, "\n");
  string[] jg_xs = [];
  int jg_i = 0;
} chain (string jg_t) {
  while (jg_i < len(jg_ls)) {
    if (jg_ls[jg_i] != "") {
      push(jg_xs, jg_ls[jg_i]);
    }
    jg_i = jg_i + 1;
  }
} return string[] jg_xs;
("a\tb\tc\n\nd\te\tf\n"):(["a\tb\tc", "d\te\tf"])
(""):([])

jg_nat_at(string[] jg_rows, string jg_nm) {
  int jg_at = -1;
  int jg_i = 0;
  while (jg_i < len(jg_rows)) {
    if (jg_field(jg_rows[jg_i], 0) == jg_nm) {
      jg_at = jg_i;
    }
    jg_i = jg_i + 1;
  }
} return int jg_at;
(["a\tb\tc", "d\te\tf"], "d"):(1)
(["a\tb\tc", "a\te\tf"], "a"):(1)
(["a\tb\tc"], "z"):(-1)
