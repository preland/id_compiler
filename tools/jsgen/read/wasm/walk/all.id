// The imports and exports of a wasm binary, in the order the binary lists
// them: the module and field name of each import, and the name of each export.

jg_wasm(int[] jg_b, string[] jg_mods, string[] jg_names, string[] jg_exps) {
  int jg_p = (import jg_wasm_hdr);
  while (jg_p < len(jg_b)) {
    jg_sec_take(jg_b, jg_p, jg_mods, jg_names, jg_exps);
    jg_p = jg_sec_end(jg_b, jg_p);
  }
} return void;
