// Where a wasm import's descriptor ends, for each of the five kinds (0 function,
// 1 table, 2 memory, 3 global, 4 tag). Only the length matters: the reader
// wants the names around it.

jg_lim_end(int[] jg_b, int jg_p) {
  int jg_e = jg_p + 1 + jg_leb_len(jg_b, jg_p + 1);
  if ((jg_b[jg_p] & 1) == 1) {
    int jg_mx = jg_leb_len(jg_b, jg_e);
    jg_e = jg_e + jg_mx;
  }
} return int jg_e;
([0, 5, 9], 0):(2)
([1, 5, 129, 1, 9], 0):(4)
([9, 1, 5, 7, 9], 1):(4)

jg_desc_end(int[] jg_b, int jg_p, int jg_kd) {
  int jg_e = jg_p;
  if (jg_kd == 0) {
    jg_e = jg_p + jg_leb_len(jg_b, jg_p);
  } else if (jg_kd == 1) {
    jg_e = jg_lim_end(jg_b, jg_p + 1);
  }
} chain (int[] jg_b, int jg_p, int jg_kd) {
  if (jg_kd == 2) {
    jg_e = jg_lim_end(jg_b, jg_p);
  } else if (jg_kd == 3) {
    jg_e = jg_p + 2;
  }
  if (jg_kd == 4) {
    jg_e = jg_p + 1 + jg_leb_len(jg_b, jg_p + 1);
  }
} return int jg_e;
([200, 1, 9], 0, 0):(2)
([112, 0, 1, 9], 0, 1):(3)
([1, 1, 2, 9], 0, 2):(3)
([127, 1, 9], 0, 3):(2)
([0, 200, 1, 9], 0, 4):(3)
([9, 9], 0, 7):(0)
