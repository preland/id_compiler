// The end of a balanced pair of brackets, as the scanner reads them: a `//`
// comment runs to the end of its line and a string literal to its closing
// quote, and brackets inside either are not counted. The state is [position,
// depth, end]: the end is -1 until the bracket that closes the pair is found.

jg_mc_step(string jg_t, int[] jg_st, int jg_open, int jg_close) {
  int jg_i = jg_st[0];
  int jg_c = character_code_at(jg_t, jg_i);
  jg_st[0] = jg_i + 1;
} chain (string jg_t, int[] jg_st, int jg_open, int jg_close) {
  if (jg_c == (import jg_slash) && character_code_at(jg_t, jg_i + 1) == (import jg_slash)) {
    jg_st[0] = string_end_of_line(jg_t, jg_i) + 1;
  } else if (jg_c == (import jg_quote)) {
    jg_st[0] = jg_str_end(jg_t, jg_i + 1) + 1;
  }
  if (jg_c == jg_open) {
    jg_st[1] = jg_st[1] + 1;
  }
} chain (string jg_t, int[] jg_st, int jg_open, int jg_close) {
  if (jg_c == jg_close) {
    jg_st[1] = jg_st[1] - 1;
    jg_mc_done(jg_st, jg_i);
  }
} return void;
("(a)", [0, 0, -1], 40, 41):("(a)", [1, 1, -1], 40, 41)
("(a)", [2, 1, -1], 40, 41):("(a)", [3, 0, 3], 40, 41)
("// )\n", [0, 0, -1], 40, 41):("// )\n", [5, 0, -1], 40, 41)
("\"a)\"x", [0, 0, -1], 40, 41):("\"a)\"x", [4, 0, -1], 40, 41)

jg_mc_done(int[] jg_st, int jg_i) {
  if (jg_st[1] == 0) {
    jg_st[2] = jg_i + 1;
  }
} return void;
([5, 0, -1], 7):([5, 0, 8])
([5, 1, -1], 7):([5, 1, -1])

jg_match_close(string jg_t, int jg_i, int jg_open, int jg_close) {
  int[] jg_st = [jg_i, 0, -1];
  while (jg_st[0] < len(jg_t) && jg_st[2] < 0) {
    jg_mc_step(jg_t, jg_st, jg_open, jg_close);
  }
  int jg_e = jg_st[2];
} return int jg_e;
("(a(b)c) d", 0, 40, 41):(7)
("(a // )\n b) c", 0, 40, 41):(11)
("{ \"}\" }", 0, 123, 125):(7)
("(a", 0, 40, 41):(-1)
