// The parameter list between a definition's parentheses, split at the commas
// that are not inside (...) or [...], each piece trimmed. The state is [start of
// the piece, depth].

jg_piece(string jg_s, int jg_lo, int jg_hi) {
  string jg_mid = str_slice(jg_s, jg_lo, jg_hi - jg_lo);
  string jg_tr = str_trim(jg_mid);
} return string jg_tr;
("a, b ", 2, 5):("b")
("abc", 0, 2):("ab")

jg_par_step(string jg_s, int jg_i, int[] jg_st, string[] jg_xs) {
  int jg_c = charat(jg_s, jg_i);
  jg_st[1] = jg_st[1] + (jg_c == (import jg_lparen) || jg_c == (import jg_lbrack)) - (jg_c == (import jg_rparen) || jg_c == (import jg_rbrack));
  if (jg_c == (import jg_comma) && jg_st[1] == 0) {
    push(jg_xs, jg_piece(jg_s, jg_st[0], jg_i));
    jg_st[0] = jg_i + 1;
  }
} return void;
("a,b", 1, [0, 0], []):("a,b", 1, [2, 0], ["a"])
("f(a,b),c", 3, [0, 1], []):("f(a,b),c", 3, [0, 1], [])
("a, b", 1, [0, 0], []):("a, b", 1, [2, 0], ["a"])
("(a", 0, [0, 0], []):("(a", 0, [0, 1], [])

jg_params(string jg_s) {
  string[] jg_xs = [];
  int[] jg_st = [0, 0];
  int jg_i = 0;
} chain (string jg_s) {
  while (jg_i < len(jg_s)) {
    jg_par_step(jg_s, jg_i, jg_st, jg_xs);
    jg_i = jg_i + 1;
  }
  string jg_last = jg_piece(jg_s, jg_st[0], len(jg_s));
  if (jg_last != "") {
    push(jg_xs, jg_last);
  }
} return string[] jg_xs;
("int a, int[] b"):(["int a", "int[] b"])
("func(int, int) return int f, int x"):(["func(int, int) return int f", "int x"])
("a,,b"):(["a", "", "b"])
(""):([])
("  "):([])
