// Stepping over a run of one kind of character, from position i: the position
// of the first that is not of it.

jg_skip_hs(string jg_t, int jg_i) {
  while (character_code_at(jg_t, jg_i) == (import jg_space) || character_code_at(jg_t, jg_i) == (import jg_tab)) {
    jg_i = jg_i + 1;
  }
} return int jg_i;
("a  \tb", 1):(4)
("a\nb", 1):(1)

jg_skip_ws(string jg_t, int jg_i) {
  while (jg_ws(character_code_at(jg_t, jg_i)) == 1) {
    jg_i = jg_i + 1;
  }
} return int jg_i;
("a \n\tb", 1):(4)
("ab", 1):(1)
("a ", 1):(2)

jg_ident_end(string jg_t, int jg_i) {
  while (jg_isid(character_code_at(jg_t, jg_i)) == 1) {
    jg_i = jg_i + 1;
  }
} return int jg_i;
("ab_9 c", 0):(4)
("ab_9 c", 5):(6)
(" x", 0):(0)
