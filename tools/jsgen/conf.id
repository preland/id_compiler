// jsgen writes <name>.mjs, <name>.d.mts and <name>.d.ts beside an id-built
// <name>.wasm: the JS module (tools/jsbind/glue.mjs with this build's facts in
// its //@gen lines and the JS module of every backend whose native the wasm
// imports appended) and the TypeScript view of the exported functions'
// signatures. `idc --target wasm` runs it; docs/INTEROP.md, "id and
// JavaScript", says what the output means.
//
//   jsgen --wasm FILE --glue glue.mjs [--natives MAP] [--out PREFIX] [--strict 1] [--names A,B] --src FILE...
//
// MAP lines are NATIVE TAB BACKEND TAB JSFILE. --strict 1 (a build driven by
// conf.id's lib_exports) makes an export that cannot be bound an error rather
// than a comment in the .d.ts, and --names says which functions the list named,
// so one the module does not contain is an error too. The signatures are read
// from the --src files with a scanner, not a parser: a definition is
// `name(params) {`, its body is the balanced braces after it, and its type is
// the first word of the `} return TYPE ...;` that closes it (docs/PROJECT.md
// section 3 for `chain`). Exit status: 0 on success, 1 on any refusal.
int jg_slash = 47;
int jg_quote = 34;
int jg_bslash = 92;
int jg_lbrace = 123;
int jg_rbrace = 125;
int jg_lparen = 40;
int jg_rparen = 41;
int jg_space = 32;
int jg_tab = 9;
int jg_comma = 44;
int jg_lbrack = 91;
int jg_rbrack = 93;
int jg_under = 95;
int jg_nl = 10;
int jg_dot = 46;
int jg_wasm_hdr = 8;
int jg_sec_import = 2;
int jg_sec_export = 7;
int jg_ret_window = 200;

string[] jg_kw = ["chain", "given", "then", "native", "stdin", "timeout", "asm"];
string[] jg_supported = ["int", "float", "word", "string", "bytes", "int[]", "float[]", "string[]"];
string[] jg_ts_from = ["int", "float", "word", "string", "bytes", "void", "int[]", "float[]", "string[]"];
string[] jg_ts_to = ["number", "number", "bigint", "string", "Uint8Array", "void", "number[]", "number[]", "string[]"];
string[] jg_ts_reserved = ["break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do", "else", "enum", "export", "extends", "false", "finally", "for", "function", "if", "import", "in", "instanceof", "new", "null", "return", "super", "switch", "this", "throw", "true", "try", "typeof", "var", "void", "while", "with", "yield", "let", "static", "implements", "interface", "package", "private", "protected", "public", "await", "async"];
string[] jg_api_reserved = ["raw", "memory", "alive", "dispose", "run"];
string[] jg_skip_exports = ["id_alloc", "id_str_of_cstr", "id_store_span"];
string[] jg_gen_tags = ["NAME", "SIGS", "NATIVES", "BACKENDS"];

string jg_usage = "usage: jsgen --wasm FILE --glue glue.mjs [--natives MAP] [--out PREFIX] [--strict 1] [--names A,B] --src FILE...";
string jg_glue_head = "// Generated by idc --target wasm from @W. Do not edit; rebuild instead.\n// The JS runtime is idc/tools/jsbind/glue.mjs; the backend modules at the end are the\n// wasm_js files of the backends this program reaches (docs/INTEROP.md).\n";

string[] jg_dts_head = ["// Generated by idc --target wasm from @W. Do not edit; rebuild instead.", "", "export class IdTrap extends Error {", "  /** \"exit\": the program called exit (a runtime check failed, or main returned); \"trap\": the wasm trapped; \"stack\": recursion too deep. */", "  kind: \"exit\" | \"trap\" | \"stack\";", "  /** The exit status; 1 for a trap. */", "  code: number;", "  /** The last stderr line the program wrote before it died, e.g. \"id: index 5 out of bounds (len 3)\". */", "  stderr: string;", "}", "", "export interface MemFs { [method: string]: (...args: any[]) => any }", "export function createMemFs(files?: Record<string, string | Uint8Array>): MemFs;", "", "export interface IdOptions {", "  /** Bytes the program writes to stdout / stderr. Default: the process's own, or console.log / console.error by line in a browser. */", "  stdout?: (bytes: Uint8Array) => void;", "  stderr?: (bytes: Uint8Array) => void;", "  /** What the program reads from stdin: text, bytes, or a function that returns up to n bytes (empty at end). Default: the process's stdin in Node, empty in a browser. */", "  stdin?: string | Uint8Array | ((n: number) => Uint8Array);"];

string jg_dts_args = "  /** argv for the program (default [\"@N\"]). */";

string[] jg_dts_mid = ["  args?: string[];", "  /** The environment the program sees (default: a copy of process.env in Node, empty in a browser). */", "  env?: Record<string, string>;", "  /** The file system fs_* natives use: Node's `fs` (the default in Node), \"memory\" or createMemFs() (the default in a browser), or any object with the same synchronous methods. */", "  fs?: \"node\" | \"memory\" | MemFs | object;", "  /** A clock in milliseconds, replacing the real one (for deterministic runs). */", "  clock?: () => number;", "  /** How sleep_ms waits. */", "  sleep?: (ms: number) => void;", "  /** How fs_run runs a shell command; returns its wait status. Default: /bin/sh in Node, none in a browser. */", "  run?: (cmd: string) => number;", "  /** Release each string and list argument after its call: true for every function, or the names of the functions to do it for. Only safe for a function that does not keep its arguments (store them in an export or in another list); the compiler cannot tell you which. Default: none, so every argument stays allocated until dispose(). */", "  freeArgs?: boolean | string[];", "}", "", "export interface IdApi {"];

string[] jg_dts_tail = ["}", "", "export interface IdInstance extends IdApi {", "  /** Every export of the wasm module, untyped. */", "  raw: WebAssembly.Exports;", "  memory: WebAssembly.Memory;", "  /** False once a call has trapped or exited, or dispose() has run. */", "  readonly alive: boolean;", "  /** Close open files and remove fs_drop_exit paths. The instance is dead afterwards. */", "  dispose(): void;", "  /** Run a program with a main (its _start) and return its exit status. */", "  run(argv?: string[]): number;", "}", "", "export function load(source?: string | URL | Response | ArrayBuffer | ArrayBufferView | WebAssembly.Module, options?: IdOptions): Promise<IdInstance>;"];

