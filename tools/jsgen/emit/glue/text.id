// The text of the four replaced lines, in the order of jg_gen_tags, and the
// whole generated module.

jg_glue_texts(string jg_name, string[][] jg_sigs, string[][] jg_ub) {
  string jg_l1 = "const IDW_NAME = " + jg_json(jg_name) + ";";
  string jg_l2 = "const IDW_SIGS = " + jg_json_sigs(jg_sigs) + ";";
  string jg_l3 = "const IDW_NATIVES = " + jg_json_map(jg_ub[0], jg_ub[1]) + ";";
} chain (string jg_name, string[][] jg_sigs, string[][] jg_ub) {
  string jg_l4 = "const IDW_BACKENDS_BY_NAME = " + jg_json_be(jg_ub[2]) + ";";
  string[] jg_tl = [jg_l1, jg_l2, jg_l3, jg_l4];
} return string[] jg_tl;
("t", [["f", "int", "x:1", "a", "int"]], [["n"], ["b"], ["b"], ["b.mjs"]]):(["const IDW_NAME = \"t\";", "const IDW_SIGS = {\"f\":{\"params\":[[\"a\",\"int\"]],\"ret\":\"int\"}};", "const IDW_NATIVES = {\"n\":\"b\"};", "const IDW_BACKENDS_BY_NAME = { \"b\": idw_be_b };"])
("p\"q", [], [[], [], [], []]):(["const IDW_NAME = \"p\\\"q\";", "const IDW_SIGS = {};", "const IDW_NATIVES = {};", "const IDW_BACKENDS_BY_NAME = {  };"])

jg_glue_text(string jg_wbase, string[] jg_ls, string[] jg_bodies) {
  string jg_hd = string_replace((import jg_glue_head), "@W", jg_wbase);
  string jg_mid = string_join(jg_ls, "\n");
  string jg_tx = jg_hd + jg_mid + string_join(jg_bodies, "");
} return string jg_tx;
("a.wasm", ["x", "y"], []):("// Generated by idc --target wasm from a.wasm. Do not edit; rebuild instead.\n// The JS runtime is idc/tools/jsbind/glue.mjs; the backend modules at the end are the\n// wasm_js files of the backends this program reaches (docs/INTEROP.md).\nx\ny")
("b.wasm", ["x"], ["\n// ---- backend z"]):("// Generated by idc --target wasm from b.wasm. Do not edit; rebuild instead.\n// The JS runtime is idc/tools/jsbind/glue.mjs; the backend modules at the end are the\n// wasm_js files of the backends this program reaches (docs/INTEROP.md).\nx\n// ---- backend z")
