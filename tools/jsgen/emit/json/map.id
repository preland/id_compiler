// The natives a module uses, and its backends, as the generated module holds
// them: {"native":"backend",...} and { "backend": idw_be_backend, ... }.

jg_json_map(string[] jg_ks, string[] jg_vs) {
  string[] jg_ps = [];
  int jg_i = 0;
  while (jg_i < len(jg_ks)) {
    push(jg_ps, jg_json(jg_ks[jg_i]) + ":" + jg_json(jg_vs[jg_i]));
    jg_i = jg_i + 1;
  }
} chain (string[] jg_ks, string[] jg_vs) {
  string jg_all = "{" + str_join(jg_ps, ",") + "}";
} return string jg_all;
(["fs_open", "fs_read"], ["fs", "fs"]):("{\"fs_open\":\"fs\",\"fs_read\":\"fs\"}")
([], []):("{}")

jg_json_be(string[] jg_ks) {
  string[] jg_ps = [];
  int jg_i = 0;
  while (jg_i < len(jg_ks)) {
    push(jg_ps, jg_json(jg_ks[jg_i]) + ": idw_be_" + jg_ident(jg_ks[jg_i]));
    jg_i = jg_i + 1;
  }
} chain (string[] jg_ks) {
  string jg_all = "{ " + str_join(jg_ps, ", ") + " }";
} return string jg_all;
(["fs", "my-env"]):("{ \"fs\": idw_be_fs, \"my-env\": idw_be_my_env }")
([]):("{  }")
