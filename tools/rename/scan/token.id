// The renamer reads source the way the language's lexer does, only far enough to
// know which runs of characters are identifiers: a name inside a string literal
// or after `//` is prose, and renaming it would change a program's output.
//
// The lexer cannot be called as a library: idlex is a program that reads a
// pipe and prints token kinds, and it reports no byte offsets, which a rewrite
// needs. The three decisions it makes about where a token ends are repeated here.

// The end of the run of letters, digits and underscores that starts at an
// index; the index itself when the character there is not one of those. A
// number is a run too (`0xff`, `1e5`), so a letter inside a number is never
// taken for the start of a name.
rename_run_end(string rename_source, int rename_index) {
  while(chr_is_alnum(charat(rename_source, rename_index)) || charat(rename_source, rename_index) == 95) {
    rename_index = rename_index + 1;
  }
} return int rename_index;
("ab_1 x", 0):(4)
("ab_1 x", 4):(4)
("x12", 1):(3)
("", 0):(0)

// The index just past the string literal whose opening quote is at the index.
// A backslash escapes the next character, so `\"` does not end the string. A
// literal with no closing quote runs to the end of the text.
rename_string_end(string rename_source, int rename_index) {
  int rename_at = rename_index + 1;
  while(charat(rename_source, rename_at) != 34 && charat(rename_source, rename_at) != -1) {
    rename_at = rename_at + 1 + (charat(rename_source, rename_at) == 92);
  }
  int rename_end = rename_at + (charat(rename_source, rename_at) == 34);
} return int rename_end;
("\"ab\" x", 0):(4)
("\"a\\\"b\" x", 0):(6)
("\"ab", 0):(3)

// The end of a token that is not a name or a number: a `//` comment to the end
// of its line, a string literal, or a single character of anything else.
rename_other_end(string rename_source, int rename_index) {
  int rename_end = rename_index + 1;
  if(charat(rename_source, rename_index) == 47 && charat(rename_source, rename_index + 1) == 47) {
    rename_end = str_eol(rename_source, rename_index);
  }
  if(charat(rename_source, rename_index) == 34) {
    rename_end = rename_string_end(rename_source, rename_index);
  }
} return int rename_end;
("// hi\nx", 0):(5)
("\"a b\" c", 0):(5)
("+x", 0):(1)
("a / b", 2):(3)
