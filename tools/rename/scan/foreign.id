// A native function is bound by name outside the id files: a C symbol is `id_`
// and the native's name (clk.h, clk_posix.c), and a JavaScript module answers it
// under the native's own name (clk.mjs). A rename that skipped those files left
// them stale and the build broken until someone ran sed by hand.
//
// These files are not id source, so they are read as plain text: every identifier
// counts, in code, comments and strings alike, because a comment that names a
// symbol should follow it. The span of an `id_` identifier is the part after the
// prefix, so a rename of `clock_error` rewrites `id_clock_error` to `id_` and the
// new name. A bare identifier is taken only in JavaScript, where the key has no
// prefix; in C a bare `read` is the C library's, not the id function's.

// Steps over one token, recording an identifier that starts with `id_`, or any
// identifier when bare is 1. Answers the index to continue from.
rename_foreign_next(string rename_source, int rename_index, int[] rename_spans, int[] rename_cells, int rename_bare) {
  int rename_end = rename_run_end(rename_source, rename_index);
  int rename_name_start = rename_index + 3 * (character_code_at(rename_source, rename_index) == 105 && character_code_at(rename_source, rename_index + 1) == 100 && character_code_at(rename_source, rename_index + 2) == 95 && rename_end > rename_index + 3);
  int rename_takes = (character_is_alpha(character_code_at(rename_source, rename_index)) || character_code_at(rename_source, rename_index) == 95) && (rename_name_start > rename_index || rename_bare == 1);
} chain (string rename_source, int rename_index, int[] rename_spans, int[] rename_cells, int rename_bare) {
  if(rename_takes == 1) {
    rename_mark(rename_source, rename_name_start, rename_end, rename_spans, rename_cells);
  }
  if(rename_end == rename_index) {
    rename_end = rename_index + 1;
  }
} return int rename_end;
("id_ab cd", 0, [], [0, 1], 0):(5)
("id_ab cd", 6, [], [0, 1], 0):(8)
("+", 0, [], [0, 1], 1):(1)

// The names of a foreign text as (start, end, line) triples.
rename_foreign_spans(string rename_source, int rename_bare) {
  int[] rename_spans = [];
  int[] rename_cells = [0, 1];
  int rename_index = 0;
} chain (string rename_source, int rename_bare) {
  while(rename_index < len(rename_source)) {
    rename_index = rename_foreign_next(rename_source, rename_index, rename_spans, rename_cells, rename_bare);
  }
} return int[] rename_spans;
("id_ab = cd; /* id_ef */", 0):([3, 5, 1, 18, 20, 1])
("id_ab = cd; /* id_ef */", 1):([3, 5, 1, 8, 10, 1, 18, 20, 1])
("a\nid_b 1e5", 0):([5, 6, 2])
("id_ id_x", 0):([7, 8, 1])

// The triples for a C header, a C source or a JavaScript module; none for any other file.
rename_native_file_spans(string rename_file, string rename_source) {
  int[] rename_spans = [];
  if(string_ends_with(rename_file, ".mjs") == 1) {
    rename_spans = rename_foreign_spans(rename_source, 1);
  }
  if(string_ends_with(rename_file, ".h") == 1 || string_ends_with(rename_file, ".c") == 1) {
    rename_spans = rename_foreign_spans(rename_source, 0);
  }
} return int[] rename_spans;
("a.mjs", "id_x y"):([3, 4, 1, 5, 6, 1])
("a.c", "id_x y"):([3, 4, 1])
("a.h", "id_x y"):([3, 4, 1])
("a.id", "id_x y"):([])
