// E0311, as a question about one name: which of its `_`-separated pieces are not
// words. The compiler answers it for the whole program under --word-scan; a
// rename has to answer it for a name that is not in the program yet.

// Appends a piece to the list when the table does not hold it. The lookup
// ignores case, as the compiler's does. An empty piece (a leading, trailing or
// doubled underscore) is listed as "(empty)".
rename_note_piece(string[] rename_failing, string rename_piece, int rename_piece_count, string[] rename_word_keys, int[] rename_word_used) {
  string rename_shown = rename_piece;
  if(rename_piece == "") {
    rename_shown = "(empty)";
  }
  if(hmap_has(rename_word_keys, rename_word_used, str_lower(rename_piece)) == 0 && str_is_axis_piece(str_lower(rename_piece), rename_piece_count) == 0) {
    push(rename_failing, rename_shown);
  }
} return void;
given rename_test_words_filled ([], "alpha", 1, (import rename_test_word_keys), (import rename_test_word_used)):([])
given rename_test_words_filled ([], "ALPHA", 1, (import rename_test_word_keys), (import rename_test_word_used)):([])
