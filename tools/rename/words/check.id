given rename_test_words_filled ([], "", 1, (import rename_test_word_keys), (import rename_test_word_used)):(["(empty)"])
given rename_test_words_filled ([], "x", 2, (import rename_test_word_keys), (import rename_test_word_used)):([])
given rename_test_words_filled ([], "q", 2, (import rename_test_word_keys), (import rename_test_word_used)):(["q"])

// The pieces of a name that are not words, as `a, b`; "" when every piece is.
rename_bad_pieces(string rename_name, string[] rename_word_keys, int[] rename_word_used) {
  string[] rename_pieces = str_split(rename_name, "_");
  string[] rename_bad = [];
  int rename_at = 0;
} chain (string rename_name, string[] rename_word_keys, int[] rename_word_used) {
  while(rename_at < len(rename_pieces)) {
    rename_note_piece(rename_bad, rename_pieces[rename_at], len(rename_pieces), rename_word_keys, rename_word_used);
    rename_at = rename_at + 1;
  }
  string rename_listed_pieces = str_join(rename_bad, ", ");
} return string rename_listed_pieces;
given rename_test_words_filled ("alpha_beta", (import rename_test_word_keys), (import rename_test_word_used)):("")
given rename_test_words_filled ("alpha_q_gamma_beta", (import rename_test_word_keys), (import rename_test_word_used)):("q, gamma")
