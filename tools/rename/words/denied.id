// Adds short.txt and allowed.txt of a directory to the table: they are accepted
// whether or not denied.txt names the word.
rename_load_extra(string rename_words_directory, string[] rename_word_keys, int[] rename_word_values, int[] rename_word_used, int[] rename_word_count) {
  string rename_short_text = fs_read_text(path_join(rename_words_directory, "short.txt"));
  string rename_allowed = fs_read_text(path_join(rename_words_directory, "allowed.txt"));
  rename_put_words(rename_short_text, rename_word_keys, rename_word_values, rename_word_used, rename_word_count);
} chain (string rename_words_directory, string[] rename_word_keys, int[] rename_word_values, int[] rename_word_used, int[] rename_word_count) {
  rename_put_words(rename_allowed, rename_word_keys, rename_word_values, rename_word_used, rename_word_count);
} return void;
