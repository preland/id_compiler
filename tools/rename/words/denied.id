// Adds every line of english.txt to the table except the denied words.
rename_put_words_except(string rename_text, string[] rename_word_keys, int[] rename_word_values, int[] rename_word_used, int[] rename_word_count, string[] rename_denied_keys, int[] rename_denied_used) {
  string[] rename_lines = string_lines(rename_text);
  int rename_at = 0;
  while(rename_at < len(rename_lines)) {
    rename_put_unless(rename_lines[rename_at], rename_word_keys, rename_word_values, rename_word_used, rename_word_count, rename_denied_keys, rename_denied_used);
    rename_at = rename_at + 1;
  }
} return void;
