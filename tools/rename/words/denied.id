// The word lists beyond english.txt: the abbreviations denied.txt takes out of it,
// and the real short words and the allowed terms that are read in beside it.

// Adds one line of english.txt to the table unless denied.txt names the word.
rename_put_unless(string rename_entry, string[] rename_word_keys, int[] rename_word_values, int[] rename_word_used, int[] rename_word_count, string[] rename_denied_keys, int[] rename_denied_used) {
  string rename_lowered = string_lower(string_trim(rename_entry));
  if(hash_map_has(rename_denied_keys, rename_denied_used, rename_lowered) == 0) {
    rename_put_word(rename_entry, rename_word_keys, rename_word_values, rename_word_used, rename_word_count);
  }
} return void;
