// Fills the table from the two list files in a directory.
rename_load_words(string rename_words_directory, string[] rename_word_keys, int[] rename_word_values, int[] rename_word_used, int[] rename_word_count) {
  hmap_init(rename_word_keys, rename_word_values, rename_word_used, rename_word_count);
  string rename_vocabulary_words = fs_read_text(path_join(rename_words_directory, "english.txt"));
  string rename_allowed = fs_read_text(path_join(rename_words_directory, "allowed.txt"));
} chain (string rename_words_directory, string[] rename_word_keys, int[] rename_word_values, int[] rename_word_used, int[] rename_word_count) {
  rename_put_words(rename_vocabulary_words, rename_word_keys, rename_word_values, rename_word_used, rename_word_count);
  rename_put_words(rename_allowed, rename_word_keys, rename_word_values, rename_word_used, rename_word_count);
} return void;
