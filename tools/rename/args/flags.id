// The command line: `rename ROOT... --map FILE [--words DIR] [--reserve DIR]...
// [--dry-run]`. The options that take a value are --map, --words and --reserve;
// everything else that does not start with `--` is a root.

// Whether an argument is an option that takes the next argument as its value.
rename_value_flag(string rename_argument) {
  int rename_takes = rename_argument == "--map" || rename_argument == "--words" || rename_argument == "--reserve";
} return int rename_takes;
("--map"):(1)
("--reserve"):(1)
("--dry-run"):(0)
("src"):(0)

// Where the argument after the one at an index is: two on when the argument is an
// option with a value, one on otherwise.
rename_argument_next(string[] rename_argument_values, int rename_at) {
  int rename_next_at = rename_at + 1 + rename_value_flag(rename_argument_values[rename_at]);
} return int rename_next_at;
(["p", "--map", "m", "x"], 1):(3)
(["p", "--dry-run", "x"], 1):(2)
