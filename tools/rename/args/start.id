// From the command line to a run.

// The directory of word lists: the one given, or the compiler's own, found from
// the repository root.
rename_words_choice(string[] rename_argument_values) {
  string[] rename_given = rename_flag_values(rename_argument_values, "--words");
  string rename_chosen = "idc/data/words";
  if(len(rename_given) > 0) {
    rename_chosen = rename_given[0];
  }
} return string rename_chosen;
(["p", "--words", "w"]):("w")
(["p", "src"]):("idc/data/words")

// The function a rename is restricted to (--in), or "" for the whole program.
rename_scope_choice(string[] rename_argument_values) {
  string rename_chosen_scope = list_string_get_or(rename_flag_values(rename_argument_values, "--in"), 0, "");
} return string rename_chosen_scope;
(["p", "--in", "f"]):("f")
(["p", "src"]):("")

// Runs the rename an already checked command line asks for.
rename_from_arguments(string[] rename_argument_values) {
  string[] rename_roots = rename_positional_arguments(rename_argument_values);
  string[] rename_reserved = rename_flag_values(rename_argument_values, "--reserve");
  string rename_words_directory = rename_words_choice(rename_argument_values);
} chain (string[] rename_argument_values) {
  string[] rename_maps = rename_flag_values(rename_argument_values, "--map");
  int rename_dry = list_string_index(rename_argument_values, "--dry-run") >= 0;
  string rename_scope = rename_scope_choice(rename_argument_values);
} chain (string[] rename_argument_values) {
  int rename_code = rename_run(rename_roots, rename_reserved, rename_maps[0], rename_words_directory, rename_dry, rename_scope);
} return int rename_code;
given rename_test_project("") (["p", "src", "--map", "map.txt", "--words", "words", "--dry-run"]):(0) then prints:("src/NAMES.md:1: oldname -> alpha\nsrc/a.id:1: oldname -> alpha\nsrc/a.id:1: oldname -> alpha\n3 name(s) renamed in 2 file(s) (dry run, nothing written)\n")
given rename_test_project("") (["p", "src", "--map", "map.txt"]):(1) then eprints:("rename: no words could be read from idc/data/words (english.txt, allowed.txt)\nrename: oldname -> alpha: the new name is not spelled in words (E0311): alpha\nrename: refused; no file was changed\n")
