// Whether a new name is already in use. A rename that gave a name to something
// else's name would make two things one, and the compiler would either reject
// the program or, when the types agree, accept a program that does something
// different. Every name in the program, declared or only used, counts: a name
// that is used is declared somewhere, in the program, the library or the
// compiler's builtins.

// Counts the name at an index of the spans, when it is one of the new names.
rename_count_one(string rename_source, int[] rename_spans, int rename_at, string[] rename_count_keys, int[] rename_count_values, int[] rename_count_used, int[] rename_count_count) {
  string rename_name = str_sub(rename_source, rename_spans[rename_at], rename_spans[rename_at + 1] - rename_spans[rename_at]);
  if(hash_map_has(rename_count_keys, rename_count_used, rename_name) == 1) {
    hash_map_bump(rename_count_keys, rename_count_values, rename_count_used, rename_count_count, rename_name);
  }
} return void;
