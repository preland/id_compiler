// Counts every name in a source text that is one of the new names.
rename_count_names(string rename_source, string[] rename_count_keys, int[] rename_count_values, int[] rename_count_used, int[] rename_count_count) {
  int[] rename_spans = rename_name_spans(rename_source);
  int rename_at = 0;
  while(rename_at < len(rename_spans)) {
    rename_count_one(rename_source, rename_spans, rename_at, rename_count_keys, rename_count_values, rename_count_used, rename_count_count);
    rename_at = rename_at + 3;
  }
} return void;
