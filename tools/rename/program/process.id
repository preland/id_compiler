// Renaming in one file.

// The triples for a file's names: source files are read as source, the
// registries as markdown tables, and the C and JavaScript files that bind a
// native by name as plain text (scan/foreign.id).
rename_file_spans(string rename_file, string rename_source) {
  int[] rename_spans = rename_native_file_spans(rename_file, rename_source);
  if(str_ends(rename_file, ".id") == 1) {
    rename_spans = rename_name_spans(rename_source);
  }
  if(str_ends(rename_file, ".md") == 1) {
    rename_spans = rename_markdown_spans(rename_source);
  }
} return int[] rename_spans;
("a.id", "x // y"):([0, 1, 1])
("a.mjs", "id_y z"):([3, 4, 1, 5, 6, 1])
("NAMES.md", "x `y`"):([])
("NAMES.md", "| `y` |"):([3, 4, 1])

// Prints each row of a file's changes after the file's name.
rename_print_rows(string rename_file, string[] rename_listed) {
  int rename_at = 0;
  while(rename_at < len(rename_listed)) {
    print(rename_file + ":" + rename_listed[rename_at]);
    rename_at = rename_at + 1;
  }
} return void;
("f.id", ["3: a -> b"]):("f.id", ["3: a -> b"]) then prints:("f.id:3: a -> b\n")
("f.id", []):("f.id", []) then prints:("")

// Renames in one file, prints what it changes and, unless this is a dry run,
// writes the file back. The totals are counted in rename_totals.
rename_in_file(string rename_file, string[] rename_table_keys, int[] rename_table_values, int[] rename_table_used, string[] rename_table_news, int rename_dry, string rename_scope, int[] rename_totals) {
  string rename_source = fs_read_text(rename_file);
  int[] rename_spans = rename_file_spans(rename_file, rename_source);
  string[] rename_picked = rename_pick_all(rename_source, rename_spans, rename_table_keys, rename_table_values, rename_table_used, rename_table_news);
} chain (string rename_file, string[] rename_table_keys, int[] rename_table_values, int[] rename_table_used, string[] rename_table_news, int rename_dry, string rename_scope, int[] rename_totals) {
  rename_scoped_picked(rename_file, rename_source, rename_spans, rename_picked, rename_scope);
  string[] rename_listed = rename_rows(rename_source, rename_spans, rename_picked);
  rename_print_rows(rename_file, rename_listed);
} chain (string rename_file, string[] rename_table_keys, int[] rename_table_values, int[] rename_table_used, string[] rename_table_news, int rename_dry, string rename_scope, int[] rename_totals) {
  rename_store(rename_file, rename_splice(rename_source, rename_spans, rename_picked), len(rename_listed), rename_dry, rename_totals);
} return void;
