// The whole program swept for the new names, and the pairs that would collide.

// Counts the new names in every file of a list.
rename_count_files(string[] rename_files, string[] rename_count_keys, int[] rename_count_values, int[] rename_count_used, int[] rename_count_count) {
  int rename_at = 0;
  while(rename_at < len(rename_files)) {
    rename_count_file(rename_files[rename_at], rename_count_keys, rename_count_values, rename_count_used, rename_count_count);
    rename_at = rename_at + 1;
  }
} return void;
