// The refusals for a map: every pair whose new name is already in the program.
rename_clash_problems(string[] rename_old_names, string[] rename_news, string[] rename_count_keys, int[] rename_count_values, int[] rename_count_used) {
  string[] rename_problems = [];
  int rename_at = 0;
  while(rename_at < len(rename_old_names)) {
    rename_note(rename_problems, rename_clash_one(rename_old_names[rename_at], rename_news[rename_at], rename_count_keys, rename_count_values, rename_count_used));
    rename_at = rename_at + 1;
  }
} return string[] rename_problems;
