// The refusal for one pair whose new name the program already uses: "" when
// it does not.
rename_clash_one(string rename_old, string rename_new, string[] rename_count_keys, int[] rename_count_values, int[] rename_count_used) {
  int rename_uses = hmap_get(rename_count_keys, rename_count_values, rename_count_used, rename_new, 0);
  string rename_problem = "";
  if(rename_uses > 0) {
    rename_problem = rename_old + " -> " + rename_new + ": the new name is already used " + rename_uses + " time(s) in the program";
  }
} return string rename_problem;
