// All the files of a rename, one at a time.

// The source files and registries under every root, root by root.
rename_gather(string[] rename_roots) {
  string[] rename_files = [];
  int rename_at = 0;
  while(rename_at < len(rename_roots)) {
    list_string_extend(rename_files, rename_walk(rename_roots[rename_at]));
    rename_at = rename_at + 1;
  }
} return string[] rename_files;
given rename_test_tree ([".", "sub"]):(["./NAMES.md", "./a.id", "./sub/NOTES.md", "./sub/b.id", "sub/NOTES.md", "sub/b.id"])
([]):([])

// Renames in every file of a list.
rename_apply_files(string[] rename_files, string[] rename_table_keys, int[] rename_table_values, int[] rename_table_used, string[] rename_table_news, int rename_dry, string rename_scope, int[] rename_totals) {
  int rename_at = 0;
  while(rename_at < len(rename_files)) {
    rename_in_file(rename_files[rename_at], rename_table_keys, rename_table_values, rename_table_used, rename_table_news, rename_dry, rename_scope, rename_totals);
    rename_at = rename_at + 1;
  }
} return void;
