// The line that ends a run: how many names changed, in how many files, and
// whether nothing was written.
rename_summary(int[] rename_totals, int rename_dry) {
  string rename_line_out = rename_totals[0] + " name(s) renamed in " + rename_totals[1] + " file(s)";
  if(rename_dry == 1) {
    rename_line_out = rename_line_out + " (dry run, nothing written)";
  }
} return string rename_line_out;
