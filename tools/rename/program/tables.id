// Fills an empty table with the names of a list, each counted zero times.
rename_seed_counts(string[] rename_names, string[] rename_table_keys, int[] rename_table_values, int[] rename_table_used, int[] rename_table_count) {
  hmap_init(rename_table_keys, rename_table_values, rename_table_used, rename_table_count);
  int rename_at = 0;
  while(rename_at < len(rename_names)) {
    hmap_put(rename_table_keys, rename_table_values, rename_table_used, rename_table_count, rename_names[rename_at], 0);
    rename_at = rename_at + 1;
  }
} return void;
