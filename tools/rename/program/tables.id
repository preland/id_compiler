// The two hash tables a rename keeps, each as the four lists the standard
// library's table is: the old names (a value is the position of the name in the
// map, which is where its new name is), and the new names (a value counts how
// often the name is already used in the program).

// Fills an empty table with the names of a list, each with its position.
rename_index_table(string[] rename_names, string[] rename_table_keys, int[] rename_table_values, int[] rename_table_used, int[] rename_table_count) {
  hmap_init(rename_table_keys, rename_table_values, rename_table_used, rename_table_count);
  int rename_at = 0;
  while(rename_at < len(rename_names)) {
    hmap_put(rename_table_keys, rename_table_values, rename_table_used, rename_table_count, rename_names[rename_at], rename_at);
    rename_at = rename_at + 1;
  }
} return void;
given rename_test_words_empty (["a", "b"], (import rename_test_word_keys), (import rename_test_word_values), (import rename_test_word_used), (import rename_test_word_count)):(["a", "b"]) then hmap_get((import rename_test_word_keys), (import rename_test_word_values), (import rename_test_word_used), "b", -1):(1)
