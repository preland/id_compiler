// The two ways a run ends.

// Renames in every file and prints the totals. Answers 0, or 1 when a file could
// not be written.
rename_perform(string[] rename_old_names, string[] rename_news, string[] rename_files, int rename_dry, string rename_scope) {
  string[] rename_table_keys = [];
  int[] rename_table_values = [];
  int[] rename_table_used = [];
} chain (string[] rename_old_names, string[] rename_news, string[] rename_files, int rename_dry, string rename_scope) {
  int[] rename_table_count = [];
  int[] rename_totals = [0, 0, 0];
  rename_index_table(rename_old_names, rename_table_keys, rename_table_values, rename_table_used, rename_table_count);
} chain (string[] rename_old_names, string[] rename_news, string[] rename_files, int rename_dry, string rename_scope) {
  rename_apply_files(rename_files, rename_table_keys, rename_table_values, rename_table_used, rename_news, rename_dry, rename_scope, rename_totals);
  print(rename_summary(rename_totals, rename_dry));
  int rename_failed = rename_totals[2] > 0;
} return int rename_failed;
