// Every problem on standard error, then a closing line. The same for a command
// line that is wrong (the closing line is the usage) and a map that is refused
// (the closing line says nothing was changed).
rename_report(string[] rename_problems, string rename_closing) {
  int rename_at = 0;
  while(rename_at < len(rename_problems)) {
    eprint("rename: " + rename_problems[rename_at]);
    rename_at = rename_at + 1;
  }
  eprint(rename_closing);
} return void;
(["a -> b: bad"], "end"):(["a -> b: bad"], "end") then eprints:("rename: a -> b: bad\nend\n")
(["p", "q"], "stop"):(["p", "q"], "stop") then eprints:("rename: p\nrename: q\nstop\n")
([], "only"):([], "only") then eprints:("only\n")

// Refuses when there are problems, otherwise renames. Answers the exit status:
// 0, or 1 when refused or when a file could not be written.
rename_finish(string[] rename_old_names, string[] rename_news, string[] rename_files, int rename_dry, string rename_scope, string[] rename_problems) {
  int rename_code = 1;
  if(len(rename_problems) == 0) {
    rename_code = rename_perform(rename_old_names, rename_news, rename_files, rename_dry, rename_scope);
  } else {
    rename_report(rename_problems, "rename: refused; no file was changed");
  }
} return int rename_code;
