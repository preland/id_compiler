// iddiag [--format=human|json] [--color=always|never] < DIAGNOSTICS
//
// Reads the diagnostics idc printed (docs/DIAGNOSTICS.md, "the plain format")
// and writes them again for a person -- a source snippet with a caret under the
// text each one names, and its why and help lines -- or, with --format=json, one
// JSON object per line. bin/idc runs it on its own diagnostics; it is also the
// way to re-render a saved log. Lines that are not diagnostics pass through. Each
// diagnostic is also given the function it is in and, after a syntax error, the
// error it follows from (run/sum/mark).

main(int argc, string[] argv) {
  int dg_mn_j = lst_str_index(argv, "--format=json") >= 0;
  int dg_mn_c = lst_str_index(argv, "--color=always") >= 0;
  string dg_mn_t = read_all();
} chain (int argc, string[] argv) {
  dg_run(dg_mn_t, dg_mn_j, dg_mn_c);
} return int 0;
stdin "sample.txt:2: error: bad [E0100]\n  at: count\n" (1, ["iddiag"]):(0) then prints:("error[E0100]: bad\n  --> sample.txt:2:7\n  |\n2 |   int count = 1;\n  |       ^^^^^\nerror: aborting due to 1 previous error\nSome errors have detailed explanations: E0100.\nFor more information about an error, try `idc --explain E0100`.\n")
stdin "sample.txt:2: error: bad\nplain\n" (2, ["iddiag", "--format=json"]):(0) then prints:("{\"kind\":\"diagnostic\",\"severity\":\"error\",\"code\":null,\"file\":\"sample.txt\",\"line\":2,\"column\":null,\"end_column\":null,\"function\":null,\"message\":\"bad\",\"why\":\"\",\"fixes\":[],\"related\":[],\"follows\":null,\"rendered\":\"error: bad\\n  --> sample.txt:2\\n  |\\n2 |   int count = 1;\"}\n{\"kind\":\"text\",\"text\":\"plain\"}\n{\"kind\":\"summary\",\"errors\":1,\"warnings\":0,\"codes\":[]}\n")

dg_run(string dg_rn_t, int dg_rn_j, int dg_rn_c) {
  string[] dg_rn_b = dg_mark(dg_blocks(dg_rn_t));
  dg_print_all(dg_rn_b, dg_rn_j, dg_rn_c);
  string dg_rn_s = dg_summary(dg_rn_b, dg_rn_j);
} chain (string dg_rn_t, int dg_rn_j, int dg_rn_c) {
  if(dg_rn_s != "") {
    print(dg_rn_s);
  }
} return void;
("sample.txt:1: note: n\n", 0, 0):() then prints:("note: n\n  --> sample.txt:1\n  |\n1 | first line\n")
("x\n", 1, 0):() then prints:("{\"kind\":\"text\",\"text\":\"x\"}\n{\"kind\":\"summary\",\"errors\":0,\"warnings\":0,\"codes\":[]}\n")

dg_print_all(string[] dg_pa_b, int dg_pa_j, int dg_pa_c) {
  string[] dg_pa_seen = [];
  int dg_pa_i = 0;
  while(dg_pa_i < len(dg_pa_b)) {
    if(dg_pa_j == 1) {
      print(dg_json(dg_pa_b[dg_pa_i]));
    }
    if(dg_pa_j == 0) {
      print(dg_show_human(dg_pa_b[dg_pa_i], dg_pa_c, dg_pa_seen));
    }
    dg_pa_i = dg_pa_i + 1;
  }
} return void;
(["a"], 0, 0):() then prints:("a\n")
(["a", "b"], 1, 0):() then prints:("{\"kind\":\"text\",\"text\":\"a\"}\n{\"kind\":\"text\",\"text\":\"b\"}\n")
(["sample.txt:1: error: x [E0001]\n  why: w", "sample.txt:3: error: y [E0001]\n  why: w"], 0, 0):() then prints:("error[E0001]: x\n  --> sample.txt:1\n  |\n1 | first line\n  = why: w\nerror[E0001]: y\n  --> sample.txt:3\n  |\n3 | third line\n  = why: (as for the first [E0001] above)\n")
