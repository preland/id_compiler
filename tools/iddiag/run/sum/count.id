// What a stream of diagnostics adds up to: how many errors it holds
// and which error codes appear in it, for the summary line at the end.

dg_nsev(string[] dg_ns_b, string dg_ns_s) {
  int dg_ns_n = 0;
  int dg_ns_i = 0;
  while(dg_ns_i < len(dg_ns_b)) {
    string dg_ns_h = dg_head(dg_ns_b[dg_ns_i]);
    if(dg_ln(dg_ns_h) >= 0 && dg_sev(dg_ns_h) == dg_ns_s) {
      dg_ns_n = dg_ns_n + 1;
    }
    dg_ns_i = dg_ns_i + 1;
  }
} return int dg_ns_n;
(["a.id:1: error: x", "plain", "b.id:2: error: y\n  why: z", "c.id:3: note: n"], "error"):(2)
(["a.id:1: error: x", "plain"], "note"):(0)

// The distinct codes, in the order they first appear.
dg_codes(string[] dg_cd_b) {
  string[] dg_cd_o = [];
  int dg_cd_i = 0;
  while(dg_cd_i < len(dg_cd_b)) {
    dg_code_add(dg_cd_o, dg_head(dg_cd_b[dg_cd_i]));
    dg_cd_i = dg_cd_i + 1;
  }
} return string[] dg_cd_o;
(["a.id:1: error: x [E0002]", "b.id:2: error: y [E0001]", "c.id:3: error: z [E0002]", "d.id:4: error: no code"]):(["E0002", "E0001"])
(["a.id:1: error: x [E0003]", "b.id:2: error: y [E0003]", "c.id:3: error: z [E0004]"]):(["E0003", "E0004"])
([]):([])

dg_code_add(string[] dg_ca_o, string dg_ca_h) {
  string dg_ca_c = dg_code(dg_ca_h);
  if(dg_ca_c != "" && list_string_index(dg_ca_o, dg_ca_c) < 0) {
    push(dg_ca_o, dg_ca_c);
  }
} return void;
([], "a.id:1: error: x [E0001]"):(["E0001"])
(["E0001"], "a.id:1: error: x [E0001]"):(["E0001"])
(["E0001"], "a.id:1: error: x"):(["E0001"])
