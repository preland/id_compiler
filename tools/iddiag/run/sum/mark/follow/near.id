// The earlier syntax error nearest a line of a file: the last one at or above the
// line, or when every one is below it the last one of the file. "" when the file
// has none.

dg_root_near(string[] dg_rn_roots, string dg_rn_f, int dg_rn_n) {
  int dg_rn_best = dg_root_best(dg_rn_roots, dg_rn_f, dg_rn_n);
  int dg_rn_k = dg_rn_best;
  string dg_rn_r = "";
} chain (string[] dg_rn_roots, string dg_rn_f, int dg_rn_n) {
  if(dg_rn_best < 0) {
    dg_rn_k = dg_root_best(dg_rn_roots, dg_rn_f, 0 - 1);
  }
  if(dg_rn_k >= 0) {
    dg_rn_r = dg_rn_roots[dg_rn_k];
  }
} return string dg_rn_r;
(["a.id:2: error: x", "a.id:7: error: y"], "a.id", 9):("a.id:7: error: y")
