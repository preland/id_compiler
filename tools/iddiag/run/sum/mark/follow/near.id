(["b.id:2: error: x"], "a.id", 4):("")

dg_root_best(string[] dg_rb_roots, string dg_rb_f, int dg_rb_n) {
  int dg_rb_i = 0;
  int dg_rb_k = 0 - 1;
  while(dg_rb_i < len(dg_rb_roots)) {
    if(dg_file(dg_rb_roots[dg_rb_i]) == dg_rb_f && (dg_rb_n < 0 || dg_ln(dg_rb_roots[dg_rb_i]) <= dg_rb_n)) {
      dg_rb_k = dg_rb_i;
    }
    dg_rb_i = dg_rb_i + 1;
  }
} return int dg_rb_k;
