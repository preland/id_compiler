// What kind of diagnostic a head line is, for deciding what follows from what.

// A syntax error: the parser's codes are E01xx. A syntax error the compiler has
// not given a code yet is not seen as one, so what follows from it is not tagged.
dg_is_syntax(string dg_sy_h) {
  string dg_sy_c = dg_code(dg_sy_h);
  int dg_sy_r = str_starts(dg_sy_c, "E01");
} return int dg_sy_r;
("a.id:1: error: expected '=' [E0101]"):(1)
("a.id:1: error: undefined variable 'x' [E0301]"):(0)
("a.id:1: error: no code"):(0)

// Whether the first name a message quotes is not a name: a punctuation mark or a
// number, which only the parser's recovery makes into a variable, a function or a
// type. `undefined variable ';'` is one; `undefined variable 'count'` is not.
dg_artefact(string dg_ar_h) {
  string dg_ar_m = dg_msg(dg_ar_h);
  int dg_ar_q = str_find(dg_ar_m, "'");
  int dg_ar_r = 0;
} chain (string dg_ar_h) {
  if(dg_ar_q >= 0 && dg_ar_q + 1 < len(dg_ar_m)) {
    int dg_ar_c = character_code_at(dg_ar_m, dg_ar_q + 1);
    dg_ar_r = chr_is_alpha(dg_ar_c) == 0 && dg_ar_c != 95;
  }
} return int dg_ar_r;
("a.id:1: error: undefined variable ';' [E0301]"):(1)
("a.id:1: error: unknown type '27'"):(1)
("a.id:1: error: undefined variable 'count' [E0301]"):(0)
("a.id:1: error: variable '_x' is declared twice"):(0)
("a.id:1: error: no quoted name here"):(0)

// A syntax error that follows from none is the root of what comes after it.
dg_note_root(string[] dg_nr_roots, string dg_nr_h, string dg_nr_f) {
  if(dg_nr_f == "" && dg_is_syntax(dg_nr_h) == 1) {
    push(dg_nr_roots, dg_nr_h);
  }
} return void;
([], "a.id:1: error: x [E0101]", ""):(["a.id:1: error: x [E0101]"], "a.id:1: error: x [E0101]", "")
(["r"], "a.id:1: error: x [E0101]", ""):(["r", "a.id:1: error: x [E0101]"], "a.id:1: error: x [E0101]", "")
([], "a.id:1: error: x [E0102]", "a.id:1: error: y [E0101]"):([], "a.id:1: error: x [E0102]", "a.id:1: error: y [E0101]")
([], "a.id:1: error: x [E0301]", ""):([], "a.id:1: error: x [E0301]", "")
