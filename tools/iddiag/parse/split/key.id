// The key of a continuation line: `  why: text` is `why`. A line that is not
// one of the keys a block carries (why, help, at, edit, related, and the follows and in that dg_mark adds) has no
// key, which is what keeps an ordinary indented line of some other tool's output
// from being folded into the diagnostic above it.
dg_key(string dg_kl) {
  int dg_kp = string_find(dg_kl, ": ");
  string dg_kk = "";
  if(string_starts_with(dg_kl, "  ") == 1 && dg_kp > 2) {
    dg_kk = str_sub(dg_kl, 2, dg_kp - 2);
  }
} chain (string dg_kl) {
  int dg_ks = string_find(" why help at edit related follows in ", " " + dg_kk + " ");
  if(dg_ks < 0) {
    dg_kk = "";
  }
} return string dg_kk;
("  why: because"):("why")
("  related: a.id:1: x"):("related")
("  in: dg_x"):("in")
("  note: something else"):("")
("a.id:1: error: x"):("")

// The text after a continuation line's `key: `.
dg_kv(string dg_vl) {
  int dg_vp = string_find(dg_vl, ": ");
  int dg_vn = len(dg_vl) - dg_vp - 2;
  string dg_vr = str_sub(dg_vl, dg_vp + 2, dg_vn);
} return string dg_vr;
("  why: because: yes"):("because: yes")
("  at: x"):("x")

// Every value the block gives for a key, in order. Line 0 is the head, so the
// scan starts at line 1.
dg_vals(string dg_ab, string dg_ak) {
  string[] dg_al = string_split(dg_ab, "\n");
  string[] dg_ao = [];
  int dg_ai = 1;
} chain (string dg_ab, string dg_ak) {
  while(dg_ai < len(dg_al)) {
    dg_take(dg_ao, dg_al[dg_ai], dg_ak);
    dg_ai = dg_ai + 1;
  }
} return string[] dg_ao;
("h\n  help: a\n  why: w\n  help: b", "help"):(["a", "b"])
("h\n  help: a", "why"):([])
