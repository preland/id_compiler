// The two lines under a head: `--> FILE:LINE:COLUMN`, and `in FUNCTION` when the
// block says which function the diagnostic is in. The arrow starts where the
// snippet's bar does, so the head, the place and the snippet read as one block.

dg_loc(string dg_lo_b, string dg_lo_h, int dg_lo_on) {
  int dg_lo_n = dg_ln(dg_lo_h);
  string dg_lo_p = str_repeat(" ", len("" + dg_lo_n) + 1);
  string dg_lo_c = dg_colpart(dg_file(dg_lo_h), dg_lo_n, dg_val(dg_lo_b, "at"));
} chain (string dg_lo_b, string dg_lo_h, int dg_lo_on) {
  string dg_lo_a = dg_paint("-->", "1;34", dg_lo_on);
  string dg_lo_r = "\n" + dg_lo_p + dg_lo_a + " " + dg_file(dg_lo_h) + ":" + dg_lo_n + dg_lo_c;
  string dg_lo_f = dg_val(dg_lo_b, "in");
} chain (string dg_lo_b, string dg_lo_h, int dg_lo_on) {
  if(dg_lo_f != "") {
    dg_lo_r = dg_lo_r + "\n" + dg_lo_p + "in " + dg_lo_f;
  }
} return string dg_lo_r;
("a.id:7: error: x", "a.id:7: error: x", 0):("\n  --> a.id:7")
("h\n  in: dg_fn", "/nonexistent/p.id:12: error: x", 0):("\n   --> /nonexistent/p.id:12\n   in dg_fn")

// `:COLUMN` of the text a diagnostic underlines, or "" when the compiler named
// none or it is not on the line.
dg_colpart(string dg_cp_f, int dg_cp_n, string dg_cp_m) {
  string dg_cp_s = dg_srcline(dg_cp_f, dg_cp_n);
  int dg_cp_c = dg_col(dg_cp_s, dg_cp_m);
  string dg_cp_r = "";
} chain (string dg_cp_f, int dg_cp_n, string dg_cp_m) {
  if(dg_cp_c > 0) {
    dg_cp_r = ":" + dg_cp_c;
  }
} return string dg_cp_r;
given fs_temp_text("one\n  int count = 1;\n") ((import fs_temp_path), 2, "count"):(":7")
given fs_temp_text("one\n  int count = 1;\n") ((import fs_temp_path), 2, "nope"):("")
