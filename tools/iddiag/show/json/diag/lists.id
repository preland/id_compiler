// The two JSON arrays under a diagnostic: its fixes and its related locations.

dg_jfixes(string dg_fx_b, string dg_fx_f) {
  string[] dg_fx_g = dg_groups(dg_fx_b);
  string[] dg_fx_o = [];
  int dg_fx_i = 0;
} chain (string dg_fx_b, string dg_fx_f) {
  while(dg_fx_i < len(dg_fx_g)) {
    push(dg_fx_o, dg_jfix(dg_fx_g[dg_fx_i], dg_fx_f));
    dg_fx_i = dg_fx_i + 1;
  }
  string dg_fx_r = "[" + str_join(dg_fx_o, ",") + "]";
} return string dg_fx_r;
("h\n  help: a\n  help: b", "sample.txt"):("[{\"description\":\"a\",\"applicability\":\"none\",\"edits\":[]},{\"description\":\"b\",\"applicability\":\"none\",\"edits\":[]}]")
("h\n  why: w", "sample.txt"):("[]")

dg_jrels(string dg_rl_b) {
  string[] dg_rl_v = dg_vals(dg_rl_b, "related");
  string[] dg_rl_o = [];
  int dg_rl_i = 0;
} chain (string dg_rl_b) {
  while(dg_rl_i < len(dg_rl_v)) {
    push(dg_rl_o, dg_jrel(dg_rl_v[dg_rl_i]));
    dg_rl_i = dg_rl_i + 1;
  }
  string dg_rl_r = "[" + str_join(dg_rl_o, ",") + "]";
} return string dg_rl_r;
("h\n  related: a.id:3: note: first here\n  related: b.id:9: note: and here"):("[{\"file\":\"a.id\",\"line\":3,\"message\":\"first here\"},{\"file\":\"b.id\",\"line\":9,\"message\":\"and here\"}]")
("h"):("[]")

// A related location is written like a head line, `FILE:LINE: note: TEXT`, so
// the head parsers read it.
dg_jrel(string dg_rn_text) {
  string dg_rn_r = "{\"file\":" + dg_jq(dg_file(dg_rn_text)) + ",\"line\":" + dg_ln(dg_rn_text) + ",\"message\":" + dg_jq(dg_msg(dg_rn_text)) + "}";
} return string dg_rn_r;
("a.id:3: note: first here"):("{\"file\":\"a.id\",\"line\":3,\"message\":\"first here\"}")
("b\"x.id:1: note: q\"z"):("{\"file\":\"b\\\"x.id\",\"line\":1,\"message\":\"q\\\"z\"}")
