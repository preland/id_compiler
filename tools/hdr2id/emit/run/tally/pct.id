// Counting the rows of a report.

// c of n as a percentage to one decimal place, 0.0% when n is 0.
rp_pct(int rp_c, int rp_n) {
  int rp_v = 0;
  if (rp_n > 0) {
    rp_v = rp_c * 1000 / rp_n;
  }
  string rp_r = (rp_v / 10) + "." + (rp_v % 10) + "%";
} return string rp_r;
(5, 10):("50.0%")
(1, 3):("33.3%")
(0, 0):("0.0%")

// How many of the rows start with rp_p.
rp_count(string[] rp_rows, string rp_p) {
  int rp_i = 0;
  int rp_n = 0;
  while (rp_i < len(rp_rows)) {
    rp_n = rp_n + string_starts_with(rp_rows[rp_i], rp_p);
    rp_i = rp_i + 1;
  }
} return int rp_n;
(["H a", "HH b", "H c", "U d x"], "H "):(2)
(["H a", "HH b", "H c", "U d x"], "HH "):(1)
([], "U "):(0)

// How many of the rows that start with U, the functions left out, have rp_key in the reason they give.
rp_hits(string[] rp_rows, string rp_key) {
  int rp_i = 0;
  int rp_n = 0;
  while (rp_i < len(rp_rows)) {
    rp_n = rp_n + (string_starts_with(rp_rows[rp_i], "U ") && string_find(rp_rows[rp_i], rp_key) >= 0);
    rp_i = rp_i + 1;
  }
} return int rp_n;
(["U a callback parameter 'x'", "U b callback parameter 'y'", "H c"], "callback"):(2)
(["U a callback parameter 'x'", "H callback"], "callback"):(1)
