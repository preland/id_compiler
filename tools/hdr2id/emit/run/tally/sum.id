// The summary at the end of a report.

// One line for each reason in cat_keys that left a function out, with how many it did: two spaces, the name from cat_names, a colon and the count.
rp_cats(string[] rp_rows) {
  string[] rp_ls = [];
  string[] rp_ks = (import cat_keys);
  int rp_i = 0;
} chain (string[] rp_rows) {
  while (rp_i < len(rp_ks)) {
    rp_line(rp_rows, rp_i, rp_ls);
    rp_i = rp_i + 1;
  }
  string rp_r = string_join(rp_ls, "");
} return string rp_r;
(["U a variable arguments x", "U b callback parameter y", "U c callback parameter z", "H d"]):("  variable arguments: 1\n  callback: 2\n")
(["H a"]):("")

// Adds to rp_ls the line for reason number rp_i of cat_keys, unless it left nothing out.
rp_line(string[] rp_rows, int rp_i, string[] rp_ls) {
  int rp_n = rp_hits(rp_rows, (import cat_keys)[rp_i]);
  if (rp_n > 0) {
    push(rp_ls, "  " + (import cat_names)[rp_i] + ": " + rp_n + "\n");
  }
} return void;
(["U a struct parameter s"], 2, []):(["U a struct parameter s"], 2, ["  struct by value: 1\n"])
(["U a callback parameter x", "U b callback parameter y"], 1, []):(["U a callback parameter x", "U b callback parameter y"], 1, ["  callback: 2\n"])
(["U a struct parameter s"], 0, []):(["U a struct parameter s"], 0, [])

// The summary of a report whose rows are rp_rows: how many functions there were and how many of them were mapped exactly (H), mapped on an inferred length or a one-scalar out-parameter (HH), and left out (U) with the reasons.
rp_sum(string[] rp_rows) {
  int rp_n = len(rp_rows);
  int rp_h = rp_count(rp_rows, "H ");
  int rp_hh = rp_count(rp_rows, "HH ");
} chain (string[] rp_rows) {
  int rp_u = rp_count(rp_rows, "U ");
  string rp_t = "functions: " + rp_n + "\n  mapped exactly (scalars, strings, handles): " + rp_h + " (" + rp_pct(rp_h, rp_n) + ")\n";
  string rp_m = "  mapped on an inferred buffer length or an out-parameter: " + rp_hh + " (" + rp_pct(rp_hh, rp_n) + ")\n";
} chain (string[] rp_rows) {
  string rp_r = rp_t + rp_m + "  left out: " + rp_u + " (" + rp_pct(rp_u, rp_n) + ")\n" + rp_cats(rp_rows);
} return string rp_r;
(["H a", "HH b", "U c callback parameter x", "U d callback parameter y"]):("functions: 4\n  mapped exactly (scalars, strings, handles): 1 (25.0%)\n  mapped on an inferred buffer length or an out-parameter: 1 (25.0%)\n  left out: 2 (50.0%)\n  callback: 2\n")
(["H a"]):("functions: 1\n  mapped exactly (scalars, strings, handles): 1 (100.0%)\n  mapped on an inferred buffer length or an out-parameter: 0 (0.0%)\n  left out: 0 (0.0%)\n")
