("zh", "f|i4|int\nF|cb|cb", [[], [], [], [], []]):("zh", "f|i4|int\nF|cb|cb", [[], [], [], ["U f callback parameter 'cb': a native can take a func value only when its parameters are scalars, and C callbacks that take pointers or user data need a trampoline shim"], []])

// Runs hd_one over every signature in hd_sigs.
hd_emit(string hd_pre, string[] hd_sigs, string[][] hd_o) {
  int hd_i = 0;
  while (hd_i < len(hd_sigs)) {
    hd_one(hd_pre, hd_sigs[hd_i], hd_o);
    hd_i = hd_i + 1;
  }
} return void;
