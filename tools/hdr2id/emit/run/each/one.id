// A list of hd_n new empty string lists, which is how a run starts its results: lists to fill, and no way to write them as one literal that says what they hold.
hd_fresh(int hd_n) {
  string[][] hd_f = [];
  int hd_i = 0;
  while (hd_i < hd_n) {
    string[] hd_e = [];
    push(hd_f, hd_e);
    hd_i = hd_i + 1;
  }
} return string[][] hd_f;
