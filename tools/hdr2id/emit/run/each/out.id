// The files of a run.

// Writes pre.c under hd_out: the shim C source of a run that mapped what hd_o holds, for the header hd_hdr: its banner, the shared prelude, one handle table per struct tag, then the shims. Answers the bytes written.
hd_cfile(string hd_out, string hd_pre, string hd_hdr, string[][] hd_o) {
  string hd_top = wr_banner(hd_hdr) + str_join((import shim_prelude), "\n") + "\n\n" + wr_weak(hd_o[(import out_nm)]) + "\n";
  string hd_tb = wr_tables(hd_o[(import out_tags)]);
  string hd_cc = hd_top + hd_tb + "\n" + str_join(hd_o[(import out_sh)], "\n");
} chain (string hd_out, string hd_pre, string hd_hdr, string[][] hd_o) {
  int hd_n = wr_put(hd_out, hd_pre + ".c", hd_cc);
} return int hd_n;
given wr_t_dir("zh.c") ((import wr_t_out), "zh", "zlib.h", [[], [], ["SHIM\n"], [], ["gz"]]):(1030) then wr_t_end:("h_gz = { {0}, {0}, 1 };\n\nSHIM\n")
given wr_t_dir("q.c") ((import wr_t_out), "q", "sqlite3.h", [[], [], ["A\n", "B\n"], [], []]):(1000) then wr_t_top:("/* Generated by hdr2id from sqlite3.h: o")
given wr_t_dir("w.c") ((import wr_t_out), "w", "w.h", [[], ["f", "g"], ["S\n"], [], []]):(1015) then wr_t_end:("gma weak f\n#pragma weak g\n\n\nS\n")

// Writes all three kinds of file of a run under hd_out: backend.id, pre.c and the tree of natives under natives/. Answers how many files of natives it wrote.
hd_files(string hd_pre, string hd_hdr, string hd_lib, string hd_out, string[][] hd_o) {
  int hd_b = wr_put(hd_out, "backend.id", wr_backend(hd_pre, hd_lib));
  int hd_cn = hd_cfile(hd_out, hd_pre, hd_hdr, hd_o);
  int hd_nf = wr_natives(hd_out + "/natives", hd_o[(import out_nm)], hd_o[(import out_nat)]);
} return int hd_nf;
given wr_t_dir("backend.id") ("zh", "zlib.h", "z", (import wr_t_out), [["native zh_g() return int;"], ["g"], ["S\n"], [], []]):(1) then wr_t_text:("// What a code generator needs to link the natives declared beside this file. Written by hdr2id; docs/BACKENDS.md says what each name means.\n\nstring name = \"zh\";\n\nstring[] c_linux_sources = [\"zh.c\"];\nstring[] c_linux_cflags = [];\nstring[] c_linux_link = [\"-lz\"];\nstring[] c_darwin_sources = [\"zh.c\"];\nstring[] c_darwin_cflags = [];\nstring[] c_darwin_link = [\"-lz\"];\n")
given wr_t_dir("natives/f_natives.id") ("zh", "zlib.h", "z", (import wr_t_out), [["native zh_f() return int;"], ["f"], ["S\n"], [], []]):(1) then wr_t_text:("native zh_f() return int;\n")

// Writes the files of a run unless hd_out is -, which asks for the report alone. Answers how many files of natives it wrote.
hd_write(string hd_pre, string hd_hdr, string hd_lib, string hd_out, string[][] hd_o) {
  int hd_nf = 0;
  if (hd_out != "-") {
    hd_nf = hd_files(hd_pre, hd_hdr, hd_lib, hd_out, hd_o);
  }
} return int hd_nf;
("zh", "zlib.h", "z", "-", [[], [], [], [], []]):(0)
given wr_t_dir("natives/f_natives.id") ("zh", "zlib.h", "z", (import wr_t_out), [["native zh_f() return int;"], ["f"], ["S\n"], [], []]):(1) then wr_t_text:("native zh_f() return int;\n")
