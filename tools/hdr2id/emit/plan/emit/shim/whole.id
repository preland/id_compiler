// The lines pl_ls as the body of a C function, each indented four spaces and ended by a newline; "" when there are none.
pl_indent(string[] pl_ls) {
  string pl_r = "";
  if (len(pl_ls) > 0) {
    pl_r = "    " + str_join(pl_ls, "\n    ") + "\n";
  }
} return string pl_r;
