// A whole shim function.

// Adds to pl_acc the C that brings in each parameter of the signature pl_s, those that are buffers when pl_bf is 1 and the others when it is 0: a buffer's length is another parameter, so that one has to be in first.
pl_pass(string[] pl_s, int pl_bf, string[] pl_acc) {
  int pl_j = 1;
  while (pl_j < len(pl_s)) {
    int pl_isb = pl_pk(pl_field(pl_s[pl_j], 0)) == 1;
    if (pl_isb == pl_bf) {
      push(pl_acc, pl_decl(pl_s, pl_j));
    }
    pl_j = pl_j + 1;
  }
} return void;
