// The C source of the shim for the function of signature pl_s, named id_ then pl_pre then an underscore then the C name, which is the symbol idc calls for the native of that name: its parameters brought in, the call, the return.
pl_shim(string pl_pre, string[] pl_s) {
  string[] pl_ls = [];
  string pl_rc = pl_field(pl_s[0], 1);
  string pl_hd = pl_ctype(pl_rc, 1) + " id_" + pl_pre + "_" + pl_field(pl_s[0], 0) + "(" + pl_cparams(pl_s) + ") {\n";
} chain (string pl_pre, string[] pl_s) {
  pl_pass(pl_s, 0, pl_ls);
  pl_pass(pl_s, 1, pl_ls);
  string pl_r = pl_hd + pl_indent(pl_ls) + pl_ret(pl_s) + "\n}\n";
} return string pl_r;
