// The text of the files that are not the natives: the backend.id that says how to link, and the C source that holds the shims.

// The backend.id for a backend named wr_pre whose C source is wr_pre.c and which links the library wr_lib (zlib is z, so -lz), for the two platforms a POSIX shim serves.
wr_backend(string wr_pre, string wr_lib) {
  string wr_src = "[\"" + wr_pre + ".c\"]";
  string wr_lk = "[\"-l" + wr_lib + "\"]";
  string wr_h = "// What a code generator needs to link the natives declared beside this file. Written by hdr2id; docs/BACKENDS.md says what each name means.\n\nstring name = \"" + wr_pre + "\";\n\n";
} chain (string wr_pre, string wr_lib) {
  string wr_l = "string[] c_linux_sources = " + wr_src + ";\nstring[] c_linux_cflags = [];\nstring[] c_linux_link = " + wr_lk + ";\n";
  string wr_d = "string[] c_darwin_sources = " + wr_src + ";\nstring[] c_darwin_cflags = [];\nstring[] c_darwin_link = " + wr_lk + ";\n";
  string wr_r = wr_h + wr_l + wr_d;
} return string wr_r;
("zh", "z"):("// What a code generator needs to link the natives declared beside this file. Written by hdr2id; docs/BACKENDS.md says what each name means.\n\nstring name = \"zh\";\n\nstring[] c_linux_sources = [\"zh.c\"];\nstring[] c_linux_cflags = [];\nstring[] c_linux_link = [\"-lz\"];\nstring[] c_darwin_sources = [\"zh.c\"];\nstring[] c_darwin_cflags = [];\nstring[] c_darwin_link = [\"-lz\"];\n")
("q", "sqlite3"):("// What a code generator needs to link the natives declared beside this file. Written by hdr2id; docs/BACKENDS.md says what each name means.\n\nstring name = \"q\";\n\nstring[] c_linux_sources = [\"q.c\"];\nstring[] c_linux_cflags = [];\nstring[] c_linux_link = [\"-lsqlite3\"];\nstring[] c_darwin_sources = [\"q.c\"];\nstring[] c_darwin_cflags = [];\nstring[] c_darwin_link = [\"-lsqlite3\"];\n")

// The top of the shim C source: a comment saying where it came from and the include of the header wr_hdr.
wr_banner(string wr_hdr) {
  string wr_c = "/* Generated by hdr2id from " + wr_hdr + ": one shim per function that could be mapped, named id_<prefix>_<function> for the native of the same name. */\n#include <" + wr_hdr + ">\n\n";
} return string wr_c;
("zlib.h"):("/* Generated by hdr2id from zlib.h: one shim per function that could be mapped, named id_<prefix>_<function> for the native of the same name. */\n#include <zlib.h>\n\n")
("sqlite3.h"):("/* Generated by hdr2id from sqlite3.h: one shim per function that could be mapped, named id_<prefix>_<function> for the native of the same name. */\n#include <sqlite3.h>\n\n")

// One handle table for each of the struct tags wr_tags, as C declares them, one to a line, each ended by a newline.
wr_tables(string[] wr_tags) {
  string[] wr_ts = [];
  int wr_i = 0;
  while (wr_i < len(wr_tags)) {
    push(wr_ts, "static HTab h_" + wr_tags[wr_i] + " = { {0}, {0}, " + (wr_i + 1) + " };\n");
    wr_i = wr_i + 1;
  }
} chain (string[] wr_tags) {
  string wr_r = string_join(wr_ts, "");
} return string wr_r;
(["gzFile_s", "other"]):("static HTab h_gzFile_s = { {0}, {0}, 1 };\nstatic HTab h_other = { {0}, {0}, 2 };\n")
([]):("")
