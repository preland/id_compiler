// A prototype as a signature.

// The first line of a signature: name|return class|return type of the prototype fn_t whose parameter list opens at token fn_p.
fn_sigtop(string[] fn_t, int fn_p, string[] fn_tn, string[] fn_tc) {
  string[] fn_rw = fn_retw(fn_t, fn_p);
  string fn_rcl = ty_class(fn_rw, fn_tn, fn_tc);
  string fn_top = fn_t[fn_p - 1] + "|" + fn_rcl + "|" + str_join(fn_rw, " ");
} return string fn_top;
