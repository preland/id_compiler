// The signature of the statement fn_st, its tokens joined by single spaces, read against the type table: a list whose first element is name|return class|return type and whose others are the parameters' cls|name|type records; an empty list when fn_st does not declare a function.
fn_sig(string fn_st, string[] fn_tn, string[] fn_tc) {
  string[] fn_t = str_split(fn_st, " ");
  int fn_p = fn_open(fn_t);
  string[] fn_o = [];
} chain (string fn_st, string[] fn_tn, string[] fn_tc) {
  if (fn_p >= 0) {
    push(fn_o, fn_sigtop(fn_t, fn_p, fn_tn, fn_tc));
    fn_sigtail(fn_t, fn_p, fn_tn, fn_tc, fn_o);
  }
} return string[] fn_o;
