(["int", "g", "(", ")", ";"], 2, [], []):("g|i4|int")

// Adds to fn_o the record of each parameter of the prototype fn_t whose parameter list opens at token fn_p.
fn_sigtail(string[] fn_t, int fn_p, string[] fn_tn, string[] fn_tc, string[] fn_o) {
  string[] fn_pl = fn_params(fn_t, fn_p, fn_close(fn_t, fn_p));
  int fn_k = 0;
  while (fn_k < len(fn_pl)) {
    push(fn_o, fn_rec(fn_pl[fn_k], fn_k, fn_tn, fn_tc));
    fn_k = fn_k + 1;
  }
} return void;
