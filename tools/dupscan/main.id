// dupscan -- the same function written twice, in two different projects.
//
// `id` already rejects two functions with the same signature and the same
// logic, but only *within one compilation unit*: a program, the standard
// library and each imported tree are separate units, so the rule cannot see
// that demos/galaxy, republic_beta and idstd each carried the same lset. This
// closes that gap, and it does it without a second opinion about what "the
// same function" means -- the fingerprints it reads are the compiler's own,
// printed by `idc PATH --fingerprints` (mid/form/unique/canon/). A tool that
// re-derived them could disagree with the compiler, which for a tool whose
// whole job is finding duplicated logic would be its own punchline.
//
//   for p in proj1 proj2; do bin/idc $p --fingerprints; done | dupscan
//
// One line in, tab-separated: PROJECT, fingerprint, function name, file:line.
main(int argc, string[] argv) {
  string text = read_all();
  string tab = chr(9);
  scan_text(text, tab);
} return int 0;
stdin "projA\tFPX\tfoo\tfileA.id:10\nprojB\tFPX\tfoo\tfileB.id:20\n" (2, ["prog"]):(0) then prints:("2 copies of foo:\n    fileA.id:10\n    fileB.id:20\n")
stdin "projA\tFPX\tfoo\tfileA.id:10\n" (1, ["prog"]):(0) then prints:("")

scan_text(string text, string tab) {
  string nl = chr(10);
  string[] lines = str_split(text, nl);
  scan_lines(lines, tab);
} return void;
("projA\tFPX\tfoo\tfileA.id:10\nprojB\tFPX\tfoo\tfileB.id:20", "\t"):() then prints:("2 copies of foo:\n    fileA.id:10\n    fileB.id:20\n")
("projA\tFPX\tfoo\tfileA.id:10\nprojB\tFPX\tfoo\tfileB.id:20\nprojC\tFPX\tfoo\tfileC.id:30", "\t"):() then prints:("3 copies of foo:\n    fileA.id:10\n    fileB.id:20\n    fileC.id:30\n")
("projA\tFPX\tfoo\tfileA.id:10", "\t"):() then prints:("")

scan_lines(string[] lines, string tab) {
  ds_init(lines, tab);
  group_all();
} return void;
(["projA\tFPX\tfoo\tfileA.id:10", "projB\tFPX\tfoo\tfileB.id:20"], "\t"):() then prints:("2 copies of foo:\n    fileA.id:10\n    fileB.id:20\n")
(["projA\tFPX\tfoo\tfileA.id:10", "projB\tFPX\tfoo\tfileB.id:20", "projC\tFPX\tfoo\tfileC.id:30"], "\t"):() then prints:("3 copies of foo:\n    fileA.id:10\n    fileB.id:20\n    fileC.id:30\n")
(["projA\tFPX\tfoo\tfileA.id:10"], "\t"):() then prints:("")
