// Fixed module-state fixture for dupscan's own cases: five tab-separated
// rows -- a genuine three-way duplicate (fingerprint FPX, projects A/B/C),
// one unique row (FPY) and one blank line -- traced by hand below, plus two
// zero-parameter readers the cases use as `then` checks.
ds_test_setup() {
  string t = chr(9);
  string[] lines = ["projA" + t + "FPX" + t + "foo" + t + "fileA.id:10", "projB" + t + "FPX" + t + "foo" + t + "fileB.id:20", "projC" + t + "FPX" + t + "foo" + t + "fileC.id:30", "projD" + t + "FPY" + t + "baz" + t + "fileD.id:40", ""];
  ds_init(lines, t);
} return void;
