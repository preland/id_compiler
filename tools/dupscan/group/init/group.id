// ds_hash: How many rows have been hashed so far -- the length witness ds_init2 and
// ds_fill need, since a reset that silently no-ops would leave stale rows
// behind instead of an empty list len() alone would not tell apart.
// ds_seen: Line 1's seen flag: 0 until something groups it with line 0.
ds_init2() {
  export int[] ds_seen = [];
  export int[] ds_hash = [];
  ds_fill(0);
} return void;
given ds_test_setup ():() then len((import ds_hash)):(5)
