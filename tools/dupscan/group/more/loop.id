// Every line becomes the head of at most one group: once a line has been
// claimed it is skipped, so a group of five is printed once rather than five
// times.
group_all() {
  int i = 0;
  while(i < len((import ds_lines))) {
    group_at(i);
    i = i + 1;
  }
} return void;
given ds_test_setup ():() then prints:("3 copies of foo:\n    fileA.id:10\n    fileB.id:20\n    fileC.id:30\n")
given ds_test_setup given group_all ():() then prints:("")

group_at(int i) {
  if((import ds_seen)[i] == 0 && len((import ds_lines)[i]) > 0) {
    int[] grp = [];
    group_head(i, grp);
  }
} return void;
