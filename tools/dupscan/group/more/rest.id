// The rest of the group: every later line with the same fingerprint. The hash
// is compared first and the string only on a hit, so this is a scan over ints
// with a rare string comparison, not a quadratic pile of string compares.
group_rest(int i, int[] grp) {
  int j = i + 1;
  rest_loop(i, grp, j);
  emit_group(grp);
} return void;
