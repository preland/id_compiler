// A hash match is not a match. str_hash is 32 bits over bodies that are often
// near-identical, so the fingerprints are compared in full before two
// functions are called the same one -- a false positive here is a tool telling
// someone to delete working code.
rest_take(int i, int[] grp, int j) {
  string a = ds_col(i, 1);
  string b = ds_col(j, 1);
  take_eq(grp, j, a, b);
} return void;
given ds_test_setup (0, [0], 1):(0, [0, 1], 1)
given ds_test_setup (0, [0], 3):(0, [0], 3)

take_eq(int[] grp, int j, string a, string b) {
  if(str_cmp(a, b) == 0) {
    lset((import ds_seen), j, 1);
    take_new(grp, j);
  }
} return void;
given ds_test_setup ([0], 1, "FPX", "FPX"):([0, 1], 1, "FPX", "FPX") then (import ds_seen)[1]:(1)
given ds_test_setup ([0], 1, "FPX", "FPY"):([0], 1, "FPX", "FPY") then (import ds_seen)[1]:(0)

take_new(int[] grp, int j) {
  int dup = has_where(grp, j);
  if(dup == 0) {
    push(grp, j);
  }
} return void;
given ds_test_setup ([0], 1):([0, 1], 1)
given ds_test_setup ([0], 0):([0], 0)
