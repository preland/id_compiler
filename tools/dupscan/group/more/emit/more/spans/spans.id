// Is line j's location already in the group? The standard library is merged
// into every project's build, so one idstd function arrives once per project
// at the same file:line -- that is one function seen twice, not a duplicate.
has_where(int[] grp, int j) {
  string where = ds_where(j);
  int r = where_loop(grp, where, 0);
} return int r;

where_loop(int[] grp, string where, int k) {
  int r = 0;
  while(k < len(grp) && r == 0) {
    r = where_at(grp, where, k);
    k = k + 1;
  }
} return int r;

where_at(int[] grp, string where, int k) {
  string here = ds_where(grp[k]);
  int r = str_cmp(where, here) == 0;
} return int r;
