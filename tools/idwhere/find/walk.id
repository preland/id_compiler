// The .id files under a root, each asked for NAME: the rows, as `PATH:LINE:
// SIGNATURE -> TYPE` with PATH relative to the root. A directory whose name
// starts with `.` (.idc-cache, .git, idstd's .tests) is not source of the tree
// and is not entered. FILE, when not empty, keeps only rows whose path ends with
// it (the FILE::NAME form).

iw_walk(string iw_wroot, string iw_wname, string iw_wfile) {
  string[] iw_wtodo = [""];
  string[] iw_wrows = [];
  while(len(iw_wtodo) > 0) {
    string iw_wdir = pop(iw_wtodo);
    iw_visit(iw_wtodo, iw_wrows, iw_wroot, iw_wdir, iw_wname, iw_wfile);
  }
} return string[] iw_wrows;
given iw_tree_make ((import iw_troot), "g", ""):(["sub/b.id:1: g(int x) -> int"])
given iw_tree_make ((import iw_troot), "h", ""):([])
given iw_tree_make ((import iw_troot), "g", "other.id"):([])

iw_visit(string[] iw_vtodo, string[] iw_vrows, string iw_vroot, string iw_vdir, string iw_vname, string iw_vfile) {
  string[] iw_vls = exec_ls(path_join(iw_vroot, iw_vdir));
  int iw_vi = 0;
  while(iw_vi < len(iw_vls)) {
    iw_entry(iw_vtodo, iw_vrows, iw_vroot, iw_vdir, iw_vls[iw_vi], iw_vname, iw_vfile);
    iw_vi = iw_vi + 1;
  }
} return void;
given iw_tree_make ([], [], (import iw_troot), "", "f", ""):(["sub/"], ["a.id:1: f() -> void"])
given iw_tree_make ([], [], (import iw_troot), "sub/", "g", ""):([], ["sub/b.id:1: g(int x) -> int"])
([], [], "/nonexistent_iw_root", "x/", "f", ""):([], [])

iw_entry(string[] iw_etodo, string[] iw_erows, string iw_eroot, string iw_edir, string iw_eent, string iw_ename, string iw_efile) {
  string iw_erel = path_join(iw_edir, iw_eent);
  string iw_einfo = "";
  if(string_ends_with(iw_eent, ".id") == 1) {
    iw_einfo = iw_scan(path_join(iw_eroot, iw_erel), iw_ename);
  }
} chain (string[] iw_etodo, string[] iw_erows, string iw_eroot, string iw_edir, string iw_eent, string iw_ename, string iw_efile) {
  if(iw_einfo != "" && string_ends_with(iw_erel, iw_efile) == 1) {
    push(iw_erows, iw_erel + ":" + iw_einfo);
  }
  if(string_ends_with(iw_eent, "/") == 1 && string_starts_with(iw_eent, ".") == 0) {
    push(iw_etodo, iw_erel);
  }
} return void;
given iw_tree_make ([], [], (import iw_troot), "", "a.id", "f", ""):([], ["a.id:1: f() -> void"])
