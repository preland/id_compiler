// A header line as a signature: what is written before the `{` that opens the
// body.

fh_sig(string fh_hl) {
  string fh_r = str_trim(fh_hl);
  int fh_n = len(fh_r) - 1;
  int fh_e = str_ends(fh_r, "{");
} chain (string fh_hl) {
  if(fh_e == 1) {
    string fh_cut = str_sub(fh_r, 0, fh_n);
    fh_r = str_trim(fh_cut);
  }
} return string fh_r;
("add(int a, int b) {"):("add(int a, int b)")
("add(int a)"):("add(int a)")
