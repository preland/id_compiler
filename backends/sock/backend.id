// What a code generator needs to link the natives declared beside this file.
// Read by idc/bin/idc and never compiled, so none of these names reaches a
// program; docs/BACKENDS.md says what each one means.

string name = "sock";
string c_header = "sock.h";

// Linux only: AF_UNIX is POSIX, but the retry loop here was only ever
// proven on Linux. A darwin entry can be added the day something needs it --
// the missing-platform diagnostic already names the gap.
string[] c_linux_sources = ["sock_linux.c"];
string[] c_linux_cflags = [];
string[] c_linux_link = [];
